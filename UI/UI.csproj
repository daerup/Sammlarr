<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<!-- CS8524: allow exhaustive-over-named enum switches without a default arm (Razor compiler warnings ignore .editorconfig). -->
		<NoWarn>$(NoWarn);CS8524</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
		<ProjectReference Include="..\DB\DB.csproj" />
		<ProjectReference Include="..\Shared\Shared.csproj" />
		<ProjectReference Include="..\API\API.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="UI.Tests" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="BlazorBlueprint.Components" />
		<PackageReference Include="BlazorBlueprint.Primitives" />
		<PackageReference Include="BlazorBlueprint.Icons.Lucide" />
		<PackageReference Include="CronExpressionDescriptor" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
		<PackageReference Include="timewarp-simple-icons" />
	</ItemGroup>
	<Target Name="husky" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != 0">
		<Exec Command="dotnet tool restore" StandardOutputImportance="Low" StandardErrorImportance="High" />
		<Exec Command="dotnet husky install" StandardOutputImportance="Low" StandardErrorImportance="High" WorkingDirectory=".." />
	</Target>
	<ItemGroup>
		<Content Update="Shared\PaginationControls.razor.css">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
		<Content Remove="Shared\Media\SearchTile\Skeleton.razor" />
		<Content Update="Shared\Media\MediaDetailSheet.razor.css">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
		<Content Update="Features\Settings\Components\ProviderSettingCard.razor.css">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>
</Project>
