@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using UI.Features.Feeds.Components
@implements IDisposable
@inject FeedRunProgress Progress
@inject NavigationManager Navigation

@if (Progress.Live is Some<ILiveRun>(var run) && !OnFeeds)
{
    <BbTooltip DelayDuration="150">
        <BbTooltipTrigger AsChild="false" Class="absolute -right-0.5 top-1/2 flex -translate-y-1/2 items-center" Focusable="false">
            <span class="nav-dot" role="img" aria-label="A feed is running" data-testid="feeds-nav-dot"></span>
        </BbTooltipTrigger>
        <BbTooltipContent>@Tip(run.Tally)</BbTooltipContent>
    </BbTooltip>
}

@code {
    private bool OnFeeds => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/') == "feeds";

    protected override void OnInitialized()
    {
        Progress.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Progress.StartAsync();
            StateHasChanged();
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Progress.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private static string Tip(RunTally tally)
    {
        var state = tally.Ended.Match(_ => "1 feed run just finished", () => "1 feed running");
        var total = tally.Total.Match(count => $" of {(tally.Estimated ? "~" : "")}{Count(count)}", () => tally.Done == 1 ? " title" : " titles");
        return $"{state} · {Count(tally.Done)}{total}";
    }

    private static string Count(int count) => count.ToString("N0", CultureInfo.InvariantCulture);
}
