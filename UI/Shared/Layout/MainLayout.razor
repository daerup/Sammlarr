@inherits LayoutComponentBase
@implements IDisposable
@using UI.Features.Onboarding.Components
@inject CurrentUserAccessor CurrentUser
@inject AppVersionProvider Versions
@inject SearchLauncher SearchLauncher

<SessionInvalidationListener/>
<AuthorizeView>
    <SetupRedirect/>
</AuthorizeView>
<AuthorizeView>
    <GlobalSearch IsOpen="_isSearchOpen" IsOpenChanged="SearchOpenChanged" Purpose="_searchPurpose"/>
</AuthorizeView>

<div class="relative h-screen overflow-hidden flex flex-col">
    <header class="shrink-0 z-50 w-full border-b bg-background">
        <div class="flex h-12 items-center px-6">
            <div class="mr-6 flex">
                <NavLink href="/" Match="NavLinkMatch.All" class="flex items-center group" aria-label="Sammlarr home">
                    <SammlarrLogo Size="33" WordSize="19"/>
                </NavLink>
            </div>
            <BbNavigationMenu Class="text-sm font-medium">
                <BbNavigationMenuList>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/browse" Class="nav-link">Browse</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/feeds" Class="nav-link">Feeds</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/wantlist" Class="nav-link">Wantlist</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/blocklist" Class="nav-link">Blocklist</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                </BbNavigationMenuList>
            </BbNavigationMenu>
            <div class="flex flex-1 items-center justify-end space-x-2">
                <AuthorizeView>
                    <button type="button" class="search-trigger" aria-label="Search for a movie or show" @onclick="@(() => _isSearchOpen = true)">
                        <LucideIcon Name="search" Size="14"/>
                        <span class="search-trigger-label">Search</span>
                        <BbKbd Keys="Ctrl+K"/>
                    </button>
                </AuthorizeView>
                <BbDarkModeToggle Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"/>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Href="/settings" AriaLabel="Settings">
                    <LucideIcon Name="settings" Size="16"/>
                </BbButton>

                <ProfileCard/>
            </div>
        </div>
    </header>

    <main class="flex-1 min-h-0 overflow-y-auto">
        @Body
    </main>

    <AppFooter Version="Versions.Current"/>
</div>

<BbToastProvider Position="ToastPosition.BottomRight"/>
<WebUiToastListener/>
<BbDialogProvider/>
<BbPortalHost/>

@code {
	private bool _isSearchOpen;

	private SearchPurpose _searchPurpose;

	[CascadingParameter]
	private Task<AuthenticationState>? AuthenticationState { get; set; }

	protected override async Task OnParametersSetAsync()
	{
		if (AuthenticationState is not null)
		{
			CurrentUser.SetPrincipal((await AuthenticationState).User);
		}
	}

	protected override void OnInitialized() => SearchLauncher.Opened += OpenSearch;

	private void OpenSearch(SearchPurpose purpose)
	{
		_searchPurpose = purpose;
		_isSearchOpen = true;
		_ = InvokeAsync(StateHasChanged);
	}

	private void SearchOpenChanged(bool open)
	{
		_isSearchOpen = open;
		if (!open)
		{
			_searchPurpose = SearchPurpose.Wantlist;
		}
	}

	public void Dispose() => SearchLauncher.Opened -= OpenSearch;
}
