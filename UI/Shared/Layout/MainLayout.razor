@inherits LayoutComponentBase
@inject CurrentUserAccessor CurrentUser

<SessionInvalidationListener/>

<div class="relative h-screen overflow-hidden flex flex-col">
    <header class="shrink-0 z-50 w-full border-b bg-background">
        <div class="flex h-14 items-center px-6">
            <div class="mr-6 flex">
                <a href="/" class="flex items-center gap-2 group" aria-label="Sammlarr — home">
                    <LucideIcon Name="library-big" Size="22" Class="text-primary transition-transform duration-200 group-hover:rotate-[-6deg]"/>
                    <span class="font-bold tracking-tight text-base">Sammlarr</span>
                </a>
            </div>
            <BbNavigationMenu Class="text-sm font-medium">
                <BbNavigationMenuList>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/" Match="NavLinkMatch.All" Class="nav-link">Home</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/feeds" Class="nav-link">Feeds</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/browse" Class="nav-link">Browse</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/watchlist" Class="nav-link">Watchlist</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/blacklist" Class="nav-link">Blacklist</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                </BbNavigationMenuList>
            </BbNavigationMenu>
            <div class="flex flex-1 items-center justify-end space-x-2">
                <BbDarkModeToggle Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"/>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Href="/settings" AriaLabel="Settings">
                    <LucideIcon Name="settings" Size="16"/>
                </BbButton>

                <ProfileCard/>
            </div>
        </div>
    </header>

    <main class="flex-1 min-h-0 overflow-y-auto">
        @Body
    </main>

    <footer class="shrink-0 border-t py-6 md:py-0">
        <div class="flex flex-col items-center justify-between gap-4 md:h-14 md:flex-row px-6">
            <p class="text-sm text-muted-foreground">
                Built with <a href="https://blazorblueprintui.com" target="_blank" class="font-medium underline underline-offset-4">BlazorBlueprint</a>
            </p>
        </div>
    </footer>
</div>

<BbToastProvider Position="ToastPosition.BottomRight"/>
<WebUiToastListener/>
<BbDialogProvider/>
<BbPortalHost/>

@code {
	[CascadingParameter]
	private Task<AuthenticationState>? AuthenticationState { get; set; }

	protected override async Task OnParametersSetAsync()
	{
		if (AuthenticationState is not null)
		{
			CurrentUser.SetPrincipal((await AuthenticationState).User);
		}
	}
}
