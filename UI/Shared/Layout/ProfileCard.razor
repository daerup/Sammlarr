@implements IDisposable
@using System.Security.Claims
@using Contracts.Settings
@using UI.Shared.Services.Branding
@inject NavigationManager NavigationManager
@inject ProfileDropdownService ProfileDropdownService
@inject IProviderConfigService ProviderConfigService
@inject MediaProviderBrandingService BrandingService

@if (_isAuthenticated && _branding is not null)
{
    var brand = _branding.BrandColor;
    var headerStyle = $"background: linear-gradient(180deg, {brand}1F 0%, {brand}08 60%, transparent 100%);";

    <BbDropdownMenu @bind-Open="_isProfileDropdownOpen">
        <BbDropdownMenuTrigger>
            <BbButton id="profile-dropdown-trigger" Variant="ButtonVariant.Ghost" Class="relative h-8 w-8 rounded-full p-0"
                      AriaLabel="@($"Account menu, signed in as {_displayName}")">
                <BbAvatar Size="AvatarSize.Small" ShowDot="true" DotClass="bg-green-500">
                    <BbAvatarImage Source="@_avatarUrl" Alt="@_displayName"/>
                    <BbAvatarFallback>
                        <LucideIcon Name="user" Size="16"/>
                    </BbAvatarFallback>
                </BbAvatar>
            </BbButton>
        </BbDropdownMenuTrigger>
        <BbDropdownMenuContent Align="PopoverAlign.End" Class="p-0 overflow-hidden">
            <div class="relative" style="width: 17rem;">
                @if (_accountUrl is not null)
                {
                    <a href="@_accountUrl" target="_blank" rel="noopener noreferrer"
                       class="absolute top-3 right-3 z-10 text-muted-foreground/60 hover:text-foreground transition-colors"
                       aria-label="@($"Open {_branding.NickName} account in new tab")">
                        <LucideIcon Name="external-link" Size="14"/>
                    </a>
                }
                <div class="px-4 py-4 border-b border-border/60" style="@headerStyle">
                    <div class="flex items-center gap-3">
                        <BbAvatar Size="AvatarSize.Large" Class="avatar-rect">
                            <BbAvatarImage Source="@_avatarUrl" Alt="@_displayName"/>
                            <BbAvatarFallback>
                                <LucideIcon Name="user-round" Size="20"/>
                            </BbAvatarFallback>
                        </BbAvatar>
                        <div class="flex min-w-0 flex-1 flex-col gap-1">
                            <span class="text-sm font-semibold truncate">@_displayName</span>
                            <span class="text-xs text-muted-foreground truncate">@_role</span>
                        </div>
                    </div>
                </div>

                <div class="p-2">
                    <HoverButton Preset="HoverButtonPreset.Destructive"
                                 Icon="log-out"
                                 Text="Sign out"
                                 OnClick="SignOut"
                                 Border="false"
                                 Class="w-full"/>
                </div>
            </div>
        </BbDropdownMenuContent>
    </BbDropdownMenu>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isAuthenticated;
    private string? _displayName;
    private string? _avatarUrl;
    private string? _role;
    private string? _accountUrl;
    private bool _isProfileDropdownOpen;
    private BrandingInfo? _branding;

    public void Dispose() => ProfileDropdownService.OnOpenRequested -= HandleProfileDropdownOpenRequestedAsync;

    protected override async Task OnInitializedAsync()
    {
        var config = await ProviderConfigService.GetAsync();
        _branding = BrandingService.GetBrandingInfo(config.WatchlistProvider.AsMediaProvider());
        _accountUrl = config.AuthProvider == AuthProvider.Plex ? "https://app.plex.tv/desktop/#!/settings/account" : null;

        if (AuthState is not null)
        {
            var principal = (await AuthState).User;
            _isAuthenticated = principal.Identity?.IsAuthenticated == true;
            _displayName = principal.Identity?.Name;
            _avatarUrl = principal.FindFirst(Contracts.Identity.AuthClaims.Avatar)?.Value;
            _role = principal.FindFirst(ClaimTypes.Role)?.Value;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ProfileDropdownService.OnOpenRequested += HandleProfileDropdownOpenRequestedAsync;
            StateHasChanged();
        }
    }

    private void SignOut() => NavigationManager.NavigateTo("/auth/logout", forceLoad: true);

    private async Task HandleProfileDropdownOpenRequestedAsync()
    {
        _isProfileDropdownOpen = true;
        await InvokeAsync(StateHasChanged);
    }
}
