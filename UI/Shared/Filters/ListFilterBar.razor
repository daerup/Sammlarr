@using BlazorBlueprint.Primitives
@using Domain.Media

<div class="filter-bar">
    @if (Available.Count > 0)
    {
        <BbMultiSelect TValue="string"
                       Values="@SelectedSourceKeys"
                       ValuesChanged="OnSourcesChangedAsync"
                       Options="@SourceOptions"
                       Placeholder="Any source"
                       SearchPlaceholder="Search sources"
                       PopoverWidth="w-[420px]"
                       MaxDisplayTags="2"
                       Class="filter-control"/>
    }

    <BbSelect TValue="string"
              Value="@(Filter.Type?.ToString())"
              ValueChanged="OnTypeChangedAsync"
              Options="@TypeOptions"
              Placeholder="Any type"
              Class="filter-control filter-type"/>

    <span class="filter-count">@Shown of @Total</span>

    @if (Filter.HasFilters)
    {
        <button type="button" class="filter-clear" @onclick="ClearAsync">Clear all</button>
    }

    <span class="filter-spacer"></span>
    <span class="filter-divider"></span>

    <BbSelect TValue="ListSort"
              Value="@Filter.Sort"
              ValueChanged="OnSortChangedAsync"
              Options="@SortOptions"
              Class="filter-control filter-sort"/>
</div>

@code {
    [Parameter, EditorRequired]
    public required ListFilter Filter { get; set; }

    [Parameter]
    public EventCallback<ListFilter> FilterChanged { get; set; }

    [Parameter]
    public IReadOnlyList<SourceOption> Available { get; set; } = [];

    [Parameter]
    public int Shown { get; set; }

    [Parameter]
    public int Total { get; set; }

    private IReadOnlyList<SelectOption<string>> SourceOptions => [.. Available.Select(source => new SelectOption<string>(source.Key, source.Label))];

    private static readonly SelectOption<string>[] TypeOptions =
    [
        new(nameof(MediaType.Movie), "Movies"),
        new(nameof(MediaType.Show), "Shows"),
    ];

    private static readonly SelectOption<ListSort>[] SortOptions =
    [
        new(ListSort.RecentlyAdded, "Recently added"),
        new(ListSort.OldestAdded, "Oldest added"),
        new(ListSort.TitleAscending, "Title A to Z"),
        new(ListSort.TitleDescending, "Title Z to A"),
        new(ListSort.NewestRelease, "Newest release"),
        new(ListSort.OldestRelease, "Oldest release"),
    ];

    private IEnumerable<string> SelectedSourceKeys =>
        Filter.Sources.Select(KeyFor).Where(key => key is not null).Select(key => key!);

    private string? KeyFor(SourceChoice choice) => Available.FirstOrDefault(source => source.Choice == choice)?.Key;

    private Task OnSourcesChangedAsync(IEnumerable<string>? keys) =>
        Apply(
            Filter with
            {
                Sources =
                [
                    .. (keys ?? [])
                        .Select(key => Available.FirstOrDefault(source => source.Key == key))
                        .Where(source => source is not null)
                        .Select(source => source!.Choice),
                ],
            }
        );

    private Task OnTypeChangedAsync(string? key) =>
        Apply(Filter with { Type = Enum.TryParse<MediaType>(key, out var type) ? type : null });

    private Task OnSortChangedAsync(ListSort sort) => Apply(Filter with { Sort = sort });

    private Task ClearAsync() => Apply(Filter.ClearFilters());

    private Task Apply(ListFilter filter) => FilterChanged.InvokeAsync(filter);
}
