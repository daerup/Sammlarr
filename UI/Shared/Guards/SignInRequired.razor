@using UI.Shared.Services.Branding
@inject NavigationManager NavigationManager
@inject MediaProviderBrandingService BrandingService

<div class="w-full max-w-md rounded-lg border bg-muted/40 p-8 text-center space-y-4">
    <div class="space-y-1.5">
        <h2 class="text-lg font-semibold tracking-tight">Sign in</h2>
        <p class="text-sm text-muted-foreground">Use your @ProviderNames account to continue.</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert-soft-destructive flex items-start gap-3 rounded-lg border px-4 py-3 text-left text-sm">
            <LucideIcon Name="circle-alert" Size="18" Class="shrink-0 mt-0.5"/>
            <span class="leading-relaxed">@Error</span>
        </div>
    }
    <div class="space-y-2">
        @foreach (var provider in Providers)
        {
            var branding = BrandingService.GetBrandingInfo(provider.AsMediaProvider());
            <div class="signin" style="--brand: @branding.BrandColor">
                <BbButton Variant="ButtonVariant.Outline" Class="signin-button w-full gap-2 font-medium" OnClick="() => SignIn(provider)">
                    <span>Sign in with</span>
                    <ProviderLogo Provider="@branding.Provider" Form="ProviderLogoForm.Logo" Size="16"/>
                </BbButton>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? ReturnUrl { get; set; }

    [Parameter] public string? Error { get; set; }

    private static readonly AuthProvider[] Providers = Enum.GetValues<AuthProvider>();

    private string ProviderNames => string.Join(" or ", Providers.Select(provider => BrandingService.GetBrandingInfo(provider.AsMediaProvider()).NickName));

    private void SignIn(AuthProvider provider)
    {
        var target = string.IsNullOrEmpty(ReturnUrl) ? "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri) : ReturnUrl;
        NavigationManager.NavigateTo($"/auth/{provider.ToString().ToLowerInvariant()}/login?returnUrl={Uri.EscapeDataString(target)}", forceLoad: true);
    }
}
