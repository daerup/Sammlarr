@using Contracts.Auth
@using Domain.Providers
@inject ICredentialRepository CredentialStore

@code {
    [Parameter] [EditorRequired] public AuthProvider Provider { get; set; }
    [Parameter] public EventCallback<bool> AccessChanged { get; set; }

    private bool? _lastReportedAccess;

    protected override async Task OnParametersSetAsync()
    {
        var hasAccess = await CredentialStore.GetAsync(Provider).IsSuccess();

        if (AccessChanged.HasDelegate && _lastReportedAccess != hasAccess)
        {
            _lastReportedAccess = hasAccess;
            await AccessChanged.InvokeAsync(hasAccess);
        }
    }
}
