@using Domain.Media
@using UI.Shared.Media

<div class="change-row @(Entry.Kind is ChangeKind.Removed ? "is-leaving" : null)" @onclick="HandleClickAsync">
    @if (Entry.Media is { } media && !string.IsNullOrWhiteSpace(media.PosterUrl))
    {
        <img class="change-poster" src="@media.PosterUrl" alt=""/>
    }
    else
    {
        <span class="change-poster is-missing">
            <LucideIcon Name="image-off" Size="13"/>
        </span>
    }
    <span class="change-text">
        <span class="change-title">@Entry.Title</span>
        @if (!string.IsNullOrWhiteSpace(Entry.Subtitle))
        {
            <span class="change-subtitle">@Entry.Subtitle</span>
        }
    </span>
    @if (Entry.ContextIcon is { } icon)
    {
        <BbTooltipProvider>
            <BbTooltip DelayDuration="200">
                <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                    <span class="change-context">
                        <LucideIcon Name="@icon" Size="14"/>
                    </span>
                </BbTooltipTrigger>
                <BbTooltipContent>@Entry.ContextTooltip</BbTooltipContent>
            </BbTooltip>
        </BbTooltipProvider>
    }
</div>

@code {
    [Parameter] [EditorRequired] public required ChangeEntry Entry { get; set; }
    [Parameter] public EventCallback<MediaLookup> OnSelect { get; set; }

    private Task HandleClickAsync() => Entry.Media is { } media ? OnSelect.InvokeAsync(media) : Task.CompletedTask;
}
