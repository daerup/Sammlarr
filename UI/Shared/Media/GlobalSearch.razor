@using Contracts.Blocklist
@using Contracts.Settings
@using Contracts.Wantlist
@using Domain.Wantlist
@using UI.Shared.Media.Icons
@implements IDisposable
@inject IProviderConfigService ProviderConfigService
@inject IWantlistService WantlistService
@inject IBlocklistService BlocklistService
@inject Notifier Notifier

@if (_settings is not null)
{
    <SearchModal IsOpen="IsOpen"
                 IsOpenChanged="IsOpenChanged"
                 SearchProvider="@_settings.SearchProvider"
                 IsInWantlist="IsWantlisted"
                 OnToggle="ToggleWantlistAsync"
                 Title="Search"
                 Description="Find a movie or show and add it to a list.">
        <TileIcons Context="ctx">
            <WantlistProvenanceToggle Result="ctx.Result"
                                       IsToggled="ctx.IsToggled"
                                       IsToggling="ctx.IsToggling"
                                       Entry="@EntryFor(ctx.Result.Id)"
                                       OnToggle="ctx.OnToggle"/>
            <BlocklistToggleIcon Result="ctx.Result"
                                 IsToggled="@_blocklisted.Contains(ctx.Result.Id)"
                                 IsToggling="@(_blocklisting == ctx.Result.Id)"
                                 OnToggle="ToggleBlocklistAsync"/>
        </TileIcons>
    </SearchModal>
}

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private ProviderConfig? _settings;
    private IReadOnlySet<MediaId> _blocklisted = new HashSet<MediaId>();
    private IReadOnlyDictionary<MediaId, WantlistItem> _entries = new Dictionary<MediaId, WantlistItem>();
    private MediaId? _blocklisting;

    [Parameter] public bool IsOpen { get; set; }

    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _settings = await ProviderConfigService.GetAsync(_cancellation.Token);
        await RefreshAsync();
    }

    private bool IsWantlisted(MediaId mediaId) => _entries.ContainsKey(mediaId);

    private WantlistItem? EntryFor(MediaId mediaId) => _entries.TryGetValue(mediaId, out var entry) ? entry : null;

    private async Task RefreshAsync()
    {
        _entries = await WantlistService.GetEntriesAsync(_cancellation.Token);
        _blocklisted = await BlocklistService.GetBlocklistIdsAsync(_cancellation.Token);
    }

    private async Task<bool> ToggleWantlistAsync(MediaId id, string title, bool isMarked)
    {
        if (isMarked)
        {
            await WantlistService.RemoveFromWantlistAsync([id], _cancellation.Token);
            Notifier.Success($"'{title}' has been removed from your wantlist.");
        }
        else
        {
            await WantlistService.AddToWantlistAsync([id], new ManualOrigin(ManualSource.Search), _cancellation.Token);
            Notifier.Success($"'{title}' has been added to your wantlist.");
        }

        await RefreshAsync();
        return true;
    }

    private async Task ToggleBlocklistAsync(MediaLookup media)
    {
        if (_blocklisting is not null)
        {
            return;
        }

        _blocklisting = media.Id;
        try
        {
            if (_blocklisted.Contains(media.Id))
            {
                await BlocklistService.RemoveFromBlocklistAsync(media.Id, _cancellation.Token);
                Notifier.Success($"'{media.Title}' has been removed from your blocklist.");
            }
            else
            {
                await BlocklistService.AddToBlocklistAsync(media.Id, _cancellation.Token);
                Notifier.Success($"'{media.Title}' has been blocklisted.");
            }

            await RefreshAsync();
        }
        finally
        {
            _blocklisting = null;
        }
    }

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
