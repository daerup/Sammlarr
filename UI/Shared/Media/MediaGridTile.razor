@using Contracts.Media
@inject IMediaService MediaService
<div class="cursor-pointer group @(Media.IsUnresolved ? "tile-unresolved" : "")" @onclick="OnClick">
    <div class="relative overflow-hidden rounded-lg media-card-backdrop">
        @if (_failed)
        {
            <div class="media-card-failed">
                <LucideIcon Name="image-off" Size="48" Class="text-muted-foreground"/>
            </div>
        }
        else
        {
            <div class="media-card-image" style="--poster: @PosterVar"></div>
            <img class="media-card-probe" src="@_src" alt="" aria-hidden="true" loading="lazy" decoding="async" @onerror="OnImageError"/>
        }

        @if (Media.IsUnresolved)
        {
            <div class="absolute top-4 right-4 z-10">
                <BbTooltipProvider>
                    <BbTooltip DelayDuration="200">
                        <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                            <div class="tile-unresolved-indicator">
                                <LucideIcon Name="circle-alert" Size="24"/>
                            </div>
                        </BbTooltipTrigger>
                        <BbTooltipContent>Could not be matched in your watchlist provider. This item can't be added to your watchlist.</BbTooltipContent>
                    </BbTooltip>
                </BbTooltipProvider>
            </div>
        }
        else if (ShowBookmark)
        {
            <div class="absolute top-4 right-4 z-10">
                <LucideIcon Name="bookmark"
                            Size="25"
                            Color="orange"
                            Fill="@(IsInWatchlist ? "orange" : "transparent")"/>
            </div>
        }

        <div class="absolute bottom-0 left-0 right-0 p-4 space-y-2 z-10">
            @if (Media.Rating is { } rating)
            {
                <div class="flex items-center gap-1.5 text-yellow-400 text-sm tracking-wide antialiased">
                    <LucideIcon Name="star" Size="16" Fill="currentColor"/>
                    <span class="font-medium">@(rating == 0 ? "N/A" : rating.ToString("F1"))</span>
                </div>
            }

            <div class="flex items-center justify-between gap-2">
                <h3 class="text-white text-base font-bold text-lg">@Media.Title</h3>
                @if (Media.ReleaseDate > DateOnly.MinValue)
                {
                    <span class="text-white/70 font-medium text-sm shrink-0">@Media.ReleaseDate.ToString("MMM d, yyyy")</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Media.Tagline))
            {
                <p class="text-white text-xs line-clamp-2">@Media.Tagline</p>
            }
        </div>

        <div
            class="absolute inset-0 bg-gradient-to-br from-primary/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public required MediaLookup Media { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool ShowBookmark { get; set; }
    [Parameter] public bool IsInWatchlist { get; set; }

    private string _src = string.Empty;
    private string? _lastImageUrl;
    private bool _isShowingPoster;
    private bool _failed;

    private string PosterVar => string.IsNullOrWhiteSpace(_src) ? "none" : $"url('{_src}')";

    protected override void OnParametersSet()
    {
        if (_lastImageUrl != Media.BackdropUrl)
        {
            _lastImageUrl = Media.BackdropUrl;
            _src = Media.BackdropUrl;
            _isShowingPoster = false;
            _failed = false;
        }
    }

    private async Task OnImageError()
    {
        if (_isShowingPoster || string.IsNullOrWhiteSpace(Media.PosterUrl))
        {
            _failed = true;
            if (!Media.IsUnresolved)
            {
                await MediaService.InvalidateAsync([Media.Id]);
            }
            return;
        }
        _isShowingPoster = true;
        _src = Media.PosterUrl;
    }
}
