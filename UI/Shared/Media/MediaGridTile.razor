@using Contracts.Media
@using Contracts.Media.Artwork
@inject IMediaService MediaService
@inject ArtworkSources Artwork
<div data-testid="media-tile" class="cursor-pointer group @(Media is UnmatchedMedia ? "tile-unmatched" : "")" @onclick="OnClick">
    <div class="relative overflow-hidden rounded-lg media-card-backdrop @(Dimmed ? "media-card-dimmed" : "")">
        @if (_failed)
        {
            <div class="media-card-failed">
                <LucideIcon Name="image-off" Size="48" Class="text-muted-foreground"/>
            </div>
        }
        else
        {
            <img class="media-card-poster" src="@_src" srcset="@_srcSet" sizes="@Sizes" alt="" @onerror="OnImageError"/>
            <div class="media-card-scrim"></div>
        }

        @if (Media is UnmatchedMedia)
        {
            <div class="absolute top-4 right-4 z-10">
                <BbTooltipProvider>
                    <BbTooltip DelayDuration="200">
                        <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                            <div class="tile-unmatched-indicator">
                                <LucideIcon Name="circle-alert" Size="24"/>
                            </div>
                        </BbTooltipTrigger>
                        <BbTooltipContent>Could not be matched in your media service. This item can't be added to your wantlist.</BbTooltipContent>
                    </BbTooltip>
                </BbTooltipProvider>
            </div>
        }
        else if (ShowBookmark)
        {
            <div class="absolute top-4 right-4 z-10">
                <LucideIcon Name="bookmark"
                            Size="25"
                            Color="orange"
                            Fill="@(IsInWantlist ? "orange" : "transparent")"/>
            </div>
        }

        <div class="absolute bottom-0 left-0 right-0 p-4 space-y-2 z-10">
            @if (Details.Rating.Average is { } rating)
            {
                <div class="flex items-center gap-1.5 text-yellow-400 text-sm tracking-wide antialiased">
                    <LucideIcon Name="star" Size="16" Fill="currentColor"/>
                    <span class="font-medium">@(rating == 0 ? "N/A" : rating.ToString("F1"))</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Details.Tagline))
            {
                <h3 class="text-white text-base font-bold text-lg">@Details.Title</h3>
            }

            <div class="flex items-end justify-between gap-2">
                @if (!string.IsNullOrWhiteSpace(Details.Tagline))
                {
                    <p class="text-white text-xs line-clamp-2">@Details.Tagline</p>
                }
                else
                {
                    <h3 class="text-white text-base font-bold text-lg">@Details.Title</h3>
                }
                @if (Details.ReleaseDate is { } released)
                {
                    <span class="text-white/70 font-medium text-sm shrink-0">@released.ToString("MMM d, yyyy")</span>
                }
            </div>
        </div>

        <div
            class="absolute inset-0 bg-gradient-to-br from-primary/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public required MediaLookup Media { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool ShowBookmark { get; set; }
    [Parameter] public bool IsInWantlist { get; set; }
    [Parameter] public bool Dimmed { get; set; }

    private MediaDetails Details => Media.Details;

    private const string Sizes = "(min-width: 768px) calc(30vw - 40px), calc(120vw - 76px)";
    private static readonly ArtworkSize[] Candidates = [new(780, 413), new(1280, 678)];

    private string _src = string.Empty;
    private string? _srcSet;
    private string? _lastImageUrl;
    private bool _isShowingPoster;
    private bool _failed;

    protected override void OnParametersSet()
    {
        if (_lastImageUrl != Details.BackdropUrl)
        {
            _lastImageUrl = Details.BackdropUrl;
            Show(Details.BackdropUrl);
            _isShowingPoster = false;
            _failed = false;
        }
    }

    private void Show(string? url)
    {
        _src = url ?? string.Empty;
        _srcSet = url is null ? null : Artwork.ByWidth(url, Candidates);
    }

    private async Task OnImageError()
    {
        if (_srcSet is not null)
        {
            _srcSet = null;
            return;
        }

        if (_isShowingPoster || string.IsNullOrWhiteSpace(Details.PosterUrl))
        {
            _failed = true;
            if (Media is IdentifiedMedia identified)
            {
                await MediaService.InvalidateAsync([identified.Identity.Id]);
            }
            return;
        }
        _isShowingPoster = true;
        Show(Details.PosterUrl);
    }
}
