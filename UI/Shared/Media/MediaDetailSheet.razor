@using Contracts.Media
@using Contracts.Blocklist
@using Contracts.Settings
@using Contracts.Wantlist
@using Domain.Wantlist
@using UI.Features.Wantlist.Components
@using UI.Shared.Media.Icons
@inject IMediaService MediaService
@inject IWantlistService WantlistService
@inject IBlocklistService BlocklistService
@inject IProviderConfigService ProviderConfigService
@inject Notifier Notifier
@if (Open)
{
    <div class="sheet-modal-backdrop"></div>
}
<BbSheet Open="Open" OpenChanged="HandleSheetOpenChangedAsync">
    <BbSheetContent Side="SheetSide.Right" ShowClose="false" Class="media-detail-sheet-content overflow-y-auto scrollbar-thin">
        @if (Media.HasValue)
        {
            var media = Media.Value;
            <div class="space-y-6">
                <div class="media-sheet-hero">
                    @if (_failed || string.IsNullOrWhiteSpace(media.PosterUrl))
                    {
                        <div class="media-sheet-poster relative overflow-hidden">
                            <div class="w-full h-full bg-muted flex items-center justify-center">
                                <LucideIcon Name="@(media.MediaType is MediaType.Movie ? "film" : "tv")" Size="64" Class="text-muted-foreground"/>
                            </div>
                        </div>
                    }
                    else
                    {
                        <PosterFade Src="@media.PosterUrl" Alt="@media.Title" OnError="OnImageError"/>
                    }
                </div>

                <BbSheetHeader Class="media-sheet-meta">
                    @if (!media.IsUnmatched)
                    {
                        <div class="media-sheet-toggles">
                            <WantlistProvenanceToggle Result="media"
                                                       Size="18"
                                                       IsToggled="IsWantlisted"
                                                       IsToggling="_togglingWantlist"
                                                       Item="@(_item is Some<WantlistItem>(var shown) ? shown : null)"
                                                       OnToggle="ToggleWantlistAsync"/>
                            <BlocklistToggleIcon Result="media"
                                                 Size="18"
                                                 IsToggled="_blocklisted"
                                                 IsToggling="_togglingBlocklist"
                                                 OnToggle="ToggleBlocklistAsync"/>
                        </div>
                    }
                    <BbSheetTitle Class="font-bold tracking-wide text-xl">
                        <MediaTitleLink Title="@media.Title" Ids="@media.ExternalIds" Side="PopoverSide.Bottom" Align="PopoverAlign.Center"/>
                    </BbSheetTitle>
                    <BbSheetDescription Class="font-normal tracking-wide">
                        <span class="media-sheet-meta-line inline-flex items-center gap-1.5 flex-wrap">
                            <LucideIcon Name="@(media.MediaType is MediaType.Movie ? "film" : "tv")" Size="16" Class="@(media.MediaType is MediaType.Movie ? "" : "meta-tv-icon")"/>
                            <span>@media.MediaType.GetDescription()</span>
                            @if (media.ReleaseDate > DateOnly.MinValue)
                            {
                                <span aria-hidden="true">•</span>
                                <span>@media.ReleaseDate.Year</span>
                            }
                            @foreach (var fact in MediaFacts.GetDisplayFacts(media))
                            {
                                <span aria-hidden="true">•</span>
                                <span>@fact</span>
                            }
                            @if (media.Rating is { } rating)
                            {
                                <span aria-hidden="true">•</span>
                                <span class="inline-flex items-center gap-1 text-yellow-400">
                                    <LucideIcon Name="star" Size="16" Fill="currentColor"/>
                                    <span class="font-semibold">@rating.ToString("F1")</span>
                                </span>
                            }
                        </span>
                    </BbSheetDescription>
                    @if (media.Genres.Count > 0)
                    {
                        <div class="flex flex-wrap justify-center gap-1.5">
                            @foreach (var genre in media.Genres)
                            {
                                <BbBadge Variant="BadgeVariant.Secondary" Class="px-2 py-0.5">@genre</BbBadge>
                            }
                        </div>
                    }
                </BbSheetHeader>

                @if (!string.IsNullOrWhiteSpace(media.Summary))
                {
                    <div class="space-y-3">
                        <h3 class="text-sm font-bold tracking-wide">Overview</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed font-normal tracking-wide antialiased">
                            @media.Summary
                        </p>
                    </div>
                }

            </div>
        }
    </BbSheetContent>
</BbSheet>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OnOpenChanged { get; set; }

    [Parameter]
    public MediaLookup? Media { get; set; }

    [Parameter]
    public EventCallback<MediaListKind> OnEnrollmentChanged { get; set; }

    [Parameter]
    public ManualSource Source { get; set; } = ManualSource.Unknown;

    private bool _failed;
    private string? _lastImageUrl;
    private MediaId? _loadedFor;
    private bool IsWantlisted => _item is Some<WantlistItem>;
    private bool _blocklisted;
    private bool _togglingWantlist;
    private bool _togglingBlocklist;
    private Optional<WantlistItem> _item = new None();

    protected override async Task OnParametersSetAsync()
    {
        var poster = Media.HasValue ? Media.Value.PosterUrl : null;
        if (_lastImageUrl != poster)
        {
            _lastImageUrl = poster;
            _failed = false;
        }

        if (Media is { } lookup && !lookup.IsUnmatched && _loadedFor != lookup.Id)
        {
            _loadedFor = lookup.Id;
            await LoadEnrollmentAsync(lookup.Id);
        }
    }

    private async Task LoadEnrollmentAsync(MediaId id)
    {
        var wantlist = await WantlistService.GetAsync();
        _item = wantlist.Find(id);
        _blocklisted = (await BlocklistService.GetBlocklistIdsAsync()).Contains(id);
    }

    private async Task ToggleWantlistAsync(MediaLookup media)
    {
        if (_togglingWantlist)
        {
            return;
        }

        _togglingWantlist = true;
        try
        {
            if (IsWantlisted)
            {
                await WantlistService.RemoveAsync([media.Id]);
            }
            else
            {
                await WantlistService.AddAsync([media.Id], new ManualOrigin(Source));
            }

            await LoadEnrollmentAsync(media.Id);
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to update wantlist");
        }
        finally
        {
            _togglingWantlist = false;
        }

        await OnEnrollmentChanged.InvokeAsync(MediaListKind.Wantlist);
        await LoadEnrollmentAsync(media.Id);
    }

    private async Task ToggleBlocklistAsync(MediaLookup media)
    {
        if (_togglingBlocklist)
        {
            return;
        }

        _togglingBlocklist = true;
        try
        {
            if (_blocklisted)
            {
                await BlocklistService.RemoveFromBlocklistAsync(media.Id);
            }
            else
            {
                await BlocklistService.AddToBlocklistAsync(media.Id);
            }

            await LoadEnrollmentAsync(media.Id);
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to update blocklist");
        }
        finally
        {
            _togglingBlocklist = false;
        }

        await OnEnrollmentChanged.InvokeAsync(MediaListKind.Blocklist);
        await LoadEnrollmentAsync(media.Id);
    }

    private async Task OnImageError()
    {
        _failed = true;
        if (Media.HasValue && !Media.Value.IsUnmatched)
        {
            await MediaService.InvalidateAsync([Media.Value.Id]);
        }
    }

    private async Task HandleSheetOpenChangedAsync(bool isOpen)
    {
        Open = isOpen;
        await OnOpenChanged.InvokeAsync(isOpen);
    }
}
