@using Contracts.Media
@using global::Shared
@using UI.Shared.Services.Branding
@inject IMediaService MediaService
@if (Open)
{
    <div class="sheet-modal-backdrop"></div>
}
<BbSheet Open="Open" OpenChanged="HandleSheetOpenChangedAsync">
    <BbSheetContent Side="SheetSide.Right" Class="sm:max-w-lg">
        @if (Media.HasValue)
        {
            var media = Media.Value;
            <BbSheetHeader>
                <BbSheetTitle Class="font-bold tracking-wide">
                    <MediaTitleLink Title="@media.Title" Ids="@media.ExternalIds" Side="PopoverSide.Bottom" Align="PopoverAlign.Center"/>
                </BbSheetTitle>
                <BbSheetDescription Class="font-normal tracking-wide">
                    <span class="inline-flex items-center justify-center gap-1.5">
                        @if (media.MediaType is MediaType.Movie)
                        {
                            <LucideIcon Name="film" Size="16"/>
                        }
                        else
                        {
                            <LucideIcon Name="tv" Size="16"/>
                        }
                        <span>@media.MediaType.GetDescription() • @media.ReleaseDate.Year</span>
                    </span>
                </BbSheetDescription>
            </BbSheetHeader>

            <div class="space-y-6 py-6">
                <div class="flex justify-center">
                    <div class="relative overflow-hidden rounded-lg shadow-xl max-w-[260px]">
                        @if (_failed)
                        {
                            <div class="w-full aspect-[2/3] bg-muted flex items-center justify-center">
                                <LucideIcon Name="@(media.MediaType is MediaType.Movie ? "film" : "tv")" Size="48" Class="text-muted-foreground"/>
                            </div>
                        }
                        else
                        {
                            <img src="@media.PosterUrl"
                                 alt="@media.Title"
                                 class="w-full aspect-[2/3] object-cover"
                                 @onerror="OnImageError"/>
                        }
                        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                    </div>
                </div>

                @if (ShowMetadataRow)
                {
                    <div class="flex items-center gap-4 text-sm font-medium tracking-wide antialiased">
                        @if (media.Rating is { } rating)
                        {
                            <div class="flex items-center gap-1.5 text-yellow-400">
                                <LucideIcon Name="star" Size="16" Fill="currentColor"/>
                                <span class="font-semibold">@rating.ToString("F1")</span>
                            </div>
                            <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="h-4"/>
                        }
                        <span class="text-muted-foreground font-medium">
                            @media.ReleaseDate.ToString("MMM d, yyyy")
                        </span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(media.Summary))
                {
                    <div class="space-y-3">
                        <h3 class="text-sm font-bold tracking-wide">Overview</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed font-normal tracking-wide antialiased">
                            @media.Summary
                        </p>
                    </div>
                }

                <BbSeparator/>

                <div class="flex gap-2">
                    <BbButton Class="flex-1"
                              OnClick="HandleButtonClickedAsync"
                              Disabled="@(_isButtonBusy || ButtonDisabled)">
                        @if (_isButtonBusy)
                        {
                            <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                            <span>Processing...</span>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(ResolvedButtonIcon))
                            {
                                <LucideIcon Name="@ResolvedButtonIcon" Size="16" Class="mr-2"/>
                            }
                            <span>@ButtonText()</span>
                        }
                    </BbButton>
                </div>

            </div>
        }
    </BbSheetContent>
</BbSheet>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OnOpenChanged { get; set; }

    [Parameter]
    public MediaMatch? Media { get; set; }

    [Parameter]
    public bool ShowMetadataRow { get; set; }

    [Parameter]
    public required Func<string> ButtonText { get; init; }

    [Parameter]
    public required Func<Task> ButtonAction { get; init; }

    [Parameter]
    public required Func<string> ButtonIcon { get; init; }

    [Parameter]
    public bool ButtonDisabled { get; set; }

    private bool _isButtonBusy;
    private bool _failed;
    private string? _lastImageUrl;
    private string ResolvedButtonIcon => ButtonIcon.Invoke();

    protected override void OnParametersSet()
    {
        var poster = Media.HasValue ? Media.Value.PosterUrl : null;
        if (_lastImageUrl != poster)
        {
            _lastImageUrl = poster;
            _failed = false;
        }
    }

    private async Task OnImageError()
    {
        _failed = true;
        if (Media.HasValue && !Media.Value.IsUnresolved)
        {
            await MediaService.InvalidateAsync([Media.Value.Id]);
        }
    }

    private async Task HandleSheetOpenChangedAsync(bool isOpen)
    {
        Open = isOpen;
        await OnOpenChanged.InvokeAsync(isOpen);
    }

    private async Task HandleButtonClickedAsync()
    {
        if (_isButtonBusy)
        {
            return;
        }

        _isButtonBusy = true;
        try
        {
            await ButtonAction();
        }
        finally
        {
            _isButtonBusy = false;
            Open = false;
            await OnOpenChanged.InvokeAsync(false);
        }
    }
}
