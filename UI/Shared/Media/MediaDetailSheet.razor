@using Contracts.Media
@using Contracts.Blocklist
@using Contracts.Settings
@using UI.Shared.Services.Branding
@using Contracts.Wantlist
@inject IMediaService MediaService
@inject IWantlistService WantlistService
@inject IProviderConfigService ProviderConfig
@inject MediaProviderBrandingService Branding
@inject IBlocklistService BlocklistService
@inject Notifier Notifier
@if (Open)
{
    <div class="sheet-modal-backdrop"></div>
}
<BbSheet Open="Open" OpenChanged="HandleSheetOpenChangedAsync">
    <BbSheetContent Side="SheetSide.Right" ShowClose="false" Class="media-detail-sheet-content overflow-y-auto scrollbar-thin">
        @if (Media.HasValue)
        {
            var media = Media.Value;
            var details = media.Details;
            <div class="space-y-6">
                <div class="media-sheet-hero">
                    @if (!_failed && details.PosterUrl is { } poster)
                    {
                        <PosterFade Src="@poster" Alt="@details.Title" OnError="OnImageError"/>
                    }
                    else
                    {
                        <div class="media-sheet-poster relative overflow-hidden">
                            <div class="w-full h-full bg-muted flex items-center justify-center">
                                <LucideIcon Name="@details.Type.Icon" Size="64" Class="text-muted-foreground"/>
                            </div>
                        </div>
                    }
                </div>

                <BbSheetHeader Class="media-sheet-meta text-center sm:text-center">
                    @if (media is MatchedMedia matched)
                    {
                        <div class="media-sheet-toggles">
                            <WantlistProvenanceToggle Result="matched"
                                                       Size="18"
                                                       IsToggled="IsWantlisted"
                                                       IsToggling="_togglingWantlist"
                                                       Item="_item"
                                                       OnToggle="ToggleWantlistAsync"/>
                            <BlocklistToggleIcon Result="matched"
                                                 Size="18"
                                                 IsToggled="_blocklisted"
                                                 IsToggling="_togglingBlocklist"
                                                 OnToggle="ToggleBlocklistAsync"/>
                        </div>
                    }
                    <BbSheetTitle Class="font-bold tracking-wide text-xl">
                        <MediaTitleLink Title="@details.Title" Ids="@(media.Externals.ToList())" Side="PopoverSide.Bottom" Align="PopoverAlign.Center"/>
                    </BbSheetTitle>
                    <BbSheetDescription Class="font-normal tracking-wide">
                        <span class="media-sheet-meta-line inline-flex items-center gap-1.5 flex-wrap">
                            <LucideIcon Name="@details.Type.Icon" Size="16" Class="@(details.Type is MediaType.Show ? "meta-tv-icon" : "")"/>
                            <span>@details.Type.Label</span>
                            @if (details.ReleaseDate is { } released)
                            {
                                <span aria-hidden="true">•</span>
                                <span>@released.Year</span>
                            }
                            @foreach (var fact in MediaFacts.GetDisplayFacts(details))
                            {
                                <span aria-hidden="true">•</span>
                                <span>@fact</span>
                            }
                            <span aria-hidden="true">•</span>
                            <SammlarrRatingBadge Ratings="@_loadedRatings.GetValueOr(details.Ratings)" Ids="@(media.Externals.ToList())" Title="@details.Title" Size="17" Align="PopoverAlign.Center" Media="media.MatchedId"/>
                        </span>
                    </BbSheetDescription>
                    @if (details.Genres.Count > 0)
                    {
                        <div class="flex flex-wrap justify-center gap-1.5">
                            @foreach (var genre in details.Genres)
                            {
                                <BbBadge Variant="BadgeVariant.Secondary" Class="px-2 py-0.5">@genre</BbBadge>
                            }
                        </div>
                    }
                </BbSheetHeader>

                @if (details.Summary is { } summary)
                {
                    <div class="space-y-3">
                        <h3 class="text-sm font-bold tracking-wide">Overview</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed font-normal tracking-wide antialiased">
                            @summary
                        </p>
                    </div>
                }

            </div>
        }
    </BbSheetContent>
</BbSheet>

@code {
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OnOpenChanged { get; set; }

    [Parameter]
    public MediaMatchResult? Media { get; set; }

    [Parameter]
    public ManualSource Source { get; set; } = ManualSource.Unknown;

    private bool _failed;
    private string? _lastImageUrl;
    private MediaId? _loadedFor;
    private bool IsWantlisted => _item.IsSome();
    private bool _blocklisted;
    private bool _togglingWantlist;
    private bool _togglingBlocklist;
    private Optional<WantlistItem> _item = new None();
    private Optional<MediaRatings> _loadedRatings = new None();

    protected override async Task OnParametersSetAsync()
    {
        var poster = Media?.Details.PosterUrl;
        if (_lastImageUrl != poster)
        {
            _lastImageUrl = poster;
            _failed = false;
        }

        if (Media is MatchedMedia matched && _loadedFor != matched.Identity.Id)
        {
            _loadedFor = matched.Identity.Id;
            _loadedRatings = new None();
            await LoadEnrollmentAsync(matched.Identity.Id);
            await LoadRatingsAsync(matched.Identity.Id);
        }
    }

    private async Task LoadRatingsAsync(MediaId id)
    {
        using var marked = UsageCauses.Mark(UsageCause.ShowingTitles);
        await foreach (var loaded in MediaService.GetDetailsAsync([id], FieldNeeds.Everything))
        {
            loaded.Apply(found => _loadedRatings = Some.Of(found.Details.Ratings));
        }
    }

    private async Task LoadEnrollmentAsync(MediaId id)
    {
        var wantlist = await WantlistService.GetAsync();
        _item = wantlist.Find(id);
        _blocklisted = (await BlocklistService.GetAsync()).Contains(id);
    }

    private async Task ToggleWantlistAsync(MatchedMedia media)
    {
        if (_togglingWantlist)
        {
            return;
        }

        _togglingWantlist = true;
        try
        {
            if (IsWantlisted)
            {
                await WantlistService.RemoveAsync([media.Identity.Id]);
            }
            else
            {
                var added = await WantlistService.AddAsync([media.Identity.Id], new ManualOrigin(Source));
                if (added.Unaddressable.Count > 0)
                {
                    var config = await ProviderConfig.GetAsync();
                    Notifier.Warning(WantlistNotices.NoMatch(Branding.Name(config.Sink.Service), media.Details.Title), WantlistNotices.CantUpdate);
                }
            }

            await LoadEnrollmentAsync(media.Identity.Id);
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to update wantlist");
        }
        finally
        {
            _togglingWantlist = false;
        }
    }

    private async Task ToggleBlocklistAsync(MatchedMedia media)
    {
        if (_togglingBlocklist)
        {
            return;
        }

        _togglingBlocklist = true;
        try
        {
            if (_blocklisted)
            {
                await BlocklistService.RemoveAsync([media.Identity.Id]);
            }
            else
            {
                await BlocklistService.AddAsync([media.Identity.Id]);
            }

            await LoadEnrollmentAsync(media.Identity.Id);
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to update blocklist");
        }
        finally
        {
            _togglingBlocklist = false;
        }
    }

    private async Task OnImageError()
    {
        _failed = true;
        if (Media is MatchedMedia matched)
        {
            await MediaService.InvalidateAsync([matched.Identity.Id]);
        }
    }

    private async Task HandleSheetOpenChangedAsync(bool isOpen)
    {
        Open = isOpen;
        await OnOpenChanged.InvokeAsync(isOpen);
    }
}
