@inject RatingContext Context

@if (_view is { } view)
{
    var strategy = Strategy.GetValueOr(view.Default);
    var value = strategy.Resolve(Ratings, view.Available).Map(rating => rating.Value).ToNullable();
    <span class="rating-badge-wrap @(Look is RatingBadgeLook.OnImage ? "on-image" : null)" @onclick:stopPropagation="true" @onfocusin:stopPropagation="true" @onfocusout:stopPropagation="true">
        <BbPopover>
            <BbPopoverTrigger AsChild="false" class="@TriggerClass(value)" aria-label="@Label(value)">
                <RatingStar Value="value" Size="Size"/>
                <span>@(value is { } shown ? RatingTexts.Number(shown) : "–")</span>
            </BbPopoverTrigger>
            <BbPopoverContent Side="Side" Align="Align" Class="w-auto overflow-hidden rounded-[9px] p-0 shadow-[0_14px_34px_rgba(0,0,0,0.35)]" aria-label="How the Sammlarr rating came about">
                <SammlarrRatingBreakdown Ratings="Ratings" Strategy="strategy" Available="view.Available" Where="@Where" Ids="Ids" Title="@Title" StoredOnly="StoredOnly" Media="Media"/>
            </BbPopoverContent>
        </BbPopover>
    </span>
}

@code {
    private RatingView? _view;

    [Parameter] [EditorRequired] public required RatingSummary Ratings { get; set; }

    [Parameter] public Optional<RatingStrategy> Strategy { get; set; } = new None();

    [Parameter] public IReadOnlyList<IExternalMediaId> Ids { get; set; } = [];

    [Parameter] public string? Title { get; set; }

    [Parameter] public bool StoredOnly { get; set; }

    [Parameter] public Optional<MediaId> Media { get; set; } = new None();

    [Parameter] public RatingBadgeLook Look { get; set; } = RatingBadgeLook.Inline;

    [Parameter] public int Size { get; set; } = 13;

    [Parameter] public PopoverSide Side { get; set; } = PopoverSide.Bottom;

    [Parameter] public PopoverAlign Align { get; set; } = PopoverAlign.Start;

    protected override async Task OnInitializedAsync() => _view = await Context.GetAsync();

    private string Where => Strategy.Match(_ => "this feed", () => "your default");

    private string TriggerClass(float? value)
    {
        var look = Look switch
        {
            RatingBadgeLook.OnImage => "on-image",
            RatingBadgeLook.Inline => "inline",
        };
        return value is null ? $"rating-badge {look} is-unrated" : $"rating-badge {look}";
    }

    private static string Label(float? value)
    {
        return value is { } shown ? $"Sammlarr rating {RatingTexts.Number(shown)}, show how it came about" : RatingTexts.Unrated;
    }
}
