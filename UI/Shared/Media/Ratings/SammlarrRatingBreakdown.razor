@using Contracts.DI
@using Contracts.Media
@using UI.Shared.Services.Branding
@using UI.Shared.Services.Links
@inject MediaProviderBrandingService Branding
@inject IMediaService MediaService
@inject IKeyedServiceIndex<MediaProvider, IExternalPageLinker> Linkers

<div class="rating-breakdown @(_model.Ranked ? "ranked" : null)">
    <div class="rating-breakdown-band popover-band">
        <div class="rating-breakdown-head">
            @if (_model.Sammlarr.ToNullable() is { } sammlarr)
            {
                <span class="rating-breakdown-value">
                    <RatingStar Value="(float)sammlarr.Rounded" Size="20"/>
                    <BbTooltip DelayDuration="150">
                        <BbTooltipTrigger AsChild="false" Class="rating-tip">@RatingTexts.Number(sammlarr)</BbTooltipTrigger>
                        <BbTooltipContent Class="max-w-[360px]"><RatingSum Terms="RatingTexts.Terms(sammlarr)" Result="@RatingTexts.Number(sammlarr)" Why="@RatingTexts.Why(Strategy)"/></BbTooltipContent>
                    </BbTooltip>
                </span>
                <span class="rating-breakdown-name">Sammlarr rating</span>
            }
            else
            {
                <span class="rating-breakdown-value is-unrated"><RatingStar Size="20"/>–</span>
                <span class="rating-breakdown-name">@RatingTexts.Unrated</span>
            }
        </div>
        <div class="rating-breakdown-how">
            @How
            @if (Votes is { } votes)
            {
                <span> · </span>
                @if (VoteSources > 1)
                {
                    <BbTooltip DelayDuration="150">
                        <BbTooltipTrigger AsChild="false" Class="rating-tip">@RatingTexts.Count(votes) votes</BbTooltipTrigger>
                        <BbTooltipContent Class="max-w-[360px]"><RatingSum Terms="VoteTerms" Result="@RatingTexts.Count(votes)" Divided="false"/></BbTooltipContent>
                    </BbTooltip>
                }
                else
                {
                    <span>@RatingTexts.Count(votes) votes</span>
                }
            }
            else if (Value is not null)
            {
                <span> · no votes</span>
            }
        </div>
    </div>
    @foreach (var row in _model.Rows)
    {
        var url = row.Rating.Map(_ => Link(row.Source)).ToNullable();
        <div class="rating-row @(row.State is RatingRowState.Counts ? "counts" : "dim") @(url is null ? null : "is-link")" style="--brand: @Brand(row.Source)">
            @if (_model.Ranked)
            {
                <span class="rating-row-rank">@row.Rank.Map(rank => rank.ToString()).GetValueOr(string.Empty)</span>
            }
            <RatingMarkIcon Source="row.Source" Rating="row.Rating"/>
            <span class="rating-row-name">
                @RatingTexts.Name(row.Source)
                <small>
                    @if (row.State is RatingRowState.NeedsProvider)
                    {
                        <text>needs a </text><RatingSuppliersPopover Sources="[row.Source]"/>
                    }
                    else
                    {
                        @Detail(row)
                    }
                </small>
            </span>
            <span class="rating-row-value">
                @if (row.Rating.ToNullable() is { } rating)
                {
                    <BbTooltip DelayDuration="150">
                        <BbTooltipTrigger AsChild="false" Class="rating-tip">@RatingTexts.Number(rating.SammlarrValue)</BbTooltipTrigger>
                        <BbTooltipContent>@RatingTexts.Conversion(rating)</BbTooltipContent>
                    </BbTooltip>
                }
                else
                {
                    <span>–</span>
                }
            </span>
            @if (url is not null)
            {
                <a class="rating-row-link" href="@url" target="_blank" rel="noopener noreferrer" aria-label="@($"Open {RatingTexts.Name(row.Source)} (opens in new tab)")">
                    <LucideIcon Name="external-link" Size="13"/>
                </a>
            }
            else
            {
                <span></span>
            }
        </div>
    }
    <div class="rating-breakdown-foot">@Footer</div>
</div>

@code {
    private RatingBreakdown _model = null!;

    private Optional<IExternalMediaId> _rottenTomatoes = new None();

    private bool _askedRottenTomatoes;

    [Parameter] [EditorRequired] public required MediaRatings Ratings { get; set; }

    [Parameter] [EditorRequired] public required RatingStrategy Strategy { get; set; }

    [Parameter] [EditorRequired] public required ValueSet<RatingSource> Available { get; set; }

    [Parameter] [EditorRequired] public required string Where { get; set; }

    [Parameter] public IReadOnlyList<IExternalMediaId> Ids { get; set; } = [];

    [Parameter] public string? Title { get; set; }

    [Parameter] public bool StoredOnly { get; set; }

    [Parameter] public Optional<MediaId> Media { get; set; } = new None();

    protected override async Task OnParametersSetAsync()
    {
        _model = RatingBreakdown.Of(Ratings, Strategy, Available, StoredOnly);
        if (!_askedRottenTomatoes && _model.Rows.Any(NeedsARottenTomatoesId))
        {
            _askedRottenTomatoes = true;
            _rottenTomatoes = await RottenTomatoesIdAsync();
        }
    }

    private Task<Optional<IExternalMediaId>> RottenTomatoesIdAsync()
    {
        return Ids
            .OfProvider(MediaProvider.RottenTomatoes)
            .Match(
                known => Task.FromResult<Optional<IExternalMediaId>>(Some.Of(known)),
                () => Media.Match(id => MediaService.FindIdAsync(id, MediaProvider.RottenTomatoes), () => Task.FromResult<Optional<IExternalMediaId>>(new None()))
            );
    }

    private Optional<string> Link(RatingSource source) => Linkers[ProviderOf(source)].PageOf(LinkIds, Optional.Of(Title));

    private static MediaProvider ProviderOf(RatingSource source)
    {
        return source switch
        {
            RatingSource.Tmdb => MediaProvider.Tmdb,
            RatingSource.Imdb => MediaProvider.Imdb,
            RatingSource.RottenTomatoesCritics or RatingSource.RottenTomatoesAudience => MediaProvider.RottenTomatoes,
        };
    }

    private IReadOnlyCollection<IExternalMediaId> LinkIds => _rottenTomatoes.Map(found => (IReadOnlyCollection<IExternalMediaId>)[.. Ids, found]).GetValueOr(Ids);

    private static bool NeedsARottenTomatoesId(RatingRow row) => row.Rating.IsSome() && ProviderOf(row.Source) == MediaProvider.RottenTomatoes;

    private float? Value => _model.Sammlarr.Map(rating => rating.Value).ToNullable();

    private int? Votes => _model.Sammlarr.Map(rating => rating.Votes).ToNullable();

    private string Footer
    {
        get
        {
            if (_model.Partial)
            {
                return RatingTexts.StoredFooter;
            }

            return Value is null ? RatingTexts.UnratedFooter : RatingTexts.Footer;
        }
    }

    private string How => $"{RatingTexts.Strategy(Strategy)} · {Where}";

    private int VoteSources => _model.Sammlarr.Map(RatingTexts.VoteSources).GetValueOr(0);

    private IReadOnlyList<RatingTerm> VoteTerms => _model.Sammlarr.Map(RatingTexts.VoteTerms).GetValueOr([]);

    private string Detail(RatingRow row)
    {
        if (row.SaysWhy)
        {
            return RatingTexts.Reason(row.State, _model.Sammlarr, Where);
        }

        return row.Rating.Map(RatingTexts.Detail).Map(text => UsedInstead(row) ? $"{text} · used instead" : text).GetValueOr(string.Empty);
    }

    private bool UsedInstead(RatingRow row) => _model.UsedInstead && row.State is RatingRowState.Counts;

    private string Brand(RatingSource source) => Branding.GetBrandingInfo(ProviderOf(source)).BrandColor;
}
