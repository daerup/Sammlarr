@using UI.Features.Wantlist.Components
@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

<span class="provenance-trigger" @oncontextmenu="Reveal" @oncontextmenu:preventDefault="CanReveal">
    <WantlistToggleIcon Result="Result"
                         Size="Size"
                         IsToggled="IsToggled"
                         IsToggling="IsToggling"
                         DotColor="@DotColor"
                         OnToggle="OnToggle"/>
    <BbPopover Open="_open" OpenChanged="@(open => _open = open)">
        <BbPopoverTrigger AsChild="false" tabindex="-1" aria-hidden="true" class="provenance-anchor"/>
        <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.End" Class="w-auto p-0 overflow-hidden">
            @if (Item is Some<WantlistItem>(var item))
            {
                <ProvenanceDetails Provenance="item.Provenance" AddedAt="item.AddedAt" ItemId="Result.Identity.Id"/>
            }
        </BbPopoverContent>
    </BbPopover>
</span>

@code {
    [Parameter] [EditorRequired] public required MatchedMedia Result { get; set; }
    [Parameter] public bool IsToggled { get; set; }
    [Parameter] public bool IsToggling { get; set; }
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public Optional<WantlistItem> Item { get; set; } = new None();
    [Parameter] public EventCallback<MatchedMedia> OnToggle { get; set; }

    private bool _open;

    private bool CanReveal => IsToggled && Item.IsSome();

    private void Reveal() => _open = CanReveal;

    private string? DotColor => Item.Match(item => ColorOf(item.Provenance), () => null);

    private string? ColorOf(WantlistItemProvenance provenance)
    {
        return provenance switch
        {
            SinkOrigin sink => Branding.SinkColor(sink.Provider),
            FeedOrigin feed => Branding.GetBrandingInfo(feed.Feed.Provider.AsMediaProvider()).BrandColor,
            OrphanedOrigin => "var(--muted-foreground)",
            ManualOrigin => null,
        };
    }
}
