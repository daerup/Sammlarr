@using UI.Features.Watchlist.Components
@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

<span class="provenance-trigger" @oncontextmenu="Reveal" @oncontextmenu:preventDefault="CanReveal">
    <WatchlistToggleIcon Result="Result"
                         Size="Size"
                         IsToggled="IsToggled"
                         IsToggling="IsToggling"
                         DotColor="@DotColor"
                         OnToggle="OnToggle"/>
    <BbPopover Open="_open" OpenChanged="@(open => _open = open)">
        <BbPopoverTrigger AsChild="false" tabindex="-1" aria-hidden="true" class="provenance-anchor"/>
        <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.End" Class="w-auto p-0 overflow-hidden">
            @if (Entry is { } entry)
            {
                <ProvenanceDetails Provenance="entry.Provenance" AddedAt="entry.AddedAt" ItemId="Result.Id"/>
            }
        </BbPopoverContent>
    </BbPopover>
</span>

@code {
    [Parameter] [EditorRequired] public required MediaLookup Result { get; set; }
    [Parameter] public bool IsToggled { get; set; }
    [Parameter] public bool IsToggling { get; set; }
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public WatchlistEntry? Entry { get; set; }
    [Parameter] public EventCallback<MediaLookup> OnToggle { get; set; }

    private bool _open;

    private bool CanReveal => IsToggled && Entry is not null;

    private void Reveal() => _open = CanReveal;

    private string? DotColor =>
        Entry is { } entry
            ? entry.Provenance switch
            {
                RemoteOrigin remote => Branding.GetBrandingInfo(remote.Provider.AsMediaProvider()).BrandColor,
                FeedOrigin feed => Branding.GetBrandingInfo(feed.Feed.Provider.AsMediaProvider()).BrandColor,
                OrphanedOrigin => "var(--muted-foreground)",
                ManualOrigin => null,
            }
            : null;
}
