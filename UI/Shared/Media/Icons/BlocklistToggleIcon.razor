<button type="button"
        class="search-result-toggle-btn @(IsToggled ? "is-marked" : "") @(IsToggling ? "pointer-events-none" : "")"
        style="--toggle-active-color: var(--destructive)"
        title="@Label"
        aria-label="@Label"
        @onclick="HandleToggleAsync">
    <span class="relative inline-flex items-center justify-center" style="width: @(Size)px; height: @(Size)px">
        @if (IsToggled)
        {
            <LucideIcon Name="shield-off" Size="@Size" Color="var(--destructive)" Class="@_iconClass"/>
        }
        else
        {
            <LucideIcon Name="shield" Size="@Size" Class="@_iconClass"/>
        }
        @if (IsToggling)
        {
            <span class="absolute inset-0 flex items-center justify-center">
                <BbSpinner Size="SpinnerSize.Small"/>
            </span>
        }
    </span>
</button>

@code {
    [Parameter] [EditorRequired] public required IdentifiedMedia Result { get; set; }
    [Parameter] public bool IsToggled { get; set; }
    [Parameter] public bool IsToggling { get; set; }
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public EventCallback<IdentifiedMedia> OnToggle { get; set; }

    private string Label => IsToggled ? "Remove from blocklist" : "Add to blocklist";

    private string _iconClass = string.Empty;

    protected override void OnParametersSet()
    {
        _iconClass = $"transition-opacity duration-150 {(IsToggling ? "opacity-0" : string.Empty)}";
    }

    private async Task HandleToggleAsync()
    {
        await OnToggle.InvokeAsync(Result);
    }
}
