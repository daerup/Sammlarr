@typeparam TItem

@if (IsEditMode)
{
    <BulkActionBar SelectedCount="SelectedCount"
                   PageCount="Items.Count"
                   ListCount="ListItems.Count"
                   RemoveLabel="@RemoveLabel"
                   IsRemoving="_isRemoving"
                   OnSelectPage="SelectPage"
                   OnSelectList="SelectList"
                   OnClearSelection="ClearSelection"
                   OnExit="ExitEditModeAsync"
                   OnRemove="RemoveSelectedAsync"
                   MarkLabel="@MarkLabel"
                   MarkIcon="@MarkIcon"
                   MarkTint="@MarkTint"
                   OnMark="MarkSelectedAsync"
                   MarkableCount="MarkableCount"
                   AlreadyMarkedHint="@AlreadyMarkedHint"
                   RemovableCount="RemovableCount"
                   AlreadyRemovedHint="@AlreadyRemovedHint"
                   RemoveConfirm="@RemoveConfirm"
                   MarkConfirm="@MarkConfirm"/>
}

<div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    @foreach (var item in Items)
    {
        var detail = Detail(item);
        var mediaId = Key(item);
        var renderKey = mediaId.Value;
        var isSelected = _selected.Contains(mediaId);
        <div class="relative media-card @(IsEditMode && isSelected ? "rounded-lg ring-2 ring-primary" : "")">
            <MediaGridTile @key="renderKey"
                           Media="detail"
                           Dimmed="@(IsDimmed?.Invoke(item) ?? false)"
                           OnClick="@(() => HandleTileClickAsync(item))"/>
            @if (IsEditMode)
            {
                <div class="absolute inset-0 z-10 rounded-lg cursor-pointer select-none" @onclick="e => HandleSelectionClick(mediaId, e)" @onclick:stopPropagation="true"></div>
                <div class="absolute top-3 right-3 z-20 pointer-events-none">
                    <div class="@SelectionPillClass(isSelected)">
                        <LucideIcon Name="@(isSelected ? "check" : "circle")" Size="16"/>
                    </div>
                </div>
            }
            @Overlay?.Invoke(item)
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public Func<TItem, MediaLookup> Detail { get; set; } = null!;
    [Parameter, EditorRequired] public Func<TItem, MediaId> Key { get; set; } = null!;
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public EventCallback<bool> IsEditModeChanged { get; set; }
    [Parameter] public EventCallback<TItem> OnTileClick { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<TItem>> OnBulkRemove { get; set; }
    [Parameter] public RenderFragment<TItem>? Overlay { get; set; }
    [Parameter] public Func<TItem, bool>? IsDimmed { get; set; }
    [Parameter] public string RemoveLabel { get; set; } = "Remove";
    [Parameter] public IReadOnlyList<TItem>? AllItems { get; set; }
    [Parameter] public string? MarkLabel { get; set; }
    [Parameter] public string MarkIcon { get; set; } = "shield-ban";
    [Parameter] public string? MarkTint { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<TItem>> OnBulkMark { get; set; }
    [Parameter] public Func<TItem, bool>? IsMarked { get; set; }
    [Parameter] public string? AlreadyMarkedHint { get; set; }
    [Parameter] public Func<TItem, bool>? IsRemoved { get; set; }
    [Parameter] public string? AlreadyRemovedHint { get; set; }
    [Parameter] public Func<int, BulkConfirm>? RemoveConfirm { get; set; }
    [Parameter] public Func<int, BulkConfirm>? MarkConfirm { get; set; }

    private readonly HashSet<MediaId> _selected = new();
    private MediaId? _anchor;
    private bool _anchorSelected;
    private bool _isRemoving;

    private IReadOnlyList<TItem> ListItems => AllItems ?? Items;

    private int SelectedCount => _selected.Count;

    private IEnumerable<TItem> Chosen => ListItems.Where(item => _selected.Contains(Key(item)));

    private IReadOnlyList<TItem> Markable => [.. IsMarked is null ? Chosen : Chosen.Where(item => !IsMarked(item))];

    private int MarkableCount => Markable.Count;

    private IReadOnlyList<TItem> Removable => [.. IsRemoved is null ? Chosen : Chosen.Where(item => !IsRemoved(item))];

    private int RemovableCount => Removable.Count;

    private string SelectionPillClass(bool selected) =>
        selected
            ? "flex h-7 w-7 items-center justify-center rounded-full bg-primary text-primary-foreground shadow"
            : "flex h-7 w-7 items-center justify-center rounded-full bg-background/80 text-muted-foreground border border-border shadow";

    protected override void OnParametersSet()
    {
        if (!IsEditMode && _selected.Count > 0)
        {
            _selected.Clear();
            _anchor = null;
        }
    }

    private async Task HandleTileClickAsync(TItem item)
    {
        if (IsEditMode)
        {
            return;
        }
        await OnTileClick.InvokeAsync(item);
    }

    private void HandleSelectionClick(MediaId mediaId, MouseEventArgs e)
    {
        if (e.ShiftKey && _anchor is { } anchorId)
        {
            ApplyRange(anchorId, mediaId, _anchorSelected);
            return;
        }
        _anchorSelected = ToggleSelection(mediaId);
        _anchor = mediaId;
    }

    private bool ToggleSelection(MediaId mediaId)
    {
        if (_selected.Add(mediaId))
        {
            return true;
        }
        _selected.Remove(mediaId);
        return false;
    }

    private void ApplyRange(MediaId anchor, MediaId target, bool select)
    {
        var anchorIdx = -1;
        var targetIdx = -1;
        for (var i = 0; i < Items.Count; i++)
        {
            var id = Key(Items[i]);
            if (id.Equals(anchor))
            {
                anchorIdx = i;
            }
            if (id.Equals(target))
            {
                targetIdx = i;
            }
        }
        if (anchorIdx < 0 || targetIdx < 0)
        {
            _anchorSelected = ToggleSelection(target);
            _anchor = target;
            return;
        }
        var (lo, hi) = anchorIdx <= targetIdx ? (anchorIdx, targetIdx) : (targetIdx, anchorIdx);
        for (var i = lo; i <= hi; i++)
        {
            var id = Key(Items[i]);
            if (select)
            {
                _selected.Add(id);
            }
            else
            {
                _selected.Remove(id);
            }
        }
    }

    private void SelectPage()
    {
        _selected.Clear();
        _selected.UnionWith(Items.Select(Key));
    }

    private void SelectList()
    {
        _selected.Clear();
        _selected.UnionWith(ListItems.Select(Key));
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _anchor = null;
        _anchorSelected = false;
    }

    private async Task ExitEditModeAsync()
    {
        _selected.Clear();
        _anchor = null;
        _anchorSelected = false;
        await IsEditModeChanged.InvokeAsync(false);
    }

    private Task RemoveSelectedAsync() => RunAsync(OnBulkRemove, Removable);

    private Task MarkSelectedAsync() => RunAsync(OnBulkMark, Markable);

    private async Task RunAsync(EventCallback<IReadOnlyList<TItem>> action, IReadOnlyList<TItem> chosen)
    {
        if (chosen.Count == 0 || _isRemoving)
        {
            return;
        }
        _isRemoving = true;
        try
        {
            await action.InvokeAsync(chosen);
            ClearSelection();
            await IsEditModeChanged.InvokeAsync(false);
        }
        finally
        {
            _isRemoving = false;
        }
    }
}
