@implements IDisposable
@inject AccountConnectionPrompt AccountConnectionPrompt

@if (Settings is null)
{
    <PageContainer>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
        </div>
    </PageContainer>
}
else
{
    <KeyboardShortcut Keys="Ctrl+F" OnInvoked="FocusSearchAsync"/>
    <SignInGuard AccessChanged="OnSignInChanged"/>
    <OAuthGuard Provider="@Settings.AuthProvider" AccessChanged="OnAccessChanged"/>

    <PageContainer Heading="@Heading" Description="@Description" Fill="true">
        <HeaderActions>
            <ProtectedSection GuardState="IsSignedIn" ShowFallback="false">
                <div class="flex items-center gap-2">
                    <div class="list-search">
                        <LucideIcon Name="search" Size="15" Class="text-muted-foreground shrink-0"/>
                        <input @ref="_search"
                               type="search"
                               class="list-search-input"
                               placeholder="Search titles"
                               aria-label="Search titles"
                               value="@Search"
                               @oninput="OnTypedAsync"/>
                        <BbKbd Keys="Ctrl+F" Class="shrink-0"/>
                    </div>
                    @HeaderExtras
                </div>
            </ProtectedSection>
        </HeaderActions>
        <ChildContent>
            <ProtectedSection GuardState="IsSignedIn"
                              DeniedActionDescription="@DeniedActionDescription"
                              FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
                @ChildContent
            </ProtectedSection>
        </ChildContent>
    </PageContainer>
}

@code {
    [Parameter] public ProviderConfig? Settings { get; set; }
    [Parameter, EditorRequired] public required string Heading { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter, EditorRequired] public required Func<bool> IsSignedIn { get; set; }
    [Parameter, EditorRequired] public required Func<bool> IsConnected { get; set; }
    [Parameter, EditorRequired] public required string DeniedActionDescription { get; set; }
    [Parameter] public EventCallback<bool> OnSignInChanged { get; set; }
    [Parameter] public EventCallback<bool> OnAccessChanged { get; set; }
    [Parameter] public string? Search { get; set; }
    [Parameter] public EventCallback<string?> SearchChanged { get; set; }
    [Parameter] public RenderFragment? HeaderExtras { get; set; }
    [Parameter, EditorRequired] public required RenderFragment ChildContent { get; set; }

    private static readonly TimeSpan TypingPause = TimeSpan.FromMilliseconds(250);

    private ElementReference _search;
    private CancellationTokenSource? _typing;

    private Task FocusSearchAsync() => _search.FocusAsync().AsTask();

    private async Task OnTypedAsync(ChangeEventArgs args)
    {
        var typed = args.Value as string;

        _typing?.Cancel();
        _typing?.Dispose();
        _typing = new CancellationTokenSource();
        var token = _typing.Token;

        try
        {
            await Task.Delay(TypingPause, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await SearchChanged.InvokeAsync(string.IsNullOrWhiteSpace(typed) ? null : typed);
    }

    public void Dispose()
    {
        _typing?.Cancel();
        _typing?.Dispose();
    }
}
