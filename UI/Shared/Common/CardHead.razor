<div class="flex items-center gap-2 border-b bg-foreground/5 px-[15px] pb-[9px] pt-2.5">
    <LucideIcon Name="@Icon" Size="14" Class="text-muted-foreground"/>
    <span class="text-[12.5px] font-semibold">@Title</span>
    @ChildContent
</div>

@code {
    [Parameter] [EditorRequired] public required string Icon { get; set; }

    [Parameter] [EditorRequired] public required string Title { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
