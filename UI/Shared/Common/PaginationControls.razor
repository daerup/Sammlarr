@implements IAsyncDisposable
@inject IJSRuntime Js

@if (TotalPages > 1)
{
    <div class="pager-float">
        <div class="pager-pill @(_docked ? "is-docked" : null)">
            @Control
        </div>
    </div>
    <div class="pager-end" @ref="_end"></div>
}

@code {
    private RenderFragment Control =>
        @<BbPagination Class="pagination-controls"
              CurrentPage="CurrentPage"
              TotalPages="TotalPages"
              CurrentPageChanged="HandleCurrentPageChangedAsync">
    <BbPaginationContent Class="justify-center gap-2">
        <BbPaginationItem Class="pagnation-control">
            <div style="@GetDisabledCursorStyle(IsFirstOrPreviousDisabled)">
                <BbPaginationFirst Disabled="@IsFirstOrPreviousDisabled"/>
            </div>
        </BbPaginationItem>
        <BbPaginationItem Class="pagnation-control">
            <div style="@GetDisabledCursorStyle(IsFirstOrPreviousDisabled)">
                <BbPaginationPrevious Disabled="@IsFirstOrPreviousDisabled"
                                      ShowText="false"
                                      Size="PaginationLinkSize.Icon"/>
            </div>
        </BbPaginationItem>
        <BbPaginationItem Class="px-2">
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                <span>Page</span>
                <div @onfocusout="CommitJumpValueAsync" @onkeydown="HandleJumpInputKeyDownAsync" class="jump-input" style="@JumpInputStyle">
                    <BbNumericInput TValue="int"
                                    Value="_jumpPageValue"
                                    ValueChanged="HandleJumpValueChangedAsync"
                                    DisableDebounce="true"
                                    Disabled="@(IsDisabled || TotalPages <= 1)"/>
                </div>
                <span>of @TotalPages</span>
            </div>
        </BbPaginationItem>
        <BbPaginationItem Class="pagnation-control">
            <div style="@GetDisabledCursorStyle(IsNextOrLastDisabled)">
                <BbPaginationNext Disabled="@IsNextOrLastDisabled"
                                  ShowText="false"
                                  Size="PaginationLinkSize.Icon"/>
            </div>
        </BbPaginationItem>
        <BbPaginationItem Class="pagnation-control">
            <div style="@GetDisabledCursorStyle(IsNextOrLastDisabled)">
                <BbPaginationLast Disabled="@IsNextOrLastDisabled"/>
            </div>
        </BbPaginationItem>
    </BbPaginationContent>
</BbPagination>;

    private int _jumpPageValue = 1;
    private string JumpInputStyle => $"width: calc({Math.Max(1, _jumpPageValue.ToString().Length)} * 9px + 28px);";

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    private ElementReference _end;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watcher;
    private DotNetObjectReference<PaginationControls>? _self;
    private bool _docked;
    private bool _watching;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shown = TotalPages > 1;
        if (shown == _watching)
        {
            return;
        }

        _watching = shown;

        if (!shown)
        {
            await StopWatchingAsync();
            _docked = false;
            return;
        }

        _self ??= DotNetObjectReference.Create(this);
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/pager.js");
        _watcher = await _module.InvokeAsync<IJSObjectReference>("watchEnd", _end, _self);
    }

    private async Task StopWatchingAsync()
    {
        if (_watcher is null)
        {
            return;
        }

        try
        {
            await _watcher.InvokeVoidAsync("dispose");
            await _watcher.DisposeAsync();
        }
        catch (JSDisconnectedException) { }

        _watcher = null;
    }

    [JSInvokable]
    public Task OnDockedChanged(bool docked)
    {
        if (docked == _docked)
        {
            return Task.CompletedTask;
        }

        _docked = docked;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        await StopWatchingAsync();

        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }

        _self?.Dispose();
    }

    private static string? GetDisabledCursorStyle(bool isDisabled) => isDisabled ? "cursor: not-allowed;" : null;

    private bool IsFirstOrPreviousDisabled => IsDisabled || CurrentPage <= 1;
    private bool IsNextOrLastDisabled => IsDisabled || CurrentPage >= TotalPages;

    protected override void OnParametersSet()
    {
        _jumpPageValue = CurrentPage;
    }

    private Task HandleCurrentPageChangedAsync(int newPage) => ChangePageAsync(newPage);

    private async Task ChangePageAsync(int newPage)
    {
        if (IsDisabled || newPage < 1 || newPage > TotalPages || newPage == CurrentPage)
        {
            return;
        }

        await PageChanged.InvokeAsync(newPage);
    }

    private Task HandleJumpValueChangedAsync(int value)
    {
        _jumpPageValue = value;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task CommitJumpValueAsync()
    {
        _jumpPageValue = Math.Clamp(_jumpPageValue, 1, TotalPages);
        return ChangePageAsync(_jumpPageValue);
    }

    private Task HandleJumpInputKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            return CommitJumpValueAsync();
        }

        return Task.CompletedTask;
    }
}

