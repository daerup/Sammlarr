@page "/blocklist"
@inherits MediaListPage
@using Contracts.Announcing
@using Contracts.Blocklist
@using Contracts.Identity
@using Contracts.Media
@using Contracts.Wantlist
@using Domain.Announcing
@using Domain.Identity
@using UI.Shared.Announcing
@using UI.Shared.Services.Branding
@inject IBlocklistService BlocklistService
@inject ToastService ToastService
@inject IWantlistService WantlistService
@inject IMediaService Media
@inject MediaProviderBrandingService BrandingService
@inject IEventPublisher Events
@inject ICurrentUser CurrentUser
@inject SearchLauncher SearchLauncher

<PageTitle>Blocklist</PageTitle>

@{
    var gridItems = GridItems;
    var pageItems = Paged(gridItems);
}

<MediaListShell Settings="Settings"
                Heading="Blocklist"
                Description="Your blocklisted movies and shows."
                IsSignedIn="IsSignedIn"
                IsConnected="IsConnected"
                DeniedActionDescription="managing your blocklist"
                OnSignInChanged="HandleSignInChanged"
                OnAccessChanged="HandleAccessChanged"
                Search="@Filter.Search"
                SearchChanged="ApplySearchAsync">
    <HeaderExtras>
        <MediaListViewActions HasItems="@(_items is { Count: > 0 })"
                              IsEditMode="IsEditMode"
                              ShowFilters="ShowFilters"
                              ActiveFilters="Filter.ActiveCount"
                              OnEnterEditMode="EnterEditMode"
                              OnToggleFilters="ToggleFilterBar"/>
    </HeaderExtras>
    <ChildContent>
        <MediaListBody IsLoading="IsLoadingList"
                       ErrorMessage="@ErrorMessage"
                       OnRetry="LoadAsync"
                       TotalCount="_items?.Count"
                       VisibleCount="gridItems.Count"
                       ShowFilters="ShowFilters"
                       Filter="Filter"
                       FilterChanged="ApplyFilterAsync"
                       CurrentPage="@PageWithin(gridItems.Count)"
                       PageCount="@PageCount(gridItems.Count)"
                       PageChanged="GoToPageAsync">
            <EmptyState>
                <MediaListEmptyState Icon="shield-off" Heading="Nothing blocklisted.">
                    <ChildContent>@ListTexts.EmptyBlocklist</ChildContent>
                    <Actions>
                        <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="() => SearchLauncher.Open(SearchPurpose.Blocklist)">
                            <LucideIcon Name="plus" Size="14" Class="mr-1.5"/>
                            <span>Blocklist a title</span>
                        </BbButton>
                    </Actions>
                </MediaListEmptyState>
            </EmptyState>
            <Grid>
                <BulkEditableMediaGrid TItem="BlocklistedMedia"
                                       Items="pageItems"
                                       AllItems="gridItems"
                                       Detail="@(i => i.Media)"
                                       Key="@(i => i.Media.Identity.Id)"
                                       IsEditMode="IsEditMode"
                                       IsEditModeChanged="SetEditMode"
                                       OnTileClick="SelectItem"
                                       OnBulkRemove="RemoveBulkAsync"
                                       RemoveLabel="Remove"
                                       MarkLabel="Wantlist"
                                       MarkIcon="bookmark"
                                       MarkTint="@SinkBrandColor"
                                       OnBulkMark="WantlistBulkAsync"
                                       RemoveConfirm="RemoveConfirm"
                                       MarkConfirm="WantlistConfirm"
                                       IsMarked="@(item => _wantlist.Contains(item.Media.Identity.Id))"
                                       AlreadyMarkedHint="Every selected title is already on your wantlist."/>
            </Grid>
        </MediaListBody>
    </ChildContent>
</MediaListShell>

<MediaDetailSheet Open="IsSheetOpen"
                  OnOpenChanged="SheetOpenChangedAsync"
                  Media="SelectedMedia"/>

@code {
    private IReadOnlyList<BlocklistedMedia>? _items;
    private BlocklistedMedia? _selectedItem;
    private WantlistSnapshot _wantlist = new([]);
    private UserId? _userId;
    private CoalescedReload _blocklistReload = null!;
    private CoalescedReload _wantlistReload = null!;

    private IReadOnlyList<BlocklistedMedia> GridItems =>
        [
            .. Filter.SortBy(
                (_items ?? []).Where(item => Filter.MatchesType(item.Media.Details.Type) && Filter.MatchesSearch(item.Media.Details.Title)),
                item => item.Media,
                item => item.AddedAt
            ),
        ];

    protected override async Task OnInitializedAsync()
    {
        _blocklistReload = new(ReloadAsync);
        _wantlistReload = new(ReloadWantlistAsync);
        Events.Published += OnEvent;
        await base.OnInitializedAsync();
    }

    protected override void ClearItems()
    {
        _items = null;
        _userId = null;
    }

    protected override void ClearSelection() => _selectedItem = null;

    protected override async Task LoadAsync()
    {
        _userId ??= CurrentUser.Id;
        IsLoadingList = true;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        ErrorMessage = null;

        try
        {
            var blocklist = await BlocklistService.GetAsync(Cancellation.Token);
            _items = await Media.GetDetailsAsync(blocklist.Items, Cancellation.Token).ToListAsync(Cancellation.Token);
            _wantlist = await WantlistService.GetAsync(Cancellation.Token);

            if (_selectedItem is not null)
            {
                _selectedItem = _items.FirstOrDefault(item => item.Media.Identity.Id == _selectedItem.Media.Identity.Id);
                if (_selectedItem is null)
                {
                    IsSheetOpen = false;
                }
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load blocklist");
            ErrorMessage = $"Failed to load blocklist: {ex.Message}";
        }
        finally
        {
            IsLoadingList = false;
            StateHasChanged();
        }
    }

    private void OnEvent(IEvent raised)
    {
        if (ViewerEvent.Own<BlocklistChangedEvent>(raised, _userId) is { } changed)
        {
            _ = InvokeAsync(() => ListChange.Differs(Shows, changed.Added, changed.Removed) ? _blocklistReload.RunAsync() : Task.CompletedTask);
            return;
        }

        if (ViewerEvent.Own<WantlistChangedEvent>(raised, _userId) is { } wanted)
        {
            _ = InvokeAsync(() => ListChange.Differs(_wantlist.Contains, wanted.Added, wanted.Removed) ? _wantlistReload.RunAsync() : Task.CompletedTask);
        }
    }

    private bool Shows(MediaId id) => _items is not null && _items.Any(item => item.Media.Identity.Id == id);

    private async Task ReloadWantlistAsync()
    {
        _wantlist = await WantlistService.GetAsync(Cancellation.Token);
        StateHasChanged();
    }

    private MediaMatchResult? SelectedMedia => _selectedItem is null ? null : (MediaMatchResult?)_selectedItem.Media;

    private void SelectItem(BlocklistedMedia item)
    {
        _selectedItem = item;
        IsSheetOpen = true;
    }

    private async Task RemoveBulkAsync(IReadOnlyList<BlocklistedMedia> toRemove)
    {
        await BlocklistService.RemoveAsync(toRemove.Select(item => item.Media.Identity.Id), Cancellation.Token);
        ToastService.Success($"Removed {toRemove.Count} item{(toRemove.Count == 1 ? "" : "s")} from your blocklist.");
    }

    private async Task WantlistBulkAsync(IReadOnlyList<BlocklistedMedia> toMark)
    {
        await WantlistService.AddAsync(toMark.Select(item => item.Media.Identity.Id), new ManualOrigin(ManualSource.Search), Cancellation.Token);
        ToastService.Success($"Added {toMark.Count} title{(toMark.Count == 1 ? "" : "s")} to your wantlist.");
    }

    private string? SinkBrandColor =>
        Settings is null ? null : BrandingService.SinkColor(Settings.Sink);

    private static BulkConfirm RemoveConfirm(int count) =>
        new(
            $"Remove {Titles(count)} from your blocklist?",
            "Later feed runs will be able to add them again. They are not added to your wantlist."
        );

    private static BulkConfirm WantlistConfirm(int count) => new($"Wantlist {Titles(count)}?", "They stay blocklisted.");

    private static string Titles(int count) => count == 1 ? "1 title" : $"{count} titles";

    public override void Dispose()
    {
        Events.Published -= OnEvent;
        base.Dispose();
    }
}
