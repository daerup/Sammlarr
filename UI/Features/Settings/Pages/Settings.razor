@page "/settings"
@using Contracts.Identity
@using Domain.Identity
@inject AccountConnectionPrompt AccountConnectionPrompt
@inject ICurrentUser CurrentUser

<PageTitle>Settings</PageTitle>

<SignInGuard AccessChanged="HandleSignInChanged"/>

<PageContainer Heading="Settings"
               Description="Connect providers, manage secrets, and keep the local cache and diagnostics in check.">
    <ProtectedSection GuardState="IsSignedIn"
                      DeniedActionDescription="manage your settings"
                      FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
    <div class="flex items-start gap-8 pt-2">
        <nav class="w-48 shrink-0 flex flex-col gap-0.5 sticky top-20" aria-label="Settings sections">
            @foreach (var item in VisibleSections)
            {
                var isActive = _activeSection == item;
                <BbButton Variant="@(isActive ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Class="@($"w-full justify-start font-medium {(isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground")}")"
                          OnClick="() => _activeSection = item">
                    <LucideIcon Name="@item.Icon" Size="15" Class="mr-2.5 shrink-0"/>
                    @item.Label
                </BbButton>
            }
        </nav>

        <div class="border-l self-stretch"></div>

        <div class="flex-1 min-w-0">
            <DynamicComponent Type="_activeSection.ComponentType"/>
        </div>
    </div>
    </ProtectedSection>
</PageContainer>

@code {

    private record SettingsSection(string Label, string Icon, Type ComponentType, UserRole? RequiredRole = null);

    private readonly List<SettingsSection> _sections =
    [
        new("Provider Settings", "sliders-horizontal", typeof(ProviderSettingsSection)),
        new("Secrets", "key", typeof(SecretsSection)),
        new("Cache", "database", typeof(CacheSection), UserRole.Admin),
        new("Diagnostics", "activity", typeof(DiagnosticsSection), UserRole.Admin),
        new("Users", "users", typeof(UsersSection), UserRole.Admin),
        new("Testing", "flask-conical", typeof(TestingSection), UserRole.Admin),
    ];

    private IEnumerable<SettingsSection> VisibleSections => _sections.Where(section => section.RequiredRole is null || CurrentUser.Role == section.RequiredRole);

    private SettingsSection _activeSection = null!;
    private bool _isSignedIn;

    private bool IsSignedIn() => _isSignedIn;

    private void HandleSignInChanged(bool hasAccess)
    {
        _isSignedIn = hasAccess;
        if (!VisibleSections.Contains(_activeSection))
        {
            _activeSection = VisibleSections.First();
        }
        StateHasChanged();
    }

    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    protected override void OnInitialized()
    {
        _activeSection = ResolveSection() ?? VisibleSections.First();
    }

    protected override void OnParametersSet()
    {
        var resolved = ResolveSection();
        if (resolved is not null)
        {
            _activeSection = resolved;
        }
        else if (!VisibleSections.Contains(_activeSection))
        {
            _activeSection = VisibleSections.First();
        }
    }

    private SettingsSection? ResolveSection() =>
        string.IsNullOrEmpty(Section) ? null : VisibleSections.FirstOrDefault(section => Slug(section.Label).Equals(Section, StringComparison.OrdinalIgnoreCase));

    private static string Slug(string label) => string.Join("-", label.Split(' ')).ToLowerInvariant();
}
