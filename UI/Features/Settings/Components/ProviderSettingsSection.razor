@using Contracts
@using Contracts.Auth
@using Contracts.Media.Metadata
@using Contracts.Media.Search
@using Contracts.Media.Trending
@using Contracts.Identity
@using Contracts.Settings
@using Domain.Identity
@using UI.Shared.Services.Branding
@inject IProviderConfigRepository ProviderConfigRepository
@inject ICurrentUser CurrentUser
@inject Notifier Notifier
@inject MediaProviderBrandingService MediaProviderBrandingService

@if (!_isLoaded)
{
    <div class="w-full max-w-4xl rounded-lg border px-6 py-8 text-sm text-muted-foreground">
        Loading provider settings…
    </div>
}
else
{
    @if (!IsAdmin)
    {
        <div class="w-full mb-4 rounded-lg border bg-muted/40 px-4 py-3 flex items-center gap-2 text-sm text-muted-foreground">
            <LucideIcon Name="lock" Size="14"/>
            <span>Provider settings are managed by an admin. You're viewing them read-only.</span>
        </div>
    }
    <div class="flex gap-8 w-full">
        <ProviderSettingCard TEnum="WatchlistProvider"
                             BrandingProvider="@(p => MediaProviderBrandingService.GetBrandingInfo(p.AsMediaProvider()))"
                             Title="Watchlist Provider"
                             Description="Choose which provider powers the watchlist and OAuth flow."
                             Selected="@_providerConfig.WatchlistProvider"
                             OnChange="@SetWatchlistProviderAsync"
                             IsDisabled="@(_isSaving || !IsAdmin)"/>

        <ProviderSettingCard TEnum="TrendingProvider"
                             BrandingProvider="@(p => MediaProviderBrandingService.GetBrandingInfo(p.AsMediaProvider()))"
                             Title="Trending Provider"
                             Description="Choose which media provider supplies recommendations."
                             Selected="@_providerConfig.TrendingProvider"
                             OnChange="@SetTrendingProviderAsync"
                             IsDisabled="@(_isSaving || !IsAdmin)"/>

        <ProviderSettingCard TEnum="SearchProvider"
                             BrandingProvider="@(p => MediaProviderBrandingService.GetBrandingInfo(p.AsMediaProvider()))"
                             Title="Search Provider"
                             Description="Choose which provider powers search inside the watchlist flow."
                             Selected="@_providerConfig.SearchProvider"
                             OnChange="@SetSearchProviderAsync"
                             IsDisabled="@(_isSaving || !IsAdmin)"/>

        <ProviderSettingCard TEnum="RatingProvider"
                             BrandingProvider="@(p => MediaProviderBrandingService.GetBrandingInfo(p.AsMediaProvider()))"
                             Title="Rating Provider"
                             Description="Choose which provider supplies ratings used for display, filtering, and sorting."
                             Selected="@_providerConfig.RatingProvider"
                             OnChange="@SetRatingProviderAsync"
                             IsDisabled="@(_isSaving || !IsAdmin)"/>
    </div>
}


@code {
    private ProviderConfig _providerConfig = null!;
    private bool _isLoaded;
    private bool _isSaving;

    private bool IsAdmin => CurrentUser.Role == UserRole.Admin;

    protected override async Task OnInitializedAsync()
    {
        _providerConfig = await ProviderConfigRepository.GetAsync();
        _isLoaded = true;
    }

    private Task SetWatchlistProviderAsync(WatchlistProvider provider) => UpdateAsync(settings => settings with { WatchlistProvider = provider });

    private Task SetTrendingProviderAsync(TrendingProvider provider) => UpdateAsync(settings => settings with { TrendingProvider = provider });

    private Task SetSearchProviderAsync(SearchProvider provider) => UpdateAsync(settings => settings with { SearchProvider = provider });

    private Task SetRatingProviderAsync(RatingProvider provider) => UpdateAsync(settings => settings with { RatingProvider = provider });

    private async Task UpdateAsync(Func<ProviderConfig, ProviderConfig> update)
    {
        if (_isSaving || !_isLoaded || !IsAdmin)
        {
            return;
        }

        var previous = _providerConfig;
        _providerConfig = update(_providerConfig);
        _isSaving = true;

        try
        {
            await ProviderConfigRepository.StoreAsync(_providerConfig);
            Notifier.Success("Provider settings saved.");
        }
        catch (Exception ex)
        {
            _providerConfig = previous;
            Notifier.Error(ex, "Failed to save provider settings");
        }
        finally
        {
            _isSaving = false;
        }
    }
}

