@inject AppVersionProvider Versions
@inject AppUpdateChecker Updates

<div class="flex max-w-6xl flex-col gap-6">
    <div>
        <h2 class="text-lg font-semibold">About</h2>
        <p class="text-sm text-muted-foreground">The version you run and where its data comes from.</p>
    </div>

    <VersionCard Version="Versions.Current" Repository="@Versions.Repository" Update="_update"/>
    <DataSourcesCard/>
</div>

@code {
    private Optional<AppUpdate> _update = new None();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _update = await Updates.CheckAsync();
            StateHasChanged();
        }
    }
}
