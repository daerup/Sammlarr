@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

<div class="overflow-hidden rounded-lg border bg-card">
    <CardHead Icon="database" Title="Data sources"/>
    @foreach (var source in Sources)
    {
        <div class="source-row">
            <span class="source-logo">
                <BrandedLogo Brand="source.Brand" Form="ProviderLogoForm.Logo" Size="22"/>
            </span>
            <span class="source-gives">@source.Gives</span>
            <span class="source-note">@source.Note</span>
            <a class="source-open" href="@source.Href" target="_blank" rel="noopener noreferrer" aria-label="@($"Open {source.Brand.DisplayName}")">
                <LucideIcon Name="external-link" Size="13"/>
            </a>
        </div>
    }
    <p class="source-credit">
        Provider icons from
        <AppLink Href="https://selfh.st/icons" External="true">selfh.st/icons</AppLink>
        (CC BY 4.0; the TVDB tile is modified from theirs) and
        <AppLink Href="https://simpleicons.org" External="true">Simple Icons</AppLink>
        (CC0); IMDb's square logo, Rotten Tomatoes' tomato and popcorn marks and Metacritic's and Wikidata's logos from Wikimedia Commons
        (public domain; Metacritic's lettering lightened for the dark theme, Wikidata's moved beside its bars);
        TVmaze's and Letterboxd's logos from their own sites (TVmaze's TV face redrawn for the dark theme);
        anime-lists set in Mona Sans (SIL OFL) beside GitHub's mark.
        Rotten Tomatoes scores arrive through @RottenTomatoesSuppliers; Rotten Tomatoes and its marks are trademarks of Fandango. Each logo belongs to its owner.
    </p>
</div>

@code {
    private string RottenTomatoesSuppliers =>
        string.Join(" and ", (RatingSource.RottenTomatoesCritics.SuppliedBy() + RatingSource.RottenTomatoesAudience.SuppliedBy()).Order().Select(Branding.Name));

    private IReadOnlyList<DataSource> Sources =>
    [
        new(Branding.GetBrandingInfo(MediaProvider.Tmdb), "Titles, artwork, trending and ratings", "This product uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.", "https://www.themoviedb.org"),
        new(Branding.GetBrandingInfo(MediaProvider.Plex), "Sign-in, search, the wantlist sync, and the IMDb and Rotten Tomatoes ratings", "Plex and the Plex logo are trademarks of Plex and used under a license.", "https://www.plex.tv"),
        new(Branding.GetBrandingInfo(MediaProvider.Mdblist), "The lists your feeds import, and ratings from IMDb, TMDB, Rotten Tomatoes, Metacritic, Letterboxd, Trakt and MyAnimeList", "Lists and ratings come from MDBList.", "https://mdblist.com"),
        new(Branding.GetBrandingInfo(MediaProvider.Tvdb), "Series ids, linked from a title", "Series ids link to TheTVDB.", "https://thetvdb.com"),
        new(Branding.GetBrandingInfo(MediaProvider.Imdb), "Title ids, linked from a title, and ratings from IMDb's datasets, for personal and non-commercial use", "IMDb and all related logos are trademarks of IMDb.com, Inc. or its affiliates.", "https://www.imdb.com"),
        new(Branding.GetBrandingInfo(MediaProvider.Metacritic), "Metascores, through MDBList, linked from a title", "Metacritic is a trademark of Fandom, Inc.", "https://www.metacritic.com"),
        new(Branding.GetBrandingInfo(MediaProvider.Letterboxd), "Ratings, through MDBList, linked from a title", "Letterboxd is a trademark of Letterboxd Limited.", "https://letterboxd.com"),
        new(Branding.GetBrandingInfo(MediaProvider.Tvmaze), "Show details and TVDB ids while TMDB cannot answer, linked from a show", "TVmaze's data is licensed under CC BY-SA 4.0.", "https://www.tvmaze.com"),
        new(Branding.GetBrandingInfo(RemoteService.Wikidata), "Rotten Tomatoes, Metacritic and Letterboxd pages, and TMDB and TVDB ids no other service knows, by IMDb id", "Wikidata's data is available under CC0.", "https://www.wikidata.org"),
        new(Branding.GetBrandingInfo(RemoteService.AnimeLists), "The map from AniList and MyAnimeList ids to TVDB, TMDB and IMDb ids, downloaded daily", "Fribb's anime-lists declares no licence; Sammlarr downloads it at runtime and never ships it.", "https://github.com/Fribb/anime-lists"),
        new(Branding.GetBrandingInfo(MediaProvider.AniList), "Public anime lists as feeds, and anime details and ratings", "Data from AniList, through its public API.", "https://anilist.co"),
        new(Branding.GetBrandingInfo(MediaProvider.Mal), "Public anime lists as feeds, and anime details and ratings, with your client ID", "Data from MyAnimeList, through its API.", "https://myanimelist.net"),
        new(Branding.GetBrandingInfo(MediaProvider.Trakt), "Watchlists, public lists and charts as feeds, and the Trakt rating, with your client ID", "Data from Trakt, through its API.", "https://trakt.tv"),
    ];

    private sealed record DataSource(BrandingInfo Brand, string Gives, string Note, string Href);
}
