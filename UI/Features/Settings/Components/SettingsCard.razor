@{
    var headerStyle =
        $"--brand: {Color}; "
        + $"background: linear-gradient(90deg, color-mix(in oklch, {Color} 26%, transparent) 0%, color-mix(in oklch, {Color} 22%, transparent) 55%, color-mix(in oklch, {Color} 12%, transparent) 100%); "
        + $"border-bottom: 2px solid {Color};";
}

<div class="w-full max-w-lg">
    <div class="rounded-lg border bg-card overflow-hidden">
        <div class="flex items-center gap-3 px-6 py-4 settings-card-header" style="@headerStyle">
            @Icon
            <h3 class="text-sm font-semibold">@Title</h3>
            @if (Badge is not null)
            {
                <div class="ml-auto">
                    @Badge
                </div>
            }
        </div>

        <div class="px-6 py-6 space-y-6">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public required string Title { get; set; }

    [Parameter] [EditorRequired] public required string Color { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment Icon { get; set; }

    [Parameter] public RenderFragment? Badge { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment ChildContent { get; set; }
}
