@using UI.Features.Feeds.Components
@using UI.Features.Feeds.Pages.Editor

<DemoCard Title="Media icons" Where="Tiles, search, detail sheet, preview"
          Note="Every toggle and indicator a title can carry, each off then on. The provenance toggle shows no dot for a title added by hand and a brand dot for a feed or the remote watchlist (muted once the feed is deleted); right-click one for its details.">
    <BbTooltipProvider>
        <div class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-3 text-xs text-muted-foreground">
            <span>Watchlist</span>
            <div class="flex items-center gap-3">
                <WatchlistToggleIcon Result="DemoMedia.Movie" IsToggled="false" IsToggling="false"/>
                <WatchlistToggleIcon Result="DemoMedia.Movie" IsToggled="true" IsToggling="false"/>
                <WatchlistToggleIcon Result="DemoMedia.Movie" IsToggled="false" IsToggling="true"/>
            </div>
            <span>Blacklist</span>
            <div class="flex items-center gap-3">
                <BlacklistToggleIcon Result="DemoMedia.Movie" IsToggled="false" IsToggling="false"/>
                <BlacklistToggleIcon Result="DemoMedia.Movie" IsToggled="true" IsToggling="false"/>
                <PreviewBlacklistToggleIcon Result="DemoMedia.Movie" IsToggled="_previewBlacklisted" OnToggle="_ => _previewBlacklisted = !_previewBlacklisted"/>
            </div>
            <span>Provenance</span>
            <div class="flex items-center gap-3">
                <WatchlistProvenanceToggle Result="DemoMedia.Movie" IsToggled="false"/>
                @foreach (var provenance in Origins)
                {
                    <WatchlistProvenanceToggle Result="DemoMedia.Movie" IsToggled="true" Entry="new WatchlistEntry(DemoMedia.Movie.Id, DemoProvenance.AddedAt, provenance)"/>
                }
            </div>
            <span>Indicator</span>
            <div class="flex items-center gap-3">
                <WatchlistIndicatorIcon IsInWatchlist="false"/>
                <WatchlistIndicatorIcon IsInWatchlist="true"/>
            </div>
            <span>Leaving</span>
            <div class="flex items-center gap-3">
                <LeavingIndicator Reason="@PreviewCopy.GoneReason" Threshold="3" Absences="2"/>
            </div>
        </div>
    </BbTooltipProvider>
</DemoCard>

@code {
    private static readonly IReadOnlyList<WatchlistItemProvenance> Origins =
    [
        new ManualOrigin(ManualSource.Search),
        DemoProvenance.Feed,
        DemoProvenance.Remote,
        new OrphanedOrigin("Old feed"),
    ];

    private bool _previewBlacklisted;
}
