@using UI.Features.Feeds.Components

<DemoCard Title="App links" Where="Every text link" Span="2"
          Note="AppLink in each variation, then FeedSourceLink, which is an external AppLink to a feed's source list.">
    <div class="grid grid-cols-[auto_1fr_auto_1fr] items-center gap-x-4 gap-y-3 text-sm">
        <span class="text-xs text-muted-foreground">In app</span>
        <span><AppLink Href="/watchlist">Watchlist</AppLink></span>
        <span class="text-xs text-muted-foreground">No arrow</span>
        <span>Your watchlist holds <AppLink Href="/watchlist" Arrow="false">1,263</AppLink> titles.</span>
        <span class="text-xs text-muted-foreground">Muted</span>
        <span><AppLink Href="/feeds" Muted="true">Feeds</AppLink></span>
        <span class="text-xs text-muted-foreground">Colour</span>
        <span><AppLink Href="/feeds" Arrow="false" Color="var(--muted-foreground)">Feeds</AppLink> › <AppLink Href="/feeds" Arrow="false">Runs</AppLink></span>
        <span class="text-xs text-muted-foreground">Small</span>
        <span><AppLink Href="/feeds" Class="text-xs">See this run</AppLink></span>
        <span class="text-xs text-muted-foreground">External</span>
        <span><AppLink Href="https://simpleicons.org" External="true">Simple Icons</AppLink></span>
        <span class="text-xs text-muted-foreground">Truncated</span>
        <span class="flex max-w-[12rem]"><AppLink Href="/feeds" Class="min-w-0"><span class="truncate">snoak/latest-movies-digital-release</span></AppLink></span>
        <span class="text-xs text-muted-foreground">Source</span>
        <span class="flex flex-col items-start gap-1">
            <FeedSourceLink Provider="FeedProvider.Mdblist" Identifier="snoak/latest-movies-digital-release"/>
            <FeedSourceLink Provider="FeedProvider.Tmdb" Identifier="8321" Muted="true"/>
        </span>
    </div>
</DemoCard>
