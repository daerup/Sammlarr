@using UI.Features.Wantlist.Components

<DemoCard Title="Provenance badges" Where="Wantlist tiles"
          Note="ProvenanceBadge for every origin a wantlist title can have: added by hand from each place, the sink, a feed per provider and a feed that has since been deleted.">
    <BbTooltipProvider>
        <div class="flex flex-wrap items-center gap-2">
            @foreach (var provenance in DemoProvenance.All)
            {
                <ProvenanceBadge Provenance="provenance" AddedAt="DemoProvenance.AddedAt"/>
            }
        </div>
    </BbTooltipProvider>
</DemoCard>
