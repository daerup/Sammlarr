@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_grid" class="demo-grid">
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public required RenderFragment ChildContent { get; set; }

    private ElementReference _grid;
    private IJSObjectReference? _masonry;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _masonry = await JS.InvokeAsync<IJSObjectReference>("import", "./js/masonry.js");
            await _masonry.InvokeVoidAsync("init", _grid);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_masonry is not null)
        {
            try
            {
                await _masonry.InvokeVoidAsync("dispose", _grid);
                await _masonry.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
