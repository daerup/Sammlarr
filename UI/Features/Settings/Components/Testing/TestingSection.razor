@using UI.Features.Settings.Components.Testing.Demos

<div class="w-full flex flex-col gap-3">
    <div class="mb-1">
        <h2 class="text-lg font-semibold tracking-tight">Testing</h2>
        <p class="text-muted-foreground mt-1 text-sm leading-relaxed max-w-2xl">
            A playground for the app's UI components. Only useful for verification during development; will be limited to Development builds.
        </p>
    </div>

    <MediaCardsDemo Watchlisted="_watchlisted"/>

    <DemoGrid>
        <MediaDetailTilesDemo Watchlisted="_watchlisted" OnToggleWatchlist="ToggleWatchlist"/>
        <BulkEditGridDemo/>
        <ProviderRowDemo/>
        <ServicesMapDemo/>
        <AlertFieldsDemo/>
        <BrandingDemo/>
        <StatesDemo/>
        <ChangeListDemo/>
        <FormControlsDemo/>
        <UpNextDemo/>
        <ProvenanceDetailsDemo/>
        <VersionCardDemo/>
        <RunProblemsDemo/>
        <LogoDemo/>
        <MediaIconsDemo/>
        <TemplateVariablesDemo/>
        <AppLinksDemo/>
        <AlertPreviewDemo/>
        <DataSourcesDemo/>
        <FeedFilterBarDemo/>
        <ListFilterBarDemo/>
        <RunsDemo/>
        <ProviderPickersDemo/>
        <MediaTitleLinkDemo/>
        <ActivityDayDemo/>
        <ToastsDemo/>
        <FeedCardsDemo/>
        <PageHeaderDemo/>
        <HoverButtonsDemo/>
        <ButtonsDemo/>
        <LibrarySourcesDemo/>
        <GuardsDemo/>
        <EnumToggleDemo/>
        <ProvenanceBadgesDemo/>
        <NotificationClientsDemo/>
        <PushStatusDemo/>
        <SettingsCardDemo/>
        <CredentialStatusDemo/>
        <DialogsDemo/>
        <FeedChipsDemo/>
        <HealthDotDemo/>
        <ScheduleDemo/>
    </DemoGrid>
</div>

@code {
    private readonly HashSet<MediaId> _watchlisted = [DemoMedia.Movie.Id];

    private void ToggleWatchlist(MediaLookup media)
    {
        if (!_watchlisted.Remove(media.Id))
        {
            _watchlisted.Add(media.Id);
        }
    }
}
