@using UI.Features.Settings.Components.Testing.Demos
@inject ScrollService ScrollService

<div class="flex w-full flex-col gap-8">
    <div class="flex flex-col gap-3">
        <div>
            <h2 class="text-lg font-semibold tracking-tight">Testing</h2>
            <p class="text-muted-foreground mt-1 text-sm leading-relaxed max-w-2xl">
                A playground for the app's UI components, for checking them during development. Release builds leave it out.
            </p>
        </div>
        <nav class="flex flex-wrap gap-1.5" aria-label="Jump to a group">
            @foreach (var group in TestingGroup.All)
            {
                <button type="button" class="rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground transition-colors hover:text-foreground"
                        @onclick="() => ScrollService.IntoViewAsync(group.Id)">
                    @group.Name
                </button>
            }
        </nav>
    </div>

    <DemoGroup Group="TestingGroup.Branding">
        <LogoDemo/>
        <BrandingDemo/>
        <MediaIconsDemo/>
        <DataSourcesDemo/>
        <ProviderTilesDemo/>
    </DemoGroup>

    <DemoGroup Group="TestingGroup.People">
        <BirdAvatarsDemo/>
        <PersonRowsDemo/>
    </DemoGroup>

    <DemoGroup Group="TestingGroup.Ratings">
        <RatingBadgesDemo/>
        <RatingBreakdownDemo/>
        <FeedRatingDemo/>
    </DemoGroup>

    <DemoGroup Group="TestingGroup.Providers">
        <ProviderRowDemo/>
        <ServicesMapDemo/>
        <ArrSinkPartsDemo/>
        <CredentialStatusDemo/>
        <ProviderPickersDemo/>
    </DemoGroup>

    <DemoGroup Group="TestingGroup.Setup">
        <SetupAccountDemo/>
        <SinkCardsDemo/>
        <SetupSummaryDemo/>
    </DemoGroup>

    <DemoGroup Group="TestingGroup.Common">
        <Lead>
            <MediaCardsDemo Wantlisted="_wantlisted"/>
            <LiveRunDemo/>
        </Lead>
        <ChildContent>
            <MediaDetailTilesDemo Wantlisted="_wantlisted" OnToggleWantlist="ToggleWantlist"/>
            <BulkEditGridDemo/>
            <PageHeaderDemo/>
            <ListFilterBarDemo/>
            <EmptyListsDemo/>
            <StatesDemo/>
            <ProvenanceBadgesDemo/>
            <ProvenanceDetailsDemo/>
            <PushStatusDemo/>
            <MediaTitleLinkDemo/>
            <FeedCardsDemo/>
            <FeedFilterBarDemo/>
            <FeedChipsDemo/>
            <RunsDemo/>
            <RunProblemsDemo/>
            <ChangeListDemo/>
            <ScheduleDemo/>
            <UpNextDemo/>
            <ActivityDayDemo/>
            <LibrarySourcesDemo/>
            <AlertFieldsDemo/>
            <AlertPreviewDemo/>
            <TemplateVariablesDemo/>
            <NotificationClientsDemo/>
            <HealthDotDemo/>
            <ButtonsDemo/>
            <HoverButtonsDemo/>
            <FormControlsDemo/>
            <EnumToggleDemo/>
            <DialogsDemo/>
            <ToastsDemo/>
            <GuardsDemo/>
            <AppLinksDemo/>
            <SettingsCardDemo/>
            <VersionCardDemo/>
        </ChildContent>
    </DemoGroup>
</div>

@code {
    private readonly HashSet<MediaId> _wantlisted = [DemoMedia.Movie.Identity.Id];

    private void ToggleWantlist(MatchedMedia media)
    {
        if (!_wantlisted.Remove(media.Identity.Id))
        {
            _wantlisted.Add(media.Identity.Id);
        }
    }
}