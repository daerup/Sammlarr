@using Contracts
@using Contracts.Usage
@using Domain.Feed.Run
@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding
@inject IDateTimeProvider Clock

<UsageCard Title="Feeds" Subtitle="@Subtitle" TestId="usage-feeds">
    <Right>
        <UsageSegments TValue="FeedsTab" Value="_tab" Options="Tabs" OnChange="tab => _tab = tab" Label="Feeds card view"/>
    </Right>
    <ChildContent>
        <div class="usage-feeds flex flex-col gap-2.5">
            <style>@HoverRules</style>
            @if (Plotted.Count == 0)
            {
                <span class="text-[12.5px] text-muted-foreground" data-testid="usage-feeds-none">No runs in the @UsageView.Window(Range).</span>
            }
            else
            {
                <div class="relative h-[192px]" data-testid="usage-feeds-chart" @onclick="() => _picked = new None()">
                    @foreach (var (y, label) in YTicks)
                    {
                        <span class="absolute left-0 w-[38px] text-right text-[10.5px] tabular-nums text-muted-foreground" style="@($"top: {UsageView.Number(y - 7)}px")"
                              data-testid="usage-feeds-tick">@label</span>
                    }
                    @foreach (var (at, label) in XTicks)
                    {
                        <span class="absolute top-[176px] text-[10.5px] whitespace-nowrap text-muted-foreground" style="@($"left: {AtX(at)}")">@label</span>
                    }
                    <svg class="absolute top-0 overflow-visible" style="@($"left: {PlotLeft}px; width: calc(100% - {PlotLeft}px); height: {PlotHeight}px")">
                        @foreach (var (y, _) in YTicks)
                        {
                            <line x1="0" x2="100%" y1="@UsageView.Number(y)" y2="@UsageView.Number(y)" stroke="var(--border)"/>
                        }
                        @foreach (var plot in Plotted.OrderBy(plot => IsLit(plot.Line.Feed)))
                        {
                            var colour = Branding.Color(plot.Line.Provider.Service);
                            <g @key="plot.Key" class="@($"usage-feed-group {(IsLit(plot.Line.Feed) ? string.Empty : "usage-feed-dim")}")" data-f="@plot.Key" data-testid="usage-feed-group"
                               @onmouseleave="Settle">
                                @foreach (var (from, to) in plot.Dots.Zip(plot.Dots.Skip(1)))
                                {
                                    <line x1="@Percent(from.X)" y1="@UsageView.Number(from.Y)" x2="@Percent(to.X)" y2="@UsageView.Number(to.Y)"
                                          stroke="@colour" stroke-width="1.8" opacity="0.7" pointer-events="none"/>
                                    <line x1="@Percent(from.X)" y1="@UsageView.Number(from.Y)" x2="@Percent(to.X)" y2="@UsageView.Number(to.Y)"
                                          stroke="transparent" stroke-width="12" class="cursor-pointer" data-testid="usage-feed-line"
                                          @onclick="() => Pick(plot.Line)" @onclick:stopPropagation="true">
                                        <title>@plot.Line.Name: click to show only its runs</title>
                                    </line>
                                }
                                @foreach (var dot in plot.Dots)
                                {
                                    <g class="cursor-pointer" data-testid="usage-feed-dot" data-run="@dot.Run.Run" @onclick="() => Open(plot.Line, dot)" @onclick:stopPropagation="true">
                                        @if (Ring(dot.Run) is Some<string>(var ring))
                                        {
                                            <circle cx="@Percent(dot.X)" cy="@UsageView.Number(dot.Y)" r="6.1" fill="none" stroke="@ring" stroke-width="1.8"
                                                    data-testid="usage-feed-ring"/>
                                        }
                                        <circle cx="@Percent(dot.X)" cy="@UsageView.Number(dot.Y)" r="3.3" fill="@colour"/>
                                        <circle cx="@Percent(dot.X)" cy="@UsageView.Number(dot.Y)" r="10" fill="transparent"/>
                                    </g>
                                }
                            </g>
                        }
                    </svg>
                    <BbPopover Open="_open" OpenChanged="open => _open = open">
                        <span class="pointer-events-none absolute size-0" style="@_anchor" data-testid="usage-feed-anchor">
                            <BbPopoverTrigger AsChild="false" tabindex="-1" aria-hidden="true" class="block size-0 p-0"/>
                        </span>
                        <BbPopoverContent Side="PopoverSide.Right" Align="PopoverAlign.Center" Offset="12" Class="w-auto overflow-hidden p-0">
                            @if (_shown is Some<(UsageFeedLine Line, UsageRun Run)>(var (line, run)))
                            {
                                <UsageRunDetails Line="line" Run="run"/>
                            }
                        </BbPopoverContent>
                    </BbPopover>
                </div>
                <div class="flex flex-wrap gap-x-3.5 gap-y-1 text-xs text-muted-foreground" data-testid="usage-feeds-legend">
                    @foreach (var (text, colour) in Rings)
                    {
                        <span class="inline-flex items-center gap-1.5">
                            <svg width="18" height="18" class="block shrink-0">
                                <circle cx="9" cy="9" r="7.2" fill="none" stroke="@colour" stroke-width="2.2"/>
                                <circle cx="9" cy="9" r="3.6" fill="var(--usage-shade)"/>
                            </svg>
                            @text
                        </span>
                    }
                </div>
            }
            <div>
                <div class="usage-feed text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                    <span>Feed</span>
                    <span>Calls</span>
                    <span class="text-right">Total</span>
                    <span class="text-right">Runs</span>
                    <span class="text-right">Per run</span>
                    <span class="text-right">Per title</span>
                    <span class="text-right">Unmatched</span>
                    <span class="text-right">Took</span>
                    <span>Last run</span>
                    <span></span>
                </div>
                @foreach (var (line, key) in Feeds.Select((line, index) => (line, Key(index))))
                {
                    var picked = IsPicked(line.Feed);
                    var stats = line.Stats;
                    <div class="@($"usage-feed rounded-md text-[12.5px] {(line.Runs.Count > 0 ? "cursor-pointer hover:bg-foreground/5" : string.Empty)} {(picked ? "usage-feed-picked" : string.Empty)}")"
                         style="@($"--edge: {Branding.Color(line.Provider.Service)}")" data-testid="usage-feed" data-feed="@line.Name"
                         data-f="@(line.Runs.Count > 0 ? key : null)" @onclick="() => Pick(line)" @onmouseleave="Settle">
                        <span class="flex min-w-0 items-center gap-2 font-medium">
                            @foreach (var brand in Branding.Brands(line.Provider.Service).Take(1))
                            {
                                <BrandedLogo Brand="brand" Size="18" Decorative="true"/>
                            }
                            <span class="truncate">@line.Name</span>
                        </span>
                        @if (stats.Calls > 0)
                        {
                            <span>
                                <UsageOutcomeBar Tally="Tally(line)" Width="Math.Max(2, stats.Calls * 100.0 / Busiest)">
                                    <Title>
                                        @foreach (var brand in Branding.Brands(line.Provider.Service).Take(1))
                                        {
                                            <BrandedLogo Brand="brand" Size="14" Decorative="true"/>
                                        }
                                        @line.Name
                                    </Title>
                                </UsageOutcomeBar>
                            </span>
                        }
                        else
                        {
                            <span class="text-xs text-muted-foreground">No runs</span>
                        }
                        <span class="text-right tabular-nums">@UsageView.Count(stats.Calls)</span>
                        <span class="text-right tabular-nums text-muted-foreground">@line.Runs.Count</span>
                        <span class="text-right font-semibold tabular-nums">@UsageView.Count(stats.CallsPerRun)</span>
                        <span class="text-right tabular-nums">@FormattableString.Invariant($"{stats.CallsPerTitle:0.0}")</span>
                        <span class="@($"text-right tabular-nums {(stats.CouldNotLookUp > 0 ? "font-medium text-[var(--fate-couldnot)]" : string.Empty)}")"
                              title="@UnmatchedTitle(line)" data-testid="usage-feed-unmatched">
                            @if (stats.CouldNotLookUp > 0)
                            {
                                <LucideIcon Name="rotate-cw" Size="11" Class="mr-0.5 inline"/>
                            }
                            @UsageView.Count(stats.Unmatched) <span class="text-muted-foreground">· @FormattableString.Invariant($"{stats.UnmatchedShare * 100:0.#}%")</span>
                        </span>
                        <span class="text-right tabular-nums text-muted-foreground">@(line.Runs.Count > 0 ? UsageView.Duration(stats.Took.TotalMilliseconds) : string.Empty)</span>
                        <span class="flex min-w-0 items-center gap-1.5 truncate text-xs text-muted-foreground" data-testid="usage-feed-last">
                            @if (!line.Enabled)
                            {
                                <LucideIcon Name="pause" Size="12"/>
                            }
                            @line.LastRun.Map(at => UsageView.Clock(at, Clock.Now)).GetValueOr("Never ran")
                        </span>
                        <a class="flex items-center justify-center rounded text-muted-foreground hover:text-foreground" href="@RunsOf(line.Feed)"
                           title="Open the run history" data-testid="usage-feed-runs" @onclick:stopPropagation="true">
                            <LucideIcon Name="chevron-right" Size="15"/>
                        </a>
                    </div>
                }
            </div>
        </div>
    </ChildContent>
</UsageCard>

@code {
    private const int PlotLeft = 46;

    private const int PlotHeight = 170;

    private const int PlotTop = 8;

    private const int MostTicks = 8;

    private static readonly IReadOnlyList<(FeedsTab Value, string Label)> Tabs = [(FeedsTab.Calls, "Calls per run"), (FeedsTab.Unmatched, "Unmatched per run")];

    [Parameter] [EditorRequired] public required IReadOnlyList<UsageFeedLine> Feeds { get; set; }

    [Parameter] [EditorRequired] public required UsageRange Range { get; set; }

    [Parameter] [EditorRequired] public required UsageWindow Window { get; set; }

    private FeedsTab _tab = FeedsTab.Calls;

    private Optional<FeedId> _picked = new None();

    private bool _open;

    private bool _quiet;

    private Optional<(UsageFeedLine Line, UsageRun Run)> _shown = new None();

    private string _anchor = string.Empty;

    private string Subtitle =>
        $"Point at a feed or its line to pick it out, click to keep only its runs, click again for all. A dot opens that run. Per run and per title are the typical run over the {UsageView.Window(Range)}.";

    private long Busiest => Feeds.Select(line => line.Stats.Calls).DefaultIfEmpty(1).Max();

    private IReadOnlyList<Plot> Plotted
    {
        get
        {
            var top = Ceiling;
            var span = Span;
            return
            [
                .. Feeds
                    .Select((line, index) => (line, index))
                    .Where(feed => feed.line.Runs.Count > 0)
                    .Select(feed => new Plot(
                        feed.line,
                        Key(feed.index),
                        [.. feed.line.Runs.OrderBy(run => run.StartedAt).Select(run => new Dot(run, Across(run.StartedAt, span), Down(Value(run), top)))]
                    )),
            ];
        }
    }

    private double Ceiling
    {
        get
        {
            var highest = Feeds.SelectMany(line => line.Runs).Select(Value).DefaultIfEmpty(0).Max();
            return _tab is FeedsTab.Calls ? Math.Max(1, Math.Ceiling(Math.Log10(Math.Max(1, highest)))) : Math.Max(20, Math.Ceiling(highest / 20) * 20);
        }
    }

    private IReadOnlyList<(double Y, string Label)> YTicks
    {
        get
        {
            var top = Ceiling;
            return _tab is FeedsTab.Calls
                ? [.. Enumerable.Range(0, (int)top + 1).Select(decade => (Down(Math.Pow(10, decade), top), UsageView.Count(Math.Pow(10, decade))))]
                : [.. Enumerable.Range(0, (int)(top / 20) + 1).Select(step => (Down(step * 20, top), $"{step * 20}%"))];
        }
    }

    private int FirstSlot => Math.Max(0, Window.SlotOf(Feeds.SelectMany(line => line.Runs).Select(run => run.StartedAt).DefaultIfEmpty(Window.From).Min()));

    private IReadOnlyList<(double At, string Label)> XTicks
    {
        get
        {
            var first = FirstSlot;
            var span = Span;
            var shown = Window.Slots - first;
            var every = Math.Max(1, (int)Math.Ceiling(shown / (double)MostTicks));
            return
            [
                .. Enumerable
                    .Range(first, shown)
                    .Where(slot => slot % every == 0)
                    .Select(slot => (Across(Window.SlotAt(slot), span), UsageView.Slot(Range, Window.SlotAt(slot)))),
            ];
        }
    }

    private IReadOnlyList<(string Text, string Colour)> Rings =>
        _tab is FeedsTab.Calls
            ? [("A ring: some calls were rate-limited", "var(--usage-after-429)"), ("some gave up", "var(--usage-gave-up)")]
            : [("A ring: some titles could not be looked up", "var(--fate-couldnot)")];

    private string HoverRules => string.Concat(Feeds.Select((_, index) => Rules(Key(index))));

    private string Rules(string key)
    {
        var row = $".usage-feeds:has(.usage-feed-group[data-f={key}]:hover) .usage-feed[data-f={key}] {{ background: color-mix(in oklch, var(--foreground) 5%, transparent); }} ";
        var traced = $".usage-feeds:has(.usage-feed[data-f={key}]:hover) .usage-feed-group[data-f={key}] {{ filter: none; opacity: 1; }} ";
        var singled =
            $".usage-feeds:has([data-f={key}]:hover) .usage-feed-group:not([data-f={key}]) {{ filter: grayscale(1); opacity: 0.3; }} "
            + $".usage-feeds:has([data-f={key}]:hover) .usage-feed-group[data-f={key}] {{ filter: none; opacity: 1; }} ";
        return _picked.Match(_ => $"{traced}{row}", () => _quiet ? row : $"{singled}{row}");
    }

    private double Value(UsageRun run) => _tab is FeedsTab.Calls ? Math.Max(1, run.Calls.Total) : Unmatched(run);

    private static double Unmatched(UsageRun run) => run.Titles == 0 ? 0 : (run.NotFound + run.CouldNotLookUp) * 100.0 / run.Titles;

    private double Down(double value, double top)
    {
        var share = _tab is FeedsTab.Calls ? Math.Log10(Math.Max(1, value)) / top : value / top;
        return PlotTop + ((PlotHeight - PlotTop) * (1 - share));
    }

    private (DateTimeOffset From, DateTimeOffset To) Span => (Window.SlotAt(FirstSlot), Clock.Now < Window.To ? Clock.Now : Window.To);

    private static double Across(DateTimeOffset at, (DateTimeOffset From, DateTimeOffset To) span) => Math.Clamp((at - span.From) / (span.To - span.From), 0, 1);

    private Optional<string> Ring(UsageRun run)
    {
        return (_tab, run.Calls.Of(UsageOutcome.GaveUpOn429) > 0, run.Calls.RateLimited > 0, run.CouldNotLookUp > 0) switch
        {
            (FeedsTab.Calls, true, _, _) => Some.Of("var(--usage-gave-up)"),
            (FeedsTab.Calls, false, true, _) => Some.Of("var(--usage-after-429)"),
            (FeedsTab.Unmatched, _, _, true) => Some.Of("var(--fate-couldnot)"),
            _ => new None(),
        };
    }

    private bool IsPicked(FeedId feed) => _picked.Match(picked => picked == feed, () => false);

    private bool IsLit(FeedId feed) => _picked.Match(picked => picked == feed, () => true);

    private void Pick(UsageFeedLine line)
    {
        if (line.Runs.Count > 0)
        {
            var unpicking = IsPicked(line.Feed);
            _quiet = unpicking;
            _picked = Optional.When(!unpicking, () => line.Feed);
        }
    }

    private void Settle() => _quiet = false;

    private void Open(UsageFeedLine line, Dot dot)
    {
        _anchor = $"left: {AtX(dot.X)}; top: {UsageView.Number(dot.Y)}px";
        _shown = Some.Of((line, dot.Run));
        _open = true;
    }

    private static string Key(int index) => $"f{index}";

    private static string Percent(double share) => FormattableString.Invariant($"{share * 100:0.###}%");

    private static string AtX(double share) => FormattableString.Invariant($"calc({PlotLeft}px + (100% - {PlotLeft}px) * {share:0.####})");

    private static UsageTally Tally(UsageFeedLine line) => UsageTally.Sum(line.Runs.Select(run => run.Calls));

    private string UnmatchedTitle(UsageFeedLine line)
    {
        var typical = $"Typical run: {UsageView.Count(line.Stats.Unmatched)} titles unmatched.";
        return line.Stats.CouldNotLookUp > 0
            ? $"{typical} Over the {UsageView.Window(Range)}, {UsageView.Count(line.Stats.CouldNotLookUp)} could not even be looked up."
            : $"{typical} Every one was not found by any service.";
    }

    private static string RunsOf(FeedId feed) => $"/feeds/{UrlGuid.Encode(feed.Value)}/runs";

    private enum FeedsTab
    {
        Calls,
        Unmatched,
    }

    private sealed record Dot(UsageRun Run, double X, double Y);

    private sealed record Plot(UsageFeedLine Line, string Key, IReadOnlyList<Dot> Dots);
}
