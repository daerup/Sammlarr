@using Contracts
@using Contracts.Usage
@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding
@inject IDateTimeProvider Clock

<UsageCard Title="Services" Subtitle="Rate, errors and duration per service, busiest first" TestId="usage-services">
    <div>
        <div class="usage-row text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
            <span>Service</span>
            <span>Calls by how they ended</span>
            <span class="text-right">Calls</span>
            <span class="text-right">Errors</span>
            <span class="text-right">p95</span>
            <span class="text-right">Rate-limited</span>
            <span>Right now</span>
        </div>
        @foreach (var line in Period.Services)
        {
            var tally = line.Tally;
            var now = UsageView.RightNow(line.RightNow, Clock.Now);
            <div class="usage-row border-t text-[12.5px]" data-testid="usage-service" data-service="@line.Service">
                <span class="flex min-w-0 items-center gap-2 whitespace-nowrap font-medium">
                    <BrandedLogo Brand="Branding.GetBrandingInfo(line.Service)" Size="18" Decorative="true"/>
                    @Branding.GetBrandingInfo(line.Service).NickName
                </span>
                <span class="flex h-2.5 gap-0.5" style="@FormattableString.Invariant($"width: {Math.Max(1, tally.Total * 100.0 / Busiest)}%")">
                    @foreach (var look in UsageView.Outcomes.Where(look => tally.Of(look.Outcome) > 0))
                    {
                        <span class="min-w-0.5 rounded-[2px]" style="@($"flex: {tally.Of(look.Outcome)}; background: {look.Color}")"
                              title="@($"{look.Name}: {UsageView.Count(tally.Of(look.Outcome))}")"></span>
                    }
                </span>
                <span class="text-right tabular-nums">@UsageView.Count(tally.Total)</span>
                <span class="@Tone(tally.Errors, tally.Total, "text-[var(--usage-failed)] font-medium")">@UsageView.Share(tally.Errors, tally.Total)</span>
                <span class="text-right tabular-nums text-muted-foreground">@tally.Percentile(0.95).Map(p95 => UsageView.Duration(p95)).GetValueOr("n/a")</span>
                <span class="@Tone(tally.RateLimited, tally.Total, "text-[var(--usage-gave-up)] font-medium")">@UsageView.Share(tally.RateLimited, tally.Total)</span>
                <span class="@($"flex min-w-0 items-center gap-1.5 overflow-hidden text-xs text-ellipsis whitespace-nowrap {NowColour(now.Tone)}")" data-testid="usage-right-now">
                    @if (now.Icon is Some<string>(var icon))
                    {
                        <LucideIcon Name="@icon" Size="12"/>
                    }
                    @now.Text
                </span>
            </div>
        }
    </div>
    @if (Silent.Count > 0)
    {
        <div class="flex flex-wrap items-center gap-2 border-t pt-2 text-xs text-muted-foreground" data-testid="usage-silent">
            <span>No calls in the @UsageView.Window(Range):</span>
            @foreach (var service in Silent)
            {
                <span class="inline-flex items-center gap-1.5">
                    <BrandedLogo Brand="Branding.GetBrandingInfo(service)" Size="16" Decorative="true"/>
                    @Branding.GetBrandingInfo(service).NickName
                </span>
            }
        </div>
    }
</UsageCard>

@code {
    private const double Noticeable = 0.01;

    [Parameter] [EditorRequired] public required UsagePeriod Period { get; set; }

    [Parameter] [EditorRequired] public required UsageRange Range { get; set; }

    private long Busiest => Period.Services.Select(line => line.Tally.Total).DefaultIfEmpty(1).Max();

    private IReadOnlyList<RemoteService> Silent => [.. Enum.GetValues<RemoteService>().Except(Period.Services.Select(line => line.Service))];

    private static string Tone(long part, long total, string trouble)
    {
        var share = total == 0 ? 0 : (double)part / total;
        var colour = (share > Noticeable, part) switch
        {
            (true, _) => trouble,
            (false, 0) => "text-muted-foreground",
            _ => string.Empty,
        };
        return $"text-right tabular-nums {colour}";
    }

    private static string NowColour(RightNowTone tone)
    {
        return tone switch
        {
            RightNowTone.Plain => "text-muted-foreground",
            RightNowTone.Paused => "text-[var(--usage-gave-up)]",
            RightNowTone.Down => "text-[var(--usage-failed)]",
        };
    }
}
