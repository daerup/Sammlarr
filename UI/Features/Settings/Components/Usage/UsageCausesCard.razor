@using Contracts.Usage

<UsageCard Title="Calls by cause" Subtitle="Pick a cause to see how its calls ended" TestId="usage-causes">
    <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] items-stretch gap-[22px]">
        <div>
            <div class="usage-cause pl-3 pr-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                <span>Cause</span>
                <span></span>
                <span class="text-right">Calls</span>
                <span class="text-right">Trouble</span>
            </div>
            @foreach (var (cause, tally) in Rows)
            {
                var picked = cause == Current;
                var (name, icon) = Describe(cause);
                <button type="button" class="@($"usage-cause w-full cursor-pointer rounded-md pl-3 pr-1 text-left text-[12.5px] hover:bg-foreground/5 {(picked ? "usage-cause-picked" : string.Empty)}")"
                        aria-pressed="@(picked ? "true" : "false")" data-testid="usage-cause" @onclick="() => _picked = cause">
                    <span class="@($"flex min-w-0 items-center gap-2 whitespace-nowrap {(cause is null ? "font-semibold" : "font-medium")}")">
                        <LucideIcon Name="@icon" Size="14"/>
                        @name
                    </span>
                    <span>
                        @if (cause is not null)
                        {
                            <span class="block h-2 rounded-[3px]" style="@FormattableString.Invariant($"width: {Math.Max(2, tally.Total * 100.0 / Busiest)}%; background: {(picked ? UsageView.Accent : "var(--usage-answered)")}")"></span>
                        }
                    </span>
                    <span class="text-right tabular-nums">@UsageView.Count(tally.Total)</span>
                    <span class="@($"text-right tabular-nums {(Trouble(tally) * 100 > tally.Total ? "font-medium text-[var(--usage-gave-up)]" : "text-muted-foreground")}")"
                          title="Hit trouble">@UsageView.Share(Trouble(tally), tally.Total)</span>
                </button>
            }
        </div>
        <div class="flex h-full flex-col gap-2.5">
            <div class="text-[13px] font-semibold" data-testid="usage-cause-picked">
                @Describe(Current).Name <span class="font-normal text-muted-foreground">· @UsageView.Count(Picked.Total) calls</span>
            </div>
            <div class="flex flex-1 items-center justify-center gap-6">
                @if (Slices.Count > 0)
                {
                    <div class="w-[170px]" style="@Palette" data-testid="usage-donut">
                        <BbPieChart Data="Slices" Height="170px" EnableAnimations="false">
                            <BbChartTooltip AppendToBody="true"/>
                            <BbPie DataKey="Calls" NameKey="Name" InnerRadius="68" OuterRadius="92" PaddingAngle="1">
                                <BbCenterLabel Value="@CentreValue" Title="@CentreTitle" FontSize="20"/>
                            </BbPie>
                        </BbPieChart>
                    </div>
                }
                else
                {
                    <div class="w-[156px] text-[12.5px] text-muted-foreground">Nothing to show: every outcome is struck out.</div>
                }
                <div class="flex w-[290px] flex-col gap-1.5 text-[12.5px]" data-testid="usage-outcomes">
                    @foreach (var look in UsageView.Outcomes)
                    {
                        var off = _struck.Contains(look.Outcome);
                        <button type="button" class="@($"usage-outcome cursor-pointer rounded text-left hover:bg-foreground/5 {(off ? "usage-outcome-off" : string.Empty)}")"
                                aria-pressed="@(off ? "false" : "true")" title="@($"{(off ? "Show" : "Hide")} {look.Name} in the donut")"
                                data-testid="usage-outcome" @onclick="() => Toggle(look.Outcome)">
                            <span class="usage-swatch" style="@($"background: {look.Color}")"></span>
                            <LucideIcon Name="@look.Icon" Size="13"/>
                            <span class="usage-strike">@look.Name</span>
                            <span class="usage-strike text-right tabular-nums">@UsageView.Count(Picked.Of(look.Outcome))</span>
                            <span class="text-right tabular-nums text-muted-foreground">@(off ? string.Empty : UsageView.Share(Picked.Of(look.Outcome), ShownTotal))</span>
                        </button>
                    }
                    <span class="mt-1 text-[11px] text-muted-foreground">Click an outcome to strike it out of the donut.</span>
                </div>
            </div>
        </div>
    </div>
</UsageCard>

@code {
    [Parameter] [EditorRequired] public required UsagePeriod Period { get; set; }

    private UsageCause? _picked;

    private readonly HashSet<UsageOutcome> _struck = [];

    private IReadOnlyList<(UsageCause? Cause, UsageTally Tally)> Rows =>
        [(null, Period.Tally), .. Period.Causes.Select(line => ((UsageCause?)line.Cause, line.Tally))];

    private long Busiest => Period.Causes.Select(line => line.Tally.Total).DefaultIfEmpty(1).Max();

    private UsageCause? Current => Period.Causes.Any(line => line.Cause == _picked) ? _picked : null;

    private UsageTally Picked => Period.Causes.FirstOrNone(line => line.Cause == Current).Map(line => line.Tally).GetValueOr(Period.Tally);

    private IReadOnlyList<OutcomeLook> Shown => [.. UsageView.Outcomes.Where(look => !_struck.Contains(look.Outcome))];

    private long ShownTotal => Shown.Sum(look => Picked.Of(look.Outcome));

    private IReadOnlyList<Slice> Slices => [.. Shown.Where(look => Picked.Of(look.Outcome) > 0).Select(look => new Slice(look.Name, Picked.Of(look.Outcome), look.Color))];

    private string Palette => string.Join("; ", Slices.Select((slice, index) => $"--chart-{index + 1}: {slice.Color}"));

    private string CentreValue => _struck.Count == 0 ? UsageView.Share(Picked.Answered, Picked.Total) : UsageView.Count(ShownTotal);

    private string CentreTitle => _struck.Count == 0 ? "got an answer" : $"of {UsageView.Count(Picked.Total)} calls";

    private static long Trouble(UsageTally tally) => tally.Total - tally.Of(UsageOutcome.Answered);

    private static (string Name, string Icon) Describe(UsageCause? cause) => Optional.Of(cause).Map(found => UsageView.Cause(found)).GetValueOr(("All causes", "layers"));

    private void Toggle(UsageOutcome outcome)
    {
        if (!_struck.Remove(outcome))
        {
            _struck.Add(outcome);
        }
    }

    private sealed record Slice(string Name, long Calls, string Color);
}
