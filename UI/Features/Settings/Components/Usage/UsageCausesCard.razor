@using Contracts.Usage
@using Domain.Usage

<UsageCard Title="Calls by cause" Subtitle="Pick a cause to see how its calls ended" TestId="usage-causes">
    <div class="grid grid-cols-[minmax(0,1fr)_max-content] items-start gap-7">
        <div>
            <div class="usage-cause pl-3 pr-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                <span>Cause</span>
                <span></span>
                <span class="text-right">Calls</span>
                <span class="text-right">Trouble</span>
            </div>
            @foreach (var (cause, tally) in Rows)
            {
                var picked = cause == Current;
                var (name, icon) = Describe(cause);
                var hint = Optional.Of(cause).Map(found => UsageView.CauseHint(found));
                <button type="button" class="@($"usage-cause w-full cursor-pointer rounded-md pl-3 pr-1 text-left text-[12.5px] hover:bg-foreground/5 {(picked ? "usage-cause-picked" : string.Empty)}")"
                        aria-pressed="@(picked ? "true" : "false")" data-testid="usage-cause" @onclick="() => _picked = cause">
                    <span class="@($"flex min-w-0 items-center gap-2 whitespace-nowrap {Weight(cause)}")">
                        <LucideIcon Name="@icon" Size="14"/>
                        @if (hint is Some<string>(var text))
                        {
                            <BbTooltip DelayDuration="200">
                                <BbTooltipTrigger Focusable="false">
                                    <span data-testid="usage-cause-hinted">@name</span>
                                </BbTooltipTrigger>
                                <BbTooltipContent Class="max-w-72">@text</BbTooltipContent>
                            </BbTooltip>
                        }
                        else
                        {
                            @name
                        }
                    </span>
                    <span>
                        @if (cause is not null)
                        {
                            <span class="block h-2 rounded-[3px]" style="@FormattableString.Invariant($"width: {Math.Max(2, tally.Total * 100.0 / Busiest)}%; background: {(picked ? UsageView.Accent : "var(--usage-answered)")}")"></span>
                        }
                    </span>
                    <span class="text-right tabular-nums">@UsageView.Count(tally.Total)</span>
                    <span class="@($"text-right tabular-nums {(Trouble(tally) * 100 > tally.Total ? "font-medium text-[var(--usage-gave-up)]" : "text-muted-foreground")}")"
                          title="Hit trouble">@UsageView.Share(Trouble(tally), tally.Total)</span>
                </button>
            }
        </div>
        <div class="flex flex-col items-center gap-3.5">
            <div class="flex items-center gap-2 text-[13px] font-semibold" data-testid="usage-cause-picked">
                <LucideIcon Name="@Describe(Current).Icon" Size="14"/>
                @Describe(Current).Name <span class="font-normal text-muted-foreground">· @UsageView.Calls(Picked.Total)</span>
            </div>
            <UsageGauge Tally="Picked"/>
            <div class="flex flex-col gap-1.5 text-[12.5px]" data-testid="usage-outcomes">
                @if (Trouble(Picked) == 0)
                {
                    <div class="usage-outcome" data-testid="usage-outcome">
                        <span class="usage-swatch" style="background: var(--usage-answered)"></span>
                        <LucideIcon Name="check" Size="13"/>
                        <span>Answered</span>
                        <span class="text-right tabular-nums">@UsageView.Count(Picked.Total)</span>
                        <span class="text-right tabular-nums text-muted-foreground">@UsageView.Share(Picked.Total, Picked.Total)</span>
                    </div>
                    <div class="flex items-center gap-2 text-muted-foreground" data-testid="usage-no-trouble">
                        <LucideIcon Name="circle-check" Size="14"/>
                        <span><span class="font-medium text-foreground">No trouble:</span> all @UsageView.Calls(Picked.Total) were answered.</span>
                    </div>
                }
                else
                {
                    @foreach (var look in UsageView.Outcomes)
                    {
                        var count = Picked.Of(look.Outcome);
                        <div class="@($"usage-outcome {(count == 0 ? "opacity-40" : string.Empty)}")" data-testid="usage-outcome" data-empty="@(count == 0 ? "true" : "false")">
                            <span class="usage-swatch" style="@($"background: {look.Color}")"></span>
                            <LucideIcon Name="@look.Icon" Size="13"/>
                            <span>@look.Name</span>
                            <span class="text-right tabular-nums">@UsageView.Count(count)</span>
                            <span class="text-right tabular-nums text-muted-foreground">@(count == 0 ? string.Empty : UsageView.Share(count, Picked.Total))</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</UsageCard>

@code {
    [Parameter] [EditorRequired] public required UsagePeriod Period { get; set; }

    private UsageCause? _picked;

    private IReadOnlyList<(UsageCause? Cause, UsageTally Tally)> Rows =>
        [(null, Period.Tally), .. Period.Causes.Select(line => ((UsageCause?)line.Cause, line.Tally))];

    private long Busiest => Period.Causes.Select(line => line.Tally.Total).DefaultIfEmpty(1).Max();

    private UsageCause? Current => Period.Causes.Any(line => line.Cause == _picked) ? _picked : null;

    private UsageTally Picked => Period.Causes.FirstOrNone(line => line.Cause == Current).Map(line => line.Tally).GetValueOr(Period.Tally);

    private static long Trouble(UsageTally tally) => tally.Total - tally.Of(UsageOutcome.Answered);

    private static string Weight(UsageCause? cause) => Optional.Of(cause).Map(found => Weight(found)).GetValueOr("font-semibold");

    private static string Weight(UsageCause cause)
    {
        return cause switch
        {
            UsageCause.Other => "font-medium text-muted-foreground",
            UsageCause.FeedRun or UsageCause.WantlistSync or UsageCause.Dataset or UsageCause.Search or UsageCause.Browse or UsageCause.ShowingTitles
                or UsageCause.KeyTest or UsageCause.FeedEditor => "font-medium",
        };
    }

    private static (string Name, string Icon) Describe(UsageCause? cause) => Optional.Of(cause).Map(found => UsageView.Cause(found)).GetValueOr(("All causes", "layers"));
}
