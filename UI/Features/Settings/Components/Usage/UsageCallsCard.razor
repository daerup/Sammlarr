@using Contracts
@using Contracts.Datasets
@using Contracts.Usage
@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding
@inject IDateTimeProvider Clock

<UsageCard Title="@(_tab is CallsTab.Calls ? "Calls" : "Answer time")" Subtitle="@Subtitle" TestId="usage-calls">
    <Chip>
        @if (Picked is Some<RemoteService>(var service))
        {
            <UsagePickChip Service="service" OnClear="() => PickedChanged.InvokeAsync(new None())"/>
        }
    </Chip>
    <Right>
        <UsageSegments TValue="CallsTab" Value="_tab" Options="Tabs" OnChange="tab => _tab = tab" Label="Calls card view"/>
    </Right>
    <ChildContent>
        @if (Missing is Some<RemoteService>(var missing))
        {
            <span class="text-[12.5px] text-muted-foreground" data-testid="usage-calls-none">No @Name(missing) calls in the @UsageView.Window(Range).</span>
            @if (Panel(missing) is Some<UsageQuota>(var quota))
            {
                @QuotaPanel((quota, []))
            }
        }
        else if (_tab is CallsTab.Calls)
        {
            <div class="flex flex-wrap gap-x-3.5 gap-y-1 text-xs text-muted-foreground" data-testid="usage-outcome-legend">
                @foreach (var look in UsageView.Outcomes)
                {
                    <span class="inline-flex items-center gap-1.5">
                        <span class="size-2.5 rounded-[3px]" style="background: @look.Color"></span>
                        <LucideIcon Name="@look.Icon" Size="11"/>
                        @look.Name
                    </span>
                }
            </div>
            <BbBarChart Data="Columns" Height="180px">
                <BbGrid Left="4" Right="4" Top="10" Bottom="0"/>
                <BbXAxis DataKey="At"/>
                <BbYAxis/>
                <BbChartTooltip AppendToBody="true"/>
                @foreach (var look in UsageView.Outcomes)
                {
                    <BbBar DataKey="@look.Outcome.ToString()" Name="@look.Name" Color="@look.Color" Stacked="true"/>
                }
            </BbBarChart>
        }
        else
        {
            <div class="relative">
                <BbBarChart Data="Durations" Height="190px">
                    <BbGrid Left="@($"{PlotLeft}")" Right="@($"{PlotRight}")" Top="@($"{PlotTop}")" Bottom="@($"{PlotBottom}")" ContainLabel="false"/>
                    <BbXAxis DataKey="Bucket"/>
                    <BbYAxis/>
                    <BbChartTooltip AppendToBody="true"/>
                    <BbBar DataKey="Calls" Name="Attempts" Color="var(--usage-shade)" BorderRadius="3"/>
                </BbBarChart>
                @foreach (var mark in Marks)
                {
                    <div class="pointer-events-none absolute border-l-[1.6px] border-dashed" data-testid="usage-latency-mark"
                         style="@($"left: {mark.Left}; top: {PlotTop}px; bottom: {PlotBottom}px; border-color: {mark.Colour}")">
                        <span class="absolute left-1.5 whitespace-nowrap text-[11px] font-semibold" style="@($"top: {mark.Row * 14}px; color: {mark.Colour}")">@mark.Label</span>
                    </div>
                }
            </div>
        }
        <div class="mt-1.5">
            <div class="usage-service pl-3 pr-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                <span>Service</span>
                <span>How they ended</span>
                <span class="text-right">Calls</span>
                <span class="text-right">Errors</span>
                <UsageAnswerTimeHead/>
                <span class="text-right">Limited</span>
                <span>Right now</span>
            </div>
            @foreach (var line in Period.Services)
            {
                var tally = line.Tally;
                var now = UsageView.RightNow(line.RightNow, Clock.Now);
                var picked = IsPicked(line.Service);
                var open = Panel(line.Service).When(_ => picked);
                <div class="@($"usage-service cursor-pointer rounded-md pl-3 pr-1 text-[12.5px] hover:bg-foreground/5 {(picked ? "usage-service-picked" : string.Empty)}")"
                     data-testid="usage-service" data-service="@line.Service" data-picked="@(picked ? "true" : "false")" @onclick="() => PickAsync(line.Service)">
                    <span class="flex min-w-0 items-center gap-2 whitespace-nowrap font-medium">
                        <BrandedLogo Brand="Branding.GetBrandingInfo(line.Service)" Size="18" Decorative="true"/>
                        @Branding.GetBrandingInfo(line.Service).NickName
                        @if (open is Some<UsageQuota>)
                        {
                            <LucideIcon Name="chevron-up" Size="14" Class="ml-auto text-muted-foreground"/>
                        }
                    </span>
                    <span>
                        <UsageOutcomeBar Tally="tally" Width="tally.Total * 100.0 / Busiest">
                            <Title>
                                <BrandedLogo Brand="Branding.GetBrandingInfo(line.Service)" Size="14" Decorative="true"/>
                                @Branding.GetBrandingInfo(line.Service).NickName
                            </Title>
                        </UsageOutcomeBar>
                    </span>
                    <span class="text-right tabular-nums">@UsageView.Count(tally.Total)</span>
                    <span class="@UsageView.Tone(tally.Errors, tally.Total, "text-[var(--usage-failed)] font-medium")">@UsageView.Share(tally.Errors, tally.Total)</span>
                    <span>
                        <UsageAnswerStrip Service="line.Service" Tally="tally"/>
                    </span>
                    <span class="@UsageView.Tone(tally.RateLimited, tally.Total, "text-[var(--usage-gave-up)] font-medium")">@UsageView.Share(tally.RateLimited, tally.Total)</span>
                    <span class="@($"flex min-w-0 items-center gap-1.5 overflow-hidden text-xs text-ellipsis whitespace-nowrap {NowColour(now.Tone)}")" data-testid="usage-right-now">
                        @if (now.Icon is Some<string>(var icon))
                        {
                            <LucideIcon Name="@icon" Size="12"/>
                        }
                        @now.Text
                    </span>
                </div>
                @if (open is Some<UsageQuota>(var quota))
                {
                    @QuotaPanel((quota, line.Slots))
                }
            }
        </div>
        @if (Silent.Count > 0)
        {
            <div class="flex flex-wrap items-center gap-2 border-t pt-2 text-xs text-muted-foreground" data-testid="usage-silent">
                <span>No calls in the @UsageView.Window(Range):</span>
                @foreach (var service in Silent)
                {
                    <span class="inline-flex items-center gap-1.5">
                        <BrandedLogo Brand="Branding.GetBrandingInfo(service)" Size="16" Decorative="true"/>
                        @Branding.GetBrandingInfo(service).NickName
                    </span>
                }
            </div>
        }
    </ChildContent>
</UsageCard>

@code {
    private const int PlotLeft = 48;

    private const int PlotRight = 4;

    private const int PlotTop = 10;

    private const int PlotBottom = 24;

    private static readonly IReadOnlyList<(CallsTab Value, string Label)> Tabs = [(CallsTab.Calls, "Calls"), (CallsTab.AnswerTime, "Answer time")];

    [Parameter] [EditorRequired] public required UsagePeriod Period { get; set; }

    [Parameter] [EditorRequired] public required UsageRange Range { get; set; }

    [Parameter] public IReadOnlyList<UsageQuota> Quotas { get; set; } = [];

    [Parameter] public Optional<RemoteService> Picked { get; set; } = new None();

    [Parameter] public EventCallback<Optional<RemoteService>> PickedChanged { get; set; }

    private CallsTab _tab = CallsTab.Calls;

    private Optional<UsageServiceLine> PickedLine => Picked.Map(service => Period.Services.FirstOrNone(line => line.Service == service));

    private Optional<RemoteService> Missing => Picked.When(service => Period.Services.All(line => line.Service != service));

    private string Subtitle =>
        Picked.Match(service => $"{Name(service)}: {Described}. Click {Name(service)} again, or the × on its chip, for every service.", () => Everyone);

    private string Described =>
        _tab is CallsTab.Calls ? $"{UsageView.Window(Range)}, each {UsageView.Each(Range)} split by how its calls ended" : "every attempt by how long it took";

    private string Everyone =>
        _tab is CallsTab.Calls
            ? $"All services: {Described}. Click a service to show only its calls, click it again for all."
            : $"All but datasets: {Described}. Click a service to show only its answers.";

    private IReadOnlyList<Column> Columns =>
        [
            .. PickedLine
                .Map(line => line.Slots)
                .GetValueOr(Period.Slots)
                .Select(slot => new Column(
                    UsageView.Slot(Range, slot.At),
                    slot.Tally.Of(UsageOutcome.Answered),
                    slot.Tally.Of(UsageOutcome.AnsweredAfter429),
                    slot.Tally.Of(UsageOutcome.GaveUpOn429),
                    slot.Tally.Of(UsageOutcome.Failed),
                    slot.Tally.Of(UsageOutcome.Cancelled)
                )),
        ];

    private UsageTally Answers =>
        PickedLine
            .Map(line => line.Tally)
            .GetValueOr(() => UsageTally.Sum(Period.Services.Where(line => !DatasetNames.ByService.ContainsKey(line.Service)).Select(line => line.Tally)));

    private IReadOnlyList<DurationColumn> Durations =>
        [.. DurationBuckets.UpToMs.Select(upTo => new DurationColumn(UsageView.Bucket(upTo), Answers.Durations.GetValueOrDefault(upTo)))];

    private IReadOnlyList<Mark> Marks =>
        [
            .. new[] { (Q: 0.5, Name: "median", Colour: "var(--foreground)"), (Q: 0.95, Name: "p95", Colour: UsageView.Accent) }
                .Select((mark, row) => Answers.Percentile(mark.Q).Map(at => new Mark(Left(at), $"{mark.Name} {UsageView.Duration(at)}", mark.Colour, row)))
                .WhereSome(),
        ];

    private long Busiest => Period.Services.Select(line => line.Tally.Total).DefaultIfEmpty(1).Max();

    private IReadOnlyList<RemoteService> Silent => [.. Enum.GetValues<RemoteService>().Except(Period.Services.Select(line => line.Service))];

    private bool IsPicked(RemoteService service) => Picked.Match(picked => picked == service, () => false);

    private Task PickAsync(RemoteService service) => PickedChanged.InvokeAsync(Optional.When(!IsPicked(service), () => service));

    private string Name(RemoteService service) => Branding.GetBrandingInfo(service).NickName;

    private Optional<UsageQuota> Panel(RemoteService service) => Quotas.FirstOrNone(quota => quota.Service == service).When(_ => Range is UsageRange.Day);

    private RenderFragment<(UsageQuota Quota, IReadOnlyList<UsageSlot> Slots)> QuotaPanel =>
        shown =>
            @<div class="usage-service-panel" data-testid="usage-quota-panel">
                <UsageQuotaSummary Quota="shown.Quota"/>
                <UsageQuotaLine Quota="shown.Quota" Window="Period.Window" Slots="shown.Slots"/>
            </div>;

    private static string Left(double milliseconds)
    {
        return FormattableString.Invariant($"calc({PlotLeft}px + (100% - {PlotLeft + PlotRight}px) * {UsageView.StripAt(milliseconds):0.####})");
    }

    private static string NowColour(RightNowTone tone)
    {
        return tone switch
        {
            RightNowTone.Plain => "text-muted-foreground",
            RightNowTone.Paused => "text-[var(--usage-gave-up)]",
            RightNowTone.Down => "text-[var(--usage-failed)]",
        };
    }

    private enum CallsTab
    {
        Calls,
        AnswerTime,
    }

    private sealed record Column(string At, long Answered, long AnsweredAfter429, long GaveUpOn429, long Failed, long Cancelled);

    private sealed record DurationColumn(string Bucket, long Calls);

    private sealed record Mark(string Left, string Label, string Colour, int Row);
}
