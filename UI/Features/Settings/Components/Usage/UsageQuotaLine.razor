@using Contracts.Usage

@if (Drawn is Some<(QuotaAllowance Allowance, QuotaDay Day)>(var (allowance, day)))
{
    var top = Ceiling(allowance, day);
    <div class="usage-quota-line relative h-[150px] text-[10.5px] leading-none text-muted-foreground" data-testid="usage-quota-line">
        <svg class="absolute top-0 overflow-visible" aria-hidden="true" style="@($"left: {PlotLeft}px; width: calc(100% - {PlotLeft + PlotRight}px); height: {Height}px")">
            <defs>
                <pattern id="usage-quota-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <rect width="5" height="5" fill="color-mix(in oklch, var(--muted-foreground) 18%, transparent)"/>
                    <rect width="2" height="5" fill="var(--muted-foreground)"/>
                </pattern>
            </defs>
            <line x1="0" x2="100%" y1="@UsageView.Number(Y(top, top))" y2="@UsageView.Number(Y(top, top))" stroke="var(--border)"/>
            <line x1="0" x2="100%" y1="@UsageView.Number(Y(0, top))" y2="@UsageView.Number(Y(0, top))" stroke="var(--border)"/>
            @foreach (var wait in Shaded(day))
            {
                <rect x="@Percent(wait.From)" y="@PlotTop" width="@Percent(wait.Until - wait.From)" height="@PlotHeight"
                      fill="color-mix(in oklch, var(--usage-gave-up) 13%, transparent)" data-testid="usage-quota-wait"/>
            }
            <svg x="0" y="@PlotTop" width="100%" height="@PlotHeight" viewBox="@($"0 0 {Span} {PlotHeight}")" preserveAspectRatio="none" class="overflow-visible">
                <path d="@Area(day, top)" fill="color-mix(in oklch, var(--foreground) 7%, transparent)"/>
                <path d="@Line(day, top)" fill="none" stroke="var(--foreground)" stroke-width="1.8" stroke-linejoin="round" vector-effect="non-scaling-stroke"
                      data-testid="usage-quota-path"/>
            </svg>
            @if (Floor(allowance) is Some<double>(var half))
            {
                <line x1="0" x2="100%" y1="@UsageView.Number(Y(half, top))" y2="@UsageView.Number(Y(half, top))" stroke="var(--muted-foreground)" stroke-width="1.4"
                      stroke-dasharray="5 4" data-testid="usage-quota-floor" data-left="@UsageView.Number(half)"/>
            }
            <line x1="0" x2="100%" y1="@UsageView.Number(Y(allowance.Reserve, top))" y2="@UsageView.Number(Y(allowance.Reserve, top))" stroke="var(--usage-gave-up)"
                  stroke-width="1.4" stroke-dasharray="5 4" data-testid="usage-quota-floor" data-left="@allowance.Reserve"/>
            @if (Gap(allowance) is Some<long>(var outside))
            {
                <rect x="@Percent(Reset)" y="@UsageView.Number(Y(top, top))" width="7" height="@UsageView.Number(Y(top - outside, top) - Y(top, top))" transform="translate(-3 0)"
                      fill="url(#usage-quota-hatch)" data-testid="usage-quota-outside"/>
            }
            <line x1="@Percent(Reset)" x2="@Percent(Reset)" y1="@(PlotTop - 14)" y2="@(PlotTop + PlotHeight)" stroke="var(--muted-foreground)" stroke-dasharray="3 3"/>
            @if (day.ReserveAt is Some<DateTimeOffset>(var reserveAt))
            {
                <line x1="@Percent(Now)" y1="@UsageView.Number(Y(allowance.Remaining, top))" x2="100%" y2="@UsageView.Number(Y(Paced(allowance, reserveAt), top))"
                      stroke="var(--foreground)" stroke-width="1.6" stroke-dasharray="3 3" data-testid="usage-quota-pace"/>
            }
            <circle cx="@Percent(Now)" cy="@UsageView.Number(Y(allowance.Remaining, top))" r="4" fill="var(--foreground)" stroke="var(--card)" stroke-width="2"/>
        </svg>
        <span class="absolute left-0 w-[34px] text-right tabular-nums" style="@TopAt(Y(top, top) - 5)">@UsageView.Count(top)</span>
        @if (Floor(allowance) is Some<double>(var floor))
        {
            <span class="absolute left-0 w-[34px] text-right tabular-nums" style="@TopAt(Y(floor, top) - 5)">@UsageView.Count(floor)</span>
            <span class="absolute whitespace-nowrap" style="@($"left: {PlotLeft + 6}px; {TopAt(Y(floor, top) - 14)}")">Filling details stops at @UsageView.Count(floor) left</span>
        }
        <span class="absolute left-0 w-[34px] text-right tabular-nums" style="@TopAt(Y(0, top) - 5)">0</span>
        @foreach (var (slot, label) in Hours)
        {
            <span class="absolute -translate-x-1/2 whitespace-nowrap" style="@($"left: {At(Middle(slot))}; top: {Height - 14}px")">@label</span>
        }
        <span class="@($"absolute whitespace-nowrap text-[var(--usage-gave-up)] {(Share(Reset) > 0.62 ? "-translate-x-full" : string.Empty)}")"
              style="@($"left: calc({At(Share(Reset))} {(Share(Reset) > 0.62 ? "- 8px" : "+ 8px")}); {TopAt(Y(allowance.Reserve, top) - 14)}")"
              data-testid="usage-quota-reserve-label">Title lookups wait at @UsageView.Count(allowance.Reserve) left, feed list pages may use the rest</span>
        <span class="absolute whitespace-nowrap" style="@($"left: calc({At(Share(Reset))} + 5px); top: {PlotTop - 16}px")">reset @UsageView.Time(Reset)</span>
        @foreach (var wait in Shaded(day).Where(wait => wait.Wait.Until <= Now))
        {
            <span class="absolute -translate-x-full whitespace-nowrap text-[var(--usage-gave-up)]" style="@($"left: calc({At(Share(wait.Until))} - 6px); {TopAt(Y(allowance.Reserve, top) - 29)}")"
                  data-testid="usage-quota-waited">Title lookups waited @UsageView.Time(wait.Wait.From) - @UsageView.Time(wait.Wait.Until)</span>
        }
        @if (Gap(allowance) is Some<long>(var gap))
        {
            <span class="absolute -translate-x-full whitespace-nowrap text-[11px] text-foreground" style="@($"left: calc({At(Share(Reset))} - 10px); {TopAt(Y(top - gap / 2.0, top) - 5)}")">
                @UsageView.Count(gap) used outside Sammlarr, time not known
            </span>
        }
        @if (Unknown(day) is Some<double>(var before))
        {
            <span class="absolute -translate-x-1/2 text-center text-[11px] leading-snug text-foreground"
                  style="@($"left: {At(before / 2)}; width: calc((100% - {PlotLeft + PlotRight}px) * {UsageView.Number(before)}); {TopAt(Y(top * 0.7, top) - 9)}")"
                  data-testid="usage-quota-unknown">Sammlarr did not see how the day before ended: its hours show after the next reset</span>
        }
        <span class="absolute -translate-x-full whitespace-nowrap text-xs font-semibold text-foreground"
              style="@($"left: calc({At(Share(Now))} - 4px); {TopAt(Y(allowance.Remaining, top) - (allowance.Remaining < top * 0.15 ? 24 : 12) - 10)}")"
              data-testid="usage-quota-now">@UsageView.Count(allowance.Remaining) left</span>
        @foreach (var hour in Hovered(day))
        {
            <div class="absolute" style="@($"left: {At(Share(hour.From))}; width: calc((100% - {PlotLeft + PlotRight}px) / {Window.Slots}); top: {PlotTop}px; height: {PlotHeight}px")">
                <BbTooltip DelayDuration="100" Placement="PopoverPlacement.Top">
                    <BbTooltipTrigger Focusable="false" Class="block size-full" style="display: block; width: 100%; height: 100%" data-testid="usage-quota-hour">
                    </BbTooltipTrigger>
                    <BbTooltipContent Class="@UsageView.Tip" data-testid="usage-quota-tip">
                        <div class="mb-1 font-semibold whitespace-nowrap">
                            @UsageView.Time(hour.From) - @UsageView.Time(hour.Until) · @UsageView.Count(hour.Before) → @UsageView.Count(hour.After) left
                        </div>
                        @if (hour.Causes.Count == 0)
                        {
                            <div class="text-muted-foreground">No calls</div>
                        }
                        else
                        {
                            <div class="mb-0.5 text-muted-foreground">Calls this hour</div>
                            @foreach (var (cause, calls) in hour.Causes)
                            {
                                <div class="grid grid-cols-[14px_minmax(0,1fr)_auto] items-center gap-1.5 leading-[1.7]" data-testid="usage-quota-tip-cause">
                                    <LucideIcon Name="@UsageView.Cause(cause).Icon" Size="12"/>
                                    <span class="whitespace-nowrap">@UsageView.Cause(cause).Name</span>
                                    <span class="pl-3 text-right font-medium tabular-nums">@UsageView.Count(calls)</span>
                                </div>
                            }
                        }
                    </BbTooltipContent>
                </BbTooltip>
            </div>
        }
    </div>
}

@code {
    private const int Height = 150;

    private const int PlotTop = 20;

    private const int PlotHeight = 110;

    private const int PlotLeft = 40;

    private const int PlotRight = 6;

    private const int Span = 1000;

    [Parameter] [EditorRequired] public required UsageQuota Quota { get; set; }

    [Parameter] [EditorRequired] public required UsageWindow Window { get; set; }

    [Parameter] public IReadOnlyList<UsageSlot> Slots { get; set; } = [];

    private Optional<(QuotaAllowance Allowance, QuotaDay Day)> Drawn => Quota.Today.Answered.Map(allowance => Quota.Day.Map(day => (allowance, day)));

    private DateTimeOffset Now => Quota.Day.Map(day => day.Points[^1].At).GetValueOr(Quota.Today.NextReset);

    private DateTimeOffset Reset => OnTheHour(Quota.Today.NextReset.AddDays(-1));

    private static DateTimeOffset OnTheHour(DateTimeOffset at) => at.AddTicks(-(at.UtcTicks % TimeSpan.TicksPerHour));

    private IEnumerable<(int Slot, string Label)> Hours
    {
        get
        {
            return Enumerable.Range(0, Window.Slots).Where(slot => slot % 3 == 0).Select(slot => (slot, UsageView.Slot(UsageRange.Day, Window.SlotAt(slot))));
        }
    }

    private static double Ceiling(QuotaAllowance allowance, QuotaDay day)
    {
        return allowance.Allowance.Match(daily => daily, () => Math.Max(1, day.Points.Max(point => point.Left)));
    }

    private static double Y(double left, double top) => PlotTop + PlotHeight * (1 - left / top);

    private static string TopAt(double y) => $"top: {UsageView.Number(y)}px";

    private double Share(DateTimeOffset at) => Math.Clamp((at - Window.From) / (Window.To - Window.From), 0, 1);

    private string Percent(DateTimeOffset at) => FormattableString.Invariant($"{Share(at) * 100:0.###}%");

    private string Percent(TimeSpan span) => FormattableString.Invariant($"{span / (Window.To - Window.From) * 100:0.###}%");

    private double Middle(int slot) => (slot + 0.5) / Window.Slots;

    private static string At(double share) => FormattableString.Invariant($"calc({PlotLeft}px + (100% - {PlotLeft + PlotRight}px) * {share:0.####})");

    private IReadOnlyList<Shade> Shaded(QuotaDay day)
    {
        return
        [
            .. day
                .Waits.Select(wait => new Shade(wait, wait.From < Window.From ? Window.From : wait.From, wait.Until > Now ? Now : wait.Until))
                .Where(shade => shade.Until > shade.From),
        ];
    }

    private static Optional<double> Floor(QuotaAllowance allowance) => allowance.Allowance.Map(daily => daily * allowance.BackgroundShare);

    private static Optional<long> Gap(QuotaAllowance allowance) => allowance.Allowance.Map(_ => allowance.Outside);

    private Optional<double> Unknown(QuotaDay day) => Optional.When(day.Points.All(point => point.At >= Reset) && Share(Reset) >= 0.25, () => Share(Reset));

    private double Paced(QuotaAllowance allowance, DateTimeOffset reserveAt)
    {
        var perHour = (allowance.Remaining - allowance.Reserve) / (reserveAt - Now).TotalHours;
        return Math.Max(0, allowance.Remaining - perHour * (Window.To - Now).TotalHours);
    }

    private string Line(QuotaDay day, double top) => $"M{string.Join(" L", day.Points.Select(point => Point(point, top)))}";

    private string Area(QuotaDay day, double top)
    {
        var first = day.Points[0];
        var last = day.Points[^1];
        return $"{Line(day, top)} L{X(last.At)},{PlotHeight} L{X(first.At)},{PlotHeight} Z";
    }

    private string Point(QuotaPoint point, double top) => FormattableString.Invariant($"{X(point.At)},{PlotHeight * (1 - point.Left / top):0.##}");

    private string X(DateTimeOffset at) => FormattableString.Invariant($"{Share(at) * Span:0.##}");

    private IEnumerable<Hour> Hovered(QuotaDay day)
    {
        return Enumerable
            .Range(0, Window.Slots)
            .Select(slot => (Slot: slot, From: Window.SlotAt(slot), Until: Window.SlotAt(slot + 1)))
            .Where(hour => hour.From < Now)
            .Select(hour =>
                day.Points.Reverse()
                    .FirstOrNone(point => point.At <= hour.From)
                    .Map(before => new Hour(
                        hour.From,
                        hour.Until,
                        before.Left,
                        day.Points.FirstOrNone(point => point.At >= hour.Until).GetValueOr(day.Points[^1]).Left,
                        Causes(hour.Slot)
                    ))
            )
            .WhereSome();
    }

    private IReadOnlyList<(UsageCause Cause, long Calls)> Causes(int slot)
    {
        var causes = Optional.Of(Slots.ElementAtOrDefault(slot)).Map(found => found.Causes).GetValueOr(new Dictionary<UsageCause, long>());
        return [.. causes.Where(pair => pair.Value > 0).OrderByDescending(pair => pair.Value).Select(pair => (pair.Key, pair.Value))];
    }

    private sealed record Shade(QuotaWait Wait, DateTimeOffset From, DateTimeOffset Until);

    private sealed record Hour(DateTimeOffset From, DateTimeOffset Until, long Before, long After, IReadOnlyList<(UsageCause Cause, long Calls)> Causes);
}
