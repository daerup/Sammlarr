@using Contracts.Media
@using Contracts.Settings
@using Domain.Providers
@inject IProviderConfigRepository ProviderConfigRepository

<div class="space-y-8">
    <div class="flex flex-row flex-wrap items-start gap-6">
        <ApiKeyCard Provider="ApiKeyProvider.Tmdb">
            <Description>
                Your TMDB v3 API key. Get one at
                <a href="https://www.themoviedb.org/settings/api" target="_blank"
                   class="underline underline-offset-2 hover:text-foreground transition-colors">
                    themoviedb.org
                </a>
            </Description>
        </ApiKeyCard>

        <ApiKeyCard Provider="ApiKeyProvider.Mdblist">
            <Description>
                Your MDBList API key. Get one at
                <a href="https://mdblist.com/preferences/#api" target="_blank"
                   class="underline underline-offset-2 hover:text-foreground transition-colors">
                    mdblist.com
                </a>
            </Description>
        </ApiKeyCard>
    </div>

    <div class="flex flex-row flex-wrap items-start gap-6">
        <CredentialCard Provider="@_authProvider"/>
    </div>
</div>

@code {
    private AuthProvider _authProvider = AuthProvider.Plex;

    protected override async Task OnInitializedAsync() => _authProvider = (await ProviderConfigRepository.GetAsync()).AuthProvider;
}
