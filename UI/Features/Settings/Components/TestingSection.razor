@using BlazorBlueprint.Components
@inject Notifier Notifier

<div class="w-full flex flex-col gap-6">
    <div>
        <h2 class="text-lg font-semibold tracking-tight">Testing</h2>
        <p class="text-muted-foreground mt-1 text-sm leading-relaxed max-w-2xl">
            Tools for exercising app behavior during development. This section is only useful for verification and will be limited to Development builds.
        </p>
    </div>

    <div class="rounded-lg border p-5 flex items-start justify-between gap-6 max-w-2xl">
        <div class="space-y-1">
            <h3 class="text-sm font-semibold">Throw test exception</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Raises an exception and surfaces it through the error toast and detail dialog, so you can verify error handling end to end.
            </p>
        </div>
        <BbButton Variant="ButtonVariant.Outline" OnClick="ThrowTestException" Class="shrink-0">
            <LucideIcon Name="bug" Size="14" Class="mr-1.5"/>
            Throw
        </BbButton>
    </div>
</div>

@code {
    private void ThrowTestException()
    {
        try
        {
            throw new InvalidOperationException("This is a test exception thrown from the Testing section to verify the error dialog.");
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Test exception");
        }
    }
}
