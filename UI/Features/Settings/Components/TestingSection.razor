    {
        Notifier.Info("Adding to the watchlist is demo-only here.");
        return Task.CompletedTask;
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_items.Count / (double)PageSize));

    private IEnumerable<int> PageItems => _items.Skip((_page - 1) * PageSize).Take(PageSize);

    private void OnPageChanged(int page) => _page = Math.Clamp(page, 1, TotalPages);

    private void ToggleItem(int item)
    {
        if (!_selected.Remove(item))
        {
            _selected.Add(item);
        }
    }

    private void SelectAllItems()
    {
        foreach (var item in _items)
        {
            _selected.Add(item);
        }
    }

    private void RemoveSelectedItems()
    {
        _items.RemoveAll(_selected.Contains);
        _selected.Clear();
        if (_page > TotalPages)
        {
            _page = TotalPages;
        }
    }

    private void ReAddItems()
    {
        _items.Clear();
        _items.AddRange(Enumerable.Range(1, 30));
        _selected.Clear();
        _page = 1;
    }

    private void OnKindChanged(NotificationKind kind) => _kind = kind;

    private void ShowNotification()
    {
        switch (_kind)
        {
            case NotificationKind.Success:
                Notifier.Success("Operation completed successfully.");
                break;
            case NotificationKind.Info:
                Notifier.Info("Here is some information worth noting.");
                break;
            case NotificationKind.Warning:
                Notifier.Warning("Something looks off, but it is not fatal.");
                break;
            case NotificationKind.Error:
                Notifier.Error("The operation failed.");
                break;
            case NotificationKind.Exception:
                ShowException();
                break;
        }
    }

    private void ShowException()
    {
        try
        {
            if (_includeInner)
            {
                try
                {
                    throw new InvalidOperationException("Inner cause: a lower-level operation failed.");
                }
                catch (Exception inner)
                {
                    throw new ApplicationException("Outer exception wrapping an inner cause.", inner);
                }
            }

            throw new InvalidOperationException("This is a test exception thrown from the Testing section to verify the error dialog.");
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Test exception");
        }
    }

    private IReadOnlyList<NotificationDeliveryOutcome> _healthOutcomes = [];

    private static readonly NotificationEventType[] _healthEvents =
    [
        NotificationEventType.WatchlistSynced,
        NotificationEventType.FeedRunCompleted,
        NotificationEventType.FeedRunFailed,
    ];

    private int _healthEventIndex;

    private void AddDelivered() => AddHealthOutcome(new Delivered());

    private void AddRetrying() => AddHealthOutcome(new Retrying("Connection timed out", DateTimeOffset.UtcNow.AddMinutes(4)));

    private void AddFailed() => AddHealthOutcome(new Failed("Endpoint returned HTTP 500"));

    private void AddHealthOutcome(DeliveryOutcome outcome)
    {
        var eventType = _healthEvents[_healthEventIndex++ % _healthEvents.Length];
        _healthOutcomes = [new NotificationDeliveryOutcome(outcome, eventType, DateTimeOffset.UtcNow), .. _healthOutcomes];
    }

    private void RemoveLastHealthOutcome() => _healthOutcomes = [.. _healthOutcomes.Skip(1)];

    private void ClearHealthOutcomes() => _healthOutcomes = [];
