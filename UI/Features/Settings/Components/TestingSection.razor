@using BlazorBlueprint.Components
@using Contracts.Feed
@using Contracts.Media
@using Domain.Media
@using Domain.Media.Metadata
@using Domain.Notifications
@using Domain.Providers
@using Domain.Watchlist
@using UI.Shared.Common
@using UI.Shared.Guards
@using UI.Shared.Media
@using UI.Shared.Media.Icons
@using UI.Shared.Services.Branding
@using UI.Features.Feeds.Components
@using UI.Features.Watchlist.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject Notifier Notifier
@inject MediaProviderBrandingService Branding
@inject IJSRuntime JS

<div class="w-full flex flex-col gap-3">
    <div class="mb-1">
        <h2 class="text-lg font-semibold tracking-tight">Testing</h2>
        <p class="text-muted-foreground mt-1 text-sm leading-relaxed max-w-2xl">
            A playground for the app's UI components. Only useful for verification during development; will be limited to Development builds.
        </p>
    </div>

    <section class="rounded-lg border p-6 space-y-5">
        <div class="space-y-1">
            <h3 class="text-sm font-semibold">Media card <span class="font-normal text-muted-foreground">— Browse / Watchlist grid</span></h3>
            <p class="text-xs text-muted-foreground leading-relaxed">MediaGridTile in the real grid. A resolved movie and show, an unresolved item, and the loading skeleton. Click a tile to open the detail sheet.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <MediaGridTile Media="_demoMovie" OnClick="() => OpenSheet(_demoMovie)" ShowBookmark="true" IsInWatchlist="@_demoWatchlisted.Contains(_demoMovie.Id)"/>
            <MediaGridTile Media="_demoShow" OnClick="() => OpenSheet(_demoShow)" ShowBookmark="true" IsInWatchlist="@_demoWatchlisted.Contains(_demoShow.Id)"/>
            <MediaGridTile Media="_demoUnknown" OnClick="() => OpenSheet(_demoUnknown)" ShowBookmark="false" IsInWatchlist="false"/>
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="1"/>
        </div>
    </section>

    <div class="flex gap-4 items-start">
    <section class="rounded-lg border p-6 space-y-5 shrink-0" style="order: 2; width: 36rem">
        <div class="space-y-1">
            <h3 class="text-sm font-semibold">Media detail tiles <span class="font-normal text-muted-foreground">— Feed preview</span></h3>
            <p class="text-xs text-muted-foreground leading-relaxed">MediaDetailTile with watchlist / blacklist toggles and status indicators, plus the preview stat badges. Toggles are visual-only.</p>
        </div>
        <BbTooltipProvider>
            <div class="flex items-start text-xs font-medium">
                <PreviewFilterBadge Icon="list" Count="3" Active="true" OnClick="() => {}">
                    <Tooltip>Total items fetched from the source list.</Tooltip>
                </PreviewFilterBadge>
                <PreviewFilterBadge Icon="check" Count="2" Active="false" OnClick="() => {}">
                    <Tooltip>Items that will be imported.</Tooltip>
                </PreviewFilterBadge>
                <PreviewFilterBadge Icon="scissors" Count="1" Active="false" OnClick="() => {}">
                    <Tooltip>Excluded by the import limit.</Tooltip>
                </PreviewFilterBadge>
                <PreviewFilterBadge Icon="circle-alert" Count="1" Active="false" OnClick="() => {}">
                    <Tooltip>Could not be matched in your media provider.</Tooltip>
                </PreviewFilterBadge>
            </div>
        </BbTooltipProvider>
        <div class="space-y-2 overflow-hidden">
            <MediaDetailTile Media="_demoMovie">
                <Icons>
                    <WatchlistToggleIcon Result="_demoMovie" IsToggled="@_demoWatchlisted.Contains(_demoMovie.Id)" IsToggling="false" OnToggle="ToggleDemoWatchlist"/>
                    <BlacklistToggleIcon Result="_demoMovie" IsToggled="@_demoBlacklisted.Contains(_demoMovie.Id)" IsToggling="false" OnToggle="ToggleDemoBlacklist"/>
                </Icons>
            </MediaDetailTile>
            <MediaDetailTile Media="_demoShow" Class="result-dimmed">
                <Icons>
                    <BbTooltipProvider>
                        <BbTooltip DelayDuration="300">
                            <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                                <div class="search-result-status-indicator">
                                    <LucideIcon Name="scissors" Size="24"/>
                                </div>
                            </BbTooltipTrigger>
                            <BbTooltipContent>Excluded by the specified import limit.</BbTooltipContent>
                        </BbTooltip>
                    </BbTooltipProvider>
                    <WatchlistToggleIcon Result="_demoShow" IsToggled="@_demoWatchlisted.Contains(_demoShow.Id)" IsToggling="false" OnToggle="ToggleDemoWatchlist"/>
                    <BlacklistToggleIcon Result="_demoShow" IsToggled="@_demoBlacklisted.Contains(_demoShow.Id)" IsToggling="false" OnToggle="ToggleDemoBlacklist"/>
                </Icons>
            </MediaDetailTile>
            <MediaDetailTile Media="_demoUnknown">
                <Icons>
                    <BbTooltipProvider>
                        <BbTooltip DelayDuration="300">
                            <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                                <div class="search-result-status-indicator">
                                    <LucideIcon Name="circle-alert" Size="24"/>
                                </div>
                            </BbTooltipTrigger>
                            <BbTooltipContent>Could not be matched in your media provider. This item will not be imported.</BbTooltipContent>
                        </BbTooltip>
                    </BbTooltipProvider>
                </Icons>
            </MediaDetailTile>
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="1"/>
        </div>
    </section>

    <div @ref="_grid" class="flex-1 min-w-0" style="order: 1; display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); column-gap: 0.75rem; grid-auto-rows: 1px; grid-auto-flow: dense; align-items: start">
        <section class="rounded-lg border p-6 space-y-5" style="grid-column: span 2; order: -2">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Bulk actions &amp; pagination</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">A paged set (page size 12). Pagination changes the visible items; select/remove mutate the set, re-add restores it.</p>
            </div>
            @if (_items.Count > 0)
            {
                <BulkActionBar SelectedCount="_selected.Count"
                               TotalCount="_items.Count"
                               RemoveLabel="Remove"
                               IsRemoving="false"
                               OnSelectAll="SelectAllItems"
                               OnClearSelection="() => _selected.Clear()"
                               OnCancel="() => _selected.Clear()"
                               OnRemove="RemoveSelectedItems"/>
                <div class="flex flex-wrap gap-2">
                    @foreach (var item in PageItems)
                    {
                        var isSelected = _selected.Contains(item);
                        <button type="button" @onclick="() => ToggleItem(item)"
                                class="@($"rounded-md border px-2 py-1 text-xs transition-colors {(isSelected ? "bg-primary text-primary-foreground border-primary" : "bg-muted text-muted-foreground hover:text-foreground")}")">
                            Item @item
                        </button>
                    }
                </div>
                <PaginationControls CurrentPage="_page" TotalPages="TotalPages" IsDisabled="false" PageChanged="OnPageChanged"/>
            }
            else
            {
                <p class="text-sm text-muted-foreground">All items removed.</p>
            }
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ReAddItems">
                <LucideIcon Name="plus" Size="14" Class="mr-1.5"/>
                Re-add items
            </BbButton>
        </section>

        <section class="rounded-lg border p-6" style="display: flex; flex-direction: column; gap: 1rem">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Notifications</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">Fire a toast of the chosen kind. Exceptions also open the detail dialog.</p>
            </div>
            <div class="flex items-end gap-3">
                <div class="w-36">
                    <BbSelect TValue="NotificationKind" Value="_kind" ValueChanged="OnKindChanged" Options="KindOptions"/>
                </div>
                <BbButton Variant="ButtonVariant.Default" OnClick="ShowNotification">
                    <LucideIcon Name="bell" Size="14" Class="mr-1.5"/>
                    Show
                </BbButton>
            </div>
            @if (_kind == NotificationKind.Exception)
            {
                <div class="flex items-center gap-2">
                    <BbCheckbox @bind-Checked="_includeInner" Id="nested-exception" AriaLabel="Include inner exception"/>
                    <label for="nested-exception" class="text-sm cursor-pointer select-none">Include inner (nested) exception</label>
                </div>
            }
        </section>

        <section class="rounded-lg border p-6 space-y-4">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Delivery health dot <span class="font-normal text-muted-foreground">— Notifications / Clients</span></h3>
                <p class="text-xs text-muted-foreground leading-relaxed">NotificationHealthDot over a live outcome list — red on any failure, amber on any retry, else green; grey when empty. Click the dot for the popover. Add or remove entries below.</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-sm font-medium">Dot:</span>
                <NotificationHealthDot Outcomes="_healthOutcomes"/>
                <span class="text-xs text-muted-foreground">@_healthOutcomes.Count @(_healthOutcomes.Count == 1 ? "entry" : "entries")</span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddDelivered">
                    <LucideIcon Name="plus" Size="14" Class="mr-1.5"/>
                    Delivered
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddRetrying">
                    <LucideIcon Name="plus" Size="14" Class="mr-1.5"/>
                    Retrying
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddFailed">
                    <LucideIcon Name="plus" Size="14" Class="mr-1.5"/>
                    Failed
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="RemoveLastHealthOutcome" Disabled="_healthOutcomes.Count == 0">
                    <LucideIcon Name="minus" Size="14" Class="mr-1.5"/>
                    Remove last
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ClearHealthOutcomes" Disabled="_healthOutcomes.Count == 0">
                    <LucideIcon Name="trash-2" Size="14" Class="mr-1.5"/>
                    Clear
                </BbButton>
            </div>
        </section>

        <section class="rounded-lg border p-6 space-y-4" style="grid-column: span 2">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Branding</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">Every brand treatment MediaProviderBrandingService drives — icon chip, colored name, brand hover button, the SettingsCard gradient header, provider pills, brand badges, and external links.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    @foreach (var provider in BrandProviders)
                    {
                        var info = Branding.GetBrandingInfo(provider);
                        <div class="flex items-center gap-3">
                            <span class="shrink-0 inline-flex items-center justify-center rounded-lg" style="width: 2.25rem; height: 2.25rem; background-color: color-mix(in oklch, @info.BrandColor 16%, transparent); color: @info.BrandColor">
                                @info.IconWithClass("h-6 w-6")
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="text-sm font-medium truncate">@info.DisplayName</div>
                                <code class="text-xs text-muted-foreground">@info.BrandColor</code>
                            </div>
                            <HoverButton Preset="HoverButtonPreset.Custom" Color="@info.BrandColor" Text="@info.NickName"/>
                        </div>
                    }
                </div>
                <div class="space-y-4">
                    @{
                        var head = Branding.GetBrandingInfo(_toggleProvider);
                    }
                    <div class="space-y-2">
                        <p class="text-xs font-medium text-muted-foreground">Card header (SettingsCard) — follows the enum toggle</p>
                        <div class="rounded-lg border overflow-hidden" style="--brand: @head.BrandColor">
                            <div class="flex items-center gap-3" style="padding: 0.75rem 1rem; background: linear-gradient(90deg, color-mix(in oklch, @head.BrandColor 26%, transparent) 0%, color-mix(in oklch, @head.BrandColor 12%, transparent) 100%); border-bottom: 2px solid @head.BrandColor">
                                <span class="inline-flex items-center justify-center" style="color: @head.BrandColor">@head.IconWithClass("h-6 w-6")</span>
                                <span class="text-sm font-semibold">Auth provider</span>
                                <BbBadge Variant="BadgeVariant.Outline" Class="provider-pill whitespace-nowrap ml-auto">@head.DisplayName</BbBadge>
                            </div>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <p class="text-xs font-medium text-muted-foreground">Sign-in button (SignInRequired) — follows the enum toggle</p>
                        <HoverButton Color="@head.BrandColor" Class="font-medium w-full" Border="false">
                            <LucideIcon Name="log-in" Size="16" Class="mr-2"/>
                            <span>Sign in with @head.NickName</span>
                        </HoverButton>
                    </div>
                    <div class="space-y-2">
                        <p class="text-xs font-medium text-muted-foreground">Provider pills</p>
                        <div class="flex flex-wrap items-center gap-2">
                            @foreach (var provider in BrandProviders)
                            {
                                var info = Branding.GetBrandingInfo(provider);
                                <span class="inline-flex" style="--brand: @info.BrandColor">
                                    <BbBadge Variant="BadgeVariant.Outline" Class="provider-pill whitespace-nowrap">@info.DisplayName</BbBadge>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="space-y-2">
                        <p class="text-xs font-medium text-muted-foreground">Brand badges</p>
                        <div class="flex flex-wrap items-center gap-2">
                            @foreach (var provider in BrandProviders)
                            {
                                var info = Branding.GetBrandingInfo(provider);
                                <span class="inline-flex" style="--brand: @info.BrandColor">
                                    <BbBadge Variant="BadgeVariant.Outline" Class="brand-badge whitespace-nowrap">@info.NickName</BbBadge>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="pt-4 border-t space-y-2">
                <p class="text-xs font-medium text-muted-foreground">External link (FeedSourceLink)</p>
                <div class="flex flex-wrap items-center gap-6">
                    <FeedSourceLink Provider="FeedProvider.Mdblist" Identifier="top-movies-2026"/>
                    <FeedSourceLink Provider="FeedProvider.Tmdb" Identifier="8321"/>
                </div>
            </div>
        </section>

        <section class="rounded-lg border p-6" style="display: flex; flex-direction: column; gap: 1rem">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Dialogs &amp; confirms</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">Neutral and destructive confirmation dialogs.</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <BbAlertDialog>
                    <BbAlertDialogTrigger>
                        <BbButton Variant="ButtonVariant.Outline">Confirm action</BbButton>
                    </BbAlertDialogTrigger>
                    <BbAlertDialogContent>
                        <BbAlertDialogHeader>
                            <BbAlertDialogTitle>Apply changes?</BbAlertDialogTitle>
                            <BbAlertDialogDescription>A neutral confirmation dialog for testing.</BbAlertDialogDescription>
                        </BbAlertDialogHeader>
                        <BbAlertDialogFooter>
                            <BbAlertDialogCancel>
                                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                            </BbAlertDialogCancel>
                            <BbAlertDialogAction>
                                <BbButton Variant="ButtonVariant.Default" OnClick="@(() => Notifier.Success("Confirmed."))">Confirm</BbButton>
                            </BbAlertDialogAction>
                        </BbAlertDialogFooter>
                    </BbAlertDialogContent>
                </BbAlertDialog>

                <BbAlertDialog>
                    <BbAlertDialogTrigger>
                        <BbButton Variant="ButtonVariant.Outline" Class="text-muted-foreground hover:text-destructive">Delete something</BbButton>
                    </BbAlertDialogTrigger>
                    <BbAlertDialogContent>
                        <BbAlertDialogHeader>
                            <BbAlertDialogTitle>Delete this item?</BbAlertDialogTitle>
                            <BbAlertDialogDescription>A destructive confirmation. This cannot be undone.</BbAlertDialogDescription>
                        </BbAlertDialogHeader>
                        <BbAlertDialogFooter>
                            <BbAlertDialogCancel>
                                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                            </BbAlertDialogCancel>
                            <BbAlertDialogAction>
                                <HoverButton Preset="HoverButtonPreset.Destructive" Text="Yes, delete" OnClick="@(() => Notifier.Success("Deleted."))"/>
                            </BbAlertDialogAction>
                        </BbAlertDialogFooter>
                    </BbAlertDialogContent>
                </BbAlertDialog>
            </div>
        </section>

        <section class="rounded-lg border p-6 space-y-5">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Hover buttons</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">Ghost until hovered, then filled with the tint. Presets read the theme; Custom takes an inline color.</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <HoverButton Preset="HoverButtonPreset.Destructive" Icon="trash-2" Text="Destructive"/>
                <HoverButton Preset="HoverButtonPreset.Success" Icon="check" Text="Success"/>
                <HoverButton Preset="HoverButtonPreset.Custom" Color="oklch(0.62 0.19 260)" Icon="star" Text="Custom"/>
                <HoverButton Preset="HoverButtonPreset.Custom" Color="oklch(0.62 0.2 300)" Icon="sparkles" Text="Custom"/>
                <HoverButton Preset="HoverButtonPreset.Custom" Color="oklch(0.85 0.16 85)" Icon="sun" Text="Light tint"/>
            </div>
        </section>

        <section class="rounded-lg border p-6 space-y-6">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Form controls</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">Input, select, switch, checkbox, and radio group.</p>
            </div>
            <div class="space-y-2">
                <label class="text-sm font-medium">Text input</label>
                <BbInput Value="@_text" ValueChanged="@(v => _text = v ?? string.Empty)" Placeholder="Type something…"/>
            </div>
            <div class="space-y-2">
                <label class="text-sm font-medium">Sensitive input <span class="font-normal text-muted-foreground">— masked, click the eye to reveal</span></label>
                <SensitiveInput @bind-Value="_secret" Placeholder="Enter a secret…" Label="secret"/>
                <p class="text-xs text-muted-foreground">Bound value: <code class="font-mono">@(string.IsNullOrEmpty(_secret) ? "(empty)" : _secret)</code></p>
            </div>
            <div class="space-y-2">
                <label class="text-sm font-medium">Select</label>
                <BbSelect TValue="string" Value="_selectValue" ValueChanged="v => _selectValue = v" Options="DemoSelectOptions"/>
            </div>
            <div class="flex items-center gap-8">
                <div class="flex items-center gap-3">
                    <BbSwitch @bind-Checked="_switch"/>
                    <span class="text-sm">Switch</span>
                </div>
                <div class="flex items-center gap-2">
                    <BbCheckbox @bind-Checked="_check" Id="demo-check"/>
                    <label for="demo-check" class="text-sm cursor-pointer select-none">Checkbox</label>
                </div>
            </div>
            <div class="space-y-2.5">
                <label class="text-sm font-medium">Radio group</label>
                <BbRadioGroup @bind-Value="_radio">
                    <BbRadioGroupItem Value="@("one")" Label="Option one"/>
                    <BbRadioGroupItem Value="@("two")" Label="Option two"/>
                    <BbRadioGroupItem Value="@("three")" Label="Option three"/>
                </BbRadioGroup>
            </div>
        </section>

        <section class="rounded-lg border p-6 space-y-5" style="grid-column: span 2; order: -1">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Enum toggle</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">EnumToggleGroup — a segmented selector over an enum's values.</p>
            </div>
            <EnumToggleGroup TEnum="MediaProvider" Value="_toggleProvider" OnChange="v => _toggleProvider = v" TooltipProvider="null"/>
        </section>

        <section class="rounded-lg border p-6" style="display: flex; flex-direction: column; gap: 0.75rem">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Guards</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">ProtectedSection and ProtectedComponent. The toggle stands in for real auth state.</p>
            </div>
            <BbTooltipProvider>
                <div class="flex items-center justify-between gap-3">
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => _guardAllowed = !_guardAllowed">
                        Access: @(_guardAllowed ? "granted" : "denied")
                    </BbButton>
                    <ProtectedComponent GuardState="() => _guardAllowed" DeniedActionDescription="use this button">
                        <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small">Protected button</BbButton>
                    </ProtectedComponent>
                </div>
            </BbTooltipProvider>
            <div class="flex flex-col" style="min-height: 12rem">
                <ProtectedSection GuardState="() => _guardAllowed" DeniedActionDescription="view this demo section">
                    <div class="flex-1 flex items-center justify-center rounded-lg border bg-muted/40 p-5 text-sm">Protected content is visible.</div>
                </ProtectedSection>
            </div>
        </section>

        <section class="rounded-lg border p-6 space-y-5" style="grid-column: span 2">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Schedule</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">SchedulePicker — daily / weekly / raw-cron modes with a human-readable summary.</p>
            </div>
            <SchedulePicker CronExpression="_cron" CronExpressionChanged="v => _cron = v"/>
        </section>

        <section class="rounded-lg border p-6 space-y-6">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Buttons &amp; badges</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">Button variants, sizes and states, plus badge variants including the soft tones.</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <BbButton Variant="ButtonVariant.Default">Default</BbButton>
                <BbButton Variant="ButtonVariant.Secondary">Secondary</BbButton>
                <BbButton Variant="ButtonVariant.Outline">Outline</BbButton>
                <BbButton Variant="ButtonVariant.Ghost">Ghost</BbButton>
                <BbButton Variant="ButtonVariant.Destructive">Destructive</BbButton>
                <BbButton Variant="ButtonVariant.Link">Link</BbButton>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small">Small</BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Default">Default</BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Large">Large</BbButton>
                <BbButton Variant="ButtonVariant.Default" Loading LoadingText="Loading">Loading</BbButton>
                <BbButton Variant="ButtonVariant.Default" Disabled>Disabled</BbButton>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <BbBadge Variant="BadgeVariant.Default">Default</BbBadge>
                <BbBadge Variant="BadgeVariant.Secondary">Secondary</BbBadge>
                <BbBadge Variant="BadgeVariant.Outline">Outline</BbBadge>
                <BbBadge Variant="BadgeVariant.Destructive">Destructive</BbBadge>
                <BbBadge Variant="BadgeVariant.Outline" Class="badge-soft-destructive">Soft destructive</BbBadge>
                <BbBadge Variant="BadgeVariant.Outline" Class="badge-soft-success">Soft success</BbBadge>
            </div>
        </section>

        <section class="rounded-lg border p-6 space-y-5">
            <div class="space-y-1">
                <h3 class="text-sm font-semibold">Custom components</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">App-authored: provenance badges and the soft alert callout.</p>
            </div>
            <BbTooltipProvider>
                <div class="flex flex-wrap items-center gap-2">
                    <ProvenanceBadge Provenance="_manualProvenance" AddedAt="_sampleDate"/>
                    <ProvenanceBadge Provenance="_searchProvenance" AddedAt="_sampleDate"/>
                    <ProvenanceBadge Provenance="_browseProvenance" AddedAt="_sampleDate"/>
                    <ProvenanceBadge Provenance="_feedPreviewProvenance" AddedAt="_sampleDate"/>
                    <ProvenanceBadge Provenance="_remoteProvenance" AddedAt="_sampleDate"/>
                    <ProvenanceBadge Provenance="_feedProvenance" AddedAt="_sampleDate"/>
                    <ProvenanceBadge Provenance="_feedMdblistProvenance" AddedAt="_sampleDate"/>
                    <ProvenanceBadge Provenance="_orphanedProvenance" AddedAt="_sampleDate"/>
                </div>
            </BbTooltipProvider>
            <div class="alert-soft-destructive rounded-lg border p-3 flex items-start gap-2">
                <LucideIcon Name="circle-alert" Size="16" Class="shrink-0 mt-0.5"/>
                <span class="text-sm">A soft destructive alert callout.</span>
            </div>
