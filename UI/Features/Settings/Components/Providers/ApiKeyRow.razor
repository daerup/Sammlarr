@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService MediaProviderBrandingService

<ProviderRow Key="@Provider.Remote" Brand="Branding" Open="Open" OpenChanged="OpenChanged">
    <Status>
        @if (_field is { } field)
        {
            <CredentialStatus State="field.State" IdleText="@(field.Empty ? "Not set" : "Not tested")" Required="@(Required && field.Empty)"/>
        }
        else
        {
            <BbSkeleton Class="h-6 w-24 rounded-full"/>
        }
    </Status>
    <ChildContent>
        <ApiKeyField Provider="Provider" Owner="@Branding.DisplayName" Description="Description" StateChanged="field => _field = field" Changed="Changed"/>
        @Setup
        @if (Uses.Count > 0)
        {
            <div class="text-sm text-muted-foreground" data-uses>
                <span class="font-medium text-foreground">What it gets you</span>
                <ul class="mt-1 list-disc pl-5">
                    @foreach (var use in Uses)
                    {
                        <li>@use</li>
                    }
                </ul>
            </div>
        }
        @Extra
    </ChildContent>
</ProviderRow>

@code {
    [Parameter] [EditorRequired] public required ApiKeyProvider Provider { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment Description { get; set; }

    [Parameter] public IReadOnlyList<string> Uses { get; set; } = [];

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public EventCallback Changed { get; set; }

    [Parameter] public RenderFragment? Setup { get; set; }

    [Parameter] public RenderFragment? Extra { get; set; }

    private BrandingInfo Branding => MediaProviderBrandingService.GetBrandingInfo(Provider.Remote);

    private ApiKeyFieldState? _field;
}