@using Contracts.Auth
@using UI.Shared.Services.Branding
@inject IApiKeyService ApiKeyService
@inject MediaProviderBrandingService MediaProviderBrandingService

<ProviderRow Provider="@Provider.AsMediaProvider()" Open="Open" OpenChanged="OpenChanged">
    <Status>
        <CredentialStatus State="_state" IdleText="@(string.IsNullOrWhiteSpace(_apiKeyInput) ? "Not set" : "Not tested")"/>
    </Status>
    <ChildContent>
        <BbField>
            <BbFieldLabel>API key</BbFieldLabel>
            <BbFieldContent>
                <SensitiveInput @bind-Value="ApiKey" Placeholder="Enter API key" Label="API key" Class="@(_state == CredentialState.Failed ? "border-destructive" : string.Empty)"/>
                <BbFieldDescription>@Description</BbFieldDescription>
            </BbFieldContent>
        </BbField>

        <CredentialActions State="_state" HasChange="HasChange" OnTest="TestAsync" OnSave="SaveAsync" OnCancel="Cancel">
            <Remove>
                <BbAlertDialog>
                    <BbAlertDialogTrigger>
                        <HoverButton Preset="HoverButtonPreset.Destructive" Icon="trash-2" Text="Delete key"/>
                    </BbAlertDialogTrigger>
                    <BbAlertDialogContent>
                        <BbAlertDialogHeader>
                            <BbAlertDialogTitle>Delete API key?</BbAlertDialogTitle>
                            <BbAlertDialogDescription>
                                This will permanently remove the saved API key for @Branding.DisplayName.
                                You will need to re-enter it to use this provider again.
                            </BbAlertDialogDescription>
                        </BbAlertDialogHeader>
                        <BbAlertDialogFooter>
                            <BbAlertDialogCancel>
                                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                            </BbAlertDialogCancel>
                            <BbAlertDialogAction>
                                <HoverButton Preset="HoverButtonPreset.Destructive" Icon="trash-2" Text="Delete key" OnClick="DeleteAsync"/>
                            </BbAlertDialogAction>
                        </BbAlertDialogFooter>
                    </BbAlertDialogContent>
                </BbAlertDialog>
            </Remove>
        </CredentialActions>
    </ChildContent>
</ProviderRow>

@code {
    [Parameter] [EditorRequired] public required ApiKeyProvider Provider { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment Description { get; set; }

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private BrandingInfo Branding => MediaProviderBrandingService.GetBrandingInfo(Provider.AsMediaProvider());

    private string _apiKeyInput = string.Empty;
    private string _savedApiKey = string.Empty;
    private IApiKey? _validatedKey;
    private ApiKeyProvider? _loadedProvider;
    private CredentialState _state = CredentialState.Idle;
    private CredentialState _savedState = CredentialState.Idle;

    private bool HasChange => !string.IsNullOrWhiteSpace(_apiKeyInput) && _apiKeyInput != _savedApiKey;

    private string ApiKey
    {
        get => _apiKeyInput;
        set
        {
            if (_apiKeyInput == value)
            {
                return;
            }

            _apiKeyInput = value;
            _state = value == _savedApiKey ? _savedState : CredentialState.Idle;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProvider == Provider)
        {
            return;
        }

        _loadedProvider = Provider;
        _savedState = await ApiKeyService
            .GetApiKeyAsync(Provider)
            .Apply(key => _savedApiKey = _apiKeyInput = key.Value)
            .ApplyError(_ => _savedApiKey = _apiKeyInput = string.Empty)
            .Match(CredentialState.Saved, CredentialState.Idle);
        _state = _savedState;
    }

    private async Task TestAsync()
    {
        _state = CredentialState.Testing;

        _state = await ApiKeyService
            .TestApiKeyAsync(Provider, _apiKeyInput)
            .Apply(key => _validatedKey = key)
            .ApplyError(_ => _validatedKey = null)
            .Match(CredentialState.Success, CredentialState.Failed);
    }

    private async Task SaveAsync()
    {
        _state = CredentialState.Saving;

        await ApiKeyService.SaveApiKeyAsync(_validatedKey!);
        _savedApiKey = _apiKeyInput;
        _savedState = CredentialState.Saved;

        _state = CredentialState.Saved;
    }

    private async Task DeleteAsync()
    {
        await ApiKeyService.RemoveApiKeyAsync(Provider);
        _savedApiKey = string.Empty;
        _apiKeyInput = string.Empty;
        _savedState = CredentialState.Idle;
        _state = CredentialState.Idle;
    }

    private void Cancel()
    {
        _apiKeyInput = _savedApiKey;
        _state = _savedState;
    }
}
