@using BlazorBlueprint.Primitives
@using Contracts.Settings
@using Domain.Wantlist.Arr

<div class="arr-app" data-arr-app="@App.Name">
    <BbField>
        <BbFieldLabel>URL</BbFieldLabel>
        <BbFieldContent>
            <BbInput Value="@_url" ValueChanged="UrlChangedAsync" Placeholder="@Placeholder" AriaLabel="@($"{App.Name} URL")"
                     Class="h-9 bg-accent text-sm" UpdateTiming="UpdateTiming.Immediate"/>
            @if (ShowsExternalUrl)
            {
                <div class="arr-app-external">
                    <span class="arr-app-addon-head">
                        <span class="font-medium">External URL</span>
                        <span class="text-muted-foreground">Links to @App.Name open here</span>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="ml-auto h-6 px-2 text-xs text-muted-foreground" OnClick="RemoveExternalUrlAsync">
                            <LucideIcon Name="x" Size="12" Class="mr-1"/>
                            Remove
                        </BbButton>
                    </span>
                    <BbInput Value="@Instance.ExternalUrl.GetValueOr(string.Empty)" ValueChanged="ExternalUrlChangedAsync" Placeholder="@($"http://localhost:{App.DefaultPort}")"
                             AriaLabel="@($"{App.Name} external URL")" Class="h-9 bg-accent text-sm"/>
                </div>
            }
            else
            {
                <BbButton Variant="ButtonVariant.Link" Size="ButtonSize.Small" Class="arr-app-add h-auto self-start p-0 text-xs text-muted-foreground" OnClick="() => _addingExternalUrl = true">
                    <LucideIcon Name="plus" Size="12" Class="mr-1"/>
                    Add external URL
                </BbButton>
            }
        </BbFieldContent>
    </BbField>

    <BbField>
        <BbFieldLabel>API key</BbFieldLabel>
        <BbFieldContent>
            <div class="flex items-center gap-2">
                <div class="min-w-0 flex-1">
                    <SensitiveInput Value="@_key" ValueChanged="KeyChangedAsync" Compact="true" Label="@($"{App.Name} API key")"
                                    Placeholder="Enter API key"
                                    Class="@(State == ArrConnectionState.Failed ? "border-destructive" : string.Empty)"/>
                </div>
                @switch (State)
                {
                    case ArrConnectionState.Testing:
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="true">
                            <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                            <span>Testing…</span>
                        </BbButton>
                        break;
                    case ArrConnectionState.Connected:
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="TestAsync">
                            <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                            <span>Test again</span>
                        </BbButton>
                        break;
                    case ArrConnectionState.Failed:
                        <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" OnClick="TestAsync">
                            <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                            <span>Test again</span>
                        </BbButton>
                        break;
                    case ArrConnectionState.Empty or ArrConnectionState.Untested:
                        <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" OnClick="TestAsync" Disabled="@(State == ArrConnectionState.Empty)">
                            <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                            <span>Test</span>
                        </BbButton>
                        break;
                }
            </div>
            <BbFieldDescription>
                Found in
                @if (ArrSettingsLink.For(Typed.LinkUrl.GetValueOr(string.Empty)).ToNullable() is { } href)
                {
                    <AppLink Href="@href" External="true">@App.Name › Settings › General</AppLink>
                }
                else
                {
                    <span>@App.Name › Settings › General</span>
                }.
            </BbFieldDescription>
            @if (State == ArrConnectionState.Failed)
            {
                <p class="arr-app-line text-destructive" role="alert">
                    <LucideIcon Name="circle-alert" Size="13" Class="mt-px shrink-0"/>
                    <span>@Error</span>
                </p>
            }
        </BbFieldContent>
    </BbField>

    @if (State == ArrConnectionState.Connected)
    {
        <BbField>
            <BbFieldLabel>Root folder</BbFieldLabel>
            <BbFieldContent>
                <BbSelect TValue="string" Value="@Instance.RootFolderPath.GetValueOr(string.Empty)" ValueChanged="FolderChangedAsync"
                          Options="FolderOptions" Placeholder="Choose a folder" AriaLabel="@($"{App.Name} root folder")" Class="w-full [&_[role=combobox]]:h-9"/>
                @if (Choices.Folders.Count == 0)
                {
                    <p class="arr-app-line text-[var(--alert-warning)]" role="alert">
                        <LucideIcon Name="triangle-alert" Size="13" Class="mt-px shrink-0"/>
                        <span>@App.Name has no root folder yet. Add one under Settings › Media Management in @App.Name, then test again.</span>
                    </p>
                }
            </BbFieldContent>
        </BbField>

        <BbField>
            <BbFieldLabel>Quality profile</BbFieldLabel>
            <BbFieldContent>
                <BbSelect TValue="int?" Value="@Instance.QualityProfileId.ToNullable()" ValueChanged="ProfileChangedAsync"
                          Options="ProfileOptions" Placeholder="Choose a profile" AriaLabel="@($"{App.Name} quality profile")" Class="w-full [&_[role=combobox]]:h-9"/>
            </BbFieldContent>
        </BbField>

        <div class="arr-app-wide overflow-hidden rounded-md border" data-arr-anime>
            <BbCollapsible>
                <div class="flex items-center gap-2 bg-foreground/5 pr-3 transition-colors hover:bg-foreground/8">
                    <BbCollapsibleTrigger AsChild="false" Class="group flex min-w-0 flex-1 items-center gap-2 py-2.5 pl-3 text-left text-sm">
                        <LucideIcon Name="chevron-right" Size="15" Class="shrink-0 text-muted-foreground transition-transform duration-150 group-data-[state=open]:rotate-90"/>
                        <span class="shrink-0 font-medium">Anime folder and profile</span>
                        <span class="truncate text-muted-foreground group-data-[state=open]:hidden">@AnimeSummary</span>
                    </BbCollapsibleTrigger>
                    <BbTooltip DelayDuration="150" Placement="PopoverPlacement.BottomEnd">
                        <BbTooltipTrigger AsChild="false" Class="inline-flex text-muted-foreground" role="button" aria-label="What counts as anime">
                            <LucideIcon Name="info" Size="13"/>
                        </BbTooltipTrigger>
                        <BbTooltipContent Class="w-[min(400px,calc(100vw-2rem))] border bg-popover px-3 py-2.5 text-xs text-muted-foreground shadow-lg">
                            <b class="mb-1 block font-semibold text-foreground">What counts as anime</b>
                            @AnimeLead(App)
                            <ol class="my-1.5 list-decimal space-y-0.5 pl-4">
                                <li><b class="font-medium text-foreground">Sammlarr's own anime data</b>: Sammlarr holds an AniList or MyAnimeList id for it, or finds its @AnimeMapId(App) id in the anime id map from anime-lists.</li>
                                <li><b class="font-medium text-foreground">@App.Name, for animated @Titles(App).ToLowerInvariant() only</b>: when it is animated (genre Animation) and Sammlarr's data does not call it anime, Sammlarr asks @App.Name, which counts it as anime when @AnimeTag(App).</li>
                            </ol>
                            <span class="block">Everything else goes to the normal folder, for example @AnimeExamples(App). @Titles(App) already in @App.Name never move.</span>
                        </BbTooltipContent>
                    </BbTooltip>
                </div>
                <BbCollapsibleContent>
                    <div class="arr-app-anime-pair border-t p-3">
                        <BbField>
                            <BbFieldLabel>Anime root folder</BbFieldLabel>
                            <BbFieldContent>
                                <BbSelect TValue="string" Value="@Instance.AnimeRootFolderPath.GetValueOr(string.Empty)" ValueChanged="AnimeFolderChangedAsync"
                                          Options="AnimeFolderOptions" Placeholder="@Off" AriaLabel="@($"{App.Name} anime root folder")" Class="w-full [&_[role=combobox]]:h-9"/>
                            </BbFieldContent>
                        </BbField>
                        <BbField>
                            <BbFieldLabel>Anime quality profile</BbFieldLabel>
                            <BbFieldContent>
                                <BbSelect TValue="int?" Value="@Instance.AnimeQualityProfileId.ToNullable()" ValueChanged="AnimeProfileChangedAsync"
                                          Options="AnimeProfileOptions" Placeholder="@SameAsDefault" Disabled="@(!Instance.RoutesAnime)"
                                          AriaLabel="@($"{App.Name} anime quality profile")" Class="w-full [&_[role=combobox]]:h-9"/>
                            </BbFieldContent>
                        </BbField>
                    </div>
                </BbCollapsibleContent>
            </BbCollapsible>
        </div>

        <label class="arr-app-switch">
            <BbSwitch Checked="Instance.Monitored" CheckedChanged="MonitoredChangedAsync" AriaLabel="@($"{App.Name} monitors new titles")"
                      AriaDescribedBy="@($"{App.Name}-monitor-note")"/>
            <span class="arr-app-switch-text">
                <span class="arr-app-switch-name">Monitor new titles</span>
                <span id="@($"{App.Name}-monitor-note")" class="arr-app-switch-note">@MonitorNote(App)</span>
            </span>
        </label>

        <label class="arr-app-switch">
            <BbSwitch Checked="Instance.SearchOnAdd" CheckedChanged="SearchChangedAsync" AriaLabel="@($"{App.Name} searches when a title is added")"
                      AriaDescribedBy="@($"{App.Name}-search-note")"/>
            <span class="arr-app-switch-text">
                <span class="arr-app-switch-name">Search when added</span>
                <span id="@($"{App.Name}-search-note")" class="arr-app-switch-note">@SearchNote(App)</span>
            </span>
        </label>
    }
    else if (State != ArrConnectionState.Failed)
    {
        <p class="arr-app-wide arr-app-line text-muted-foreground">
            <LucideIcon Name="info" Size="13" Class="mt-px shrink-0"/>
            <span>Test the connection to load @(App.Name)'s quality profiles and root folders.</span>
        </p>
    }
</div>

@code {
    [Parameter] [EditorRequired] public required ArrApp App { get; set; }

    [Parameter] [EditorRequired] public required ArrInstanceConfig Instance { get; set; }

    [Parameter] public ArrConnectionState State { get; set; }

    [Parameter] public string Error { get; set; } = string.Empty;

    [Parameter] public ArrInstanceChoices Choices { get; set; } = new([], []);

    [Parameter] public EventCallback<ArrInstanceConfig> Edited { get; set; }

    [Parameter] public EventCallback<ArrInstanceConfig> Test { get; set; }

    [Parameter] public EventCallback<ArrInstanceConfig> InstanceChanged { get; set; }

    private string _url = string.Empty;

    private string _key = string.Empty;

    private (Optional<string> Url, Optional<string> Key)? _stored;

    private string Placeholder => $"http://{App.Name.ToLowerInvariant()}:{App.DefaultPort}";

    private ArrInstanceConfig Typed => Instance with { Url = Text(_url), ApiKey = Text(_key) };

    private IEnumerable<SelectOption<int?>> ProfileOptions => Choices.Profiles.Select(profile => new SelectOption<int?>(profile.Id, profile.Name));

    private IEnumerable<SelectOption<string>> FolderOptions => Choices.Folders.Select(folder => new SelectOption<string>(folder.Path, $"{folder.Path} · {Free(folder.FreeSpace)} free"));

    private const string SameAsDefault = "Same as default";

    private const string Off = "Off";

    private IEnumerable<SelectOption<string>> AnimeFolderOptions
    {
        get
        {
            return
            [
                new SelectOption<string>(string.Empty, Off),
                .. Choices.Folders.Select(folder => new SelectOption<string>(folder.Path, $"{folder.Path} · {Free(folder.FreeSpace)} free{DefaultMark(folder.Path)}")),
            ];
        }
    }

    private IEnumerable<SelectOption<int?>> AnimeProfileOptions => [new SelectOption<int?>(null, SameAsDefault), .. ProfileOptions];

    private string DefaultMark(string path) => Instance.RootFolderPath.When(folder => folder == path).Match(" · the default", string.Empty);

    private string AnimeSummary => Instance.AnimeRootFolderPath.Map(folder => $"{folder}{AnimeProfileMark}").GetValueOr(Off);

    private string AnimeProfileMark
    {
        get
        {
            return Instance
                .AnimeQualityProfileId.Map(id => Choices.Profiles.FirstOrNone(profile => profile.Id == id))
                .Map(profile => $" · {profile.Name}")
                .GetValueOr(string.Empty);
        }
    }

    private static RenderFragment AnimeLead(ArrApp app)
    {
        return app switch
        {
            ArrApp.Radarr => @<span class="block">A new movie goes to the anime folder when it is anime by:</span>,
            ArrApp.Sonarr => @<span class="block">A new show goes to the anime folder, as an <b class="font-medium text-foreground">Anime series</b>, when it is anime by:</span>,
        };
    }

    private static string AnimeMapId(ArrApp app)
    {
        return app switch
        {
            ArrApp.Radarr => "TMDB",
            ArrApp.Sonarr => "TVDB",
        };
    }

    private static RenderFragment AnimeTag(ArrApp app)
    {
        return app switch
        {
            ArrApp.Radarr => @<span>TMDB gives it the keyword <b class="font-medium text-foreground">anime</b></span>,
            ArrApp.Sonarr => @<span>TheTVDB gives it the genre <b class="font-medium text-foreground">Anime</b></span>,
        };
    }

    private static RenderFragment AnimeExamples(ArrApp app)
    {
        return app switch
        {
            ArrApp.Radarr => @<span>Western animation such as <i>Cars 3</i> (Radarr is asked and says no) and live-action adaptations such as <i>Ghost in the Shell</i> (2017) (not animated, so never asked)</span>,
            ArrApp.Sonarr => @<span>Western animation such as <i>Arcane</i> (Sonarr is asked and says no) and live-action adaptations such as <i>One Piece</i> (2023) (not animated, so never asked)</span>,
        };
    }

    private static string Titles(ArrApp app)
    {
        return app switch
        {
            ArrApp.Radarr => "Movies",
            ArrApp.Sonarr => "Shows",
        };
    }

    private static string MonitorNote(ArrApp app)
    {
        return app switch
        {
            ArrApp.Radarr => "Radarr grabs a movie Sammlarr adds once it is released.",
            ArrApp.Sonarr => "Sonarr grabs new episodes of the shows Sammlarr adds.",
        };
    }

    private static string SearchNote(ArrApp app)
    {
        return app switch
        {
            ArrApp.Radarr => "Radarr searches right after adding a movie instead of waiting for its next RSS sync.",
            ArrApp.Sonarr => "Sonarr searches for what is already out right after adding a show.",
        };
    }

    protected override void OnParametersSet()
    {
        var stored = (Instance.Url, Instance.ApiKey);
        if (_stored.Equals(stored))
        {
            return;
        }

        _stored = stored;
        _url = Instance.Url.GetValueOr(string.Empty);
        _key = Instance.ApiKey.GetValueOr(string.Empty);
    }

    private async Task UrlChangedAsync(string? url)
    {
        _url = url ?? string.Empty;
        await Edited.InvokeAsync(Typed);
    }

    private async Task KeyChangedAsync(string key)
    {
        _key = key;
        await Edited.InvokeAsync(Typed);
    }

    private Task TestAsync() => Test.InvokeAsync(Typed);

    private bool _addingExternalUrl;

    private bool ShowsExternalUrl => _addingExternalUrl || Instance.ExternalUrl.IsSome();

    private Task ExternalUrlChangedAsync(string? url) => InstanceChanged.InvokeAsync(Instance with { ExternalUrl = Text(url ?? string.Empty) });

    private Task RemoveExternalUrlAsync()
    {
        _addingExternalUrl = false;
        return InstanceChanged.InvokeAsync(Instance with { ExternalUrl = new None() });
    }

    private Task ProfileChangedAsync(int? profile) => InstanceChanged.InvokeAsync(Instance with { QualityProfileId = Optional.Of(profile) });

    private Task FolderChangedAsync(string? folder) => InstanceChanged.InvokeAsync(Instance with { RootFolderPath = Optional.Of(folder) });

    private Task AnimeFolderChangedAsync(string? folder)
    {
        var anime = Optional.Of(folder).When(path => path.Length > 0);
        return InstanceChanged.InvokeAsync(Instance with { AnimeRootFolderPath = anime, AnimeQualityProfileId = anime.Map(_ => Instance.AnimeQualityProfileId) });
    }

    private Task AnimeProfileChangedAsync(int? profile) => InstanceChanged.InvokeAsync(Instance with { AnimeQualityProfileId = Optional.Of(profile) });

    private Task MonitoredChangedAsync(bool monitored) => InstanceChanged.InvokeAsync(Instance with { Monitored = monitored });

    private Task SearchChangedAsync(bool search) => InstanceChanged.InvokeAsync(Instance with { SearchOnAdd = search });

    private static Optional<string> Text(string typed) => Optional.When(!string.IsNullOrWhiteSpace(typed), typed.Trim);

    private static string Free(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB", "PB"];
        var size = (double)bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return FormattableString.Invariant($"{size:0.#} {units[unit]}");
    }
}
