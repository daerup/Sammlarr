@using System.Globalization
@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

<div class="w-fit max-w-full overflow-hidden rounded-lg border bg-card">
    <CardHead Icon="network" Title="Which service does what">
        @if (!CanPick)
        {
            <span class="ml-auto flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIcon Name="lock" Size="11"/>
                Managed by an admin
            </span>
        }
    </CardHead>

    <div class="overflow-x-auto px-4 pb-2.5 pt-2">
        <div class="map" style="width: @Px(ServicesMapModel.Width)px; height: @Px(_model.Height)px">
            @foreach (var role in _model.Roles)
            {
                <div class="map-role" style="top: @Px(role.Y - ServicesMapModel.ServiceHeight / 2)px">
                    <span class="map-role-icon"><LucideIcon Name="@role.Icon" Size="14"/></span>
                    <div>
                        <div class="map-role-name">@role.Name</div>
                        <div class="map-role-description">@role.Description</div>
                    </div>
                </div>
            }

            <svg class="map-traces" width="@Px(ServicesMapModel.Width)" height="@Px(_model.Height)" viewBox="0 0 @Px(ServicesMapModel.Width) @Px(_model.Height)" aria-hidden="true">
                @foreach (var trace in _model.Traces)
                {
                    <path class="@(trace.Role == Hot ? "is-hot" : null)" d="@trace.Path" stroke="@Color(trace.Provider)" stroke-dasharray="@Dash(trace.Provider)"/>
                }
                @foreach (var service in _model.Services)
                {
                    @foreach (var pin in service.Pins)
                    {
                        <rect x="@Px(ServicesMapModel.ServiceX - 5)" y="@Px(pin - 1.3)" width="5" height="2.6" rx="0.6" fill="@Color(service.Provider)"/>
                    }
                }
            </svg>

            @foreach (var service in _model.Services)
            {
                var style = $"left: {Px(ServicesMapModel.ServiceX)}px; top: {Px(service.Y - ServicesMapModel.ServiceHeight / 2)}px; --brand: {Color(service.Provider)}";
                @if (Opens(service.Provider) is { } opens)
                {
                    <button type="button" class="map-service is-openable" style="@style" @onclick="() => ServiceOpened.InvokeAsync(opens)">
                        <span class="sr-only">Open </span>
                        @ServiceBody(service.Provider)
                        <span class="map-service-glyph"><LucideIcon Name="settings-2" Size="14"/></span>
                    </button>
                }
                else
                {
                    <div class="map-service" style="@style">
                        @ServiceBody(service.Provider)
                    </div>
                }
            }

            @foreach (var tile in _model.Tiles)
            {
                <button type="button"
                        class="map-tile @EdgeClass(tile) @(Ready.Contains(tile.Provider) ? null : "is-off")"
                        style="left: @Px(tile.X)px; top: @Px(tile.Y)px; --brand: @Brand(tile.Provider).BrandColor"
                        title="@TileLabel(tile)"
                        @onclick="() => ServiceOpened.InvokeAsync(tile.Provider)">
                    <ProviderLogo Provider="tile.Provider" Form="ProviderLogoForm.Mark" Size="18" Decorative="true"/>
                    @if (!Ready.Contains(tile.Provider))
                    {
                        <span class="map-dot bg-destructive"></span>
                    }
                    <span class="sr-only">@TileLabel(tile)</span>
                </button>
            }

            <svg class="map-vias" width="@Px(ServicesMapModel.Width)" height="@Px(_model.Height)" viewBox="0 0 @Px(ServicesMapModel.Width) @Px(_model.Height)" aria-hidden="true">
                @foreach (var role in _model.Roles)
                {
                    <circle class="@(role.Provider is null ? "is-feeds" : null)" cx="@Px(ServicesMapModel.RoleWidth)" cy="@Px(role.Y)" r="2.6"
                            stroke="@(role.Provider is { } provider ? Color(provider) : null)"/>
                }
            </svg>

            @if (CanPick)
            {
                @foreach (var role in _model.Roles)
                {
                    @if (role.Picker is { } picker)
                    {
                        <span class="map-chip-slot" style="left: @Px(ServicesMapModel.ChipX)px; top: @Px(role.Y)px; --brand: @Color(picker.Current)"
                              @onmouseenter="() => _hovered = role.Name" @onmouseleave="() => _hovered = null">
                            <BbDropdownMenu OnOpenChange="open => Opened(role.Name, open)">
                                <BbDropdownMenuTrigger AsChild="false" Class="map-chip" ActiveClass="is-open" aria-label="@($"Change what {role.Name} uses")">
                                    <LucideIcon Name="chevrons-up-down" Size="12"/>
                                </BbDropdownMenuTrigger>
                                <BbDropdownMenuContent Class="w-56">
                                    <BbDropdownMenuLabel Class="text-xs font-normal text-muted-foreground">@picker.Label</BbDropdownMenuLabel>
                                    @foreach (var option in picker.Options)
                                    {
                                        var unavailable = Unavailable(picker, option);
                                        <BbDropdownMenuItem Class="gap-2.5" Disabled="@(unavailable.Length > 0)" OnClick="() => PickAsync(picker, option)">
                                            @foreach (var provider in option.Providers)
                                            {
                                                <ProviderLogo Provider="provider" Form="ProviderLogoForm.Mark" Size="20" Decorative="true"/>
                                            }
                                            <span class="flex flex-col">
                                                <span>@Name(option)</span>
                                                @if (unavailable.Length > 0)
                                                {
                                                    <span class="text-xs text-muted-foreground">@unavailable</span>
                                                }
                                            </span>
                                            @if (option == picker.Current)
                                            {
                                                <LucideIcon Name="check" Size="14" Class="ml-auto"/>
                                            }
                                        </BbDropdownMenuItem>
                                    }
                                </BbDropdownMenuContent>
                            </BbDropdownMenu>
                        </span>
                    }
                }
            }
        </div>
    </div>

    <div class="map-legend">
        <span><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4"/></svg>Connected</span>
        <span><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4" stroke-dasharray="4 3"/></svg>Not connected or pending</span>
        <span><span class="map-dot bg-success"></span>Ready</span>
        <span><span class="map-dot bg-destructive"></span>Not set up</span>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public required ProviderConfig Config { get; set; }

    [Parameter] [EditorRequired] public required IReadOnlySet<MediaProvider> Ready { get; set; }

    [Parameter] public bool CanPick { get; set; }

    [Parameter] public int People { get; set; }

    [Parameter] public EventCallback<SinkKind> SinkPicked { get; set; }

    [Parameter] public EventCallback<SearchProvider> SearchPicked { get; set; }

    [Parameter] public EventCallback<MediaProvider> ServiceOpened { get; set; }

    private RenderFragment ServiceBody(MapEndpoint endpoint) => @<text>
        @foreach (var provider in endpoint.Providers)
        {
            <ProviderLogo Provider="provider" Form="ProviderLogoForm.Mark" Size="26" Decorative="true"/>
        }
        <span class="flex min-w-0 flex-col items-start">
            <span class="map-service-name">@Name(endpoint)</span>
            <span class="map-service-status">
                <span class="map-dot @DotClass(endpoint)"></span>
                @Status(endpoint)
            </span>
        </span>
    </text>;

    private MediaProvider? Opens(MapEndpoint endpoint)
    {
        return endpoint.Partner.Match(_ => CanPick && Config.Sink == SinkKind.Arr ? (MediaProvider?)endpoint.Provider : null, () => endpoint.Provider);
    }

    private ServicesMapModel _model = null!;

    private string? _hovered;

    private string? _opened;

    private string? Hot => _opened ?? _hovered;

    private void Opened(string role, bool open) => _opened = open ? role : _opened == role ? null : _opened;

    protected override void OnParametersSet() => _model = ServicesMapModel.For(Config);

    private Task PickAsync(MapPicker picker, MapEndpoint option)
    {
        return picker.Choice switch
        {
            MapChoice.Wantlist => SinkPicked.InvokeAsync(Enum.GetValues<SinkKind>().Single(sink => MapEndpoint.Of(sink) == option)),
            MapChoice.Search => SearchPicked.InvokeAsync(Enum.GetValues<SearchProvider>().Single(search => MapEndpoint.Of(search) == option)),
        };
    }

    private string Unavailable(MapPicker picker, MapEndpoint option)
    {
        return picker.Choice switch
        {
            MapChoice.Wantlist => string.Empty,
            MapChoice.Search when IsReady(option) || option.Provider == MediaProvider.Plex => string.Empty,
            MapChoice.Search when option.Provider == MediaProvider.Tmdb => $"Add your {Name(option)} key first",
            MapChoice.Search => $"Connect {Name(option)} first",
        };
    }

    private BrandingInfo Brand(MediaProvider provider) => Branding.GetBrandingInfo(provider);

    private string Color(MapEndpoint endpoint) => endpoint.Partner.Match(_ => Branding.SinkColor(SinkKind.Arr), () => Brand(endpoint.Provider).BrandColor);

    private string Name(MapEndpoint endpoint) => string.Join(" + ", endpoint.Providers.Select(provider => Branding.GetBrandingInfo(provider).NickName));

    private bool IsReady(MapEndpoint endpoint) => endpoint.Providers.All(Ready.Contains);

    private string? Dash(MapEndpoint endpoint) => IsReady(endpoint) ? null : "4 3";

    private string DotClass(MapEndpoint endpoint) => IsReady(endpoint) ? "bg-success" : "bg-destructive";

    private string Status(MapEndpoint endpoint) => endpoint.Partner.Match(_ => PairStatus(endpoint), () => Status(endpoint.Provider));

    private string Accounts => People == 1 ? "Local accounts · 1 person" : $"Local accounts · {People} people";

    private string PairStatus(MapEndpoint endpoint) => IsReady(endpoint) ? "Connected" : "Not set up";

    private string Status(MediaProvider provider) => provider == MediaProvider.Local ? Accounts : Readiness(provider);

    private string Readiness(MediaProvider provider)
    {
        return (ServiceRoles.IsAccount(provider), Ready.Contains(provider)) switch
        {
            (true, true) => "Your account",
            (true, false) => "Not connected",
            (false, true) => "Your key is set",
            (false, false) => "No key yet",
        };
    }

    private string TileLabel(MapTile tile) => $"{Brand(tile.Provider).NickName}: {Status(tile.Provider)}";

    private static string EdgeClass(MapTile tile) =>
        tile.Entry switch
        {
            TileEdge.Bottom => "is-bottom",
            TileEdge.Top => "is-top",
        };

    private static string Px(double value) => Math.Round(value, 2).ToString(CultureInfo.InvariantCulture);
}
