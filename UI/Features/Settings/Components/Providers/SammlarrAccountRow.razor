@using Domain.Identity
@using Contracts.Identity
@using UI.Features.Settings.Components.Users
@using UI.Shared.Services.Branding
@inject IUserManagementService Users
@inject MediaProviderBrandingService Branding
@inject ICurrentUser CurrentUser
@inject NavigationManager NavigationManager

<ProviderRow Key="new SammlarrAccounts()" Brand="Brand" Open="Open" OpenChanged="OpenChanged">
    <Title>
        <span class="flex items-center gap-2 text-sm font-semibold">
            <BrandedLogo Brand="Brand" Form="ProviderLogoForm.Mark" Size="18" Decorative="true"/>
            Sammlarr
        </span>
    </Title>
    <Status>
        <BbBadge Variant="BadgeVariant.Outline" Class="h-6 items-center gap-1.5 text-success border-success">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-success"></span>
            Signed in as @CurrentUser.DisplayName
        </BbBadge>
    </Status>
    <ChildContent>
        @if (IsAdmin)
        {
            @if (_people is { } people)
            {
                <div class="flex flex-wrap gap-7 text-[13px]" data-counts>
                    @foreach (var (count, one, many) in Counts(people))
                    {
                        <span><span class="text-lg font-semibold">@count.ToString("N0")</span> <span class="text-muted-foreground">@(count == 1 ? one : many)</span></span>
                    }
                </div>
            }
            else
            {
                <BbSkeleton Class="h-7 w-80 rounded-md"/>
            }
            <div class="flex flex-wrap gap-2">
                <BbButton Size="ButtonSize.Small" OnClick="() => NavigationManager.NavigateTo(SettingsLinks.Users)">
                    <LucideIcon Name="users" Size="14" Class="mr-2"/>
                    Manage users
                </BbButton>
                <InviteDialog Invited="LoadAsync"/>
            </div>
        }
        else
        {
            <p class="text-[13px] text-muted-foreground">You sign in with your Sammlarr account. Your password lives in Account.</p>
            <div>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => NavigationManager.NavigateTo(SettingsLinks.Account)">
                    <LucideIcon Name="user-round" Size="14" Class="mr-2"/>
                    Open your account
                </BbButton>
            </div>
        }
    </ChildContent>
</ProviderRow>

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private BrandingInfo Brand => Branding.GetBrandingInfo(AuthProvider.Local);

    private bool IsAdmin => CurrentUser.Role == UserRole.Admin;

    private IReadOnlyList<Person>? _people;

    private static IReadOnlyList<(int Count, string One, string Many)> Counts(IReadOnlyList<Person> people)
    {
        var joined = people.Joined.ToList();
        return
        [
            (joined.Count, "user", "users"),
            (joined.Count(person => person.User.Role == UserRole.Admin), "admin", "admins"),
            (people.Count - joined.Count, "invite pending", "invites pending"),
            (joined.Count(person => person.LockedUntil.IsSome()), "locked out", "locked out"),
        ];
    }

    protected override async Task OnInitializedAsync()
    {
        if (IsAdmin)
        {
            await Task.Yield();
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _people = await Users.GetPeopleAsync();
    }

}
