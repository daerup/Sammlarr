@using Contracts.Auth
@using Contracts.Identity
@using Contracts.Settings
@using Domain.Identity
@inject IProviderConfigService ProviderConfigService
@inject RatingContext RatingContext
@inject IApiKeyService ApiKeys
@inject ICredentialService Credentials
@inject ICurrentUser CurrentUser

<div class="flex max-w-4xl flex-col gap-8">
    <div>
        <h2 class="text-lg font-semibold">Providers</h2>
        <p class="text-sm text-muted-foreground">Which service does what, and the account, keys and connections behind it.</p>
    </div>

    <section class="flex flex-col gap-3" aria-label="Accounts and keys">
        <h3 class="text-sm font-semibold">Accounts and keys</h3>
        <div class="rounded-lg border bg-card overflow-hidden">
            <AccountRow Provider="_authProvider"
                        Open="IsOpen(_authProvider.AsMediaProvider())"
                        OpenChanged="open => Toggle(_authProvider.AsMediaProvider(), open)"
                        Changed="RefreshReadyAsync"/>
            <ApiKeyRow Provider="ApiKeyProvider.Tmdb"
                       Open="IsOpen(MediaProvider.Tmdb)"
                       OpenChanged="open => Toggle(MediaProvider.Tmdb, open)"
                       Changed="RefreshReadyAsync">
                <Description>
                    Your TMDB API key. Get one at
                    <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener noreferrer"
                       class="underline underline-offset-2 hover:text-foreground transition-colors">themoviedb.org</a>
                </Description>
            </ApiKeyRow>
            <ApiKeyRow Provider="ApiKeyProvider.Mdblist"
                       Open="IsOpen(MediaProvider.Mdblist)"
                       OpenChanged="open => Toggle(MediaProvider.Mdblist, open)"
                       Changed="RefreshReadyAsync">
                <Description>
                    Your MDBList API key. Get one at
                    <a href="https://mdblist.com/preferences/#api" target="_blank" rel="noopener noreferrer"
                       class="underline underline-offset-2 hover:text-foreground transition-colors">mdblist.com</a>
                </Description>
            </ApiKeyRow>
        </div>
    </section>

    @if (_config is { } config)
    {
        <section class="flex flex-col gap-3" aria-label="Services">
            <h3 class="text-sm font-semibold">Services</h3>
            <ServicesMap Config="config" Ready="_ready" CanPick="@(CurrentUser.Role == UserRole.Admin)"/>
        </section>
    }
    else
    {
        <section class="flex flex-col gap-3" aria-label="Services" aria-busy="true">
            <h3 class="text-sm font-semibold">Services</h3>
            <BbSkeleton Class="h-[341px] w-full rounded-lg"/>
        </section>
    }
</div>

@code {
    [Parameter] public MediaProvider? Expanded { get; set; }

    private AuthProvider _authProvider = AuthProvider.Plex;

    private ProviderConfig? _config;

    private HashSet<MediaProvider> _ready = [];

    private MediaProvider? _open;

    private static readonly TimeSpan RevealDelay = TimeSpan.FromMilliseconds(250);

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        _config = await ProviderConfigService.GetAsync();
        _authProvider = _config.AuthProvider;
        await RefreshReadyAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Expanded is not { } provider)
        {
            return;
        }

        await Task.Delay(RevealDelay);
        _open = provider;
        StateHasChanged();
    }

    private async Task RefreshReadyAsync()
    {
        RatingContext.Refresh();
        _ready =
        [
            .. (await Credentials.GetReadyAsync()).Select(provider => provider.AsMediaProvider()),
            .. (await ApiKeys.GetReadyAsync()).Select(provider => provider.AsMediaProvider()),
        ];
    }

    private bool IsOpen(MediaProvider provider) => _open == provider;

    private void Toggle(MediaProvider provider, bool open) => _open = open ? provider : null;
}
