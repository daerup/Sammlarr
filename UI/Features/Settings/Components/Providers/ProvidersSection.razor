@using Contracts.Auth
@using Contracts.Identity
@using Contracts.Settings
@using Contracts.Wantlist
@using Domain.Identity
@using Domain.Wantlist.Arr
@using UI.Features.Settings.Components.Users
@inject IProviderConfigService ProviderConfigService
@inject RatingContext RatingContext
@inject IApiKeyService ApiKeys
@inject ICredentialService Credentials
@inject ICurrentUser CurrentUser
@inject IUserManagementService UserManagement
@inject IArrSinkConfigService ArrConfigs
@inject ISinkSwitch SinkSwitch
@inject Notifier Notifier
@inject NavigationManager Navigation
@inject ScrollService ScrollService

<div class="flex max-w-full flex-col gap-8" style="@SectionWidth">
    <div>
        <h2 class="text-lg font-semibold">Providers</h2>
        <p class="text-sm text-muted-foreground">Which service does what, and the account, keys and connections behind it.</p>
    </div>

    <section class="flex flex-col gap-3" aria-label="Accounts and keys">
        <h3 class="text-sm font-semibold">Accounts and keys</h3>
        @if (_config is null)
        {
            <BbSkeleton Class="h-[176px] w-full rounded-lg"/>
        }
        else
        {
            <AccountsAndKeys Config="_config"
                             Open="_open"
                             OpenChanged="open => _open = open"
                             Changed="AccountsChangedAsync"
                             ShowPlex="PlexForSearch"
                             PlexReturnUrl="@(PlexForSearch ? PlexSearchReturn : SettingsLinks.Providers)">
                <Arr>
                    @if (IsAdmin && ShowsArr(_config))
                    {
                        <ArrSinkRow Open="IsOpen(new Arr())"
                                    OpenChanged="open => Toggle(new Arr(), open)"
                                    SettingUp="_settingUp"
                                    Syncs="_config.Sink == SinkKind.Arr"
                                    Switching="_switching"
                                    SwitchRequested="() => ConfirmAsync(SinkKind.Arr)"
                                    StayOnPlex="StayOnPlex"
                                    InstanceMoved="MoveAsync"
                                    Changed="RefreshReadyAsync"/>
                    }
                </Arr>
            </AccountsAndKeys>
        }
    </section>

    @if (_config is { } config)
    {
        <section class="flex flex-col gap-3" aria-label="Services">
            <h3 class="text-sm font-semibold">Services</h3>
            <ServicesMap Config="MapConfig(config)" Ready="_ready" ArrReady="ArrReady(config)" CanPick="IsAdmin" People="_people" SinkPicked="SinkPickedAsync" SearchPicked="SearchPickedAsync" ServiceOpened="OpenService" ArrOpened="() => OpenRow(new Arr())" AccountsOpened="OpenAccounts"/>
        </section>

        @if (_confirming is { } target)
        {
            <SinkSwitchDialog Open="true" OpenChanged="open => _confirming = open ? _confirming : null" Target="target" People="_switchPeople" Titles="_switchTitles"
                              Switching="_switching" Confirmed="() => SwitchConfirmedAsync(target)"/>
        }
    }
    else
    {
        <section class="flex flex-col gap-3" aria-label="Services" aria-busy="true">
            <h3 class="text-sm font-semibold">Services</h3>
            <BbSkeleton Class="h-[341px] w-full rounded-lg"/>
        </section>
    }
</div>

@code {
    private static string SectionWidth => FormattableString.Invariant($"width: {ServicesMapModel.CardWidth}px");

    private const string PlexSearchReturn = $"{SettingsLinks.Providers}&search=plex";


    [Parameter] public MediaProvider? Expanded { get; set; }

    [Parameter] public SearchProvider? SearchAfterSignIn { get; set; }


    private ProviderRowKey? _scrollTo;

    private bool _plexForSearch;

    private bool _storePlexSearch;

    private ProviderConfig? _config;

    private int _people;

    private HashSet<MediaProvider> _ready = [];

    private bool _arrConnected;

    private ProviderRowKey? _open;

    private static readonly TimeSpan RevealDelay = TimeSpan.FromMilliseconds(250);

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        _config = await ProviderConfigService.GetAsync();
        _people = await UserManagement.CountAsync();
        await RefreshReadyAsync();
        _storePlexSearch = IsAdmin && SearchAfterSignIn == SearchProvider.Plex && _config.SearchProvider != SearchProvider.Plex && _ready.Contains(MediaProvider.Plex);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollTo is { } target)
        {
            _scrollTo = null;
            await ScrollService.IntoViewAsync(ProviderRows.Id(target));
        }

        if (_storePlexSearch)
        {
            _storePlexSearch = false;
            await StoreSearchAsync(SearchProvider.Plex);
            Navigation.NavigateTo(SettingsLinks.Providers, replace: true);
        }

        if (!firstRender || Expanded is not { } provider)
        {
            return;
        }

        await Task.Delay(RevealDelay);
        _open = provider;
        StateHasChanged();
    }

    private bool PlexForSearch => _plexForSearch || SearchAfterSignIn == SearchProvider.Plex;

    private async Task AccountsChangedAsync()
    {
        await RefreshReadyAsync();
        if (_plexForSearch && _ready.Contains(MediaProvider.Plex))
        {
            _plexForSearch = false;
            await StoreSearchAsync(SearchProvider.Plex);
        }
    }

    private async Task RefreshReadyAsync()
    {
        RatingContext.Refresh();
        _ready =
        [
            .. (await Credentials.GetReadyAsync()).Select(signIn => signIn.Provider()).WhereSome(),
            .. (await ApiKeys.GetReadyAsync()).Select(provider => provider.AsMediaProvider()),
        ];
        var arr = await ArrConfigs.GetAsync();
        _arrConnected = arr.IsConnectable;
    }

    private bool _settingUp;

    private bool _switching;

    private SinkKind? _confirming;

    private int _switchPeople;

    private int _switchTitles;

    private bool IsAdmin => CurrentUser.Role == UserRole.Admin;

    private ProviderConfig MapConfig(ProviderConfig config) => _settingUp ? config with { Sink = SinkKind.Arr } : config;

    private bool ShowsArr(ProviderConfig config) => config.Sink == SinkKind.Arr || config.SearchProvider == SearchProvider.Arr || _settingUp;

    private bool ArrReady(ProviderConfig config) => (config.Sink == SinkKind.Arr && !_settingUp) || _arrConnected;

    private Task SinkPickedAsync(SinkKind sink)
    {
        if (_switching)
        {
            return Task.CompletedTask;
        }

        return sink switch
        {
            SinkKind.Arr => SetUpArrAsync(),
            SinkKind.Plex => BackToPlexAsync(),
        };
    }

    private async Task SearchPickedAsync(SearchProvider search)
    {
        if (search == SearchProvider.Plex && !_ready.Contains(MediaProvider.Plex))
        {
            _plexForSearch = true;
            OpenService(MediaProvider.Plex);
            return;
        }

        await StoreSearchAsync(search);
    }

    private async Task StoreSearchAsync(SearchProvider search)
    {
        var config = await ProviderConfigService.GetAsync();
        await ProviderConfigService.StoreAsync(config with { SearchProvider = search });
        _config = await ProviderConfigService.GetAsync();
        Notifier.Success($"Search now uses {search.GetDescription()}.");
    }

    private void OpenService(MediaProvider provider) => OpenRow(provider);

    private void OpenAccounts() => OpenRow(new SammlarrAccounts());

    private void OpenRow(ProviderRowKey key)
    {
        _open = key;
        _scrollTo = key;
    }

    private Task SetUpArrAsync()
    {
        _settingUp = _config?.Sink != SinkKind.Arr;
        OpenRow(new Arr());
        return Task.CompletedTask;
    }

    private Task BackToPlexAsync()
    {
        if (_settingUp || _config?.Sink != SinkKind.Arr)
        {
            StayOnPlex();
            return Task.CompletedTask;
        }

        return ConfirmAsync(SinkKind.Plex);
    }

    private async Task ConfirmAsync(SinkKind target)
    {
        var joined = (await UserManagement.GetPeopleAsync()).Joined.ToList();
        _switchPeople = joined.Count;
        _switchTitles = joined.Sum(person => person.Holdings.Wanted);
        _confirming = target;
    }


    private async Task SwitchConfirmedAsync(SinkKind target)
    {
        await SwitchToAsync(target);
        _confirming = null;
    }

    private void StayOnPlex()
    {
        _settingUp = false;
        _open = _open is Arr ? null : _open;
    }

    private Task SwitchToAsync(SinkKind sink) => RunAsync(sink, () => SinkSwitch.SwitchAsync(sink));

    private Task MoveAsync(ArrSinkConfig arr) => RunAsync(SinkKind.Arr, () => SinkSwitch.MoveAsync(arr));

    private async Task RunAsync(SinkKind sink, Func<Task<Result<SinkSwitched>>> run)
    {
        _switching = true;
        StateHasChanged();
        try
        {
            var switched = await run();
            switched.Apply(moved => Switched(sink, moved)).ApplyError(error => Notifier.Error(error.Reason, "The wantlist did not switch"));
            _config = await ProviderConfigService.GetAsync();
            _settingUp = switched.Match(_ => false, _ => _settingUp);
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "The wantlist did not switch");
        }
        finally
        {
            _switching = false;
        }
    }

    private void Switched(SinkKind sink, SinkSwitched moved)
    {
        var skipped = moved.Unaddressable == 0 ? string.Empty : $" {moved.Unaddressable} more have no id {sink.GetDescription()} can add by and are skipped.";
        Notifier.Success($"The wantlist now syncs to {sink.GetDescription()}: {moved.Queued - moved.Unaddressable} titles go across on each user's next sync.{skipped}");
    }

    private bool IsOpen(ProviderRowKey key) => _open == key;

    private void Toggle(ProviderRowKey key, bool open) => _open = open ? key : null;
}
