@using UI.Shared.Services.Branding

<div id="@ProviderRows.Id(Key)" class="provider-row @(Ringed == Key ? "is-ringed" : null)" style="--brand: @Brand.BrandColor">
    <BbCollapsible Open="Open" OpenChanged="OpenChanged">
        <BbCollapsibleTrigger AsChild="false"
                              Class="group w-full grid grid-cols-[15px_190px_1fr_auto] items-center gap-3.5 pl-5 pr-4 py-4 text-left bg-foreground/5 hover:bg-foreground/8 transition-colors">
            <LucideIcon Name="chevron-right" Size="15" Class="text-muted-foreground transition-transform duration-150 group-data-[state=open]:rotate-90"/>
            <span class="flex items-center">
                @if (Title is { } title)
                {
                    @title
                }
                else
                {
                    <BrandedLogo Brand="Brand" Form="ProviderLogoForm.Logo" Size="18"/>
                }
            </span>
            <span class="provider-roles">
                @foreach (var role in Roles)
                {
                    <BbTooltip DelayDuration="150">
                        <BbTooltipTrigger AsChild="false" Class="provider-role" Focusable="false">
                            <LucideIcon Name="@role.Icon" Size="13"/>
                            <span class="sr-only">@role.Name</span>
                        </BbTooltipTrigger>
                        <BbTooltipContent>@role.Name</BbTooltipContent>
                    </BbTooltip>
                }
            </span>
            <span>@Status</span>
        </BbCollapsibleTrigger>
        <BbCollapsibleContent>
            <div class="flex flex-col gap-4 pl-[49px] pr-4 pt-4 pb-5">
                @ChildContent
            </div>
        </BbCollapsibleContent>
    </BbCollapsible>
</div>

@code {
    [Parameter] [EditorRequired] public required ProviderRowKey Key { get; set; }

    [Parameter] [EditorRequired] public required BrandingInfo Brand { get; set; }

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public RenderFragment? Title { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment Status { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment ChildContent { get; set; }

    [CascadingParameter(Name = ProviderRows.Ringed)] private ProviderRowKey? Ringed { get; set; }

    private IReadOnlyList<ServiceRole> Roles
    {
        get
        {
            return Key switch
            {
                MediaProvider provider => ServiceRoles.For(provider),
                SammlarrAccounts => [ServiceRoles.SignIn],
            };
        }
    }
}
