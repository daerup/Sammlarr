@using Contracts.Auth
@using UI.Shared.Services.Branding
@inject ICredentialRepository CredentialRepository
@inject ICredentialFactory CredentialFactory
@inject MediaProviderBrandingService MediaProviderBrandingService
@inject NavigationManager NavigationManager

<SettingsCard Title="@Branding.DisplayName" Color="@Branding.BrandColor">
    <Icon>
        <ProviderLogo Provider="@Branding.Provider" Size="36" Decorative="true"/>
    </Icon>
    <Badge>
        @if (_state == State.Failed)
        {
            <BbBadge Variant="BadgeVariant.Outline" Class="h-6 items-center gap-1.5 badge-soft-destructive">
                <LucideIcon Name="circle-alert" Size="12"/>
                Invalid
            </BbBadge>
        }
        else if (_state == State.Success)
        {
            <BbBadge Variant="BadgeVariant.Outline" Class="h-6 items-center gap-1.5 text-success border-success">
                <LucideIcon Name="check" Size="12"/>
                Verified
            </BbBadge>
        }
        else if (_state == State.Saved)
        {
            <BbBadge Variant="BadgeVariant.Outline" Class="h-6 items-center gap-1.5 text-success border-success">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-success"></span>
                Connected
            </BbBadge>
        }
        else
        {
            <BbBadge Variant="BadgeVariant.Secondary" Class="h-6 items-center gap-1.5 text-muted-foreground">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-muted-foreground/60"></span>
                Not connected
            </BbBadge>
        }
    </Badge>
    <ChildContent>
        <BbField>
            <BbFieldContent>
                <SensitiveInput @bind-Value="Token" Placeholder="Paste an access token" Label="token"/>
                <BbFieldDescription>Paste a @Branding.NickName access token, or connect through @Branding.NickName below.</BbFieldDescription>
            </BbFieldContent>
        </BbField>

        <div class="flex items-center gap-3">
            @if (_state == State.Idle)
            {
                <BbButton Variant="ButtonVariant.Default" OnClick="TestAsync" Disabled="string.IsNullOrWhiteSpace(_tokenInput)">
                    <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                    <span>Test</span>
                </BbButton>
            }
            else if (_state == State.Testing)
            {
                <BbButton Variant="ButtonVariant.Default" Disabled="true">
                    <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                    <span>Testing…</span>
                </BbButton>
            }
            else if (_state == State.Success)
            {
                <HoverButton Preset="HoverButtonPreset.Success" Icon="save" Text="Save" OnClick="SaveAsync"/>
            }
            else if (_state == State.Saving)
            {
                <HoverButton Preset="HoverButtonPreset.Success" Disabled="true">
                    <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                    <span>Saving…</span>
                </HoverButton>
            }
            else if (_state == State.Saved)
            {
                <BbButton Variant="ButtonVariant.Default" Class="border-success bg-success text-white" Disabled="true">
                    <LucideIcon Name="check" Size="14" Class="mr-2"/>
                    <span>Connected</span>
                </BbButton>

                <BbAlertDialog>
                    <BbAlertDialogTrigger>
                        <HoverButton Preset="HoverButtonPreset.Destructive" Icon="unplug" Text="Disconnect"/>
                    </BbAlertDialogTrigger>
                    <BbAlertDialogContent>
                        <BbAlertDialogHeader>
                            <BbAlertDialogTitle>Disconnect @Branding.DisplayName?</BbAlertDialogTitle>
                            <BbAlertDialogDescription>
                                This removes the stored @Branding.NickName credential. You will need to reconnect to use @Branding.NickName again.
                            </BbAlertDialogDescription>
                        </BbAlertDialogHeader>
                        <BbAlertDialogFooter>
                            <BbAlertDialogCancel>
                                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                            </BbAlertDialogCancel>
                            <BbAlertDialogAction>
                                <HoverButton Preset="HoverButtonPreset.Destructive" Icon="unplug" Text="Disconnect" OnClick="DisconnectAsync"/>
                            </BbAlertDialogAction>
                        </BbAlertDialogFooter>
                    </BbAlertDialogContent>
                </BbAlertDialog>
            }
            else if (_state == State.Failed)
            {
                <HoverButton Preset="HoverButtonPreset.Destructive" Icon="x" Text="Invalid" OnClick="TestAsync"/>
            }

            @if (_state != State.Saved)
            {
                <BbButton Variant="ButtonVariant.Outline" OnClick="Connect">
                    <LucideIcon Name="log-in" Size="14" Class="mr-2"/>
                    <span>Connect with @Branding.NickName</span>
                </BbButton>
            }

            @if (_tokenInput != _savedToken || _state != _savedState)
            {
                <HoverButton Preset="HoverButtonPreset.Destructive" Text="Cancel" OnClick="CancelAsync" Disabled="@(_state is State.Testing or State.Saving)"/>
            }
        </div>
    </ChildContent>
</SettingsCard>

@code {

    private enum State { Idle, Testing, Success, Saving, Saved, Failed }

    [Parameter] [EditorRequired]
    public required AuthProvider Provider { get; set; }

    private BrandingInfo Branding => MediaProviderBrandingService.GetBrandingInfo(Provider.AsMediaProvider());

    private string _tokenInput = string.Empty;
    private string _savedToken = string.Empty;
    private AuthProvider? _loadedProvider;
    private State _state = State.Idle;
    private State _savedState = State.Idle;
    private Guid _clientId;

    private string Token
    {
        get => _tokenInput;
        set
        {
            if (_tokenInput == value)
            {
                return;
            }

            _tokenInput = value;
            _state = value == _savedToken ? _savedState : State.Idle;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProvider == Provider)
        {
            return;
        }

        _loadedProvider = Provider;
        _savedState = await CredentialRepository
            .GetAsync(Provider)
            .Apply(credential =>
            {
                _savedToken = _tokenInput = credential.AccessToken;
                _clientId = credential.ClientId;
            })
            .ApplyError(_ => _savedToken = _tokenInput = string.Empty)
            .Match(State.Saved, State.Idle);
        _state = _savedState;
    }

    private async Task TestAsync()
    {
        _state = State.Testing;
        _clientId = Guid.NewGuid();
        _state = await CredentialFactory.CreateAsync(Provider, _clientId, _tokenInput, DateTimeOffset.MaxValue).Match(State.Success, State.Failed);
    }

    private async Task SaveAsync()
    {
        _state = State.Saving;
        await CredentialRepository.StoreAsync(Provider, _tokenInput, DateTimeOffset.MaxValue, _clientId);
        _savedToken = _tokenInput;
        _savedState = State.Saved;
        _state = State.Saved;
    }

    private async Task DisconnectAsync()
    {
        await CredentialRepository.ClearAsync(Provider);
        _savedToken = _tokenInput = string.Empty;
        _savedState = State.Idle;
        _state = State.Idle;
    }

    private Task CancelAsync()
    {
        _tokenInput = _savedToken;
        _state = _savedState;
        return Task.CompletedTask;
    }

    private void Connect()
    {
        var returnUrl = Uri.EscapeDataString("/settings?section=secrets");
        NavigationManager.NavigateTo($"/auth/{Provider.ToString().ToLowerInvariant()}/login?returnUrl={returnUrl}", forceLoad: true);
    }
}
