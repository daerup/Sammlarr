@using Contracts.Identity
@using Contracts.Settings
@using Domain.Identity
@using UI.Shared.Branding.Birds
@inject IUserManagementService Users
@inject IProviderConfigService ProviderConfigService
@inject ICurrentUser CurrentUser
@inject PersonPainter Painter

<div class="flex min-h-8 items-end justify-between gap-3 px-1">
    <h4 class="text-sm font-semibold">People</h4>
    @if (_config is { AuthProvider: AuthProvider.Local })
    {
        <InviteDialog Invited="LoadAsync"/>
    }
</div>

@if (_config is { } config)
{
    <div class="overflow-hidden rounded-lg border bg-card">
        @foreach (var person in _people)
        {
            var key = Key(person);
            <PersonRow @key="key" Person="person" Colour="ColourOf(person)" SignIn="config.AuthProvider" Sink="config.Sink" IsYou="IsYou(person)" IsLastAdmin="IsLastAdmin(person)"
                       Open="_open == key" OpenChanged="open => _open = open ? key : null" Changed="LoadAsync"/>
        }
    </div>
}
else
{
    <BbSkeleton Class="h-[180px] w-full rounded-lg"/>
}

@code {
    private ProviderConfig? _config;

    private IReadOnlyList<Person> _people = [];

    private string? _open;

    private IReadOnlyDictionary<UserId, PersonColour> _colours = new Dictionary<UserId, PersonColour>();

    private IReadOnlyList<JoinedPerson> Joined => [.. _people.Joined];


    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        await LoadAsync();
        StateHasChanged();
        if (await Painter.PaintAsync(Joined))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _people = await Users.GetPeopleAsync();
        _colours = PersonColours.Of(Joined);
        _config = await ProviderConfigService.GetAsync();
    }

    private PersonColour? ColourOf(Person person) => person is JoinedPerson joined ? _colours[joined.User.Id] : null;

    private static string Key(Person person)
    {
        return person switch
        {
            JoinedPerson joined => joined.User.Id.ToString(),
            InvitedPerson invited => $"invite:{invited.Username}",
        };
    }

    private bool IsYou(Person person) => person is JoinedPerson joined && joined.User.Id == CurrentUser.Id;

    private bool IsLastAdmin(Person person) => person is JoinedPerson { User.Role: UserRole.Admin } && _people.Count(IsAdmin) <= 1;

    private static bool IsAdmin(Person person) => person is JoinedPerson { User.Role: UserRole.Admin };
}