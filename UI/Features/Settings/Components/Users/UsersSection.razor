@using Contracts.Settings
@using Domain.Settings
@inject IProviderConfigService ProviderConfigService

<div class="flex w-full max-w-4xl flex-col gap-4">
    <div class="space-y-1 px-1">
        <h3 class="text-base font-semibold tracking-tight">Users</h3>
        <p class="text-sm text-muted-foreground">People with access to this Sammlarr. @How</p>
    </div>

    @if (_config is { } config)
    {
        <section class="flex flex-col gap-2" aria-label="You">
            <h4 class="px-1 text-sm font-semibold">You</h4>
            <YouCard/>
        </section>

        @if (config.AuthProvider == AuthProvider.Plex)
        {
            <SignUpsCard/>
        }

        <section class="flex flex-col gap-2" aria-label="People">
            <h4 class="px-1 text-sm font-semibold">People</h4>
            <PeopleList/>
        </section>
    }
    else
    {
        <BbSkeleton Class="h-[62px] w-full rounded-lg"/>
        <BbSkeleton Class="h-[180px] w-full rounded-lg"/>
    }
</div>

@code {
    private ProviderConfig? _config;

    private string How
    {
        get
        {
            return _config?.AuthProvider switch
            {
                AuthProvider.Plex => "Everyone signs in with Plex.",
                AuthProvider.Local => "Everyone signs in with a Sammlarr account.",
                null => string.Empty,
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        _config = await ProviderConfigService.GetAsync();
    }
}