@using Contracts.Identity
@using Contracts.Media
@using Contracts.Wantlist.Sync
@using Contracts.Announcing
@using Contracts.Jobs
@using Domain.Announcing
@using Domain.Identity
@using UI.Shared.Announcing
@using Domain.Jobs
@using UI.Shared.Changes
@using Domain.Wantlist.Arr
@using UI.Shared.Services.Branding
@implements IDisposable
@inject IMediaService Media
@inject IJobQueue JobQueue
@inject IWantlistSyncPlanner Planner
@inject ICurrentUser CurrentUser
@inject IEventPublisher Events
@inject IJobQueueView JobQueueView
@inject Notifier Notifier
@inject MediaProviderBrandingService Branding

<BbButtonGroup AriaLabel="Wantlist sync">
    @if (PerApp)
    {
        <BbButton Variant="ButtonVariant.Outline" OnClick="OpenAsync" Disabled="IsBusy" Class="sync-neutral whitespace-nowrap">@SyncLabel</BbButton>
    }
    else
    {
        <HoverButton OnClick="OpenAsync" Disabled="IsBusy" Color="@BrandColor" Class="whitespace-nowrap">@SyncLabel</HoverButton>
    }
    <span class="sync-status @(IsBusy ? "is-busy" : null)" style="@(PerApp || string.IsNullOrEmpty(BrandColor) ? null : $"--tint: {BrandColor};")">
        @if (_isLoadingDryRun || (_dryRun is null && _dryRunError is null))
        {
            <BbSpinner Size="SpinnerSize.Small"/>
            <span class="sync-note">Comparing</span>
        }
        else if (PerApp)
        {
            @foreach (var app in Enum.GetValues<ArrApp>())
            {
                <span class="sync-app" data-app="@app.Name" title="@app.Name">
                    <BrandedLogo Brand="Branding.GetBrandingInfo(app.Remote)" Form="ProviderLogoForm.Mark" Size="14" Decorative="true"/>
                    @if (_unreachable.Contains(app))
                    {
                        <LucideIcon Name="cloud-off" Size="13" Class="text-destructive"/>
                        <span class="sync-note" title="@_dryRunError">unreachable</span>
                    }
                    else if (_dryRun is { } report && ChangesOf(report, app) is var (adds, removes) && (adds > 0 || removes > 0))
                    {
                        @if (adds > 0)
                        {
                            <span class="is-added">@($"+{adds:N0}")</span>
                        }
                        @if (removes > 0)
                        {
                            <span class="is-removed">@($"−{removes:N0}")</span>
                        }
                    }
                    else
                    {
                        <LucideIcon Name="check" Size="13"/>
                        <span class="sr-only">in sync</span>
                    }
                </span>
            }
        }
        else if (_dryRun is { TotalChanges: > 0 } report)
        {
            @if (report.AddCount > 0)
            {
                <span class="is-added">@($"+{report.AddCount:N0}")</span>
            }
            @if (report.RemoveCount > 0)
            {
                <span class="is-removed">@($"−{report.RemoveCount:N0}")</span>
            }
        }
        else if (_dryRun is not null)
        {
            <LucideIcon Name="check" Size="13"/>
            <span class="sync-note">In sync</span>
        }
        else
        {
            <LucideIcon Name="cloud-off" Size="13"/>
            <span class="sync-note" title="@_dryRunError">@ProviderName unreachable</span>
        }
    </span>
</BbButtonGroup>

@if (!IsBusy)
{
    <ChangeDialog Open="_open"
                  OnOpenChanged="HandleOpenChangedAsync"
                  Title="Review changes before syncing"
                  Subtitle="@Subtitle"
                  Loading="_isLoadingDryRun"
                  Items="_items"
                  Chips="_chips"
                  OnSelect="ShowDetailsAsync"
                  RemovedLabel="Removing"
                  AddedLabel="Adding"
                  UnchangedLabel="Already in sync"
                  EmptyMessage="Everything is in sync."
                  BandTone="ChangeBandTone.Bad"
                  Prologue="@(OutboxEntries.Count > 0 ? OutboxStrip : null)"
                  Band="@(_dryRunError is not null ? ErrorBand : null)">
        <Actions>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="CloseAsync">Cancel</BbButton>
            <BbButton Size="ButtonSize.Small" Disabled="@(_dryRun is null || (_dryRun.TotalChanges == 0 && OutboxEntries.Count == 0))" OnClick="ConfirmAsync">
                <LucideIcon Name="refresh-cw" Size="13" Class="mr-1.5"/>
                Sync now
            </BbButton>
        </Actions>
    </ChangeDialog>

    <MediaDetailSheet Open="_selected is not null"
                      OnOpenChanged="@(open => { if (!open) { _selected = null; } })"
                      Media="_selected"/>
}

@code {
    private RenderFragment OutboxStrip =>
        @<text>
            <LucideIcon Name="send" Size="14"/>
            <span>@OutboxSummary</span>
        </text>;

    private RenderFragment ErrorBand =>
        @<text>
            <LucideIcon Name="cloud-off" Size="15" Class="shrink-0"/>
            <span>@_dryRunError</span>
        </text>;

    [Parameter] public EventCallback OnSynced { get; set; }

    [Parameter] public string? BrandColor { get; set; }

    [Parameter, EditorRequired] public string ProviderName { get; set; } = string.Empty;

    [Parameter] public IReadOnlyCollection<WantlistOutboxEntry> OutboxEntries { get; set; } = [];

    [Parameter] public EventCallback OnStatusRefresh { get; set; }

    [Parameter] public bool IsSyncing { get; set; }

    [Parameter] public EventCallback OnSyncStarted { get; set; }

    [Parameter] public SinkKind? Sink { get; set; }

    private bool PerApp => Sink == SinkKind.Arr;

    private ValueSet<ArrApp> _unreachable = [];

    private IReadOnlyDictionary<MediaId, MatchedMedia> _changedMedia = new Dictionary<MediaId, MatchedMedia>();

    private RenderFragment SyncLabel =>
        @<text>
            @if (IsBusy)
            {
                <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                <span>Syncing...</span>
            }
            else
            {
                <LucideIcon Name="refresh-cw" Size="16" Class="mr-2"/>
                <span>Sync</span>
            }
        </text>;

    private (int Adds, int Removes) ChangesOf(WantlistSyncSummary report, ArrApp app)
    {
        var changes = report.Changes.Where(change => _changedMedia.TryGetValue(change.MediaId, out var media) && media.Identity.Type == app.Type).ToList();
        return (changes.Count(change => change.Action == WantlistOperationAction.Add), changes.Count(change => change.Action == WantlistOperationAction.Remove));
    }

    private const int DryRunAttempts = 3;
    private static readonly TimeSpan DryRunRetryDelay = TimeSpan.FromSeconds(1);

    private readonly CancellationTokenSource _cts = new();
    private WantlistSyncSummary? _dryRun;
    private string? _dryRunError;
    private IReadOnlyList<ChangeItem> _items = [];
    private IReadOnlyList<ChangeChip> _chips = [];
    private bool _isSyncing;
    private bool _isRunning;
    private bool _isLoadingDryRun;
    private bool _open;
    private UserId? _viewer;
    private CoalescedReload _dryRunReload = null!;
    private MediaMatchResult? _selected;

    private bool IsBusy => _isSyncing || _isRunning || IsSyncing;

    private Task ShowDetailsAsync(MatchedMedia media)
    {
        _selected = media;
        return Task.CompletedTask;
    }

    private string OutboxSummary
    {
        get
        {
            var failed = OutboxEntries.Count(entry => entry.Status is WantlistOutboxState.Failed);
            var inFlight = OutboxEntries.Count - failed;
            var parts = new List<string>(2);
            if (inFlight > 0)
            {
                parts.Add($"{inFlight} waiting to reach {ProviderName}");
            }
            if (failed > 0)
            {
                parts.Add($"{failed} could not be delivered");
            }
            return string.Join(" · ", parts);
        }
    }

    private string Subtitle => _dryRun is { } report ? $"{report.NoOps.Count + report.TotalChanges} titles compared" : $"Comparing with {ProviderName}…";

    protected override async Task OnInitializedAsync()
    {
        _viewer = CurrentUser.Id;
        _dryRunReload = new(LoadDryRunAsync);
        Events.Published += OnEvent;
        _isRunning = await IsSyncRunningAsync();
        await RefreshAsync();
    }

    private async Task<bool> IsSyncRunningAsync()
    {
        var queue = await JobQueueView.GetAsync(_cts.Token);
        return queue.Jobs.Any(job => job.Request is SyncWantlist && job.State is JobState.Running);
    }

    public async Task RefreshAsync() => await LoadDryRunAsync();

    internal async Task OpenAsync()
    {
        _open = true;
        await OnStatusRefresh.InvokeAsync();
        await LoadDryRunAsync();
    }

    private Task CloseAsync()
    {
        _open = false;
        return Task.CompletedTask;
    }

    private Task HandleOpenChangedAsync(bool open)
    {
        _open = open;
        return Task.CompletedTask;
    }

    private async Task LoadDryRunAsync()
    {
        _isLoadingDryRun = true;
        _dryRun = null;
        _dryRunError = null;
        _items = [];
        _chips = [];
        StateHasChanged();

        var token = _cts.Token;
        try
        {
            for (var attempt = 1; attempt <= DryRunAttempts && _dryRun is null; attempt++)
            {
                if (attempt > 1)
                {
                    await Task.Delay(DryRunRetryDelay, token);
                }

                await AttemptDryRunAsync(token);
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _isLoadingDryRun = false;
        StateHasChanged();
    }

    private async Task AttemptDryRunAsync(CancellationToken cancellationToken)
    {
        var result = await Planner.PlanAsync(cancellationToken);
        switch (result)
        {
            case WantlistSyncSummary changes:
                _dryRun = changes;
                _dryRunError = changes.Down.Match(down => (string?)down.Reason, () => null);
                var ids = changes.Changes.Select(change => change.MediaId).Concat(changes.NoOps).Distinct();
                _changedMedia = await Media.GetDetailsByIdAsync(ids, cancellationToken);
                _unreachable = changes.Down.Map(down => down.Apps).GetValueOr([]);
                _items = WantlistSyncView.Items(changes, _changedMedia, ProviderName);
                _chips = WantlistSyncView.Chips(changes);
                break;
            case WantlistSyncSinkUnreachable failed:
                _dryRunError = failed.Reason;
                _unreachable = failed.Apps;
                break;
        }
    }

    private async Task ConfirmAsync()
    {
        _open = false;
        await SyncAsync();
    }

    public async Task SyncAsync()
    {
        if (_isSyncing)
        {
            return;
        }

        _isSyncing = true;
        StateHasChanged();
        try
        {
            await OnSyncStarted.InvokeAsync();
            switch (await JobQueue.EnqueueAsync(new SyncWantlist(new ManualTrigger()), _cts.Token))
            {
                case Queued:
                    Notifier.Info("Sync has been queued", null);
                    break;
                case AlreadyQueued:
                    Notifier.Info("A sync is already queued", null);
                    break;
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Sync failed");
        }
        finally
        {
            _isSyncing = false;
        }
    }

    public void Dispose()
    {
        Events.Published -= OnEvent;
        _cts.Cancel();
        _cts.Dispose();
    }

    private void OnEvent(IEvent raised)
    {
        if (ViewerEvent.Own<WantlistChangedEvent>(raised, _viewer) is not null)
        {
            _ = InvokeAsync(_dryRunReload.RunAsync);
            return;
        }

        if (ViewerEvent.Own<JobStateChangedEvent>(raised, _viewer) is not { Kind: JobKind.WantlistSync } job)
        {
            return;
        }

        _isRunning = job.State is JobState.Running;
        _ = InvokeAsync(async () =>
        {
            if (!_isRunning)
            {
                await RefreshAsync();
                await OnSynced.InvokeAsync();
            }

            StateHasChanged();
        });
    }
}
