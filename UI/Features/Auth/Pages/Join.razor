@page "/join/{User:guid}/{Token}"
@layout AuthLayout
@attribute [AllowAnonymous]
@using Domain.Identity
@using UI.Features.Auth.Components

<PageTitle>Join Sammlarr</PageTitle>

<PasswordLinkCard Kind="AccountLinkKind.Invite" User="@User" Token="@Token" Error="@Error"/>

@code {
    [Parameter] public required Guid User { get; set; }

    [Parameter] public required string Token { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}