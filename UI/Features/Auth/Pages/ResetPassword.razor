@page "/reset/{Token}"
@layout AuthLayout
@attribute [AllowAnonymous]
@using Domain.Identity
@using UI.Features.Auth.Components

<PageTitle>Choose a new password</PageTitle>

<PasswordLinkCard Kind="AccountLinkKind.Reset" Token="@Token" Error="@Error"/>

@code {
    [Parameter] public required string Token { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}