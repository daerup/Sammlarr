@page "/auth"
@using Contracts
@using Contracts.Auth
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager
@inject IOAuthService OAuthService
@inject Notifier Notifier

<PageTitle>Signing in…</PageTitle>

<div class="container flex items-center justify-center min-h-[60vh]">
    @if (_isHandlingCallback)
    {
        <div class="text-center space-y-3">
            <p class="text-muted-foreground text-sm">Completing sign-in…</p>
            <div class="h-2 w-48 bg-muted rounded-full overflow-hidden mx-auto">
                <div class="h-full w-1/3 bg-primary animate-pulse"></div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="text-center space-y-4">
            <div class="rounded-lg bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800 p-4">
                <p class="text-sm text-red-800 dark:text-red-200">⚠ @_errorMessage</p>
            </div>
            <a href="/" class="text-sm underline text-muted-foreground">Go home</a>
        </div>
    }
</div>

@code {
    private string? _errorMessage;
    private bool _isHandlingCallback;
    private string _returnUrl = "/";

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (string.IsNullOrEmpty(uri.Query))
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        var query = QueryHelpers.ParseQuery(uri.Query);
        _returnUrl = GetSafeReturnUrl(query.TryGetValue("returnUrl", out var returnUrlValues) ? returnUrlValues.FirstOrDefault() : null);

        _isHandlingCallback = true;
        await CompleteLoginAsync(uri.Query);
        _isHandlingCallback = false;

        if (_errorMessage is null)
        {
            NavigationManager.NavigateTo(_returnUrl, replace: true);
        }
    }

    private static string GetSafeReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            return "/";
        }

        if (!Uri.TryCreate(returnUrl, UriKind.Relative, out _))
        {
            return "/";
        }

        if (!returnUrl.StartsWith('/'))
        {
            return "/";
        }

        if (returnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return "/";
        }

        return returnUrl;
    }

    private async Task CompleteLoginAsync(string callbackQuery)
    {
        try
        {
            if (await OAuthService.CompleteLoginAsync(callbackQuery) is Error error)
            {
                _errorMessage = error.Reason;
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to complete sign-in");
            _errorMessage = $"Failed to complete sign-in: {ex.Message}";
        }
    }
}
