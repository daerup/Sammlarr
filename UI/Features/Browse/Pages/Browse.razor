@page "/browse"
@implements IDisposable
@using Contracts
@using Contracts.Auth
@using Contracts.DI
@using Contracts.Media
@using Contracts.Media.Trending
@using Contracts.Settings
@using Contracts.Watchlist
@inject IKeyedServiceIndex<TrendingProvider, ITrendingService> TrendingServiceIndex
@inject IWatchlistService WatchlistService
@inject NavigationManager NavigationManager
@inject AccountConnectionPrompt AccountConnectionPrompt
@inject ScrollService ScrollService
@inject IProviderConfigRepository ProviderConfigRepository

<PageTitle>Browse Movies</PageTitle>

<SignInGuard AccessChanged="HandleSignInChanged"/>
<ApiKeyGuard Provider="@_providerConfig.TrendingProvider.AsApiKeyProvider()" AccessChanged="HandleTrendingProviderAccessChanged"/>

<PageContainer Heading="Trending Movies & Shows" Description="Discover what's popular this week">
    <ChildContent>
        <ProtectedSection GuardState="IsSignedIn"
                          DeniedActionDescription="browsing trending media"
                          FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
            <ProtectedSection GuardState="HasTrendingProviderAccess"
                              ApiProvider="@_providerConfig.TrendingProvider.AsApiKeyProvider()"
                              DeniedActionDescription="browse trending media"
                              FallbackAction="@(() => NavigationManager.NavigateTo("/settings?section=secrets"))">
                @if (_isLoading)
                {
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="20"/>
                    </div>
                }
                else if (_trendingMedia != null)
                {
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        @foreach (var media in _trendingMedia)
                        {
                            <MediaGridTile @key="media"
                                           Media="media"
                                           OnClick="() => SelectMedia(media)"
                                           ShowBookmark="true"
                                           IsInWatchlist="IsInWatchlist(media)"/>
                        }
                    </div>

                    <PaginationControls CurrentPage="_currentPage"
                                        TotalPages="_totalPages"
                                        IsDisabled="_isLoading"
                                        PageChanged="HandlePageChangedAsync"/>
                }
            </ProtectedSection>
        </ProtectedSection>
    </ChildContent>
</PageContainer>

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  Media="_selectedMedia"
                  ShowMetadataRow="true"
                  ButtonAction="ToggleWatchlistAsync"
                  ButtonText="GetSideMenuButtonText"
                  ButtonIcon="GetSideMenuButtonIcon"
                  ButtonDisabled="@SelectedIsUnresolvedOrNull"/>

@code {
    private IReadOnlyList<MediaLookup>? _trendingMedia;
    private MediaLookup? _selectedMedia;
    private bool _isLoading;
    private bool _isSheetOpen;
    private bool _isSignedIn;
    private bool _hasTrendingProviderApiKey;
    private bool HasAccess => _isSignedIn && _hasTrendingProviderApiKey;
    private IReadOnlySet<MediaId> _watchlisted = new HashSet<MediaId>();
    private ProviderConfig _providerConfig = null!;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private readonly CancellationTokenSource _cancellationTokenSource = new();

    private bool SelectedIsUnresolvedOrNull => !_selectedMedia.HasValue || _selectedMedia.Value.IsUnresolved;

    protected override async Task OnInitializedAsync()
    {
        _providerConfig = await ProviderConfigRepository.GetAsync();
    }

    private bool IsSignedIn() => _isSignedIn;
    private bool HasTrendingProviderAccess() => _hasTrendingProviderApiKey;

    private async Task HandleSignInChanged(bool isAuthenticated)
    {
        _isSignedIn = isAuthenticated;

        if (!_isSignedIn)
        {
            _hasTrendingProviderApiKey = false;
            _watchlisted = new HashSet<MediaId>();
            _trendingMedia = null;
            CloseSelectedMedia();
            _isLoading = false;
            return;
        }

        await LoadWatchlistIdsAsync();
    }

    private void CloseSelectedMedia()
    {
        _selectedMedia = null;
        _isSheetOpen = false;
    }

    private async Task HandleTrendingProviderAccessChanged(bool hasAccess)
    {
        _hasTrendingProviderApiKey = hasAccess;

        if (!_hasTrendingProviderApiKey)
        {
            _trendingMedia = null;
            CloseSelectedMedia();
            _currentPage = 1;
            _totalPages = 1;
            _isLoading = false;
            return;
        }

        if (_currentPage < 1)
        {
            _currentPage = 1;
        }

        await LoadPageAsync();
    }

    private async Task LoadWatchlistIdsAsync()
    {
        _watchlisted = await WatchlistService.GetWatchlistIdsAsync(_cancellationTokenSource.Token);
    }

    private async Task LoadPageAsync()
    {
        if (!HasAccess)
        {
            return;
        }
        _isLoading = true;

        await TryStateHasChangedAsync();
        try
        {
            var trendingService = TrendingServiceIndex[_providerConfig.TrendingProvider];
            (_trendingMedia, _totalPages) = await trendingService.GetTrendingAsync(_currentPage, _cancellationTokenSource.Token);
        }
        finally
        {
            if (!_cancellationTokenSource.IsCancellationRequested)
            {
                _isLoading = false;
                await TryStateHasChangedAsync();
            }
        }
    }

    private async Task TryStateHasChangedAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) {}
    }

    private async Task HandlePageChangedAsync(int newPage)
    {
        if (newPage == _currentPage)
        {
            return;
        }
        CloseSelectedMedia();

        _currentPage = newPage;

        await ScrollService.ToTopAfterAsync(LoadPageAsync, _cancellationTokenSource.Token);
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    private bool IsInWatchlist(MediaLookup media) => !media.IsUnresolved && _watchlisted.Contains(media.Id);

    private void SelectMedia(MediaLookup media)
    {
        _selectedMedia = media;
        _isSheetOpen = true;
    }

    private string GetSideMenuButtonText()
    {
        if (!_selectedMedia.HasValue || _selectedMedia.Value.IsUnresolved)
        {
            return "Could not be matched";
        }
        return IsInWatchlist(_selectedMedia.Value) ? "Remove from Watchlist" : "Add to Watchlist";
    }

    private string GetSideMenuButtonIcon()
    {
        if (!_selectedMedia.HasValue || _selectedMedia.Value.IsUnresolved)
        {
            return "circle-alert";
        }
        return IsInWatchlist(_selectedMedia.Value) ? "x" : "plus";
    }

    private async Task ToggleWatchlistAsync()
    {
        if (!_selectedMedia.HasValue || _selectedMedia.Value.IsUnresolved)
        {
            return;
        }
        var resolved = _selectedMedia.Value;

        if (IsInWatchlist(resolved))
        {
            await WatchlistService.RemoveFromWatchlistAsync([resolved.Id]);
        }
        else
        {
            await WatchlistService.AddToWatchlistAsync([resolved.Id], new ManualOrigin(ManualSource.Browse));
        }

        await LoadWatchlistIdsAsync();
        _isSheetOpen = false;
    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }
}
