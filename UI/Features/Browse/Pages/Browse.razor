@page "/browse"
@implements IDisposable
@using Contracts.Announcing
@using Contracts.DI
@using Contracts.Identity
@using Contracts.Media.Trending
@using Contracts.Settings
@using Contracts.Wantlist
@using Domain.Announcing
@using Domain.Identity
@using UI.Shared.Announcing
@inject IKeyedServiceIndex<TrendingProvider, ITrendingService> TrendingServiceIndex
@inject IWantlistService WantlistService
@inject NavigationManager NavigationManager
@inject AccountConnectionPrompt AccountConnectionPrompt
@inject ScrollService ScrollService
@inject IProviderConfigService ProviderConfigService
@inject IEventPublisher Events
@inject ICurrentUser CurrentUser

<PageTitle>Browse Movies</PageTitle>

<SignInGuard AccessChanged="HandleSignInChanged"/>
<ServiceGuard Service="@_providerConfig.TrendingProvider.Service" AccessChanged="HandleTrendingProviderAccessChanged"/>

<PageContainer Heading="Trending Movies & Shows" Description="Discover what's popular this week">
    <ChildContent>
        <ProtectedSection GuardState="IsSignedIn"
                          DeniedActionDescription="browsing trending media"
                          FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
            <ProtectedSection GuardState="HasTrendingProviderAccess"
                              ApiProvider="@KeySlot(_providerConfig.TrendingProvider)"
                              DeniedActionDescription="browse trending media"
                              ApiKeyReason="Browse shows what is trending on TMDB, read through your own key. Add it once and this fills in."
                              FallbackAction="@(() => NavigationManager.NavigateTo(SettingsLinks.Provider(_providerConfig.TrendingProvider.Service)))">
                @if (_isLoading)
                {
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="20"/>
                    </div>
                }
                else if (_trendingMedia != null)
                {
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        @foreach (var media in _trendingMedia)
                        {
                            <MediaGridTile @key="media"
                                           Media="media"
                                           OnClick="() => SelectMedia(media)"
                                           ShowBookmark="true"
                                           IsInWantlist="IsInWantlist(media)"
                                           RatingsStoredOnly="true"/>
                        }
                    </div>

                    <PaginationControls CurrentPage="_currentPage"
                                        TotalPages="_totalPages"
                                        IsDisabled="_isLoading"
                                        PageChanged="HandlePageChangedAsync"/>
                }
            </ProtectedSection>
        </ProtectedSection>
    </ChildContent>
</PageContainer>

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  Media="_selectedMedia"
                  Source="ManualSource.Browse"/>

@code {
    private static ApiKeyProvider KeySlot(TrendingProvider trending)
    {
        return trending switch
        {
            TrendingProvider.Tmdb => ApiKeyProvider.Tmdb,
        };
    }

    private IReadOnlyList<MediaMatchResult>? _trendingMedia;
    private MediaMatchResult? _selectedMedia;
    private bool _isLoading;
    private bool _isSheetOpen;
    private bool _isSignedIn;
    private bool _hasTrendingProviderApiKey;
    private bool HasAccess => _isSignedIn && _hasTrendingProviderApiKey;
    private WantlistSnapshot _wantlist = new([]);
    private ProviderConfig _providerConfig = null!;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private UserId? _userId;
    private CoalescedReload _wantlistReload = null!;


    protected override async Task OnInitializedAsync()
    {
        _wantlistReload = new(ReloadWantlistAsync);
        Events.Published += OnEvent;
        _providerConfig = await ProviderConfigService.GetAsync();
    }

    private bool IsSignedIn() => _isSignedIn;
    private bool HasTrendingProviderAccess() => _hasTrendingProviderApiKey;

    private async Task HandleSignInChanged(bool isAuthenticated)
    {
        _isSignedIn = isAuthenticated;

        if (!_isSignedIn)
        {
            _hasTrendingProviderApiKey = false;
            _userId = null;
            _wantlist = new([]);
            _trendingMedia = null;
            CloseSelectedMedia();
            _isLoading = false;
            return;
        }

        _userId = CurrentUser.Id;
        await LoadWantlistAsync();
    }

    private void CloseSelectedMedia()
    {
        _selectedMedia = null;
        _isSheetOpen = false;
    }

    private async Task HandleTrendingProviderAccessChanged(bool hasAccess)
    {
        _hasTrendingProviderApiKey = hasAccess;

        if (!_hasTrendingProviderApiKey)
        {
            _trendingMedia = null;
            CloseSelectedMedia();
            _currentPage = 1;
            _totalPages = 1;
            _isLoading = false;
            return;
        }

        if (_currentPage < 1)
        {
            _currentPage = 1;
        }

        await LoadPageAsync();
    }

    private async Task LoadWantlistAsync()
    {
        _wantlist = await WantlistService.GetAsync(_cancellationTokenSource.Token);
    }

    private async Task LoadPageAsync()
    {
        if (!HasAccess)
        {
            return;
        }
        _isLoading = true;

        await TryStateHasChangedAsync();
        try
        {
            var trendingService = TrendingServiceIndex[_providerConfig.TrendingProvider];
            (_trendingMedia, _totalPages) = await trendingService.GetTrendingAsync(_currentPage, _cancellationTokenSource.Token);
        }
        finally
        {
            if (!_cancellationTokenSource.IsCancellationRequested)
            {
                _isLoading = false;
                await TryStateHasChangedAsync();
            }
        }
    }

    private async Task TryStateHasChangedAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) {}
    }

    private async Task HandlePageChangedAsync(int newPage)
    {
        if (newPage == _currentPage)
        {
            return;
        }
        CloseSelectedMedia();

        _currentPage = newPage;

        await ScrollService.ToTopAfterAsync(LoadPageAsync, _cancellationTokenSource.Token);
    }

    private void OnEvent(IEvent raised)
    {
        if (ViewerEvent.Own<WantlistChangedEvent>(raised, _userId) is { } changed)
        {
            _ = InvokeAsync(() => ListChange.Differs(_wantlist.Contains, changed.Added, changed.Removed) ? _wantlistReload.RunAsync() : Task.CompletedTask);
        }
    }

    private async Task ReloadWantlistAsync()
    {
        await LoadWantlistAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        Events.Published -= OnEvent;
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    private bool IsInWantlist(MediaMatchResult media) => media is MatchedMedia matched && _wantlist.Contains(matched.Identity.Id);

    private void SelectMedia(MediaMatchResult media)
    {
        _selectedMedia = media;
        _isSheetOpen = true;
    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }
}
