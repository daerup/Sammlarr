@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

<BbRadioGroup TValue="SinkKind" Value="Picked" ValueChanged="PickedChanged" Disabled="Disabled" AriaLabel="Where your wantlist syncs" Class="grid grid-cols-2 gap-3">
    @foreach (var card in Cards)
    {
        var id = $"sink-{card.Sink}";
        <label for="@id" class="sink-card" data-picked="@(card.Sink == Picked ? "true" : null)" style="--brand: @Branding.SinkColor(card.Sink)">
            <span class="flex items-center gap-2">
                @foreach (var provider in card.Sink.Providers())
                {
                    <ProviderLogo Provider="provider" Form="ProviderLogoForm.Mark" Size="20" Decorative="true"/>
                }
                <span class="text-[15px] font-medium">@card.Title</span>
                <span class="ml-auto"><BbRadioGroupItem Value="card.Sink" Id="@id"/></span>
            </span>
            <ul class="list-disc pl-5 text-sm text-muted-foreground">
                @foreach (var line in card.Lines)
                {
                    <li>@line</li>
                }
            </ul>
        </label>
    }
</BbRadioGroup>

@code {
    private static readonly SinkCard[] Cards =
    [
        new(SinkKind.Plex, "Plex watchlist", ["Titles go to your Plex watchlist", "A tool downstream (Overseerr, Pulsarr) picks them up", "Removing a title only removes it from the watchlist"]),
        new(SinkKind.Arr, "Radarr + Sonarr", ["Movies go straight to Radarr, shows to Sonarr", "Tagged as yours, so each person's titles stay apart", "Removing a title deletes it there"]),
    ];

    [Parameter] public SinkKind Picked { get; set; }

    [Parameter] public EventCallback<SinkKind> PickedChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private sealed record SinkCard(SinkKind Sink, string Title, IReadOnlyList<string> Lines);
}