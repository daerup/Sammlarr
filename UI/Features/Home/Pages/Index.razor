@page "/"
@implements IDisposable
@using Contracts
@using Contracts.Announcing
@using Contracts.Blocklist
@using Contracts.Feed
@using Contracts.Identity
@using Contracts.Media
@using Contracts.Settings
@using Contracts.Wantlist
@using Domain.Announcing
@using Domain.Feed.Run
@using Domain.Identity
@using UI.Features.Feeds.Components
@using UI.Features.Home.Components
@using UI.Shared.Announcing
@using Domain.Jobs
@using UI.Features.Wantlist.Components
@using UI.Shared.Services.Branding
@using Contracts.Jobs
@inject IFeedService FeedService
@inject IMediaService MediaService
@inject IWantlistService WantlistService
@inject IBlocklistService BlocklistService
@inject IProviderConfigService ProviderConfigService
@inject IEventPublisher Events
@inject ICurrentUser CurrentUser
@inject Notifier Notifier
@inject IJobQueue JobQueue
@inject DialogService DialogService
@inject IJobQueueView JobQueueView
@inject MediaProviderBrandingService BrandingService
@inject IDateTimeProvider Clock

<PageTitle>Sammlarr</PageTitle>

@if (_settings is null)
{
    <PageContainer>
        <HomeSkeleton/>
    </PageContainer>
}
else
{
<SignInGuard AccessChanged="HandleSignInChangedAsync"/>
<SinkGuard Sink="@_settings.Sink" ReadyChanged="HandleConnectionChanged"/>

<PageContainer Heading="Your library" Fill="true">
    <DescriptionContent>
        @if (_wantlistCount == 0)
        {
            <span>The local wantlist Sammlarr keeps in sync with your feeds.</span>
        }
        else
        {
            <AppLink Href="/wantlist" Arrow="false">@_wantlistCount.ToString("N0")</AppLink>

            <span> titles on your wantlist, assembled by</span>
            <AppLink Href="/feeds" Arrow="false">@_feeds.Count.ToString("N0")</AppLink>
            <span>@(_feeds.Count == 1 ? "feed" : "feeds"). </span>

            @if (_blocklistCount > 0)
            {
                <AppLink Href="/blocklist" Arrow="false">@_blocklistCount.ToString("N0")</AppLink>
                <span>blocklisted.</span>
            }
        }
    </DescriptionContent>
    <HeaderActions>
        <ProtectedSection GuardState="IsSignedIn" ShowFallback="false">
            <div class="flex items-center gap-2">
                @if (_feeds.Count > 0)
                {
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _isRunOpen = true)">
                        <LucideIcon Name="play" Size="16" Class="mr-2"/>
                        Run feeds
                    </BbButton>
                }
                <ProtectedComponent GuardState="IsConnected"
                                    Sink="@_settings.Sink"
                                    DeniedActionDescription="sync your wantlist">
                    <WantlistSyncButton @ref="_syncControl"
                                         OnSynced="SyncFinishedAsync"
                                         OnStatusRefresh="LoadOutboxAsync"
                                         OnSyncStarted="StartSync"
                                         IsSyncing="_syncing"
                                         BrandColor="@BrandColor"
                                         Sink="_settings.Sink"
                                         ProviderName="@ProviderName"
                                         OutboxEntries="_outbox"/>
                </ProtectedComponent>
            </div>
        </ProtectedSection>
    </HeaderActions>
    <ChildContent>
        <ProtectedSection GuardState="IsSignedIn"
                          DeniedActionDescription="viewing your library"
                          FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
            @if (_isLoading)
            {
                <HomeSkeleton/>
            }
            else if (_days.Count == 0 && _feeds.Count == 0)
            {
                <MediaListEmptyState Icon="rss" Heading="Nothing has happened yet.">
                    <ChildContent>
                        A feed follows a list on TMDB or MDBList and adds its titles to your wantlist, by hand or on a schedule.
                        Every run shows up here with what it added and why.
                    </ChildContent>
                    <Actions>
                        <BbButton Size="ButtonSize.Small" Href="/feeds/create">
                            <LucideIcon Name="plus" Size="14" Class="mr-1.5"/>
                            <span>Create your first feed</span>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="/browse">
                            <LucideIcon Name="trending-up" Size="14" Class="mr-1.5"/>
                            <span>Browse what's trending</span>
                        </BbButton>
                    </Actions>
                </MediaListEmptyState>
            }
            else
            {
                <LibrarySourcesPanel Sources="_sources" Total="_wantlistCount"/>
                <UpNextPanel Queued="_queued" Scheduled="_scheduled" OnCancel="CancelJobAsync"/>

                <div class="home-sec">
                    <h2 class="home-sec-title">Recent activity</h2>
                </div>

                @if (_days.Count == 0)
                {
                    <MediaListEmptyState Icon="clock" Heading="No feed has changed anything yet.">
                        Runs that add or remove a title will show up here.
                    </MediaListEmptyState>
                }
                else
                {
                    @foreach (var day in _days)
                    {
                        <ActivityDayBlock @key="day.Date" Day="day" Media="_media" Today="_today" OnSelect="SelectMedia" OnNeedMedia="LoadPostersAsync"/>
                    }
                }
            }
        </ProtectedSection>
    </ChildContent>
</PageContainer>

<MediaDetailSheet Open="_isSheetOpen" OnOpenChanged="SheetOpenChangedAsync" Media="_selected"/>

<RunFeedsDialog Open="_isRunOpen"
                OpenChanged="@(open => _isRunOpen = open)"
                Candidates="_candidates"
                Pending="_pendingFeeds"
                Now="_now"
                ProviderName="@ProviderName"
                OnRun="RunFeedsAsync"/>
}

@code {
    private static readonly TimeSpan ActivityWindow = TimeSpan.FromDays(14);
    private const int RunCap = 500;

    [Inject] internal AccountConnectionPrompt AccountConnectionPrompt { get; set; } = null!;

    private readonly CancellationTokenSource _cancellation = new();
    private readonly Dictionary<MediaId, MatchedMedia> _media = [];

    private IReadOnlyList<ActivityDay> _days = [];
    private IReadOnlyList<UpNextRow> _queued = [];
    private IReadOnlyList<UpNextRow> _scheduled = [];
    private IReadOnlySet<FeedId> _pendingFeeds = new HashSet<FeedId>();
    private IReadOnlyList<SourceShare> _sources = [];
    private IReadOnlyList<RunCandidate> _candidates = [];
    private IReadOnlyList<Feed> _feeds = [];
    private IReadOnlyList<WantlistOutboxEntry> _outbox = [];
    private WantlistSyncButton? _syncControl;
    private bool _isConnected;
    private bool _isRunOpen;
    private bool _syncing;
    private ProviderConfig? _settings;
    private MediaMatchResult? _selected;
    private UserId? _userId;
    private DateTimeOffset _now;
    private DateOnly _today;
    private int _wantlistCount;
    private int _blocklistCount;
    private WantlistSnapshot _wantlist = new([]);
    private BlocklistSnapshot _blocklist = new([]);
    private CoalescedReload _reload = null!;
    private bool _isLoading = true;
    private bool _isSignedIn;
    private bool _isSheetOpen;

    private bool IsSignedIn() => _isSignedIn;

    private IReadOnlyDictionary<FeedId, string> FeedNames() => _feeds.ToDictionary(feed => feed.Id, feed => feed.Name);

    private IReadOnlyDictionary<FeedId, IReadOnlyList<BrandingInfo>> FeedBrands()
    {
        return _feeds.ToDictionary(feed => feed.Id, feed => BrandingService.Brands(feed.Provider.Service));
    }

    private IReadOnlyList<BrandingInfo> Sink => BrandingService.Brands((_settings?.Sink ?? SinkKind.Plex).Service);

    private bool IsConnected() => _isConnected;

    private string? BrandColor => _settings is null ? null : BrandingService.Color(_settings.Sink.Service);

    private void StartSync()
    {
        _syncing = true;
    }

    private async Task SyncFinishedAsync()
    {
        _syncing = false;
        await LoadAsync();
    }

    private void HandleConnectionChanged(bool hasAccess)
    {
        _isConnected = hasAccess;
    }

    private async Task RunFeedsAsync((IReadOnlyList<FeedId> Feeds, bool SyncAfter) plan)
    {
        try
        {
            Notifier.Info(await FeedRunQueue.EnqueueAsync(JobQueue, plan.Feeds, plan.SyncAfter, _cancellation.Token), null);
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "The feeds could not be queued");
        }
    }

    private async Task CancelJobAsync(UpNextRow row)
    {
        var answer = await DialogService.ConfirmAsync(
            $"Cancel {row.Name}?",
            row.CancelNote,
            new ConfirmDialogOptions { ConfirmText = "Cancel it", CancelText = "Keep it", Destructive = true }
        );
        if (!answer.Confirmed)
        {
            return;
        }

        try
        {
            await row.Job
                .Map(job => JobQueue.CancelAsync(job, _cancellation.Token))
                .Apply(_ => Notifier.Success($"{row.Name} was cancelled."))
                .ApplyNone(() => Notifier.Info($"{row.Name} already started, so it could not be cancelled."));
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "The job could not be cancelled");
        }
    }

    private string ProviderName => _settings is null ? "your media service" : BrandingService.Name(_settings.Sink.Service);

    protected override async Task OnInitializedAsync()
    {
        ReadClock();
        _reload = new(LoadAsync);
        Events.Published += OnEvent;
        _settings = await ProviderConfigService.GetAsync();
    }

    private async Task HandleSignInChangedAsync(bool hasAccess)
    {
        _isSignedIn = hasAccess;

        if (!hasAccess)
        {
            ClearLibrary();
            return;
        }

        _userId = CurrentUser.Id;
        _isLoading = true;
        await Task.Yield();
        await LoadAsync();
    }

    private void ReadClock()
    {
        _now = Clock.Now.ToLocalTime();
        _today = DateOnly.FromDateTime(_now.DateTime);
    }

    private void ClearLibrary()
    {
        _userId = null;
        _days = [];
        _queued = [];
        _scheduled = [];
        _sources = [];
        _candidates = [];
        _feeds = [];
        _outbox = [];
        _media.Clear();
        _wantlistCount = 0;
        _blocklistCount = 0;
        _selected = null;
        _isSheetOpen = false;
        _isRunOpen = false;
        _isLoading = false;
    }

    private async Task LoadOutboxAsync()
    {
        _outbox = (await WantlistService.GetOutboxAsync(_cancellation.Token)).Entries;
    }

    private async Task LoadAsync()
    {
        ReadClock();

        try
        {
            var feeds = await FeedService.GetAsync(_cancellation.Token);
            _feeds = [.. feeds.Feeds.Select(overview => overview.Feed)];
            var runs = await FeedService.GetRunsAsync(RunQuery.Take(RunCap) with { Since = Some.Of(_now - ActivityWindow) }, _cancellation.Token);
            _wantlist = await WantlistService.GetAsync(_cancellation.Token);
            _blocklist = await BlocklistService.GetAsync(_cancellation.Token);
            _outbox = (await WantlistService.GetOutboxAsync(_cancellation.Token)).Entries;
            var queue = await JobQueueView.GetAsync(_cancellation.Token);

            var names = FeedNames();
            var brands = FeedBrands();
            _wantlistCount = _wantlist.Ids.Count;
            _blocklistCount = _blocklist.Ids.Count;
            _sources = LibraryView.Sources(feeds.Feeds, _wantlistCount, ProviderName);
            _queued = UpNextView.InTheQueue(queue, names, brands, Sink);
            _pendingFeeds = UpNextView.FeedsAlreadyPending(queue);
            _scheduled = UpNextView.OnASchedule(_feeds, _now, TimeZoneInfo.Local, BrandingService);
            _candidates = RunPlan.Candidates(feeds.Feeds, _now, TimeZoneInfo.Local);
            _days = ActivityLog.Days(runs, names, TimeZoneInfo.Local);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load your library");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadPostersAsync(IReadOnlyList<MediaId> ids)
    {
        var wanted = ids.Where(id => !_media.ContainsKey(id)).Distinct().ToList();
        if (wanted.Count == 0)
        {
            return;
        }

        try
        {
            foreach (var (id, media) in await MediaService.GetDetailsByIdAsync(wanted, _cancellation.Token))
            {
                _media[id] = media;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
    }

    private void OnEvent(IEvent raised)
    {
        if (ViewerEvent.Own<FeedRunFinishedEvent>(raised, _userId) is not null)
        {
            _ = InvokeAsync(_reload.RunAsync);
            return;
        }

        if (ViewerEvent.Own<WantlistChangedEvent>(raised, _userId) is { } wanted)
        {
            _ = InvokeAsync(() => ListChange.Differs(_wantlist.Contains, wanted.Added, wanted.Removed) ? _reload.RunAsync() : Task.CompletedTask);
            return;
        }

        if (ViewerEvent.Own<BlocklistChangedEvent>(raised, _userId) is { } blocked)
        {
            _ = InvokeAsync(() => ListChange.Differs(_blocklist.Contains, blocked.Added, blocked.Removed) ? _reload.RunAsync() : Task.CompletedTask);
            return;
        }

        if (ViewerEvent.Own<JobStateChangedEvent>(raised, _userId) is not null)
        {
            _ = InvokeAsync(RefreshQueueAsync);
        }
    }

    private async Task RefreshQueueAsync()
    {
        try
        {
            var snapshot = await JobQueueView.GetAsync(_cancellation.Token);
            _queued = UpNextView.InTheQueue(snapshot, FeedNames(), FeedBrands(), Sink);
            _pendingFeeds = UpNextView.FeedsAlreadyPending(snapshot);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        StateHasChanged();
    }

    private void SelectMedia(MatchedMedia media)
    {
        _selected = media;
        _isSheetOpen = true;
    }

    private Task SheetOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            _isSheetOpen = false;
            _selected = null;
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Events.Published -= OnEvent;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
