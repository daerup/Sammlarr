<div class="band">
    <div class="band-head">
        <span class="band-title">Up next</span>
        <span class="band-note">@Note</span>
    </div>

    @if (Queued.Count > 0)
    {
        <UpNextSection Title="Running and queued" Rows="Queued"/>
    }

    @if (Scheduled.Count > 0)
    {
        <UpNextSection Title="On a schedule" Rows="NextScheduled"/>
    }

    @if (Queued.Count == 0 && Scheduled.Count == 0)
    {
        <p class="band-empty">No feed is on a schedule, so nothing will run on its own.</p>
    }
</div>

@code {
    private const int ScheduledShown = 5;

    [Parameter] public IReadOnlyList<UpNextRow> Queued { get; set; } = [];
    [Parameter] public IReadOnlyList<UpNextRow> Scheduled { get; set; } = [];

    private IReadOnlyList<UpNextRow> NextScheduled => [.. Scheduled.Take(ScheduledShown)];

    private string Note =>
        Queued.Count > 0
            ? $"{Queued.Count} in the queue"
            : Scheduled.Count switch
            {
                0 => "nothing scheduled",
                1 => "1 feed on a schedule",
                var count => $"{count} feeds on a schedule",
            };
}
