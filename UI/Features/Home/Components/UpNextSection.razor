<button type="button" class="sect" aria-expanded="@_open" @onclick="@(() => _open = !_open)">
    <LucideIcon Name="@(_open ? "chevron-down" : "chevron-right")" Size="12"/>
    <span class="sect-title">@Title</span>
    <span class="sect-count">@Rows.Count</span>
</button>

@if (_open)
{
    @foreach (var row in Rows)
    {
        <div class="row">
            <span class="row-icon @(row.Kind is UpNextKind.Running ? "is-running" : "")">
                <LucideIcon Name="@Icon(row.Kind)" Size="12"/>
            </span>
            <span class="row-body">
                @if (row.Href is { } href)
                {
                    <a class="row-name" href="@href">@row.Name</a>
                }
                else
                {
                    <span class="row-name">@row.Name</span>
                }
                <span class="row-detail">@row.Detail</span>
            </span>
            <span class="row-when @(row.Kind is UpNextKind.Running ? "is-running" : "")">@row.When</span>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<UpNextRow> Rows { get; set; }

    private bool _open = true;

    private static string Icon(UpNextKind kind) =>
        kind switch
        {
            UpNextKind.Running => "loader",
            UpNextKind.Queued => "ellipsis",
            UpNextKind.Scheduled => "clock",
        };
}
