@page "/blacklist"
@inherits MediaListPage
@using Contracts.Blacklist
@using Contracts.Watchlist
@using UI.Shared.Services.Branding
@using UI.Shared.Filters
@inject IBlacklistService BlacklistService
@inject ToastService ToastService
@inject IWatchlistService WatchlistService
@inject MediaProviderBrandingService BrandingService

<PageTitle>Blacklist</PageTitle>

@{
    var gridItems = GridItems;
    var pageItems = Paged(gridItems);
}

<MediaListShell Settings="Settings"
                Heading="Blacklist"
                Description="Your blacklisted movies and shows."
                IsSignedIn="IsSignedIn"
                IsConnected="IsConnected"
                DeniedActionDescription="managing your blacklist"
                OnSignInChanged="HandleSignInChanged"
                OnAccessChanged="HandleAccessChanged"
                Search="@Filter.Search"
                SearchChanged="ApplySearchAsync">
    <HeaderExtras>
        <MediaListViewActions HasItems="@(_items is { Count: > 0 })"
                              IsEditMode="IsEditMode"
                              ShowFilters="ShowFilters"
                              Filter="Filter"
                              OnEnterEditMode="EnterEditMode"
                              OnToggleFilters="ToggleFilterBar"/>
    </HeaderExtras>
    <ChildContent>
        <MediaListBody IsLoading="IsLoadingList"
                       ErrorMessage="@ErrorMessage"
                       OnRetry="LoadAsync"
                       TotalCount="_items?.Count"
                       VisibleCount="gridItems.Count"
                       ShowFilters="ShowFilters"
                       Filter="Filter"
                       FilterChanged="ApplyFilterAsync"
                       CurrentPage="@PageWithin(gridItems.Count)"
                       PageCount="@PageCount(gridItems.Count)"
                       PageChanged="GoToPageAsync">
            <EmptyState>
                <MediaListEmptyState Icon="shield-off" Heading="Nothing blacklisted.">
                    Add a title with <span class="font-medium text-foreground">Ctrl+K</span> to keep it out of your Watchlist.
                </MediaListEmptyState>
            </EmptyState>
            <Grid>
                <BulkEditableMediaGrid TItem="BlacklistedMedia"
                                       Items="pageItems"
                                       AllItems="gridItems"
                                       Detail="@(i => i.Media)"
                                       Key="@(i => i.Media.Id)"
                                       IsEditMode="IsEditMode"
                                       IsEditModeChanged="SetEditMode"
                                       OnTileClick="@(i => SelectItem(i.Media))"
                                       OnBulkRemove="RemoveBulkAsync"
                                       RemoveLabel="Remove"
                                       MarkLabel="Watchlist"
                                       MarkIcon="bookmark"
                                       MarkTint="@WatchlistBrandColor"
                                       OnBulkMark="WatchlistBulkAsync"
                                       RemoveConfirm="RemoveConfirm"
                                       MarkConfirm="WatchlistConfirm"
                                       IsMarked="@(item => _watchlistedIds.Contains(item.Media.Id))"
                                       AlreadyMarkedHint="Every selected title is already on your watchlist."/>
            </Grid>
        </MediaListBody>
    </ChildContent>
</MediaListShell>

<MediaDetailSheet Open="IsSheetOpen"
                  OnOpenChanged="SheetOpenChangedAsync"
                  Media="_selectedItem"
                  OnEnrollmentChanged="@(_ => LoadAsync())"/>

@code {
    private IReadOnlyList<BlacklistedMedia>? _items;
    private MediaLookup? _selectedItem;
    private IReadOnlySet<MediaId> _watchlistedIds = new HashSet<MediaId>();

    private IReadOnlyList<BlacklistedMedia> GridItems =>
        [
            .. Filter.SortBy(
                (_items ?? []).Where(item => Filter.MatchesType(item.Media.ToMatch().MediaType) && Filter.MatchesSearch(item.Media.Title)),
                item => item.Media,
                item => item.AddedAt
            ),
        ];

    protected override void ClearItems() => _items = null;

    protected override void ClearSelection() => _selectedItem = null;

    protected override async Task LoadAsync()
    {
        IsLoadingList = true;
        ErrorMessage = null;
        StateHasChanged();

        try
        {
            _items = await BlacklistService.GetBlacklistItemsAsync(Cancellation.Token).ToListAsync();
            _watchlistedIds = await WatchlistService.GetWatchlistIdsAsync(Cancellation.Token);

            if (_selectedItem.HasValue)
            {
                var selectedId = _selectedItem.Value.Id;
                _selectedItem = _items.FirstOrDefault(i => i.Media.Id == selectedId)?.Media.ToMatch();
                if (_selectedItem is null)
                {
                    IsSheetOpen = false;
                }
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load blacklist");
            ErrorMessage = $"Failed to load blacklist: {ex.Message}";
        }
        finally
        {
            IsLoadingList = false;
            StateHasChanged();
        }
    }

    private void SelectItem(MediaLookup detail)
    {
        _selectedItem = detail;
        IsSheetOpen = true;
    }

    private async Task RemoveBulkAsync(IReadOnlyList<BlacklistedMedia> toRemove)
    {
        foreach (var item in toRemove)
        {
            await BlacklistService.RemoveFromBacklistAsync(item.Media.Id, Cancellation.Token);
        }
        ToastService.Success($"Removed {toRemove.Count} item{(toRemove.Count == 1 ? "" : "s")} from your blacklist.");
        await LoadAsync();
    }

    private async Task WatchlistBulkAsync(IReadOnlyList<BlacklistedMedia> toMark)
    {
        await WatchlistService.AddToWatchlistAsync(toMark.Select(item => item.Media.Id), new ManualOrigin(ManualSource.Search), Cancellation.Token);
        ToastService.Success($"Added {toMark.Count} title{(toMark.Count == 1 ? "" : "s")} to your watchlist.");
    }

    private string? WatchlistBrandColor =>
        Settings is null ? null : BrandingService.GetBrandingInfo(Settings.WatchlistProvider.AsMediaProvider()).BrandColor;

    private static BulkConfirm RemoveConfirm(int count) =>
        new(
            $"Remove {Titles(count)} from your blacklist?",
            "Later feed runs will be able to add them again. They are not added to your watchlist."
        );

    private static BulkConfirm WatchlistConfirm(int count) => new($"Watchlist {Titles(count)}?", "They stay blacklisted.");

    private static string Titles(int count) => count == 1 ? "1 title" : $"{count} titles";
}
