@page "/blacklist"
@implements IDisposable
@using Contracts
@using Contracts.Blacklist
@using Contracts.Media
@using Contracts.Media.Search
@using Contracts.Settings
@inject IBlacklistService BlacklistService
@inject ScrollService ScrollService
@inject ProfileDropdownService ProfileDropdownService
@inject IProviderConfigRepository ProviderConfigRepository
@inject Notifier Notifier
@inject ToastService ToastService

<PageTitle>@PageTitleText</PageTitle>

@if (_providerSettings is null)
{
    <PageContainer>
        <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
        </div>
    </PageContainer>
}
else
{
    <PageContainer Heading="@PageHeading" Description="@PageDescription">
        <HeaderActions>
            <div class="flex items-center gap-2">
                <BbCommand Class="border">
                    <BbCommandItem OnSelect="OpenSearchModal" Value="search" class="search-command-item">
                        <LucideIcon Name="search" Class="mr-2"/>
                        Add from Search
                        <BbKbd Keys="Ctrl+K" Class="search-command-item-shortcut"/>
                    </BbCommandItem>
                </BbCommand>
                @if (_items is { Count: > 0 } && !_isEditMode)
                {
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Default" @onclick="EnterEditMode" Class="whitespace-nowrap">
                        <LucideIcon Name="square-check" Size="16" Class="mr-2"/>
                        Bulk edit
                    </BbButton>
                }
            </div>
        </HeaderActions>
        <ChildContent>
            @if (_isLoading)
            {
                <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
                    <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
                </div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="rounded-lg border bg-destructive/10 border-destructive/20 p-4 space-y-3">
                    <p class="text-sm text-destructive font-medium">@_errorMessage</p>
                    <BbButton Variant="ButtonVariant.Secondary" @onclick="LoadBlacklistAsync">
                        <LucideIcon Name="refresh-cw" Size="16" Class="mr-2"/>
                        Retry
                    </BbButton>
                </div>
            }
            else if (_items is not null && _items.Count == 0)
            {
                <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-3">
                    <LucideIcon Name="shield-off" Size="36" Class="mx-auto text-muted-foreground"/>
                    <h3 class="text-base font-semibold tracking-tight">Nothing blacklisted.</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed">Add a title with <span class="font-medium text-foreground">Ctrl+K</span> to keep it out of your Watchlist.</p>
                </div>
            }
            else if (_items is not null)
            {
                <BulkEditableMediaGrid TItem="BlacklistedMedia"
                                       Items="_items"
                                       Detail="@(i => i.Media)"
                                       Key="@(i => i.Media.Id)"
                                       IsEditMode="_isEditMode"
                                       IsEditModeChanged="@(v => _isEditMode = v)"
                                       OnTileClick="@(i => SelectItem(i.Media))"
                                       OnBulkRemove="RemoveBulkAsync"
                                       RemoveLabel="Remove from Blacklist"/>
            }
        </ChildContent>
    </PageContainer>
}

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  Media="_selectedItem"
                  ShowMetadataRow="false"
                  ButtonAction="RemoveSelectedFromBlacklistAsync"
                  ButtonText="GetRemoveButtonText"
                  ButtonIcon="GetRemoveButtonIcon"/>

<SearchModal @bind-IsOpen="_isSearchModalOpen"
             SearchProvider="@_providerSettings.SearchProvider"
             IsInWatchlist="IsBlacklisted"
             OnToggle="ToggleFromSearchAsync"
             Title="Search & Add to Blacklist"
             Description="Find a movie or show and add it to your blacklist.">
    <TileIcons Context="ctx">
        <BlacklistToggleIcon Result="ctx.Result" IsToggled="ctx.IsToggled" IsToggling="ctx.IsToggling" OnToggle="ctx.OnToggle"/>
    </TileIcons>
</SearchModal>

@code {
    private IReadOnlyList<BlacklistedMedia>? _items;
    private MediaLookup? _selectedItem;
    private bool _isLoading;
    private bool _isRemoving;
    private bool _isSheetOpen;
    private bool _isSearchModalOpen;
    private bool _isEditMode;
    private string? _errorMessage;
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private ProviderConfig? _providerSettings;

    private string PageTitleText => "Blacklist";
    private string PageHeading => "Blacklist";
    private string PageDescription => "Your blacklisted movies and shows.";
    private string EmptyStateMessage => "Your blacklist is empty.";
    protected override async Task OnInitializedAsync()
    {
        _providerSettings = await ProviderConfigRepository.GetAsync() ?? throw new InvalidOperationException("Provider settings are not configured.");
        await LoadBlacklistAsync();
    }

    private async Task LoadBlacklistAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _items = await BlacklistService.GetBlacklistItems(_cancellationTokenSource.Token).ToListAsync();

            if (_selectedItem.HasValue)
            {
                var selectedId = _selectedItem.Value.Id;
                _selectedItem = _items.FirstOrDefault(i => i.Media.Id == selectedId)?.Media.ToMatch();
                if (_selectedItem is null)
                {
                    _isSheetOpen = false;
                }
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load blacklist");
            _errorMessage = $"Failed to load blacklist: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static string GetRemoveButtonText() => "Remove from Blacklist";

    private static string GetRemoveButtonIcon() => "x";

    private void SelectItem(MediaLookup detail)
    {
        _selectedItem = detail;
        _isSheetOpen = true;
    }

    private void EnterEditMode()
    {
        _isEditMode = true;
        CloseSelectedMedia();
    }

    private async Task RemoveBulkAsync(IReadOnlyList<BlacklistedMedia> toRemove)
    {
        foreach (var item in toRemove)
        {
            await BlacklistService.RemoveFromBacklistAsync(item.Media.Id, _cancellationTokenSource.Token);
        }
        ToastService.Success($"Removed {toRemove.Count} item{(toRemove.Count == 1 ? "" : "s")} from your blacklist.");
        await LoadBlacklistAsync();
    }

    private async Task RemoveSelectedFromBlacklistAsync()
    {
        if (_isRemoving)
        {
            return;
        }

        if (!_selectedItem.HasValue)
        {
            return;
        }

        _isRemoving = true;

        try
        {
            await BlacklistService.RemoveFromBacklistAsync(_selectedItem.Value.Id, _cancellationTokenSource.Token);
            CloseSelectedMedia();
            await LoadBlacklistAsync();
        }
        finally
        {
            _isRemoving = false;
        }
    }

    private void CloseSelectedMedia()
    {
        _isSheetOpen = false;
        _selectedItem = null;
    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }

    private bool IsBlacklisted(MediaId mediaId)
    {
        if (_items is null)
        {
            return false;
        }

        return _items.Any(item => item.Media.Id.Equals(mediaId));
    }

    private void OpenSearchModal()
    {
        _isSearchModalOpen = true;
    }

    private async Task<bool> ToggleFromSearchAsync(MediaId id, string title, bool isMarked)
    {
        if (isMarked)
        {
            if (!IsBlacklisted(id))
            {
                Notifier.Warning($"'{title}' is not in your blacklist.");
                return false;
            }

            try
            {
                await BlacklistService.RemoveFromBacklistAsync(id, _cancellationTokenSource.Token);
                Notifier.Success($"'{title}' has been removed from your blacklist.");
                await LoadBlacklistAsync();
                return true;
            }
            catch (Exception ex)
            {
                Notifier.Error(ex, "Failed to remove from blacklist");
                return false;
            }
        }

        if (IsBlacklisted(id))
        {
            Notifier.Warning($"'{title}' is already in your blacklist.");
            return false;
        }

        try
        {
            await BlacklistService.AddToBacklistAsync(id, _cancellationTokenSource.Token);
            Notifier.Success($"'{title}' has been added to your blacklist.");
            await LoadBlacklistAsync();
            return true;
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to add to blacklist");
            return false;
        }
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}




