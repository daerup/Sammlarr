@page "/watchlist"
@using Contracts.Identity
@using Contracts.Settings
@using Contracts.Watchlist
@using Contracts.Watchlist.Outbox
@using Domain.Identity
@using UI.Features.Watchlist.Components
@using UI.Shared.Services.Branding
@implements IDisposable
@inject IWatchlistService WatchlistService
@inject IWatchlistOutbox Outbox
@inject AccountConnectionPrompt AccountConnectionPrompt
@inject IProviderConfigRepository ProviderConfigRepository
@inject MediaProviderBrandingService BrandingService
@inject Notifier Notifier
@inject IWatchlistOutboxEventFeed OutboxEventFeed
@inject ICurrentUser CurrentUser

<PageTitle>@PageTitleText</PageTitle>

@if (_providerSettings is null)
{
    <PageContainer>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
        </div>
    </PageContainer>
}
else
{
    <SignInGuard AccessChanged="HandleSignInChanged"/>
    <OAuthGuard Provider="@_providerSettings.AuthProvider" AccessChanged="HandlePlexAccessChanged"/>

    <PageContainer Heading="@PageHeading" Description="@PageDescription" Fill="true">
        <HeaderActions>
            <ProtectedSection GuardState="IsSignedIn" ShowFallback="false">
                <div class="flex items-center gap-2">
                    <ProtectedComponent GuardState="IsPlexConnected"
                                        AuthProvider="@_providerSettings.AuthProvider"
                                        DeniedActionDescription="search and add titles">
                        <BbCommand Class="border">
                            <BbCommandItem OnSelect="OpenSearchModal" Value="search" class="search-command-item">
                                <LucideIcon Name="search" Class="mr-2"/>
                                Add from Search
                                <BbKbd Keys="Ctrl+K" Class="search-command-item-shortcut"/>
                            </BbCommandItem>
                        </BbCommand>
                    </ProtectedComponent>
                    @if (_items is { Count: > 0 } && !_isEditMode)
                    {
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Default" @onclick="EnterEditMode" Class="whitespace-nowrap">
                            <LucideIcon Name="square-check" Size="16" Class="mr-2"/>
                            Bulk edit
                        </BbButton>
                    }
                    @if (_removedItems.Count > 0 && !_isEditMode)
                    {
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Default" @onclick="ToggleShowRemoved" Class="whitespace-nowrap">
                            <LucideIcon Name="@(_showRemoved ? "eye-off" : "eye")" Size="16" Class="mr-2"/>
                            @(_showRemoved ? "Hide removed" : "Show removed") (@_removedItems.Count)
                        </BbButton>
                    }
                    <ProtectedComponent GuardState="IsPlexConnected"
                                        AuthProvider="@_providerSettings.AuthProvider"
                                        DeniedActionDescription="sync your watchlist">
                        <WatchlistSyncButton @ref="_syncControl" OnSynced="LoadWatchlistAsync" OnStatusRefresh="LoadOutboxAsync" OnSyncStarted="StartSync" IsSyncing="_syncing" BrandColor="@WatchlistBrandColor" OutboxEntries="_outboxEntries.Values"/>
                    </ProtectedComponent>
                </div>
            </ProtectedSection>
        </HeaderActions>
        <ChildContent>
            <ProtectedSection GuardState="IsSignedIn"
                              DeniedActionDescription="viewing your watchlist"
                              FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
                @if (_isLoading)
                {
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="rounded-lg border bg-destructive/10 border-destructive/30 p-5 flex items-start gap-3">
                        <LucideIcon Name="circle-alert" Size="18" Class="text-destructive shrink-0 mt-0.5"/>
                        <div class="flex-1 space-y-3">
                            <p class="text-sm text-destructive font-medium">@_errorMessage</p>
                            <BbButton Variant="ButtonVariant.Secondary" @onclick="LoadWatchlistAsync">
                                <LucideIcon Name="refresh-cw" Size="14" Class="mr-2"/>
                                Retry
                            </BbButton>
                        </div>
                    </div>
                }
                else if (_items is not null && GridItems.Count == 0)
                {
                    <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-3">
                        <LucideIcon Name="inbox" Size="36" Class="mx-auto text-muted-foreground"/>
                        <h3 class="text-base font-semibold tracking-tight">Your watchlist is empty.</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">Click Sync above to load it
                            from @_providerSettings.WatchlistProvider.GetDescription(), or add a title with <span
                                class="font-medium text-foreground">Ctrl+K</span>.</p>
                    </div>
                }
                else if (_items is not null)
                {
                    <BulkEditableMediaGrid TItem="WatchlistedMedia"
                                           Items="GridItems"
                                           Detail="@(i => i.Media)"
                                           Key="@(i => i.Media.Id)"
                                           IsEditMode="_isEditMode"
                                           IsEditModeChanged="@(v => _isEditMode = v)"
                                           IsDimmed="@(gridItem => _removedIds.Contains(gridItem.Media.Id))"
                                           OnTileClick="SelectItem"
                                           OnBulkRemove="RemoveBulkAsync"
                                           RemoveLabel="Remove from Watchlist">
                        <Overlay Context="item">
                            @if (_removedIds.Contains(item.Media.Id))
                            {
                                <div class="absolute top-2 right-2 z-10">
                                    <PushStatusDot State="PushDotState.Removed" ProviderName="@WatchlistProviderName"/>
                                </div>
                            }
                            else
                            {
                                <div class="absolute top-2 left-2 z-10 flex flex-col gap-1">
                                    <ProvenanceBadge Provenance="item.Provenance" AddedAt="item.AddedAt" ItemId="item.Media.Id"/>
                                </div>
                                @if (PushDotFor(item.Media.Id) is { } dot)
                                {
                                    <div class="absolute top-2 right-2 z-10">
                                        <PushStatusDot State="dot.State" Attempts="dot.Attempts" ProviderName="@WatchlistProviderName"/>
                                    </div>
                                }
                            }
                        </Overlay>
                    </BulkEditableMediaGrid>
                }
            </ProtectedSection>
        </ChildContent>
    </PageContainer>
}

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  Media="_selectedItem?.Media.ToMatch()"
                  OnEnrollmentChanged="ReloadAfterEnrollmentAsync"/>

@if (_providerSettings is not null)
{
    <SearchModal @bind-IsOpen="_isSearchModalOpen"
                 SearchProvider="@_providerSettings.SearchProvider"
                 IsInWatchlist="IsInWatchlist"
                 OnToggle="ToggleFromSearchAsync"
                 ShortcutEnabled="_hasPlexAccess">
        <TileIcons Context="ctx">
            <WatchlistToggleIcon Result="ctx.Result" IsToggled="ctx.IsToggled" IsToggling="ctx.IsToggling" OnToggle="ctx.OnToggle"/>
        </TileIcons>
    </SearchModal>
}

@code {
    private List<WatchlistedMedia>? _items;
    private Dictionary<MediaId, WatchlistOutboxEntry> _outboxEntries = [];
    private List<WatchlistedMedia> _removedItems = [];
    private HashSet<MediaId> _removedIds = [];
    private bool _showRemoved;
    private readonly HashSet<MediaId> _pushed = [];
    private UserId? _userId;
    private bool _syncing;
    private WatchlistedMedia? _selectedItem;
    private bool _isLoading;
    private bool _isSheetOpen;
    private bool _isSignedIn;
    private bool _hasPlexAccess;
    private bool _isSearchModalOpen;
    private bool _isEditMode;
    private string? _errorMessage;
    private WatchlistSyncButton? _syncControl;
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private ProviderConfig? _providerSettings;

    private string PageTitleText => _providerSettings is null ? "Watchlist" : $"{_providerSettings.WatchlistProvider.GetDescription()} Watchlist";
    private string PageHeading => _providerSettings is null ? "Watchlist" : $"{_providerSettings.WatchlistProvider.GetDescription()} Watchlist";
    private string PageDescription => _providerSettings is null ? "Your saved movies and shows." : $"Your saved movies and shows from {_providerSettings.WatchlistProvider.GetDescription()}";
    private string? WatchlistBrandColor => _providerSettings is null ? null : BrandingService.GetBrandingInfo(_providerSettings.WatchlistProvider.AsMediaProvider()).BrandColor;
    private string WatchlistProviderName => _providerSettings is null ? "your watchlist provider" : _providerSettings.WatchlistProvider.GetDescription();
    private bool IsSignedIn() => _isSignedIn;

    private IReadOnlyList<WatchlistedMedia> GridItems =>
        _showRemoved && !_isEditMode && _items is not null
            ? [.. _items.Concat(_removedItems).OrderByDescending(item => item.AddedAt)]
            : _items ?? [];

    private void ToggleShowRemoved() => _showRemoved = !_showRemoved;

    private bool IsPlexConnected() => _hasPlexAccess;

    private void HandlePlexAccessChanged(bool hasAccess)
    {
        _hasPlexAccess = hasAccess;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        OutboxEventFeed.Published += OnOutboxEvent;
        _providerSettings = await ProviderConfigRepository.GetAsync() ?? throw new InvalidOperationException("Provider settings are not configured.");
    }

    private async Task HandleSignInChanged(bool hasAccess)
    {
        _isSignedIn = hasAccess;

        if (!hasAccess)
        {
            _userId = null;
            _items = null;
            _errorMessage = null;
            _isLoading = false;
            _isEditMode = false;
            CloseSelectedMedia();
            return;
        }

        _userId = CurrentUser.Id;
        await LoadWatchlistAsync();
    }

    private async Task LoadWatchlistAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            await LoadOutboxAsync();
            _removedIds = _outboxEntries.Values.Where(entry => entry.Action == WatchlistOperationAction.Remove).Select(entry => entry.MediaId).ToHashSet();

            var all = await WatchlistService.GetWatchlistItemsAsync(WatchlistQueryOptions.WithRemoved, _cancellationTokenSource.Token).ToListAsync(_cancellationTokenSource.Token);
            _items = all.Where(item => !_removedIds.Contains(item.Media.Id)).ToList();
            _removedItems = all.Where(item => _removedIds.Contains(item.Media.Id)).ToList();

            if (_selectedItem is not null)
            {
                _selectedItem = _items.FirstOrDefault(item => item.Media.Id.Equals(_selectedItem.Media.Id));
                if (_selectedItem is null)
                {
                    _isSheetOpen = false;
                }
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load watchlist");
            _errorMessage = $"Failed to load watchlist: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private Task RefreshPendingAsync() => _syncControl?.RefreshAsync() ?? Task.CompletedTask;

    private async Task LoadOutboxAsync()
    {
        _outboxEntries = (await Outbox.GetAsync(_cancellationTokenSource.Token)).ToDictionary(entry => entry.MediaId);
        CompleteIfDrained();
        StateHasChanged();
    }

    private void StartSync()
    {
        _pushed.Clear();
        _syncing = true;
        StateHasChanged();
    }

    private void CompleteIfDrained()
    {
        if (!_syncing || _outboxEntries.Values.Any(entry => entry.Status == WatchlistOutboxState.Pending))
        {
            return;
        }

        _syncing = false;
        _ = RefreshPendingAsync();
        var pushed = _pushed.Count;
        var failed = _outboxEntries.Values.Count(entry => entry.Status == WatchlistOutboxState.Failed);

        if (pushed == 0 && failed == 0)
        {
            _pushed.Clear();
            return;
        }
        if (failed > 0)
        {
            Notifier.Warning($"Synced {pushed} to {WatchlistProviderName} — {failed} failed.");
        }

        _ = ClearPushedAfterDelayAsync();
    }

    private async Task ClearPushedAfterDelayAsync()
    {
        try
        {
            await Task.Delay(1000, _cancellationTokenSource.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        _pushed.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private (PushDotState State, int Attempts)? PushDotFor(MediaId mediaId)
    {
        if (_pushed.Contains(mediaId))
        {
            return (PushDotState.Pushed, 0);
        }
        if (_outboxEntries.TryGetValue(mediaId, out var entry))
        {
            var state = entry.Status == WatchlistOutboxState.Failed ? PushDotState.Failed : PushDotState.Pending;
            return (state, entry.Attempts);
        }
        return null;
    }

    private void OnOutboxEvent(WatchlistOutboxEvent outboxEvent)
    {
        if (_userId is not { } current || outboxEvent.UserId != current)
        {
            return;
        }
        _ = InvokeAsync(() => ApplyOutboxEvent(outboxEvent));
    }

    private void ApplyOutboxEvent(WatchlistOutboxEvent outboxEvent)
    {
        switch (outboxEvent.Kind)
        {
            case WatchlistOutboxEventKind.Pushed:
                _outboxEntries.Remove(outboxEvent.MediaId);
                if (_removedIds.Remove(outboxEvent.MediaId))
                {
                    _removedItems.RemoveAll(item => item.Media.Id == outboxEvent.MediaId);
                }
                if (_syncing)
                {
                    _pushed.Add(outboxEvent.MediaId);
                }
                break;
            case WatchlistOutboxEventKind.Abandoned:
                if (_outboxEntries.TryGetValue(outboxEvent.MediaId, out var failedRow))
                {
                    _outboxEntries[outboxEvent.MediaId] = failedRow with { Status = WatchlistOutboxState.Failed };
                }
                break;
            case WatchlistOutboxEventKind.Retrying:
                if (_outboxEntries.TryGetValue(outboxEvent.MediaId, out var retryRow))
                {
                    _outboxEntries[outboxEvent.MediaId] = retryRow with { Attempts = retryRow.Attempts + 1 };
                }
                break;
        }
        CompleteIfDrained();
        StateHasChanged();
    }

    private void SelectItem(WatchlistedMedia item)
    {
        _selectedItem = item;
        _isSheetOpen = true;
    }

    private async Task ReloadAfterEnrollmentAsync(MediaListKind changed)
    {
        await LoadWatchlistAsync();
        if (changed is MediaListKind.Watchlist)
        {
            await RefreshPendingAsync();
        }
    }

    private void EnterEditMode()
    {
        _isEditMode = true;
        CloseSelectedMedia();
    }

    private async Task RemoveBulkAsync(IReadOnlyList<WatchlistedMedia> toRemove)
    {
        await WatchlistService.RemoveFromWatchlistAsync(toRemove.Select(item => item.Media.Id), _cancellationTokenSource.Token);
        Notifier.Success($"Removed {toRemove.Count} item{(toRemove.Count == 1 ? "" : "s")} from your watchlist.");
        await LoadWatchlistAsync();
        await RefreshPendingAsync();
    }

    private void CloseSelectedMedia()
    {
        _isSheetOpen = false;
        _selectedItem = null;
    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }

    private void OpenSearchModal()
    {
        _isSearchModalOpen = true;
    }

    private bool IsInWatchlist(MediaId mediaId)
    {
        if (_items is null)
        {
            return false;
        }
        return _items.Any(i => i.Media.Id == mediaId);
    }

    private async Task<bool> ToggleFromSearchAsync(MediaId id, string title, bool isMarked)
    {
        if (isMarked)
        {
            if (!IsInWatchlist(id))
            {
                Notifier.Warning($"'{title}' is not in your watchlist.");
                return false;
            }
            await WatchlistService.RemoveFromWatchlistAsync([id], _cancellationTokenSource.Token);
            await LoadWatchlistAsync();
            await RefreshPendingAsync();
            Notifier.Success($"'{title}' has been removed from your watchlist.");
            return true;
        }

        if (IsInWatchlist(id))
        {
            Notifier.Warning($"'{title}' is already in your watchlist.");
            return false;
        }
        await WatchlistService.AddToWatchlistAsync([id], new ManualOrigin(ManualSource.Search), _cancellationTokenSource.Token);
        await LoadWatchlistAsync();
        await RefreshPendingAsync();
        Notifier.Success($"'{title}' has been added to your watchlist.");
        return true;
    }

    public void Dispose()
    {
        OutboxEventFeed.Published -= OnOutboxEvent;
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
