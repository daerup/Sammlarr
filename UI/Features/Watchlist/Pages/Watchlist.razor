@page "/watchlist"
@using Contracts
@using Contracts.Auth
@using Contracts.Media
@using Contracts.Media.Search
@using Contracts.Settings
@using Contracts.Watchlist
@using global::Shared
@using UI.Features.Watchlist.Components
@using UI.Shared.Services.Branding
@implements IDisposable
@inject IWatchlistService WatchlistService
@inject ProfileDropdownService ProfileDropdownService
@inject IProviderConfigRepository ProviderConfigRepository
@inject MediaProviderBrandingService BrandingService
@inject Notifier Notifier

<PageTitle>@PageTitleText</PageTitle>

@if (_providerSettings is null)
{
    <PageContainer>
        <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
        </div>
    </PageContainer>
}
else
{
    <OauthGuard Provider="@_providerSettings.WatchlistProvider"
                AccessChanged="HandleAccessChanged"/>

    <PageContainer Heading="@PageHeading" Description="@PageDescription">
        <HeaderActions>
            <ProtectedSection GuardState="IsOAuthAllowed" ShowFallback="false">
                <div class="flex items-center gap-2">
                    <BbCommand Class="border">
                        <BbCommandItem OnSelect="OpenSearchModal" Value="search" class="search-command-item">
                            <LucideIcon Name="search" Class="mr-2"/>
                            Add from Search
                            <BbKbd Keys="Ctrl+K" Class="search-command-item-shortcut"/>
                        </BbCommandItem>
                    </BbCommand>
                    @if (_items is { Count: > 0 } && !_isEditMode)
                    {
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Default" @onclick="EnterEditMode" Class="whitespace-nowrap">
                            <LucideIcon Name="square-check" Size="16" Class="mr-2"/>
                            Bulk edit
                        </BbButton>
                    }
                    <WatchlistSyncButton @ref="_syncControl" OnSynced="LoadWatchlistAsync" BrandColor="@WatchlistBrandColor"/>
                </div>
            </ProtectedSection>
        </HeaderActions>
        <ChildContent>
            <ProtectedSection GuardState="IsOAuthAllowed"
                              AuthProvider="@_providerSettings.WatchlistProvider"
                              DeniedActionDescription="viewing your watchlist"
                              FallbackAction="() => ProfileDropdownService.RequestOpenAsync()">
                @if (_isLoading)
                {
                    <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
                        <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="rounded-lg border bg-destructive/10 border-destructive/30 p-5 flex items-start gap-3">
                        <LucideIcon Name="circle-alert" Size="18" Class="text-destructive shrink-0 mt-0.5"/>
                        <div class="flex-1 space-y-3">
                            <p class="text-sm text-destructive font-medium">@_errorMessage</p>
                            <BbButton Variant="ButtonVariant.Secondary" @onclick="LoadWatchlistAsync">
                                <LucideIcon Name="refresh-cw" Size="14" Class="mr-2"/>
                                Retry
                            </BbButton>
                        </div>
                    </div>
                }
                else if (_items is not null && _items.Count == 0)
                {
                    <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-3">
                        <LucideIcon Name="inbox" Size="36" Class="mx-auto text-muted-foreground"/>
                        <h3 class="text-base font-semibold tracking-tight">Your watchlist is empty.</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">Click Sync to load it
                            from @_providerSettings.WatchlistProvider.GetDescription(), or add a title with <span
                                class="font-medium text-foreground">Ctrl+K</span>.</p>
                        <div class="flex justify-center">
                            <WatchlistSyncButton OnSynced="LoadWatchlistAsync" BrandColor="@WatchlistBrandColor"/>
                        </div>
                    </div>
                }
                else if (_items is not null)
                {
                    <BulkEditableMediaGrid TItem="WatchlistItem"
                                           Items="_items"
                                           Detail="@(i => i.Media)"
                                           Key="@(i => i.Media.Id)"
                                           IsEditMode="_isEditMode"
                                           IsEditModeChanged="@(v => _isEditMode = v)"
                                           OnTileClick="SelectItem"
                                           OnBulkRemove="RemoveBulkAsync"
                                           RemoveLabel="Remove from Watchlist">
                        <Overlay Context="item">
                            <div class="absolute top-2 left-2 z-10 flex flex-col gap-1 wl-badge-host">
                                <BbBadge Variant="@ProvenanceBadgeVariant(item.Provenance)" Class="wl-badge">
                                    <BbTooltip>
                                        <BbTooltipTrigger AsChild="false" Class="p-0">
                                            <span class="flex items-center gap-1 wl-badge-content">
                                                <LucideIcon Name="@ProvenanceIcon(item.Provenance)" Size="12"/>
                                                <span class="wl-badge-label">@ProvenanceLabel(item.Provenance)</span>
                                            </span>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>@ProvenanceTooltip(item)</BbTooltipContent>
                                    </BbTooltip>
                                </BbBadge>
                            </div>
                        </Overlay>
                    </BulkEditableMediaGrid>
                }
            </ProtectedSection>
        </ChildContent>
    </PageContainer>
}

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  Media="_selectedItem?.Media.ToMatch()"
                  ShowMetadataRow="false"
                  ButtonAction="RemoveSelectedFromWatchlistAsync"
                  ButtonText="GetRemoveButtonText"
                  ButtonIcon="GetRemoveButtonIcon"/>

@if (_providerSettings is not null)
{
    <SearchModal @bind-IsOpen="_isSearchModalOpen"
                 SearchProvider="@_providerSettings.SearchProvider"
                 IsInWatchlist="IsInWatchlist"
                 OnToggle="ToggleFromSearchAsync"
                 ShortcutEnabled="_hasOAuthAccess">
        <TileIcons Context="ctx">
            <WatchlistToggleIcon Result="ctx.Result" IsToggled="ctx.IsToggled" IsToggling="ctx.IsToggling" OnToggle="ctx.OnToggle"/>
        </TileIcons>
    </SearchModal>
}

@code {
    private List<WatchlistItem>? _items;
    private WatchlistItem? _selectedItem;
    private bool _isLoading;
    private bool _isRemoving;
    private bool _isSheetOpen;
    private bool _hasOAuthAccess;
    private bool _isSearchModalOpen;
    private bool _isEditMode;
    private string? _errorMessage;
    private WatchlistSyncButton? _syncControl;
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private ProviderConfig? _providerSettings;

    private string PageTitleText => _providerSettings is null ? "Watchlist" : $"{_providerSettings.WatchlistProvider.GetDescription()} Watchlist";
    private string PageHeading => _providerSettings is null ? "Watchlist" : $"{_providerSettings.WatchlistProvider.GetDescription()} Watchlist";
    private string PageDescription => _providerSettings is null ? "Your saved movies and shows." : $"Your saved movies and shows from {_providerSettings.WatchlistProvider.GetDescription()}";
    private string? WatchlistBrandColor => _providerSettings is null ? null : BrandingService.GetBrandingInfo(_providerSettings.WatchlistProvider.AsMediaProvider()).BrandColor;
    private bool IsOAuthAllowed() => _hasOAuthAccess;

    protected override async Task OnInitializedAsync()
    {
        _providerSettings = await ProviderConfigRepository.GetAsync() ?? throw new InvalidOperationException("Provider settings are not configured.");
    }

    private async Task HandleAccessChanged(bool hasAccess)
    {
        _hasOAuthAccess = hasAccess;

        if (!hasAccess)
        {
            _items = null;
            _errorMessage = null;
            _isLoading = false;
            _isEditMode = false;
            CloseSelectedMedia();
            return;
        }

        await LoadWatchlistAsync();
    }

    private async Task LoadWatchlistAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _items = await WatchlistService.GetWatchlistItemsAsync(_cancellationTokenSource.Token).ToListAsync(_cancellationTokenSource.Token);

            if (_selectedItem is not null)
            {
                _selectedItem = _items.FirstOrDefault(item => item.Media.Id.Equals(_selectedItem.Media.Id));
                if (_selectedItem is null)
                {
                    _isSheetOpen = false;
                }
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load watchlist");
            _errorMessage = $"Failed to load watchlist: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private Task RefreshPendingAsync() => _syncControl?.RefreshAsync() ?? Task.CompletedTask;

    private static string GetRemoveButtonText() => "Remove from Watchlist";

    private static string GetRemoveButtonIcon() => "x";

    private void SelectItem(WatchlistItem item)
    {
        _selectedItem = item;
        _isSheetOpen = true;
    }

    private async Task RemoveSelectedFromWatchlistAsync()
    {
        if (_isRemoving || _selectedItem is null)
        {
            return;
        }

        _isRemoving = true;
        try
        {
            await WatchlistService.RemoveFromWatchlistAsync([_selectedItem.Media.Id], _cancellationTokenSource.Token);
            CloseSelectedMedia();
            await LoadWatchlistAsync();
            await RefreshPendingAsync();
        }
        finally
        {
            _isRemoving = false;
        }
    }

    private void EnterEditMode()
    {
        _isEditMode = true;
        CloseSelectedMedia();
    }

    private async Task RemoveBulkAsync(IReadOnlyList<WatchlistItem> toRemove)
    {
        await WatchlistService.RemoveFromWatchlistAsync(toRemove.Select(item => item.Media.Id), _cancellationTokenSource.Token);
        Notifier.Success($"Removed {toRemove.Count} item{(toRemove.Count == 1 ? "" : "s")} from your watchlist.");
        await LoadWatchlistAsync();
        await RefreshPendingAsync();
    }

    private void CloseSelectedMedia()
    {
        _isSheetOpen = false;
        _selectedItem = null;
    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }

    private void OpenSearchModal()
    {
        _isSearchModalOpen = true;
    }

    private bool IsInWatchlist(MediaId mediaId)
    {
        if (_items is null)
        {
            return false;
        }
        return _items.Any(i => i.Media.Id == mediaId);
    }

    private async Task<bool> ToggleFromSearchAsync(MediaId id, string title, bool isMarked)
    {
        if (isMarked)
        {
            if (!IsInWatchlist(id))
            {
                Notifier.Warning($"'{title}' is not in your watchlist.");
                return false;
            }
            await WatchlistService.RemoveFromWatchlistAsync([id], _cancellationTokenSource.Token);
            await LoadWatchlistAsync();
            await RefreshPendingAsync();
            Notifier.Success($"'{title}' has been removed from your watchlist.");
            return true;
        }

        if (IsInWatchlist(id))
        {
            Notifier.Warning($"'{title}' is already in your watchlist.");
            return false;
        }
        await WatchlistService.AddToWatchlistAsync([id], new ManualOrigin(), _cancellationTokenSource.Token);
        await LoadWatchlistAsync();
        await RefreshPendingAsync();
        Notifier.Success($"'{title}' has been added to your watchlist.");
        return true;
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    private static BadgeVariant ProvenanceBadgeVariant(WatchlistItemProvenance provenance) =>
        provenance.Value switch
        {
            RemoteOrigin => BadgeVariant.Secondary,
            ManualOrigin => BadgeVariant.Default,
            FeedOrigin => BadgeVariant.Default,
            OrphanedOrigin => BadgeVariant.Outline,
            _ => BadgeVariant.Secondary,
        };

    private static string ProvenanceIcon(WatchlistItemProvenance provenance) =>
        provenance.Value switch
        {
            RemoteOrigin => "cloud",
            ManualOrigin => "user",
            FeedOrigin => "rss",
            OrphanedOrigin => "unlink",
            _ => "circle",
        };

    private static string ProvenanceLabel(WatchlistItemProvenance provenance) =>
        provenance.Value switch
        {
            RemoteOrigin => "From Plex",
            ManualOrigin => "Manual",
            FeedOrigin feed => feed.FeedName,
            OrphanedOrigin orphaned => $"{orphaned.FormerFeedName} (deleted)",
            _ => string.Empty,
        };

    private static string ProvenanceTooltip(WatchlistItem item)
    {
        var date = item.AddedAt.LocalDateTime.ToString("MMM d, yyyy");
        return item.Provenance.Value switch
        {
            RemoteOrigin => "From Plex",
            ManualOrigin => $"Added manually on {date}",
            FeedOrigin feed => $"Added by feed '{feed.FeedName}' on {date}",
            OrphanedOrigin orphaned => $"Was from '{orphaned.FormerFeedName}' (deleted)",
            _ => string.Empty,
        };
    }
}
