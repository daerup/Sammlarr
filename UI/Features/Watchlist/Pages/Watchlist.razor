@page "/watchlist"
@inherits MediaListPage
@using Contracts.Identity
@using Contracts.Announcing
@using Contracts.Blacklist
@using Contracts.Watchlist
@using Contracts.Watchlist.Outbox
@using Domain.Announcing
@using Domain.Identity
@using Domain.Feed
@using Domain.Feed.Run
@using global::Shared
@using UI.Features.Watchlist.Components
@using UI.Shared.Announcing
@using UI.Shared.Filters
@using UI.Shared.Services.Branding
@inject IWatchlistService WatchlistService
@inject IWatchlistOutbox Outbox
@inject IBlacklistService BlacklistService
@inject MediaProviderBrandingService BrandingService
@inject IEventPublisher Events
@inject ICurrentUser CurrentUser

<PageTitle>@PageHeading</PageTitle>

@{
    var allItems = AllItems;
    var gridItems = Visible(allItems);
    var sources = SourcesFrom(allItems);
    var pageItems = Paged(gridItems);
}

<MediaListShell Settings="Settings"
                Heading="@PageHeading"
                Description="@PageDescription"
                IsSignedIn="IsSignedIn"
                IsConnected="IsConnected"
                DeniedActionDescription="viewing your watchlist"
                OnSignInChanged="HandleSignInChanged"
                OnAccessChanged="HandleAccessChanged"
                Search="@Filter.Search"
                SearchChanged="ApplySearchAsync">
    <HeaderExtras>
        <MediaListViewActions HasItems="@(_items is { Count: > 0 } || _removedItems.Count > 0)"
                              IsEditMode="IsEditMode"
                              ShowFilters="ShowFilters"
                              ActiveFilters="Filter.ActiveCount"
                              OnEnterEditMode="EnterEditMode"
                              OnToggleFilters="ToggleFilterBar"/>
        <ProtectedComponent GuardState="IsConnected"
                            AuthProvider="@Settings!.AuthProvider"
                            DeniedActionDescription="sync your watchlist">
            <WatchlistSyncButton @ref="_syncControl" OnSynced="LoadAsync" OnStatusRefresh="LoadOutboxAsync" OnSyncStarted="StartSync" IsSyncing="_syncing" BrandColor="@WatchlistBrandColor" ProviderName="@WatchlistProviderName" OutboxEntries="_outboxEntries.Values"/>
        </ProtectedComponent>
    </HeaderExtras>
    <ChildContent>
        <MediaListBody IsLoading="IsLoadingList"
                       ErrorMessage="@ErrorMessage"
                       OnRetry="LoadAsync"
                       TotalCount="@(_items is null ? null : allItems.Count)"
                       VisibleCount="gridItems.Count"
                       ShowFilters="ShowFilters"
                       Filter="Filter"
                       FilterChanged="ApplyFilterAsync"
                       Sources="sources"
                       Statuses="StatusOptions"
                       CurrentPage="@PageWithin(gridItems.Count)"
                       PageCount="@PageCount(gridItems.Count)"
                       PageChanged="GoToPageAsync">
            <EmptyState>
                <MediaListEmptyState Icon="inbox" Heading="Your watchlist is empty.">
                    Click Sync above to load it from @WatchlistProviderName, or add a title with <span class="font-medium text-foreground">Ctrl+K</span>.
                </MediaListEmptyState>
            </EmptyState>
            <Grid>
                <BulkEditableMediaGrid TItem="WatchlistedMedia"
                                       Items="pageItems"
                                       AllItems="gridItems"
                                       Detail="@(i => i.Media)"
                                       Key="@(i => i.Media.Id)"
                                       IsEditMode="IsEditMode"
                                       IsEditModeChanged="SetEditMode"
                                       IsDimmed="@(gridItem => _removedIds.Contains(gridItem.Media.Id))"
                                       OnTileClick="SelectItem"
                                       OnBulkRemove="RemoveBulkAsync"
                                       RemoveLabel="Remove"
                                       MarkLabel="Blacklist"
                                       MarkIcon="shield-ban"
                                       OnBulkMark="BlacklistBulkAsync"
                                       RemoveConfirm="RemoveConfirm"
                                       MarkConfirm="BlacklistConfirm"
                                       IsMarked="@(item => _blacklistedIds.Contains(item.Media.Id))"
                                       AlreadyMarkedHint="Every selected title is already blacklisted."
                                       IsRemoved="@(item => _removedIds.Contains(item.Media.Id))"
                                       AlreadyRemovedHint="Every selected title is already pending removal.">
                    <Overlay Context="item">
                        @if (_removedIds.Contains(item.Media.Id))
                        {
                            <div class="absolute top-2 right-2 z-10">
                                <PushStatusDot State="PushDotState.Removed" ProviderName="@WatchlistProviderName"/>
                            </div>
                        }
                        else
                        {
                            <div class="absolute top-2 left-2 z-10 flex flex-col gap-1">
                                <ProvenanceBadge Provenance="item.Provenance" AddedAt="item.AddedAt" ItemId="item.Media.Id"/>
                            </div>
                            @if (PushDotFor(item.Media.Id) is { } dot)
                            {
                                <div class="absolute top-2 right-2 z-10">
                                    <PushStatusDot State="dot.State" Attempts="dot.Attempts" ProviderName="@WatchlistProviderName"/>
                                </div>
                            }
                        }
                    </Overlay>
                </BulkEditableMediaGrid>
            </Grid>
        </MediaListBody>
    </ChildContent>
</MediaListShell>

<MediaDetailSheet Open="IsSheetOpen"
                  OnOpenChanged="SheetOpenChangedAsync"
                  Media="_selectedItem?.Media.ToMatch()"
                  OnEnrollmentChanged="ReloadAfterEnrollmentAsync"/>

@code {
    private static readonly TimeSpan RenderCoalesceWindow = TimeSpan.FromMilliseconds(120);
    private bool _renderQueued;
    private List<WatchlistedMedia>? _items;
    private Dictionary<MediaId, WatchlistOutboxEntry> _outboxEntries = [];
    private List<WatchlistedMedia> _removedItems = [];
    private HashSet<MediaId> _removedIds = [];
    private readonly HashSet<MediaId> _pushed = [];
    private IReadOnlySet<MediaId> _blacklistedIds = new HashSet<MediaId>();
    private UserId? _userId;
    private bool _syncing;
    private WatchlistedMedia? _selectedItem;
    private WatchlistSyncButton? _syncControl;

    [Parameter]
    [SupplyParameterFromQuery(Name = "feed")]
    public string? FeedParam { get; set; }

    private string PageHeading => Settings is null ? "Watchlist" : $"{Settings.WatchlistProvider.GetDescription()} Watchlist";

    private string PageDescription =>
        Settings is null ? "Your saved movies and shows." : $"Your saved movies and shows from {Settings.WatchlistProvider.GetDescription()}";

    private string? WatchlistBrandColor => Settings is null ? null : BrandingService.GetBrandingInfo(Settings.WatchlistProvider.AsMediaProvider()).BrandColor;

    private string WatchlistProviderName => Settings is null ? "your watchlist provider" : Settings.WatchlistProvider.GetDescription();

    private IReadOnlyList<StatusOption> StatusOptions => WatchlistStatusView.Options(_removedItems.Count);

    private IReadOnlyList<WatchlistedMedia> AllItems =>
        _items is null ? [] : WatchlistStatusView.Within(Filter, _items, _removedItems);

    private IReadOnlyList<WatchlistedMedia> Visible(IReadOnlyList<WatchlistedMedia> all) =>
        [
            .. Filter.SortBy(
                all.Where(item =>
                    Filter.MatchesSource(item.Provenance) && Filter.MatchesType(item.Media.ToMatch().MediaType) && Filter.MatchesSearch(item.Media.Title)
                ),
                item => item.Media,
                item => item.AddedAt
            ),
        ];

    private static IReadOnlyList<SourceOption> SourcesFrom(IReadOnlyList<WatchlistedMedia> all) =>
        [
            .. all.Select(item => item.Provenance)
                .Select(SourceOptionFor)
                .Where(option => option is not null)
                .Select(option => option!)
                .DistinctBy(option => option.Key)
                .OrderBy(option => option.Label),
        ];

    private static SourceOption? SourceOptionFor(WatchlistItemProvenance provenance) =>
        provenance.Value switch
        {
            FeedOrigin feed => new SourceOption(UrlGuid.Encode(feed.Feed.Id.Value), feed.Feed.Name, new SourceChoice(SourceKind.Feed, feed.Feed.Id)),
            ManualOrigin => new SourceOption("manual", "Added by hand", new SourceChoice(SourceKind.Manual)),
            RemoteOrigin => new SourceOption("remote", "Remote watchlist", new SourceChoice(SourceKind.Remote)),
            OrphanedOrigin => new SourceOption("orphaned", "Feed deleted", new SourceChoice(SourceKind.Orphaned)),
            _ => null,
        };

    private void ApplyFeedFromQuery()
    {
        if (FeedParam is null || _items is null)
        {
            return;
        }

        var wanted = new SourceChoice(SourceKind.Feed, FeedId.From(UrlGuid.Decode(FeedParam)));
        if (SourcesFrom(AllItems).Any(option => option.Choice == wanted))
        {
            Filter = Filter with { Sources = [wanted] };
            ShowFilters = true;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        Events.Published += OnEvent;
        Filter = Filter with { Statuses = [WatchlistStatusView.Active] };
        await base.OnInitializedAsync();
    }

    protected override void ClearItems()
    {
        _items = null;
        _userId = null;
    }

    protected override void ClearSelection() => _selectedItem = null;

    protected override async Task LoadAsync()
    {
        _userId ??= CurrentUser.Id;
        IsLoadingList = true;
        StateHasChanged();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        ErrorMessage = null;

        try
        {
            await LoadOutboxAsync();
            _removedIds = _outboxEntries.Values.Where(entry => entry.Action == WatchlistOperationAction.Remove).Select(entry => entry.MediaId).ToHashSet();

            _blacklistedIds = await BlacklistService.GetBlacklistIdsAsync(Cancellation.Token);

            var all = await WatchlistService.GetWatchlistItemsAsync(WatchlistQueryOptions.WithRemoved, Cancellation.Token).ToListAsync(Cancellation.Token);
            _items = all.Where(item => !_removedIds.Contains(item.Media.Id)).ToList();
            _removedItems = all.Where(item => _removedIds.Contains(item.Media.Id)).ToList();
            Filter = Filter with { Statuses = WatchlistStatusView.Adjusted(Filter.Statuses, _items.Count, _removedItems.Count) };
            ApplyFeedFromQuery();

            if (_selectedItem is not null)
            {
                _selectedItem = _items.FirstOrDefault(item => item.Media.Id.Equals(_selectedItem.Media.Id));
                if (_selectedItem is null)
                {
                    IsSheetOpen = false;
                }
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load watchlist");
            ErrorMessage = $"Failed to load watchlist: {ex.Message}";
        }
        finally
        {
            IsLoadingList = false;
            StateHasChanged();
        }
    }

    private Task RefreshPendingAsync() => _syncControl?.RefreshAsync() ?? Task.CompletedTask;

    private async Task LoadOutboxAsync()
    {
        _outboxEntries = (await Outbox.GetAsync(Cancellation.Token)).ToDictionary(entry => entry.MediaId);
        CompleteIfDrained();
        StateHasChanged();
    }

    private void StartSync()
    {
        _pushed.Clear();
        _syncing = true;
        StateHasChanged();
    }

    private void CompleteIfDrained()
    {
        if (!_syncing || _outboxEntries.Values.Any(entry => entry.Status == WatchlistOutboxState.Pending))
        {
            return;
        }

        _syncing = false;
        _ = RefreshPendingAsync();
        var pushed = _pushed.Count;
        var failed = _outboxEntries.Values.Count(entry => entry.Status == WatchlistOutboxState.Failed);

        if (pushed == 0 && failed == 0)
        {
            _pushed.Clear();
            return;
        }
        if (failed > 0)
        {
            Notifier.Warning($"Synced {pushed} to {WatchlistProviderName} — {failed} failed.");
        }

        _ = ClearPushedAfterDelayAsync();
    }

    private async Task ClearPushedAfterDelayAsync()
    {
        try
        {
            await Task.Delay(1000, Cancellation.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        _pushed.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private (PushDotState State, int Attempts)? PushDotFor(MediaId mediaId)
    {
        if (_pushed.Contains(mediaId))
        {
            return (PushDotState.Pushed, 0);
        }
        if (_outboxEntries.TryGetValue(mediaId, out var entry))
        {
            var state = entry.Status == WatchlistOutboxState.Failed ? PushDotState.Failed : PushDotState.Pending;
            return (state, entry.Attempts);
        }
        return null;
    }

    private void OnEvent(IEvent raised)
    {
        if (ViewerEvent.Own<FeedRunFinishedEvent>(raised, _userId) is not null)
        {
            _ = InvokeAsync(ReloadAsync);
            return;
        }

        if (ViewerEvent.Own<WatchlistOutboxEvent>(raised, _userId) is not { } outboxEvent)
        {
            return;
        }
        _ = InvokeAsync(() => ApplyOutboxEvent(outboxEvent));
    }

    private void ApplyOutboxEvent(WatchlistOutboxEvent outboxEvent)
    {
        switch (outboxEvent.Kind)
        {
            case WatchlistOutboxEventKind.Pushed:
                _outboxEntries.Remove(outboxEvent.MediaId);
                if (_removedIds.Remove(outboxEvent.MediaId))
                {
                    _removedItems.RemoveAll(item => item.Media.Id == outboxEvent.MediaId);
                }
                if (_syncing)
                {
                    _pushed.Add(outboxEvent.MediaId);
                }
                break;
            case WatchlistOutboxEventKind.Abandoned:
                if (_outboxEntries.TryGetValue(outboxEvent.MediaId, out var failedRow))
                {
                    _outboxEntries[outboxEvent.MediaId] = failedRow with { Status = WatchlistOutboxState.Failed };
                }
                break;
            case WatchlistOutboxEventKind.Retrying:
                if (_outboxEntries.TryGetValue(outboxEvent.MediaId, out var retryRow))
                {
                    _outboxEntries[outboxEvent.MediaId] = retryRow with { Attempts = retryRow.Attempts + 1 };
                }
                break;
        }
        CompleteIfDrained();
        QueueRender();
    }

    private void QueueRender()
    {
        if (_renderQueued)
        {
            return;
        }

        _renderQueued = true;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(RenderCoalesceWindow, Cancellation.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            _renderQueued = false;
            StateHasChanged();
        });
    }

    private void SelectItem(WatchlistedMedia item)
    {
        _selectedItem = item;
        IsSheetOpen = true;
    }

    private async Task ReloadAfterEnrollmentAsync(MediaListKind changed)
    {
        await LoadAsync();
        if (changed is MediaListKind.Watchlist)
        {
            await RefreshPendingAsync();
        }
    }

    private async Task RemoveBulkAsync(IReadOnlyList<WatchlistedMedia> toRemove)
    {
        await WatchlistService.RemoveFromWatchlistAsync(toRemove.Select(item => item.Media.Id), Cancellation.Token);
        Notifier.Success($"Removed {toRemove.Count} item{(toRemove.Count == 1 ? "" : "s")} from your watchlist.");
        await LoadAsync();
        await RefreshPendingAsync();
    }

    private async Task BlacklistBulkAsync(IReadOnlyList<WatchlistedMedia> toMark)
    {
        foreach (var item in toMark)
        {
            await BlacklistService.AddToBacklistAsync(item.Media.Id, Cancellation.Token);
        }
        Notifier.Success($"Blacklisted {toMark.Count} title{(toMark.Count == 1 ? "" : "s")}.");
    }

    private static BulkConfirm RemoveConfirm(int count) =>
        new(
            $"Remove {Titles(count)} from your watchlist?",
            "They are not blacklisted, so a later feed run can add them back."
        );

    private static BulkConfirm BlacklistConfirm(int count) =>
        new($"Blacklist {Titles(count)}?", "Future feed runs will skip them. They stay on your watchlist.");

    private static string Titles(int count) => count == 1 ? "1 title" : $"{count} titles";

    public override void Dispose()
    {
        Events.Published -= OnEvent;
        base.Dispose();
    }
}
