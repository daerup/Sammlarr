@using Contracts.Identity
@using Contracts.Media
@using Contracts.Watchlist.Sync
@implements IDisposable
@inject IMediaService Media
@inject IWatchlistSyncEngine SyncEngine
@inject ICurrentUser CurrentUser
@inject Notifier Notifier

@if (_isSyncing || IsSyncing)
{
    <HoverButton Disabled="true" Color="@BrandColor" Class="whitespace-nowrap">
        <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
        <span>Syncing...</span>
    </HoverButton>
}
else
{
    <BbHoverCard OpenDelay="200" CloseDelay="100" OnOpenChange="OnHoverChanged">
        <BbHoverCardTrigger AsChild="false">
            <HoverButton OnClick="SyncAsync" Color="@BrandColor" Class="relative whitespace-nowrap">
                <LucideIcon Name="refresh-cw" Size="16" Class="mr-2"/>
                <span>Sync</span>
                <span class="ml-2 inline-flex items-center justify-center h-5" style="min-width: 1.5rem">
                    @if (_isLoadingDryRun)
                    {
                        <BbSpinner Size="SpinnerSize.Small"/>
                    }
                    else if (_dryRun is { TotalChanges: > 0 } report)
                    {
                        <BbBadge Variant="BadgeVariant.Outline"
                                 Class="hover-button-badge min-w-5 h-5 px-1.5 rounded-full text-[10px] font-semibold">
                            @report.TotalChanges
                        </BbBadge>
                    }
                    else if (_dryRun is not null)
                    {
                        <LucideIcon Name="check" Size="14"/>
                    }
                    else if (_dryRunError is not null)
                    {
                        <LucideIcon Name="cloud-off" Size="14"/>
                    }
                </span>
            </HoverButton>
        </BbHoverCardTrigger>
        <BbHoverCardContent Side="PopoverSide.Bottom" Align="PopoverAlign.End" Class="p-0 watchlist-sync-preview">
            @if (OutboxEntries.Count > 0)
            {
                <div class="px-4 py-2 flex items-center gap-2 text-sm @(HasFailedEntries ? "text-destructive" : "text-muted-foreground")" style="border-bottom: 1px solid var(--border);">
                    <LucideIcon Name="send" Size="14"/>
                    <span>@OutboxSummary</span>
                </div>
            }
            <div class="px-4 py-3" style="@PreviewHeaderStyle">
                <p class="text-xs uppercase tracking-wide font-medium text-muted-foreground">Sync preview</p>
                @if (_dryRunError is not null)
                {
                    <div class="flex items-center gap-2 text-sm text-destructive mt-1.5">
                        <LucideIcon Name="cloud-off" Size="14"/>
                        <span class="truncate">@_dryRunError</span>
                    </div>
                }
                else if (_dryRun is null)
                {
                    <div class="flex items-center gap-2 text-sm text-muted-foreground mt-1.5">
                        <BbSpinner Size="SpinnerSize.Small"/>
                        <span>Computing…</span>
                    </div>
                }
                else
                {
                    <div class="flex items-baseline gap-3 mt-1.5">
                        <span class="text-sm font-semibold text-success tabular-nums">+@_dryRun.AddCount</span>
                        <span class="text-sm font-semibold text-destructive tabular-nums">−@_dryRun.RemoveCount</span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-1.5">@_dryRun.NoOps.Count already in sync</p>
                }
            </div>
            @if (_dryRun is not null && _dryRun.TotalChanges > 0)
            {
                var window = _dryRun.Changes.Take(DryRunPreviewLimit).ToList();
                <div class="max-h-64 overflow-y-auto scrollbar-thin py-2">
                    @foreach (var change in window)
                    {
                        var directionIcon = change.Direction == WatchlistSyncDirection.Pull ? "arrow-down-left" : "arrow-up-right";
                        var directionTooltip = change.Direction == WatchlistSyncDirection.Pull ? "from Plex" : "to Plex";
                        var kindIcon = change.Action == WatchlistOperationAction.Add ? "plus" : "minus";
                        var kindColor = change.Action == WatchlistOperationAction.Add ? "text-success" : "text-destructive";
                        var title = _metadata.TryGetValue(change.MediaId, out var detail) ? detail.Title : "…";
                        <div class="flex items-center gap-2 px-4 py-1.5 text-sm">
                            <span class="inline-flex h-5 items-center shrink-0 @kindColor">
                                <LucideIcon Name="@kindIcon" Size="14"/>
                            </span>
                            <span class="flex-1" style="white-space: nowrap; padding-right: 1rem;" title="@title">@title</span>
                            <span title="@directionTooltip" class="inline-flex h-5 items-center shrink-0 text-muted-foreground">
                                <LucideIcon Name="@directionIcon" Size="14"/>
                            </span>
                        </div>
                    }
                </div>
                @if (_dryRun.TotalChanges > window.Count)
                {
                    var hidden = _dryRun.TotalChanges - window.Count;
                    <div class="px-4 py-2 border-t text-xs text-muted-foreground">+@hidden more change@(hidden == 1 ? "" : "s")</div>
                }
            }
        </BbHoverCardContent>
    </BbHoverCard>
}

@code {
    private const int DryRunPreviewLimit = 25;

    [Parameter]
    public EventCallback OnSynced { get; set; }

    [Parameter]
    public string? BrandColor { get; set; }

    [Parameter]
    public IReadOnlyCollection<WatchlistOutboxEntry> OutboxEntries { get; set; } = [];

    [Parameter]
    public EventCallback OnStatusRefresh { get; set; }

    [Parameter]
    public bool IsSyncing { get; set; }

    [Parameter]
    public EventCallback OnSyncStarted { get; set; }

    private bool HasFailedEntries => OutboxEntries.Any(entry => entry.Status is WatchlistOutboxState.Failed);

    private string OutboxSummary
    {
        get
        {
            var failed = OutboxEntries.Count(entry => entry.Status is WatchlistOutboxState.Failed);
            var inFlight = OutboxEntries.Count - failed;
            var parts = new List<string>(2);
            if (inFlight > 0)
            {
                parts.Add($"{inFlight} in flight");
            }
            if (failed > 0)
            {
                parts.Add($"{failed} failed");
            }
            return string.Join(" · ", parts);
        }
    }

    private const string PreviewHeaderStyle = "background: oklch(from var(--muted) calc(l - 0.08) c h); border-bottom: 2px solid #09090b;";

    private readonly CancellationTokenSource _cts = new();
    private WatchlistSyncSummary? _dryRun;
    private string? _dryRunError;
    private Dictionary<MediaId, MediaLookup> _metadata = [];
    private bool _isSyncing;
    private bool _dryRunRequested;
    private bool _isLoadingDryRun;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    public async Task RefreshAsync()
    {
        await LoadDryRunAsync();
    }

    private async Task OnHoverChanged(bool open)
    {
        if (!open)
        {
            return;
        }
        await OnStatusRefresh.InvokeAsync();
        if (_dryRunRequested)
        {
            return;
        }
        await LoadDryRunAsync();
    }

    private async Task LoadDryRunAsync()
    {
        _dryRunRequested = true;
        _isLoadingDryRun = true;
        _dryRun = null;
        _dryRunError = null;
        _metadata = [];
        StateHasChanged();

        var result = await SyncEngine.DryRunAsync(CurrentUser, _cts.Token);
        switch (result)
        {
            case WatchlistSyncSummary changes:
                _dryRun = changes;
                _metadata = await LoadMetadataAsync(changes);
                break;
            case WatchlistSyncRemoteFailed failed:
                _dryRunError = $"Dry run unavailable — {failed.Reason}";
                break;
            case WatchlistSyncAlreadyRunning:
                _dryRunError = "Dry run unavailable — a sync is already running.";
                break;
        }
        _isLoadingDryRun = false;
        StateHasChanged();
    }

    private Task<Dictionary<MediaId, MediaLookup>> LoadMetadataAsync(WatchlistSyncSummary dryRun) =>
        DryRunMetadataLoader.LoadAsync(Media, dryRun, DryRunPreviewLimit, _cts.Token);

    public async Task SyncAsync()
    {
        if (_isSyncing)
        {
            return;
        }
        _isSyncing = true;
        StateHasChanged();
        try
        {
            await OnSyncStarted.InvokeAsync();
            var result = await SyncEngine.SyncAsync(new ManualTrigger(), CurrentUser, _cts.Token);
            switch (result)
            {
                case WatchlistSyncSummary { Push.Count: > 0 }:
                    break;
                case WatchlistSyncSummary changes:
                    Notifier.Info(changes.ToString(), null);
                    break;
                case WatchlistSyncAlreadyRunning running:
                    Notifier.Info(running.ToString(), null);
                    break;
                case WatchlistSyncRemoteFailed failed:
                    Notifier.Warning(failed.ToString(), null);
                    break;
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Sync failed");
        }
        finally
        {
            _isSyncing = false;
            await RefreshAsync();
            await OnSynced.InvokeAsync();
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
