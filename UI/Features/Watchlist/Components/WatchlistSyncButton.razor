@using Contracts.Identity
@using Contracts.Media
@using Contracts.Watchlist.Sync
@using Contracts.Blacklist
@using Contracts.Watchlist
@using Domain.Watchlist
@using UI.Shared.Changes
@using UI.Shared.Media
@implements IDisposable
@inject IMediaService Media
@inject IWatchlistService WatchlistService
@inject IBlacklistService BlacklistService
@inject IWatchlistSyncEngine SyncEngine
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation
@inject Notifier Notifier

@if (_isSyncing || IsSyncing)
{
    <HoverButton Disabled="true" Color="@BrandColor" Class="whitespace-nowrap">
        <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
        <span>Syncing...</span>
    </HoverButton>
}
else
{
    <HoverButton OnClick="OpenAsync" Color="@BrandColor" Class="relative whitespace-nowrap">
        <LucideIcon Name="refresh-cw" Size="16" Class="mr-2"/>
        <span>Sync</span>
        <span class="ml-2 inline-flex items-center justify-center h-5" style="min-width: 1.5rem">
            @if (_isLoadingDryRun)
            {
                <BbSpinner Size="SpinnerSize.Small"/>
            }
            else if (_dryRun is { TotalChanges: > 0 } report)
            {
                <span class="sync-badge">
                    @if (report.AddCount > 0)
                    {
                        <span class="is-added">@report.AddCount</span>
                    }
                    @if (report is { AddCount: > 0, RemoveCount: > 0 })
                    {
                        <span class="sync-dot">·</span>
                    }
                    @if (report.RemoveCount > 0)
                    {
                        <span class="is-removed">@report.RemoveCount</span>
                    }
                </span>
            }
            else if (_dryRun is not null)
            {
                <LucideIcon Name="check" Size="14"/>
            }
            else if (_dryRunError is not null)
            {
                <LucideIcon Name="cloud-off" Size="14"/>
            }
        </span>
    </HoverButton>

    <ChangeDialog Open="_open"
                  OnOpenChanged="HandleOpenChangedAsync"
                  Title="Review changes before syncing"
                  Subtitle="@Subtitle"
                  Entries="_entries"
                  Chips="_chips"
                  OnSelect="ShowDetailsAsync"
                  RemovedLabel="Removing"
                  AddedLabel="Adding"
                  UnchangedLabel="Already in sync"
                  EmptyMessage="Everything is in sync."
                  BandTone="ChangeBandTone.Bad"
                  Prologue="@(OutboxEntries.Count > 0 ? OutboxStrip : null)"
                  Band="@(_dryRunError is not null ? ErrorBand : null)">
        <Actions>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="CloseAsync">Cancel</BbButton>
            <BbButton Size="ButtonSize.Small" Disabled="@(_dryRun is null || (_dryRun.TotalChanges == 0 && OutboxEntries.Count == 0))" OnClick="ConfirmAsync">
                <LucideIcon Name="refresh-cw" Size="13" Class="mr-1.5"/>
                Sync now
            </BbButton>
        </Actions>
    </ChangeDialog>

    <MediaDetailSheet Open="_selected is not null"
                      OnOpenChanged="@(open => { if (!open) { _selected = null; } })"
                      Media="_selected"
                      OnEnrollmentChanged="HandleEnrollmentChangedAsync"/>
}

@code {
    private RenderFragment OutboxStrip =>
        @<text>
            <LucideIcon Name="send" Size="14"/>
            <span>@OutboxSummary</span>
        </text>;

    private RenderFragment ErrorBand =>
        @<text>
            <LucideIcon Name="cloud-off" Size="15" Class="shrink-0"/>
            <span>@_dryRunError</span>
        </text>;

    [Parameter] public EventCallback OnSynced { get; set; }

    [Parameter] public string? BrandColor { get; set; }

    [Parameter] public IReadOnlyCollection<WatchlistOutboxEntry> OutboxEntries { get; set; } = [];

    [Parameter] public EventCallback OnStatusRefresh { get; set; }

    [Parameter] public bool IsSyncing { get; set; }

    [Parameter] public EventCallback OnSyncStarted { get; set; }

    private const int DryRunAttempts = 3;
    private static readonly TimeSpan DryRunRetryDelay = TimeSpan.FromSeconds(1);

    private readonly CancellationTokenSource _cts = new();
    private WatchlistSyncSummary? _dryRun;
    private string? _dryRunError;
    private IReadOnlyList<ChangeEntry> _entries = [];
    private IReadOnlyList<ChangeChip> _chips = [];
    private bool _isSyncing;
    private bool _isLoadingDryRun;
    private bool _open;
    private MediaLookup? _selected;
    private bool _watchlistChanged;

    private Task ShowDetailsAsync(MediaLookup media)
    {
        _selected = media;
        return Task.CompletedTask;
    }

    private async Task HandleEnrollmentChangedAsync(MediaListKind changed)
    {
        if (changed is not MediaListKind.Watchlist)
        {
            return;
        }

        _watchlistChanged = true;
        await LoadDryRunAsync();
    }

    private string OutboxSummary
    {
        get
        {
            var failed = OutboxEntries.Count(entry => entry.Status is WatchlistOutboxState.Failed);
            var inFlight = OutboxEntries.Count - failed;
            var parts = new List<string>(2);
            if (inFlight > 0)
            {
                parts.Add($"{inFlight} waiting to reach Plex");
            }
            if (failed > 0)
            {
                parts.Add($"{failed} could not be delivered");
            }
            return string.Join(" · ", parts);
        }
    }

    private string Subtitle => _dryRun is { } report ? $"{report.NoOps.Count + report.TotalChanges} titles compared" : "Comparing with Plex…";

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    public async Task RefreshAsync() => await LoadDryRunAsync();

    private async Task OpenAsync()
    {
        _open = true;
        await OnStatusRefresh.InvokeAsync();
        await LoadDryRunAsync();
    }

    private Task CloseAsync()
    {
        _open = false;
        ReloadIfWatchlistChanged();
        return Task.CompletedTask;
    }

    private Task HandleOpenChangedAsync(bool open)
    {
        _open = open;
        if (!open)
        {
            ReloadIfWatchlistChanged();
        }

        return Task.CompletedTask;
    }

    private void ReloadIfWatchlistChanged()
    {
        if (_watchlistChanged)
        {
            Navigation.Refresh(true);
        }
    }

    private async Task LoadDryRunAsync()
    {
        _isLoadingDryRun = true;
        _dryRun = null;
        _dryRunError = null;
        _entries = [];
        _chips = [];
        StateHasChanged();

        for (var attempt = 1; attempt <= DryRunAttempts && _dryRun is null; attempt++)
        {
            if (attempt > 1)
            {
                await Task.Delay(DryRunRetryDelay, _cts.Token);
            }

            await AttemptDryRunAsync();
        }

        _isLoadingDryRun = false;
        StateHasChanged();
    }

    private async Task AttemptDryRunAsync()
    {
        var result = await SyncEngine.DryRunAsync(CurrentUser, _cts.Token);
        switch (result)
        {
            case WatchlistSyncSummary changes:
                _dryRun = changes;
                _dryRunError = null;
                var metadata = await DryRunMetadataLoader.LoadAsync(Media, changes, _cts.Token);
                _entries = WatchlistSyncView.Entries(changes, metadata);
                _chips = WatchlistSyncView.Chips(changes);
                break;
            case WatchlistSyncRemoteFailed failed:
                _dryRunError = failed.Reason;
                break;
            case WatchlistSyncAlreadyRunning:
                _dryRunError = "A sync is already running.";
                break;
        }
    }

    private async Task ConfirmAsync()
    {
        _open = false;
        _watchlistChanged = false;
        await SyncAsync();
    }

    public async Task SyncAsync()
    {
        if (_isSyncing)
        {
            return;
        }

        _isSyncing = true;
        StateHasChanged();
        try
        {
            await OnSyncStarted.InvokeAsync();
            var result = await SyncEngine.SyncAsync(new ManualTrigger(), CurrentUser, _cts.Token);
            switch (result)
            {
                case WatchlistSyncSummary { Push.Count: > 0 }:
                    break;
                case WatchlistSyncSummary changes:
                    Notifier.Info(changes.ToString(), null);
                    break;
                case WatchlistSyncAlreadyRunning running:
                    Notifier.Info(running.ToString(), null);
                    break;
                case WatchlistSyncRemoteFailed failed:
                    Notifier.Warning(failed.ToString(), null);
                    break;
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Sync failed");
        }
        finally
        {
            _isSyncing = false;
            await RefreshAsync();
            await OnSynced.InvokeAsync();
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
