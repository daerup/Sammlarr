@using System.ComponentModel
@using BlazorBlueprint.Primitives.Filtering
@using Contracts.Auth
@using Contracts.Processing
@using UI.Features.Feeds.Components
@inject IApiKeyService ApiKeyService

<BbCard Class="flex-1 min-w-0 flex flex-col overflow-hidden feed-pane rounded-lg bg-card border border-border shadow-sm">
    <div class="flex-1 min-h-0 overflow-y-auto scrollbar-thin px-6 py-6" style="scrollbar-gutter: stable;">
        <div class="space-y-8 pb-4">

            <BbField>
                <BbFieldLabel Class="flex items-center leading-none">
                    Enabled
                    <BbTooltipProvider>
                        <BbTooltip DelayDuration="0">
                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                <LucideIcon Name="info" Size="14"/>
                            </BbTooltipTrigger>
                            <BbTooltipContent>Toggle to enable or disable this feed.</BbTooltipContent>
                        </BbTooltip>
                    </BbTooltipProvider>
                </BbFieldLabel>
                <BbFieldContent>
                    <BbSwitch @bind-Checked="@_isEnabled" @bind-Checked:after="NotifyChange"/>
                </BbFieldContent>
            </BbField>

            <BbField>
                <BbFieldLabel For="name" Class="flex items-center leading-none">
                    Name <span class="text-destructive ml-0.5">*</span>
                    <BbTooltipProvider>
                        <BbTooltip DelayDuration="0">
                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                <LucideIcon Name="info" Size="14"/>
                            </BbTooltipTrigger>
                            <BbTooltipContent>A friendly label to identify this feed across your collection.</BbTooltipContent>
                        </BbTooltip>
                    </BbTooltipProvider>
                </BbFieldLabel>
                <BbFieldContent>
                    <BbInput id="name" Placeholder="e.g. My Top Movies"
                             Value="@_name" ValueChanged="@ChangeName"
                             Class="bg-accent" Required="true"
                             UpdateTiming="UpdateTiming.Immediate"/>
                </BbFieldContent>
            </BbField>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-8">
                <BbField>
                    <BbFieldLabel Class="flex items-center leading-none">
                        Provider <span class="text-destructive ml-0.5">*</span>
                        <BbTooltipProvider>
                            <BbTooltip DelayDuration="0">
                                <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                    <LucideIcon Name="info" Size="14"/>
                                </BbTooltipTrigger>
                                <BbTooltipContent>The external service that hosts the list you want to import.</BbTooltipContent>
                            </BbTooltip>
                        </BbTooltipProvider>
                    </BbFieldLabel>
                    <BbFieldContent>
                        <FeedProviderSelect Value="@_provider" ValueChanged="@ChangeProvider" Unavailable="@_disabledProviders"/>
                    </BbFieldContent>
                    @if (ProviderWithoutKey is { } missing)
                    {
                        <BbFieldError>
                            API key is missing, fix in <AppLink Href="@SettingsLinks.Provider(missing.AsMediaProvider())" Color="inherit">Settings</AppLink>
                        </BbFieldError>
                    }
                </BbField>

                <BbField>
                    <BbFieldLabel Class="flex leading-none">
                        Strategy
                        <BbTooltipProvider>
                            <BbTooltip>
                                <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex p-0 text-muted-foreground cursor-default">
                                    <LucideIcon Name="info" Size="14"/>
                                </BbTooltipTrigger>
                                <BbTooltipContent>Append only adds. Mirror also removes items this feed added, once they leave the list.</BbTooltipContent>
                            </BbTooltip>
                        </BbTooltipProvider>
                    </BbFieldLabel>
                    <BbFieldContent>
                        <div class="relative">
                        <div class="flex items-center gap-2">
                            <BbButton Variant="@(_strategyMode == StrategyMode.Append ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      Class="min-w-24 justify-center"
                                      aria-pressed="@(_strategyMode == StrategyMode.Append)"
                                      OnClick="@(() => ChangeStrategyMode(StrategyMode.Append))">
                                Append
                            </BbButton>
                            @if (_strategyMode == StrategyMode.Mirror)
                            {
                                <div class="flex items-stretch h-10 rounded-md border border-primary overflow-hidden">
                                    <BbButton Variant="ButtonVariant.Default" Class="min-w-20 justify-center rounded-none border-0 h-full" aria-pressed="@true">Mirror</BbButton>
                                    <span class="flex items-center bg-accent px-2">
                                        <input id="absence-threshold" inputmode="numeric" aria-label="Runs missing before removal"
                                               aria-invalid="@AbsenceThresholdIsInvalid"
                                               value="@_absenceThresholdRaw"
                                               @oninput="@(e => ChangeAbsenceThreshold(e.Value?.ToString() ?? string.Empty))"
                                               class="w-9 bg-transparent border-0 text-center text-sm text-foreground focus:outline-none"/>
                                    </span>
                                </div>
                            }
                            else
                            {
                                <BbButton Variant="ButtonVariant.Outline"
                                          Class="min-w-24 justify-center"
                                          OnClick="@(() => ChangeStrategyMode(StrategyMode.Mirror))">
                                    Mirror
                                </BbButton>
                            }
                        </div>
                        @if (_strategyMode == StrategyMode.Mirror)
                        {
                            <p class="absolute left-0 top-full mt-1.5 whitespace-nowrap text-sm @AbsenceHelperClass">
                                @if (AbsenceThresholdIsInvalid)
                                {
                                    <span>Enter a whole number of at least 1.</span>
                                }
                                else if (AbsenceThresholdIsRisky)
                                {
                                    <span>Removes an item as soon as it leaves the list.</span>
                                }
                                else
                                {
                                    <span>
                                        Waits
                                        <span class="absence-threshold-count">@ParsedAbsenceThreshold</span>
                                        runs before removing an item that left the list.
                                    </span>
                                }
                            </p>
                        }
                        </div>
                    </BbFieldContent>
                </BbField>
            </div>

            <BbField>
                <BbFieldLabel For="list-identifier" Class="flex items-center leading-none">
                    List identifier <span class="text-destructive ml-0.5">*</span>
                    <BbTooltipProvider>
                        <BbTooltip>
                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                <LucideIcon Name="info" Size="14"/>
                            </BbTooltipTrigger>
                            <BbTooltipContent>The unique string that locates your list within the selected provider. The exact format varies by provider; check
                                the list's URL or the provider's documentation.
                            </BbTooltipContent>
                        </BbTooltip>
                    </BbTooltipProvider>
                </BbFieldLabel>
                <BbFieldContent>
                    <BbInput id="list-identifier" Placeholder="@GetIdentifierPlaceholder(_provider)"
                             Value="@_identifier" ValueChanged="@ChangeIdentifier"
                             Class="bg-accent" Required="true"
                             Disabled="@IsLoading"
                             UpdateTiming="UpdateTiming.Immediate"/>
                </BbFieldContent>
                <BbFieldDescription>@RenderIdentifierDescription()</BbFieldDescription>
            </BbField>

        </div>

        <BbCollapsible Open="@_filtersSectionOpen" OpenChanged="@(v => _filtersSectionOpen = v)">
            <BbCollapsibleTrigger AsChild="false"
                                  Class="group w-full flex items-center justify-between -mx-6 pl-2 pr-4 py-3 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors border-t">
                <span class="flex items-center gap-2">
                    <LucideIcon Name="sliders-horizontal" Size="14"/>
                    Filters, Sorting & Limits
                    <span class="text-xs font-normal opacity-50">optional</span>
                </span>
                <LucideIcon Name="chevron-down" Size="14" Class="transition-transform duration-200 group-data-[state=open]:rotate-180"/>
            </BbCollapsibleTrigger>
            <BbCollapsibleContent>
                <div class="pt-4 pb-4 space-y-8 px-3">

                    <BbField>
                        <BbFieldLabel Class="flex items-center leading-none">
                            Enable filters
                            <BbTooltipProvider>
                                <BbTooltip DelayDuration="0">
                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                        <LucideIcon Name="info" Size="14"/>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Limit which imported items are added to your collection. Filter by genre, rating, release year, and
                                        more.
                                    </BbTooltipContent>
                                </BbTooltip>
                            </BbTooltipProvider>
                        </BbFieldLabel>
                        <BbFieldContent>
                            <BbSwitch @bind-Checked="@_filterEnabled" @bind-Checked:after="NotifyChange"/>
                        </BbFieldContent>
                    </BbField>

                    @if (_filterEnabled)
                    {
                        <BbFilterBuilder Filter="@_filter" FilterChanged="@ChangeFilter" Fields="FilterFields"/>
                    }

                    <BbField>
                        <BbFieldLabel Class="flex items-center leading-none">
                            Enable custom sorting
                            <BbTooltipProvider>
                                <BbTooltip DelayDuration="0">
                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                        <LucideIcon Name="info" Size="14"/>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Sort imported items by a specific field before applying the limit.</BbTooltipContent>
                                </BbTooltip>
                            </BbTooltipProvider>
                        </BbFieldLabel>
                        <BbFieldContent>
                            <BbSwitch @bind-Checked="@_sortEnabled" @bind-Checked:after="NotifyChange"/>
                        </BbFieldContent>
                    </BbField>

                    @if (_sortEnabled)
                    {
                        <BbField>
                            <BbFieldLabel Class="flex items-center leading-none">
                                Sort by
                            </BbFieldLabel>
                            <BbFieldContent>
                                <div class="flex items-center gap-3">
                                    <BbSelect TValue="string"
                                              Value="@SortField"
                                              Class="w-40"
                                              ValueChanged="@ChangeSortField"
                                              Options="SortFields"/>
                                    <BbTooltipProvider>
                                        <BbTooltip DelayDuration="0">
                                            <BbTooltipTrigger AsChild="false" Class="p-0">
                                                <BbButton Size="ButtonSize.Icon"
                                                          Variant="ButtonVariant.Outline"
                                                          OnClick="@ToggleSortDirection"
                                                          AriaLabel="@GetSortLabel()">
                                                    <LucideIcon Name="arrow-up" Size="14" Class="@GetSortIconClass()"/>
                                                </BbButton>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>@GetSortTooltip()</BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                </div>
                            </BbFieldContent>
                        </BbField>
                    }

                    <BbField>
                        <BbFieldLabel Class="flex items-center leading-none">
                            Enable limit
                            <BbTooltipProvider>
                                <BbTooltip DelayDuration="0">
                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                        <LucideIcon Name="info" Size="14"/>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Cap the number of imported items.</BbTooltipContent>
                                </BbTooltip>
                            </BbTooltipProvider>
                        </BbFieldLabel>
                        <BbFieldContent>
                            <BbSwitch @bind-Checked="@_limitEnabled" @bind-Checked:after="NotifyChange"/>
                        </BbFieldContent>
                    </BbField>

                    @if (_limitEnabled)
                    {
                        <BbField IsInvalid="@LimitIsInvalid">
                            <BbFieldLabel For="limit" Class="flex items-center leading-none">
                                Maximum items
                            </BbFieldLabel>
                            <BbFieldContent>
                                <BbInput id="limit"
                                         Placeholder="e.g. 100"
                                         Value="@_limitRaw" ValueChanged="@ChangeLimitRaw"
                                         Class="bg-accent w-40"
                                         AriaInvalid="@LimitIsInvalid"
                                         UpdateTiming="UpdateTiming.Immediate"/>
                            </BbFieldContent>
                            @if (LimitIsInvalid)
                            {
                                <BbFieldError>Limit must be a positive whole number.</BbFieldError>
                            }
                        </BbField>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <BbField>
                                <BbFieldLabel Class="flex items-center leading-none">
                                    Wantlist slot policy
                                    <BbTooltipProvider>
                                        <BbTooltip>
                                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                <LucideIcon Name="info" Size="14"/>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>
                                                Wantlisted items are never imported. This decides whether they still take a slot, and takes precedence if
                                                the item is blocklisted too.
                                            </BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                </BbFieldLabel>
                                <BbFieldContent>
                                    <EnumToggleGroup TEnum="SlotPolicy"
                                                     Value="@WantlistedBehavior"
                                                     OnChange="@ChangeWantlistedBehavior"
                                                     TooltipProvider="@GetSlotPolicyTooltip"/>
                                    <p class="mt-1.5 text-sm text-muted-foreground">@SlotScopeHelper</p>
                                </BbFieldContent>
                            </BbField>

                            <BbField>
                                <BbFieldLabel Class="flex items-center leading-none">
                                    Blocklist slot policy
                                    <BbTooltipProvider>
                                        <BbTooltip>
                                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                <LucideIcon Name="info" Size="14"/>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>
                                                Blocklisted items are never imported. This decides whether they still take a slot.
                                            </BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                </BbFieldLabel>
                                <BbFieldContent>
                                    <EnumToggleGroup TEnum="SlotPolicy"
                                                     Value="@BlocklistedBehavior"
                                                     OnChange="@ChangeBlocklistedBehavior"
                                                     TooltipProvider="@GetSlotPolicyTooltip"/>
                                </BbFieldContent>
                            </BbField>
                        </div>
                    }

                </div>
            </BbCollapsibleContent>
        </BbCollapsible>

        <BbCollapsible Open="@_syncFrequencySectionOpen" OpenChanged="@(v => _syncFrequencySectionOpen = v)">
            <BbCollapsibleTrigger AsChild="false"
                                  Class="group w-full flex items-center justify-between -mx-6 pl-2 pr-4 py-3 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors border-t">
                <span class="flex items-center gap-2">
                    <LucideIcon Name="clock" Size="14"/>
                    Sync Frequency
                    <span class="text-xs font-normal opacity-50">optional</span>
                </span>
                <LucideIcon Name="chevron-down" Size="14" Class="transition-transform duration-200 group-data-[state=open]:rotate-180"/>
            </BbCollapsibleTrigger>
            <BbCollapsibleContent>
                <div class="pt-4 pb-4 space-y-8 px-3">
                    <BbField>
                        <BbFieldLabel Class="flex items-center leading-none">
                            Trigger
                            <BbTooltipProvider>
                                <BbTooltip DelayDuration="0">
                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                        <LucideIcon Name="info" Size="14"/>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>When to sync this feed, on demand or on a recurring schedule.</BbTooltipContent>
                                </BbTooltip>
                            </BbTooltipProvider>
                        </BbFieldLabel>
                        <BbFieldContent>
                            <EnumToggleGroup TEnum="ScheduleMode"
                                             Value="@_scheduleMode"
                                             OnChange="@OnScheduleModeChanged"/>
                        </BbFieldContent>
                    </BbField>

                    @if (_scheduleMode == ScheduleMode.Scheduled)
                    {
                        <BbField>
                            <BbFieldLabel Class="flex items-center leading-none">
                                Schedule
                                <BbTooltipProvider>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                            <LucideIcon Name="info" Size="14"/>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Define a CRON schedule for automatic runs.</BbTooltipContent>
                                    </BbTooltip>
                                </BbTooltipProvider>
                            </BbFieldLabel>
                            <BbFieldContent>
                                <SchedulePicker CronExpression="@_scheduleCronExpression"
                                                CronExpressionChanged="@ChangeSchedule"/>
                            </BbFieldContent>
                        </BbField>
                    }
                </div>
            </BbCollapsibleContent>
        </BbCollapsible>

    </div>
</BbCard>

@code {

    [Parameter] public required FeedConfig Value { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<FeedConfig> OnChange { get; set; }

    private readonly HashSet<FeedProvider> _disabledProviders = [];

    private static readonly QuerySort DefaultSort = new() { Property = nameof(MediaQueryRow.Title), Direction = ListSortDirection.Descending };
    private static readonly QueryLimit DefaultLimit = new() { Count = 0, Wantlisted = SlotPolicy.Consumed, Blocklisted = SlotPolicy.Consumed };

    private bool _isEnabled;
    private string _name = string.Empty;
    private FeedProvider? _provider;
    private StrategyMode _strategyMode;
    private string _absenceThresholdRaw = new Mirror().AbsenceThreshold.ToString();
    private string _identifier = string.Empty;
    private bool _filtersSectionOpen;
    private bool _filterEnabled;
    private FilterDefinition _filter = new();
    private bool _sortEnabled;
    private QuerySort _sort = DefaultSort;
    private bool _limitEnabled;
    private QueryLimit _limit = DefaultLimit;
    private string _limitRaw = string.Empty;
    private bool _syncFrequencySectionOpen;
    private ScheduleMode _scheduleMode;
    private string? _scheduleCronExpression;

    private FeedProvider? ProviderWithoutKey => _provider is { } provider && _disabledProviders.Contains(provider) ? provider : null;
    private bool ProviderHasNoKey => ProviderWithoutKey is not null;
    private bool ScheduleIsInvalid => _scheduleMode == ScheduleMode.Scheduled && _scheduleCronExpression is null;
    private int? ParsedLimit => int.TryParse(_limitRaw, out var n) && n > 0 ? n : null;
    private bool LimitIsInvalid => _limitEnabled && ParsedLimit is null;
    private int? ParsedAbsenceThreshold => int.TryParse(_absenceThresholdRaw, out var n) && n >= 1 ? n : null;
    private bool AbsenceThresholdIsInvalid => _strategyMode == StrategyMode.Mirror && ParsedAbsenceThreshold is null;
    private bool AbsenceThresholdIsRisky => _strategyMode == StrategyMode.Mirror && ParsedAbsenceThreshold == 1;
    private string AbsenceHelperClass => AbsenceThresholdIsInvalid ? "text-destructive" : AbsenceThresholdIsRisky ? "text-amber-500" : "text-muted-foreground";

    private string SortField => _sort.Property;
    private ListSortDirection SortDir => _sort.Direction;
    private SlotPolicy WantlistedBehavior => _limit.Wantlisted;
    private SlotPolicy BlocklistedBehavior => _limit.Blocklisted;

    private record FieldDefinition(string Property, string Label, FilterFieldType FilterType, IReadOnlyList<SelectOption<string>>? Options = null);

    private static readonly IReadOnlyList<FieldDefinition> FieldDefinitions =
    [
        new(nameof(MediaQueryRow.Title), "Title", FilterFieldType.Text),
        new(nameof(MediaQueryRow.Tagline), "Tagline", FilterFieldType.Text),
        new(nameof(MediaQueryRow.Summary), "Summary", FilterFieldType.Text),
        new(nameof(MediaQueryRow.Genres), "Genres", FilterFieldType.Text),
        new(
            nameof(MediaQueryRow.MediaType),
            "Media Type",
            FilterFieldType.Enum,
            [new SelectOption<string>(nameof(MediaType.Movie), "Movie"), new SelectOption<string>(nameof(MediaType.Show), "Show")]
        ),
        new(nameof(MediaQueryRow.ReleaseDate), "Release Date", FilterFieldType.Date),
        new(nameof(MediaQueryRow.Rating), "Rating", FilterFieldType.Number),
        new(nameof(MediaQueryRow.RuntimeMinutes), "Runtime (min)", FilterFieldType.Number),
        new(nameof(MediaQueryRow.Seasons), "Seasons", FilterFieldType.Number),
        new(nameof(MediaQueryRow.Episodes), "Episodes", FilterFieldType.Number),
    ];

    private static readonly IReadOnlyList<SelectOption<string>> SortFields =
        FieldDefinitions.Select(f => new SelectOption<string>(f.Property, f.Label)).ToList();

    private static readonly IReadOnlyList<FilterField> FilterFields =
        FieldDefinitions
            .Select(f => new FilterField
            {
                Name = f.Property,
                Label = f.Label,
                Type = f.FilterType,
                Options = f.Options ?? [],
            })
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _isEnabled = Value.IsEnabled;
        _name = Value.Name;
        _provider = Value.Provider;
        _strategyMode = Value.Strategy is Mirror ? StrategyMode.Mirror : StrategyMode.Append;
        _absenceThresholdRaw = (Value.Strategy is Mirror m ? m : new Mirror()).AbsenceThreshold.ToString();
        _identifier = Value.Identifier;
        _filterEnabled = Value.Filter is not null;
        _filter = Value.Filter ?? new FilterDefinition();
        _filtersSectionOpen = Value.Filter is not null || Value.Sort is not null || Value.Limit is not null;
        _sortEnabled = Value.Sort is not null;
        _sort = Value.Sort ?? DefaultSort;
        _limitEnabled = Value.Limit is not null;
        _limit = Value.Limit ?? DefaultLimit;
        _limitRaw = Value.Limit?.Count.ToString() ?? string.Empty;
        _scheduleMode = Value.Schedule is Scheduled ? ScheduleMode.Scheduled : ScheduleMode.Manual;
        _scheduleCronExpression = Value.Schedule is Scheduled scheduled ? scheduled.ToString() : null;
        _syncFrequencySectionOpen = _scheduleMode == ScheduleMode.Scheduled;

        _disabledProviders.UnionWith(await FeedProviderKeys.WithoutKeyAsync(ApiKeyService));

        if (ProviderHasNoKey)
        {
            NotifyChange();
        }
    }

    private void NotifyChange() => _ = OnChange.InvokeAsync(BuildConfig());

    private FeedConfig BuildConfig() => new()
    {
        IsEnabled = _isEnabled,
        Name = _name,
        Provider = _provider,
        Strategy = _strategyMode == StrategyMode.Mirror ? new FeedStrategy(ParsedAbsenceThreshold is { } threshold ? new Mirror(threshold) : new Mirror()) : new FeedStrategy(new Append()),
        Identifier = _identifier,
        Filter = _filterEnabled ? _filter : null,
        Sort = _sortEnabled ? _sort : null,
        Limit = _limitEnabled ? _limit : null,
        IsScheduleValid = !ScheduleIsInvalid,
        IsStrategyValid = !AbsenceThresholdIsInvalid,
        IsProviderAvailable = !ProviderHasNoKey,
        Schedule = _scheduleMode == ScheduleMode.Scheduled && _scheduleCronExpression is not null
            ? new FeedRunTrigger(new Scheduled(_scheduleCronExpression))
            : new FeedRunTrigger(new Manual()),
    };

    private void ChangeName(string v)
    {
        _name = v;
        NotifyChange();
    }
    private void ChangeProvider(FeedProvider? v)
    {
        _provider = v;
        NotifyChange();
    }
    private void ChangeStrategyMode(StrategyMode v)
    {
        _strategyMode = v;
        NotifyChange();
    }
    private void ChangeAbsenceThreshold(string v)
    {
        _absenceThresholdRaw = v;
        NotifyChange();
    }
    private void ChangeIdentifier(string v)
    {
        _identifier = v;
        NotifyChange();
    }
    private void ChangeFilter(FilterDefinition f)
    {
        _filter = f;
        NotifyChange();
    }
    private void ChangeLimitRaw(string v)
    {
        _limitRaw = v;
        if (int.TryParse(v, out var n) && n > 0)
        {
            _limit = _limit with { Count = n };
        }
        NotifyChange();
    }
    private void OnScheduleModeChanged(ScheduleMode v)
    {
        _scheduleMode = v;
        if (v == ScheduleMode.Scheduled)
        {
            _syncFrequencySectionOpen = true;
        }
        NotifyChange();
    }

    private void ChangeSchedule(string? v)
    {
        _scheduleCronExpression = v;
        NotifyChange();
    }


    private void ToggleSortDirection()
    {
        _sort = _sort with
        {
            Direction = SortDir == ListSortDirection.Ascending ? ListSortDirection.Descending : ListSortDirection.Ascending,
        };
        NotifyChange();
    }

    private void ChangeSortField(string? v)
    {
        _sort = _sort with { Property = v ?? SortField };
        NotifyChange();
    }

    private void ChangeWantlistedBehavior(SlotPolicy v)
    {
        _limit = _limit with { Wantlisted = v };
        NotifyChange();
    }

    private void ChangeBlocklistedBehavior(SlotPolicy v)
    {
        _limit = _limit with { Blocklisted = v };
        NotifyChange();
    }

    private string GetIdentifierPlaceholder(FeedProvider? provider) =>
        provider switch
        {
            FeedProvider.Mdblist => "e.g. top-250-movies or 12345",
            null => "Select a provider first",
            _ => "Provider-specific list identifier",
        };

    private MarkupString RenderIdentifierDescription() => _provider switch
    {
        FeedProvider.Mdblist => new MarkupString(
        "Slug or numeric ID from the list URL, e.g. <code>top-250-movies</code> or <code>12345</code>. " +
        "<a href=\"https://mdblist.com/toplists/\" target=\"_blank\" " +
        "class=\"underline underline-offset-2 hover:text-foreground transition-colors\">Browse lists on MDBList</a>"),
        null => new MarkupString("No provider is available. Configure an API key in Settings."),
        _ => new MarkupString("The provider-specific identifier for the list (slug, numeric ID, or URL segment)."),
    };

    private static string GetStrategyTooltip(StrategyMode strategy) =>
        strategy switch
        {
            StrategyMode.Append => "Each sync adds only new items. Items already in your collection are kept.",
            StrategyMode.Mirror => "Each sync removes items that were added by this feed and are no longer on the list. Items added by other feeds are unaffected, even if they appear on this list.",
        };

    private const string SlotScopeHelper = "Only affects items this feed did not add itself.";

    private static string GetSlotPolicyTooltip(SlotPolicy behavior) =>
        behavior switch
        {
            SlotPolicy.Consumed => "Counts against your import limit, taking up a slot that could be used by another item.",
            SlotPolicy.Preserved => "Does not count against your import limit, preserving the slot for the next eligible item.",
        };

    private string GetSortLabel() =>
        SortDir == ListSortDirection.Ascending ? "Ascending" : "Descending";

    private string GetSortTooltip() =>
        SortDir == ListSortDirection.Ascending ? "Ascending (low to high)" : "Descending (high to low)";

    private string GetSortIconClass() =>
        SortDir == ListSortDirection.Descending ? "transition-transform duration-200 rotate-180" : "transition-transform duration-200";
}
