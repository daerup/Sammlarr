@using System.Diagnostics
@using Contracts.Blacklist
@using Contracts.DI
@using Contracts.Feed
@using Contracts.Media
@using Contracts.Processing
@using Contracts.Watchlist
@using UI.Features.Feeds.Components
@using global::Observability.Tracing
@implements IDisposable
@inject IWatchlistService WatchlistService
@inject IBlacklistService BlacklistService
@inject IMediaService Media
@inject IKeyedServiceIndex<FeedProvider, IFeedService> FeedServiceIndex
@inject IQueryProcessor<MediaQueryRow> QueryProcessor
@inject Notifier Notifier

<BbCard Class="flex-1 min-w-0 flex flex-col overflow-hidden feed-pane rounded-lg bg-card border border-border shadow-sm">
    <div class="shrink-0 sticky top-0 z-20 px-6 pt-6 pb-4 border-b flex items-center gap-2 bg-base-100 rounded-t-lg">
        <BbInput Placeholder="Search media..."
                 Class="w-full"
                 Value="@_searchQuery"
                 ValueChanged="OnSearchQueryChanged"
                 UpdateTiming="UpdateTiming.Debounced"
                 DebounceInterval="250"
                 Disabled="IsLoading"/>
        <LucideIcon Name="search" Class="text-muted-foreground shrink-0"/>
        @if (HasResults)
        {
            <BbAlertDialog @bind-Open="_refreshDialogOpen">
                <BbAlertDialogTrigger>
                    <BbTooltip>
                        <BbTooltipTrigger>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Refresh assets">
                                <LucideIcon Name="refresh-cw" Size="16"/>
                            </BbButton>
                        </BbTooltipTrigger>
                        <BbTooltipContent>Refresh assets</BbTooltipContent>
                    </BbTooltip>
                </BbAlertDialogTrigger>
                <BbAlertDialogContent>
                    <BbAlertDialogHeader>
                        <BbAlertDialogTitle>Refresh assets?</BbAlertDialogTitle>
                        <BbAlertDialogDescription>
                            This drops the cached metadata for every item shown and re-fetches it from your providers. It may take a while for large lists.
                        </BbAlertDialogDescription>
                    </BbAlertDialogHeader>
                    <BbAlertDialogFooter>
                        <BbAlertDialogCancel>
                            <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                        </BbAlertDialogCancel>
                        <BbButton Variant="ButtonVariant.Default" OnClick="OnRefreshConfirmedAsync">Refresh</BbButton>
                    </BbAlertDialogFooter>
                </BbAlertDialogContent>
            </BbAlertDialog>
        }
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto scrollbar-thin px-6 pb-4 pt-4 flex flex-col" style="scrollbar-gutter: stable;">
        @if (HasItems)
        {
            <div class="mb-4 shrink-0 flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-base font-semibold tracking-wide flex items-center gap-2">
                        <span>Media Results</span>
                        @if (IsLoading)
                        {
                            <BbSpinner Size="SpinnerSize.Small"/>
                        }
                    </h2>
                    <p class="text-sm text-muted-foreground mt-0.5">
                        <FeedSourceLink Identifier="@(_appliedConfig?.Identifier ?? Config.Identifier)"
                                        Provider="@(_appliedConfig?.Provider ?? Config.Provider!.Value)"/>
                    </p>
                </div>
                <BbTooltipProvider>
                    <div class="stat-badges-row flex items-start text-xs font-medium">
                        <PreviewFilterBadge Icon="list" Count="_rawResults.Count" Active="_activeFilters.Count == 0" OnClick="ResetFilters">
                            <Tooltip>Total items fetched from the source list. Click to clear filters.</Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Icon="check" Count="IncludedCount" Active="IsFilterActive(PreviewResultFilter.Included)" OnClick="() => ToggleFilter(PreviewResultFilter.Included)">
                            <Tooltip>Items that will be imported</Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Icon="redo-dot" Count="BypassedCount" Active="IsFilterActive(PreviewResultFilter.Bypassed)" OnClick="() => ToggleFilter(PreviewResultFilter.Bypassed)">
                            <Tooltip>
                                <p class="font-medium mb-0.5">Bypasses import</p>
                                <p>@WatchlistCount in your watchlist · @BlacklistCount in your blacklist</p>
                                <p class="opacity-70 mt-0.5">These will not be imported.</p>
                            </Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Icon="filter-x" Count="FilteredCount" Active="IsFilterActive(PreviewResultFilter.Filtered)" OnClick="() => ToggleFilter(PreviewResultFilter.Filtered)">
                            <Tooltip>Items excluded by your filter rules</Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Icon="scissors" Count="SkippedCount" Active="IsFilterActive(PreviewResultFilter.Skipped)" OnClick="() => ToggleFilter(PreviewResultFilter.Skipped)">
                            <Tooltip>Items excluded by the import limit</Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Icon="circle-alert" Count="UnresolvedCount" Active="IsFilterActive(PreviewResultFilter.Unresolved)" OnClick="() => ToggleFilter(PreviewResultFilter.Unresolved)">
                            <Tooltip>Items that could not be matched in your media provider</Tooltip>
                        </PreviewFilterBadge>
                    </div>
                </BbTooltipProvider>
            </div>
        }
        @if (_providerUnavailable && HasItems)
        {
            <div class="mb-4 shrink-0 flex items-center justify-between gap-3 rounded-md border border-border bg-muted/40 px-4 py-3">
                <div class="flex items-center gap-2 text-sm">
                    <LucideIcon Name="triangle-alert" Size="18" Class="text-muted-foreground shrink-0"/>
                    <span>The provider became unavailable before the full list finished loading — showing partial results.</span>
                </div>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="RetryAsync" Disabled="IsLoading">
                    <LucideIcon Name="refresh-cw" Size="14" Class="mr-1"/>
                    Retry
                </BbButton>
            </div>
        }
        @if (HasItems && (_filteredResults.Count > 0 || _filteredUnresolvedResults.Count > 0))
        {
            @if (_filteredResults.Count > 0)
            {
                <div>
                <Virtualize Items="_filteredResults" Context="result" ItemSize="215" OverscanCount="6">
                    <ItemContent>
                    @{
                    var item = GetItem(result);
                    var isCulled = result is Culled<MediaQueryRow>;
                    var isTruncated = result is Truncated<MediaQueryRow>;
                    var isDimmed = isCulled || isTruncated;
                    var isGreyedOut = result is Bypassed<MediaQueryRow>;
                    var isBlacklisted = IsBlacklisted(item);
                    var isInWatchlist = IsWatchlisted(item);
                    var isTogglingWatchlist = _togglingWatchlistItem == item.Id;
                    var isTogglingBlacklist = _togglingBlacklistItem == item.Id;

                    var hoverStyle = (isDimmed, isGreyedOut) switch
                    {
                        (true, _) => "result-dimmed",
                        (false, true) => "result-grey",
                        _ => "hover-bg"
                    };
                    <div class="pb-2">
                            <MediaDetailTile @key="item"
                                             Media="item"
                                             Class="@(hoverStyle)"
                                             IsFocused="_focusedResult == item.Key"
                                             OnFocusIn="() => _focusedResult = item.Key"
                                             OnFocusOut="() => ClearFocus(item)">
                                <Icons>
                                    @if (isDimmed)
                                    {
                                        <BbTooltipProvider>
                                            <BbTooltip DelayDuration="300">
                                                <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                                                    <div class="search-result-status-indicator">
                                                        <LucideIcon Name="@(isCulled ? "filter-x" : "scissors")" Size="24"/>
                                                    </div>
                                                </BbTooltipTrigger>
                                                <BbTooltipContent>
                                                    @(isCulled ? "Filtered out by your filter rules." : "Excluded by the specified limit.")
                                                </BbTooltipContent>
                                            </BbTooltip>
                                        </BbTooltipProvider>
                                    }
                                    else if (isGreyedOut)
                                    {
                                        <BbTooltipProvider>
                                            <BbTooltip DelayDuration="300">
                                                <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                                                    <div class="search-result-status-indicator">
                                                        <LucideIcon Name="redo-dot" Size="24"/>
                                                    </div>
                                                </BbTooltipTrigger>
                                                <BbTooltipContent>@(result is Bypassed<MediaQueryRow> bypassed ? BypassedTooltip(bypassed) : string.Empty)</BbTooltipContent>
                                            </BbTooltip>
                                        </BbTooltipProvider>
                                    }
                                    <WatchlistToggleIcon Result="item" IsToggled="isInWatchlist" IsToggling="isTogglingWatchlist" OnToggle="ToggleWatchlistAsync"/>
                                    <BlacklistToggleIcon Result="item" IsToggled="isBlacklisted" IsToggling="isTogglingBlacklist" OnToggle="ToggleBlacklistAsync"/>
                                </Icons>
                            </MediaDetailTile>
                        </div>
                    }
                    </ItemContent>
                </Virtualize>
                </div>
            }
            @if (_filteredUnresolvedResults.Count > 0)
            {
                <div class="mt-4">
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider px-1 pb-2">Not found in provider</p>
                    <Virtualize Items="_filteredUnresolvedResults" Context="item" ItemSize="215" OverscanCount="6">
                        <ItemContent>
                    @{
                            <div class="pb-2">
                                <MediaDetailTile @key="item"
                                                 Media="item.Media"
                                                 IsFocused="_focusedResult == item.Media.Key"
                                                 OnFocusIn="() => _focusedResult = item.Media.Key"
                                                 OnFocusOut="() => ClearFocus(item.Media)">
                                    <Icons>
                                        <BbTooltipProvider>
                                            <BbTooltip DelayDuration="300">
                                                <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                                                    <div class="search-result-status-indicator">
                                                        <LucideIcon Name="circle-alert" Size="24"/>
                                                    </div>
                                                </BbTooltipTrigger>
                                                <BbTooltipContent>Could not be matched in your media provider. This item will not be imported.</BbTooltipContent>
                                            </BbTooltip>
                                        </BbTooltipProvider>
                                    </Icons>
                                </MediaDetailTile>
                            </div>
                    }
                        </ItemContent>
                    </Virtualize>
                </div>
            }
            @if (IsLoading)
            {
                <div class="mt-2 space-y-2">
                    <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="3"/>
                </div>
            }
        }
        else if (HasItems)
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                <LucideIcon Name="search-x" Size="48" Class="text-muted-foreground mb-4"/>
                <p class="text-lg font-semibold">No results match</p>
                <p class="text-muted-foreground text-sm mt-2">Try adjusting your search or filters.</p>
            </div>
        }
        else if (IsLoading)
        {
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaResultsHeader"/>
            <div class="space-y-2">
                <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="8"/>
            </div>
        }
        else if (HasFailed)
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                @if (_providerUnavailable)
                {
                    <LucideIcon Name="cloud-off" Size="48" Class="text-muted-foreground mb-4"/>
                    <p class="text-lg font-semibold">Provider temporarily unavailable</p>
                    <p class="text-muted-foreground text-sm mt-2">The list provider is rate-limited or unreachable right now. Try again in a moment.</p>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="mt-4" OnClick="RetryAsync" Disabled="IsLoading">
                        <LucideIcon Name="refresh-cw" Size="14" Class="mr-1"/>
                        Retry
                    </BbButton>
                }
                else
                {
                    <LucideIcon Name="zap-off" Size="48" Class="mb-4"/>
                    <p class="text-lg font-semibold">Test failed</p>
                    <p class="text-muted-foreground text-sm mt-2">Could not fetch media from the provider. Please check your input and try again.</p>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                <LucideIcon Name="list-music" Size="48" Class="text-muted-foreground mb-4"/>
                <p class="text-lg font-semibold">Media results will appear here</p>
                <p class="text-muted-foreground text-sm mt-2">Run a test to preview the media items from your list.</p>
            </div>
        }
    </div>
</BbCard>

@code {

    [Parameter] public required FeedConfig Config { get; set; }
    [Parameter] public EventCallback<PreviewStatus> OnStatusChanged { get; set; }

    private enum FetchState { Idle, Loading, Success, Failed }

    private FetchState _fetchState = FetchState.Idle;
    private List<MediaLookup> _rawResults = [];
    private IReadOnlyList<MediaQueryRow> _unresolvedResults = [];
    private IReadOnlyList<QueryResult<MediaQueryRow>> _processedResults = [];
    private List<QueryResult<MediaQueryRow>> _filteredResults = [];
    private List<MediaQueryRow> _filteredUnresolvedResults = [];
    private FeedConfig? _appliedConfig;
    private CancellationTokenSource? _cts;
    private PreviewStatus _lastEmittedStatus = new();

    private string _searchQuery = string.Empty;
    private readonly HashSet<Func<QueryResult<MediaQueryRow>, bool>> _activeFilters = [];
    private string? _focusedResult;
    private MediaId? _togglingWatchlistItem;
    private MediaId? _togglingBlacklistItem;
    private readonly HashSet<MediaId> _watchlisted = new();
    private readonly HashSet<MediaId> _blacklistIds = new();
    private bool _hasEnrollmentChanges;
    private bool _refreshDialogOpen;
    private bool _providerUnavailable;
    private readonly Stopwatch _fetchTimer = new();

    private static readonly TimeSpan EarlySaveDelay = TimeSpan.FromSeconds(10);
    private const int EarlySaveMinItems = 100;

    private bool IsLoading => _fetchState == FetchState.Loading;
    private bool HasItems => _rawResults.Count > 0;
    private bool HasResults => _fetchState == FetchState.Success && _rawResults.Count > 0;
    private bool HasFailed => _fetchState == FetchState.Failed;
    private bool EarlySaveAllowed => IsLoading && _fetchTimer.Elapsed >= EarlySaveDelay && _rawResults.Count >= EarlySaveMinItems;

    protected override void OnParametersSet()
    {
        if (_fetchState is FetchState.Success or FetchState.Failed &&
            (Config.Provider != _appliedConfig?.Provider ||
             !string.Equals(Config.Identifier?.Trim(), _appliedConfig?.Identifier?.Trim(), StringComparison.Ordinal)))
        {
            _fetchState = FetchState.Idle;
            _rawResults = [];
            _unresolvedResults = [];
            _processedResults = [];
            _appliedConfig = null;
        }

        _ = EmitStatusIfChangedAsync();
    }

    public async Task ApplyAsync(FeedConfig config)
    {
        if (_fetchState == FetchState.Loading)
        {
            return;
        }

        Config = config;
        var needsFetch = _fetchState is FetchState.Idle or FetchState.Failed ||
                         Config.Provider != _appliedConfig?.Provider ||
                         !string.Equals(Config.Identifier?.Trim(), _appliedConfig?.Identifier?.Trim(), StringComparison.Ordinal);

        _appliedConfig = Config;

        if (needsFetch)
        {
            _fetchState = FetchState.Loading;
            _rawResults = [];
            _unresolvedResults = [];
            _processedResults = [];
            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);
            await FetchAsync();
        }
        else
        {
            await ReprocessAsync(CancellationToken.None);
        }

        await EmitStatusIfChangedAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RetryAsync()
    {
        _fetchState = FetchState.Idle;
        await ApplyAsync(Config);
    }

    private async Task OnRefreshConfirmedAsync()
    {
        if (_fetchState == FetchState.Loading || _rawResults.Count == 0)
        {
            return;
        }

        var staleIds = _rawResults.Where(r => r is not UnmatchedMedia).Select(r => r.Id).ToList();
        _refreshDialogOpen = false;
        _fetchState = FetchState.Loading;
        ClearResults();
        await RunRefreshAsync(staleIds);
    }

    private async Task RunRefreshAsync(IEnumerable<MediaId> staleIds)
    {
        await Task.Yield();

        try
        {

            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);

            await Media.InvalidateAsync(staleIds);

            await FetchAsync();
            await EmitStatusIfChangedAsync();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FetchAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        using var activity = Instrumentation.Source.StartActivity("FeedPreview", ActivityKind.Internal, default(ActivityContext));
        activity?.SetTag("sammlarr.feed.provider", Config.Provider?.ToString());
        activity?.SetTag("sammlarr.feed.identifier", Config.Identifier?.Trim());

        ClearResults();

        try
        {
            _watchlisted.Clear();
            _blacklistIds.Clear();
            await LoadWatchlistAndBlacklistAsync();

            var service = FeedServiceIndex[Config.Provider!.Value];
            _fetchTimer.Restart();
            var sw = Stopwatch.StartNew();
            await foreach (var item in service.GetFeedItemsAsync(Config.Identifier.Trim(), ct).WithCancellation(ct))
            {
                _rawResults.Add(item);
                if (sw.ElapsedMilliseconds >= 150)
                {
                    await ReprocessAsync(ct);
                    await EmitStatusIfChangedAsync();
                    await InvokeAsync(StateHasChanged);
                    sw.Restart();
                }
            }
            _fetchTimer.Stop();

            if (_rawResults.Count == 0)
            {
                _fetchState = FetchState.Failed;
                return;
            }

            _fetchState = FetchState.Success;
            await ReprocessAsync(ct);
            activity?.SetTag("sammlarr.feed.items", _rawResults.Count);
            Notifier.Info($"Loaded {_rawResults.Count} items in {FormatElapsed(_fetchTimer.Elapsed)}.");
        }
        catch (OperationCanceledException)
        {
            _rawResults = [];
            _unresolvedResults = [];
            _processedResults = [];
            _fetchState = FetchState.Idle;
        }
        catch (FeedIdentifierNotFoundException ex)
        {
            _rawResults = [];
            _unresolvedResults = [];
            _processedResults = [];
            _fetchState = FetchState.Failed;
            Notifier.Warning($"No list found with identifier '{ex.Identifier}'.", "List not found");
        }
        catch (ProviderUnavailableException)
        {
            _providerUnavailable = true;
            if (_rawResults.Count > 0)
            {
                _fetchState = FetchState.Success;
                await ReprocessAsync(ct);
                Notifier.Warning("The provider became unavailable before the full list loaded. Showing partial results — retry to load the rest.", "Provider unavailable");
            }
            else
            {
                _fetchState = FetchState.Failed;
                Notifier.Warning("The list provider is temporarily unavailable (rate-limited or unreachable). Try again in a moment.", "Provider unavailable");
            }
        }
        catch (Exception ex)
        {
            _rawResults = [];
            _unresolvedResults = [];
            _processedResults = [];
            _fetchState = FetchState.Failed;
            Notifier.Error(ex, "Failed to fetch media");
        }
    }
    private void ClearResults()
    {
        _rawResults = [];
        _unresolvedResults = [];
        _processedResults = [];
        _filteredResults = [];
        _filteredUnresolvedResults = [];
        _providerUnavailable = false;
    }

    private async Task ReprocessAsync(CancellationToken cancellationToken)
    {
        _hasEnrollmentChanges = false;

        if (_rawResults.Count == 0)
        {
            _unresolvedResults = [];
            _processedResults = [];
        }
        else
        {
            _unresolvedResults = _rawResults.Where(r => r is UnmatchedMedia).Select(MediaQueryRow.From).ToList();
            var resolvedItems = _rawResults.Where(r => r is not UnmatchedMedia).Select(MediaQueryRow.From).ToList();

            var applied = _appliedConfig ?? Config;
            var options = new QueryOptions
            {
                Sort = applied.Sort,
                Limit = applied.Limit,
                Filter = FilterDefinitionConverter.ToQueryFilter(applied.Filter),
            };
            _processedResults = resolvedItems.Count > 0
                ? await QueryProcessor.ExecuteAsync(resolvedItems, options, r => IsWatchlisted(r.Media), r => IsBlacklisted(r.Media), cancellationToken).ToListAsync(cancellationToken)
                : [];
        }

        RebuildFilteredViews();
    }

    private void OnSearchQueryChanged(string value)
    {
        _searchQuery = value;
        RebuildFilteredViews();
    }

    private void RebuildFilteredViews()
    {
        _filteredResults = _processedResults
            .Where(r => PreviewResultFilter.IsVisible(r, _activeFilters) && MatchesSearch(GetItem(r).Title))
            .ToList();
        _filteredUnresolvedResults = _unresolvedResults
            .Where(r => PreviewResultFilter.IsVisible(r, _activeFilters) && MatchesSearch(r.Media.Title))
            .ToList();
        RecountBadges();
    }

    private bool MatchesSearch(string title) =>
        string.IsNullOrWhiteSpace(_searchQuery) || title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase);

    private bool IsFilterActive(Func<QueryResult<MediaQueryRow>, bool> filter) => _activeFilters.Contains(filter);

    private void ToggleFilter(Func<QueryResult<MediaQueryRow>, bool> filter)
    {
        if (!_activeFilters.Add(filter))
        {
            _activeFilters.Remove(filter);
        }
        RebuildFilteredViews();
    }

    private void ResetFilters()
    {
        _activeFilters.Clear();
        RebuildFilteredViews();
    }

    private Task EmitStatusIfChangedAsync()
    {
        var status = BuildStatus();
        if (status == _lastEmittedStatus)
        {
            return Task.CompletedTask;
        }
        _lastEmittedStatus = status;
        return OnStatusChanged.InvokeAsync(status);
    }

    private PreviewStatus BuildStatus() => new()
    {
        IsLoading = IsLoading,
        HasResults = HasResults,
        HasFailed = HasFailed,
        HasEnrollmentChanges = _hasEnrollmentChanges,
        EarlySaveAllowed = EarlySaveAllowed,
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private static string FormatElapsed(TimeSpan elapsed) =>
        elapsed.TotalSeconds < 1 ? $"{elapsed.TotalMilliseconds:0} ms" : $"{elapsed.TotalSeconds:0.0} s";

    private async Task LoadWatchlistAndBlacklistAsync()
    {
        try
        {
            (await WatchlistService.GetWatchlistIdsAsync(CancellationToken.None)).ToList().ForEach(item => _watchlisted.Add(item));
            (await BlacklistService.GetBlacklistIdsAsync(CancellationToken.None)).ToList().ForEach(item => _blacklistIds.Add(item));
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to fetch media");
        }
    }

    private int IncludedCount { get; set; }
    private int BypassedCount { get; set; }
    private int FilteredCount { get; set; }
    private int SkippedCount { get; set; }
    private int UnresolvedCount => _unresolvedResults.Count;
    private int WatchlistCount { get; set; }
    private int BlacklistCount { get; set; }

    private void RecountBadges()
    {
        var included = 0;
        var bypassed = 0;
        var filtered = 0;
        var skipped = 0;
        var watchlisted = 0;
        var blacklisted = 0;

        foreach (var result in _processedResults)
        {
            if (result is MediaQueryRow)
            {
                included++;
            }
            else if (result is Bypassed<MediaQueryRow>)
            {
                bypassed++;
            }
            else if (result is Culled<MediaQueryRow>)
            {
                filtered++;
            }
            else if (result is Truncated<MediaQueryRow>)
            {
                skipped++;
            }

            var item = GetItem(result);
            if (IsWatchlisted(item))
            {
                watchlisted++;
            }

            if (IsBlacklisted(item))
            {
                blacklisted++;
            }
        }

        IncludedCount = included;
        BypassedCount = bypassed;
        FilteredCount = filtered;
        SkippedCount = skipped;
        WatchlistCount = watchlisted;
        BlacklistCount = blacklisted;
    }

    private bool IsBlacklisted(MediaLookup item) => _blacklistIds.Contains(item.Id);
    private bool IsWatchlisted(MediaLookup item) => _watchlisted.Contains(item.Id);

    private string BypassedTooltip(Bypassed<MediaQueryRow> bypassed)
    {
        var source = bypassed.Source switch
        {
            BypassReason.Watchlisted => "On your watchlist",
            BypassReason.Blacklisted => "On your blacklist",
        };
        if (Config.Limit is null)
            return $"{source}, will not be imported.";
        return bypassed.CountsTowardLimit ? $"{source}, skipped but counts toward your import limit." : $"{source}, skipped and does not count toward your import limit.";
    }

    private static MediaLookup GetItem(QueryResult<MediaQueryRow> result) =>
        (
            result switch
            {
                MediaQueryRow row => row,
                Bypassed<MediaQueryRow> e => e.Item,
                Truncated<MediaQueryRow> s => s.Item,
                Culled<MediaQueryRow> f => f.Item,
            }
        ).Media;

    private void ClearFocus(MediaLookup item)
    {
        if (_focusedResult == item.Key)
        {
            _focusedResult = null;
        }
    }

    private async Task ToggleBlacklistAsync(MediaLookup item)
    {
        if (_togglingBlacklistItem is not null)
        {
            return;
        }

        _togglingBlacklistItem = item.Id;
        try
        {
            if (_blacklistIds.Contains(item.Id))
            {
                await BlacklistService.RemoveFromBacklistAsync(item.Id);
                _blacklistIds.Remove(item.Id);
            }
            else
            {
                await BlacklistService.AddToBacklistAsync(item.Id);
                _blacklistIds.Add(item.Id);
            }
            _hasEnrollmentChanges = true;
        }
        catch (UnknownMediaException)
        {
            Notifier.Warning($"'{item.Title}' isn't ready yet — still loading.", "Can't update blacklist");
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to update blacklist");
        }
        finally
        {
            _togglingBlacklistItem = null;
            _focusedResult = null;
            RecountBadges();
            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleWatchlistAsync(MediaLookup item)
    {
        if (_togglingWatchlistItem is not null)
        {
            return;
        }

        _togglingWatchlistItem = item.Id;
        try
        {
            if (IsWatchlisted(item))
            {
                await WatchlistService.RemoveFromWatchlistAsync([item.Id]);
                _watchlisted.Remove(item.Id);
            }
            else
            {
                await WatchlistService.AddToWatchlistAsync([item.Id], new ManualOrigin(ManualSource.FeedPreview));
                _watchlisted.Add(item.Id);
            }
            _hasEnrollmentChanges = true;
        }
        catch (MissingWatchlistExternalIdException)
        {
            Notifier.Warning($"'{item.Title}' isn't ready yet — still loading.", "Can't update watchlist");
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to update watchlist");
        }
        finally
        {
            _togglingWatchlistItem = null;
            _focusedResult = null;
            RecountBadges();
            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);
        }
    }
}
