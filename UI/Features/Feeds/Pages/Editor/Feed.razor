@page "/feeds/create"
@page "/feeds/edit/{EditFeedId}"
@page "/feeds/clone/{CloneFeedId}"
@using Contracts.Auth
@using Contracts.Feed
@using global::Shared
@inject IFeedService FeedService
@inject NavigationManager NavigationManager
@inject IApiKeyService ApiKeyService
@inject AccountConnectionPrompt AccountConnectionPrompt
@inject Notifier Notifier
@inject DialogService DialogService

<PageTitle>@PageTitleText</PageTitle>

<KeyboardShortcut Keys="Ctrl+Enter" OnInvoked="OnShortcutActivatedAsync"/>

<SignInGuard AccessChanged="HandleSignInChangedAsync"/>

<PageContainer Heading="@PageHeadingText"
               Description="@PageDescriptionText"
               HeaderClass="@(IsSignedIn() ? "border-b" : "")">
    <HeaderActions>
        @if (_previewStatus.IsLoading || _isApplying)
        {
            @if (_previewStatus.EarlySaveAllowed && CanSave)
            {
                <BbTooltip>
                    <BbTooltipTrigger AsChild="true">
                        <HoverButton Preset="HoverButtonPreset.Success" OnClick="QuickSaveAsync" Disabled="_isSaving">
                            <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                            <span>Quick save</span>
                        </HoverButton>
                    </BbTooltipTrigger>
                    <BbTooltipContent>Saves the feed now without waiting for the preview to finish</BbTooltipContent>
                </BbTooltip>
            }
            else
            {
                <BbButton Variant="ButtonVariant.Default" Disabled="true">
                    <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                    <span>@(_isApplying && !_previewStatus.IsLoading ? "Applying…" : "Testing…")</span>
                </BbButton>
            }
        }
        else if (ShowApplyButton)
        {
            <BbButton Variant="ButtonVariant.Default"
                      OnClick="() => ApplyAsync()"
                      Disabled="!_config.IsTestable">
                <LucideIcon Name="check" Size="14" Class="mr-2"/>
                Apply
            </BbButton>
        }
        else if (ShowSaveButton)
        {
            <HoverButton Preset="HoverButtonPreset.Success"
                         Icon="save"
                         Text="Save"
                         OnClick="HandleSaveAsync"
                         Disabled="!CanSave"/>
        }
        else if (_previewStatus.HasFailed)
        {
            <HoverButton Preset="HoverButtonPreset.Destructive"
                         Icon="rotate-cw"
                         Text="Retry"
                         OnClick="() => ApplyAsync()"
                         Disabled="!_config.IsTestable"/>
        }
        else if (ShowTestButton)
        {
            <BbButton Variant="ButtonVariant.Default"
                      OnClick="() => ApplyAsync()"
                      Disabled="!_config.IsTestable">
                <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                Test
            </BbButton>
        }

        <HoverButton Preset="HoverButtonPreset.Destructive"
                     Text="Cancel"
                     OnClick="ReturnAsync"
                     Disabled="@(_previewStatus.IsLoading || _isSaving || _isApplying)"/>
    </HeaderActions>
    <ChildContent>
        <ProtectedSection GuardState="IsSignedIn"
                          DeniedActionDescription="managing feeds"
                          FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
            @if (_loadingFeed)
            {
                <div class="flex-1 min-h-0 flex flex-row gap-4 overflow-hidden" aria-busy="true">
                    <BbSkeleton Class="flex-1 min-w-0 rounded-lg"/>
                    <BbSkeleton Class="flex-1 min-w-0 rounded-lg"/>
                </div>
            }
            else
            {
                <div class="flex-1 min-h-0 flex flex-row gap-4 overflow-hidden" @onkeydown="HandleContainerKeyDownAsync">

                    <FeedConfigPanel @key="_configKey"
                                     Value="@_config"
                                     IsLoading="@(_previewStatus.IsLoading || _isApplying)"
                                     OnChange="@OnConfigChanged"/>

                    <FeedPreviewPanel @ref="_previewPanel"
                                      Config="@_config"
                                      SavedFeedId="@_savedFeedId"
                                      OnStatusChanged="@OnPreviewStatusChanged"/>

                </div>
            }
        </ProtectedSection>
    </ChildContent>
</PageContainer>

@code {

    [Parameter] public string? EditFeedId { get; set; }
    [Parameter] public string? CloneFeedId { get; set; }
    private bool IsEditOrClone => EditFeedId is not null || CloneFeedId is not null;

    private string PageTitleText =>
        EditFeedId is not null ? "Edit feed"
        : CloneFeedId is not null ? "Clone feed"
        : "Create feed";
    private string PageHeadingText => PageTitleText;
    private string PageDescriptionText =>
        EditFeedId is not null ? "Update an existing feed and keep your sync settings in sync."
        : CloneFeedId is not null ? "Create a new feed using values copied from an existing one."
        : "Subscribe to a list from an external provider as a feed.";

    private bool _loadingFeed;
    private bool _isSignedIn;
    private bool IsSignedIn() => _isSignedIn;

    private FeedConfig _config = new();
    private int? _storedHash;
    private int _appliedHash;
    private FeedId? _savedFeedId;
    private FeedStrategy _storedStrategy = new(new Append());

    private bool _isSaving;
    private bool _isApplying;
    private bool _pendingAutoApply;
    private PreviewStatus _previewStatus = new();
    private FeedPreviewPanel _previewPanel = null!;

    private int _configKey;

    private bool HasChanged => _storedHash is null || _config.GetSaveHash() != _storedHash;
    private bool HasPendingChanges => _config.GetPreviewHash() != _appliedHash;

    private bool CanSave => _config.IsValid && (_previewStatus.HasResults || _previewStatus.EarlySaveAllowed) && HasChanged;

    private bool ShowTestButton => !_previewStatus.HasResults && !_previewStatus.IsLoading && !_isSaving;
    private bool ShowApplyButton => _previewStatus.HasResults && HasPendingChanges && !_isSaving;
    private bool ShowSaveButton => _previewStatus.HasResults && !HasPendingChanges && !_isSaving;

    private void OnPreviewStatusChanged(PreviewStatus status) => _previewStatus = status;
    private void OnConfigChanged(FeedConfig config)
    {
        _config = config;
        StateHasChanged();
    }

    private Task HandleSignInChangedAsync(bool hasAccess)
    {
        _isSignedIn = hasAccess;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!IsEditOrClone)
        {
            return;
        }

        _loadingFeed = true;
        await Task.Yield();

        var sourceId = FeedId.From(UrlGuid.Decode(EditFeedId ?? CloneFeedId));
        await (await FeedService.GetAsync())
            .Find(sourceId)
            .Map(overview => overview.Feed)
            .ApplyNone(() => NavigationManager.NavigateTo("/feeds"))
            .Apply(LoadConfigAsync);
    }

    private async Task LoadConfigAsync(Domain.Feed.Feed feed)
    {
        _config = new FeedConfig
        {
            Name = feed.Name.Trim(),
            IsEnabled = feed.Enabled,
            Provider = feed.Provider,
            Strategy = feed.Strategy,
            Identifier = feed.Identifier.Trim(),
            Filter = FilterDefinitionConverter.FromQueryFilter(feed.Filter.ToNullable()),
            Sort = feed.Sort.ToNullable(),
            Limit = feed.Limit.ToNullable(),
            Schedule = feed.Schedule,
            IsProviderAvailable = await ApiKeyService.GetAsync(feed.Provider.AsApiKeyProvider()).IsSuccess(),
        };
        _storedHash = _config.GetSaveHash();
        _storedStrategy = _config.Strategy;
        if (EditFeedId is not null)
        {
            _savedFeedId = feed.Id;
        }
        _configKey++;
        _pendingAutoApply = true;
        _loadingFeed = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingAutoApply)
        {
            _pendingAutoApply = false;
            if (_config.IsTestable)
            {
                await ApplyAsync();
            }
        }
    }

    private async Task OnShortcutActivatedAsync()
    {
        if (_previewStatus.IsLoading || _isSaving)
        {
            return;
        }

        if (ShowSaveButton && CanSave)
        {
            await HandleSaveAsync();
        }
        else if (ShowApplyButton && _config.IsTestable)
        {
            await ApplyAsync();
        }
        else if (ShowTestButton && _config.IsTestable)
        {
            await ApplyAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyAsync()
    {
        _isApplying = true;
        StateHasChanged();
        try
        {
            var applied = _config;
            await _previewPanel.ApplyAsync(applied);
            _appliedHash = applied.GetPreviewHash();
        }
        finally
        {
            _isApplying = false;
            StateHasChanged();
        }
    }

    private Task ReturnAsync()
    {
        NavigationManager.NavigateTo("/feeds");
        return Task.CompletedTask;
    }

    private Task HandleSaveAsync() => CanSave ? SaveAsync() : Task.CompletedTask;

    private async Task<bool> ConfirmMirrorSwitchAsync()
    {
        if (!MirrorSwitch.NeedsConfirmation(_storedStrategy, _config.Strategy, _previewStatus.MirrorExposure) || _config.Strategy is not Mirror mirror)
        {
            return true;
        }

        var result = await DialogService.ConfirmAsync(
            MirrorSwitch.Heading,
            MirrorSwitch.Warning(_previewStatus.MirrorExposure, mirror.AbsenceThreshold),
            new ConfirmDialogOptions { ConfirmText = MirrorSwitch.Confirm, Destructive = true }
        );
        return result.Confirmed;
    }

    private async Task SaveAsync()
    {
        if (!await ConfirmMirrorSwitchAsync())
        {
            return;
        }

        _isSaving = true;

        try
        {
            await PersistAsync(navigate: true);
        }
        catch (OperationCanceledException) {}
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to save feed");
            _isSaving = false;
        }
    }

    private async Task QuickSaveAsync()
    {
        if (!CanSave || _isSaving || !await ConfirmMirrorSwitchAsync())
        {
            return;
        }

        _isSaving = true;
        try
        {
            await PersistAsync(navigate: false);
            Notifier.Info("Feed saved.");
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to save feed");
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PersistAsync(bool navigate)
    {
        if (_savedFeedId is { } id)
        {
            await FeedService.UpdateAsync(id, BuildUpdateData(), CancellationToken.None);
        }
        else
        {
            _savedFeedId = await FeedService.CreateAsync(BuildCreateData(), CancellationToken.None);
        }

        _storedHash = _config.GetSaveHash();

        if (navigate)
        {
            NavigationManager.NavigateTo("/feeds");
        }
    }

    private FeedUpdateData BuildUpdateData() =>
        new()
        {
            Name = _config.Name.Trim(),
            IsEnabled = _config.IsEnabled,
            Provider = _config.Provider!.Value,
            Strategy = _config.Strategy,
            Identifier = _config.Identifier.Trim(),
            Filter = Optional.Of(FilterDefinitionConverter.ToQueryFilter(_config.Filter)),
            Sort = Optional.Of(_config.Sort),
            Limit = Optional.Of(_config.Limit),
            Schedule = _config.Schedule,
        };

    private FeedCreateData BuildCreateData() =>
        new()
        {
            Name = _config.Name.Trim(),
            IsEnabled = _config.IsEnabled,
            Provider = _config.Provider!.Value,
            Strategy = _config.Strategy,
            Identifier = _config.Identifier.Trim(),
            Filter = Optional.Of(FilterDefinitionConverter.ToQueryFilter(_config.Filter)),
            Sort = Optional.Of(_config.Sort),
            Limit = Optional.Of(_config.Limit),
            Schedule = _config.Schedule,
        };

    private Task HandleContainerKeyDownAsync(KeyboardEventArgs args)
    {
        return args is { CtrlKey: true, Key: "Enter" } ? OnShortcutActivatedAsync() : Task.CompletedTask;
    }

}
