@page "/feeds"
@implements IDisposable
@using Contracts.Announcing
@using Contracts.Feed
@using Contracts.Identity
@using Contracts.Jobs
@using Contracts.Media
@using Contracts.Settings
@using Domain.Announcing
@using Domain.Feed.Run
@using Domain.Identity
@using Domain.Jobs
@using Domain.Media
@using global::Shared
@using UI.Features.Feeds.Components
@using UI.Shared.Announcing
@using UI.Shared.Changes
@using UI.Shared.Media
@inject IFeedService FeedService
@inject NavigationManager NavigationManager
@inject IProviderConfigService ProviderConfigService
@inject AccountConnectionPrompt AccountConnectionPrompt
@inject IJobQueue JobQueue
@inject IFeedRunPlanner Planner
@inject ICurrentUser CurrentUser
@inject Notifier Notifier
@inject IMediaService Media
@inject IEventPublisher Events
@inject IJobQueueView JobQueueView

<PageTitle>Feeds</PageTitle>

<SignInGuard AccessChanged="HandleSignInChangedAsync"/>

<PageContainer Heading="Feeds" Fill="true">
    <DescriptionContent>
        @if (_feeds.Count > 0)
        {
            <FeedStatusLine Rows="_rows" Added="_lastWeek.Added" Removed="_lastWeek.Removed" Now="_now"/>
        }
        else
        {
            <span>Subscribe to media lists from supported providers to get started.</span>
        }
    </DescriptionContent>
    <HeaderActions>
        <ProtectedSection GuardState="IsSignedIn" ShowFallback="false">
            <div class="flex items-center gap-2">
                @if (_feeds.Count > 0)
                {
                    <ListSearch Value="@_filter.Search" ValueChanged="ApplySearch" Placeholder="Search feeds"/>
                }
                <MediaListViewActions HasItems="_feeds.Count > 0"
                                      IsEditMode="_isSelecting"
                                      ShowFilters="_showFilters"
                                      ActiveFilters="_filter.ActiveCount"
                                      OnEnterEditMode="() => _isSelecting = true"
                                      OnToggleFilters="() => _showFilters = !_showFilters"/>
                <BbButton Variant="ButtonVariant.Secondary" OnClick="@(() => NavigationManager.NavigateTo("/feeds/create"))">
                    <LucideIcon Name="plus" Size="15" Class="mr-2.5 shrink-0"/>
                    Add feed
                </BbButton>
            </div>
        </ProtectedSection>
    </HeaderActions>
    <ChildContent>
        <ProtectedSection GuardState="IsSignedIn"
                          DeniedActionDescription="managing your feeds"
                          FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
            @if (_isLoading)
            {
                <div class="feeds-grid">
                    @for (var index = 0; index < 8; index++)
                    {
                        <BbSkeleton Class="h-[188px] rounded-[11px]"/>
                    }
                </div>
            }
            else if (_feeds.Count == 0)
            {
                <MediaListEmptyState Icon="rss" Heading="No feeds yet.">
                    Feeds sync titles from lists on MDBList or TMDb into your library, by hand or on a schedule.
                </MediaListEmptyState>
            }
            else
            {
                @if (_showFilters)
                {
                    <FeedFilterBar Filter="_filter" FilterChanged="ApplyFilter" Providers="ProviderCounts" Shown="_visible.Count" Total="_rows.Count"/>
                }

                @if (_isSelecting)
                {
                    <BulkActionBar SelectedCount="_selection.Count"
                                   PageCount="PageRows.Count"
                                   ListCount="_visible.Count"
                                   OnSelectPage="() => _selection.SelectAll(PageRows.Select(row => row.Feed.Id))"
                                   OnSelectList="() => _selection.SelectAll(_visible.Select(row => row.Feed.Id))"
                                   OnClearSelection="_selection.Clear"
                                   OnExit="ExitSelecting">
                        <Actions>
                            <HoverButton Preset="HoverButtonPreset.Custom"
                                         Color="var(--foreground)"
                                         Size="ButtonSize.Small"
                                         Class="min-w-24 justify-center"
                                         OnClick="OpenBulkRun"
                                         Disabled="@(!Chosen.Any(row => row.Feed.Enabled && !row.IsBusy))">
                                <LucideIcon Name="play" Size="14" Class="mr-1"/>
                                <span>Run</span>
                            </HoverButton>
                            @if (Chosen.Count > 0 && Chosen.All(row => !row.Feed.Enabled))
                            {
                                <HoverButton Preset="HoverButtonPreset.Custom"
                                             Color="var(--alert-warning)"
                                             Size="ButtonSize.Small"
                                             Class="min-w-24 justify-center"
                                             OnClick="ResumeAsync">
                                    <LucideIcon Name="play" Size="14" Class="mr-1"/>
                                    <span>Resume</span>
                                </HoverButton>
                            }
                            else
                            {
                                <HoverButton Preset="HoverButtonPreset.Custom"
                                             Color="var(--alert-warning)"
                                             Size="ButtonSize.Small"
                                             Class="min-w-24 justify-center"
                                             OnClick="() => _confirm = FeedsConfirm.Pause"
                                             Disabled="@(!Chosen.Any(row => row.Feed.Enabled))">
                                    <LucideIcon Name="pause" Size="14" Class="mr-1"/>
                                    <span>Pause</span>
                                </HoverButton>
                            }
                            <HoverButton Preset="HoverButtonPreset.Destructive"
                                         Size="ButtonSize.Small"
                                         Class="min-w-24 justify-center"
                                         OnClick="() => AskDelete(Chosen)"
                                         Disabled="@(Chosen.Count == 0)">
                                <LucideIcon Name="trash-2" Size="14" Class="mr-1"/>
                                <span>Delete</span>
                            </HoverButton>
                        </Actions>
                    </BulkActionBar>
                }

                @if (_visible.Count == 0)
                {
                    <MediaListEmptyState Icon="filter-x" Heading="Nothing matches these filters.">
                        @_rows.Count feeds are hidden. Clear the filters to see them.
                    </MediaListEmptyState>
                }
                else
                {
                    <div class="feeds-grid">
                        @foreach (var row in PageRows)
                        {
                            <FeedCard @key="row.Feed.Id"
                                      Row="row"
                                      Now="_now"
                                      RunVersion="_runVersion"
                                      RunDisabled="_isPreviewing"
                                      IsSelecting="_isSelecting"
                                      IsSelected="_selection.Contains(row.Feed.Id)"
                                      OnToggleSelect="@(args => _selection.Click(row.Feed.Id, args.ShiftKey, [.. PageRows.Select(page => page.Feed.Id)]))"
                                      OnRun="() => RunFeedAsync(row.Feed)"
                                      OnDelete="() => AskDelete([row])"/>
                        }
                    </div>

                    <PaginationControls CurrentPage="_currentPage"
                                        TotalPages="FeedPaging.PageCount(_visible.Count)"
                                        IsDisabled="_isLoading"
                                        PageChanged="page => _currentPage = page"/>
                }
            }
        </ProtectedSection>
    </ChildContent>
</PageContainer>

<ChangeDialog Open="_confirmOpen"
              OnOpenChanged="HandleConfirmOpenChanged"
              Title="@($"Run \"{_pendingFeed?.Name}\" now?")"
              Subtitle="@(_pendingPlan is {} loaded ? FeedRunView.Pending(loaded) : null)"
              Loading="_isPreviewing"
              Items="_pendingItems"
              Chips="_pendingChips"
              OnSelect="ShowDetailsAsync"
              EmptyMessage="This run would change nothing."
              RemovedLabel="Removing"
              AddedLabel="Adding"
              Band="@(_pendingPlan is {} failing && FeedRunView.Problem(failing) is {} problem ? PlanProblemBand(failing, problem) : null)"
              BandTone="ChangeBandTone.Bad">
    <Badges>
        @if (_pendingFeed is {} pending)
        {
            <FeedStrategyChip Strategy="pending.Strategy"/>
        }
        @if (_pendingPlan is {} badged && badged.Conclusiveness is not Conclusiveness.Conclusive)
        {
            <FeedChip Tone="FeedChipTone.Attention" Icon="shield">Guarded</FeedChip>
        }
    </Badges>
    <Actions>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => _confirmOpen = false)">Cancel</BbButton>
        <BbButton Size="ButtonSize.Small" Disabled="@(_pendingPlan is null)" OnClick="ConfirmRunAsync">
            <LucideIcon Name="play" Size="13" Class="mr-1.5"/>
            Run now
        </BbButton>
    </Actions>
</ChangeDialog>

<RunFeedsDialog Open="_isRunOpen"
                OpenChanged="@(open => _isRunOpen = open)"
                Candidates="_candidates"
                Pending="PendingFeeds"
                Now="_now"
                ProviderName="@ProviderName"
                Selection="_selection.Keys"
                OnRun="RunFeedsAsync"/>

@if (_confirm is { } confirm)
{
    <BbAlertDialog Open="true" OpenChanged="@(open => { if (!open) { _confirm = null; } })">
        <BbAlertDialogContent>
            <BbAlertDialogHeader>
                <BbAlertDialogTitle>@ConfirmTitle(confirm)</BbAlertDialogTitle>
                <BbAlertDialogDescription>@ConfirmBody(confirm)</BbAlertDialogDescription>
            </BbAlertDialogHeader>
            <BbAlertDialogFooter>
                <BbAlertDialogCancel>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="() => _confirm = null">Cancel</BbButton>
                </BbAlertDialogCancel>
                @if (confirm is FeedsConfirm.Pause)
                {
                    <HoverButton Preset="HoverButtonPreset.Custom" Color="var(--alert-warning)" OnClick="PauseAsync">
                        <LucideIcon Name="pause" Size="15" Class="mr-1"/>
                        <span>Pause</span>
                    </HoverButton>
                }
                else
                {
                    <HoverButton Preset="HoverButtonPreset.Destructive" OnClick="DeleteAsync">
                        <LucideIcon Name="trash-2" Size="15" Class="mr-1"/>
                        <span>Delete</span>
                    </HoverButton>
                }
            </BbAlertDialogFooter>
        </BbAlertDialogContent>
    </BbAlertDialog>
}

<MediaDetailSheet Open="_selected is not null"
                  OnOpenChanged="@(open => {
                                     if (!open) { _selected = null; }
                                 })"
                  Media="_selected"
                  OnEnrollmentChanged="@(_ => HandleEnrollmentChangedAsync())"/>

@code {
    private enum FeedsConfirm
    {
        Pause,
        Delete,
    }

    private static readonly TimeSpan LastWeek = TimeSpan.FromDays(7);
    private const int RunCap = 1000;

    private readonly CancellationTokenSource _cancellation = new();
    private readonly Dictionary<FeedId, JobState> _feedJobs = [];
    private readonly BulkSelection<FeedId> _selection = new();

    private ProviderConfig? _providerConfig;
    private bool _isSignedIn;
    private UserId? _viewer;
    private DateTimeOffset _now = DateTimeOffset.Now;

    private IReadOnlyList<FeedOverview> _feeds = [];
    private IReadOnlyList<FeedRow> _rows = [];
    private IReadOnlyList<FeedRow> _visible = [];
    private IReadOnlyList<RunCandidate> _candidates = [];
    private (int Added, int Removed) _lastWeek;
    private FeedFilter _filter = FeedFilter.None;
    private bool _showFilters;
    private bool _isSelecting;
    private bool _isRunOpen;
    private FeedsConfirm? _confirm;
    private IReadOnlyList<FeedRow> _deleting = [];

    private bool _isLoading = true;
    private int _currentPage = 1;
    private int _runVersion;
    private bool _confirmOpen;
    private bool _isPreviewing;
    private Feed? _pendingFeed;
    private IFeedPlan? _pendingPlan;
    private IReadOnlyList<ChangeItem> _pendingItems = [];
    private IReadOnlyList<ChangeChip> _pendingChips = [];
    private MediaLookup? _selected;

    private bool IsSignedIn() => _isSignedIn;

    private IReadOnlyList<FeedRow> PageRows => FeedPaging.Slice(_visible, FeedPaging.PageWithin(_currentPage, _visible.Count));

    private IReadOnlyList<FeedRow> Chosen => [.. _visible.Where(row => _selection.Contains(row.Feed.Id))];

    private IReadOnlySet<FeedId> PendingFeeds => _feedJobs.Keys.ToHashSet();

    private IReadOnlyList<ProviderCount> ProviderCounts => FeedPulse.Providers(_rows);

    private string ProviderName => _providerConfig is null ? "your media service" : _providerConfig.Sink.GetDescription();

    protected override async Task OnInitializedAsync()
    {
        Events.Published += OnEvent;
        await Task.Yield();
        _providerConfig = await ProviderConfigService.GetAsync();
        await LoadAsync();
        _isLoading = false;
    }

    private async Task LoadAsync()
    {
        _now = DateTimeOffset.Now;
        await LoadQueueAsync();
        _feeds = (await FeedService.GetAsync(_cancellation.Token)).Feeds;
        _lastWeek = FeedPulse.Moved(await FeedService.GetRunsAsync(RunQuery.Take(RunCap) with { Since = Some.Of(_now - LastWeek) }, _cancellation.Token));
        Rebuild();
    }

    private void Rebuild()
    {
        _rows = [.. _feeds.Select(overview => FeedRow.Of(overview, _feedJobs, _now, TimeZoneInfo.Local))];
        _visible = _filter.Apply(_rows);
        _candidates = RunPlan.Candidates(_feeds, _now, TimeZoneInfo.Local);
    }

    private async Task LoadQueueAsync()
    {
        var queue = await JobQueueView.GetAsync(_cancellation.Token);
        _feedJobs.Clear();
        foreach (var job in queue.Jobs)
        {
            if (job.Request is RunFeed(var id, _, _) && job.State is JobState.Waiting or JobState.Queued or JobState.Running)
            {
                _feedJobs[id] = job.State;
            }
        }
    }

    private void ApplyFeedJob(JobStateChangedEvent job)
    {
        var id = FeedId.From(Guid.Parse(job.Key));
        if (job.State is JobState.Waiting or JobState.Queued or JobState.Running)
        {
            _feedJobs[id] = job.State;
        }
        else
        {
            _feedJobs.Remove(id);
        }

        Rebuild();
    }

    private Task HandleSignInChangedAsync(bool hasAccess)
    {
        _isSignedIn = hasAccess;
        _viewer = hasAccess ? CurrentUser.Id : null;
        return Task.CompletedTask;
    }

    private void ApplyFilter(FeedFilter filter)
    {
        _filter = filter;
        _currentPage = 1;
        _visible = _filter.Apply(_rows);
    }

    private void ApplySearch(string? search) => ApplyFilter(_filter with { Search = search });

    private void ExitSelecting()
    {
        _selection.Clear();
        _isSelecting = false;
    }

    private void OpenBulkRun()
    {
        _now = DateTimeOffset.Now;
        _candidates = RunPlan.Candidates(_feeds, _now, TimeZoneInfo.Local);
        _isRunOpen = true;
    }

    private async Task RunFeedsAsync((IReadOnlyList<FeedId> Feeds, bool SyncAfter) plan)
    {
        ExitSelecting();
        try
        {
            Notifier.Info(await FeedRunQueue.EnqueueAsync(JobQueue, plan.Feeds, plan.SyncAfter, _cancellation.Token), null);
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "The feeds could not be queued");
        }
    }

    private async Task ResumeAsync()
    {
        await FeedService.ResumeAsync([.. Chosen.Select(row => row.Feed.Id)], _cancellation.Token);
        ExitSelecting();
        await LoadAsync();
    }

    private async Task PauseAsync()
    {
        _confirm = null;
        await FeedService.PauseAsync([.. Chosen.Select(row => row.Feed.Id)], _cancellation.Token);
        ExitSelecting();
        await LoadAsync();
    }

    private void AskDelete(IReadOnlyList<FeedRow> rows)
    {
        _deleting = rows;
        _confirm = FeedsConfirm.Delete;
    }

    private async Task DeleteAsync()
    {
        _confirm = null;
        foreach (var row in _deleting)
        {
            await FeedService.DeleteAsync(row.Feed.Id, _cancellation.Token);
        }

        _deleting = [];
        ExitSelecting();
        await LoadAsync();
    }

    private string ConfirmTitle(FeedsConfirm confirm) =>
        confirm switch
        {
            FeedsConfirm.Pause => Chosen.Count(row => row.Feed.Enabled) switch
            {
                1 => "Pause 1 feed?",
                var pausing => $"Pause {pausing} feeds?",
            },
            FeedsConfirm.Delete => _deleting.Count == 1 ? $"Delete \"{_deleting[0].Feed.Name}\"?" : $"Delete {_deleting.Count} feeds?",
        };

    private string ConfirmBody(FeedsConfirm confirm) =>
        confirm switch
        {
            FeedsConfirm.Pause => "Paused feeds skip their schedule and can't be run until you resume them. Titles they already put on your wantlist stay there."
                + AlreadyPaused(),
            FeedsConfirm.Delete => _deleting.Count == 1
                ? "This permanently removes the feed. Titles it put on your wantlist stay there. This can't be undone."
                : "This permanently removes them. Titles they put on your wantlist stay there. This can't be undone.",
        };

    private string AlreadyPaused() =>
        Chosen.Count(row => !row.Feed.Enabled) switch
        {
            0 => string.Empty,
            1 => " 1 of your selection is already paused.",
            var paused => $" {paused} of your selection are already paused.",
        };

    public void Dispose()
    {
        Events.Published -= OnEvent;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }

    private void OnEvent(IEvent raised)
    {
        if (ViewerEvent.Own<JobStateChangedEvent>(raised, _viewer) is { Kind: JobKind.FeedRun } job)
        {
            _ = InvokeAsync(() =>
            {
                ApplyFeedJob(job);
                StateHasChanged();
            });
            return;
        }

        if (ViewerEvent.Own<FeedRunFinishedEvent>(raised, _viewer) is {})
        {
            _ = InvokeAsync(RefreshAfterRunAsync);
        }
    }

    private async Task RefreshAfterRunAsync()
    {
        _runVersion++;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task RunFeedAsync(Feed feed)
    {
        if (_isPreviewing)
        {
            return;
        }

        _pendingFeed = feed;
        _confirmOpen = true;
        await LoadPreviewAsync(feed);
    }

    private async Task LoadPreviewAsync(Feed feed)
    {
        _pendingPlan = null;
        _pendingItems = [];
        _pendingChips = [];
        _isPreviewing = true;
        StateHasChanged();

        try
        {
            switch (await Planner.PlanAsync(new SavedFeed(feed.Id)))
            {
                case IFeedPlan plan:
                    await FillConfirmAsync(plan);
                    break;
                case FeedPlanFailed failed:
                    _confirmOpen = false;
                    Notifier.Warning(failed.ToString(), null);
                    break;
            }
        }
        catch (Exception ex)
        {
            _confirmOpen = false;
            Notifier.Error(ex, $"'{feed.Name}' could not be previewed");
        }
        finally
        {
            _isPreviewing = false;
        }
    }

    private async Task HandleEnrollmentChangedAsync()
    {
        if (_pendingFeed is {} feed && _confirmOpen)
        {
            await LoadPreviewAsync(feed);
        }
    }

    private async Task FillConfirmAsync(IFeedPlan summary)
    {
        var media = new Dictionary<MediaId, IdentifiedMedia>();
        foreach (var verdict in summary.Verdicts)
        {
            media[verdict.Item.Identity.Id] = verdict.Item;
        }

        var missing = summary.Delta.Drops.Where(id => !media.ContainsKey(id)).ToList();
        foreach (var (id, detail) in await Media.GetDetailsByIdAsync(missing))
        {
            media[id] = detail;
        }

        _pendingPlan = summary;
        _pendingItems = FeedRunView.Items(summary, media);
        _pendingChips = FeedRunView.Chips(FeedRunCounts.From(summary));
    }

    private static RenderFragment PlanProblemBand(IFeedPlan plan, string problem) =>
        @<RunProblem Headline="@problem" Reason="@plan.SourceFailure" Failed="true"/>;

    private Task ShowDetailsAsync(IdentifiedMedia media)
    {
        _selected = media;
        return Task.CompletedTask;
    }

    private void HandleConfirmOpenChanged(bool open)
    {
        _confirmOpen = open;
        if (!open)
        {
            _selected = null;
        }
    }

    private async Task ConfirmRunAsync()
    {
        if (_pendingFeed is not {} feed)
        {
            return;
        }

        _confirmOpen = false;
        try
        {
            switch (await JobQueue.EnqueueAsync(new RunFeed(feed.Id, new Manual())))
            {
                case Queued:
                    Notifier.Info($"'{feed.Name}' has been queued", null);
                    break;
                case AlreadyQueued:
                    Notifier.Info($"'{feed.Name}' is already queued", null);
                    break;
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, $"'{feed.Name}' could not run");
        }
    }
}
