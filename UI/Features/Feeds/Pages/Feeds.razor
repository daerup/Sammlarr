@page "/feeds"
@implements IDisposable
@using Contracts.Feed
@using Contracts.Media
@using Contracts.Identity
@using Contracts.Watchlist
@using Contracts.Jobs
@using Contracts.Announcing
@using Domain.Announcing
@using Domain.Identity
@using Domain.Jobs
@using Domain.Feed.Run
@using Contracts.Settings
@using global::Shared
@using Domain.Media
@using UI.Features.Feeds.Components
@using UI.Shared.Announcing
@using UI.Shared.Changes
@using UI.Shared.Media
@using UI.Shared.Services.Branding
@inject IFeedService FeedService
@inject NavigationManager NavigationManager
@inject MediaProviderBrandingService MediaProviderBrandingService
@inject IProviderConfigRepository ProviderConfigRepository
@inject AccountConnectionPrompt AccountConnectionPrompt
@inject IJobQueue JobQueue
@inject IFeedRunPlanner Planner
@inject ICurrentUser CurrentUser
@inject Notifier Notifier
@inject IMediaService Media
@inject IWatchlistRepository Watchlist
@inject IEventPublisher Events
@inject IJobQueueView JobQueueView

<PageTitle>Feeds</PageTitle>

<SignInGuard AccessChanged="HandleSignInChangedAsync"/>

<PageContainer Heading="@PageHeading" Description="@PageDescription">
    <HeaderActions>
        <BbButton Variant="ButtonVariant.Secondary" OnClick="@(() => NavigationManager.NavigateTo("/feeds/create"))">
            <LucideIcon Name="plus" Size="15" Class="mr-2.5 shrink-0"/>
            Add New
        </BbButton>
    </HeaderActions>
    <ChildContent>
        <ProtectedSection GuardState="IsSignedIn"
                          DeniedActionDescription="managing your feeds"
                          FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
            @if (!_isLoading && _feeds.Count == 0)
            {
                <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-4">
                    <LucideIcon Name="list-plus" Size="40" Class="mx-auto text-muted-foreground"/>
                    <p class="text-muted-foreground">Feeds let you sync titles from providers like MDBList or TMDb into your Sammlarr library
                        automatically.</p>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="NavigateToCreateFeed">
                        <LucideIcon Name="plus" Size="15" Class="mr-2 shrink-0"/>
                        Add
                    </BbButton>
                </div>
            }
            else
            {
                <div class="feeds-table">
                    <BbDataTable TData="Feed"
                                 Data="@_pagedFeeds"
                                 IsLoading="@_isLoading"
                                 ShowToolbar="true"
                                 ShowPagination="false"
                                 AriaLabel="Feeds">
                        <Columns>
                            <BbDataTableColumn TData="Feed" TValue="string"
                                               Header="Name"
                                               Property="@(l => l.Name)"
                                               Sortable="true"
                                               Filterable="true">
                                <CellTemplate Context="feed">
                                    <span class="feed-name" title="@feed.Name">@feed.Name</span>
                                </CellTemplate>
                            </BbDataTableColumn>

                            <BbDataTableColumn TData="Feed" TValue="FeedProvider"
                                               Header="Provider"
                                               Property="@(l => l.Provider)"
                                               Sortable="true">
                                <CellTemplate Context="feed">
                                    @{
                                        var branding = MediaProviderBrandingService.GetBrandingInfo(feed.Provider.AsMediaProvider());
                                    }
                                    <BbTooltip>
                                        <BbTooltipTrigger AsChild="false" Class="inline-flex">
                                            <span class="shrink-0 flex items-center" aria-label="@branding.DisplayName">@branding.Icon</span>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>@branding.DisplayName</BbTooltipContent>
                                    </BbTooltip>
                                </CellTemplate>
                            </BbDataTableColumn>

                            <BbDataTableColumn TData="Feed" TValue="string"
                                               Header="List ID"
                                               Property="@(l => l.Identifier)"
                                               Filterable="true">
                                <CellTemplate Context="feed">
                                <span class="feed-ident" title="@feed.Identifier">
                                    <FeedSourceLink Identifier="@feed.Identifier" Provider="@feed.Provider"/>
                                </span>
                                </CellTemplate>
                            </BbDataTableColumn>

                            <BbDataTableColumn TData="Feed" TValue="bool"
                                               Header="Status"
                                               Property="@(l => l.Enabled)"
                                               Sortable="true">
                                <CellTemplate Context="feed">
                                    @if (feed.Enabled)
                                    {
                                        <BbBadge Class="bg-success">Enabled</BbBadge>
                                    }
                                    else
                                    {
                                        <BbBadge Variant="BadgeVariant.Destructive">Disabled</BbBadge>
                                    }
                                </CellTemplate>
                            </BbDataTableColumn>

                            <BbDataTableColumn TData="Feed" TValue="string"
                                               Header="Strategy"
                                               Property="@(l => l.Strategy.ToString())"
                                               Sortable="true">
                                <CellTemplate Context="feed">
                                    <BbBadge Variant="BadgeVariant.Secondary">
                                        @(feed.Strategy is Mirror ? "Mirror" : "Append")
                                    </BbBadge>
                                </CellTemplate>
                            </BbDataTableColumn>

                            <BbDataTableColumn TData="Feed" TValue="string"
                                               Header="Trigger"
                                               Property="@(l => l.Schedule is Scheduled ? "Scheduled" : "Manual")"
                                               Sortable="true">
                                <CellTemplate Context="feed">
                                    @if (feed.Schedule is Scheduled scheduled)
                                    {
                                        <BbPopover>
                                            <BbPopoverTrigger AsChild="false" aria-label="Schedule details" class="inline-flex cursor-pointer">
                                                <BbBadge Variant="BadgeVariant.Secondary">
                                                    <LucideIcon Name="clock" Size="12" Class="mr-1 shrink-0"/>
                                                    Scheduled
                                                </BbBadge>
                                            </BbPopoverTrigger>
                                            <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Class="w-72 overflow-hidden p-0">
                                                <div class="border-b px-3 py-2 text-xs font-medium text-muted-foreground">Schedule</div>
                                                <div class="flex flex-col gap-1.5 px-3 py-2 text-xs">
                                                    <div class="flex items-center justify-between gap-3">
                                                        <span class="text-muted-foreground">Expression</span>
                                                        <code class="rounded bg-muted px-1.5 py-0.5 tabular-nums">@scheduled.ToString()</code>
                                                    </div>
                                                    <div class="flex items-center justify-between gap-3">
                                                        <span class="text-muted-foreground">Next run</span>
                                                        <span class="tabular-nums">@NextRunLabel(scheduled)</span>
                                                    </div>
                                                </div>
                                            </BbPopoverContent>
                                        </BbPopover>
                                    }
                                    else
                                    {
                                        <BbBadge Variant="BadgeVariant.Outline">
                                            <LucideIcon Name="hand" Size="12" Class="mr-1 shrink-0"/>
                                            Manual
                                        </BbBadge>
                                    }
                                </CellTemplate>
                            </BbDataTableColumn>

                            <BbDataTableColumn TData="Feed" TValue="int"
                                               Header="On watchlist"
                                               Property="@(l => OwnedBy(l))"
                                               Sortable="true">
                                <CellTemplate Context="feed">
                                    @if (!_overviews.ContainsKey(feed.Id))
                                    {
                                        <span class="feed-owned is-none">—</span>
                                    }
                                    else if (OwnedBy(feed) is > 0 and var owned)
                                    {
                                        <a class="feed-owned feed-owned-link"
                                           href="@($"/watchlist?feed={UrlGuid.Encode(feed.Id.Value)}")"
                                           title="@($"Show the {owned} titles this feed put on your watchlist")">@owned</a>
                                    }
                                    else
                                    {
                                        <span class="feed-owned is-none">0</span>
                                    }
                                </CellTemplate>
                            </BbDataTableColumn>

                            <BbDataTableColumn TData="Feed" TValue="string"
                                               Header="Last run">
                                <CellTemplate Context="feed">
                                    <LastRunCell @key="(feed.Id, _runVersion)" FeedId="feed.Id" Overview="@_overviews.GetValueOrDefault(feed.Id)"/>
                                </CellTemplate>
                            </BbDataTableColumn>

                            <BbDataTableColumn TData="Feed" TValue="string"
                                               Header=""
                                               CellClass="feeds-actions-cell">
                                <CellTemplate Context="feed">
                                    <div class="flex items-center justify-end gap-1">
                                        <BbTooltip>
                                            <BbTooltipTrigger>
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Run now"
                                                          Disabled="@(Pending(feed.Id) is not null || _isPreviewing)"
                                                          OnClick="@(() => RunFeedAsync(feed))">
                                                    @switch (Pending(feed.Id))
                                                    {
                                                        case JobState.Running:
                                                            <BbSpinner Size="SpinnerSize.Small"/>
                                                            break;
                                                        case JobState.Queued:
                                                            <LucideIcon Name="clock" Size="15"/>
                                                            break;
                                                        default:
                                                            <LucideIcon Name="play" Size="15"/>
                                                            break;
                                                    }
                                                </BbButton>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>@RunLabel(feed.Id)</BbTooltipContent>
                                        </BbTooltip>
                                        <BbTooltip>
                                            <BbTooltipTrigger AsChild="false" Class="inline-flex" Focusable="false">
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Run history"
                                                          Href="@($"/feeds/{UrlGuid.Encode(feed.Id.Value)}/runs")">
                                                    <LucideIcon Name="history" Size="15"/>
                                                </BbButton>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>Run history</BbTooltipContent>
                                        </BbTooltip>
                                        <BbTooltip>
                                            <BbTooltipTrigger AsChild="false" Class="inline-flex" Focusable="false">
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit"
                                                          Href="@($"/feeds/edit/{UrlGuid.Encode(feed.Id.Value)}")">
                                                    <LucideIcon Name="pencil" Size="15"/>
                                                </BbButton>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>Edit</BbTooltipContent>
                                        </BbTooltip>
                                        <BbTooltip>
                                            <BbTooltipTrigger AsChild="false" Class="inline-flex" Focusable="false">
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Duplicate"
                                                          Href="@($"/feeds/clone/{UrlGuid.Encode(feed.Id.Value)}")">
                                                    <LucideIcon Name="copy" Size="15"/>
                                                </BbButton>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>Duplicate</BbTooltipContent>
                                        </BbTooltip>
                                        <BbAlertDialog>
                                            <BbAlertDialogTrigger>
                                                <BbTooltip>
                                                    <BbTooltipTrigger>
                                                        <HoverButton Preset="HoverButtonPreset.Destructive"
                                                                     Icon="trash-2"
                                                                     Size="ButtonSize.Icon"
                                                                     AriaLabel="Delete"
                                                                     Border="false"/>
                                                    </BbTooltipTrigger>
                                                    <BbTooltipContent>Delete</BbTooltipContent>
                                                </BbTooltip>
                                            </BbAlertDialogTrigger>
                                            <BbAlertDialogContent>
                                                <BbAlertDialogHeader>
                                                    <BbAlertDialogTitle>Delete "@feed.Name"?</BbAlertDialogTitle>
                                                    <BbAlertDialogDescription>
                                                        This will permanently remove the feed. This action cannot be undone.
                                                    </BbAlertDialogDescription>
                                                </BbAlertDialogHeader>
                                                <BbAlertDialogFooter>
                                                    <BbAlertDialogCancel>
                                                        <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                                                    </BbAlertDialogCancel>
                                                    <BbAlertDialogAction>
                                                        <HoverButton Preset="HoverButtonPreset.Destructive"
                                                                     Text="Delete"
                                                                     OnClick="@(() => DeleteFeedAsync(feed.Id))"/>
                                                    </BbAlertDialogAction>
                                                </BbAlertDialogFooter>
                                            </BbAlertDialogContent>
                                        </BbAlertDialog>
                                    </div>
                                </CellTemplate>
                            </BbDataTableColumn>
                        </Columns>
                    </BbDataTable>
                </div>

                <PaginationControls CurrentPage="_currentPage"
                                    TotalPages="_totalPages"
                                    IsDisabled="_isLoading"
                                    PageChanged="HandlePageChangedAsync"/>
            }
        </ProtectedSection>
    </ChildContent>
</PageContainer>

<ChangeDialog Open="_confirmOpen"
              OnOpenChanged="HandleConfirmOpenChanged"
              Title="@($"Run \"{_pendingFeed?.Name}\" now?")"
              Subtitle="@(_pendingPlan is {} loaded ? FeedRunView.Pending(loaded) : null)"
              Loading="_isPreviewing"
              Entries="_pendingEntries"
              Chips="_pendingChips"
              OnSelect="ShowDetailsAsync"
              EmptyMessage="This run would change nothing."
              RemovedLabel="Removing"
              AddedLabel="Adding">
    <Badges>
        @if (_pendingFeed is {} pending)
        {
            <BbBadge Variant="BadgeVariant.Secondary">@(pending.Strategy is Mirror ? "Mirror" : "Append")</BbBadge>
        }
        @if (_pendingPlan is {} badged && badged.Conclusiveness is not Conclusiveness.Conclusive)
        {
            <BbBadge Variant="BadgeVariant.Secondary">Guarded</BbBadge>
        }
    </Badges>
    <Actions>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => _confirmOpen = false)">Cancel</BbButton>
        <BbButton Size="ButtonSize.Small" Disabled="@(_pendingPlan is null)" OnClick="ConfirmRunAsync">
            <LucideIcon Name="play" Size="13" Class="mr-1.5"/>
            Run now
        </BbButton>
    </Actions>
</ChangeDialog>

<MediaDetailSheet Open="_selected is not null"
                  OnOpenChanged="@(open => {
                                     if (!open) { _selected = null; }
                                 })"
                  Media="_selected"
                  OnEnrollmentChanged="@(_ => HandleEnrollmentChangedAsync())"/>

@code {
    private string PageHeading => "Feeds";
    private string PageDescription => "Subscribe to media lists from supported providers to get started.";

    private ProviderConfig _providerConfig = null!;
    private bool _isSignedIn;
    private UserId? _viewer;
    private bool IsSignedIn() => _isSignedIn;

    private IReadOnlyList<Feed> _feeds = [];
    private IReadOnlyDictionary<FeedId, int> _owned = new Dictionary<FeedId, int>();
    private IReadOnlyDictionary<FeedId, FeedOverview> _overviews = new Dictionary<FeedId, FeedOverview>();

    private int OwnedBy(Feed feed) => _owned.GetValueOrDefault(feed.Id);

    private IReadOnlyList<Feed> _pagedFeeds = [];
    private bool _isLoading = true;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private readonly Dictionary<FeedId, JobState> _feedJobs = [];
    private int _runVersion;
    private bool _confirmOpen;
    private bool _isPreviewing;
    private Feed? _pendingFeed;
    private IFeedPlan? _pendingPlan;
    private IReadOnlyList<ChangeEntry> _pendingEntries = [];
    private IReadOnlyList<ChangeChip> _pendingChips = [];
    private MediaLookup? _selected;

    protected override async Task OnInitializedAsync()
    {
        Events.Published += OnEvent;
        await LoadQueueAsync();
        _providerConfig = await ProviderConfigRepository.GetAsync();
        _feeds = await FeedService.GetFeedsAsync();
        _owned = await Watchlist.GetOwnedCountsAsync();
        _overviews = await FeedService.GetOverviewsAsync();
        UpdatePagedFeeds();
        _isLoading = false;
    }

    private async Task LoadQueueAsync()
    {
        var queue = await JobQueueView.GetAsync();
        _feedJobs.Clear();
        foreach (var job in queue.Jobs)
        {
            if (job.Request is RunFeed(var id, _, _))
            {
                _feedJobs[id] = job.State;
            }
        }
    }

    private void ApplyFeedJob(JobStateChangedEvent job)
    {
        var id = FeedId.From(Guid.Parse(job.Key));
        if (job.State is JobState.Queued or JobState.Running)
        {
            _feedJobs[id] = job.State;
            return;
        }

        _feedJobs.Remove(id);
    }

    private JobState? Pending(FeedId id) => _feedJobs.TryGetValue(id, out var state) ? state : null;

    private string RunLabel(FeedId id) =>
        Pending(id) switch
        {
            JobState.Running => "Running now",
            JobState.Queued => "Waiting in the queue",
            _ => "Run now",
        };

    private Task HandleSignInChangedAsync(bool hasAccess)
    {
        _isSignedIn = hasAccess;
        _viewer = hasAccess ? CurrentUser.Id : null;
        return Task.CompletedTask;
    }

    private static string NextRunLabel(Scheduled scheduled) =>
        scheduled.NextRun(DateTimeOffset.UtcNow, TimeZoneInfo.Local) is {} next ? next.ToString("MMMM d, yyyy HH:mm") : "Never";

    private void NavigateToCreateFeed()
    {
        NavigationManager.NavigateTo("/feeds/create");
    }

    private void UpdatePagedFeeds()
    {
        _totalPages = FeedPaging.PageCount(_feeds.Count);
        _currentPage = FeedPaging.PageWithin(_currentPage, _feeds.Count);
        _pagedFeeds = FeedPaging.Slice(_feeds, _currentPage);
    }

    private async Task DeleteFeedAsync(FeedId id)
    {
        await FeedService.DeleteFeedAsync(id);
        _feeds = await FeedService.GetFeedsAsync();
        UpdatePagedFeeds();
    }

    public void Dispose() => Events.Published -= OnEvent;

    private void OnEvent(IEvent raised)
    {
        if (ViewerEvent.Own<JobStateChangedEvent>(raised, _viewer) is { Kind: JobKind.FeedRun } job)
        {
            ApplyFeedJob(job);
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        if (ViewerEvent.Own<FeedRunFinishedEvent>(raised, _viewer) is {})
        {
            _ = InvokeAsync(RefreshAfterRunAsync);
        }
    }

    private async Task RefreshAfterRunAsync()
    {
        _runVersion++;
        _owned = await Watchlist.GetOwnedCountsAsync();
        _overviews = await FeedService.GetOverviewsAsync();
        StateHasChanged();
    }

    private async Task RunFeedAsync(Feed feed)
    {
        if (_isPreviewing)
        {
            return;
        }

        _pendingFeed = feed;
        _confirmOpen = true;
        await LoadPreviewAsync(feed);
    }

    private async Task LoadPreviewAsync(Feed feed)
    {
        _pendingPlan = null;
        _pendingEntries = [];
        _pendingChips = [];
        _isPreviewing = true;
        StateHasChanged();

        try
        {
            switch (await Planner.PlanAsync(new SavedFeed(feed.Id)))
            {
                case IFeedPlan plan:
                    await FillConfirmAsync(plan);
                    break;
                case FeedPlanFailed failed:
                    _confirmOpen = false;
                    Notifier.Warning(failed.ToString(), null);
                    break;
            }
        }
        catch (Exception ex)
        {
            _confirmOpen = false;
            Notifier.Error(ex, $"'{feed.Name}' could not be previewed");
        }
        finally
        {
            _isPreviewing = false;
        }
    }

    private async Task HandleEnrollmentChangedAsync()
    {
        if (_pendingFeed is {} feed && _confirmOpen)
        {
            await LoadPreviewAsync(feed);
        }
    }

    private async Task FillConfirmAsync(IFeedPlan summary)
    {
        var media = new Dictionary<MediaId, MediaLookup>();
        foreach (var verdict in summary.Verdicts)
        {
            media[verdict.Item.Identity.Id] = verdict.Item;
        }

        var missing = summary.Delta.Drops.Where(id => !media.ContainsKey(id)).ToList();
        await foreach (var detail in Media.GetDetailsAsync(missing).WhereSuccessAwait())
        {
            media[detail.Id] = detail.ToMatch();
        }

        _pendingPlan = summary;
        _pendingEntries = FeedRunView.Entries(summary, media);
        _pendingChips = FeedRunView.Chips(FeedRunCounts.From(summary));
    }

    private Task ShowDetailsAsync(MediaLookup media)
    {
        _selected = media;
        return Task.CompletedTask;
    }

    private void HandleConfirmOpenChanged(bool open)
    {
        _confirmOpen = open;
        if (!open)
        {
            _selected = null;
        }
    }

    private async Task ConfirmRunAsync()
    {
        if (_pendingFeed is not {} feed)
        {
            return;
        }

        _confirmOpen = false;
        try
        {
            switch (await JobQueue.EnqueueAsync(new RunFeed(feed.Id, new Manual())))
            {
                case Queued:
                    Notifier.Info($"'{feed.Name}' has been queued", null);
                    break;
                case AlreadyQueued:
                    Notifier.Info($"'{feed.Name}' is already queued", null);
                    break;
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, $"'{feed.Name}' could not run");
        }
    }


    private async Task HandlePageChangedAsync(int newPage)
    {
        _currentPage = newPage;
        UpdatePagedFeeds();
        await Task.CompletedTask;
    }
}
