@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

<AppLink Href="@Url" External="true" Muted="Muted" Title="@($"Open on {Branding.NickName(Provider.Service)}")" Class="@($"min-w-0 max-w-full {Class ?? "text-sm"}")">
    <span class="min-w-0 truncate font-mono">@Identifier</span>
</AppLink>

@code {
    [Parameter] [EditorRequired]
    public string Identifier { get; set; } = string.Empty;

    [Parameter] [EditorRequired]
    public FeedProvider Provider { get; set; }

    [Parameter]
    public bool Muted { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string Url => FeedSources.Of(Provider).Page(Identifier);
}
