@{
    var url = GetProviderUrl(Identifier, Provider);
}

@if (url is not null)
{
    <BbTooltip>
        <BbTooltipTrigger AsChild="false" Class="inline-flex min-w-0 max-w-full" Focusable="false">
            <a href="@url" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1 min-w-0 max-w-full font-mono text-sm text-primary underline-offset-4 hover:underline">
                <span class="min-w-0 truncate">@Identifier</span>
                <LucideIcon Name="external-link" Size="12" Class="shrink-0 opacity-60"/>
            </a>
        </BbTooltipTrigger>
        <BbTooltipContent>Open on @ProviderName</BbTooltipContent>
    </BbTooltip>
}
else
{
    <span class="block truncate font-mono text-sm">@Identifier</span>
}

@code {
    [Parameter] [EditorRequired]
    public string Identifier { get; set; } = string.Empty;

    [Parameter] [EditorRequired]
    public FeedProvider Provider { get; set; }

    private string ProviderName =>
        Provider switch
        {
            FeedProvider.Mdblist => "MDBList",
            FeedProvider.Tmdb => "TMDB",
        };

    private static string GetProviderUrl(string identifier, FeedProvider provider) =>
        provider switch
        {
            FeedProvider.Mdblist => $"https://mdblist.com/lists/{identifier}",
            FeedProvider.Tmdb => $"https://www.themoviedb.org/list/{identifier}",
        };
}
