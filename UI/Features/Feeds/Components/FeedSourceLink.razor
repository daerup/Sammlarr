@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

<AppLink Href="@Url" External="true" Muted="Muted" Title="@($"Open on {Branding.GetBrandingInfo(Provider.AsMediaProvider()).NickName}")" Class="@($"min-w-0 max-w-full {Class ?? "text-sm"}")">
    <span class="min-w-0 truncate font-mono">@Identifier</span>
</AppLink>

@code {
    [Parameter] [EditorRequired]
    public string Identifier { get; set; } = string.Empty;

    [Parameter] [EditorRequired]
    public FeedProvider Provider { get; set; }

    [Parameter]
    public bool Muted { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string Url =>
        Provider switch
        {
            FeedProvider.Mdblist => $"https://mdblist.com/lists/{Identifier}",
            FeedProvider.Tmdb => $"https://www.themoviedb.org/list/{Identifier}",
        };
}
