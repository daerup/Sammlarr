@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

<div class="feed-provider-select">
    <BbSelect TValue="FeedProvider?" Value="@Value" ValueChanged="@ValueChanged" Class="w-54">
        <BbSelectTrigger Class="provider-trigger" style="@BrandStyle(Value)">
            @if (Value is { } selected)
            {
                <span class="flex min-w-0 items-center gap-2">
                    <ProviderTile Provider="@selected.AsMediaProvider()" Size="22" Decorative="true"/>
                    <span class="truncate">@Brand(selected).NickName</span>
                </span>
            }
            else
            {
                <span class="font-normal text-muted-foreground">No provider available</span>
            }
        </BbSelectTrigger>
        <BbSelectContent>
            @foreach (var provider in Providers)
            {
                var available = !Unavailable.Contains(provider);
                <BbSelectItem Value="@((FeedProvider?)provider)" Text="@Brand(provider).NickName" Disabled="@(!available)"
                              Class="isolate bg-transparent data-[focused=true]:bg-transparent data-[disabled=true]:opacity-100 [&>.truncate]:flex-1">
                    <span class="provider-wash" style="@BrandStyle(provider)"></span>
                    <span class="flex items-center gap-2.5">
                        <span class="@(available ? "flex" : "flex grayscale opacity-45")">
                            <ProviderTile Provider="@provider.AsMediaProvider()" Size="22" Decorative="true"/>
                        </span>
                        <span class="@NameClass(provider, available)">@Brand(provider).NickName</span>
                        @if (!available)
                        {
                            <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideIcon Name="key-round" Size="12"/>
                                No API key
                            </span>
                        }
                    </span>
                </BbSelectItem>
            }
            @if (Unavailable.Count > 0)
            {
                <div class="-mx-1 my-1 h-px bg-border"></div>
                <div class="flex items-center gap-2 px-2 py-1.5 text-xs text-muted-foreground">
                    <LucideIcon Name="key-round" Size="13"/>
                    <span>
                        @(Providers.All(Unavailable.Contains) ? "No keys set." : "Missing a key?")
                        <a href="/settings?section=providers" class="font-medium text-foreground underline underline-offset-3">Open API keys</a>
                    </span>
                </div>
            }
        </BbSelectContent>
    </BbSelect>
</div>

@code {
    [Parameter] public FeedProvider? Value { get; set; }

    [Parameter] public EventCallback<FeedProvider?> ValueChanged { get; set; }

    [Parameter] public IReadOnlyCollection<FeedProvider> Unavailable { get; set; } = [];

    private static readonly FeedProvider[] Providers = Enum.GetValues<FeedProvider>();

    private BrandingInfo Brand(FeedProvider provider) => Branding.GetBrandingInfo(provider.AsMediaProvider());

    private string? BrandStyle(FeedProvider? provider) => provider is { } brand ? $"--brand: {Brand(brand).BrandColor}" : null;

    private string NameClass(FeedProvider provider, bool available) =>
        !available ? "flex-1 text-muted-foreground"
        : provider == Value ? "flex-1 font-semibold"
        : "flex-1";
}
