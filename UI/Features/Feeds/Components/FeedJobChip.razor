@using Domain.Jobs

@if (Job.IsRunning)
{
    <FeedChip Tone="FeedChipTone.Attention"><span class="feed-chip-dot"></span>Running</FeedChip>
}
else if (Job.IsQueued)
{
    <FeedChip Tone="FeedChipTone.Quiet" Icon="hourglass">Queued</FeedChip>
}

@code {
    [Parameter] public Optional<JobState> Job { get; set; } = new None();
}
