@using System.Globalization
@using Domain.Feed.Run
@using Domain.Feed.Trace
@using Domain.Processing
@using Microsoft.JSInterop
@using UI.Shared.Services.Branding
@using global::Shared
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject MediaProviderBrandingService Branding

<section class="live feed-live feed-live-fold @Class" @ref="_root" data-testid="feed-run-live" aria-label="@($"Live run of {Run.Feed.Name}")">
    <div class="live-head">
        <div class="live-top">
            @foreach (var brand in Branding.Brands(Run.Feed.Provider.Service))
            {
                <BrandedTile Brand="brand" Size="30" Decorative="true"/>
            }
            <div class="live-name">
                <b title="@Run.Feed.Name">@Run.Feed.Name</b>
                <span class="live-route">
                    @Branding.Name(Run.Feed.Provider.Service)
                    <LucideIcon Name="arrow-right" Size="12"/>
                    @foreach (var brand in Branding.Brands(Run.Layout.Sink.Service))
                    {
                        <BrandedTile Brand="brand" Size="14" Decorative="true"/>
                    }
                    @Branding.NickName(Run.Layout.Sink.Service)
                    @if (Run.Layout.Targets.Count > 0)
                    {
                        <span class="live-needs">· needs @string.Join(" and ", Run.Layout.Targets.Select(target => target.GetDescription())) ids</span>
                    }
                </span>
            </div>
            <div class="live-meta">
                @Tally.Ended.Match(Ended, () => Running)
                <span class="live-clock" data-testid="live-clock">@Clock</span>
                <span data-testid="live-count"><b>@Count(Tally.Done)</b> @Of</span>
                <a class="live-link" href="@($"/feeds/{UrlGuid.Encode(Run.Feed.Id.Value)}/runs")">Run history</a>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ToggleAsync" data-testid="live-toggle">
                    <LucideIcon Name="@(Run.Hidden ? "chevron-down" : "chevron-up")" Size="14" Class="mr-1"/>
                    @(Run.Hidden ? "Show" : "Hide")
                </BbButton>
            </div>
        </div>
        <div class="live-bar" data-testid="live-bar">
            @foreach (var part in Tally.Bar)
            {
                <i style="@Width(Tally.Count(part), RunBar.Color(part))" data-part="@part"></i>
            }
            <i class="is-flight" style="@Width(Tally.InFlight, null)"></i>
        </div>
        <div class="live-legend" data-testid="live-legend">
            @foreach (var part in Tally.Legend)
            {
                @LegendEntry(RunBar.Label(part), RunBar.Meaning(part, Branding.NickName(Run.Layout.Sink.Service)), Tally.Count(part), $"background: {RunBar.Color(part)}", null)
            }
            @LegendEntry("In flight", RunBar.InFlightMeaning, Tally.InFlight, null, "is-flight")
        </div>
    </div>
    <div class="live-body" @ref="_body" hidden="@Run.Hidden" data-testid="live-body"></div>
    <div class="live-foot" hidden="@Run.Hidden" data-testid="live-foot">
        @Tally.Ended.When(end => end.Ending is TraceEnding.Completed).Map(end => end.Counts).Match(Rules, () => Reading)
    </div>
    @if (Flash > 0)
    {
        <span class="live-flash" @key="Flash" aria-hidden="true"></span>
    }
</section>

@code {
    private const string ModulePath = "./js/feed-live.js";

    [Parameter, EditorRequired] public required ILiveRun Run { get; set; }

    [Parameter] public EventCallback OnFolded { get; set; }

    [Parameter] public int Flash { get; set; }

    [Parameter] public string? Class { get; set; }

    private ElementReference _root;
    private ElementReference _body;
    private IJSObjectReference? _module;
    private bool _mounted;
    private bool _mounting;
    private bool _disposed;
    private Optional<Guid> _mountedKey = new None();
    private List<WireBatch>? _buffer;

    private RunTally Tally => Run.Tally;

    private string Clock => Tally.Ended.Match(end => FeedRunView.Took(TimeSpan.FromMilliseconds(end.ElapsedMs)), () => Elapsed(Tally.ElapsedMs));

    private string Of => Tally.Total.Match(total => $"of {(Tally.Estimated ? "~" : "")}{Count(total)}", () => Tally.Done == 1 ? "title" : "titles");

    protected override void OnInitialized()
    {
        Run.Batch += OnBatch;
        Run.Folded += OnRunFolded;
        if (Run.HasFolded)
        {
            OnRunFolded();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await LoadAsync();
            if (_disposed)
            {
                await ReleaseAsync();
                return;
            }
        }

        await SyncAsync();
    }

    private async Task<IJSObjectReference?> LoadAsync()
    {
        try
        {
            return await Js.InvokeAsync<IJSObjectReference>("import", ModulePath);
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task SyncAsync()
    {
        if (_disposed || _module is null || _mounting)
        {
            return;
        }

        if (_mounted && (Run.Hidden || !Current(_mountedKey)))
        {
            _mounted = false;
            await CallAsync("dispose", _body);
        }

        if (!_mounted && !Run.Hidden && !_disposed)
        {
            await MountAsync();
        }
    }

    private async Task MountAsync()
    {
        _mounting = true;
        _buffer = [];
        try
        {
            var snapshot = await Run.SnapshotAsync();
            await snapshot.When(found => !_disposed && Current(found.Cursor.Run)).Match(ShowAsync, () => Task.CompletedTask);
        }
        finally
        {
            _buffer = null;
            _mounting = false;
        }
    }

    private async Task ShowAsync(TraceSnapshot snapshot)
    {
        var layout = LiveWire.Layout(Run.Layout, Branding, file => Assets[$"_content/UI/providers/{file}"]);
        await CallAsync("mount", _body, layout, LiveWire.Snapshot(snapshot));
        _mounted = true;
        _mountedKey = snapshot.Cursor.Run;
        for (var index = 0; index < _buffer!.Count && !_disposed; index++)
        {
            await CallAsync("push", _body, _buffer[index]);
        }
    }

    private bool Current(Optional<Guid> key) => Run.TraceKey.Match(trace => key.Match(seen => seen == trace, () => false), () => true);

    private void OnBatch(WireBatch batch) => _ = InvokeAsync(() => PushAsync(batch));

    private async Task PushAsync(WireBatch batch)
    {
        if (_disposed)
        {
            return;
        }

        if (_buffer is not null)
        {
            _buffer.Add(batch);
        }
        else if (_mounted && Current(_mountedKey))
        {
            await CallAsync("push", _body, batch);
        }

        StateHasChanged();
    }

    private void OnRunFolded() => _ = InvokeAsync(FoldAsync);

    private async Task FoldAsync()
    {
        if (_module is not null && !_disposed)
        {
            await CallAsync("fold", _root);
        }

        await OnFolded.InvokeAsync();
    }

    private Task ToggleAsync()
    {
        if (Run.Hidden)
        {
            Run.Show();
        }
        else
        {
            Run.Hide();
        }

        return Task.CompletedTask;
    }

    private async Task CallAsync(string identifier, params object[] args)
    {
        try
        {
            await _module!.InvokeVoidAsync(identifier, args);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Run.Batch -= OnBatch;
        Run.Folded -= OnRunFolded;
        await ReleaseAsync();
    }

    private async Task ReleaseAsync()
    {
        if (_module is null)
        {
            return;
        }

        await CallAsync("dispose", _body);
        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    private string Width(int count, string? color)
    {
        var background = color is null ? "" : $"; background: {color}";
        return string.Create(CultureInfo.InvariantCulture, $"width: {Tally.Percent(count):0.###}%{background}");
    }

    private static string Elapsed(int ms)
    {
        var seconds = Math.Max(0, ms / 1000);
        return string.Create(CultureInfo.InvariantCulture, $"{seconds / 60}:{seconds % 60:00}");
    }

    private static string Count(int count) => count.ToString("N0", CultureInfo.InvariantCulture);

    private static readonly RenderFragment Nothing = _ => { };

    private RenderFragment Reading =>
        @<span class="live-foot-main">
            @Tally.Progress.Reading.Match(ReadingPage, () => Nothing)
            @Tally.Progress.Busiest.Match(WaitingOn, () => Idle)
        </span>;

    private static RenderFragment ReadingPage(int page) => @<span>Reading page <b>@Count(page)</b> of the list</span>;

    private RenderFragment Idle => Tally.Ended.Match(_ => Nothing, () => Tally.Progress.Reading.Match(_ => Nothing, () => Tally.Fates.Started > 0 ? Flowing : Nothing));

    private static RenderFragment Flowing => @<span>Titles flowing</span>;

    private RenderFragment WaitingOn(ServiceWait wait) =>
        @<span>
            <b>@Count(wait.Waiting)</b> waiting on @Branding.Name(wait.Service)@if (Tally.RateLimited)
            {
                @(" ")<span class="k429">(rate-limited)</span>
            }
        </span>;

    private RenderFragment Rules(FeedRunCounts counts) =>
        @<span class="live-foot-main">
            @if (counts.Added > 0)
            {
                <span><b class="is-added">+@Count(counts.Added)</b> added to your wantlist</span>
            }
            else
            {
                <span><b>@Count(counts.Kept)</b> kept, nothing new</span>
            }
            <span><b>@Count(counts.Filtered)</b> didn't pass the feed's filters</span>
            @Run.Feed.Limit.Match(limit => Past(counts, limit), () => Nothing)
        </span>;

    private static RenderFragment Past(FeedRunCounts counts, QueryLimit limit) =>
        @<span><b>@Count(counts.Skipped)</b> over this run's limit of @Count(limit.Count)</span>;

    private static RenderFragment LegendEntry(string label, string meaning, int count, string? style, string? swatch) =>
        @<BbTooltip DelayDuration="150">
            <BbTooltipTrigger AsChild="false">
                <span data-testid="live-legend-entry"><i class="sq @swatch" style="@style"></i>@label <b>@Count(count)</b></span>
            </BbTooltipTrigger>
            <BbTooltipContent Class="w-[280px] border bg-popover px-3 py-2.5 text-xs text-muted-foreground shadow-lg">
                <b class="mb-0.5 block font-semibold text-foreground">@label</b>
                @meaning
            </BbTooltipContent>
        </BbTooltip>;

    private static RenderFragment Added(int added) => @<span class="added-chip" data-testid="live-added">+@Count(added) to your wantlist</span>;

    private RenderFragment Running => @<FeedChip Tone="FeedChipTone.Running"><span class="feed-chip-dot"></span>Running</FeedChip>;

    private RenderFragment Ended(FeedRunEnd end)
    {
        return end.Ending switch
        {
            TraceEnding.Failed => @<FeedChip Tone="FeedChipTone.Failed" Icon="cloud-off">Failed</FeedChip>,
            TraceEnding.Completed => @<span class="live-done" data-testid="live-done">
                <LucideIcon Name="check" Size="13"/>Done
                @end.Counts.When(counts => counts.Added > 0).Match(counts => Added(counts.Added), () => Nothing)
            </span>,
        };
    }
}
