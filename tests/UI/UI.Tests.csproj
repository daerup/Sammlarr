<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Bogus" />
		<PackageReference Include="bunit" />
		<PackageReference Include="CsCheck" />
		<PackageReference Include="TUnit" />
		<PackageReference Include="TUnit.Assertions" />
		<PackageReference Include="TUnit.Core" />
		<PackageReference Include="TUnit.Mocks" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\src\UI\UI.csproj" />
		<ProjectReference Include="..\TestInfrastructure\TestInfrastructure.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Update="Branding\BirdReference.json" CopyToOutputDirectory="PreserveNewest" />
		<None Update="Settings\About\third-party-notices.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<Compile Remove="Settings\DemoRenderTests.cs" />
		<Compile Remove="Settings\TestingSectionTests.cs" />
	</ItemGroup>
</Project>
