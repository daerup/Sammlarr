<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]"/>
    <!-- BlazorBlueprint themes -->
    <link href="@Assets["_content/BlazorBlueprint.Components/css/themes.css"]" rel="stylesheet"/>
    <!-- BlazorBlueprint component styles -->
    <link href="@Assets["_content/BlazorBlueprint.Components/blazorblueprint.css"]" rel="stylesheet"/>
    <!-- Theme CSS variable overrides - must load after BlazorBlueprint to take precedence -->
    <link href="@Assets["styles/themes/default.css"]" rel="stylesheet"/>
    <!-- App styles (Tailwind utilities for template pages) -->
    <link href="@Assets["css/app.css"]" rel="stylesheet"/>
    <!-- Blazor CSS isolation bundle (scoped CSS bundles into the host app) -->
    <link href="@Assets["Web.styles.css"]" rel="stylesheet"/>
    <HeadOutlet @rendermode="InteractiveServer"/>
</head>
<body class="font-sans antialiased">
<Routes @rendermode="InteractiveServer"/>

<div id="blazor-error-ui" class="hidden fixed bottom-0 left-0 right-0 z-50 p-4 bg-destructive text-destructive-foreground">
    An error has occurred. This application may no longer respond until reloaded.
    <a href="" class="underline">Reload</a>
</div>

<!-- Preload Floating UI for positioning (Select, Popover, etc.) -->
<script type="module">
    import * as FloatingUI from 'https://cdn.jsdelivr.net/npm/@@floating-ui/dom@@1.5.3/+esm';

    window.FloatingUIDOM = FloatingUI;
</script>

<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="@Assets["js/nav-underline.js"]"></script>
<script src="@Assets["js/notification-template.js"]"></script>
<script src="@Assets["js/scroll.js"]"></script>
<script src="@Assets["js/tooltip-guard.js"]"></script>
<script type="module" src="@Assets["js/diagnostics.js"]"></script>
</body>
</html>
