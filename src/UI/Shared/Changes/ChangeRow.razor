@using Contracts.Media.Artwork
@inject ArtworkSources Artwork

<div @ref="_root"
     class="change-row @(Item.Kind is ChangeKind.Removed ? "is-leaving" : null) @(Highlighted ? "is-highlight" : null)"
     tabindex="@(Highlighted ? "-1" : null)"
     @onclick="HandleClickAsync">
    @if (Item.Media?.Details.PosterUrl is { } poster)
    {
        <img class="change-poster" src="@poster" srcset="@(_unsized ? null : Artwork.ByDensity(poster, Thumb))" alt="" loading="lazy" decoding="async" @onerror="() => _unsized = true"/>
    }
    else
    {
        <span class="change-poster is-missing">
            <LucideIcon Name="image-off" Size="13"/>
        </span>
    }
    <span class="change-text">
        <span class="change-title">@Item.Title</span>
        @if (!string.IsNullOrWhiteSpace(Item.Subtitle))
        {
            <span class="change-subtitle">@Item.Subtitle</span>
        }
    </span>
    @if (Item.ContextIcon is { } icon)
    {
        <BbTooltipProvider>
            <BbTooltip DelayDuration="200">
                <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                    <span class="change-context">
                        <LucideIcon Name="@icon" Size="14"/>
                    </span>
                </BbTooltipTrigger>
                <BbTooltipContent>@Item.ContextTooltip</BbTooltipContent>
            </BbTooltip>
        </BbTooltipProvider>
    }
</div>

@code {
    private static readonly ArtworkSize Thumb = new(40, 60);

    [Parameter] [EditorRequired] public required ChangeItem Item { get; set; }
    [Parameter] public EventCallback<MatchedMedia> OnSelect { get; set; }
    [Parameter] public bool Highlighted { get; set; }
    [Parameter] public bool Reveal { get; set; }
    [Parameter] public EventCallback OnRevealed { get; set; }

    private ElementReference _root;

    private bool _unsized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Reveal)
        {
            return;
        }

        await OnRevealed.InvokeAsync();
        await _root.FocusAsync();
    }

    private Task HandleClickAsync() => Item.Media is { } media ? OnSelect.InvokeAsync(media) : Task.CompletedTask;
}
