@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="change-list @(Fill ? "is-fill" : null)">
    <div class="change-chips">
        <BbTooltipProvider>
            @foreach (var (chip, separator, countsOnly) in ChipRow())
            {
                @if (separator)
                {
                    <span class="change-chip-sep"></span>
                }
                <BbTooltip DelayDuration="200">
                    <BbTooltipTrigger AsChild="false" Class="p-0" Focusable="false">
                        @if (countsOnly)
                        {
                            <span class="change-chip is-count @ToneClass(chip.Tone)">
                                @ChipFace(chip)
                            </span>
                        }
                        else
                        {
                            <button type="button"
                                    class="change-chip @ToneClass(chip.Tone) @(IsActive(chip) ? "is-on" : null) @(Clickable(chip) ? null : "is-dim")"
                                    disabled="@(!Clickable(chip))"
                                    @onclick="() => ToggleAsync(chip)">
                                @ChipFace(chip)
                            </button>
                        }
                    </BbTooltipTrigger>
                    <BbTooltipContent>@chip.Tooltip</BbTooltipContent>
                </BbTooltip>
            }
        </BbTooltipProvider>
        <span class="change-search">
            <LucideIcon Name="search" Size="13"/>
            <input type="text" placeholder="Search titles" value="@_search" @oninput="OnSearchChanged"/>
        </span>
    </div>

    <div class="change-body" @ref="_body">
        @foreach (var group in Groups())
        {
            <section class="change-section" data-kind="@group.Kind">
                <div class="change-group @ToneClass(GroupTone(group.Kind))">
                    @if (GroupGlyph(group.Kind) is { } glyph)
                    {
                        <span class="change-glyph">@glyph</span>
                    }
                    else
                    {
                        <LucideIcon Name="@GroupIcon(group.Kind)" Size="14"/>
                    }
                    <span>@GroupLabel(group.Kind)</span>
                    <span class="change-group-count">@group.Items.Length.ToString("N0")</span>
                    @if (group.Kind == Fold?.Kind)
                    {
                        <button type="button" class="change-fold" @onclick="Hide">
                            <LucideIcon Name="chevron-up" Size="13"/>
                            Hide
                        </button>
                    }
                </div>
                <VirtualizeGuard>
                    <Virtualize Items="group.Items" Context="item" ItemSize="RowHeight" OverscanCount="8">
                        <ChangeRow @key="item" Item="item" OnSelect="SelectAsync" Highlighted="@IsHighlighted(item)" Reveal="@Reveals(item)" OnRevealed="Revealed"/>
                    </Virtualize>
                </VirtualizeGuard>
            </section>
        }
        @if (Fold is { Count: > 0 } fold && _fold is not FoldState.Open && Shows(fold.Kind))
        {
            <div class="change-pin">
                @if (_fold is FoldState.Loading)
                {
                    <BbSpinner Size="SpinnerSize.Small"/>
                    <span>Loading the <b>@fold.Count.ToString("N0")</b> @Titles(fold.Count) already in sync</span>
                }
                else
                {
                    <LucideIcon Name="@GroupIcon(fold.Kind)" Size="14"/>
                    @if (string.IsNullOrWhiteSpace(_search))
                    {
                        <span><b>@fold.Count.ToString("N0")</b> @Titles(fold.Count) already in sync, nothing to do</span>
                    }
                    else
                    {
                        <span><b>@fold.Count.ToString("N0")</b> already in sync were not searched</span>
                    }
                    <button type="button" class="change-fold" @onclick="() => UnfoldAsync(fold)">
                        <LucideIcon Name="chevron-down" Size="13"/>
                        Show them
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    private const float RowHeight = 74;

    [Parameter] [EditorRequired] public required IReadOnlyList<ChangeItem> Items { get; set; }
    [Parameter] [EditorRequired] public required IReadOnlyList<ChangeChip> Chips { get; set; }
    [Parameter] public EventCallback<MatchedMedia> OnSelect { get; set; }
    [Parameter] public MediaId? Highlight { get; set; }
    [Parameter] public ChangeFold? Fold { get; set; }
    [Parameter] public bool Fill { get; set; }
    [Parameter] public string RemovedLabel { get; set; } = "Removed";
    [Parameter] public string AddedLabel { get; set; } = "Added";
    [Parameter] public string UnchangedLabel { get; set; } = "Already yours";

    private readonly HashSet<ChangeKind> _active = [];
    private ElementReference _body;
    private IJSObjectReference? _module;
    private string _search = string.Empty;
    private MediaId? _pointedAt;
    private bool _dismissed;
    private bool _revealed;
    private FoldState _fold = FoldState.Folded;
    private bool _read;
    private Scroll? _scroll;

    private enum FoldState
    {
        Folded,
        Loading,
        Open,
    }

    private sealed record Group(ChangeKind Kind, ChangeItem[] Items);

    private readonly record struct Scroll(ChangeKind Kind, float Offset);

    protected override void OnParametersSet()
    {
        if (Highlight == _pointedAt)
        {
            return;
        }

        _pointedAt = Highlight;
        _dismissed = false;
        _revealed = false;
        if (Highlight is { } wanted)
        {
            ScrollTo(wanted);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scroll is not { } scroll)
        {
            return;
        }

        _scroll = null;
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/change-list.js");
        await _module.InvokeVoidAsync("scrollToSection", _body, scroll.Kind.ToString(), scroll.Offset);
    }

    private void ScrollTo(MediaId wanted)
    {
        foreach (var group in Groups())
        {
            var index = Array.FindIndex(group.Items, item => item.Id == wanted);
            if (index >= 0)
            {
                _scroll = new Scroll(group.Kind, index * RowHeight);
                return;
            }
        }
    }

    private bool IsHighlighted(ChangeItem item) => !_dismissed && Highlight is { } wanted && item.Id == wanted;

    private bool Reveals(ChangeItem item) => !_revealed && IsHighlighted(item);

    private void Revealed() => _revealed = true;

    private async Task SelectAsync(MatchedMedia media)
    {
        _dismissed = true;
        await OnSelect.InvokeAsync(media);
    }

    private IEnumerable<Group> Groups()
    {
        return Items
            .Where(item => Shows(item.Kind) && !IsFolded(item.Kind))
            .Where(item => string.IsNullOrWhiteSpace(_search) || item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .GroupBy(item => item.Kind)
            .OrderBy(group => group.Key == Fold?.Kind)
            .ThenBy(group => group.Key)
            .Select(group => new Group(group.Key, [.. group]));
    }

    private bool Shows(ChangeKind kind) => _active.Count == 0 || _active.Contains(kind);

    private bool IsFolded(ChangeKind kind) => kind == Fold?.Kind && _fold is not FoldState.Open;

    private async Task UnfoldAsync(ChangeFold fold)
    {
        if (_fold is not FoldState.Folded)
        {
            return;
        }

        _fold = FoldState.Loading;
        if (!_read)
        {
            await fold.UnfoldAsync();
            _read = true;
        }

        _fold = FoldState.Open;
        _scroll = new Scroll(fold.Kind, 0);
    }

    private void Hide() => _fold = FoldState.Folded;

    private static string Titles(int count) => "title".ToQuantity(count, ShowQuantityAs.None);

    private RenderFragment ChipFace(ChangeChip chip) =>
        @<text>
            @if (chip.Glyph is { } glyph)
            {
                <span class="change-glyph">@glyph</span>
            }
            else if (chip.Icon is { } icon)
            {
                <LucideIcon Name="@icon" Size="16"/>
            }
            <span class="change-chip-count">@chip.Count.ToString("N0")</span>
        </text>;

    private IEnumerable<(ChangeChip Chip, bool Separator, bool CountsOnly)> ChipRow()
    {
        var separatorPending = false;
        var countsOnly = false;
        foreach (var chip in Chips)
        {
            if (chip.StartsCountsOnly)
            {
                separatorPending = true;
                countsOnly = true;
            }

            if (chip.Count == 0)
            {
                continue;
            }

            yield return (chip, separatorPending, countsOnly);
            separatorPending = false;
        }
    }

    private bool Clickable(ChangeChip chip) => chip.Filters is null ? _active.Count > 0 : chip.Count > 0;

    private bool IsActive(ChangeChip chip) => chip.Filters is { } kind ? _active.Contains(kind) : _active.Count == 0;

    private async Task ToggleAsync(ChangeChip chip)
    {
        if (chip.Filters is not { } kind)
        {
            _active.Clear();
            return;
        }

        if (!_active.Add(kind))
        {
            _active.Remove(kind);
            return;
        }

        if (Fold is { } fold && fold.Kind == kind)
        {
            await UnfoldAsync(fold);
        }
    }

    private void OnSearchChanged(ChangeEventArgs args) => _search = args.Value?.ToString() ?? string.Empty;

    private static ChipTone GroupTone(ChangeKind kind) =>
        kind switch
        {
            ChangeKind.Removed => ChipTone.Removed,
            ChangeKind.Added => ChipTone.Added,
            ChangeKind.Unchanged => ChipTone.Neutral,
            ChangeKind.Unmatched => ChipTone.Unmatched,
            ChangeKind.Unaddressable => ChipTone.Unmatched,
        };

    private static string? GroupGlyph(ChangeKind kind) =>
        kind switch
        {
            ChangeKind.Removed => "−",
            ChangeKind.Added => "+",
            ChangeKind.Unchanged => null,
            ChangeKind.Unmatched => null,
            ChangeKind.Unaddressable => null,
        };

    private static string GroupIcon(ChangeKind kind) =>
        kind switch
        {
            ChangeKind.Removed => "minus",
            ChangeKind.Added => "plus",
            ChangeKind.Unchanged => "bookmark-check",
            ChangeKind.Unmatched => "circle-alert",
            ChangeKind.Unaddressable => "bookmark-x",
        };

    private string GroupLabel(ChangeKind kind) =>
        kind switch
        {
            ChangeKind.Removed => RemovedLabel,
            ChangeKind.Added => AddedLabel,
            ChangeKind.Unchanged => UnchangedLabel,
            ChangeKind.Unmatched => "Could not be matched",
            ChangeKind.Unaddressable => "Couldn't be added",
        };

    private static string ToneClass(ChipTone tone) =>
        tone switch
        {
            ChipTone.Neutral => "tone-neutral",
            ChipTone.Added => "tone-added",
            ChipTone.Removed => "tone-removed",
            ChipTone.Unmatched => "tone-unmatched",
        };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
    }
}
