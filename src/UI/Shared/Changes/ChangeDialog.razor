
<BbDialog Open="Open" OpenChanged="OnOpenChanged">
    <BbDialogContent Class="change-dialog p-0 gap-0" InitialFocus="FocusTrapInitialFocus.Container">
        @if (Prologue is not null)
        {
            <div class="change-prologue">@Prologue</div>
        }
        <div class="change-head">
            <div class="change-head-top">
                <div>
                    <div class="change-title-line">
                        <h3 class="change-title-text">@Title</h3>
                        @if (Loading && HasRows)
                        {
                            <span class="change-head-spin" role="status">
                                <BbSpinner Size="SpinnerSize.Small"/>
                                <span class="sr-only">Loading…</span>
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <p class="change-sub">@Subtitle</p>
                    }
                </div>
                @if (Badges is not null)
                {
                    <div class="change-badges">@Badges</div>
                }
            </div>
        </div>

        @if (Band is not null)
        {
            <div class="change-band @BandClass">@Band</div>
        }

        @if (HasRows)
        {
            <ChangeList Items="Items"
                        Chips="Chips"
                        OnSelect="OnSelect"
                        Fold="Fold"
                        RemovedLabel="@RemovedLabel"
                        AddedLabel="@AddedLabel"
                        UnchangedLabel="@UnchangedLabel"/>
        }
        else if (Loading)
        {
            <div class="change-empty change-loading">
                <BbSpinner Size="SpinnerSize.Small"/>
                <span>Loading…</span>
            </div>
        }
        else
        {
            <div class="change-empty">@EmptyMessage</div>
        }

        <div class="change-foot @(Actions is null ? "is-note-only" : null)">
            @if (Note is not null && NoteHref is not null)
            {
                <AppLink Href="@NoteHref" Class="text-xs">@Note</AppLink>
            }
            else
            {
                <span class="change-note">@Note</span>
            }
            <span class="change-actions">@Actions</span>
        </div>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OnOpenChanged { get; set; }

    [Parameter] [EditorRequired] public required string Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Badges { get; set; }

    [Parameter] public RenderFragment? Prologue { get; set; }
    [Parameter] public RenderFragment? Band { get; set; }
    [Parameter] public ChangeBandTone BandTone { get; set; } = ChangeBandTone.Warn;

    [Parameter] public bool Loading { get; set; }

    [Parameter] public IReadOnlyList<ChangeItem> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<ChangeChip> Chips { get; set; } = [];
    [Parameter] public EventCallback<MatchedMedia> OnSelect { get; set; }
    [Parameter] public ChangeFold? Fold { get; set; }

    [Parameter] public string RemovedLabel { get; set; } = "Removed";
    [Parameter] public string AddedLabel { get; set; } = "Added";
    [Parameter] public string UnchangedLabel { get; set; } = "Already yours";
    [Parameter] public string EmptyMessage { get; set; } = "Nothing changed.";

    [Parameter] public string? Note { get; set; }
    [Parameter] public string? NoteHref { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    private string BandClass => BandTone is ChangeBandTone.Warn ? "is-warn" : "is-bad";

    private bool HasRows => Items.Count > 0 || Fold is { Count: > 0 };
}
