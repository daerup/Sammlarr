@using UI.Shared.Services.Branding

<span class="provider-pair" style="--tile-size: @(Size)px; --mark-size: @(MarkSize)px">
    <span class="provider-pair-first"><BrandedLogo Brand="First" Form="ProviderLogoForm.Mark" Size="@MarkSize" Decorative="Decorative"/></span>
    <span class="provider-pair-second"><BrandedLogo Brand="Second" Form="ProviderLogoForm.Mark" Size="@MarkSize" Decorative="Decorative"/></span>
</span>

@code {
    [Parameter] [EditorRequired] public required BrandingInfo First { get; set; }

    [Parameter] [EditorRequired] public required BrandingInfo Second { get; set; }

    [Parameter] public int Size { get; set; } = 28;

    [Parameter] public bool Decorative { get; set; }

    private int MarkSize => (int)Math.Round(Size * 18 / 28d);
}
