@if (Visible)
{
    @if (Placement is ActionPlacement.Toolbar && HasSlot)
    {
        <button type="button" class="toolbar-slot @(Active && !PhoneOnClick.HasDelegate ? "is-on" : null) @(Tone is ActionTone.Danger ? "is-danger" : null)" disabled="@Disabled" aria-label="@(Badge > 0 ? $"{Label}, {Badge}" : null)" @onclick="PhoneOnClick.HasDelegate ? PhoneOnClick : OnClick">
            <LucideIcon Name="@Icon" Size="20"/>
            <span class="toolbar-slot-label">@Label</span>
            @if (Badge > 0)
            {
                <span class="toolbar-badge">@Badge</span>
            }
        </button>
    }
    else if (Placement is ActionPlacement.Header)
    {
        <div class="contents @(HasSlot ? "max-md:hidden" : null)">
            @if (Desktop is not null)
            {
                @Desktop
            }
            else
            {
                <BbButton Variant="Variant" OnClick="OnClick" Disabled="Disabled" Class="@(Active ? "bg-accent" : null)">
                    <LucideIcon Name="@Icon" Size="IconSize" Class="@IconClass"/>
                    @(DesktopLabel ?? Label)
                    @if (Badge > 0)
                    {
                        <span class="action-badge">@Badge</span>
                    }
                </BbButton>
            }
        </div>
    }
}

@code {
    [CascadingParameter] private ActionPlacement Placement { get; set; }

    [Parameter, EditorRequired] public required string Icon { get; set; }
    [Parameter] public int IconSize { get; set; } = 16;
    [Parameter] public string IconClass { get; set; } = "mr-2";
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public string? DesktopLabel { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;
    [Parameter] public bool Active { get; set; }
    [Parameter] public int Badge { get; set; }
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public ActionTone Tone { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback PhoneOnClick { get; set; }
    [Parameter] public RenderFragment? Desktop { get; set; }

    private bool HasSlot => OnClick.HasDelegate || PhoneOnClick.HasDelegate;
}
