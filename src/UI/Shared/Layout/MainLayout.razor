@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Sections
@using UI.Features.Onboarding.Components
@inject CurrentUserAccessor CurrentUser
@inject AppVersionProvider Versions
@inject AppUpdateChecker Updates
@inject SearchLauncher SearchLauncher

<PhoneLayout>
    <SessionInvalidationListener/>
    <AuthorizeView>
        <SetupRedirect/>
    </AuthorizeView>
    <AuthorizeView>
        <GlobalSearch IsOpen="_isSearchOpen" IsOpenChanged="SearchOpenChanged" Purpose="_searchPurpose"/>
    </AuthorizeView>

    <div class="relative h-dvh overflow-hidden flex flex-col">
        <header class="shrink-0 z-50 w-full border-b bg-background max-md:pt-[env(safe-area-inset-top)]">
            <div class="flex h-12 items-center px-6 max-md:h-13 max-md:gap-0.5 max-md:px-2">
                <div class="contents md:hidden">
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Open menu" aria-haspopup="dialog" aria-expanded="@(_isMenuOpen ? "true" : "false")" OnClick="@(() => _isMenuOpen = true)">
                        <LucideIcon Name="menu" Size="20"/>
                    </BbButton>
                    <PhoneOnly>
                        <h1 class="phone-title"><SectionOutlet SectionName="@PhoneLayout.TitleSection"/></h1>
                    </PhoneOnly>
                </div>
                <div class="mr-6 flex max-md:hidden">
                    <NavLink href="/" Match="NavLinkMatch.All" class="flex items-center group" aria-label="Sammlarr home">
                        <SammlarrLogo Size="33" WordSize="19"/>
                    </NavLink>
                </div>
                <BbNavigationMenu Class="text-sm font-medium max-md:hidden">
                    <BbNavigationMenuList>
                        @foreach (var link in AppSections.Pages)
                        {
                            <BbNavigationMenuItem>
                                <BbNavigationMenuLink Href="@link.Href" Class="nav-link">@link.Label</BbNavigationMenuLink>
                            </BbNavigationMenuItem>
                        }
                    </BbNavigationMenuList>
                </BbNavigationMenu>
                <div class="flex items-center justify-end space-x-2 md:flex-1 max-md:ml-auto max-md:space-x-0.5">
                    <AuthorizeView>
                        <button type="button" class="search-trigger" aria-label="Search for a movie or show" @onclick="@(() => _isSearchOpen = true)">
                            <LucideIcon Name="search" Size="14"/>
                            <span class="search-trigger-label max-md:hidden">Search</span>
                            <BbKbd Keys="Ctrl+K" Class="max-md:hidden"/>
                        </button>
                    </AuthorizeView>
                    <BbDarkModeToggle Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="max-md:hidden"/>
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Href="/settings" AriaLabel="Settings" Class="max-md:hidden">
                        <LucideIcon Name="settings" Size="16"/>
                    </BbButton>

                    <ProfileCard/>
                </div>
            </div>
            <PhoneOnly>
                <SectionOutlet SectionName="@PhoneLayout.BarSection"/>
            </PhoneOnly>
        </header>

        <main class="flex-1 min-h-0 overflow-y-auto">
            @Body
        </main>

        <PhoneOnly>
            <nav class="page-toolbar" aria-label="Page actions">
                <div class="page-slots">
                    <SectionOutlet SectionName="@PhoneLayout.ToolbarSection"/>
                </div>
                <SectionOutlet SectionName="@PhoneLayout.BulkSection"/>
            </nav>
        </PhoneOnly>

        <AppFooter Version="Versions.Current" Update="_update" Class="max-md:hidden"/>
    </div>

    <PhoneOnly>
        <PhoneMenu @bind-Open="_isMenuOpen" Version="Versions.Current" Update="_update"/>
    </PhoneOnly>
    <BbToastProvider Position="ToastPosition.BottomRight" Class="toast-viewport"/>
    <WebUiToastListener/>
    <BbDialogProvider/>
    <BbPortalHost/>
</PhoneLayout>

@code {
	private bool _isSearchOpen;

	private bool _isMenuOpen;

	private SearchPurpose _searchPurpose;

	private Optional<AppUpdate> _update = new None();

	[CascadingParameter]
	private Task<AuthenticationState>? AuthenticationState { get; set; }

	protected override async Task OnParametersSetAsync()
	{
		if (AuthenticationState is not null)
		{
			CurrentUser.SetPrincipal((await AuthenticationState).User);
		}
	}

	protected override void OnInitialized() => SearchLauncher.Opened += OpenSearch;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			_update = await Updates.CheckAsync();
			StateHasChanged();
		}
	}

	private void OpenSearch(SearchPurpose purpose)
	{
		_searchPurpose = purpose;
		_isSearchOpen = true;
		_ = InvokeAsync(StateHasChanged);
	}

	private void SearchOpenChanged(bool open)
	{
		_isSearchOpen = open;
		if (!open)
		{
			_searchPurpose = SearchPurpose.Wantlist;
		}
	}

	public void Dispose() => SearchLauncher.Opened -= OpenSearch;
}
