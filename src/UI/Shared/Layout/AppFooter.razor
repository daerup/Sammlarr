<footer class="shrink-0 border-t @Class">
    <div class="flex h-8 items-center justify-end px-6 text-xs text-muted-foreground">
        <AppLink Href="/settings?section=about" Title="@LinkTitle(Update)">
            @if (Update is Some<AppUpdate>)
            {
                <span class="update-dot" data-testid="footer-update-dot"></span>
            }
            <span class="font-mono font-normal">@Version.Number</span>
        </AppLink>
    </div>
</footer>

@code {
    [Parameter] [EditorRequired] public required AppVersion Version { get; set; }

    [Parameter] public Optional<AppUpdate> Update { get; set; } = new None();

    [Parameter] public string? Class { get; set; }

    internal static string LinkTitle(Optional<AppUpdate> update) => update.Match(found => $"Sammlarr {found.Version} is out", () => "About this version");
}
