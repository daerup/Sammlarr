<div class="h-full flex flex-col pt-4 pb-2">
    @if (Heading is not null || HeaderSearch is not null || Actions is not null)
    {
        <PageHeader Heading="@Heading"
                    Description="@Description"
                    DescriptionContent="@DescriptionContent"
                    Actions="@HeaderRow"
                    Class="px-6 pb-2 shrink-0"/>
    }
    <div class="flex-1 min-h-0 overflow-y-auto px-6 py-2">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Heading { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? DescriptionContent { get; set; }
    [Parameter] public RenderFragment? HeaderSearch { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? HeaderClass { get; set; }

    private RenderFragment? HeaderRow => HeaderSearch is null && Actions is null ? null : @<text>@HeaderSearch@Actions</text>;
}
