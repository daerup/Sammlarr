@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

@if (GuardState())
{
    @ChildContent
}
else if (ShowFallback)
{
    <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-4">
        <LucideIcon Name="@FallbackIcon" Size="40" Class="mx-auto text-muted-foreground"/>
        @if (ApiProvider is { } apiProvider)
        {
            <h3 class="text-base font-semibold tracking-tight">Add your @Branding.Name(apiProvider.Remote) key</h3>
        }
        <p class="text-muted-foreground">@GetFallbackMessage()</p>

        @if (FallbackAction.HasDelegate)
        {
            <BbButton Variant="@(ApiProvider.HasValue ? ButtonVariant.Default : ButtonVariant.Outline)" OnClick="InvokeFallbackActionAsync">
                @if (ApiProvider.HasValue)
                {
                    <LucideIcon Name="key-round" Size="14" Class="mr-2"/>
                }
                @GetFallbackActionText()
            </BbButton>
        }
    </div>
}

@code {
    [Parameter] [EditorRequired] public Func<bool> GuardState { get; set; } = () => true;
    [Parameter] [EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowFallback { get; set; } = true;

    [Parameter] public AuthProvider? AuthProvider { get; set; }
    [Parameter] public ApiKeyProvider? ApiProvider { get; set; }
    [Parameter] public string DeniedActionDescription { get; set; } = "access this section";
    [Parameter] public string? ApiKeyReason { get; set; }
    [Parameter] public EventCallback FallbackAction { get; set; }

    private string FallbackIcon => (AuthProvider, ApiProvider) switch
    {
        ({ }, _) => "lock",
        (_, { }) => "key-round",
        _ => "log-in",
    };

    private string GetFallbackMessage()
    {
        if (AuthProvider.HasValue)
        {
            return $"You need to connect your {Branding.Name(AuthProvider.Value.Service)} account before {DeniedActionDescription}.";
        }

        if (ApiProvider.HasValue)
        {
            return ApiKeyReason ?? $"A valid {Branding.Name(ApiProvider.Value.Remote)} API key is required to {DeniedActionDescription}.";
        }

        return $"You need to sign in before {DeniedActionDescription}.";
    }

    private string GetFallbackActionText()
    {
        if (AuthProvider.HasValue)
        {
            return $"Connect {Branding.Name(AuthProvider.Value.Service)} Account";
        }

        if (ApiProvider.HasValue)
        {
            return $"Add your {Branding.Name(ApiProvider.Value.Remote)} key";
        }

        return "Sign in";
    }

    private Task InvokeFallbackActionAsync() => FallbackAction.InvokeAsync();
}

