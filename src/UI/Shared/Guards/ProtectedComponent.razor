@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

@if (GuardState())
{
    @ChildContent
}
else
{
    <ReasonTip TriggerClass="inline-block cursor-not-allowed" Reason="@GetDisabledMessage()" ActionText="Settings" ActionHref="@GetSetupLink()">
        <div class="pointer-events-none opacity-50">
            @ChildContent
        </div>
    </ReasonTip>
}

@code {
    [Parameter] [EditorRequired] public Func<bool> GuardState { get; set; } = () => true;
    [Parameter] [EditorRequired] public RenderFragment? ChildContent { get; set; }

    [Parameter] public SinkKind? Sink { get; set; }
    [Parameter] public ApiKeyProvider? ApiProvider { get; set; }
    [Parameter] public string DeniedActionDescription { get; set; } = "use this";

    private string? GetSetupLink()
    {
        return Sink switch
        {
            SinkKind.Plex => SettingsLinks.Provider(RemoteService.Plex),
            SinkKind.Arr => null,
            null => ApiProvider is { } provider ? SettingsLinks.Provider(provider.Remote) : null,
        };
    }

    private string GetDisabledMessage()
    {
        if (Sink is { } sink)
        {
            return sink switch
            {
                SinkKind.Plex => $"Connect your Plex account to {DeniedActionDescription}.",
                SinkKind.Arr => $"Radarr + Sonarr needs setting up before you can {DeniedActionDescription}.",
            };
        }

        if (ApiProvider.HasValue)
        {
            return $"A valid {Branding.Name(ApiProvider.Value.Remote)} API key is required to {DeniedActionDescription}.";
        }

        return $"Sign in to {DeniedActionDescription}.";
    }
}
