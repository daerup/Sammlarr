@using UI.Shared.Services.Branding
@inject NavigationManager NavigationManager
@inject MediaProviderBrandingService BrandingService

<div class="w-full max-w-md rounded-lg border bg-muted/40 p-8 text-center space-y-4">
    <div class="space-y-1.5">
        <h2 class="text-lg font-semibold tracking-tight">Sign in</h2>
        <p class="text-sm text-muted-foreground">Use your @Branding.NickName account to continue.</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert-soft-destructive flex items-start gap-3 rounded-lg border px-4 py-3 text-left text-sm">
            <LucideIcon Name="circle-alert" Size="18" Class="shrink-0 mt-0.5"/>
            <span class="leading-relaxed">@Error</span>
        </div>
    }
    @switch (Provider)
    {
        case AuthProvider.Plex:
            <div class="signin" style="--brand: @Branding.BrandColor">
                <BbButton Variant="ButtonVariant.Outline" Class="signin-button w-full gap-2 font-medium" OnClick="SignInWithPlex" Disabled="_signingIn">
                    @if (_signingIn)
                    {
                        <BbSpinner Size="SpinnerSize.Small"/>
                        <span>Signing in…</span>
                    }
                    else
                    {
                        <span>Sign in with</span>
                        <BrandedLogo Brand="Branding" Form="ProviderLogoForm.Logo" Size="16"/>
                    }
                </BbButton>
            </div>
            break;
        case AuthProvider.Local:
            <form method="post" action="/auth/local" class="signin-form space-y-4 text-left" onsubmit="this.dataset.busy = ''; this.querySelector('button[type=submit]').disabled = true">
                <AntiforgeryToken/>
                <input type="hidden" name="returnUrl" value="@Target"/>
                <BbField>
                    <BbFieldLabel For="signin-username">Username</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Id="signin-username" Name="username" Required="true" autocomplete="username"/>
                    </BbFieldContent>
                </BbField>
                <BbField>
                    <BbFieldLabel For="signin-password">Password</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Id="signin-password" Name="password" Type="InputType.Password" Required="true" autocomplete="current-password"/>
                    </BbFieldContent>
                </BbField>
                <BbButton Type="ButtonType.Submit" Class="w-full">
                    <span class="signin-idle">Sign in</span>
                    <span class="signin-busy"><BbSpinner Size="SpinnerSize.Small"/>Signing in…</span>
                </BbButton>
            </form>
            break;
    }
</div>

@code {
    [Parameter] [EditorRequired] public required AuthProvider Provider { get; set; }

    [Parameter] public string? ReturnUrl { get; set; }

    [Parameter] public string? Error { get; set; }

    private BrandingInfo Branding => BrandingService.Brands(Provider.Service).Single();

    private string Target => string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;

    private bool _signingIn;

    private void SignInWithPlex()
    {
        _signingIn = true;
        NavigationManager.NavigateTo($"/auth/plex/login?returnUrl={Uri.EscapeDataString(Target)}", forceLoad: true);
    }
}
