@using Contracts.Media.Search
@using Domain.Wantlist.Arr
@using UI.Shared.Services.Branding
@inject IMediaSearchService SearchService
@inject MediaProviderBrandingService Branding
@inject Notifier Notifier
<KeyboardShortcut Keys="@ShortcutKeys" OnInvoked="OpenFromShortcutAsync" Enabled="ShortcutEnabled"/>
@if (IsOpen)
{
    <div class="search-modal @(_details is null ? null : "under-details")"
         role="dialog"
         aria-modal="true"
         aria-label="@SearchModalTitle"
         tabindex="-1"
         @onkeydown="HandleModalKeyDown">
        <div class="search-modal-backdrop" @onclick="CloseAsync"></div>

        <div tabindex="0" class="sr-only" aria-hidden="true" @onfocus="FocusTrapLoopAsync"></div>

        <div class="search-modal-content">
            <div class="flex items-start justify-between gap-4 max-md:hidden">
                <div>
                    <h2 class="text-lg font-bold tracking-wide">@SearchModalTitle</h2>
                    <p class="text-sm text-muted-foreground">@SearchModalDescription</p>
                </div>
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseAsync">
                    <LucideIcon Name="x" Size="18"/>
                </BbButton>
            </div>

            <div class="search-modal-body gap-4 mt-4 max-md:mt-0">
                <div class="flex items-center gap-2 max-md:gap-1">
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-11 w-10 shrink-0 md:hidden" OnClick="CloseAsync" AriaLabel="Back">
                        <LucideIcon Name="chevron-left" Size="22"/>
                    </BbButton>
                    <BbField Class="flex-1">
                        <BbFieldLabel For="search-input" Class="sr-only">Search query</BbFieldLabel>
                        <BbFieldContent>
                            <div class="relative">
                                <LucideIcon Name="search" Size="17" Class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground md:hidden"/>
                                <input id="search-input"
                                       class="w-full border-input bg-secondary file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 flex h-9 max-md:h-11 min-w-0 rounded-md border px-3 py-1 max-md:pl-10 max-md:pr-11 max-md:rounded-[10px] text-base shadow-xs transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm [&::-webkit-search-cancel-button]:hidden"
                                       type="search"
                                       enterkeyhint="search"
                                       @bind="_searchQuery"
                                       @bind:event="oninput"
                                       @bind:after="QueryChangedAsync"
                                       @onkeydown="HandleSearchKeyDown"
                                       @onfocus="() => _focusedResult = null"
                                       @ref="_searchInputRef"
                                       placeholder="@Placeholder"/>
                                @if (IsPhone && !string.IsNullOrEmpty(_searchQuery))
                                {
                                    <button type="button" class="absolute right-1 top-1/2 grid size-9 -translate-y-1/2 place-items-center text-muted-foreground" aria-label="Clear search" @onclick="ClearAsync">
                                        <LucideIcon Name="circle-x" Size="18"/>
                                    </button>
                                }
                            </div>
                        </BbFieldContent>
                    </BbField>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="SearchAsync" Disabled="@_isSearching" Class="bg-secondary max-md:hidden">
                        @if (_isSearching)
                        {
                            <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <LucideIcon Name="search" Size="16" Class="mr-2"/>
                            <span>Search</span>
                        }
                    </BbButton>

                </div>

                @if (!string.IsNullOrWhiteSpace(_searchHint))
                {
                    <div class="rounded-lg border bg-muted/40 px-4 py-3 flex items-center gap-2 text-sm text-muted-foreground">
                        <LucideIcon Name="info" Size="16" Class="shrink-0"/>
                        <span>@_searchHint</span>
                    </div>
                }

                @foreach (var miss in _missed)
                {
                    <div class="rounded-lg border bg-muted/40 px-4 py-3 flex items-start gap-2 text-sm text-muted-foreground" data-testid="search-miss">
                        <LucideIcon Name="info" Size="16" Class="shrink-0 mt-0.5"/>
                        <span class="min-w-0 break-words">
                            <span class="text-foreground font-medium">@Branding.Name(miss.Service)</span> did not answer, so its @KindOf(miss.Service) are missing.
                            <span class="block text-xs" data-testid="search-miss-reason">@miss.Reason</span>
                        </span>
                    </div>
                }

                @if (_isSearching)
                {
                    <div class="search-modal-results scrollbar-thin space-y-2 pr-1 max-md:space-y-0" aria-hidden="true" tabindex="-1">
                        <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="4"/>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_searchError))
                {
                    <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-3">
                        <LucideIcon Name="circle-alert" Size="36" Class="mx-auto text-destructive"/>
                        <h3 class="text-base font-semibold tracking-tight">Search failed.</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed break-words">@_searchError</p>
                    </div>
                }
                else if (_searchResults.Count > 0)
                {
                    @if (SplitsByApp)
                    {
                        <BbTabs Value="@_tab" ValueChanged="tab => _tab = tab ?? _tab">
                            <BbTabsList>
                                @foreach (var app in Enum.GetValues<ArrApp>())
                                {
                                    <BbTabsTrigger Value="@app.Name" Class="gap-1.5">
                                        <LucideIcon Name="@app.Type.Icon" Size="14"/>
                                        <span>@app.Type.Plural</span>
                                        <span class="text-xs text-muted-foreground">@CountOf(app)</span>
                                        <BrandedLogo Brand="Branding.GetBrandingInfo(app.Remote)" Form="ProviderLogoForm.Mark" Size="13" Decorative="true"/>
                                    </BbTabsTrigger>
                                }
                            </BbTabsList>
                        </BbTabs>
                    }
                    <div class="search-modal-results scrollbar-thin space-y-2 pr-1 max-md:space-y-0" tabindex="-1">
                        @foreach (var result in ShownResults)
                        {
                            <MediaDetailTile @key="result.Key"
                                             Media="result"
                                             IsFocused="_focusedResult == result.Key"
                                             OnFocusIn="() => _focusedResult = result.Key"
                                             OnFocusOut="() => ClearFocusedResult(result)"
                                             OnOpen="() => _details = result">
                                <Icons>
                                    @if (result is MatchedMedia matched)
                                    {
                                        @TileIcons?.Invoke(new TileIconContext(matched, IsSearchResultMarked(matched), _isAdding && Equals(_activeToggledSourceId, matched.Identity.Id), EventCallback.Factory.Create<MatchedMedia>(this, ToggleAsync)))
                                    }
                                    else if (result is UnmatchedMedia { Reason: UnmatchedReason.Conflict })
                                    {
                                        <DetailTip Title="Can't be added" TriggerClass="text-muted-foreground" PhoneLabel="Can't be added" PhoneClass="relative after:absolute after:-inset-2.5" data-testid="search-conflict">
                                            <Trigger>
                                                <LucideIcon Name="split" Size="16"/>
                                            </Trigger>
                                            <Detail>
                                                Its ids disagree with titles already in your library, so it can't be added.
                                            </Detail>
                                        </DetailTip>
                                    }
                                </Icons>
                            </MediaDetailTile>
                        }
                    </div>
                    <BbSeparator Class="max-md:hidden"/>
                    <p class="flex items-center gap-2 text-xs text-muted-foreground max-md:hidden">
                        @foreach (var brand in Brands)
                        {
                            <BrandedLogo Brand="brand" Form="@FooterForm" Size="14" Decorative="true"/>
                        }
                        <span>Results from @ResultsSource</span>
                    </p>
                }
                else if (_hasSearched)
                {
                    <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-3">
                        <LucideIcon Name="search-x" Size="36" Class="mx-auto text-muted-foreground"/>
                        <h3 class="text-base font-semibold tracking-tight">No matches found.</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">Try a different title or check your spelling.</p>
                    </div>
                }
                else if (IsPhone)
                {
                    <div class="search-modal-empty" data-testid="search-empty">
                        <LucideIcon Name="search" Size="32"/>
                        <p>@SearchModalDescription</p>
                    </div>
                }
            </div>
        </div>

        <div tabindex="0" class="sr-only" aria-hidden="true" @onfocus="FocusTrapLoopAsync"></div>

        <MediaDetailSheet Open="_details is not null"
                          OnOpenChanged="@(open => { if (!open) { _details = null; } })"
                          Media="_details"
                          Source="ManualSource.Search"/>
    </div>
}

@code {

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] [EditorRequired] public SearchProvider SearchProvider { get; set; }
    [Parameter] [EditorRequired] public required Func<MediaId, bool> IsInWantlist { get; set; }
    [Parameter] [EditorRequired] public required Func<MediaId, string, bool, Task<bool>> OnToggle { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment<TileIconContext>? TileIcons { get; set; }
    [Parameter] public string ShortcutKeys { get; set; } = "Ctrl+K";
    [Parameter] public bool ShortcutEnabled { get; set; } = true;
    private bool _isSearching;
    private bool _hasSearched;
    private bool _isAdding;
    private string? _searchQuery = string.Empty;
    private string? _searchHint;
    private string? _searchError;
    private IReadOnlyList<SearchMiss> _missed = [];
    private MediaId? _activeToggledSourceId;
    private List<MediaMatchResult> _searchResults = [];
    private MediaMatchResult? _details;

    private string _tab = ArrApp.Radarr.Name;

    [CascadingParameter(Name = PhoneLayout.IsPhoneCascade)] private bool IsPhone { get; set; }

    private static readonly TimeSpan TypingPause = TimeSpan.FromMilliseconds(350);

    private int _typed;

    private bool SplitsByApp => SearchProvider == SearchProvider.Arr;

    private string Placeholder => IsPhone ? $"Search {ResultsSource}" : "Search title";

    private IEnumerable<MediaMatchResult> ShownResults => SplitsByApp ? _searchResults.Where(result => result.Details.Type == TabApp.Type) : _searchResults;

    private ArrApp TabApp => Enum.GetValues<ArrApp>().First(app => app.Name == _tab);

    private int CountOf(ArrApp app) => _searchResults.Count(result => result.Details.Type == app.Type);

    private static string KindOf(RemoteService service)
    {
        return Enum.GetValues<ArrApp>().First(app => app.Remote == service).Type.Plural.ToLowerInvariant();
    }

    private ElementReference _searchInputRef;
    private bool _shouldFocusSearchInput;
    private bool _wasOpen;
    private string? _focusedResult;

    private string SearchProviderName => Branding.Name(SearchProvider.Service);
    private string SearchModalTitle => Title ?? $"Search {SearchProviderName}";
    private string SearchModalDescription => Description ?? $"Find a movie or show from {SearchProviderName} and add it to your wantlist.";
    private IReadOnlyList<BrandingInfo> Brands => Branding.Brands(SearchProvider.Service);
    private ProviderLogoForm FooterForm => Brands.Count == 1 ? ProviderLogoForm.Logo : ProviderLogoForm.Mark;
    private string ResultsSource => Brands.Select(brand => brand.DisplayName).Humanize(Notation.Words);

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _shouldFocusSearchInput = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && _shouldFocusSearchInput)
        {
            _shouldFocusSearchInput = false;
            await _searchInputRef.FocusAsync();
        }

        _wasOpen = IsOpen;
    }

    private async Task FocusTrapLoopAsync()
    {
        await _searchInputRef.FocusAsync();
    }


    private bool IsSearchResultMarked(MatchedMedia result) => IsInWantlist.Invoke(result.Identity.Id);

    private async Task CloseAsync()
    {
        _focusedResult = null;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task OpenFromShortcutAsync()
    {
        if (IsOpen)
        {
            return;
        }
        await IsOpenChanged.InvokeAsync(true);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter")
        {
            await SearchAsync();
        }
        else if (args.Key is "Escape" && IsOpen)
        {
            await CloseAsync();
        }
    }

    private async Task HandleModalKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Escape" && IsOpen)
        {
            await CloseAsync();
        }
    }

    private async Task QueryChangedAsync()
    {
        if (!IsPhone)
        {
            return;
        }

        var typed = ++_typed;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            ResetResults();
            return;
        }

        await Task.Delay(TypingPause);
        if (typed == _typed)
        {
            await SearchAsync();
        }
    }

    private async Task ClearAsync()
    {
        _searchQuery = string.Empty;
        _typed++;
        ResetResults();
        await _searchInputRef.FocusAsync();
    }

    private void ResetResults()
    {
        _searchResults = [];
        _missed = [];
        _searchHint = null;
        _searchError = null;
        _hasSearched = false;
    }

    private async Task SearchAsync()
    {
        var query = _searchQuery?.Trim();
        _searchHint = null;
        _searchError = null;
        _missed = [];

        if (string.IsNullOrWhiteSpace(query))
        {
            _searchHint = "Enter a title to search.";
            _searchResults = [];
            _hasSearched = false;
            return;
        }

        _isSearching = true;

        try
        {
            var searched = await SearchService.SearchAsync(query, [MediaType.Movie, MediaType.Show]);
            if (IsPhone && _searchQuery?.Trim() != query)
            {
                return;
            }

            _searchResults = [.. searched.Results];
            _missed = searched.Missed;
            _tab = Enum.GetValues<ArrApp>().OrderByDescending(CountOf).First().Name;

            _hasSearched = true;
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Search failed");
            _searchError = ex.Message;
            _searchResults = [];
            _hasSearched = false;
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task ToggleAsync(MatchedMedia result)
    {
        if (_isAdding)
        {
            return;
        }

        _isAdding = true;
        _activeToggledSourceId = result.Identity.Id;
        _searchHint = null;
        _searchError = null;

        var isMarked = IsSearchResultMarked(result);
        await OnToggle(result.Identity.Id, result.Details.Title ?? string.Empty, isMarked);

        _isAdding = false;
        _activeToggledSourceId = null;
        _focusedResult = null;
    }

    private void ClearFocusedResult(MediaMatchResult result)
    {
        if (_focusedResult == result.Key)
        {
            _focusedResult = null;
        }
    }


}
