<div class="media-grid grid grid-cols-3 gap-x-2.5 gap-y-4 md:grid-cols-4 md:gap-6">
    @if (Loading)
    {
        <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="Skeletons"/>
    }
    else
    {
        @ChildContent
    }
</div>

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public int Skeletons { get; set; } = 12;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
