@using Contracts.Media
@using Contracts.Media.Artwork
@inject IMediaService MediaService
@inject ArtworkSources Artwork
<div class="search-result-row rounded-sm border bg-card @Class @(Media is UnmatchedMedia ? "is-unmatched" : null) @(IsFocused ? "row-focused" : "")"
     style="@_backgroundStyle"
     @onfocusin="OnFocusIn"
     @onfocusout="OnFocusOut">
    <div class="flex items-start justify-between gap-3">
        <div class="search-result-main-content flex items-start">
            <div class="search-result-poster">
                @if (!_failed && Details.PosterUrl is { } poster)
                {
                    <img src="@poster" srcset="@_posterSet" alt="@Details.Title" class="rounded-sm" loading="lazy" decoding="async" @onerror="OnPosterError"/>
                }
                else
                {
                    <LucideIcon Name="image-off" Size="16" Class="text-muted-foreground"/>
                }
            </div>
            <div class="search-result-content min-w-0">
                <div class="text-xs text-muted-foreground flex flex-wrap items-center gap-x-1.5 gap-y-1 space-x-1">
                    <LucideIcon Name="@Details.Type.Icon" Size="13"/>
                    @if (Details.ReleaseDate is { } released)
                    {
                        <span>@released.Year</span>
                    }
                    @foreach (var fact in _displayFacts)
                    {
                        <span aria-hidden="true">•</span>
                        <span>@fact</span>
                    }
                    <span aria-hidden="true">•</span>
                    <SammlarrRatingBadge Ratings="@Details.Ratings" Ids="@_ids" Title="@Details.Title" Media="Media.MatchedId" Strategy="Strategy"/>
                </div>
                <div class="flex items-center gap-2 pt-2 min-w-0">
                    <MediaTitleLink Title="@Details.Title" Ids="@_ids" Class="font-bold truncate text-xl" Side="PopoverSide.Bottom" Align="PopoverAlign.Center"/>
                </div>

                @if (Details.Tagline is { } tagline)
                {
                    <p class="text-xs italic text-muted-foreground line-clamp-1 pt-1">@tagline</p>
                }

                @if (Details.Genres.Count > 0)
                {
                    <div class="search-result-genres pt-1">
                        @foreach (var genre in Details.Genres)
                        {
                            <BbBadge Variant="BadgeVariant.Secondary" Class="px-2 py-0.5">@genre</BbBadge>
                        }
                    </div>
                }

                @if (Details.Summary is { } summary)
                {
                    <p class="text-sm text-foreground line-clamp-2 pt-2">@summary</p>
                }
            </div>
        </div>
        @if (Icons != null)
        {
            <div class="flex items-center gap-1">
                @Icons
            </div>
        }
    </div>
</div>

@code {

    [Parameter] [EditorRequired] public required MediaMatchResult Media { get; set; }
    [Parameter] public string Class { get; set; } = "hover-bg";
    [Parameter] public bool IsFocused { get; set; }
    [Parameter] public EventCallback OnFocusIn { get; set; }
    [Parameter] public EventCallback OnFocusOut { get; set; }
    [Parameter] public RenderFragment? Icons { get; set; }
    [Parameter] public Optional<RatingStrategy> Strategy { get; set; } = new None();

    private MediaDetails Details => Media.Details;

    private string? _backgroundStyle;
    private IReadOnlyList<string> _displayFacts = [];
    private IReadOnlyList<IExternalMediaId> _ids = new List<IExternalMediaId>();
    private bool _failed;
    private string? _poster;
    private string? _posterSet;
    private static readonly ArtworkSize Poster = new(192, 288);
    private static readonly ArtworkSize Backdrop = new(780, 439);
    private string? _lastKey;

    protected override void OnParametersSet()
    {
        if (_lastKey != Media.Key)
        {
            _lastKey = Media.Key;
            _failed = false;
        }
        _backgroundStyle = (Details.BackdropUrl ?? Details.PosterUrl) is { } artwork ? $"--hover-bg: url('{Artwork.Sized(artwork, Backdrop)}')" : null;
        if (Details.PosterUrl != _poster)
        {
            _poster = Details.PosterUrl;
            _posterSet = _poster is { } poster ? Artwork.ByDensity(poster, Poster) : null;
        }

        _displayFacts = MediaFacts.GetDisplayFacts(Details);
        _ids = [.. Media.Externals];
    }

    private async Task OnPosterError()
    {
        if (_posterSet is not null)
        {
            _posterSet = null;
            return;
        }

        _failed = true;
        if (Media is MatchedMedia matched)
        {
            await MediaService.InvalidateAsync([matched.Identity.Id]);
        }
    }

}
