@using UI.Features.Wantlist.Components
@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

@if (ReadOnly)
{
    @Bookmark
}
else
{
    <span class="provenance-trigger" style="--dot-hit: @(Size * 2 / 3)px" @oncontextmenu="Reveal" @oncontextmenu:preventDefault="CanReveal" @onkeydown:stopPropagation="_open">
        <button type="button"
                class="search-result-toggle-btn @(IsToggled ? "is-marked" : "") @(IsToggling ? "pointer-events-none" : "")"
                style="--toggle-active-color: orange"
                title="@Label"
                aria-label="@Label"
                @onclick="ToggleAsync">
            @Bookmark
        </button>
        @if (CanReveal && Item is Some<WantlistItem>(var item))
        {
            <BbPopover Open="_open" OpenChanged="@(open => _open = open)">
                <BbPopoverTrigger AsChild="false" class="provenance-dot" aria-label="Where it came from" title="Where it came from"/>
                <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.End" Offset="10" Class="w-auto p-0 overflow-hidden">
                    <ProvenanceDetails Provenance="item.Provenance" AddedAt="item.AddedAt" ItemId="Result.Identity.Id" Type="Result.Identity.Type"/>
                </BbPopoverContent>
            </BbPopover>
        }
    </span>
}

@code {
    [Parameter] [EditorRequired] public required MatchedMedia Result { get; set; }
    [Parameter] public bool IsToggled { get; set; }
    [Parameter] public bool IsToggling { get; set; }
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public Optional<WantlistItem> Item { get; set; } = new None();
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<MatchedMedia> OnToggle { get; set; }

    private bool _open;

    private string Label => IsToggled ? "Remove from wantlist" : "Add to wantlist";

    private string IconClass => $"transition-opacity duration-150 {(IsToggling ? "opacity-0" : string.Empty)}";

    private bool CanReveal => IsToggled && !IsToggling && Item.IsSome();

    private string? DotColor => Item.When(IsToggled && !IsToggling).Map(item => ColorOf(item.Provenance)).ToNullable();

    private RenderFragment Bookmark =>
        @<span class="relative inline-flex items-center justify-center" style="width: @(Size)px; height: @(Size)px">
            @if (IsToggled)
            {
                <LucideIcon Name="bookmark" Size="@Size" Fill="orange" Color="orange" Class="@IconClass"/>
            }
            else
            {
                <LucideIcon Name="bookmark" Size="@Size" Class="@IconClass"/>
            }
            @if (DotColor is { } color)
            {
                <span class="toggle-dot" style="background: @color"></span>
            }
            @if (IsToggling)
            {
                <span class="absolute inset-0 flex items-center justify-center">
                    <BbSpinner Size="SpinnerSize.Small"/>
                </span>
            }
        </span>;

    protected override void OnParametersSet() => _open &= CanReveal;

    private void Reveal() => _open = CanReveal;

    private Task ToggleAsync() => OnToggle.InvokeAsync(Result);

    private string ColorOf(WantlistItemProvenance provenance)
    {
        return provenance switch
        {
            SinkOrigin sink => Branding.Color(sink.Provider.Service),
            FeedOrigin feed => Branding.Color(feed.Feed.Provider.Service),
            OrphanedOrigin or ManualOrigin => "var(--muted-foreground)",
        };
    }
}
