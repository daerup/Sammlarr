@if (Verdict.ToNullable() is { } verdict)
{
    <img class="rating-mark" src="@VerdictArt(verdict)" alt="" style="--mark-size: @(Size)px"/>
}
else
{
    <ProviderTile Provider="Source.Card.Owner" Size="Size" Decorative="true"/>
}

@code {
    [Parameter] [EditorRequired] public required RatingSource Source { get; set; }

    [Parameter] public int Size { get; set; } = 16;

    [Parameter] public Optional<IMediaRating> Rating { get; set; } = new None();

    private Optional<RatingVerdict> Verdict => Rating.Map(rating => rating.Verdict);

    private string VerdictArt(RatingVerdict verdict) => Assets[$"_content/UI/providers/ratings/{Slug(Source)}-{Slug(verdict)}.svg"];

    private static string Slug(Enum value) => value.ToString().ToLowerInvariant();
}
