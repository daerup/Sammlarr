<div class="unfold-row @(Divided ? "divided" : null) @Class" style="@RowStyle" @attributes="Attributes">
    <BbCollapsible Open="Open" OpenChanged="OpenChanged">
        <BbCollapsibleTrigger AsChild="false"
                              Class="@($"unfold-row-trigger group w-full grid {Grid} {TriggerClass} items-center gap-3.5 pl-5 pr-4 max-md:min-h-[52px] max-md:pl-3.5 text-left bg-foreground/5 hover:bg-foreground/8 transition-colors")">
            <LucideIcon Name="chevron-right" Size="15" Class="text-muted-foreground transition-transform duration-150 group-data-[state=open]:rotate-90"/>
            @(IsPhone && PhoneSummary is not null ? PhoneSummary : Summary)
        </BbCollapsibleTrigger>
        <BbCollapsibleContent>
            @Details
        </BbCollapsibleContent>
    </BbCollapsible>
</div>

@code {
    [CascadingParameter(Name = PhoneLayout.IsPhoneCascade)] private bool IsPhone { get; set; }

    [Parameter, EditorRequired] public required string Columns { get; set; }
    [Parameter] public string? PhoneColumns { get; set; }
    [Parameter] public string? TriggerClass { get; set; }
    [Parameter] public string? Edge { get; set; }
    [Parameter] public bool Divided { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public required RenderFragment Summary { get; set; }
    [Parameter] public RenderFragment? PhoneSummary { get; set; }
    [Parameter, EditorRequired] public required RenderFragment Details { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private string? RowStyle => Edge is null ? Style : $"--edge: {Edge};{Style}";

    private string Grid => IsPhone && PhoneColumns is not null ? PhoneColumns : Columns;
}
