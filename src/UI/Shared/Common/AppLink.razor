<a href="@Href"
   class="@($"app-link{(Muted ? " is-muted" : null)} {Class}".Trim())"
   style="@(Color is null ? null : $"color: {Color}")"
   title="@Title"
   target="@(External ? "_blank" : null)"
   rel="@(External ? "noopener noreferrer" : null)">
    @ChildContent
    @if (Arrow)
    {
        <LucideIcon Name="@(External ? "external-link" : "arrow-up-right")" Size="12" Class="app-link-arrow"/>
    }
</a>

@code {
    [Parameter] [EditorRequired] public required string Href { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment ChildContent { get; set; }

    [Parameter] public bool Arrow { get; set; } = true;

    [Parameter] public bool External { get; set; }

    [Parameter] public bool Muted { get; set; }

    [Parameter] public string? Color { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Title { get; set; }
}
