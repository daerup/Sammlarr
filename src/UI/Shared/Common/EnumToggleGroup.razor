@typeparam TEnum where TEnum : struct, Enum

<BbToggleGroup TValue="TEnum?" Value="Value" ValueChanged="SelectAsync" Required="true" Disabled="Disabled"
               Class="h-10 w-fit gap-0 rounded-md bg-muted p-1 text-muted-foreground" aria-label="Enum selection">
    @foreach (var option in Enum.GetValues<TEnum>())
    {
        <BbToggleGroupItem TValue="TEnum?" Value="@option" Disabled="@DisabledValues.Contains(option)"
                           Class="h-full rounded-sm px-3 hover:text-foreground data-[state=on]:bg-background data-[state=on]:text-foreground data-[state=on]:shadow-xs">
            @if (TooltipProvider is null)
            {
                @option.GetDescription()
            }
            else
            {
                <BbTooltip>
                    <BbTooltipTrigger Focusable="false">@option.GetDescription()</BbTooltipTrigger>
                    <BbTooltipContent>@TooltipProvider(option)</BbTooltipContent>
                </BbTooltip>
            }
        </BbToggleGroupItem>
    }
</BbToggleGroup>

@code {
    [Parameter] public required Func<TEnum, string>? TooltipProvider { get; set; }

    [Parameter] [EditorRequired] public TEnum? Value { get; set; }

    [Parameter] [EditorRequired] public required EventCallback<TEnum> OnChange { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public IReadOnlyCollection<TEnum> DisabledValues { get; set; } = [];

    private Task SelectAsync(TEnum? value) => Optional.Of(value).Match(OnChange.InvokeAsync, () => Task.CompletedTask);
}
