@implements IAsyncDisposable
@inject IJSRuntime Js

@if (TotalPages > 1)
{
    <div class="pager-float">
        <div class="pager-pill @(_docked ? "is-docked" : null)">
            @Control
        </div>
    </div>
    <div class="pager-end" @ref="_end"></div>
}

@code {
    private RenderFragment Control =>
        @<BbPagination Class="pagination-controls"
              CurrentPage="CurrentPage"
              TotalPages="TotalPages"
              CurrentPageChanged="HandleCurrentPageChangedAsync">
    <BbPaginationContent Class="justify-center gap-2">
        <BbPaginationItem Class="pagnation-control">
            <div style="@GetDisabledCursorStyle(IsFirstOrPreviousDisabled)">
                <BbPaginationFirst Disabled="@IsFirstOrPreviousDisabled"/>
            </div>
        </BbPaginationItem>
        <BbPaginationItem Class="pagnation-control">
            <div style="@GetDisabledCursorStyle(IsFirstOrPreviousDisabled)">
                <BbPaginationPrevious Disabled="@IsFirstOrPreviousDisabled"
                                      ShowText="false"
                                      Size="PaginationLinkSize.Icon"/>
            </div>
        </BbPaginationItem>
        <BbPaginationItem Class="px-2">
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                <span>Page</span>
                <div @onfocusout="CommitJumpValueAsync" @onkeydown="HandleJumpInputKeyDownAsync" class="jump-input" style="@JumpInputStyle">
                    <BbNumericInput TValue="int"
                                    Value="_jumpPageValue"
                                    ValueChanged="HandleJumpValueChangedAsync"
                                    DisableDebounce="true"
                                    Disabled="@(IsDisabled || TotalPages <= 1)"/>
                </div>
                <span>of @TotalPages</span>
            </div>
        </BbPaginationItem>
        <BbPaginationItem Class="pagnation-control">
            <div style="@GetDisabledCursorStyle(IsNextOrLastDisabled)">
                <BbPaginationNext Disabled="@IsNextOrLastDisabled"
                                  ShowText="false"
                                  Size="PaginationLinkSize.Icon"/>
            </div>
        </BbPaginationItem>
        <BbPaginationItem Class="pagnation-control">
            <div style="@GetDisabledCursorStyle(IsNextOrLastDisabled)">
                <BbPaginationLast Disabled="@IsNextOrLastDisabled"/>
            </div>
        </BbPaginationItem>
    </BbPaginationContent>
</BbPagination>;

    private int _jumpPageValue = 1;
    private string JumpInputStyle => $"width: calc({Math.Max(1, _jumpPageValue.ToString().Length)} * 9px + 28px);";

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    [Parameter]
    public EventCallback OnReachEnd { get; set; }

    [CascadingParameter(Name = PhoneLayout.IsPhoneCascade)]
    private bool IsPhone { get; set; }

    private ElementReference _end;
    private Task<IJSObjectReference>? _import;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watcher;
    private int _generation;
    private DotNetObjectReference<PaginationControls>? _self;
    private bool _docked;
    private (bool Shown, bool Phone) _watching;
    private (int Current, int Total) _seen;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var wanted = (TotalPages > 1, IsPhone);
        if (wanted != _watching)
        {
            _watching = wanted;
            _seen = (CurrentPage, TotalPages);
            await WatchAsync();
            return;
        }

        if (IsPhone && _watcher is { } watcher && (CurrentPage, TotalPages) != _seen)
        {
            _seen = (CurrentPage, TotalPages);
            await OutlivingTheCircuitAsync(async () => await watcher.InvokeVoidAsync("recheck"));
        }
    }

    private async Task WatchAsync()
    {
        var generation = ++_generation;
        await StopWatchingAsync();
        if (!_watching.Shown)
        {
            _docked = false;
            return;
        }

        var phone = _watching.Phone;
        IJSObjectReference? started = null;
        await OutlivingTheCircuitAsync(async () =>
        {
            _self ??= DotNetObjectReference.Create(this);
            _import ??= Js.InvokeAsync<IJSObjectReference>("import", "./js/pager.js").AsTask();
            _module = await _import;
            started = await _module.InvokeAsync<IJSObjectReference>("watchEnd", _end, _self, phone);
        });

        if (_import is { IsFaulted: true } or { IsCanceled: true })
        {
            _import = null;
        }

        if (generation == _generation && !_disposed)
        {
            _watcher = started;
            return;
        }

        await StopAsync(started);
        if (_disposed)
        {
            await ReleaseAsync();
        }
    }

    private async Task StopWatchingAsync()
    {
        var watcher = _watcher;
        _watcher = null;
        await StopAsync(watcher);
    }

    private async Task StopAsync(IJSObjectReference? watcher)
    {
        if (watcher is null)
        {
            return;
        }

        await OutlivingTheCircuitAsync(async () =>
        {
            await watcher.InvokeVoidAsync("dispose");
            await watcher.DisposeAsync();
        });
    }

    private async Task OutlivingTheCircuitAsync(Func<Task> call)
    {
        try
        {
            await call();
        }
        catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException || (exception is ObjectDisposedException && _disposed)) { }
    }

    [JSInvokable]
    public async Task OnEndInView(bool inView)
    {
        if (inView && IsPhone && CurrentPage < TotalPages)
        {
            await OnReachEnd.InvokeAsync();
        }

        if (inView == _docked)
        {
            return;
        }

        _docked = inView;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await ReleaseAsync();
    }

    private async Task ReleaseAsync()
    {
        await StopWatchingAsync();
        if (_module is { } module)
        {
            _module = null;
            await OutlivingTheCircuitAsync(async () => await module.DisposeAsync());
        }

        _self?.Dispose();
    }

    private static string? GetDisabledCursorStyle(bool isDisabled) => isDisabled ? "cursor: not-allowed;" : null;

    private bool IsFirstOrPreviousDisabled => IsDisabled || CurrentPage <= 1;
    private bool IsNextOrLastDisabled => IsDisabled || CurrentPage >= TotalPages;

    protected override void OnParametersSet()
    {
        _jumpPageValue = CurrentPage;
    }

    private Task HandleCurrentPageChangedAsync(int newPage) => ChangePageAsync(newPage);

    private async Task ChangePageAsync(int newPage)
    {
        if (IsDisabled || newPage < 1 || newPage > TotalPages || newPage == CurrentPage)
        {
            return;
        }

        await PageChanged.InvokeAsync(newPage);
    }

    private Task HandleJumpValueChangedAsync(int value)
    {
        _jumpPageValue = value;
        return Task.CompletedTask;
    }

    private Task CommitJumpValueAsync()
    {
        _jumpPageValue = Math.Clamp(_jumpPageValue, 1, TotalPages);
        return ChangePageAsync(_jumpPageValue);
    }

    private Task HandleJumpInputKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            return CommitJumpValueAsync();
        }

        return Task.CompletedTask;
    }
}

