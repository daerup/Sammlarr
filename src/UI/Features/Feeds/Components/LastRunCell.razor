@using System.Globalization
@using Contracts.Media
@using Domain.Feed.Run
@using UI.Shared.Changes
@using global::Shared
@inject IMediaService Media
@inject TimeProvider Clock

@if (Running is Some<ILiveRun>(var live))
{
    <RunningPill Run="live" Bar="Bar" OnOpen="OnOpenLive"/>
}
else if (Overview.LastRun is Some<FeedRun>(var run))
{
    @if (Bar)
    {
        var segments = RunBar.Segments(run.Counts);
        <BbTooltip DelayDuration="150" Placement="PopoverPlacement.TopStart">
            <BbTooltipTrigger Focusable="false" Class="flex min-w-0 flex-1 items-center *:flex *:min-w-0 *:flex-1 *:items-center">
                @Pill(run)
                <button type="button" class="foot-bar" aria-label="See what this run changed" data-testid="last-run-bar" @onclick="() => OpenAsync(run)">
                    <span class="foot-track">
                        @foreach (var segment in segments)
                        {
                            <i class="block h-full" style="@segment.Style" data-part="@segment.Part"></i>
                        }
                    </span>
                </button>
            </BbTooltipTrigger>
            <BbTooltipContent Class="w-[300px] border bg-popover px-3 py-2.5 text-xs text-muted-foreground shadow-lg" data-testid="last-run-tip">
                <div class="flex justify-between gap-2.5">
                    <b class="font-semibold text-foreground">Run of @Heading(run)</b>
                    <span class="tabular-nums">@run.Duration.Humanize(2, Notation.Symbols) · @("title".ToQuantity(run.Counts.Total, "N0"))</span>
                </div>
                @if (segments.Count > 0)
                {
                <div class="mt-2 text-[10px] font-semibold uppercase tracking-[.07em]">Finding the titles</div>
                <div class="mt-1 flex h-[7px] overflow-hidden rounded-full bg-secondary">
                    @foreach (var segment in segments)
                    {
                        <i class="block h-full" style="@segment.Style"></i>
                    }
                </div>
                <div class="mt-1.5 grid grid-cols-[1fr_auto] gap-x-4 gap-y-0.5" data-testid="last-run-tip-found">
                    @foreach (var segment in RunBar.Legend(segments))
                    {
                        <span class="inline-flex items-center gap-[7px]">
                            <i class="inline-block size-[9px] rounded-[2px]" style="@($"background: {RunBar.Color(segment.Part)}")"></i>@RunBar.Label(segment.Part)
                        </span>
                        <b class="text-right font-semibold tabular-nums text-foreground">@Count(segment.Count)</b>
                    }
                </div>
                }
                <div class="mt-2 text-[10px] font-semibold uppercase tracking-[.07em]">What the run did</div>
                <div class="mt-1 grid grid-cols-[1fr_auto] gap-x-4 gap-y-0.5" data-testid="last-run-tip-did">
                    @foreach (var chip in FeedRunView.Did(run.Counts))
                    {
                        <span class="inline-flex items-center gap-[7px]">
                            @if (chip.Glyph is { } glyph)
                            {
                                <span class="@($"inline-flex w-[13px] justify-center font-bold {Tone(chip.Tone)}")">@glyph</span>
                            }
                            else
                            {
                                <LucideIcon Name="@chip.Icon" Size="13"/>
                            }
                            @chip.Tooltip
                        </span>
                        <b class="@($"text-right font-semibold tabular-nums {(chip.Count > 0 ? Tone(chip.Tone) : "text-foreground")}")">@Count(chip.Count)</b>
                    }
                </div>
                <div class="mt-2 text-[11px] opacity-80">Click for the titles it added, removed or couldn't add</div>
            </BbTooltipContent>
        </BbTooltip>
    }
    else
    {
        <BbTooltip>
            <BbTooltipTrigger AsChild="false" Class="inline-flex" Focusable="false">
                @Pill(run)
            </BbTooltipTrigger>
            <BbTooltipContent>See what this run changed</BbTooltipContent>
        </BbTooltip>
    }
}
else
{
    <span class="last-run is-never">
        <LucideIcon Name="history" Size="14"/>
        <span>Never</span>
        <span class="last-run-badge is-empty">—</span>
    </span>
}

@if (Overview.LastRun is Some<FeedRun>(var last))
{
    <ChangeDialog Open="_open"
                  OnOpenChanged="SetOpenAsync"
                  Title="@Heading(last)"
                  Subtitle="@FeedRunView.Summary(last)"
                  Items="_items"
                  Chips="@FeedRunView.Chips(last.Counts)"
                  OnSelect="ShowDetailsAsync"
                  EmptyMessage="@(FeedRunView.LostItsTitles(last) ? FeedRunView.TitlesGone : "Nothing was added or removed.")"
                  Note="@("run".ToQuantity(_runCount))"
                  NoteHref="@($"/feeds/{UrlGuid.Encode(Overview.Feed.Id.Value)}/runs")"
                  Band="@(FeedRunView.Problem(last) is { } problem ? ProblemBand(last, problem) : null)"
                  BandTone="@(last.Failed ? ChangeBandTone.Bad : ChangeBandTone.Warn)">
        <Badges>
            <FeedStrategyChip Strategy="last.Strategy"/>
            @if (last.Failed)
            {
                <FeedChip Tone="FeedChipTone.Failed" Icon="cloud-off">Failed</FeedChip>
            }
            else if (last.Conclusiveness is not (Conclusiveness.Conclusive or Conclusiveness.Pending))
            {
                <FeedChip Tone="FeedChipTone.Attention" Icon="shield">Guarded</FeedChip>
            }
        </Badges>
    </ChangeDialog>

    <MediaDetailSheet Open="_selected is not null"
                      OnOpenChanged="@(open => { if (!open) { _selected = null; } })"
                      Media="_selected"/>
}

@code {
    [Parameter] [EditorRequired] public required FeedOverview Overview { get; set; }

    [Parameter] public EventCallback<bool> DialogOpenChanged { get; set; }

    [Parameter] public bool Bar { get; set; }

    [Parameter] public Optional<ILiveRun> Running { get; set; } = new None();

    [Parameter] public EventCallback OnOpenLive { get; set; }

    private int _runCount;
    private bool _open;
    private IReadOnlyList<ChangeItem> _items = [];
    private MediaMatchResult? _selected;

    private Task ShowDetailsAsync(MatchedMedia media)
    {
        _selected = media;
        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        _runCount = Overview.History.TotalRuns;
    }

    private async Task OpenAsync(FeedRun run)
    {
        var wanted = run.Items.Select(item => item.MediaId).ToList();
        _items = FeedRunView.Items(run, await Media.GetDetailsByIdAsync(wanted));
        await SetOpenAsync(true);
    }

    private Task SetOpenAsync(bool open)
    {
        _open = open;
        return DialogOpenChanged.InvokeAsync(open);
    }

    private static string Heading(FeedRun run) => run.StartedAt.ToLocalTime().ToString("MMMM d, HH:mm", CultureInfo.InvariantCulture);

    private static string Count(int count) => count.ToString("N0");

    private static string Tone(ChipTone tone)
    {
        return tone switch
        {
            ChipTone.Added => "text-[color:var(--alert-success)]",
            ChipTone.Removed => "text-destructive",
            ChipTone.Neutral => "text-foreground",
            ChipTone.Unmatched => "text-foreground",
        };
    }

    private RenderFragment Pill(FeedRun run) =>
        @<button type="button" class="last-run" @onclick="() => OpenAsync(run)">
            <LucideIcon Name="history" Size="14"/>
            <span>@run.StartedAt.Humanize(Clock.GetUtcNow())</span>
            @if (run.Conclusiveness is Conclusiveness.Pending)
            {
                <span class="last-run-badge">
                    <LucideIcon Name="loader-circle" Size="11"/>
                </span>
            }
            else if (run.Conclusiveness is not Conclusiveness.Conclusive)
            {
                <span class="last-run-badge is-guarded">
                    <LucideIcon Name="shield" Size="11"/>
                </span>
            }
            else
            {
                <span class="last-run-badge">
                    @if (run.Counts.Added > 0)
                    {
                        <span class="is-added">+@run.Counts.Added</span>
                    }
                    @if (run.Counts.Removed > 0)
                    {
                        <span class="is-removed">−@run.Counts.Removed</span>
                    }
                    @if (!run.HasChanges)
                    {
                        <LucideIcon Name="check" Size="11"/>
                    }
                </span>
            }
        </button>;

    private static RenderFragment ProblemBand(FeedRun run, string problem) =>
        @<RunProblem Headline="@problem" Reason="@run.SourceFailure" Failed="run.Failed"/>;
}
