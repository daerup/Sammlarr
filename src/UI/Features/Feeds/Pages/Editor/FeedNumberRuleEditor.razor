@using BlazorBlueprint.Primitives.Filtering
@using FilterOperator = BlazorBlueprint.Primitives.Filtering.FilterOperator

<div class="number-rule">
    @Box(Condition.Value, value => SetAsync(Write(value), Condition.ValueEnd), Label)
    @if (Condition.Operator is FilterOperator.Between)
    {
        <span class="number-rule-and">and</span>
        @Box(Condition.ValueEnd, value => SetAsync(Condition.Value, Write(value)), $"{Label}, upper bound")
    }
</div>

@code {
    [Parameter] [EditorRequired] public required FilterCondition Condition { get; set; }

    [Parameter] [EditorRequired] public required string Label { get; set; }

    [Parameter] [EditorRequired] public required FeedNumberRule Rule { get; set; }

    [Parameter] public RenderFragment? Adornment { get; set; }

    [Parameter] public Func<object?, double> Read { get; set; } = value => value is double number ? number : 0;

    [Parameter] public Func<double, object> Write { get; set; } = amount => amount;

    [Parameter] public EventCallback Changed { get; set; }

    private RenderFragment Box(object? value, Func<double, Task> changed, string label) => @<label class="number-rule-box">
        <BbNumericInput TValue="double"
                        Value="@Read(value)"
                        ValueChanged="changed"
                        Min="Rule.Min"
                        Max="Rule.Max"
                        Step="Rule.Step"
                        ShowButtons="false"
                        AllowNegative="false"
                        AriaLabel="@label"
                        data-number-rule/>
        @if (UnitOf(value) is { } unit)
        {
            <span class="number-rule-unit">@unit</span>
        }
        @if (Adornment is not null)
        {
            <span class="number-rule-adornment">@Adornment</span>
        }
    </label>;

    private string? UnitOf(object? value) => Read(value) is 1 ? Rule.Unit : Rule.Plural ?? Rule.Unit;

    private Task SetAsync(object? value, object? valueEnd)
    {
        Condition.Value = value;
        Condition.ValueEnd = valueEnd;
        return Changed.InvokeAsync();
    }
}
