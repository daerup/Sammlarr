@using BlazorBlueprint.Primitives.Filtering

<FeedNumberRuleEditor Condition="Condition" Label="@Label" Rule="Rule" Read="AmountOf" Write="DurationOf" Changed="Changed">
    <Adornment>
        <span class="flex items-center pr-2.5">
            <BbToggleGroup TValue="DurationUnit?" Value="@_unit" ValueChanged="SetUnitAsync" Required="true"
                           Class="h-5 w-fit gap-0 overflow-hidden rounded-[5px] border border-border text-muted-foreground" aria-label="Unit">
                <BbToggleGroupItem TValue="DurationUnit?" Value="DurationUnit.Minutes" Class="@UnitClass">@RuleWords.Short(DurationUnit.Minutes)</BbToggleGroupItem>
                <BbToggleGroupItem TValue="DurationUnit?" Value="DurationUnit.Hours" Class="@UnitClass">@RuleWords.Short(DurationUnit.Hours)</BbToggleGroupItem>
            </BbToggleGroup>
        </span>
    </Adornment>
</FeedNumberRuleEditor>

@code {
    private const string UnitClass = "h-full rounded-none px-1.5 text-[11px] font-normal hover:bg-transparent hover:text-foreground focus-visible:ring-inset focus-visible:ring-offset-0 data-[state=on]:bg-accent data-[state=on]:text-foreground";

    private DurationUnit _unit = DurationUnit.Minutes;

    [Parameter] [EditorRequired] public required FilterCondition Condition { get; set; }

    [Parameter] [EditorRequired] public required string Label { get; set; }

    [Parameter] [EditorRequired] public required FeedNumberRule Rule { get; set; }

    [Parameter] [EditorRequired] public required EventCallback Changed { get; set; }

    protected override void OnParametersSet()
    {
        if ((Condition.Value ?? Condition.ValueEnd) is Duration duration)
        {
            _unit = duration.Unit;
        }
    }

    private static double AmountOf(object? value) => value is Duration duration ? duration.Amount : 0;

    private object DurationOf(double amount) => new Duration(amount, _unit);

    private static Duration? InUnit(object? value, DurationUnit unit) => value is Duration duration ? duration with { Unit = unit } : null;

    private Task SetUnitAsync(DurationUnit? unit) => Optional.Of(unit).Match(ApplyAsync, () => Task.CompletedTask);

    private Task ApplyAsync(DurationUnit unit)
    {
        _unit = unit;
        if (Condition.Value is null && Condition.ValueEnd is null)
        {
            return Task.CompletedTask;
        }

        Condition.Value = InUnit(Condition.Value, unit);
        Condition.ValueEnd = InUnit(Condition.ValueEnd, unit);
        return Changed.InvokeAsync();
    }
}
