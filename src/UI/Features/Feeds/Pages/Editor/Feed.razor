@page "/feeds/create"
@page "/feeds/edit/{EditFeedId}"
@page "/feeds/clone/{CloneFeedId}"
@implements IDisposable
@using System.Globalization
@using Contracts
@using Contracts.Providers
@using Contracts.DI
@using Contracts.Feed
@using global::Shared
@inject IFeedService FeedService
@inject IKeyedServiceIndex<FeedProvider, IFeedProvider> FeedProviders
@inject NavigationManager NavigationManager
@inject IServiceReadiness Readiness
@inject AccountConnectionPrompt AccountConnectionPrompt
@inject Notifier Notifier
@inject DialogService DialogService
@inject IDateTimeProvider Clock

<PageTitle>@PageTitleText</PageTitle>

<KeyboardShortcut Keys="Ctrl+Enter" OnInvoked="SaveFromShortcutAsync"/>

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@HasUnsavedChanges"/>

<SignInGuard AccessChanged="HandleSignInChangedAsync"/>

<PageContainer Heading="@PageHeadingText"
               Description="@PageDescriptionText"
               HeaderClass="@(IsSignedIn() ? "border-b" : "")">
    <HeaderActions>
        @if (_isSaving)
        {
            <HoverButton Preset="HoverButtonPreset.Success" Disabled="true">
                <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                <span>Saving…</span>
            </HoverButton>
        }
        else
        {
            @if (IsSignedIn() && !_loadingFeed)
            {
                @SaveStatus()
            }
            <HoverButton Preset="HoverButtonPreset.Success"
                         Icon="save"
                         Text="Save"
                         OnClick="HandleSaveAsync"
                         Disabled="!CanSave"/>
        }

        <BbButton Variant="ButtonVariant.Outline" OnClick="Close" Disabled="_isSaving">Close</BbButton>
    </HeaderActions>
    <ChildContent>
        <ProtectedSection GuardState="IsSignedIn"
                          DeniedActionDescription="managing feeds"
                          FallbackAction="() => AccountConnectionPrompt.RequestAsync()">
            @if (_loadingFeed)
            {
                <div class="flex-1 min-h-0 flex flex-row gap-4 overflow-hidden" aria-busy="true">
                    <BbSkeleton Class="flex-1 min-w-0 rounded-lg"/>
                    <BbSkeleton Class="flex-1 min-w-0 rounded-lg"/>
                </div>
            }
            else
            {
                <div class="flex-1 min-h-0 flex flex-row gap-4 overflow-hidden"
                     data-preview-current="@(PreviewCaughtUp ? "true" : "false")"
                     @onkeydown="HandleContainerKeyDownAsync">

                    <FeedConfigPanel @key="_configKey"
                                     Value="@_config"
                                     Pending="@Pending"
                                     Check="@_identifierCheck"
                                     OnChange="@OnConfigChanged"
                                     OnCommit="@StartLoad"/>

                    <FeedPreviewPanel @ref="_previewPanel"
                                      Config="@_config"
                                      SavedFeedId="@_savedFeedId"
                                      DraftFeedId="@_draftId"
                                      Updating="@(_pause is not null || _applying > 0)"
                                      OnStatusChanged="@OnPreviewStatusChanged"/>

                </div>
            }
        </ProtectedSection>
    </ChildContent>
</PageContainer>

@code {

    [Parameter] public string? EditFeedId { get; set; }
    [Parameter] public string? CloneFeedId { get; set; }
    private bool IsEditOrClone => EditFeedId is not null || CloneFeedId is not null;

    private string PageTitleText =>
        EditFeedId is not null ? "Edit feed"
        : CloneFeedId is not null ? "Clone feed"
        : "Create feed";
    private string PageHeadingText => PageTitleText;
    private string PageDescriptionText =>
        EditFeedId is not null ? "Update an existing feed and keep your sync settings in sync."
        : CloneFeedId is not null ? "Create a new feed using values copied from an existing one."
        : "Subscribe to a list from an external provider as a feed.";

    private bool _loadingFeed;
    private bool _isSignedIn;
    private bool IsSignedIn() => _isSignedIn;

    private FeedConfig _config = new();
    private int _storedHash = new FeedConfig().GetSaveHash();
    private int? _storedPreviewHash;
    private FeedConfig? _applied;
    private int _appliedHash;
    private int _seenPreviewHash = new FeedConfig().GetPreviewHash();
    private FeedConfig? _committed;
    private int _loads;
    private FeedId? _savedFeedId;
    private readonly FeedId _draftId = FeedId.From(Guid.NewGuid());
    private FeedStrategy _storedStrategy = new(new Append());

    private bool _isSaving;
    private DateTimeOffset? _savedAt;
    private bool _pendingAutoLoad;
    private PreviewStatus _previewStatus = new();
    private IdentifierCheck? _identifierCheck;
    private FeedPreviewPanel _previewPanel = null!;
    private CancellationTokenSource? _pause;
    private int _applying;

    private int _configKey;

    private static readonly TimeSpan ReplanPause = TimeSpan.FromMilliseconds(300);

    private const string WaitForThePreview = "Wait for the preview";

    private readonly CancellationTokenSource _visit = new();

    private bool HasChanged => _config.GetSaveHash() != _storedHash;
    private bool HasPendingChanges => _applied is null || _appliedHash != _config.GetPreviewHash();
    private bool HasUnsavedChanges => IsSignedIn() && !_loadingFeed && HasChanged;

    private bool ChangesWhatItImports => _storedPreviewHash != _config.GetPreviewHash();
    private bool PreviewShowsIt => _previewStatus.HasResults && !HasPendingChanges;
    private bool PreviewCaughtUp => _applying == 0 && !_previewStatus.IsLoading && _pause is null && !HasPendingChanges;

    private bool Pending => _config.IsTestable && (_committed is not { } committed || !committed.SameSource(_config));

    private bool CanReplan =>
        _config.IsTestable
        && _applied is { } applied
        && applied.SameSource(_config)
        && (_previewStatus.HasResults || _previewStatus.IsLoading || (_previewStatus.HasFailed && !_previewStatus.IsListMissing))
        && FilterDefinitionConverter.Incomplete(_config.Filter).IsNone();

    private bool ListNotFound => IdentifierRefused || (_savedFeedId is null && _previewStatus.IsListMissing);

    private bool IdentifierRefused => _identifierCheck is { Refused: true } check && check.Typed == _config.Identifier.Trim();

    private bool CheckFailed => _identifierCheck is { } check && check.Typed == _config.Identifier.Trim() && check.Answer.IsError();

    private Optional<string> SaveProblem => Optional.When(ListNotFound, () => "List not found").Or(() => _config.Problem);

    private bool CanSave => HasChanged && SaveProblem.IsNone();

    private void OnPreviewStatusChanged(PreviewStatus status) => _previewStatus = status;

    private void OnConfigChanged(FeedConfig config)
    {
        var previous = _config;
        var previewHash = config.GetPreviewHash();
        var previewChanged = previewHash != _seenPreviewHash;
        _config = config;
        _seenPreviewHash = previewHash;
        if (config.Provider != previous.Provider)
        {
            _identifierCheck = null;
            StartLoad();
        }
        else if (previewChanged && config.SameSource(previous))
        {
            ReplanAfterPause();
        }
    }

    private Task HandleSignInChangedAsync(bool hasAccess)
    {
        _isSignedIn = hasAccess;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!IsEditOrClone)
        {
            return;
        }

        _loadingFeed = true;
        await Task.Yield();

        var sourceId = FeedId.From(UrlGuid.Decode(EditFeedId ?? CloneFeedId));
        await (await FeedService.GetAsync())
            .Find(sourceId)
            .Map(overview => overview.Feed)
            .ApplyNone(() => NavigationManager.NavigateTo("/feeds"))
            .Apply(LoadConfigAsync);
    }

    private async Task LoadConfigAsync(Domain.Feed.Feed feed)
    {
        _config = new FeedConfig
        {
            Name = feed.Name.Trim(),
            IsEnabled = feed.Enabled,
            Provider = feed.Provider,
            Strategy = feed.Strategy,
            Identifier = feed.Identifier.Trim(),
            Filter = FilterDefinitionConverter.FromQueryFilter(feed.Filter.ToNullable()),
            Sort = feed.Sort.ToNullable(),
            Limit = feed.Limit.ToNullable(),
            Schedule = feed.Schedule,
            RatingStrategy = feed.RatingStrategy,
            IsProviderAvailable = await Readiness.ReadyAsync(feed.Provider.Service),
        };
        _storedHash = _config.GetSaveHash();
        _seenPreviewHash = _config.GetPreviewHash();
        _storedStrategy = _config.Strategy;
        if (EditFeedId is not null)
        {
            _savedFeedId = feed.Id;
            _storedPreviewHash = _config.GetPreviewHash();
        }
        _configKey++;
        _pendingAutoLoad = true;
        _loadingFeed = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_pendingAutoLoad)
        {
            _pendingAutoLoad = false;
            StartLoad();
        }
    }

    private async Task SaveFromShortcutAsync()
    {
        await HandleSaveAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void StartLoad() => _ = LoadListAsync();

    private async Task LoadListAsync()
    {
        if (!_config.IsTestable || (_committed is { } committed && committed.SameSource(_config) && !CheckFailed))
        {
            return;
        }

        CancelPause();
        var load = ++_loads;
        _committed = _config;
        try
        {
            var typed = _config.Identifier.Trim();
            var answer = await CheckIdentifierAsync(typed);
            if (load == _loads)
            {
                _identifierCheck = new IdentifierCheck(typed, answer);
                await answer.Apply(PreviewAsync);
            }
        }
        catch (OperationCanceledException) when (_visit.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load the list");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<Result<string>> CheckIdentifierAsync(string typed)
    {
        if (_identifierCheck is { } check && check.Answer.Match(stored => stored == typed, _ => false))
        {
            return check.Answer;
        }

        return await FeedProviders[_committed!.Provider!.Value].CheckLinkAsync(typed, _savedFeedId ?? _draftId, _visit.Token);
    }

    private async Task PreviewAsync(string identifier)
    {
        if (_config.SameSource(_committed!))
        {
            _config = _config with { Identifier = identifier };
            _seenPreviewHash = _config.GetPreviewHash();
        }

        var applied = _config with { Provider = _committed!.Provider, Identifier = identifier };
        _committed = applied;
        _applied = applied;
        _appliedHash = applied.GetPreviewHash();
        await ApplyToPreviewAsync(applied);
    }

    private void ReplanAfterPause()
    {
        CancelPause();
        if (!CanReplan)
        {
            return;
        }

        var pause = CancellationTokenSource.CreateLinkedTokenSource(_visit.Token);
        _pause = pause;
        _ = ReplanAfterAsync(pause);
    }

    private async Task ReplanAfterAsync(CancellationTokenSource pause)
    {
        try
        {
            await Task.Delay(ReplanPause, pause.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await ReplanAsync(pause);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReplanAsync(CancellationTokenSource pause)
    {
        if (!ReferenceEquals(_pause, pause))
        {
            return;
        }

        _pause = null;
        pause.Dispose();
        if (!CanReplan)
        {
            return;
        }

        var applied = _config;
        _applied = applied;
        _appliedHash = applied.GetPreviewHash();
        try
        {
            await ApplyToPreviewAsync(applied);
        }
        catch (OperationCanceledException) when (_visit.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to update the preview");
        }
    }

    private async Task ApplyToPreviewAsync(FeedConfig applied)
    {
        _applying++;
        try
        {
            await _previewPanel.ApplyAsync(applied, _visit.Token);
        }
        finally
        {
            _applying--;
        }
    }

    private async Task FlushReplanAsync()
    {
        if (_pause is { } pause)
        {
            await pause.CancelAsync();
            await ReplanAsync(pause);
        }
    }

    private void CancelPause()
    {
        _pause?.Cancel();
        _pause?.Dispose();
        _pause = null;
    }

    private void Close() => NavigationManager.NavigateTo("/feeds");

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!HasUnsavedChanges || _isSaving)
        {
            return;
        }

        var result = await DialogService.ConfirmAsync(
            "Leave without saving?",
            $"Your changes to {FeedName} haven't been saved. They're lost if you leave now.",
            new ConfirmDialogOptions
            {
                ConfirmText = "Discard changes",
                CancelText = "Keep editing",
                Destructive = true,
            }
        );
        if (!result.Confirmed)
        {
            context.PreventNavigation();
        }
    }

    private string FeedName => string.IsNullOrWhiteSpace(_config.Name) ? "this feed" : _config.Name.Trim();

    private RenderFragment? SaveStatus()
    {
        if (HasChanged)
        {
            return SaveProblem.Match(Problem, () => Unsaved);
        }

        return Optional.Of(_savedAt).Map(savedAt => SavedAt(TimeZoneInfo.ConvertTime(savedAt, Clock.Zone).ToString("HH:mm", CultureInfo.InvariantCulture))).ToNullable();
    }

    private static RenderFragment Unsaved => @<span class="mr-1.5 inline-flex items-center gap-1.5 whitespace-nowrap text-sm text-muted-foreground" data-save-status="unsaved">
        <span class="size-[7px] rounded-full bg-[var(--sammlarr-gold)]"></span>
        Unsaved changes
    </span>;

    private static RenderFragment Problem(string problem) => @<span class="mr-1.5 inline-flex items-center gap-1.5 whitespace-nowrap text-sm text-destructive" data-save-status="problem">
        <LucideIcon Name="circle-alert" Size="13"/>
        @problem
    </span>;

    private static RenderFragment SavedAt(string time) => @<span class="mr-1.5 inline-flex items-center gap-1.5 whitespace-nowrap text-sm text-[color:var(--alert-success)]" data-save-status="saved">
        <LucideIcon Name="check" Size="14"/>
        Saved @time
    </span>;

    private async Task HandleSaveAsync()
    {
        if (!CanSave || _isSaving)
        {
            return;
        }

        await FlushReplanAsync();
        if (!await ConfirmSaveAsync() || _isSaving || _visit.IsCancellationRequested)
        {
            return;
        }

        await SaveAsync();
    }

    private Task<bool> ConfirmSaveAsync()
    {
        if (_savedFeedId is not null && _config.Strategy is Mirror mirror && MirrorSwitch.NeedsConfirmation(_storedStrategy, _config.Strategy, _previewStatus.MirrorExposure))
        {
            return ConfirmMirrorSwitchAsync(mirror);
        }

        return ChangesWhatItImports && !PreviewShowsIt ? ConfirmSaveBeforeThePreviewAsync() : Task.FromResult(true);
    }

    private async Task<bool> ConfirmMirrorSwitchAsync(Mirror mirror)
    {
        var result = await DialogService.ConfirmAsync(
            MirrorSwitch.Heading,
            MirrorSwitch.Warning(_previewStatus.MirrorExposure, mirror.AbsenceThreshold),
            new ConfirmDialogOptions
            {
                ConfirmText = MirrorSwitch.Confirm,
                CancelText = _previewStatus.IsLoading ? WaitForThePreview : "Cancel",
                Destructive = true,
            }
        );
        return result.Confirmed;
    }

    private async Task<bool> ConfirmSaveBeforeThePreviewAsync()
    {
        var (preview, cancel) = _previewStatus switch
        {
            { HasFailed: true } => ("the preview didn't finish", "Cancel"),
            { IsLoading: true } => ("the preview is still loading", WaitForThePreview),
            _ => ("the preview doesn't show them yet", "Cancel"),
        };
        var result = await DialogService.ConfirmAsync(
            "Save before the preview has finished?",
            $"Your changes decide what this feed imports, and {preview}. The next run applies them as saved.",
            new ConfirmDialogOptions { ConfirmText = "Save anyway", CancelText = cancel }
        );
        return result.Confirmed;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;

        try
        {
            (await SaveFeedAsync()).Apply(Saved).ApplyError(Refused);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to save feed");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private Task<Result<FeedId>> SaveFeedAsync()
    {
        return _savedFeedId is { } id
            ? FeedService.UpdateAsync(id, BuildUpdateData(), CancellationToken.None)
            : FeedService.CreateAsync(BuildCreateData(), CancellationToken.None);
    }

    private void Saved(FeedId id)
    {
        var created = _savedFeedId is null;
        _savedFeedId = id;
        _storedHash = _config.GetSaveHash();
        _storedPreviewHash = _config.GetPreviewHash();
        _storedStrategy = _config.Strategy;
        _savedAt = Clock.Now;
        if (created && !_visit.IsCancellationRequested)
        {
            NavigationManager.NavigateTo($"/feeds/edit/{UrlGuid.Encode(id.Value)}", replace: true);
        }
    }

    private void Refused(Error error)
    {
        _identifierCheck = new IdentifierCheck(_config.Identifier.Trim(), error);
    }

    private FeedUpdateData BuildUpdateData() =>
        new()
        {
            Name = _config.Name.Trim(),
            IsEnabled = _config.IsEnabled,
            Provider = _config.Provider!.Value,
            Strategy = _config.Strategy,
            Identifier = _config.Identifier.Trim(),
            Filter = Optional.Of(FilterDefinitionConverter.ToQueryFilter(_config.Filter)),
            Sort = Optional.Of(_config.Sort),
            Limit = Optional.Of(_config.Limit),
            Schedule = _config.Schedule,
            RatingStrategy = _config.RatingStrategy,
        };

    private FeedCreateData BuildCreateData() =>
        new()
        {
            Id = Some.Of(_draftId),
            Name = _config.Name.Trim(),
            IsEnabled = _config.IsEnabled,
            Provider = _config.Provider!.Value,
            Strategy = _config.Strategy,
            Identifier = _config.Identifier.Trim(),
            Filter = Optional.Of(FilterDefinitionConverter.ToQueryFilter(_config.Filter)),
            Sort = Optional.Of(_config.Sort),
            Limit = Optional.Of(_config.Limit),
            Schedule = _config.Schedule,
            RatingStrategy = _config.RatingStrategy,
        };

    public void Dispose()
    {
        _visit.Cancel();
        CancelPause();
    }

    private Task HandleContainerKeyDownAsync(KeyboardEventArgs args)
    {
        return args is { CtrlKey: true, Key: "Enter" } ? SaveFromShortcutAsync() : Task.CompletedTask;
    }

}
