@using BlazorBlueprint.Primitives.Filtering
@using FilterOperator = BlazorBlueprint.Primitives.Filtering.FilterOperator

<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter condition">
    <div class="w-[160px] @AdornedClass">
        <BbSelect TValue="string" Value="@Field.Property" ValueChanged="ChangeFieldAsync" DisplayTextSelector="FeedFields.LabelOf" Class="min-w-0 flex-1">
            <BbSelectTrigger>
                <BbSelectValue/>
            </BbSelectTrigger>
            <BbSelectContent>
                @foreach (var field in FeedFields.All)
                {
                    <BbSelectItem Value="@field.Property" Text="@field.Label">
                        <span class="flex items-center gap-2">
                            @field.Label
                            @if (field.ShowsOnly)
                            {
                                <BbBadge Variant="BadgeVariant.Secondary" Class="px-1.5 py-0 text-[11px] font-normal" data-shows-only>Shows</BbBadge>
                            }
                        </span>
                    </BbSelectItem>
                }
            </BbSelectContent>
        </BbSelect>
        @Adornment
    </div>
    <BbSelect TValue="FilterOperator" Value="@Condition.Operator" ValueChanged="ChangeOperatorAsync" Class="w-[180px]">
        <BbSelectTrigger>
            <span class="truncate">@OperatorLabel</span>
        </BbSelectTrigger>
        <BbSelectContent>
            @foreach (var offered in Field.Operators)
            {
                <BbSelectItem Value="@offered.Value" Text="@offered.Text"/>
            }
        </BbSelectContent>
    </BbSelect>
    @switch (Field.Kind)
    {
        case FeedFieldKind.Text:
            <BbInput Value="@(Condition.Value as string)" ValueChanged="SetAsync" Placeholder="Enter value..."
                     UpdateTiming="UpdateTiming.Immediate" Class="w-[180px]"/>
            break;
        case FeedFieldKind.Number:
            <FeedNumberRuleEditor Condition="Condition" Label="@Field.Label" Rule="Field.Number" Changed="Changed"/>
            break;
        case FeedFieldKind.Runtime:
            <FeedRuntimeRuleEditor Condition="Condition" Label="@Field.Label" Rule="Field.Number" Changed="Changed"/>
            break;
        case FeedFieldKind.Choice when IsMultiple:
            <BbMultiSelect TValue="string" Values="@Picked" ValuesChanged="SetPickedAsync" Options="Field.Options" Placeholder="Select..." Class="w-[180px]"/>
            break;
        case FeedFieldKind.Choice:
            <BbSelect TValue="string" Value="@(Condition.Value as string)" ValueChanged="SetAsync" Options="Field.Options" Placeholder="Select..." Class="w-[180px]"/>
            break;
        case FeedFieldKind.Genres:
            <FeedGenreRuleEditor Value="@(Condition.Value as GenreMatch ?? GenreMatch.None)" ValueChanged="SetAsync" Label="@Field.Label"/>
            break;
        case FeedFieldKind.Date:
            <FeedDateRuleEditor Value="@Condition.Value" ValueChanged="SetAsync" Label="@Field.Label"/>
            @if (Condition.Operator is FilterOperator.Between)
            {
                <span class="text-sm text-muted-foreground">and</span>
                <FeedDateRuleEditor Value="@Condition.ValueEnd" ValueChanged="SetEndAsync" Label="@($"{Field.Label}, upper bound")"/>
            }
            break;
    }
    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="shrink-0 text-muted-foreground hover:text-destructive" AriaLabel="Remove condition"
              OnClick="OnRemove">
        <LucideIcon Name="x" Size="16"/>
    </BbButton>
</div>

@code {
    [Parameter] [EditorRequired] public required FilterCondition Condition { get; set; }

    [Parameter] [EditorRequired] public required EventCallback Changed { get; set; }

    [Parameter] [EditorRequired] public required EventCallback OnRemove { get; set; }

    [Parameter] [EditorRequired] public required IReadOnlyDictionary<string, RenderFragment> Adornments { get; set; }

    private FeedField Field => FeedFields.For(Condition.Field);

    private RenderFragment? Adornment => Field.Kind is FeedFieldKind.Runtime ? RuntimeMode : Adornments.GetValueOrDefault(Condition.Field);

    private RenderFragment RuntimeMode => @<FeedRuntimeModeButton Total="IsTotal" TotalChanged="SetTotalAsync"/>;

    private bool IsTotal => Field.IsTotal(Condition.Field);

    private string OperatorLabel => Field.Operators.FirstOrNone(offered => offered.Value == Condition.Operator).Map(offered => offered.Text).GetValueOr(string.Empty);

    private string? AdornedClass => Adornment is null ? null : "field-adorned";

    private bool IsMultiple => FeedFields.TakesPicks(Condition);

    private IEnumerable<string> Picked => Condition.Value as IEnumerable<string> ?? [];

    private Task ChangeFieldAsync(string field)
    {
        if (Field.Names(field))
        {
            return Task.CompletedTask;
        }

        var kind = Field.Kind;
        Condition.Field = field;
        if (!Field.Offers(Condition.Operator) || Field.Kind is FeedFieldKind.Genres)
        {
            Condition.Operator = Field.Operators[0].Value;
        }

        if (kind != Field.Kind)
        {
            Condition.Value = Field.Blank;
            Condition.ValueEnd = Condition.Operator is FilterOperator.Between ? Field.Blank : null;
        }

        return Changed.InvokeAsync();
    }

    private Task ChangeOperatorAsync(FilterOperator chosen)
    {
        var multiple = IsMultiple;
        Condition.Operator = chosen;
        if (multiple != IsMultiple)
        {
            Condition.Value = null;
        }

        Condition.ValueEnd = chosen is FilterOperator.Between ? Condition.ValueEnd ?? Field.Blank : null;

        return Changed.InvokeAsync();
    }

    private Task SetTotalAsync(bool total)
    {
        Condition.Field = Field.NameFor(total);
        return Changed.InvokeAsync();
    }

    private Task SetPickedAsync(IEnumerable<string>? picked) => SetAsync(picked?.ToArray());

    private Task SetEndAsync(object? value)
    {
        Condition.ValueEnd = value;
        return Changed.InvokeAsync();
    }

    private Task SetAsync(object? value)
    {
        Condition.Value = value;
        return Changed.InvokeAsync();
    }
}
