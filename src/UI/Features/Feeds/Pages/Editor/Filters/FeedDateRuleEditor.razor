@inject TimeProvider Clock

<BbPopover Open="_open" OpenChanged="OpenChanged">
    <BbPopoverTrigger AsChild="false" aria-label="@Label"
                      class="flex h-10 w-[180px] items-center gap-2 rounded-md border border-input bg-background px-3 text-sm hover:bg-accent">
        <LucideIcon Name="@(Value is RelativeDate ? "history" : "calendar")" Size="14" Class="shrink-0 -translate-y-px text-muted-foreground"/>
        <span class="@(Value is null ? "truncate text-muted-foreground" : "truncate")" data-date-rule>@Text</span>
    </BbPopoverTrigger>
    <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Class="w-[304px] p-2.5" aria-label="@Label">
        <BbTabs Value="@_tab" ValueChanged="SelectTabAsync">
            <BbTabsList Class="w-full">
                <BbTabsTrigger Value="@DateTab" Class="flex-1">Date</BbTabsTrigger>
                <BbTabsTrigger Value="@RelativeTab" Class="flex-1">Relative</BbTabsTrigger>
            </BbTabsList>
            <BbTabsContent Value="@DateTab">
                <BbCalendar Selected="@(Value as DateTime?)" SelectedChanged="PickAsync" Class="p-0"/>
            </BbTabsContent>
            <BbTabsContent Value="@RelativeTab">
                <div class="flex items-center gap-1.5 pt-2">
                    <BbNumericInput TValue="int" Value="@Relative.Amount" ValueChanged="SetAmountAsync" Min="0" Max="999" ShowButtons="false" AllowNegative="false"
                                    AriaLabel="@($"{Label}, amount")" Class="h-9 w-16"/>
                    <BbSelect TValue="DateUnit" Value="@Relative.Unit" ValueChanged="SetUnitAsync" Options="Units"
                              Class="min-w-0 flex-1 [&_[role=combobox]]:h-9 [&_[role=combobox]]:px-2.5 [&_[role=combobox]]:text-[12.5px]"/>
                    <BbToggleGroup TValue="bool?" Value="@Relative.Ahead" ValueChanged="SetAheadAsync" Required="true"
                                   Class="h-9 w-fit shrink-0 gap-0 overflow-hidden rounded-md border border-border text-muted-foreground" aria-label="Direction">
                        <BbToggleGroupItem TValue="bool?" Value="false" Class="@DirectionClass">ago</BbToggleGroupItem>
                        <BbToggleGroupItem TValue="bool?" Value="true" Class="@DirectionClass">from now</BbToggleGroupItem>
                    </BbToggleGroup>
                </div>
                <p class="mt-3 flex items-center gap-1.5 border-t pt-2 text-xs text-muted-foreground">
                    <LucideIcon Name="calendar" Size="12"/>
                    On today's run: @RuleWords.Day(Relative.On(DateOnly.FromDateTime(Clock.GetLocalNow().DateTime)))
                </p>
            </BbTabsContent>
        </BbTabs>
    </BbPopoverContent>
</BbPopover>

@code {
    private const string DateTab = "date";
    private const string RelativeTab = "relative";
    private const string DirectionClass = "h-full rounded-none whitespace-nowrap px-[9px] text-xs font-normal hover:bg-transparent hover:text-foreground focus-visible:ring-inset focus-visible:ring-offset-0 data-[state=on]:bg-accent data-[state=on]:text-foreground";

    private static readonly RelativeDate Fallback = new(1, DateUnit.Years, Ahead: false);

    private static readonly IReadOnlyList<SelectOption<DateUnit>> Units =
        [new(DateUnit.Days, "days"), new(DateUnit.Weeks, "weeks"), new(DateUnit.Months, "months"), new(DateUnit.Years, "years")];

    private bool _open;

    private string _tab = DateTab;

    private Optional<DateTime> _fixed = new None();

    [Parameter] public object? Value { get; set; }

    [Parameter] public EventCallback<object?> ValueChanged { get; set; }

    [Parameter] [EditorRequired] public required string Label { get; set; }

    private RelativeDate Relative => Value as RelativeDate ?? Fallback;

    private string Text
    {
        get
        {
            return Value switch
            {
                RelativeDate relative => RuleWords.Relative(relative),
                DateTime fixedDay => RuleWords.Day(DateOnly.FromDateTime(fixedDay)),
                _ => "Pick a date",
            };
        }
    }

    protected override void OnParametersSet()
    {
        if (Value is DateTime fixedDay)
        {
            _fixed = Some.Of(fixedDay);
        }
    }

    private void OpenChanged(bool open)
    {
        _open = open;
        if (open)
        {
            _tab = Value is RelativeDate ? RelativeTab : DateTab;
        }
    }

    private Task SelectTabAsync(string tab)
    {
        _tab = tab;
        return (tab, Value) switch
        {
            (RelativeTab, not RelativeDate) => ValueChanged.InvokeAsync(Fallback),
            (DateTab, RelativeDate) => _fixed.Match(day => ValueChanged.InvokeAsync(day), () => Task.CompletedTask),
            _ => Task.CompletedTask,
        };
    }

    private Task PickAsync(DateTime? day)
    {
        _open = false;
        return ValueChanged.InvokeAsync(day);
    }

    private Task SetAmountAsync(int amount) => ValueChanged.InvokeAsync(Relative with { Amount = amount });

    private Task SetUnitAsync(DateUnit unit) => ValueChanged.InvokeAsync(Relative with { Unit = unit });

    private Task SetAheadAsync(bool? ahead) => Optional.Of(ahead).Match(picked => ValueChanged.InvokeAsync(Relative with { Ahead = picked }), () => Task.CompletedTask);
}
