@using BlazorBlueprint.Primitives.Filtering

<div class="space-y-1" role="group" aria-label="@GroupLabel">
    @if (HasLabel || Depth > 0)
    {
        <div class="flex min-h-6 items-center justify-between">
            @if (HasLabel)
            {
                <BbSelect TValue="LogicalOperator" Value="@Group.Operator" ValueChanged="ChangeOperatorAsync" DisplayTextSelector="LogicalText" AriaLabel="Conditions to match" Class="@LabelClass">
                    <BbSelectTrigger>
                        <BbSelectValue/>
                    </BbSelectTrigger>
                    <BbSelectContent Class="min-w-max">
                        @foreach (var option in LogicalOptions)
                        {
                            <BbSelectItem Value="@option.Value" Text="@option.Text"/>
                        }
                    </BbSelectContent>
                </BbSelect>
            }
            @if (Depth > 0)
            {
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="ms-auto size-6 shrink-0 text-muted-foreground hover:text-destructive"
                          AriaLabel="Remove group" OnClick="OnRemove">
                    <LucideIcon Name="x" Size="14"/>
                </BbButton>
            }
        </div>
    }
    <div class="@GroupClass">
        @if (Group.Conditions.Count > 0 || Group.Groups.Count > 0)
        {
            <div class="space-y-2">
                @foreach (var condition in Group.Conditions)
                {
                    <FeedFilterCondition @key="condition.Id" Condition="condition" Changed="Changed" Adornments="Adornments"
                                         OnRemove="@(() => RemoveConditionAsync(condition))"/>
                }
                @foreach (var nested in Group.Groups)
                {
                    <FeedFilterGroup @key="nested" Group="nested" Depth="@(Depth + 1)" Changed="Changed" Adornments="Adornments"
                                     OnRemove="@(() => RemoveGroupAsync(nested))"/>
                }
            </div>
        }
        <div class="flex items-center gap-2">
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="text-xs text-muted-foreground hover:text-foreground" OnClick="AddConditionAsync">
                <LucideIcon Name="plus" Size="14"/>
                Add condition
            </BbButton>
            @if (Depth < MaxDepth)
            {
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="text-xs text-muted-foreground hover:text-foreground" OnClick="AddGroupAsync">
                    <LucideIcon Name="plus" Size="14"/>
                    Add group
                </BbButton>
            }
        </div>
    </div>
</div>

@code {
    private const int MaxDepth = 2;

    [Parameter] [EditorRequired] public required FilterDefinition Group { get; set; }

    [Parameter] public int Depth { get; set; }

    [Parameter] [EditorRequired] public required EventCallback Changed { get; set; }

    [Parameter] public EventCallback OnRemove { get; set; }

    [Parameter] [EditorRequired] public required IReadOnlyDictionary<string, RenderFragment> Adornments { get; set; }

    private static readonly IReadOnlyList<SelectOption<LogicalOperator>> LogicalOptions =
        [new(LogicalOperator.And, "all of"), new(LogicalOperator.Or, "any of")];

    private static string LogicalText(LogicalOperator chosen) => LogicalOptions.Single(option => option.Value == chosen).Text;

    private string GroupLabel => Depth == 0 ? "Root filter group" : $"Nested filter group at depth {Depth}";

    private bool HasLabel => Group.Conditions.Count + Group.Groups.Count > 1;

    private string GroupClass => $"{Frame} {FilterDepth.Stripe(Depth)}";

    private string Frame => Depth == 0 ? "space-y-3 rounded-s-md border-s-4 ps-3" : "space-y-3 rounded-lg border border-s-4 bg-muted/30 p-3";

    private const string Label =
        "w-auto [&_[role=combobox]]:h-6 [&_[role=combobox]]:w-auto [&_[role=combobox]]:min-w-0 [&_[role=combobox]_svg]:ms-0 [&_[role=combobox]]:gap-1 [&_[role=combobox]]:border-0 [&_[role=combobox]]:bg-transparent [&_[role=combobox]]:px-1 [&_[role=combobox]]:text-xs [&_[role=combobox]]:font-semibold [&_[role=combobox]]:shadow-none [&_[role=combobox]]:text-inherit";

    private string LabelClass => $"{Label} {FilterDepth.Tone(Depth)}";


    private Task ChangeOperatorAsync(LogicalOperator chosen)
    {
        Group.Operator = chosen;
        return Changed.InvokeAsync();
    }

    private Task AddConditionAsync()
    {
        Group.Conditions.Add(FeedFields.NewCondition());
        return Changed.InvokeAsync();
    }

    private Task AddGroupAsync()
    {
        Group.Groups.Add(new FilterDefinition { Conditions = [FeedFields.NewCondition()] });
        return Changed.InvokeAsync();
    }

    private Task RemoveConditionAsync(FilterCondition condition)
    {
        Group.Conditions.Remove(condition);
        return Changed.InvokeAsync();
    }

    private Task RemoveGroupAsync(FilterDefinition nested)
    {
        Group.Groups.Remove(nested);
        return Changed.InvokeAsync();
    }
}
