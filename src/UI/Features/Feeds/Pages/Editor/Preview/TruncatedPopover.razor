<VerdictPopover Icon="scissors" Title="Past the import limit" Reason="@Reason" Foot="@(Random ? "The next run draws again." : null)">
    <SlotLineDetail Rank="Rank" LastIn="@LastIn" Title="@Title"/>
</VerdictPopover>

@code {
    [Parameter] [EditorRequired] public required SlotRank Rank { get; set; }

    [Parameter] [EditorRequired] public required string LastIn { get; set; }

    [Parameter] [EditorRequired] public required string Title { get; set; }

    [Parameter] [EditorRequired] public required string Order { get; set; }

    [Parameter] public bool Random { get; set; }

    private string Reason => $"{Rank.Position.Ordinal} in line for {Slots}, {Order}.";

    private string Slots => Rank.Slots == 1 ? "the only slot" : $"the {Rank.Slots} slots";
}
