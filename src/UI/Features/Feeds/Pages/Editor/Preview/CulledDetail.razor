@using Contracts.Processing

<div class="culled-detail">
    @Draw(_blame.Root, 0)
</div>

@code {
    private FilterBlame _blame = null!;

    [Parameter] [EditorRequired] public required QueryFilter Filter { get; set; }

    [Parameter] [EditorRequired] public required FilterChecks Checks { get; set; }

    [Parameter] [EditorRequired] public required MediaQueryRow Row { get; set; }

    [Parameter] [EditorRequired] public required RatingStrategy Strategy { get; set; }

    protected override void OnParametersSet() => _blame = FilterBlame.Of(Filter, Checks);

    private RenderFragment Draw(FilterGroup group, int depth)
    {
        if (_blame.Blames(group))
        {
            return All(group, depth);
        }

        var parts = Parts(_blame.BlamesARuleIn(group) ? group.Predicates : [], group.Groups.Where(_blame.Leads), nested => Draw(nested, depth + 1));
        return depth == 0 && parts.Count == 1 ? parts[0] : Bar(group, depth, parts);
    }

    private RenderFragment All(FilterGroup group, int depth)
    {
        return Bar(group, depth, Parts(group.Predicates, group.Groups.Where(Checks.Fails), nested => All(nested, depth + 1)));
    }

    private List<RenderFragment> Parts(IReadOnlyList<FilterPredicate> rules, IEnumerable<FilterGroup> groups, Func<FilterGroup, RenderFragment> nested)
    {
        var passed = rules.Count(rule => Checks.Counts(rule) && !Checks.Fails(rule));
        return [.. rules.Where(Checks.Fails).Select(Line), .. groups.Select(nested), .. passed > 0 ? [Fold(passed)] : Array.Empty<RenderFragment>()];
    }

    private RenderFragment Line(FilterPredicate rule)
    {
        var written = RuleTexts.Written(FilterDefinitionConverter.ToCondition(rule));
        return @<div class="culled-rule">
                    <span><b>@written.Field</b>@(" ")<span class="culled-rule-operator">@written.Operator</span>@(" ")@written.Value</span>
                    <span class="culled-rule-value">@RuleTexts.Value(rule.Field, Row, Strategy)<span class="culled-rule-mark text-destructive"><LucideIcon Name="x" Size="11"/></span><span class="sr-only">@(", failed")</span></span>
                </div>;
    }

    private static RenderFragment Fold(int passed) => @<div class="culled-fold">and @("rule".ToQuantity(passed)) that passed</div>;

    private static RenderFragment Bar(FilterGroup group, int depth, List<RenderFragment> parts)
    {
        return @<div class="culled-group">
            @if (parts.Count > 1)
            {
                <span class="@($"culled-group-label {FilterDepth.Tone(depth)}")">@Label(group.Operator)</span>
            }
            <div class="@($"culled-group-body {FilterDepth.Stripe(depth)}")">
                @foreach (var part in parts)
                {
                    @part
                }
            </div>
        </div>;
    }

    private static string Label(FilterOperator @operator)
    {
        return @operator switch
        {
            FilterOperator.And => "all of",
            FilterOperator.Or => "any of",
        };
    }
}
