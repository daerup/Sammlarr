<DetailTip Title="@Title" Delay="200" TriggerClass="p-0 cursor-default" PhoneLabel="@Title">
    <Trigger>
        <span class="search-result-status-indicator block">
            <LucideIcon Name="@Icon" Size="24"/>
        </span>
    </Trigger>
    <Detail>
        <div class="@(Edge is null ? "verdict-popover" : "verdict-popover has-edge")">
            @if (Edge is { } share)
            {
                <span class="verdict-popover-edge"><i style="@($"width: {Math.Round(share * 100)}%")"></i></span>
            }
            <div class="verdict-popover-head">
                <p class="verdict-popover-title">@Title</p>
                @Header
            </div>
            @if (Reason is not null)
            {
                <p class="verdict-popover-reason">@Reason</p>
            }
            @if (ChildContent is not null)
            {
                <div class="verdict-popover-detail">@ChildContent</div>
            }
            @if (Foot is not null)
            {
                <p class="verdict-popover-foot">@Foot</p>
            }
        </div>
    </Detail>
</DetailTip>

@code {
    [Parameter] [EditorRequired] public required string Icon { get; set; }

    [Parameter] [EditorRequired] public required string Title { get; set; }

    [Parameter] public string? Reason { get; set; }

    [Parameter] public RenderFragment? Header { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Foot { get; set; }

    [Parameter] public double? Edge { get; set; }
}
