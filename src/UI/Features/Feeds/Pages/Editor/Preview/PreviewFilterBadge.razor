@if (IsPhone)
{
    <button @key="_flashes" type="button" aria-pressed="@(Active ? "true" : "false")" class="preview-filter-badge is-chip @(Active ? "is-active" : null) @(_flashes > 0 ? "is-flashing" : null)" @onclick="OnClick">
        <LucideIcon Name="@Icon" Size="13"/>
        <span>@Label</span>
        <b data-count>@Count</b>
    </button>
}
else
{
    <BbTooltip DelayDuration="0">
        <BbTooltipTrigger AsChild="false" Class="p-0">
            <button @key="_flashes" type="button" aria-label="@($"{Label}: {Count}")" class="preview-filter-badge @(Active ? "is-active" : null) @(_flashes > 0 ? "is-flashing" : null)" @onclick="OnClick">
                <LucideIcon Name="@Icon" Size="14"/>
                <span data-count>@Count</span>
            </button>
        </BbTooltipTrigger>
        <BbTooltipContent data-label-tip="@(!Detailed)">@Tooltip</BbTooltipContent>
    </BbTooltip>
}

@code {
    [CascadingParameter(Name = PhoneLayout.IsPhoneCascade)] private bool IsPhone { get; set; }

    [Parameter] [EditorRequired] public required string Icon { get; set; }
    [Parameter] [EditorRequired] public required int Count { get; set; }
    [Parameter] [EditorRequired] public required string Label { get; set; }
    [Parameter] public bool Detailed { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public int Flash { get; set; }
    [Parameter] public RenderFragment? Tooltip { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private int _seenFlash;
    private int? _shownCount;
    private int _flashes;

    protected override void OnParametersSet()
    {
        if (Flash != _seenFlash && _shownCount is { } shown && shown != Count)
        {
            _flashes++;
        }

        _seenFlash = Flash;
        _shownCount = Count;
    }
}
