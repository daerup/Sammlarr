@using System.Diagnostics
@using System.Globalization
@using Contracts.Blocklist
@using Contracts.DI
@using Contracts.Feed
@using Contracts.Identity
@using Contracts.Media
@using Contracts.Processing
@using Contracts.Settings
@using Contracts.Wantlist
@using Domain.Feed.Run
@using UI.Shared.Services.Branding
@using global::Observability.Tracing
@implements IDisposable
@inject IWantlistService WantlistService
@inject IProviderConfigService ProviderConfig
@inject IBlocklistService BlocklistService
@inject IMediaService Media
@inject IServiceScopeFactory Scopes
@inject ICurrentUser CurrentUser
@inject IFeedRunPlanner Planner
@inject MediaProviderBrandingService Branding
@inject Notifier Notifier
@inject RatingContext RatingContext

<BbCard data-preview-state="@PreviewState" Class="flex-1 min-w-0 flex flex-col overflow-hidden feed-pane rounded-lg bg-card border border-border shadow-sm">
    <div class="shrink-0 sticky top-0 z-20 px-6 pt-6 pb-4 border-b flex items-center gap-2 bg-base-100 rounded-t-lg">
        <BbInput Placeholder="Search media..."
                 Class="w-full"
                 Value="@_searchQuery"
                 ValueChanged="OnSearchQueryChanged"
                 UpdateTiming="UpdateTiming.Debounced"
                 DebounceInterval="250"
                 Disabled="IsLoading"/>
        <LucideIcon Name="search" Class="text-muted-foreground shrink-0"/>
        @if (HasResults)
        {
            <BbAlertDialog @bind-Open="_refreshDialogOpen">
                <BbAlertDialogTrigger>
                    <BbTooltip>
                        <BbTooltipTrigger AsChild="false" Class="inline-flex" Focusable="false">
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Refresh assets">
                                <LucideIcon Name="refresh-cw" Size="16"/>
                            </BbButton>
                        </BbTooltipTrigger>
                        <BbTooltipContent>Refresh assets</BbTooltipContent>
                    </BbTooltip>
                </BbAlertDialogTrigger>
                <BbAlertDialogContent>
                    <BbAlertDialogHeader>
                        <BbAlertDialogTitle>Refresh assets?</BbAlertDialogTitle>
                        <BbAlertDialogDescription>
                            This drops the cached metadata for every item shown and re-fetches it from your providers. It may take a while for large lists.
                        </BbAlertDialogDescription>
                    </BbAlertDialogHeader>
                    <BbAlertDialogFooter>
                        <BbAlertDialogCancel>
                            <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                        </BbAlertDialogCancel>
                        <BbButton Variant="ButtonVariant.Default" OnClick="OnRefreshConfirmedAsync">Refresh</BbButton>
                    </BbAlertDialogFooter>
                </BbAlertDialogContent>
            </BbAlertDialog>
        }
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto scrollbar-thin px-6 pb-4 pt-4 flex flex-col" style="scrollbar-gutter: stable;">
        @if (HasItems)
        {
            <div class="mb-4 shrink-0 flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-base font-semibold tracking-wide flex items-center gap-2">
                        <span>Media Results</span>
                        @if (IsLoading || Updating)
                        {
                            <span class="inline-flex" data-preview-busy>
                                <BbSpinner Size="SpinnerSize.Small"/>
                            </span>
                        }
                    </h2>
                    <p class="text-sm text-muted-foreground mt-0.5">
                        <FeedSourceLink Identifier="@(_appliedConfig?.Identifier ?? Config.Identifier)"
                                        Provider="@(_appliedConfig?.Provider ?? Config.Provider!.Value)"
                                        Muted="true"/>
                    </p>
                    @if (_reloading is { } reloading)
                    {
                        <p class="mt-1 text-xs text-muted-foreground" data-preview-reloading>@reloading.Progress</p>
                    }
                </div>
                <BbTooltipProvider>
                    <div class="flex items-start transition-opacity @DimClass">
                    <div class="stat-badges-row flex items-start text-xs font-medium">
                        <PreviewFilterBadge Flash="_flash" Icon="list" Count="_rawResults.Count" Active="_activeFilters.Count == 0 && !_atRiskOnly" OnClick="ResetFilters">
                            <Tooltip>Total items fetched from the source list. Click to clear filters.</Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Flash="_flash" Icon="check" Count="IncludedCount" Active="IsFilterActive(PreviewBucket.Added)" OnClick="() => ToggleFilter(PreviewBucket.Added)">
                            <Tooltip>Items that will be imported</Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Flash="_flash" Icon="bookmark-check" Count="KeptCount" Active="IsFilterActive(PreviewBucket.Kept)" OnClick="() => ToggleFilter(PreviewBucket.Kept)">
                            <Tooltip>Items this feed already added and still wants. Nothing to import.</Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Flash="_flash" Icon="redo-dot" Count="BypassedCount" Active="IsFilterActive(PreviewBucket.Bypassed)" OnClick="() => ToggleFilter(PreviewBucket.Bypassed)">
                            <Tooltip>
                                <p class="font-medium mb-0.5">Bypasses import</p>
                                <p>@WantlistCount in your wantlist · @BlocklistCount in your blocklist</p>
                                <p class="opacity-70 mt-0.5">These will not be imported.</p>
                            </Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Flash="_flash" Icon="filter-x" Count="FilteredCount" Active="IsFilterActive(PreviewBucket.Filtered)" OnClick="() => ToggleFilter(PreviewBucket.Filtered)">
                            <Tooltip>Items excluded by your filter rules</Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Flash="_flash" Icon="scissors" Count="SkippedCount" Active="IsFilterActive(PreviewBucket.Skipped)" OnClick="() => ToggleFilter(PreviewBucket.Skipped)">
                            <Tooltip>Items excluded by the import limit</Tooltip>
                        </PreviewFilterBadge>
                        <PreviewFilterBadge Flash="_flash" Icon="circle-alert" Count="UnmatchedCount" Active="IsFilterActive(PreviewBucket.Unmatched)" OnClick="() => ToggleFilter(PreviewBucket.Unmatched)">
                            <Tooltip>Items that could not be matched in your media provider</Tooltip>
                        </PreviewFilterBadge>
                    </div>
                    @if (IsMirror && LeavingCount > 0)
                    {
                        <div class="leaving-badge-slot flex items-start text-xs font-medium ml-2 pl-2 border-l border-border">
                            <PreviewFilterBadge Flash="_flash" Icon="log-out" Count="LeavingCount" Active="_atRiskOnly" OnClick="ToggleAtRiskOnly">
                                <Tooltip>
                                    <p class="font-medium mb-0.5">On its way out</p>
                                    <p>@AtRiskCount no longer match your rules@(GoneCount > 0 ? $" · {GoneCount} no longer on the remote list" : null)</p>
                                </Tooltip>
                            </PreviewFilterBadge>
                        </div>
                    }
                    </div>
                </BbTooltipProvider>
            </div>
        }
        @if (_providerUnavailable && HasItems)
        {
            <div class="mb-4 shrink-0 flex items-center justify-between gap-3 rounded-md border border-border bg-muted/40 px-4 py-3">
                <div class="flex items-center gap-2 text-sm">
                    <LucideIcon Name="triangle-alert" Size="18" Class="text-muted-foreground shrink-0"/>
                    <span>The provider became unavailable before the full list finished loading — showing partial results.</span>
                </div>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="RetryAsync" Disabled="IsLoading">
                    <LucideIcon Name="refresh-cw" Size="14" Class="mr-1"/>
                    Retry
                </BbButton>
            </div>
        }
        @if (HasItems && (_filteredResults.Count > 0 || _filteredUnmatchedResults.Count > 0 || _filteredGoneResults.Count > 0))
        {
            @if (_filteredResults.Count > 0)
            {
                <div class="preview-main-results transition-opacity @DimClass">
                <VirtualizeGuard>
                    <Virtualize @key="_filteredResults.Count" Items="_filteredResults" Context="result" ItemSize="215" OverscanCount="6">
                        <ItemContent>
                        @{
                        var item = result.Item;
                        var isCulled = result.Outcome is Culled;
                        var isTruncated = result.Outcome is Truncated;
                        var isAtRisk = IsMirror && result.AtRisk;
                        var isDimmed = (isCulled || isTruncated) && !isAtRisk;
                        var isGreyedOut = result.Bypassed;
                        var isBlocklisted = IsBlocklisted(item);
                        var isInWantlist = IsWantlisted(item);
                        var isTogglingWantlist = _togglingWantlistItem == item.Identity.Id;
                        var isTogglingBlocklist = _togglingBlocklistItem == item.Identity.Id;

                        var hoverStyle = (isAtRisk, isDimmed, isGreyedOut) switch
                        {
                            (true, _, _) => "result-leaving",
                            (false, true, _) => "result-dimmed",
                            (false, false, true) => "result-grey",
                            _ => "hover-bg"
                        };
                        <div class="pb-2">
                                <MediaDetailTile @key="item"
                                                 Media="item"
                                                 Strategy="(_appliedConfig ?? Config).RatingStrategy"
                                                 Class="@(hoverStyle)"
                                                 IsFocused="_focusedResult == item.Key"
                                                 OnFocusIn="() => _focusedResult = item.Key"
                                                 OnFocusOut="() => ClearFocus(item)">
                                    <Icons>
                                        @if (isAtRisk)
                                        {
                                            <LeavingIndicator Reason="@PreviewCopy.AtRiskReason(result)" Threshold="MirrorThreshold" Absences="AbsencesOf(item.Identity.Id)"
                                                              ChildContent="LeavingDetail(result)"/>
                                        }
                                        else
                                        {
                                            @Verdict(result)
                                        }
                                        <WantlistToggleIcon Result="item"
                                                             IsToggled="isInWantlist"
                                                             IsToggling="isTogglingWantlist"
                                                             DotColor="@(result.Enrollment.Owned ? FeedBrandColor : null)"
                                                             OnToggle="ToggleWantlistAsync"/>
                                        <BlocklistToggleIcon Result="item" IsToggled="isBlocklisted" IsToggling="isTogglingBlocklist" OnToggle="ToggleBlocklistAsync"/>
                                    </Icons>
                                </MediaDetailTile>
                            </div>
                        }
                        </ItemContent>
                    </Virtualize>
                </VirtualizeGuard>
                </div>
            }
            @if (_filteredGoneResults.Count > 0)
            {
                <div class="mt-4 preview-gone-results transition-opacity @DimClass">
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider px-1 pb-2">@PreviewCopy.GoneHeading</p>
                    <VirtualizeGuard>
                        <Virtualize @key="_filteredGoneResults.Count" Items="_filteredGoneResults" Context="gone" ItemSize="215" OverscanCount="6">
                            <ItemContent>
                        @{
                                var goneItem = gone.Media;
                                <div class="pb-2">
                                    <MediaDetailTile @key="goneItem"
                                                     Media="goneItem"
                                                     Class="result-leaving"
                                                     IsFocused="_focusedResult == goneItem.Key"
                                                     OnFocusIn="() => _focusedResult = goneItem.Key"
                                                     OnFocusOut="() => ClearFocus(goneItem)">
                                        <Icons>
                                            <LeavingIndicator Reason="@PreviewCopy.GoneReason" Threshold="MirrorThreshold" Absences="AbsencesOf(goneItem.Identity.Id)"/>
                                            <WantlistToggleIcon Result="goneItem"
                                                                 IsToggled="IsWantlisted(goneItem)"
                                                                 IsToggling="_togglingWantlistItem == goneItem.Identity.Id"
                                                                 DotColor="@FeedBrandColor"
                                                                 OnToggle="ToggleWantlistAsync"/>
                                            <BlocklistToggleIcon Result="goneItem"
                                                                 IsToggled="IsBlocklisted(goneItem)"
                                                                 IsToggling="_togglingBlocklistItem == goneItem.Identity.Id"
                                                                 OnToggle="ToggleBlocklistAsync"/>
                                        </Icons>
                                    </MediaDetailTile>
                                </div>
                        }
                            </ItemContent>
                        </Virtualize>
                    </VirtualizeGuard>
                    @if (_goneShortfall > 0)
                    {
                        <p class="text-xs text-muted-foreground px-1 pt-1">+@_goneShortfall more the provider could not describe</p>
                    }
                </div>
            }
            @if (_filteredUnmatchedResults.Count > 0)
            {
                <div class="mt-4 transition-opacity @DimClass">
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider px-1 pb-2">Not found in provider</p>
                    <VirtualizeGuard>
                        <Virtualize @key="_filteredUnmatchedResults.Count" Items="_filteredUnmatchedResults" Context="item" ItemSize="215" OverscanCount="6">
                            <ItemContent>
                        @{
                                <div class="pb-2">
                                    <MediaDetailTile @key="item"
                                                     Media="item"
                                                     IsFocused="_focusedResult == item.Key"
                                                     OnFocusIn="() => _focusedResult = item.Key"
                                                     OnFocusOut="() => ClearFocus(item)">
                                        <Icons>
                                            @if (item is UnmatchedMedia unmatched)
                                            {
                                                <NotFoundPopover Unmatched="unmatched"/>
                                            }
                                        </Icons>
                                    </MediaDetailTile>
                                </div>
                        }
                            </ItemContent>
                        </Virtualize>
                    </VirtualizeGuard>
                </div>
            }
            @if (IsLoading && _reloading is null)
            {
                <div class="mt-2 space-y-2">
                    <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="3"/>
                </div>
            }
        }
        else if (HasItems)
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                <LucideIcon Name="search-x" Size="48" Class="text-muted-foreground mb-4"/>
                <p class="text-lg font-semibold">No results match</p>
                <p class="text-muted-foreground text-sm mt-2">Try adjusting your search or filters.</p>
            </div>
        }
        else if (IsEmptyList)
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                <LucideIcon Name="list-x" Size="48" Class="text-muted-foreground mb-4"/>
                <p class="text-lg font-semibold">The list is empty</p>
                <p class="text-muted-foreground text-sm mt-2">The provider returned no items. Nothing will be imported, and nothing will be removed.</p>
            </div>
        }
        else if (IsLoading)
        {
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaResultsHeader"/>
            <div class="space-y-2">
                <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="8"/>
            </div>
        }
        else if (HasFailed)
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                @if (_providerUnavailable)
                {
                    <LucideIcon Name="cloud-off" Size="48" Class="text-muted-foreground mb-4"/>
                    <p class="text-lg font-semibold">Provider temporarily unavailable</p>
                    <p class="text-muted-foreground text-sm mt-2">The list provider is rate-limited or unreachable right now. Try again in a moment.</p>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="mt-4" OnClick="RetryAsync" Disabled="IsLoading">
                        <LucideIcon Name="refresh-cw" Size="14" Class="mr-1"/>
                        Retry
                    </BbButton>
                }
                else
                {
                    <LucideIcon Name="zap-off" Size="48" Class="mb-4"/>
                    <p class="text-lg font-semibold">@(IsListMissing ? "List not found" : "Couldn't load the list")</p>
                    <p class="text-muted-foreground text-sm mt-2">@(IsListMissing ? "The provider has no list with this identifier. Check the link or the identifier." : "Could not fetch media from the provider. Check the list identifier and try again.")</p>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="mt-4" OnClick="RetryAsync" Disabled="IsLoading">
                        <LucideIcon Name="refresh-cw" Size="14" Class="mr-1"/>
                        Retry
                    </BbButton>
                }
            </div>
        }
        else if (Config.IsTestable)
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                <LucideIcon Name="corner-down-left" Size="48" Class="text-muted-foreground mb-4"/>
                <p class="text-lg font-semibold">Press Enter to load the list</p>
                <p class="text-muted-foreground text-sm mt-2">Or leave the field. Nothing is fetched while you type.</p>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                <LucideIcon Name="list-music" Size="48" Class="text-muted-foreground mb-4"/>
                <p class="text-lg font-semibold">Media results will appear here</p>
                <p class="text-muted-foreground text-sm mt-2">Paste a list's link or its identifier to preview it.</p>
            </div>
        }
    </div>
</BbCard>

@code {

    [Parameter] public required FeedConfig Config { get; set; }
    [Parameter] public FeedId? SavedFeedId { get; set; }
    [Parameter] public required FeedId DraftFeedId { get; set; }
    [Parameter] public bool Updating { get; set; }

    private FeedId PreviewFeedId => SavedFeedId ?? DraftFeedId;
    [Parameter] public EventCallback<PreviewStatus> OnStatusChanged { get; set; }

    private enum FetchState { Idle, Loading, Success, Failed, Missing }

    private FetchState _fetchState = FetchState.Idle;
    private List<Listed<MediaMatchResult>> _rawResults = [];
    private IReadOnlyList<UnmatchedMedia> _unmatchedResults = [];
    private IReadOnlyList<QueryVerdict<MatchedMedia>> _processedResults = [];
    private List<QueryVerdict<MatchedMedia>> _filteredResults = [];
    private List<MediaMatchResult> _filteredUnmatchedResults = [];
    private IReadOnlyDictionary<MediaId, int> _missedRuns = new Dictionary<MediaId, int>();
    private List<GoneItem> _goneResults = [];
    private List<GoneItem> _filteredGoneResults = [];
    private int _goneShortfall;
    private bool _atRiskOnly;
    private FeedConfig? _appliedConfig;
    private RatingView? _ratingView;
    private QueryFilter? _appliedFilter;
    private string _lastIn = string.Empty;
    private CancellationTokenSource? _cts;
    private CancellationToken _visit;
    private PreviewStatus _lastEmittedStatus = new();
    private int _fetchGeneration;
    private int _planGeneration;
    private int _flash;
    private Reading? _reloading;
    private bool _listComplete;

    private bool IsStale => _appliedConfig is { } applied && !applied.SameSource(Config);

    private string DimClass => _reloading is not null || IsStale ? "opacity-40" : string.Empty;

    private sealed class Reading(string fields, int total)
    {
        public int Count { get; set; }

        public string Progress => $"Reading {fields} · {Count.ToString("N0", CultureInfo.InvariantCulture)} of {total.ToString("N0", CultureInfo.InvariantCulture)}";
    }

    private string _searchQuery = string.Empty;
    private readonly HashSet<PreviewBucket> _activeFilters = [];
    private string? _focusedResult;
    private MediaId? _togglingWantlistItem;
    private MediaId? _togglingBlocklistItem;
    private readonly HashSet<MediaId> _wantlisted = [];
    private readonly HashSet<MediaId> _blocklistIds = [];
    private bool _refreshDialogOpen;
    private bool _providerUnavailable;
    private readonly Stopwatch _fetchTimer = new();
    private FieldNeeds _fetchedNeeds = FieldNeeds.None;

    private bool IsLoading => _fetchState == FetchState.Loading;

    private string PreviewState
    {
        get
        {
            return _fetchState switch
            {
                FetchState.Idle => "idle",
                FetchState.Loading => "loading",
                FetchState.Success => "success",
                FetchState.Failed or FetchState.Missing => "failed",
            };
        }
    }

    private bool HasItems => _rawResults.Count > 0;
    private bool HasResults => _fetchState == FetchState.Success && _rawResults.Count > 0;
    private bool IsEmptyList => _fetchState == FetchState.Success && _rawResults.Count == 0;
    private bool HasFailed => _fetchState is FetchState.Failed or FetchState.Missing;
    private bool IsListMissing => _fetchState == FetchState.Missing;

    protected override async Task OnInitializedAsync() => _ratingView = await RatingContext.GetAsync();

    private RenderFragment? Verdict(QueryVerdict<MatchedMedia> result)
    {
        return result.Outcome switch
        {
            Culled culled => CulledVerdict(result.Item, culled),
            Truncated truncated => @<TruncatedPopover Rank="truncated.Rank" LastIn="@_lastIn" Title="@TitleOf(result.Item)" Order="@Order" Random="IsRandomPick"/>,
            Qualified qualified when result.Bypassed => @<BypassedPopover Enrollment="result.Enrollment" Counts="qualified.ConsumesSlot" Limited="HasLimit"/>,
            Qualified => null,
        };
    }

    private RenderFragment CulledVerdict(MatchedMedia item, Culled culled)
    {
        return _ratingView is { } view && _appliedFilter is { } filter
            ? @<CulledPopover Filter="filter" Checks="culled.Checks" Row="RowOf(item, view)" Strategy="StrategyOf(view)"/>
            : @<VerdictPopover Icon="filter-x" Title="Filtered out by your filter rules"/>;
    }

    private RenderFragment? LeavingDetail(QueryVerdict<MatchedMedia> result)
    {
        return result.Outcome switch
        {
            Culled culled when _ratingView is { } view && _appliedFilter is { } filter =>
                @<CulledDetail Filter="filter" Checks="culled.Checks" Row="RowOf(result.Item, view)" Strategy="StrategyOf(view)"/>,
            Truncated truncated => @<SlotLineDetail Rank="truncated.Rank" LastIn="@_lastIn" Title="@TitleOf(result.Item)"/>,
            Culled or Qualified => null,
        };
    }

    private MediaQueryRow RowOf(MatchedMedia item, RatingView view) => MediaQueryRow.From(item, StrategyOf(view), view.Available);

    private RatingStrategy StrategyOf(RatingView view) => (_appliedConfig ?? Config).RatingStrategy.GetValueOr(view.Default);

    private static string TitleOf(MatchedMedia item) => item.Details.Title ?? string.Empty;

    private bool HasLimit => (_appliedConfig ?? Config).Limit is not null;

    private bool IsRandomPick => (_appliedConfig ?? Config).Limit is { Pick: LimitPick.Random };

    private string Order
    {
        get
        {
            return (_appliedConfig ?? Config) switch
            {
                { Limit.Pick: LimitPick.Random } => "drawn at random",
                { Sort: { } sort } => $"sorted by {FeedFields.LabelOf(sort.Property)}",
                _ => "in the list's order",
            };
        }
    }

    private static string LastIn(IReadOnlyList<QueryVerdict<MatchedMedia>> verdicts)
    {
        return verdicts
            .FirstOrNone(verdict => verdict.Outcome is Qualified qualified && qualified.Rank.Match(rank => rank.Position == rank.Slots, () => false))
            .Map(verdict => TitleOf(verdict.Item))
            .GetValueOr(string.Empty);
    }

    protected override void OnParametersSet() => _ = EmitStatusIfChangedAsync();

    public async Task ApplyAsync(FeedConfig config, CancellationToken visit)
    {
        _visit = visit;
        if (visit.IsCancellationRequested)
        {
            return;
        }

        var fresh = _appliedConfig is not { } applied || !applied.SameSource(config) || _fetchState is FetchState.Idle or FetchState.Failed or FetchState.Missing;
        Config = config;
        _appliedConfig = config;

        if (fresh)
        {
            _fetchState = FetchState.Loading;
            ClearResults();
            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);
            await FetchAsync(AsTheFeedReads);
        }
        else if (_reloading is null)
        {
            await CatchUpAsync();
        }

        await EmitStatusIfChangedAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CatchUpAsync()
    {
        var needs = await Planner.NeedsAsync(SynthesizeFeed(), _visit);
        var missing = needs.Required.Except(_fetchedNeeds.Required);
        if (missing.IsEmpty)
        {
            await ReprocessLoadedAsync();
            return;
        }

        if (_fetchState is FetchState.Loading)
        {
            _ = FetchAsync(AsTheFeedReads);
            return;
        }

        List<MediaId> lacking = [.. _rawResults.Select(listed => listed.Item).Matched().Where(item => !(item.Details.Missing & missing).IsEmpty).Select(item => item.Identity.Id)];
        if (lacking.Count == 0)
        {
            _fetchedNeeds = new FieldNeeds(_fetchedNeeds.Required | missing, _fetchedNeeds.Shown);
            await ReprocessLoadedAsync();
            return;
        }

        _ = TopUpAsync(lacking, missing);
    }

    private async Task TopUpAsync(IReadOnlyList<MediaId> lacking, MediaFields missing)
    {
        var reading = new Reading(PreviewCopy.Fields(missing), lacking.Count);
        _reloading = reading;
        _fetchState = FetchState.Loading;
        var (fetch, ct) = await StartFetchAsync();
        await EmitStatusIfChangedAsync();
        await InvokeAsync(StateHasChanged);
        using var marked = UsageCauses.Mark(UsageCause.FeedEditor, Some.Of(PreviewFeedId));
        var read = new Dictionary<MediaId, MediaDetails>();

        try
        {
            var sinceRender = Stopwatch.StartNew();
            await foreach (var answer in Media.GetDetailsAsync(lacking, new FieldNeeds(missing, MediaFields.None), ct).WithCancellation(ct))
            {
                answer.Apply(media => read[media.Identity.Id] = media.Details);
                reading.Count++;
                if (sinceRender.ElapsedMilliseconds >= 150)
                {
                    sinceRender.Restart();
                    await InvokeAsync(StateHasChanged);
                }
            }

            _rawResults = [.. _rawResults.Select(listed => WithDetails(listed, read))];
            _fetchedNeeds = new FieldNeeds(_fetchedNeeds.Required | missing, _fetchedNeeds.Shown);
            _reloading = null;
            _fetchState = FetchState.Success;
            await CatchUpAsync();
        }
        catch (Exception) when (fetch != _fetchGeneration || _visit.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Notify(notifier => notifier.Error(ex, $"Failed to read {PreviewCopy.Fields(missing)}"));
        }
        finally
        {
            if (fetch == _fetchGeneration)
            {
                _reloading = null;
                _fetchState = FetchState.Success;
                await EmitStatusIfChangedAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static Listed<MediaMatchResult> WithDetails(Listed<MediaMatchResult> listed, IReadOnlyDictionary<MediaId, MediaDetails> read)
    {
        if (listed.Item is MatchedMedia matched && read.TryGetValue(matched.Identity.Id, out var details))
        {
            return new Listed<MediaMatchResult>(listed.Position, matched with { Details = details });
        }

        return listed;
    }

    private async Task<(int Fetch, CancellationToken Token)> StartFetchAsync()
    {
        var fetch = ++_fetchGeneration;
        var previous = _cts;
        _cts = CancellationTokenSource.CreateLinkedTokenSource(_visit);
        var token = _cts.Token;
        if (previous is not null)
        {
            await previous.CancelAsync();
            previous.Dispose();
        }

        return (fetch, token);
    }

    private static FieldNeeds AsTheFeedReads(FieldNeeds needs) => needs;

    private static FieldNeeds Patiently(FieldNeeds needs) => new(needs.All, MediaFields.None);

    private async Task RetryAsync()
    {
        _fetchState = FetchState.Idle;
        await ApplyAsync(_appliedConfig ?? Config, _visit);
    }

    private async Task OnRefreshConfirmedAsync()
    {
        if (_visit.IsCancellationRequested || _fetchState == FetchState.Loading || _rawResults.Count == 0)
        {
            return;
        }

        var staleIds = _rawResults.Select(listed => listed.Item).Matched().Select(media => media.Identity.Id).ToList();
        _refreshDialogOpen = false;
        _fetchState = FetchState.Loading;
        ClearResults();
        await RunRefreshAsync(staleIds);
    }

    private async Task RunRefreshAsync(IEnumerable<MediaId> staleIds)
    {
        await Task.Yield();

        try
        {

            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);

            await Media.InvalidateAsync(staleIds, _visit);

            await FetchAsync(Patiently);
            await EmitStatusIfChangedAsync();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FetchAsync(Func<FieldNeeds, FieldNeeds> asking)
    {
        if (_visit.IsCancellationRequested)
        {
            return;
        }

        ClearResults();
        _listComplete = false;
        var (fetch, ct) = await StartFetchAsync();
        using var activity = Instrumentation.Source.StartActivity("FeedPreview", ActivityKind.Internal, default(ActivityContext));
        activity?.SetTag("sammlarr.feed.provider", Config.Provider?.ToString());
        activity?.SetTag("sammlarr.feed.identifier", Config.Identifier?.Trim());
        using var marked = UsageCauses.Mark(UsageCause.FeedEditor, Some.Of(PreviewFeedId));

        var loaded = _rawResults;
        var source = _appliedConfig ?? Config;

        try
        {
            _wantlisted.Clear();
            _blocklistIds.Clear();
            await LoadWantlistAndBlocklistAsync(ct);

            await using var scope = Scopes.CreateAsyncScope();
            using var user = scope.ServiceProvider.GetRequiredService<IUserScope>().As(CurrentUser);
            var service = scope.ServiceProvider.GetRequiredService<IKeyedServiceIndex<FeedProvider, IFeedProvider>>()[source.Provider!.Value];
            _fetchTimer.Restart();
            _fetchedNeeds = asking(await Planner.NeedsAsync(SynthesizeFeed(), ct));
            var reprocessAt = 1;
            var sinceRender = Stopwatch.StartNew();
            await foreach (var item in service.GetFeedItemsAsync(source.Identifier.Trim(), _fetchedNeeds, ct).WithCancellation(ct))
            {
                if (fetch != _fetchGeneration)
                {
                    return;
                }

                loaded.Add(item);
                var reprocessed = loaded.Count >= reprocessAt;
                if (reprocessed)
                {
                    reprocessAt = loaded.Count * 2;
                    if (!await ReprocessAsync(FeedLoadState.Unfinished, ct))
                    {
                        return;
                    }
                }

                if (reprocessed || sinceRender.ElapsedMilliseconds >= 150)
                {
                    sinceRender.Restart();
                    await EmitStatusIfChangedAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
            _fetchTimer.Stop();

            _listComplete = true;
            if (!await ReprocessAsync(FeedLoadState.Finished, ct))
            {
                return;
            }

            _fetchState = FetchState.Success;
            activity?.SetTag("sammlarr.feed.items", _rawResults.Count);

            if (_rawResults.Count == 0)
            {
                Notify(notifier => notifier.Warning("The list loaded successfully but returned no items. Nothing will be imported or removed.", "Empty list"));
                return;
            }

            Notify(notifier => notifier.Info($"Loaded {"item".ToQuantity(_rawResults.Count)} in {_fetchTimer.Elapsed.Humanize(2, Notation.Symbols)}."));
        }
        catch (Exception) when (fetch != _fetchGeneration)
        {
        }
        catch (OperationCanceledException)
        {
            _rawResults = [];
            _unmatchedResults = [];
            _processedResults = [];
            _fetchState = FetchState.Idle;
        }
        catch (FeedIdentifierNotFoundException ex)
        {
            _rawResults = [];
            _unmatchedResults = [];
            _processedResults = [];
            _fetchState = FetchState.Missing;
            Notify(notifier => notifier.Warning($"No list found with identifier '{ex.Identifier}'.", "List not found"));
        }
        catch (RemoteUnavailableException)
        {
            _providerUnavailable = true;
            if (_rawResults.Count == 0)
            {
                _fetchState = FetchState.Failed;
                Notify(notifier => notifier.Warning("The list provider is temporarily unavailable (rate-limited or unreachable). Try again in a moment.", "Provider unavailable"));
                return;
            }

            if (await ReprocessAsync(FeedLoadState.Unfinished, ct))
            {
                _fetchState = FetchState.Success;
                Notify(notifier => notifier.Warning("The provider became unavailable before the full list loaded. Showing partial results. Retry to load the rest.", "Provider unavailable"));
            }
        }
        catch (Exception ex)
        {
            _rawResults = [];
            _unmatchedResults = [];
            _processedResults = [];
            _fetchState = FetchState.Failed;
            Notify(notifier => notifier.Error(ex, "Failed to fetch media"));
        }
    }

    private void ClearResults()
    {
        _reloading = null;
        _rawResults = [];
        _unmatchedResults = [];
        _processedResults = [];
        _filteredResults = [];
        _filteredUnmatchedResults = [];
        _goneResults = [];
        _filteredGoneResults = [];
        _goneShortfall = 0;
        _providerUnavailable = false;
    }

    private async Task<bool> ReprocessAsync(FeedLoadState state, CancellationToken cancellationToken)
    {
        var generation = ++_planGeneration;
        using var marked = UsageCauses.Mark(UsageCause.FeedEditor, Some.Of(PreviewFeedId));
        var feed = SynthesizeFeed();
        var planned = await Planner.PlanAsync(new DraftFeed(feed, new RawFeedLoad(_rawResults, state)), cancellationToken);
        if (generation != _planGeneration)
        {
            return true;
        }

        if (planned is not IFeedPlan plan)
        {
            ClearResults();
            _fetchState = FetchState.Failed;
            Notify(notifier => notifier.Warning("The preview could not finish. Your library or the list provider may be unavailable.", "Preview failed"));
            return false;
        }

        var (gone, shortfall) = await GoneAsync(plan, state, cancellationToken);
        if (generation != _planGeneration)
        {
            return true;
        }

        _processedResults = plan.Verdicts;
        _appliedFilter = feed.Filter.ToNullable();
        _lastIn = LastIn(plan.Verdicts);
        _unmatchedResults = plan.Unmatched;
        _missedRuns = plan is MirrorPlan mirrored ? mirrored.MissedRuns : new Dictionary<MediaId, int>();
        _goneResults = gone;
        _goneShortfall = shortfall;
        RebuildFilteredViews();
        return true;
    }

    private async Task<(List<GoneItem> Gone, int Shortfall)> GoneAsync(IFeedPlan plan, FeedLoadState state, CancellationToken cancellationToken)
    {
        if (state is FeedLoadState.Unfinished || plan is not MirrorPlan mirrored)
        {
            return ([], 0);
        }

        var present = plan.Verdicts.Select(verdict => verdict.Item.Identity.Id).ToHashSet();
        var gone = mirrored.MissedRuns.Keys.Where(id => !present.Contains(id)).OrderByDescending(id => mirrored.MissedRuns[id]).ToList();

        var described = await Media.GetDetailsByIdAsync(gone, cancellationToken);

        List<GoneItem> items = [.. gone.Where(described.ContainsKey).Select(id => new GoneItem(described[id]))];
        return (items, gone.Count - items.Count);
    }

    private FeedLoadState LoadedState() => _listComplete && !_providerUnavailable ? FeedLoadState.Finished : FeedLoadState.Unfinished;

    private Domain.Feed.Feed SynthesizeFeed()
    {
        var applied = _appliedConfig ?? Config;
        return new Domain.Feed.Feed
        {
            Id = PreviewFeedId,
            Name = applied.Name,
            Enabled = applied.IsEnabled,
            Provider = applied.Provider!.Value,
            Strategy = applied.Strategy,
            Identifier = applied.Identifier,
            CreatedAt = DateTimeOffset.MinValue,
            Filter = Optional.Of(FilterDefinitionConverter.ToQueryFilter(applied.Filter)),
            Sort = Optional.Of(applied.Sort),
            Limit = Optional.Of(applied.Limit),
            Schedule = applied.Schedule,
            RatingStrategy = applied.RatingStrategy,
        };
    }

    private void OnSearchQueryChanged(string value)
    {
        _searchQuery = value;
        RebuildFilteredViews();
    }

    private void RebuildFilteredViews()
    {
        _filteredResults =
        [
            .. _processedResults.Where(r =>
                (!_atRiskOnly || r.AtRisk) && PreviewResultFilter.IsVisible(PreviewResultFilter.Bucket(r), _activeFilters) && MatchesSearch(r.Item.Details.Title)
            ),
        ];
        _filteredUnmatchedResults = _atRiskOnly
            ? []
            :
            [
                .. _unmatchedResults
                    .Where(r => PreviewResultFilter.IsVisible(PreviewBucket.Unmatched, _activeFilters) && MatchesSearch(r.Details.Title)),
            ];
        _filteredGoneResults = _activeFilters.Count > 0 ? [] : [.. _goneResults.Where(gone => MatchesSearch(gone.Media.Details.Title))];
        RecountBadges();
    }

    private void ToggleAtRiskOnly()
    {
        _atRiskOnly = !_atRiskOnly;
        _activeFilters.Clear();
        RebuildFilteredViews();
    }

    private bool IsMirror => (_appliedConfig ?? Config).Strategy is Mirror;

    private int MirrorThreshold => (_appliedConfig ?? Config).Strategy is Mirror mirror ? mirror.AbsenceThreshold : 1;

    private int AbsencesOf(MediaId id) => Math.Min(MirrorThreshold, _missedRuns.GetValueOrDefault(id));

    private string FeedBrandColor =>
        (_appliedConfig ?? Config).Provider is { } provider ? Branding.Color(provider.Service) : "currentColor";

    private bool MatchesSearch(string? title)
    {
        return string.IsNullOrWhiteSpace(_searchQuery) || title?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) is true;
    }

    private bool IsFilterActive(PreviewBucket bucket) => _activeFilters.Contains(bucket);

    private void ToggleFilter(PreviewBucket bucket)
    {
        if (!_activeFilters.Add(bucket))
        {
            _activeFilters.Remove(bucket);
        }
        _atRiskOnly = false;
        RebuildFilteredViews();
    }

    private void ResetFilters()
    {
        _activeFilters.Clear();
        _atRiskOnly = false;
        RebuildFilteredViews();
    }

    private Task EmitStatusIfChangedAsync()
    {
        var status = BuildStatus();
        if (_visit.IsCancellationRequested || status == _lastEmittedStatus)
        {
            return Task.CompletedTask;
        }
        _lastEmittedStatus = status;
        return OnStatusChanged.InvokeAsync(status);
    }

    private PreviewStatus BuildStatus() => new()
    {
        IsLoading = IsLoading,
        HasResults = HasResults,
        HasFailed = HasFailed,
        IsListMissing = IsListMissing,
        MirrorExposure = Optional.When(IsMirror && _fetchState == FetchState.Success && !_providerUnavailable, () => LeavingCount),
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private async Task LoadWantlistAndBlocklistAsync(CancellationToken cancellationToken)
    {
        try
        {
            _wantlisted.UnionWith((await WantlistService.GetAsync(cancellationToken)).Ids);
            _blocklistIds.UnionWith((await BlocklistService.GetAsync(cancellationToken)).Ids);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Notify(notifier => notifier.Error(ex, "Failed to fetch media"));
        }
    }

    private void Notify(Action<Notifier> notify)
    {
        if (!_visit.IsCancellationRequested)
        {
            notify(Notifier);
        }
    }

    private async Task ReprocessLoadedAsync()
    {
        try
        {
            if (await ReprocessAsync(LoadedState(), _visit))
            {
                _flash++;
            }
        }
        catch (OperationCanceledException) when (_visit.IsCancellationRequested)
        {
        }
    }

    private int IncludedCount { get; set; }
    private int KeptCount { get; set; }
    private int BypassedCount { get; set; }
    private int FilteredCount { get; set; }
    private int SkippedCount { get; set; }
    private int UnmatchedCount => _unmatchedResults.Count;
    private int AtRiskCount { get; set; }
    private int LeavingCount { get; set; }
    private int GoneCount => _goneResults.Count + _goneShortfall;
    private int WantlistCount { get; set; }
    private int BlocklistCount { get; set; }

    private void RecountBadges()
    {
        var buckets = _processedResults.CountBy(PreviewResultFilter.Bucket).ToDictionary();

        IncludedCount = buckets.GetValueOrDefault(PreviewBucket.Added);
        KeptCount = buckets.GetValueOrDefault(PreviewBucket.Kept);
        BypassedCount = buckets.GetValueOrDefault(PreviewBucket.Bypassed);
        FilteredCount = buckets.GetValueOrDefault(PreviewBucket.Filtered);
        SkippedCount = buckets.GetValueOrDefault(PreviewBucket.Skipped);
        AtRiskCount = IsMirror ? _processedResults.Count(result => result.AtRisk) : 0;
        LeavingCount = AtRiskCount + GoneCount;

        var bypassed = _processedResults.Where(result => PreviewResultFilter.Bucket(result) is PreviewBucket.Bypassed).ToList();
        WantlistCount = bypassed.Count(result => result.Enrollment.InWantlist);
        BlocklistCount = bypassed.Count(result => result.Enrollment.InBlocklist);
    }

    private bool IsBlocklisted(MatchedMedia item) => _blocklistIds.Contains(item.Identity.Id);
    private bool IsWantlisted(MatchedMedia item) => _wantlisted.Contains(item.Identity.Id);

    private void ClearFocus(MediaMatchResult item)
    {
        if (_focusedResult == item.Key)
        {
            _focusedResult = null;
        }
    }

    private async Task ToggleBlocklistAsync(MatchedMedia item)
    {
        if (_togglingBlocklistItem is not null)
        {
            return;
        }

        _togglingBlocklistItem = item.Identity.Id;
        try
        {
            if (_blocklistIds.Contains(item.Identity.Id))
            {
                await BlocklistService.RemoveAsync([item.Identity.Id], CancellationToken.None);
                _blocklistIds.Remove(item.Identity.Id);
            }
            else
            {
                await BlocklistService.AddAsync([item.Identity.Id], CancellationToken.None);
                _blocklistIds.Add(item.Identity.Id);
            }
        }
        catch (UnknownMediaException)
        {
            Notify(notifier => notifier.Warning($"'{item.Details.Title}' isn't ready yet: still loading.", "Can't update blocklist"));
        }
        catch (Exception ex)
        {
            Notify(notifier => notifier.Error(ex, "Failed to update blocklist"));
        }
        finally
        {
            _togglingBlocklistItem = null;
            _focusedResult = null;
            await ReprocessLoadedAsync();
            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleWantlistAsync(MatchedMedia item)
    {
        if (_togglingWantlistItem is not null)
        {
            return;
        }

        _togglingWantlistItem = item.Identity.Id;
        try
        {
            if (IsWantlisted(item))
            {
                await WantlistService.RemoveAsync([item.Identity.Id], CancellationToken.None);
                _wantlisted.Remove(item.Identity.Id);
            }
            else
            {
                var added = await WantlistService.AddAsync([item.Identity.Id], new ManualOrigin(ManualSource.FeedPreview), CancellationToken.None);
                if (added.Unaddressable.Count > 0)
                {
                    var config = await ProviderConfig.GetAsync(_visit);
                    Notify(notifier => notifier.Warning(WantlistNotices.NoMatch(Branding.Name(config.Sink.Service), item.Details.Title), WantlistNotices.CantUpdate));
                }
                else
                {
                    _wantlisted.Add(item.Identity.Id);
                }
            }
        }
        catch (Exception ex)
        {
            Notify(notifier => notifier.Error(ex, "Failed to update wantlist"));
        }
        finally
        {
            _togglingWantlistItem = null;
            _focusedResult = null;
            await ReprocessLoadedAsync();
            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);
        }
    }
}
