@using global::Shared.Options
@using Contracts.Auth
@using Domain.Identity
@inject IAccountLinkService Links
@inject AccountsOptions Accounts

<div class="w-full max-w-md rounded-lg border bg-muted/40 p-8 space-y-4">
    @if (!_loaded)
    {
        <BbSkeleton Class="h-48 w-full rounded-md"/>
    }
    else if (_preview is Some<AccountLinkPreview>(var preview))
    {
        <div class="space-y-1.5 text-center">
            <h2 class="text-lg font-semibold tracking-tight">@Heading</h2>
            <p class="text-sm text-muted-foreground">
                @switch (Kind)
                {
                    case AccountLinkKind.Invite:
                        <text>You were invited as </text><span class="font-medium text-foreground">@preview.DisplayName</span><text>. Choose a password to finish.</text>
                        break;
                    case AccountLinkKind.Reset:
                        <text>For </text><span class="font-medium text-foreground">@preview.DisplayName</span><text>. This link works once.</text>
                        break;
                }
            </p>
        </div>
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="alert-soft-destructive flex items-start gap-3 rounded-lg border px-4 py-3 text-left text-sm" role="alert">
                <LucideIcon Name="circle-alert" Size="18" Class="shrink-0 mt-0.5"/>
                <span class="leading-relaxed">@Error</span>
            </div>
        }
        <form method="post" action="@Action" class="space-y-4">
            <AntiforgeryToken/>
            <input type="hidden" name="user" value="@User"/>
            <input type="hidden" name="token" value="@Token"/>
            @if (Kind == AccountLinkKind.Invite)
            {
                <BbField>
                    <BbFieldLabel For="link-username">Username</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Id="link-username" Value="@preview.DisplayName" Disabled="true" autocomplete="username"/>
                    </BbFieldContent>
                </BbField>
            }
            <BbField>
                <BbFieldLabel For="link-password">New password</BbFieldLabel>
                <BbFieldContent>
                    <BbInput Id="link-password" Name="password" Type="InputType.Password" Required="true" Placeholder="@($"At least {Accounts.MinimumPasswordLength} characters")"
                             autocomplete="new-password"/>
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel For="link-confirmation">Confirm password</BbFieldLabel>
                <BbFieldContent>
                    <BbInput Id="link-confirmation" Name="confirmation" Type="InputType.Password" Required="true" autocomplete="new-password"/>
                </BbFieldContent>
            </BbField>
            <BbButton Type="ButtonType.Submit" Class="w-full">@Submit</BbButton>
        </form>
    }
    else
    {
        <div class="space-y-1.5 text-center">
            <h2 class="text-lg font-semibold tracking-tight">This link no longer works</h2>
            <p class="text-sm text-muted-foreground">It has expired or was already used. Ask your admin for a new one.</p>
        </div>
        <BbButton Variant="ButtonVariant.Outline" Class="w-full" Href="/signin">Go to sign in</BbButton>
    }
</div>

@code {
    [Parameter] [EditorRequired] public required AccountLinkKind Kind { get; set; }

    [Parameter] [EditorRequired] public required Guid User { get; set; }

    [Parameter] [EditorRequired] public required string Token { get; set; }

    [Parameter] public string? Error { get; set; }

    private Optional<AccountLinkPreview> _preview = new None();

    private bool _loaded;

    private string Heading
    {
        get
        {
            return Kind switch
            {
                AccountLinkKind.Invite => "Join Sammlarr",
                AccountLinkKind.Reset => "Choose a new password",
            };
        }
    }

    private string Submit
    {
        get
        {
            return Kind switch
            {
                AccountLinkKind.Invite => "Join",
                AccountLinkKind.Reset => "Save and sign in",
            };
        }
    }

    private string Action
    {
        get
        {
            return Kind switch
            {
                AccountLinkKind.Invite => "/auth/join",
                AccountLinkKind.Reset => "/auth/reset",
            };
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await Task.Yield();
        _preview = UserId.TryFrom(User, out var user) ? await Links.InspectAsync(Kind, user, new Secret(Token)) : new None();
        _loaded = true;
    }
}