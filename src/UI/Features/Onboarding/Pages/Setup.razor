@page "/setup"
@layout AuthLayout
@attribute [AllowAnonymous]
@using Contracts.Auth
@using Contracts.Identity
@using Contracts.Setup
@using Domain.Identity
@using UI.Features.Onboarding.Components
@inject IOnboardingService Onboarding
@inject ISignInService SignIns
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>Set up Sammlarr</PageTitle>

@if (_needsAdmin is { } needsAdmin)
{
    <SetupWizard NeedsAdmin="needsAdmin" Error="@ShownError" SignInWith="ShownSignInWith" Pending="_pending" SwitchingPlex="@(Switch == "plex")"/>
}
else
{
    <BbSkeleton Class="h-[560px] w-[950px] max-w-full rounded-xl"/>
}

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "with")]
    public string? With { get; set; }

    [SupplyParameterFromQuery(Name = "pending")]
    public Guid? PendingId { get; set; }

    [SupplyParameterFromQuery(Name = "switch")]
    public string? Switch { get; set; }

    private AuthProvider? SignInWith => Enum.TryParse<AuthProvider>(With, ignoreCase: true, out var picked) && Enum.IsDefined(picked) ? picked : null;

    private bool PendingLost => PendingId is not null && _pending.IsNone();

    private string? ShownError => PendingLost ? SignInTimeout.Message : Error;

    private AuthProvider? ShownSignInWith => PendingLost ? AuthProvider.Plex : SignInWith;

    private Optional<PendingAdmin> _pending = new None();

    private bool? _needsAdmin;

    private string SignInPage => string.IsNullOrWhiteSpace(Error) ? "/signin?returnUrl=%2Fsetup" : $"/signin?returnUrl=%2Fsetup&authError={Uri.EscapeDataString(Error)}";

    protected override async Task OnInitializedAsync()
    {
        var needsAdmin = await Onboarding.NeedsAdminAsync();
        if (needsAdmin || (CurrentUser.Role == UserRole.Admin && !await Onboarding.IsCompleteAsync()))
        {
            _needsAdmin = needsAdmin;
            return;
        }

        Navigation.NavigateTo(CurrentUser.IsAuthenticated ? "/" : SignInPage, forceLoad: !CurrentUser.IsAuthenticated);
    }

    protected override void OnParametersSet() => _pending = Optional.Of(PendingId).Map(SignIns.Pending);
}