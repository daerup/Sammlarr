<div class="overflow-hidden rounded-lg border bg-card" aria-label="Setup summary">
    @foreach (var row in Rows)
    {
        <div class="setup-summary-row">
            @if (row.Done)
            {
                <LucideIcon Name="circle-check" Size="16" Class="text-success"/>
            }
            else
            {
                <LucideIcon Name="circle-dashed" Size="16" Class="text-muted-foreground"/>
            }
            <span class="text-muted-foreground">@row.Label</span>
            <span>@row.Value</span>
            @if (row.Later)
            {
                <BbButton Variant="ButtonVariant.Link" Size="ButtonSize.Small" Class="ml-auto h-auto p-0 text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground" OnClick="LaterClicked">Add in Settings</BbButton>
            }
        </div>
    }
</div>

@code {
    [Parameter] [EditorRequired] public required IReadOnlyList<SummaryRow> Rows { get; set; }

    [Parameter] public EventCallback LaterClicked { get; set; }
}