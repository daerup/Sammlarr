@using Contracts.Identity
@using Contracts.Setup
@using Domain.Identity
@inject IOnboardingService Onboarding
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

@code {
    private string Welcome
    {
        get
        {
            var here = $"/{Navigation.ToBaseRelativePath(Navigation.Uri)}";
            return here == "/" ? "/welcome" : $"/welcome?returnUrl={Uri.EscapeDataString(here)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var page = CurrentUser.Role switch
        {
            UserRole.Admin => Optional.When(!await Onboarding.IsCompleteAsync(), () => "/setup"),
            UserRole.Member => Optional.When(await Onboarding.NeedsKeyPromptAsync(), () => Welcome),
        };
        page.Apply(target => Navigation.NavigateTo(target));
    }
}