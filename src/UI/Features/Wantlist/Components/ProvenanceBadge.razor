@using UI.Shared.Services.Branding
@inject MediaProviderBrandingService Branding

@{
    var feedUrl = ProvenanceView.RunUrl(Provenance, ItemId);
}
@if (feedUrl is not null && !IsPhone)
{
    <a href="@feedUrl" class="wl-badge-brand inline-flex cursor-pointer" style="@BrandStyle">
        @Badge
    </a>
}
else
{
    <span class="wl-badge-brand inline-flex" style="@BrandStyle">
        @Badge
    </span>
}

@code {
    [CascadingParameter(Name = PhoneLayout.IsPhoneCascade)] private bool IsPhone { get; set; }

    [Parameter, EditorRequired]
    public required WantlistItemProvenance Provenance { get; set; }

    [Parameter, EditorRequired]
    public required DateTimeOffset AddedAt { get; set; }

    [Parameter]
    public MediaId? ItemId { get; set; }

    [Parameter, EditorRequired]
    public required MediaType Type { get; set; }

    private RenderFragment Badge =>
        @<BbBadge Variant="@ProvenanceBadgeVariant(Provenance)" Class="wl-badge">
            <DetailTip Title="Where it came from" TriggerClass="p-0" PhoneClass="relative after:absolute after:-inset-4">
                <Trigger>
                    <span class="flex items-center gap-1 wl-badge-content">
                        <LucideIcon Name="@ProvenanceView.Icon(Provenance)" Size="14" Color="@IconColor"/>
                        <span class="wl-badge-label max-md:sr-only">@ProvenanceView.Label(Provenance, Branding, Type)</span>
                    </span>
                </Trigger>
                <Detail>
                    @if (IsPhone)
                    {
                        <ProvenanceDetails Provenance="Provenance" AddedAt="AddedAt" ItemId="ItemId" Type="Type"/>
                    }
                    else
                    {
                        @ProvenanceView.Description(Provenance, Branding, AddedAt, Type)
                    }
                </Detail>
            </DetailTip>
        </BbBadge>;

    private static BadgeVariant ProvenanceBadgeVariant(WantlistItemProvenance provenance) =>
        provenance.Value switch
        {
            SinkOrigin => BadgeVariant.Secondary,
            ManualOrigin => BadgeVariant.Default,
            FeedOrigin => BadgeVariant.Default,
            OrphanedOrigin => BadgeVariant.Outline,
            _ => BadgeVariant.Secondary,
        };

    private string IconColor => ProvenanceView.BrandColor(Provenance, Branding, Type) ?? "currentColor";

    private string? BrandStyle => ProvenanceView.BrandColor(Provenance, Branding, Type) is { } color ? $"--wl-brand: {color}" : null;
}
