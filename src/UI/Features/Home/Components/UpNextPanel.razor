<SectionCard Look="SectionCardLook.Panel" Title="Up next" Note="@Note" Class="mb-[18px]">
    <UpNextSection Title="Running and queued" Rows="Queued" Empty="Nothing is running or queued right now." OnCancel="OnCancel"/>

    <UpNextSection Title="On a schedule" Rows="NextScheduled" Empty="No feed is on a schedule, so nothing will run on its own."/>
</SectionCard>

@code {
    private const int ScheduledShown = 5;

    [Parameter] public IReadOnlyList<UpNextRow> Queued { get; set; } = [];
    [Parameter] public IReadOnlyList<UpNextRow> Scheduled { get; set; } = [];
    [Parameter] public EventCallback<UpNextRow> OnCancel { get; set; }

    private IReadOnlyList<UpNextRow> NextScheduled => [.. Scheduled.Take(ScheduledShown)];

    private string Note =>
        Queued.Count > 0
            ? $"{Queued.Count} in the queue"
            : Scheduled.Count switch
            {
                0 => "nothing scheduled",
                var count => $"{"feed".ToQuantity(count)} on a schedule",
            };
}
