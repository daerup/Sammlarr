<button type="button" class="sect" aria-expanded="@Open" @onclick="@(() => _open = !Open)">
    <LucideIcon Name="@(Open ? "chevron-down" : "chevron-right")" Size="12"/>
    <span class="sect-title">@Title</span>
    <span class="sect-count">@Rows.Count</span>
</button>

@if (Open)
{
    @if (Rows.Count == 0 && Empty is { } empty)
    {
        <p class="sect-empty">@empty</p>
    }
    @foreach (var row in Rows)
    {
        <div class="row @(row.Kind is UpNextKind.Running ? "is-running" : null)">
            <span class="row-lead">
                @if (row.Brands is [var brand])
                {
                    <BrandedTile Brand="brand"/>
                }
                else if (row.Brands is [var first, var second])
                {
                    <ProviderPairTile First="first" Second="second"/>
                }
                else
                {
                    <span class="row-icon">
                        <LucideIcon Name="@(row.Deleted ? "ghost" : Icon(row.Kind))" Size="12"/>
                    </span>
                }
                @if (row.CanCancel)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@($"Cancel {row.Name}")"
                              Class="row-cancel text-muted-foreground hover:text-destructive" OnClick="() => OnCancel.InvokeAsync(row)">
                        <LucideIcon Name="x" Size="14"/>
                    </BbButton>
                }
            </span>
            <span class="row-body">
                @if (row.Href is { } href)
                {
                    <AppLink Href="@href" Class="min-w-0 text-xs"><span class="row-name">@row.Name</span></AppLink>
                }
                else
                {
                    <span class="row-name">@row.Name</span>
                }
                <span class="row-detail">
                    @if (row.Kind is UpNextKind.Running)
                    {
                        <span class="row-dot"></span>
                    }
                    @row.Detail
                </span>
            </span>
            <span class="row-when">
                @if (row.RunsAt is Some<DateTimeOffset>(var runsAt))
                {
                    <Countdown At="runsAt"/>
                }
                else
                {
                    @row.When
                }
            </span>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<UpNextRow> Rows { get; set; }
    [Parameter] public string? Empty { get; set; }
    [Parameter] public EventCallback<UpNextRow> OnCancel { get; set; }

    private bool? _open;

    private bool Open => _open ?? Rows.Count > 0;

    private static string Icon(UpNextKind kind) =>
        kind switch
        {
            UpNextKind.Running => "loader",
            UpNextKind.Queued => "ellipsis",
            UpNextKind.Waiting => "hourglass",
            UpNextKind.Scheduled => "clock",
        };
}
