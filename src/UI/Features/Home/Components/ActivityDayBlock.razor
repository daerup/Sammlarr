@using System.Globalization
@using UI.Shared.Changes

<div class="dcard">
    <button type="button" class="dtop @(_collapsed ? "is-collapsed" : null)" aria-expanded="@(_collapsed ? "false" : "true")" @onclick="ToggleAsync">
        <span class="dchev"><LucideIcon Name="@(_collapsed ? "chevron-right" : "chevron-down")" Size="13"/></span>
        <span class="dname">@DayName</span>
        <span class="dstat">
            @if (Day.Added.Count > 0)
            {
                <span class="part"><span class="up">+@Day.Added.Count.ToString("N0")</span> added</span>
            }
            @if (Day.Removed.Count > 0)
            {
                <span class="part"><span class="dn">&minus;@Day.Removed.Count.ToString("N0")</span> removed</span>
            }
            <span class="part">@("run".ToQuantity(Day.RunCount))</span>
            @if (IsPhone && _collapsed && Day.Inconclusive.Count > 0)
            {
                <span class="part is-problem">@("problem".ToQuantity(Day.Inconclusive.Count))</span>
            }
        </span>
    </button>

    @if (!_collapsed)
    {
        @if (Day.Feeds.Count > 0)
        {
            <div class="chips">
                @foreach (var feed in Day.Feeds)
                {
                    @if (feed.Gone)
                    {
                        <span class="chip" data-gone="true">@Chip(feed)</span>
                    }
                    else
                    {
                        <a class="chip" href="@FeedHref(feed)">@Chip(feed)</a>
                    }
                }
            </div>
        }

        @if (IsPhone)
        {
            @if (ShownAdded.Count > 0)
            {
                @Rows(ShownAdded, ChangeKind.Added)
            }
            @if (ShownRemoved.Count > 0)
            {
                @RemovedHeading
                @Rows(ShownRemoved, ChangeKind.Removed)
            }
            @if (HiddenRows > 0)
            {
                <button type="button" class="dtoggle" @onclick="ShowAllRowsAsync">
                    <LucideIcon Name="chevron-down" Size="13"/>
                    Show @HiddenRows.ToString("N0") more
                </button>
            }
        }
        else
        {
            @if (Day.Added.Count > 0)
            {
                <PosterTrack Ids="Day.Added" Media="Media" OnSelect="OnSelect" OnNeedMedia="OnNeedMedia"/>
            }

            @if (Day.Removed.Count > 0)
            {
                @RemovedHeading
                <PosterTrack Ids="Day.Removed" Media="Media" OnSelect="OnSelect" OnNeedMedia="OnNeedMedia" Faded="true"/>
            }
        }

        @foreach (var entry in Day.Inconclusive)
        {
            <div class="dproblem">
                <LucideIcon Name="circle-alert" Size="14"/>
                <span>
                    <span class="problem-feed">@entry.FeedName</span> @Problem(entry)
                </span>
            </div>
        }

        <button type="button" class="dtoggle" @onclick="@(() => _expanded = !_expanded)">
            <LucideIcon Name="@(_expanded ? "chevron-down" : "chevron-right")" Size="13"/>
            @(_expanded ? "Hide" : "Show") all @("run".ToQuantity(Day.RunCount))
        </button>

        @if (_expanded)
        {
            <div class="druns">
                @foreach (var entry in Day.Runs)
                {
                    <a class="drun" href="@(entry.Gone ? null : RunHref(entry))" @key="entry.Run.Id">
                        <span class="drun-at">@At(entry)</span>
                        <span class="drun-feed">@entry.FeedName</span>
                        <span class="drun-delta">
                            @if (entry.Inconclusive)
                            {
                                <span class="bad">@(entry.Run.Failed ? "failed" : "inconclusive")</span>
                            }
                            else if (entry.Run.HasChanges)
                            {
                                @if (entry.Run.Counts.Added > 0)
                                {
                                    <span class="up">+@entry.Run.Counts.Added.ToString("N0")</span>
                                }
                                @if (entry.Run.Counts.Removed > 0)
                                {
                                    <span class="dn">&minus;@entry.Run.Counts.Removed.ToString("N0")</span>
                                }
                            }
                            else
                            {
                                <span class="nil">no change</span>
                            }
                        </span>
                    </a>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public required ActivityDay Day { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyDictionary<MediaId, MatchedMedia> Media { get; set; }
    [Parameter] public EventCallback<MatchedMedia> OnSelect { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<MediaId>> OnNeedMedia { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public bool StartsFolded { get; set; }

    [CascadingParameter(Name = PhoneLayout.IsPhoneCascade)] private bool IsPhone { get; set; }

    private const int RowBatch = 20;

    private bool _collapsed;

    private bool _expanded;

    private bool _placedOnPhone;

    private int _rowLimit = RowBatch;

    private readonly HashSet<MediaId> _requested = [];

    private IReadOnlyList<MediaId> ShownAdded => [.. Day.Added.Take(_rowLimit)];

    private IReadOnlyList<MediaId> ShownRemoved => [.. Day.Removed.Take(Math.Max(0, _rowLimit - Day.Added.Count))];

    private int HiddenRows => Math.Max(0, Day.Added.Count + Day.Removed.Count - _rowLimit);

    protected override async Task OnParametersSetAsync()
    {
        if (IsPhone && !_placedOnPhone)
        {
            _placedOnPhone = true;
            _collapsed = StartsFolded;
        }

        await RequestRowMediaAsync();
    }

    private async Task ToggleAsync()
    {
        _collapsed = !_collapsed;
        await RequestRowMediaAsync();
    }

    private async Task ShowAllRowsAsync()
    {
        _rowLimit = int.MaxValue;
        await RequestRowMediaAsync();
    }

    private async Task RequestRowMediaAsync()
    {
        if (!IsPhone || _collapsed)
        {
            return;
        }

        var wanted = ShownAdded.Concat(ShownRemoved).Where(id => !_requested.Contains(id)).ToList();
        if (wanted.Count == 0)
        {
            return;
        }

        _requested.UnionWith(wanted);
        await OnNeedMedia.InvokeAsync(wanted);
    }

    private RenderFragment RemovedHeading =>
        @<div class="dsub">
            <LucideIcon Name="trash-2" Size="11"/>
            Removed
        </div>;

    private RenderFragment Rows(IReadOnlyList<MediaId> ids, ChangeKind kind) =>
        @<div class="day-rows">
            @foreach (var id in ids)
            {
                @if (Media.TryGetValue(id, out var media))
                {
                    <ChangeRow @key="id.Value" Item="ItemOf(media, kind)" OnSelect="OnSelect"/>
                }
            }
        </div>;

    private static ChangeItem ItemOf(MatchedMedia media, ChangeKind kind)
    {
        return new ChangeItem
        {
            Title = media.Details.Title ?? "Unknown title",
            Id = media.Identity.Id,
            Media = media,
            Kind = kind,
            Subtitle = media.Details.Year?.ToString(),
        };
    }

    private string DayName =>
        Day.Date == Today ? "Today"
        : Day.Date == Today.AddDays(-1) ? "Yesterday"
        : Day.Date.Year == Today.Year ? Day.Date.ToString("dddd d MMMM", CultureInfo.InvariantCulture)
        : Day.Date.ToString("d MMMM yyyy", CultureInfo.InvariantCulture);

    private static string At(ActivityRun entry) => entry.Run.StartedAt.ToLocalTime().ToString("HH:mm");

    private static string Problem(ActivityRun entry) =>
        entry.Run.Failed ? $"failed at {At(entry)}: {entry.Reason}"
        : entry.Reason is { } reason ? $"ran at {At(entry)} but {entry.Outcome}. {reason}"
        : $"ran at {At(entry)} but {entry.Outcome}.";

    private static RenderFragment Chip(FeedContribution feed) =>
        @<text>
            <LucideIcon Name="@(feed.Gone ? "ghost" : "rss")" Size="11"/>
            <span class="chip-name">@feed.Name</span>
            @if (feed.Added > 0)
            {
                <b>+@feed.Added.ToString("N0")</b>
            }
            @if (feed.Removed > 0)
            {
                <span class="chip-rm">&minus;@feed.Removed.ToString("N0")</span>
            }
            @if (feed.Runs > 1)
            {
                <span class="chip-runs">&times;@feed.Runs</span>
            }
        </text>;

    private static string FeedHref(FeedContribution feed) =>
        $"/feeds/{UrlGuid.Encode(feed.FeedId.Value)}/runs/{UrlGuid.Encode(feed.LatestRunId.Value)}";

    private static string RunHref(ActivityRun entry) => $"/feeds/{UrlGuid.Encode(entry.Run.FeedId.Value)}/runs/{UrlGuid.Encode(entry.Run.Id.Value)}";
}
