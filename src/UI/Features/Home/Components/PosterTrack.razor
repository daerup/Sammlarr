@using Contracts.Media.Artwork
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject ArtworkSources Artwork

<div class="track-wrap">
    @if (_canLeft)
    {
        <button type="button" class="track-arrow left" aria-label="Scroll back" @onclick="ScrollLeftAsync">
            <LucideIcon Name="chevron-left" Size="16"/>
        </button>
    }
    <div class="track" @ref="_track">
        @foreach (var id in Shown)
        {
            @if (Media.TryGetValue(id, out var media))
            {
                <button type="button" class="track-tile @(Faded ? "faded" : "")" @key="id.Value" @onclick="() => OnSelect.InvokeAsync(media)">
                    @if (media.Details.PosterUrl is { } poster)
                    {
                        <img class="track-poster" src="@poster" srcset="@SrcSet(id, poster)" alt="" loading="lazy" @onerror="() => _unsized.Add(id)"/>
                    }
                    else
                    {
                        <span class="track-blank">
                            <LucideIcon Name="image-off" Size="20"/>
                        </span>
                    }
                    <span class="track-scrim"></span>
                    <span class="track-title">@Title(media)</span>
                </button>
            }
        }
    </div>
    @if (CanRight)
    {
        <button type="button" class="track-arrow right" aria-label="Scroll forward" @onclick="ScrollRightAsync">
            <LucideIcon Name="chevron-right" Size="16"/>
        </button>
    }
</div>

@code {
    private const int Batch = 30;
    private static readonly ArtworkSize Poster = new(110, 165);
    private static readonly ArtworkSize FadedPoster = new(78, 117);

    [Parameter, EditorRequired] public required IReadOnlyList<MediaId> Ids { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyDictionary<MediaId, MatchedMedia> Media { get; set; }
    [Parameter] public EventCallback<MatchedMedia> OnSelect { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<MediaId>> OnNeedMedia { get; set; }
    [Parameter] public bool Faded { get; set; }

    private ElementReference _track;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watcher;
    private Task<IJSObjectReference?>? _observing;
    private DotNetObjectReference<PosterTrack>? _self;
    private readonly HashSet<MediaId> _requested = [];
    private readonly HashSet<MediaId> _unsized = [];
    private int _rendered = Batch;
    private bool _canLeft;
    private bool _canScrollRight;
    private bool _disposed;

    private IReadOnlyList<MediaId> Shown => Ids.Count <= _rendered ? Ids : [.. Ids.Take(_rendered)];

    private bool CanRight => _canScrollRight || _rendered < Ids.Count;

    protected override async Task OnParametersSetAsync()
    {
        _rendered = Math.Min(_rendered, Math.Max(Batch, Ids.Count));
        await RequestMediaAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _self = DotNetObjectReference.Create(this);
                _observing = ObserveAsync(_self);
                _watcher = await _observing;
            }
            else if (_watcher is not null)
            {
                await _watcher.InvokeVoidAsync("report");
            }
        }
        catch (ObjectDisposedException) when (_disposed) { }
    }

    [JSInvokable]
    public Task OnScrollState(bool canLeft, bool canRight)
    {
        if (canLeft == _canLeft && canRight == _canScrollRight)
        {
            return Task.CompletedTask;
        }

        _canLeft = canLeft;
        _canScrollRight = canRight;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static string Title(MatchedMedia media) => media.Details.Title ?? "Unknown title";

    private string? SrcSet(MediaId id, string poster) => _unsized.Contains(id) ? null : Artwork.ByDensity(poster, Faded ? FadedPoster : Poster);

    private async Task RequestMediaAsync()
    {
        var wanted = Shown.Where(id => !_requested.Contains(id)).ToList();
        if (wanted.Count == 0)
        {
            return;
        }

        _requested.UnionWith(wanted);
        await OnNeedMedia.InvokeAsync(wanted);
    }

    private async Task ScrollRightAsync()
    {
        if (!_canScrollRight && _rendered < Ids.Count)
        {
            _rendered = Math.Min(_rendered + Batch, Ids.Count);
            await RequestMediaAsync();
            StateHasChanged();
        }

        await ScrollAsync("scrollForward");
    }

    private Task ScrollLeftAsync() => ScrollAsync("scrollBack");

    private async Task ScrollAsync(string action) => await (await Module()).InvokeVoidAsync(action, _track);

    private async Task<IJSObjectReference> Module() => _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/poster-track.js");

    private async Task<IJSObjectReference?> ObserveAsync(DotNetObjectReference<PosterTrack> self) =>
        await (await Module()).InvokeAsync<IJSObjectReference?>("observe", _track, self);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_observing is not null && await _observing is { } watcher)
            {
                await watcher.InvokeVoidAsync("dispose");
                await watcher.DisposeAsync();
            }
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }

        _self?.Dispose();
    }
}
