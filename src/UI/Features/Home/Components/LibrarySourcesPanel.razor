<div class="band">
    <div class="band-head">
        <span class="band-title">Where your library came from</span>
        <span class="band-note">@Note</span>
    </div>

    @if (Sources.Count == 0)
    {
        <p class="band-empty">Nothing on your wantlist yet, so there is nothing to attribute.</p>
    }
    else
    {
        <div class="band-body">
            <StackedBar Size="BarSize.Large" ShowLegend="true" HiddenChanged="OnHidden">
                <Title>@("title".ToQuantity(ShownTotal, "N0"))</Title>
                <ChildContent>
                    @foreach (var source in Sources)
                    {
                        <StackedBarPart Name="@source.Name" Value="source.Count" Color="@source.Color.ToNullable()"/>
                    }
                </ChildContent>
            </StackedBar>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<SourceShare> Sources { get; set; }
    [Parameter] public int Total { get; set; }

    private IReadOnlySet<string> _hidden = new HashSet<string>();

    private int ShownTotal => Sources.Where(source => !_hidden.Contains(source.Name)).Sum(source => source.Count);

    private string Note => ShownTotal == Total ? "title".ToQuantity(Total, "N0") : $"{ShownTotal:N0} of {"title".ToQuantity(Total, "N0")}";

    private void OnHidden(IReadOnlySet<string> hidden) => _hidden = hidden;
}
