<BbDialogHeader>
    <BbDialogTitle>@Title</BbDialogTitle>
    <BbDialogDescription>@Description</BbDialogDescription>
</BbDialogHeader>
<LinkBox Link="@Link"/>
<BbDialogFooter data-dialog-actions>
    <BbDialogClose>
        <BbButton data-dialog-commit Size="ButtonSize.Small">Done</BbButton>
    </BbDialogClose>
</BbDialogFooter>

@code {
    [Parameter] [EditorRequired] public required string Title { get; set; }

    [Parameter] [EditorRequired] public required string Description { get; set; }

    [Parameter] [EditorRequired] public required string Link { get; set; }
}