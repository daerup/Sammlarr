@using Contracts.Identity
@using Contracts.Settings
@inject ICurrentUser CurrentUser
@inject IProviderConfigService ProviderConfigService

@if (_signIn is { } signIn)
{
    <div class="overflow-hidden rounded-lg border bg-card" data-you>
        <BbCollapsible @bind-Open="_open">
            <div class="flex items-center gap-3.5 bg-foreground/5 py-3 pl-5 pr-4">
                <BbAvatar Size="AvatarSize.Small">
                    @if (CurrentUser.AvatarUrl.Length > 0)
                    {
                        <BbAvatarImage Source="@CurrentUser.AvatarUrl" Alt="@CurrentUser.DisplayName"/>
                    }
                    <BbAvatarFallback>@Initial</BbAvatarFallback>
                </BbAvatar>
                <span class="flex min-w-0 flex-col">
                    <span class="truncate text-sm font-medium">@CurrentUser.DisplayName</span>
                    <span class="truncate text-xs text-muted-foreground" data-signs-in>@CurrentUser.Role · @PersonRow.SignsIn(signIn)</span>
                </span>
                @if (signIn == AuthProvider.Local)
                {
                    <BbCollapsibleTrigger>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="ml-auto">
                            <LucideIcon Name="key-round" Size="14" Class="mr-2"/>
                            Change password
                        </BbButton>
                    </BbCollapsibleTrigger>
                }
            </div>
            <BbCollapsibleContent ForceMount="false">
                <div class="border-t px-5 py-4">
                    <ChangePasswordForm/>
                </div>
            </BbCollapsibleContent>
        </BbCollapsible>
    </div>
}
else
{
    <BbSkeleton Class="h-[58px] w-full rounded-lg"/>
}

@code {
    private AuthProvider? _signIn;

    private bool _open;

    private string Initial => CurrentUser.DisplayName[..1].ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        _signIn = (await ProviderConfigService.GetAsync()).AuthProvider;
    }
}
