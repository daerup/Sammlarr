@using Domain.Notifications

<BbField>
    <BbLabel>Title template</BbLabel>
    <BbInput Id="alert-title" Value="@Title" ValueChanged="TitleChanged" Placeholder="@TitlePlaceholder" UpdateTiming="UpdateTiming.Immediate"/>
</BbField>
<div class="flex min-h-0 flex-1 flex-col gap-1.5">
    <BbLabel>Message template</BbLabel>
    <BbTextarea Id="alert-message" Value="@Message" ValueChanged="MessageChanged" Placeholder="@MessagePlaceholder" MaxLength="8192" UpdateTiming="UpdateTiming.Immediate" Class="field-sizing-fixed min-h-0 flex-1 resize-none"/>
</div>
@if (IsPushover)
{
    <BbField>
        <BbLabel>Priority</BbLabel>
        <BbSelect TValue="PushoverPriority?" Value="@Priority" ValueChanged="PriorityChanged" Options="PriorityOptions" Placeholder="@Automatic"/>
    </BbField>
}
else
{
    <BbField>
        <BbLabel>Level</BbLabel>
        <BbSelect TValue="NotificationLevel?" Value="@Level" ValueChanged="LevelChanged" Options="LevelOptions" Placeholder="@Automatic"/>
    </BbField>
}

@code {
    private const string TitlePlaceholder = "e.g. {{ title }}";
    private const string MessagePlaceholder = "e.g. {{ summary }}";

    private const string Automatic = "Automatic";

    private static readonly List<SelectOption<NotificationLevel?>> LevelOptions =
    [
        new(null, Automatic),
        new(NotificationLevel.Info, "Info"),
        new(NotificationLevel.Success, "Success"),
        new(NotificationLevel.Warning, "Warning"),
        new(NotificationLevel.Error, "Error"),
    ];

    private static readonly List<SelectOption<PushoverPriority?>> PriorityOptions =
    [
        new(null, Automatic),
        .. PushoverPriorities.Ascending.Select(priority => new SelectOption<PushoverPriority?>(priority, priority.Humanize())),
    ];

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> TitleChanged { get; set; }

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> MessageChanged { get; set; }

    [Parameter]
    public NotificationLevel? Level { get; set; }

    [Parameter]
    public EventCallback<NotificationLevel?> LevelChanged { get; set; }

    [Parameter]
    public PushoverPriority? Priority { get; set; }

    [Parameter]
    public EventCallback<PushoverPriority?> PriorityChanged { get; set; }

    [Parameter]
    public bool IsPushover { get; set; }
}
