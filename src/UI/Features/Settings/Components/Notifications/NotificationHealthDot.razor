@using Domain.Notifications
@inject TimeProvider Clock

@if (Outcomes.Count == 0)
{
    <span class="inline-block h-2 w-2 shrink-0 rounded-full bg-muted-foreground/30" title="No deliveries yet"></span>
}
else
{
    <BbPopover>
        <BbPopoverTrigger AsChild="false" aria-label="Delivery health — click for details" class="inline-flex cursor-pointer">
            <span class="inline-block h-2 w-2 shrink-0 rounded-full @DotClass" title="Click for details"></span>
        </BbPopoverTrigger>
        <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Class="w-72 overflow-hidden p-0">
            <div class="border-b px-3 py-2 text-xs font-medium text-muted-foreground">Recent deliveries</div>
            <div class="flex flex-col">
                @foreach (var entry in Outcomes)
                {
                    <div class="flex items-start gap-2 px-3 py-1.5 text-xs">
                        <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full @RowDot(entry.Outcome)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <span class="flex min-w-0 items-baseline gap-1.5">
                                    <span class="font-medium">@Label(entry.Outcome)</span>
                                    <span class="truncate text-muted-foreground">@entry.EventType.Humanize()</span>
                                </span>
                                <span class="shrink-0 text-muted-foreground">@entry.RecordedAt.Humanize(Clock.GetUtcNow())</span>
                            </div>
                            @if (Detail(entry.Outcome) is { } detail)
                            {
                                <p class="truncate text-muted-foreground">@detail</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </BbPopoverContent>
    </BbPopover>
}

@code {
    [Parameter]
    [EditorRequired]
    public required IReadOnlyList<NotificationDeliveryOutcome> Outcomes { get; set; }

    private string DotClass =>
        Outcomes.Any(entry => entry.Outcome is Failed) ? "bg-destructive"
        : Outcomes.Any(entry => entry.Outcome is Retrying) ? "bg-amber-500"
        : "bg-green-500";

    private static string RowDot(DeliveryOutcome outcome) =>
        outcome switch
        {
            Delivered => "bg-green-500",
            Retrying => "bg-amber-500",
            Failed => "bg-destructive",
        };

    private static string Label(DeliveryOutcome outcome) =>
        outcome switch
        {
            Delivered => "Delivered",
            Retrying => "Retrying",
            Failed => "Failed",
        };

    private string? Detail(DeliveryOutcome outcome) =>
        outcome switch
        {
            Delivered => null,
            Retrying retrying => $"retry {retrying.NextAttemptAt.Humanize(Clock.GetUtcNow())} · {retrying.Reason}",
            Failed failed => failed.Reason,
        };
}
