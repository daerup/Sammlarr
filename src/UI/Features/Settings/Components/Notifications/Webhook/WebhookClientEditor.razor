@using Domain.Notifications
@inherits ClientEditorBase

<WebhookClientFields @bind-Url="_url" @bind-Regenerate="_regenerate" ShowRegenerate="!IsCreate"/>

@code {
    private string _url = string.Empty;
    private bool _regenerate;
    private string _signingSecret = string.Empty;

    protected override void OnInitialized()
    {
        if (Target?.Config is WebhookConfig webhook)
        {
            _url = webhook.Url.Reveal();
            _signingSecret = webhook.SigningSecret.Reveal();
        }
        else
        {
            _signingSecret = WebhookSecret.Generate();
        }
    }

    public override bool TryBuild(out NotificationConfig config, out string? error)
    {
        config = default!;
        if (!NotificationConfigBuilder.Webhook(_url, _signingSecret).Endpoint().Match(_ => true, () => false))
        {
            error = "Enter an absolute http:// or https:// URL.";
            return false;
        }
        if (_regenerate && !IsCreate)
        {
            _signingSecret = WebhookSecret.Generate();
        }
        config = NotificationConfigBuilder.Webhook(_url, _signingSecret);
        error = null;
        return true;
    }

    public override string? CreatedSecret => IsCreate || _regenerate ? _signingSecret : null;
}
