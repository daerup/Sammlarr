@using UI.Shared.Changes

<DemoCard Title="Change list" Where="Run dialog, sync dialog" Span="2"
          Note="ChangeList with an added, a removed, an unmatched title and one no sink could add under the run's count chips, and the ChangeDialog that frames it.">
    <ChangeList Items="Items" Chips="Chips"/>
    <div>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => _open = true">
            <LucideIcon Name="history" Size="14" Class="mr-1.5"/>
            Open the change dialog
        </BbButton>
    </div>
    <ChangeDialog Open="_open"
                  OnOpenChanged="v => _open = v"
                  Title="@DemoFeeds.MirrorFeed.Name"
                  Subtitle="scheduled · 48 fetched · took 14 s"
                  Items="Items"
                  Chips="Chips"
                  Note="30 runs"
                  NoteHref="/feeds">
        <Badges>
            <FeedStrategyChip Strategy="DemoFeeds.MirrorFeed.Strategy"/>
        </Badges>
    </ChangeDialog>
</DemoCard>

@code {
    private static readonly IReadOnlyList<ChangeItem> Items =
    [
        new() { Title = "Project Hail Mary", Id = DemoMedia.Movie.Identity.Id, Media = DemoMedia.Movie, Kind = ChangeKind.Added, Subtitle = "2026 · Movie" },
        new()
        {
            Title = "Breaking Bad",
            Id = DemoMedia.Show.Identity.Id,
            Media = DemoMedia.Show,
            Kind = ChangeKind.Removed,
            Subtitle = "2008 · Show",
            ContextIcon = "log-out",
            ContextTooltip = "Removed once it had been absent from enough runs",
        },
        new() { Title = "Unmatched Title", Kind = ChangeKind.Unmatched, Subtitle = "2024" },
        new() { Title = "Unaddressable Title", Kind = ChangeKind.Unaddressable, Subtitle = "2023" },
    ];

    private static readonly IReadOnlyList<ChangeChip> Chips = FeedRunView.Chips(DemoFeeds.MirrorRun.Counts);

    private bool _open;
}
