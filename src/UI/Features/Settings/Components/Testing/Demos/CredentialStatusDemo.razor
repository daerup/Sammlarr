<DemoCard Title="Credential status" Where="Providers: API keys, accounts"
          Note="CredentialStatus in each state a key or account row passes through while it is tested and saved.">
    <div class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-2">
        @foreach (var state in Enum.GetValues<CredentialState>())
        {
            <span class="text-xs text-muted-foreground">@state</span>
            <CredentialStatus State="state" IdleText="Not tested"/>
        }
    </div>
</DemoCard>
