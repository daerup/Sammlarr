@using UI.Features.Feeds.Pages.Editor

<DemoCard Title="Media icons" Where="Tiles, search, detail sheet, preview"
          Note="Every toggle and indicator a title can carry, each off then on. The provenance toggle shows a brand dot for a feed or the sink and a neutral one for a title added by hand or a deleted feed; click the dot (or right-click the bookmark) for its details.">
    <BbTooltipProvider>
        <div class="grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-3 text-xs text-muted-foreground">
            <span>Wantlist</span>
            <div class="flex items-center gap-3">
                <WantlistToggleIcon Result="DemoMedia.Movie" IsToggled="false" IsToggling="false"/>
                <WantlistToggleIcon Result="DemoMedia.Movie" IsToggled="true" IsToggling="false"/>
                <WantlistToggleIcon Result="DemoMedia.Movie" IsToggled="false" IsToggling="true"/>
            </div>
            <span>Blocklist</span>
            <div class="flex items-center gap-3">
                <BlocklistToggleIcon Result="DemoMedia.Movie" IsToggled="false" IsToggling="false"/>
                <BlocklistToggleIcon Result="DemoMedia.Movie" IsToggled="true" IsToggling="false"/>
                <PreviewBlocklistToggleIcon Result="DemoMedia.Movie" IsToggled="_previewBlocklisted" OnToggle="_ => _previewBlocklisted = !_previewBlocklisted"/>
            </div>
            <span>Provenance</span>
            <div class="flex items-center gap-3">
                <WantlistProvenanceToggle Result="DemoMedia.Movie" IsToggled="false"/>
                @foreach (var provenance in Origins)
                {
                    <WantlistProvenanceToggle Result="DemoMedia.Movie" IsToggled="true" Item="Some.Of(new WantlistItem(DemoMedia.Movie.Identity.Id, DemoProvenance.AddedAt, provenance))"/>
                }
            </div>
            <span>Indicator</span>
            <div class="flex items-center gap-3">
                <WantlistIndicatorIcon IsInWantlist="false"/>
                <WantlistIndicatorIcon IsInWantlist="true"/>
            </div>
            <span>Leaving</span>
            <div class="flex items-center gap-3">
                <LeavingIndicator Reason="@PreviewCopy.GoneReason" Threshold="3" Absences="2"/>
                <LeavingIndicator Reason="@PreviewCopy.PastTheLimitReason" Threshold="2" Absences="1">
                    <SlotLineDetail Rank="new SlotRank(21, 20)" LastIn="Firefly Wedding" Title="@(DemoMedia.Movie.Details.Title ?? string.Empty)"/>
                </LeavingIndicator>
            </div>
        </div>
    </BbTooltipProvider>
</DemoCard>

@code {
    private static readonly IReadOnlyList<WantlistItemProvenance> Origins =
    [
        new ManualOrigin(ManualSource.Search),
        DemoProvenance.Feed,
        DemoProvenance.Sink,
        new OrphanedOrigin("Old feed"),
    ];

    private bool _previewBlocklisted;
}
