<DemoCard Title="Media card" Where="Browse / Wantlist grid"
          Note="MediaGridTile in the real grid. A resolved movie and show, an unmatched item, and the loading skeleton. Click a tile to open the detail sheet.">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <MediaGridTile Media="DemoMedia.Movie" OnClick="() => OpenSheet(DemoMedia.Movie)" ShowBookmark="true" IsInWantlist="@Wantlisted.Contains(DemoMedia.Movie.Identity.Id)"/>
        <MediaGridTile Media="DemoMedia.Show" OnClick="() => OpenSheet(DemoMedia.Show)" ShowBookmark="true" IsInWantlist="@Wantlisted.Contains(DemoMedia.Show.Identity.Id)"/>
        <MediaGridTile Media="DemoMedia.Unknown" OnClick="() => OpenSheet(DemoMedia.Unknown)" ShowBookmark="false" IsInWantlist="false"/>
        <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="1"/>
    </div>
</DemoCard>

<MediaDetailSheet Open="_sheetOpen"
                  OnOpenChanged="v => _sheetOpen = v"
                  Media="_sheetMedia"/>

@code {
    [Parameter, EditorRequired] public required IReadOnlySet<MediaId> Wantlisted { get; set; }

    private bool _sheetOpen;
    private MediaMatchResult? _sheetMedia;

    private void OpenSheet(MediaMatchResult media)
    {
        _sheetMedia = media;
        _sheetOpen = true;
    }
}
