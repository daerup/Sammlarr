<DemoCard Title="Media detail tiles" Where="Feed preview" Span="2" PinRight="true"
          Note="MediaDetailTile with wantlist / blocklist toggles and status indicators, plus the preview stat badges. Toggles are visual-only.">
    <BbTooltipProvider>
        <div class="flex items-start text-xs font-medium">
            <PreviewFilterBadge Icon="list" Count="3" Active="true" OnClick="() => {}">
                <Tooltip>Total items fetched from the source list.</Tooltip>
            </PreviewFilterBadge>
            <PreviewFilterBadge Icon="check" Count="2" Active="false" OnClick="() => {}">
                <Tooltip>Items that will be imported.</Tooltip>
            </PreviewFilterBadge>
            <PreviewFilterBadge Icon="scissors" Count="1" Active="false" OnClick="() => {}">
                <Tooltip>Excluded by the import limit.</Tooltip>
            </PreviewFilterBadge>
            <PreviewFilterBadge Icon="circle-alert" Count="1" Active="false" OnClick="() => {}">
                <Tooltip>Could not be matched in your media provider.</Tooltip>
            </PreviewFilterBadge>
        </div>
    </BbTooltipProvider>
    <div class="space-y-2 overflow-hidden">
        <MediaDetailTile Media="DemoMedia.Movie">
            <Icons>
                <WantlistToggle Result="DemoMedia.Movie" IsToggled="@Wantlisted.Contains(DemoMedia.Movie.Identity.Id)" IsToggling="false" OnToggle="OnToggleWantlist"/>
                <BlocklistToggleIcon Result="DemoMedia.Movie" IsToggled="@_blocklisted.Contains(DemoMedia.Movie.Identity.Id)" IsToggling="false" OnToggle="ToggleBlocklist"/>
            </Icons>
        </MediaDetailTile>
        <MediaDetailTile Media="DemoMedia.Show" Class="result-dimmed">
            <Icons>
                <BbTooltipProvider>
                    <BbTooltip DelayDuration="300">
                        <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                            <div class="search-result-status-indicator">
                                <LucideIcon Name="scissors" Size="24"/>
                            </div>
                        </BbTooltipTrigger>
                        <BbTooltipContent>Excluded by the specified import limit.</BbTooltipContent>
                    </BbTooltip>
                </BbTooltipProvider>
                <WantlistToggle Result="DemoMedia.Show" IsToggled="@Wantlisted.Contains(DemoMedia.Show.Identity.Id)" IsToggling="false" OnToggle="OnToggleWantlist"/>
                <BlocklistToggleIcon Result="DemoMedia.Show" IsToggled="@_blocklisted.Contains(DemoMedia.Show.Identity.Id)" IsToggling="false" OnToggle="ToggleBlocklist"/>
            </Icons>
        </MediaDetailTile>
        <MediaDetailTile Media="DemoMedia.Unknown">
            <Icons>
                <BbTooltipProvider>
                    <BbTooltip DelayDuration="300">
                        <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                            <div class="search-result-status-indicator">
                                <LucideIcon Name="circle-alert" Size="24"/>
                            </div>
                        </BbTooltipTrigger>
                        <BbTooltipContent>Could not be matched in your media provider. This item will not be imported.</BbTooltipContent>
                    </BbTooltip>
                </BbTooltipProvider>
            </Icons>
        </MediaDetailTile>
        <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="1"/>
    </div>
</DemoCard>

@code {
    [Parameter, EditorRequired] public required IReadOnlySet<MediaId> Wantlisted { get; set; }

    [Parameter] public EventCallback<MatchedMedia> OnToggleWantlist { get; set; }

    private readonly HashSet<MediaId> _blocklisted = [];

    private void ToggleBlocklist(MatchedMedia media)
    {
        if (!_blocklisted.Remove(media.Identity.Id))
        {
            _blocklisted.Add(media.Identity.Id);
        }
    }
}
