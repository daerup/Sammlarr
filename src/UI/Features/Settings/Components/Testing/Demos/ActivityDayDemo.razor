@using UI.Features.Home.Components

<DemoCard Title="Activity day" Where="Home" Span="2"
          Note="ActivityDayBlock for a day where a mirror feed added three titles and removed one, and a second feed failed at the source. The posters scroll in a PosterTrack.">
    <ActivityDayBlock Day="Day" Media="Media" Today="Today"/>
</DemoCard>

@code {
    private static readonly DateOnly Today = DateOnly.FromDateTime(DemoFeeds.Now.LocalDateTime);

    private static readonly IReadOnlyDictionary<MediaId, MatchedMedia> Media = new Dictionary<MediaId, MatchedMedia>
    {
        [DemoMedia.Movie.Identity.Id] = DemoMedia.Movie,
        [DemoMedia.Show.Identity.Id] = DemoMedia.Show,
        [DemoMedia.Gohan.Identity.Id] = DemoMedia.Gohan,
        [DemoMedia.YellowMirror.Identity.Id] = DemoMedia.YellowMirror,
    };

    private static readonly ActivityDay Day = new(
        Today,
        [DemoMedia.Movie.Identity.Id, DemoMedia.Gohan.Identity.Id, DemoMedia.YellowMirror.Identity.Id],
        [DemoMedia.Show.Identity.Id],
        [new FeedContribution(DemoFeeds.MirrorFeed.Id, DemoFeeds.MirrorFeed.Name, 3, 1, 1, DemoFeeds.MirrorRun.Id, false)],
        [new ActivityRun(DemoFeeds.MirrorRun, DemoFeeds.MirrorFeed.Name)],
        [new ActivityRun(DemoFeeds.FailedRun, DemoFeeds.TrendingFeed.Name)],
        1
    );
}
