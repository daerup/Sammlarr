@using Domain.Notifications
@inject TimeProvider Clock

<DemoCard Title="Delivery health dot" Where="Notifications / Clients"
          Note="NotificationHealthDot over a live outcome list: red on any failure, amber on any retry, else green; grey when empty. Click the dot for the popover. Add or remove entries below.">
    <div class="flex items-center gap-3">
        <span class="text-sm font-medium">Dot:</span>
        <NotificationHealthDot Outcomes="_outcomes"/>
        <span class="text-xs text-muted-foreground">@("entry".ToQuantity(_outcomes.Count))</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => Add(new Delivered())">
            <LucideIcon Name="plus" Size="14" Class="mr-1.5"/>
            Delivered
        </BbButton>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => Add(new Retrying(RetryReason, Clock.GetUtcNow().AddMinutes(4)))">
            <LucideIcon Name="plus" Size="14" Class="mr-1.5"/>
            Retrying
        </BbButton>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => Add(new Failed(FailReason))">
            <LucideIcon Name="plus" Size="14" Class="mr-1.5"/>
            Failed
        </BbButton>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => _outcomes = [.. _outcomes.Skip(1)]" Disabled="_outcomes.Count == 0">
            <LucideIcon Name="minus" Size="14" Class="mr-1.5"/>
            Remove last
        </BbButton>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => _outcomes = []" Disabled="_outcomes.Count == 0">
            <LucideIcon Name="trash-2" Size="14" Class="mr-1.5"/>
            Clear
        </BbButton>
    </div>
</DemoCard>

@code {
    private const string RetryReason = "Connection timed out";
    private const string FailReason = "Endpoint returned HTTP 500";

    private static readonly NotificationEventType[] Events =
    [
        NotificationEventType.WantlistSyncCompleted,
        NotificationEventType.FeedRunCompleted,
        NotificationEventType.FeedRunFailed,
    ];

    private IReadOnlyList<NotificationDeliveryOutcome> _outcomes = [];
    private int _eventIndex;

    private void Add(DeliveryOutcome outcome) =>
        _outcomes = [new NotificationDeliveryOutcome(outcome, Events[_eventIndex++ % Events.Length], Clock.GetUtcNow()), .. _outcomes];
}
