<DemoCard Title="Page header" Where="Wantlist, blocklist, feeds" Span="3"
          Note="PageHeader as a list page uses it: heading, description, and the ListSearch and PageActions it carries as actions.">
    <PageHeader Heading="Wantlist" Description="Everything Sammlarr keeps on your Plex watchlist, and where each title came from.">
        <Actions>
            <ListSearch Value="_search" ValueChanged="v => _search = v" Placeholder="Search titles"/>
            <PageAction Icon="square-check" Label="Select" DesktopLabel="Bulk edit"/>
            <PageAction Icon="sliders-horizontal" Label="Filter" DesktopLabel="View" Active="_showFilters" Badge="2" OnClick="() => _showFilters = !_showFilters"/>
        </Actions>
    </PageHeader>
</DemoCard>

@code {
    private string? _search;
    private bool _showFilters;
}
