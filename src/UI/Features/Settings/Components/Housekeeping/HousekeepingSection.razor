@using Contracts.Housekeeping
@using Contracts.Media
@using global::Shared.Options
@using UI.Shared.Announcing
@using UI.Shared.Services.Branding
@implements IDisposable
@inject IHousekeepingTasks Tasks
@inject IMediaCachePurger CachePurger
@inject IUnmatchedMediaCache UnmatchedCache
@inject HousekeepingOptions Options
@inject MediaProviderBrandingService Branding
@inject TimeProvider Clock
@inject Notifier Notifier

@if (_overview is not { } overview)
{
    <BbSkeleton Class="h-[440px] w-full rounded-xl"/>
}
else
{
    var now = Clock.GetUtcNow();
    var cache = overview.Cache;
    var nextTrim = HousekeepingView.Next(overview.Pass.NextRun, now);
    <div class="overflow-hidden rounded-xl border bg-card">
        <div class="px-[18px] py-3.5">
            <h4 class="text-sm font-semibold">Housekeeping</h4>
            <p class="mt-0.5 text-xs text-muted-foreground" data-testid="housekeeping-size" data-bloated="@(HousekeepingView.Bloated(overview.Size) ? "true" : "false")">
                <b class="@SizeClass(overview.Size)">@HousekeepingView.Size(overview.Size.OnDisk)</b> on disk,
                <b class="@SizeClass(overview.Size)">@HousekeepingView.Size(overview.Size.Data)</b> of it data@(Compacted(overview, now)).
            </p>
            <div class="mt-2.5">
                <StackedBar ShowLegend="true" Format="HousekeepingView.Size">
                    <Title>@HousekeepingView.Size(overview.Size.OnDisk) on disk</Title>
                    <ChildContent>
                        @foreach (var part in HousekeepingView.FileParts(overview, Branding.GetBrandingInfo(RemoteService.ImdbDatasets).BrandColor))
                        {
                            <StackedBarPart Name="@part.Name" Value="part.Bytes" Color="@part.Color.ToNullable()" Pattern="part.Pattern"/>
                        }
                    </ChildContent>
                </StackedBar>
            </div>
        </div>

        <div class="@GroupHead">Runs by itself</div>
        <div class="overflow-x-auto">
        <table class="w-full border-collapse text-[13px]">
            <thead>
                <tr class="border-b text-left text-[11.5px] font-medium whitespace-nowrap text-muted-foreground">
                    <th class="py-2 pr-3 pl-[18px] font-medium">Task</th>
                    <th class="px-3 py-2 font-medium">Runs</th>
                    <th class="px-3 py-2 font-medium">Last run</th>
                    <th class="px-3 py-2 font-medium">What it did</th>
                    <th class="px-3 py-2 font-medium">Next</th>
                    <th class="py-2 pr-[18px] pl-3"></th>
                </tr>
            </thead>
            <tbody>
                <HousekeepingTaskRow Tile="@IconTile("brush")"
                                     Name="Housekeeping"
                                     What="trims history and the cache"
                                     Runs="@HousekeepingView.Runs(overview.Pass.NextRun)"
                                     Line="HousekeepingView.Pass(overview.Pass, now)"
                                     Breakdown="Breakdown(overview.Pass, now)"
                                     Next="@HousekeepingView.Next(overview.Pass.NextRun, now)"
                                     TestId="pass"
                                     OnRun="() => RunAsync(() => Tasks.RunPassAsync())"/>
                @foreach (var dataset in overview.Datasets)
                {
                    var look = HousekeepingView.Datasets[dataset.Service];
                    <HousekeepingTaskRow Tile="DatasetTile(dataset)"
                                         Name="@look.Name"
                                         Href="Some.Of(look.Href)"
                                         What="@look.What"
                                         Runs="@HousekeepingView.Runs(dataset.NextRun)"
                                         Line="HousekeepingView.Dataset(dataset, now)"
                                         Next="@HousekeepingView.Next(dataset.NextRun, now)"
                                         TestId="@dataset.Service.ToString()"
                                         OnRun="() => RunAsync(() => Tasks.LoadDatasetAsync(dataset.Service))"/>
                }
            </tbody>
        </table>
        </div>

        @if (overview.StoredTwice.Undecided + overview.StoredTwice.KeptApart > 0)
        {
            var twice = overview.StoredTwice;
            <div class="@GroupHead">Waiting for you</div>
            <div class="@ActionRow" data-testid="housekeeping-stored-twice">
                <LucideIcon Name="copy" Size="18" Class="text-muted-foreground"/>
                <div>
                    <div class="text-sm font-medium">Titles stored twice</div>
                    <div class="max-w-[80ch] text-[12.5px] text-muted-foreground">@TitlesStoredTwiceView.Waiting(twice.Undecided, twice.KeptApart)</div>
                </div>
                <span class="@ToDecideClass(twice)">@twice.Undecided to decide</span>
                <BbButton Variant="@(twice.Undecided > 0 ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Small" OnClick="() => _reviewing = true">
                    <LucideIcon Name="list-checks" Size="13" Class="mr-1.5"/>
                    <span>Review…</span>
                </BbButton>
            </div>
        }
        <TitlesStoredTwiceDialog Open="_reviewing" OpenChanged="ReviewChangedAsync"/>

        <div class="overflow-x-auto">
            <div class="min-w-max">
                <div class="@($"{GroupHead} {HousekeepingCacheRow.Grid}")" data-testid="housekeeping-caches-band">
                    <span>Caches</span>
                    <span>Holds</span>
                    <span>Size</span>
                    <span>Next trim</span>
                    <span></span>
                </div>
                <div class="divide-y">
                    <HousekeepingCacheRow TestId="housekeeping-clear-unmatched"
                                          Tile="@IconTile("circle-alert")"
                                          Name="Unmatched lookups"
                                          Why="@UnmatchedWhy"
                                          Holds="NoHolds"
                                          Size="in memory"
                                          Next="within the hour"
                                          Removes="each an hour after it failed">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ClearUnmatched">
                            <LucideIcon Name="eraser" Size="13" Class="mr-1.5"/>
                            <span>Clear</span>
                        </BbButton>
                    </HousekeepingCacheRow>
                    <HousekeepingCacheRow TestId="housekeeping-clear-show-parts"
                                          Tile="@IconTile("layers")"
                                          Name="Show parts"
                                          Why="@ShowPartsWhy"
                                          Holds="@(Holds(cache.ShowParts, "part"))"
                                          Size="@HousekeepingView.Size(cache.ShowPartsBytes)"
                                          Next="@nextTrim"
                                          Removes="@($"seasons with no show found, after {HousekeepingView.Days(Options.NoPrequelDays)}")">
                        <HousekeepingClearDialog Title="Clear show parts?" Action="Clear show parts" Disabled="_clearing" OnClear="ClearShowPartsAsync">
                            Anime feed runs ask AniList again for the seasons the Anime ids list can't place, about <b class="font-medium text-foreground">one call per 50 titles</b>.
                        </HousekeepingClearDialog>
                    </HousekeepingCacheRow>
                    <HousekeepingCacheRow TestId="housekeeping-clear-details"
                                          Tile="@IconTile("film")"
                                          Name="Cached details"
                                          Why="@DetailsWhy"
                                          Holds="@(Holds(cache.Detailed, "title"))"
                                          Size="@HousekeepingView.Size(cache.DetailsBytes)"
                                          Next="@nextTrim"
                                          Removes="@($"details nobody opened in {HousekeepingView.Days(Options.DetailsUnusedDays)}")">
                        <HousekeepingClearDialog Title="Clear cached details?" Action="Clear cached details" Disabled="_clearing" OnClear="ClearDetailsAsync">
                            Each of the <b class="font-medium text-foreground">@HousekeepingView.Titles(cache.Detailed)</b> fetches its posters and ratings again the next time it is shown:
                            up to <b class="font-medium text-foreground">@HousekeepingView.ProviderCalls(cache.Detailed)</b>, and a busy provider may slow them down.
                        </HousekeepingClearDialog>
                    </HousekeepingCacheRow>
                    <HousekeepingCacheRow TestId="housekeeping-clear-ids"
                                          Tile="@IconTile("link")"
                                          Name="Title ids and details"
                                          Why="@IdsWhy"
                                          Holds="@(Holds(cache.Matched, "title"))"
                                          Size="@HousekeepingView.Size(cache.DetailsBytes + cache.IdsBytes)"
                                          Next="@nextTrim"
                                          Removes="@($"ids nobody used in {HousekeepingView.Days(Options.IdsUnusedDays)}")">
                        <HousekeepingClearDialog Title="Clear title ids and details?" Action="Clear title ids and details" Disabled="_clearing" OnClear="ClearIdsAsync">
                            Each of the <b class="font-medium text-foreground">@HousekeepingView.Titles(cache.Matched)</b> is matched again the next time it is needed, the slowest cache to rebuild:
                            up to <b class="font-medium text-foreground">@HousekeepingView.ProviderCalls(cache.Matched)</b> plus their details.
                            Titles on your wantlist or blocklist, or waiting to sync, keep their ids.
                        </HousekeepingClearDialog>
                    </HousekeepingCacheRow>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string GroupHead = "border-t bg-foreground/[0.03] px-[18px] pt-2.5 pb-1.5 text-[11px] font-semibold tracking-[.07em] text-muted-foreground uppercase";

    private const string ActionRow = "grid grid-cols-[22px_minmax(0,1fr)_76px_120px] items-center gap-3.5 px-[18px] py-3.5 [&>:last-child]:justify-self-end";

    private const string UnmatchedWhy = "Titles no provider recognised. Sammlarr skips them for an hour instead of asking again on every run. Clear it to try them on the next run, for example after a provider was down.";

    private const string ShowPartsWhy = "Which show each anime season, part or special belongs to, so a later season joins its show. Clear it when a season lands on the wrong show.";

    private const string DetailsWhy = "Posters, summaries and ratings, kept so titles open without asking the providers. Clear it when artwork or ratings look wrong.";

    private const string IdsWhy = "Which IMDb, TMDB and other ids belong to each title, with its details. Clear it when titles are matched to the wrong film or show.";

    private HousekeepingOverview? _overview;

    private CoalescedReload _reload = null!;

    private bool _clearing;

    private bool _reviewing;


    private static readonly RenderFragment NoHolds = @<span>@HousekeepingView.Nothing</span>;

    protected override async Task OnInitializedAsync()
    {
        _reload = new(LoadAsync);
        Tasks.Changed += OnChanged;
        await Task.Yield();
        await _reload.RunAsync();
    }

    public void Dispose() => Tasks.Changed -= OnChanged;

    private async Task LoadAsync()
    {
        _overview = await Tasks.OverviewAsync();
        StateHasChanged();
    }

    private void OnChanged() => _ = InvokeAsync(_reload.RunAsync);

    private async Task RunAsync(Func<Task<bool>> start)
    {
        try
        {
            if (!await start())
            {
                Notifier.Info("It is already running.");
            }
        }
        catch (InvalidOperationException ex)
        {
            Notifier.Error(ex, "Could not start it");
        }
    }

    private async Task ClearDetailsAsync() => await ClearAsync(() => CachePurger.PurgeDetailsAsync(), "Cached details cleared.");

    private async Task ClearIdsAsync() => await ClearAsync(() => CachePurger.PurgeAsync(), "Title ids and details cleared.");

    private async Task ClearShowPartsAsync() => await ClearAsync(() => CachePurger.PurgeShowPartsAsync(), "Show parts cleared.");

    private async Task ClearAsync(Func<Task> clear, string done)
    {
        _clearing = true;
        try
        {
            await clear();
            Notifier.Success(done);
            await _reload.RunAsync();
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Could not clear the cache");
        }
        finally
        {
            _clearing = false;
        }
    }

    private async Task ReviewChangedAsync(bool open)
    {
        _reviewing = open;
        await _reload.RunAsync();
    }

    private static string ToDecideClass(StoredTwiceCount twice)
    {
        return twice.Undecided > 0
            ? "text-right text-[13px] whitespace-nowrap font-semibold text-[color:var(--alert-warning)]"
            : "text-right text-[13px] whitespace-nowrap text-muted-foreground";
    }

    private void ClearUnmatched()
    {
        UnmatchedCache.Clear();
        Notifier.Success("Unmatched titles will be tried again on the next run.");
    }

    private RenderFragment DatasetTile(DatasetTask dataset) => @<BrandedTile Brand="Branding.GetBrandingInfo(dataset.Service)" Size="26" Decorative="true"/>;

    private Optional<RenderFragment> Breakdown(PassTask pass, DateTimeOffset now)
    {
        return pass.Last.When(report => pass.Running.IsNone() && report.Steps.Any(step => step.Removed > 0)).Map(report => Removed(report, now));
    }

    private RenderFragment Removed(HousekeepingReport report, DateTimeOffset now) =>
        @<div data-testid="housekeeping-breakdown">
            <b class="mb-1.5 block font-semibold text-foreground">@HousekeepingView.Removed(report, now)</b>
            <div class="grid grid-cols-[1fr_auto] gap-x-3.5 gap-y-0.5">
                @foreach (var (label, removed) in HousekeepingView.Breakdown(report, Options))
                {
                    <span>@label</span>
                    <b class="text-right font-medium text-foreground tabular-nums">@HousekeepingView.Number(removed)</b>
                }
            </div>
        </div>;

    private static string Compacted(HousekeepingOverview overview, DateTimeOffset now)
    {
        return HousekeepingView.CompactedAt(overview).Map(at => $" · compacted {HousekeepingView.Day(at, now)}").GetValueOr(string.Empty);
    }

    private static string SizeClass(DatabaseSize size) => HousekeepingView.Bloated(size) ? "font-semibold text-[color:var(--alert-warning)]" : "font-semibold text-foreground";

    private static RenderFragment Holds(int count, string noun) =>
        @<span><b class="font-medium text-foreground">@HousekeepingView.Number(count)</b> @noun.ToQuantity(count, ShowQuantityAs.None)</span>;

    private static RenderFragment IconTile(string icon) =>
        @<span class="inline-flex size-[26px] shrink-0 items-center justify-center rounded-md bg-secondary text-foreground">
            <LucideIcon Name="@icon" Size="14"/>
        </span>;
}
