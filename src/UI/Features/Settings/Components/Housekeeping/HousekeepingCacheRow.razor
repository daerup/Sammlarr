@if (IsPhone)
{
    <UnfoldRow Columns="grid-cols-[15px_minmax(0,1fr)_auto]" TriggerClass="py-2.5" data-testid="@TestId">
        <Summary>
            <span class="flex min-w-0 items-center gap-2.5 text-[13px] font-medium">
                @Tile
                <span class="truncate">@Name</span>
            </span>
            <span class="whitespace-nowrap text-xs text-muted-foreground" data-testid="housekeeping-cache-size">@Size</span>
        </Summary>
        <Details>
            <div class="flex flex-col items-start gap-2.5 pt-1 pr-4 pb-3 pl-[43px] text-xs">
                <p class="text-muted-foreground" data-testid="housekeeping-cache-why">@Why</p>
                <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1.5">
                    <dt class="text-muted-foreground">Holds</dt>
                    <dd data-testid="housekeeping-cache-holds">@Holds</dd>
                    <dt class="text-muted-foreground">Next trim</dt>
                    <dd>
                        <span data-testid="housekeeping-cache-next">@Next</span>,
                        <span data-testid="housekeeping-cache-removes">@Removes</span>
                    </dd>
                </dl>
                @ChildContent
            </div>
        </Details>
    </UnfoldRow>
}
else
{
    <div class="@($"{Grid} px-[18px] py-[9px] text-[13px] [&>:last-child]:justify-self-end")" data-testid="@TestId">
        <div class="flex items-center gap-2.5 font-medium whitespace-nowrap">
            @Tile
            <span>@Name</span>
            <HelpTip Title="@Name" Delay="150" IconSize="13" TriggerClass="ml-1.5 inline-flex cursor-help text-muted-foreground opacity-75 hover:text-foreground hover:opacity-100"
                     ContentClass="w-[340px] border bg-popover px-3 py-2.5 text-xs text-muted-foreground shadow-lg"
                     role="button" aria-label="@($"About {Name.ApplyCase(LetterCasing.LowerCase)}")" data-testid="housekeeping-cache-why">@Why</HelpTip>
        </div>
        <span class="whitespace-nowrap text-muted-foreground" data-testid="housekeeping-cache-holds">@Holds</span>
        <span class="whitespace-nowrap text-muted-foreground" data-testid="housekeeping-cache-size">@Size</span>
        <span class="flex flex-col leading-[1.3] whitespace-nowrap text-muted-foreground">
            <span data-testid="housekeeping-cache-next">@Next</span>
            <span class="text-[11.5px] opacity-80" data-testid="housekeeping-cache-removes">@Removes</span>
        </span>
        @ChildContent
    </div>
}

@code {
    [CascadingParameter(Name = PhoneLayout.IsPhoneCascade)] private bool IsPhone { get; set; }

    internal const string Grid = "grid grid-cols-[minmax(0,1fr)_120px_100px_250px_110px] items-center gap-3.5";

    [Parameter] [EditorRequired] public required string TestId { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment Tile { get; set; }

    [Parameter] [EditorRequired] public required string Name { get; set; }

    [Parameter] [EditorRequired] public required string Why { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment Holds { get; set; }

    [Parameter] [EditorRequired] public required string Size { get; set; }

    [Parameter] [EditorRequired] public required string Next { get; set; }

    [Parameter] [EditorRequired] public required string Removes { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment ChildContent { get; set; }
}
