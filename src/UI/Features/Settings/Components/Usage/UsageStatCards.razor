@using Contracts.Usage

<div class="grid grid-cols-4 gap-3">
    <UsageStat Label="Traffic" Icon="arrow-up-right" Value="@UsageView.Count(Now.Total)" Unit="calls"
               Change="UsageView.Change(Now.Total, Then.Total)" Sub="@UsageView.Before(Range)"
               Points="Spark(tally => tally.Total)" Color="@UsageView.Accent"/>
    <UsageStat Label="Errors" Icon="circle-x" Value="@UsageView.Share(Now.Errors, Now.Total)"
               Change="UsageView.Change(Rate(Now, Now.Errors), Rate(Then, Then.Errors))" UpIsWorse="true"
               Sub="@($"{UsageView.Count(Now.Errors)} failed or gave up")"
               Points="Spark(tally => tally.Errors)" Color="var(--usage-failed)"/>
    <UsageStat Label="Latency" Icon="timer" Value="@Now.Percentile(0.95).Map(p95 => UsageView.Duration(p95)).GetValueOr("n/a")" Unit="p95"
               Change="Now.Percentile(0.95).Map(now => Then.Percentile(0.95).Map(then => UsageView.Change(now, then)))" UpIsWorse="true"
               Sub="@Now.Percentile(0.5).Map(median => $"median {UsageView.Duration(median)}").GetValueOr("no answers yet")"
               Points="Spark(tally => tally.Percentile(0.95).GetValueOr(0))" Color="@UsageView.Grey"/>
    <UsageStat Label="Rate limits" Icon="gauge" Value="@UsageView.Share(Now.RateLimited, Now.Total)" Unit="of calls hit a 429"
               Change="UsageView.Change(Rate(Now, Now.RateLimited), Rate(Then, Then.RateLimited))" UpIsWorse="true"
               Sub="@RateLimitsSub" Points="Spark(tally => tally.RateLimited)" Color="var(--usage-after-429)"/>
</div>

@code {
    [Parameter] [EditorRequired] public required UsageSnapshot Snapshot { get; set; }

    [Parameter] [EditorRequired] public required UsageRange Range { get; set; }

    private UsageTally Now => Snapshot.Current.Tally;

    private UsageTally Then => Snapshot.Previous.Tally;

    private string RateLimitsSub =>
        Snapshot
            .Current.Services.FirstOrNone(line => line.Service == RemoteService.Mdblist)
            .Map(line => line.RightNow.RequestsLeft)
            .Map(left => $"MDBList: {UsageView.Requests(left)} left today")
            .GetValueOr($"{UsageView.Calls(Now.RateLimited)} hit a 429");

    private static double Rate(UsageTally tally, long part) => tally.Total == 0 ? 0 : (double)part / tally.Total;

    private IReadOnlyList<UsageSparkline.SparkPoint> Spark(Func<UsageTally, double> value)
    {
        return [.. Snapshot.Current.Slots.Select(slot => new UsageSparkline.SparkPoint(UsageView.Slot(Range, slot.At), value(slot.Tally)))];
    }
}
