<StackedBar Total="Busiest">
    <Title>
        <span class="flex items-center gap-2">
            @Title
            <span class="font-normal text-muted-foreground">· @UsageView.Calls(Tally.Total)</span>
        </span>
    </Title>
    <ChildContent>
        @foreach (var look in UsageView.Outcomes)
        {
            <StackedBarPart Name="@look.Name" Value="Tally.Of(look.Outcome)" Color="@look.Color"/>
        }
    </ChildContent>
</StackedBar>

@code {
    [Parameter] [EditorRequired] public required UsageTally Tally { get; set; }

    [Parameter] [EditorRequired] public required long Busiest { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment Title { get; set; }
}
