<SectionCard Icon="tag" Title="Version">
    <div class="flex items-center gap-3 px-[15px] py-3 max-md:flex-col max-md:py-6 max-md:text-center">
        <span class="max-md:hidden" data-testid="version-logo"><SammlarrLogo Size="24" WordSize="14"/></span>
        <span class="md:hidden" data-testid="version-logo-phone"><SammlarrLogo Size="48" WordSize="28"/></span>
        <div class="flex min-w-0 flex-col gap-0.5 max-md:items-center">
            <div class="flex items-center gap-2">
                <span class="version-number font-mono text-[13px]">@Version.Number</span>
                @if (Version.IsDevBuild)
                {
                    <BbBadge Variant="BadgeVariant.Outline" Class="h-5 px-2 text-[11px] font-medium text-muted-foreground">Dev build</BbBadge>
                }
                @if (Update is Some<AppUpdate>(var update))
                {
                    <BbBadge Variant="BadgeVariant.Outline" Class="@UpdateBadge" data-testid="version-update">@update.Version available</BbBadge>
                }
            </div>
            <span class="version-source text-xs text-muted-foreground">@Source</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(Repository))
        {
            <div class="ml-auto flex shrink-0 items-center gap-4 whitespace-nowrap text-xs max-md:ml-0 max-md:flex-wrap max-md:justify-center max-md:gap-y-1.5">
                @if (Update is Some<AppUpdate>(var newer))
                {
                    <AppLink Href="@newer.Page.ToString()" External="true">What is new in @newer.Version</AppLink>
                }
                @if (!Version.IsDevBuild)
                {
                    <AppLink Href="@($"{RepositoryUrl}/releases/tag/v{Version.Number}")" External="true">Release notes</AppLink>
                }
                <AppLink Href="@RepositoryUrl" External="true">@Repository on GitHub</AppLink>
            </div>
        }
    </div>
</SectionCard>

@code {
    [Parameter] [EditorRequired] public required AppVersion Version { get; set; }

    [Parameter] [EditorRequired] public required string Repository { get; set; }

    [Parameter] public Optional<AppUpdate> Update { get; set; } = new None();

    private const string UpdateBadge = "h-5 px-2 text-[11px] font-medium text-[var(--alert-warning)] border-[color-mix(in_oklab,var(--alert-warning)_55%,transparent)]";

    private string RepositoryUrl => $"https://github.com/{Repository}";

    private string Commits => "commit".ToQuantity(Version.CommitsSinceRelease);

    private string Source =>
        !Version.IsDevBuild ? $"The version comes from the release tag v{Version.Number} this build was made from."
        : Version.HasRelease ? $"The version comes from git when Sammlarr is built: this build is {Commits} past the latest release tag."
        : $"The version comes from git when Sammlarr is built. Nothing is tagged as a release yet, so it counts the commits so far: {Version.CommitsSinceRelease}.";
}
