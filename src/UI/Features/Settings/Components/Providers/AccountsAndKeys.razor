<div class="rounded-lg border bg-card overflow-hidden divide-y">
    @if (Config.AuthProvider == AuthProvider.Local)
    {
        <SammlarrAccountRow Open="Open is SammlarrAccounts" OpenChanged="open => ToggleAsync(new SammlarrAccounts(), open)"/>
    }
    @if (UsesPlex)
    {
        <AccountRow Provider="AuthProvider.Plex"
                    SignsIn="Config.AuthProvider == AuthProvider.Plex"
                    Open="Open == RemoteService.Plex"
                    OpenChanged="open => ToggleAsync(RemoteService.Plex, open)"
                    ReturnUrl="@PlexReturnUrl"
                    Changed="Changed"/>
    }
    @Arr
    <ApiKeyRow Provider="ApiKeyProvider.Tmdb"
               Required="true"
               Uses="TmdbUses"
               Open="Open == RemoteService.Tmdb"
               OpenChanged="open => ToggleAsync(RemoteService.Tmdb, open)"
               Changed="Changed">
        <Description>
            Your TMDB API key. Get one at
            <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener noreferrer"
               class="underline underline-offset-2 hover:text-foreground transition-colors">themoviedb.org › Settings › API</a>
            (free, takes a minute).
        </Description>
        <Extra>
            <OptionalKey Provider="ApiKeyProvider.TmdbReadToken"
                         Title="Read access token"
                         Hint="for lists only TMDB's v4 API serves"
                         Noun="read access token"
                         DeleteText="Delete token"
                         Uses="lists only TMDB's v4 API serves"
                         Changed="Changed">
                <Description>
                    The API Read Access Token from the same
                    <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener noreferrer"
                       class="underline underline-offset-2 hover:text-foreground transition-colors">themoviedb.org › Settings › API</a>
                    page. Only lists TMDB's v4 API serves need it; everything else uses the key.
                </Description>
            </OptionalKey>
        </Extra>
    </ApiKeyRow>
    <ApiKeyRow Provider="ApiKeyProvider.Mdblist"
               Uses="MdblistUses"
               Open="Open == RemoteService.Mdblist"
               OpenChanged="open => ToggleAsync(RemoteService.Mdblist, open)"
               Changed="Changed">
        <Description>
            Your MDBList API key. Get one at
            <a href="https://mdblist.com/preferences/#api" target="_blank" rel="noopener noreferrer"
               class="underline underline-offset-2 hover:text-foreground transition-colors">mdblist.com › Preferences › API</a>
            (free).
        </Description>
    </ApiKeyRow>
    <ApiKeyRow Provider="ApiKeyProvider.Mal"
               Noun="client ID"
               Uses="MalUses"
               Open="Open == RemoteService.Mal"
               OpenChanged="open => ToggleAsync(RemoteService.Mal, open)"
               Changed="Changed">
        <Description>
            Your MyAnimeList client ID. Create an API client at
            <a href="https://myanimelist.net/apiconfig" target="_blank" rel="noopener noreferrer"
               class="underline underline-offset-2 hover:text-foreground transition-colors">myanimelist.net › API</a>
            (free) and paste its client ID.
        </Description>
        <Setup>
            <KeySetup Title="How to get a client ID" Time="about 3 minutes">
                <KeySetupStep Number="1">
                    Sign in at myanimelist.net and open
                    <a href="https://myanimelist.net/apiconfig" target="_blank" rel="noopener noreferrer"
                       class="underline underline-offset-2 hover:text-foreground transition-colors">API › Create ID</a>.
                </KeySetupStep>
                <KeySetupStep Number="2">
                    Fill in the form. MyAnimeList asks for every field; Sammlarr only ever uses the client ID.
                    <div class="mt-1.5 grid grid-cols-[max-content_1fr] items-center gap-x-3.5 gap-y-1 text-xs">
                        <SetupValue Name="App Name" Value="Sammlarr"/>
                        <SetupValue Name="App Type" Value="other"/>
                        <SetupValue Name="App Description" Value="Anime lists and ratings for my selfhosted Sammlarr instance"/>
                        <SetupValue Name="App Redirect URL" Value="http://localhost/"/>
                        <SetupValue Name="Homepage URL" Value="https://github.com/daerup/Sammlarr"/>
                        <SetupValue Name="Commercial / Non-Commercial" Value="non-commercial"/>
                        <SetupValue Name="Name / Company Name" Value="your name" Copy="false"/>
                        <SetupValue Name="Purpose of Use" Value="hobbyist"/>
                    </div>
                </KeySetupStep>
                <KeySetupStep Number="3">
                    Agree to the API License and Developer Agreement and press <span class="font-medium text-foreground">Submit</span>.
                </KeySetupStep>
                <KeySetupStep Number="4">
                    Press <span class="font-medium text-foreground">Return to list</span>, then
                    <span class="font-medium text-foreground">Edit</span> next to Sammlarr, and copy its
                    <span class="font-medium text-foreground">Client ID</span> into the field above.
                </KeySetupStep>
            </KeySetup>
        </Setup>
    </ApiKeyRow>
    <ApiKeyRow Provider="ApiKeyProvider.Trakt"
               Noun="client ID"
               Uses="TraktUses"
               Open="Open == RemoteService.Trakt"
               OpenChanged="open => ToggleAsync(RemoteService.Trakt, open)"
               Changed="Changed">
        <Description>
            Your Trakt client ID. Create an API app at
            <a href="https://developer.trakt.tv/apps" target="_blank" rel="noopener noreferrer"
               class="underline underline-offset-2 hover:text-foreground transition-colors">developer.trakt.tv › My Apps</a>
            (free) and paste its client ID. Trakt deletes an app that goes unused for 30 days.
        </Description>
        <Setup>
            <KeySetup Title="How to get a client ID" Time="about 3 minutes">
                <KeySetupStep Number="1">
                    Sign in at trakt.tv and open
                    <a href="https://developer.trakt.tv/apps" target="_blank" rel="noopener noreferrer"
                       class="underline underline-offset-2 hover:text-foreground transition-colors">developer.trakt.tv › My Apps</a>.
                    Trakt asks you to connect a verified GitHub account once before your first app.
                </KeySetupStep>
                <KeySetupStep Number="2">
                    Create a new app. Sammlarr only ever uses its client ID.
                    <div class="mt-1.5 grid grid-cols-[max-content_1fr] items-center gap-x-3.5 gap-y-1 text-xs">
                        <SetupValue Name="Name" Value="Sammlarr"/>
                        <SetupValue Name="Redirect URI" Value="https://trakt.tv/activate"/>
                    </div>
                </KeySetupStep>
                <KeySetupStep Number="3">
                    Save the app and copy its <span class="font-medium text-foreground">Client ID</span> into the field above.
                </KeySetupStep>
            </KeySetup>
        </Setup>
    </ApiKeyRow>
</div>

@code {
    private static readonly string[] TmdbUses =
    [
        "Search, to find titles to add",
        "Trending titles in Browse",
        "the poster, summary and rating on every title",
        "the ids Radarr and Sonarr need to add a title",
        "TMDB lists as feeds",
    ];

    private static readonly string[] MalUses =
    [
        "MyAnimeList anime lists as feeds",
        "anime details and the MyAnimeList rating with its votes",
    ];

    private static readonly string[] TraktUses =
    [
        "Trakt watchlists, public lists and charts as feeds",
        "the Trakt rating with its votes, without MDBList",
        "Trakt, IMDb, TMDB and TheTVDB ids",
    ];

    private static readonly string[] MdblistUses =
    [
        "MDBList lists as feeds, like hdlists/latest-hd-documentary-movies-1980-to-today",
        "IMDb, Trakt and Letterboxd lists, once you add them on mdblist.com (a free account adds one, updated weekly)",
    ];

    [Parameter] [EditorRequired] public required ProviderConfig Config { get; set; }

    [Parameter] public Service? Open { get; set; }

    [Parameter] public EventCallback<Service?> OpenChanged { get; set; }

    [Parameter] public EventCallback Changed { get; set; }

    [Parameter] public bool ShowPlex { get; set; }

    [Parameter] public string PlexReturnUrl { get; set; } = SettingsLinks.Providers;

    [Parameter] public RenderFragment? Arr { get; set; }

    private bool UsesPlex => ShowPlex || Config.AuthProvider == AuthProvider.Plex || Config.Sink == SinkKind.Plex || Config.SearchProvider == SearchProvider.Plex;

    private Task ToggleAsync(Service key, bool open)
    {
        return OpenChanged.InvokeAsync(open ? key : null);
    }
}
