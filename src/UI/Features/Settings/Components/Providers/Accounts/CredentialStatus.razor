@switch (State)
{
    case CredentialState.Failed:
        <BbBadge Variant="BadgeVariant.Outline" Class="h-6 items-center gap-1.5 badge-soft-destructive">
            <LucideIcon Name="circle-alert" Size="12"/>
            Invalid
        </BbBadge>
        break;
    case CredentialState.Testing:
        <BbBadge Variant="BadgeVariant.Secondary" Class="h-6 items-center gap-1.5 text-muted-foreground">
            <BbSpinner Size="SpinnerSize.Small"/>
            Testing…
        </BbBadge>
        break;
    case CredentialState.Success or CredentialState.Saving:
        <BbBadge Variant="BadgeVariant.Outline" Class="h-6 items-center gap-1.5 text-success border-success">
            <LucideIcon Name="check" Size="12"/>
            Verified
        </BbBadge>
        break;
    case CredentialState.Saved:
        <BbBadge Variant="BadgeVariant.Outline" Class="h-6 items-center gap-1.5 text-success border-success">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-success"></span>
            Connected
        </BbBadge>
        break;
    case CredentialState.Idle when Required:
        <BbBadge Variant="BadgeVariant.Outline" Class="h-6 items-center gap-1.5 badge-soft-destructive">
            <LucideIcon Name="asterisk" Size="12"/>
            Required
        </BbBadge>
        break;
    case CredentialState.Idle:
        <BbBadge Variant="BadgeVariant.Secondary" Class="h-6 items-center gap-1.5 text-muted-foreground">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-muted-foreground/60"></span>
            @IdleText
        </BbBadge>
        break;
}

@code {
    [Parameter] [EditorRequired] public required CredentialState State { get; set; }

    [Parameter] [EditorRequired] public required string IdleText { get; set; }

    [Parameter] public bool Required { get; set; }
}
