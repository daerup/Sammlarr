<div class="flex items-center gap-3">
    @switch (State)
    {
        case CredentialState.Idle:
            <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" OnClick="OnTest" Disabled="!HasChange">
                <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                <span>Test</span>
            </BbButton>
            break;
        case CredentialState.Testing:
            <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" Disabled="true">
                <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                <span>Testing…</span>
            </BbButton>
            break;
        case CredentialState.Success:
            <HoverButton Preset="HoverButtonPreset.Success" Size="ButtonSize.Small" Icon="save" Text="Save" OnClick="OnSave"/>
            break;
        case CredentialState.Saving:
            <HoverButton Preset="HoverButtonPreset.Success" Size="ButtonSize.Small" Disabled="true">
                <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                <span>Saving…</span>
            </HoverButton>
            break;
        case CredentialState.Failed:
            <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" OnClick="OnTest">
                <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                <span>Test again</span>
            </BbButton>
            break;
        case CredentialState.Saved:
            break;
    }

    @ChildContent

    @if (State is CredentialState.Success or CredentialState.Failed || (State == CredentialState.Idle && HasChange))
    {
        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="OnCancel">Cancel</BbButton>
    }

    @if (State == CredentialState.Saved)
    {
        <div class="ml-auto">@Remove</div>
    }
</div>

@code {
    [Parameter] [EditorRequired] public required CredentialState State { get; set; }

    [Parameter] public bool HasChange { get; set; }

    [Parameter] public EventCallback OnTest { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment Remove { get; set; }
}
