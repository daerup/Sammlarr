@using UI.Shared.Services.Branding

<UnfoldRow id="@ProviderRows.Id(Key)" Class="provider-row scroll-mt-20" Edge="@Brand.BrandColor" Open="Open" OpenChanged="OpenChanged"
           Columns="grid-cols-[15px_190px_1fr_auto]" PhoneColumns="grid-cols-[15px_minmax(0,1fr)_auto]" TriggerClass="py-4">
    <Summary>
        @Logo
        <RoleIcons Key="Key"/>

        <span>@Status</span>
    </Summary>
    <PhoneSummary>
        @Logo
        <span>@Status</span>
    </PhoneSummary>
    <Details>
        <div class="flex flex-col gap-4 pl-[49px] pr-4 pt-4 pb-5 max-md:pl-[43px]">
            @if (IsPhone)
            {
                <RoleIcons Key="Key" Named="true"/>
            }
            @ChildContent
        </div>
    </Details>
</UnfoldRow>

@code {
    [CascadingParameter(Name = PhoneLayout.IsPhoneCascade)] private bool IsPhone { get; set; }

    [Parameter] [EditorRequired] public required Service Key { get; set; }

    [Parameter] [EditorRequired] public required BrandingInfo Brand { get; set; }

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public RenderFragment? Title { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment Status { get; set; }

    [Parameter] [EditorRequired] public required RenderFragment ChildContent { get; set; }

    private RenderFragment Logo =>
        @<span class="flex items-center">
            @if (Title is { } title)
            {
                @title
            }
            else
            {
                <BrandedLogo Brand="Brand" Form="ProviderLogoForm.Logo" Size="18"/>
            }
        </span>;
}
