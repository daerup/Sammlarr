@using Contracts.Ratings
@inject RatingContext RatingContext
@inject IRatingService Ratings

<div class="flex max-w-6xl flex-col gap-6">
    <div>
        <h2 class="text-lg font-semibold">Ratings</h2>
        <p class="text-sm text-muted-foreground">How your Sammlarr rating is built wherever a feed does not set its own.</p>
    </div>

    @if (_view is { } view)
    {
        <RatingPipelineCard Strategy="view.Default" Available="view.Available"/>
        <p class="imdb-file text-xs text-muted-foreground">@ImdbFileText</p>
    }
    else
    {
        <BbSkeleton Class="h-64 w-[792px] max-w-full rounded-lg"/>
    }
</div>

@code {
    private RatingView? _view;

    private Optional<DateTimeOffset> _imdbFile = new None();

    private string ImdbFileText =>
        _imdbFile.Match(
            loaded => $"IMDb ratings come from IMDb's ratings file of {loaded.ToLocalTime().ToString("d MMMM yyyy, HH:mm")}.",
            () => "IMDb's ratings file has not been loaded yet.");

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        _imdbFile = await Ratings.GetImdbFileDateAsync();
        _view = await RatingContext.GetAsync();
    }
}
