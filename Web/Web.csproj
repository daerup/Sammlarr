<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- CS8524: allow exhaustive-over-named enum switches without a default arm (Razor compiler warnings ignore .editorconfig). -->
		<NoWarn>$(NoWarn);CS8524</NoWarn>
		<RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
	</PropertyGroup>
	<ItemGroup>
		<TailwindInput Include="$(MSBuildThisFileDirectory)wwwroot\css\app-input.css;$(RepoRoot)UI\tailwind.config.js" Visible="false" />
		<TailwindInput Include="$(RepoRoot)UI\**\*.razor;$(MSBuildThisFileDirectory)*.razor" Exclude="$(RepoRoot)UI\obj\**;$(RepoRoot)UI\bin\**" Visible="false" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
		<ProjectReference Include="..\DB\DB.csproj" />
		<ProjectReference Include="..\API\API.csproj" />
		<ProjectReference Include="..\Messaging\Messaging.csproj" />
		<ProjectReference Include="..\Observability\Observability.csproj" />
		<ProjectReference Include="..\Shared\Shared.csproj" />
		<ProjectReference Include="..\UI\UI.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
		<PackageReference Include="TickerQ" />
		<PackageReference Include="MinVer" PrivateAssets="all" />
	</ItemGroup>
	<PropertyGroup>
		<ExcludeStaging Condition="'$(ExcludeStaging)' == '' and '$(_IsPublishing)' == 'true'">true</ExcludeStaging>
	</PropertyGroup>
	<PropertyGroup Condition="'$(ExcludeStaging)' != 'true'">
		<DefineConstants>$(DefineConstants);STAGING_SEED</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="'$(ExcludeStaging)' == 'true'">
		<Compile Remove="Staging/**" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Web.Tests" />
		<InternalsVisibleTo Include="E2E.Tests" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<Content Remove="wwwroot\js\masonry.js" />
	</ItemGroup>
	<ItemGroup>
		<Content Remove="wwwroot\css\app-input.css" />
	</ItemGroup>
	<Target Name="DropUnusedBlueprintMap" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<StaticWebAsset
				Remove="@(StaticWebAsset)"
				Condition="'%(SourceId)' == 'BlazorBlueprint.Components' and $([System.String]::new('%(RelativePath)').StartsWith('maps/'))"
			/>
			<StaticWebAssetEndpoint
				Remove="@(StaticWebAssetEndpoint)"
				Condition="$([System.String]::new('%(Identity)').StartsWith('_content/BlazorBlueprint.Components/maps/'))"
			/>
		</ItemGroup>
	</Target>
	<Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild" Inputs="@(TailwindInput)" Outputs="$(MSBuildThisFileDirectory)wwwroot\css\app.css">
		<Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(RepoRoot)" Condition="!Exists('$(RepoRoot)node_modules')" />
		<Exec Command="npm run css" WorkingDirectory="$(RepoRoot)" />
		<ItemGroup>
			<Content Include="wwwroot\css\app.css" Exclude="@(Content)" />
		</ItemGroup>
	</Target>
</Project>
