{
  "Sammlarr": {
    "ConnectionString": "Data Source=sammlarr.db",
    "Observability": {
      "LogLevel": "Standard"
    }
  },
  "Plex": {
    "BaseUrl": "https://plex.tv",
    "DiscoverUrl": "https://discover.provider.plex.tv",
    "VodUrl": "https://vod.provider.plex.tv",
    "MetadataUrl": "https://metadata.provider.plex.tv",
    "ArtworkUrl": "https://metadata-static.plex.tv",
    "ImagesUrl": "https://images.plex.tv",
    "AuthAppUrl": "https://app.plex.tv/auth",
    "Authentication": {
      "ProductName": "Sammlarr"
    },
    "Http": {
      "HttpVersion": "2.0",
      "EnableMultipleHttp2Connections": true,
      "AttemptTimeoutSeconds": 10,
      "RetryAttempts": 3,
      "MaxWaitSeconds": 90,
      "Lanes": {
        "api": { "Limits": [ { "Requests": 50, "Per": "00:00:01" } ], "MaxInFlight": 25 },
        "match": { "Routes": [ { "Url": "discover", "Path": "library/metadata/matches" } ], "Limits": [ { "Requests": 50, "Per": "00:00:01" } ], "MaxInFlight": 25 },
        "metadata": { "Routes": [ { "Url": "metadata", "Path": "library/metadata" } ], "Limits": [ { "Requests": 50, "Per": "00:00:01" } ], "MaxInFlight": 25 },
        "watchlist": { "Routes": [ { "Url": "discover", "Path": "library/sections/watchlist" }, { "Url": "vod", "Path": "actions" } ], "MaxInFlight": 4 }
      }
    }
  },
  "TMDB": {
    "BaseUrl": "https://api.themoviedb.org/3",
    "V4BaseUrl": "https://api.themoviedb.org/4",
    "ImageBaseUrl": "https://image.tmdb.org/t/p",
    "Http": {
      "HttpVersion": "2.0",
      "EnableMultipleHttp2Connections": true,
      "AttemptTimeoutSeconds": 6,
      "RetryAttempts": 2,
      "MaxWaitSeconds": 15,
      "EnrichWaitSeconds": 15,
      "Lanes": {
        "api": { "Limits": [ { "Requests": 40, "Per": "00:00:01" } ] }
      }
    }
  },
  "Arr": {
    "Radarr": {
      "MinimumAvailability": "Released",
      "Http": {
        "HttpVersion": "1.1",
        "EnableMultipleHttp2Connections": false,
        "AttemptTimeoutSeconds": 15,
        "RetryAttempts": 2,
        "Lanes": {
          "api": { "MaxInFlight": 4 }
        }
      }
    },
    "Sonarr": {
      "SeriesType": "Standard",
      "SeasonFolder": true,
      "Http": {
        "HttpVersion": "1.1",
        "EnableMultipleHttp2Connections": false,
        "AttemptTimeoutSeconds": 15,
        "RetryAttempts": 2,
        "Lanes": {
          "api": { "MaxInFlight": 4 }
        }
      }
    }
  },
  "Wikidata": {
    "BaseUrl": "https://query.wikidata.org",
    "UserAgent": "Sammlarr/1.0 (https://github.com/daerup/Sammlarr; id lookups)",
    "Http": {
      "HttpVersion": "2.0",
      "EnableMultipleHttp2Connections": false,
      "AttemptTimeoutSeconds": 10,
      "RetryAttempts": 1,
      "Lanes": {
        "api": { "MaxInFlight": 5 }
      }
    }
  },
  "TVmaze": {
    "BaseUrl": "https://api.tvmaze.com",
    "UserAgent": "Sammlarr/1.0 (https://github.com/daerup/Sammlarr; show lookups)",
    "Http": {
      "HttpVersion": "1.1",
      "EnableMultipleHttp2Connections": false,
      "AttemptTimeoutSeconds": 10,
      "RetryAttempts": 1,
      "Lanes": {
        "api": { "Limits": [ { "Requests": 20, "Per": "00:00:10" } ] }
      }
    }
  },
  "ImdbDatasets": {
    "BaseUrl": "https://datasets.imdbws.com",
    "UserAgent": "Sammlarr/1.0 (https://github.com/daerup/Sammlarr; ratings dataset)",
    "Http": {
      "HttpVersion": "1.1",
      "EnableMultipleHttp2Connections": false,
      "AttemptTimeoutSeconds": 14,
      "RetryAttempts": 1,
      "Lanes": {
        "api": { "MaxInFlight": 2 }
      }
    }
  },
  "AnimeLists": {
    "BaseUrl": "https://raw.githubusercontent.com/Fribb/anime-lists/master",
    "UserAgent": "Sammlarr/1.0 (https://github.com/daerup/Sammlarr; anime id map)",
    "Http": {
      "HttpVersion": "1.1",
      "EnableMultipleHttp2Connections": false,
      "AttemptTimeoutSeconds": 14,
      "RetryAttempts": 1,
      "Lanes": {
        "api": { "MaxInFlight": 2 }
      }
    }
  },
  "AniList": {
    "BaseUrl": "https://graphql.anilist.co",
    "UserAgent": "Sammlarr/1.0 (https://github.com/daerup/Sammlarr; anime lists)",
    "Http": {
      "HttpVersion": "2.0",
      "EnableMultipleHttp2Connections": false,
      "AttemptTimeoutSeconds": 14,
      "RetryAttempts": 1,
      "Lanes": {
        "api": { "Limits": [ { "Requests": 30, "Per": "00:01:00" } ], "MaxInFlight": 1 }
      }
    }
  },
  "MyAnimeList": {
    "BaseUrl": "https://api.myanimelist.net/v2",
    "Http": {
      "HttpVersion": "2.0",
      "EnableMultipleHttp2Connections": false,
      "AttemptTimeoutSeconds": 14,
      "RetryAttempts": 1,
      "Lanes": {
        "api": { "Limits": [ { "Requests": 30, "Per": "00:00:01" } ], "MaxInFlight": 1 }
      }
    }
  },
  "Trakt": {
    "BaseUrl": "https://api.trakt.tv",
    "UserAgent": "Sammlarr/1.0 (https://github.com/daerup/Sammlarr; feeds and ratings)",
    "Http": {
      "HttpVersion": "2.0",
      "EnableMultipleHttp2Connections": false,
      "AttemptTimeoutSeconds": 14,
      "RetryAttempts": 1,
      "Lanes": {
        "api": { "Limits": [ { "Requests": 1000, "Per": "00:05:00" } ] }
      }
    }
  },
  "Pushover": {
    "BaseUrl": "https://api.pushover.net/1",
    "Http": {
      "TimeoutSeconds": 15
    }
  },
  "MDBList": {
    "BaseUrl": "https://api.mdblist.com",
    "FeedReserve": 50,
    "Http": {
      "HttpVersion": "1.1",
      "EnableMultipleHttp2Connections": false,
      "AttemptTimeoutSeconds": 10,
      "RetryAttempts": 1,
      "Lanes": {
        "api": { "Limits": [ { "Requests": 1000, "Per": "00:05:00", "Aligned": true } ] },
        "titles": { "MaxBatch": 200 }
      }
    }
  }
}
