<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="new[] { typeof(MainLayout).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToSignIn/>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="flex flex-col items-center justify-center min-h-[400px] gap-4">
                <h1 class="text-4xl font-bold">404</h1>
                <p class="text-muted-foreground">Sorry, there's nothing at this address.</p>
                <a href="/" class="text-primary underline">Go home</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
