@page "/plex-auth"
@using Contracts.Auth
@using global::Shared.DI
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager
@inject ICredentialStore CredentialStore
@inject IKeyedServiceIndex<AuthProvider, IOAuthService> OAuthServiceIndex

<PageTitle>Connecting to Plex…</PageTitle>

<div class="container flex items-center justify-center min-h-[60vh]">
    @if (_isHandlingCallback)
    {
        <div class="text-center space-y-3">
            <p class="text-muted-foreground text-sm">Completing sign-in…</p>
            <div class="h-2 w-48 bg-muted rounded-full overflow-hidden mx-auto">
                <div class="h-full w-1/3 bg-primary animate-pulse"></div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="text-center space-y-4">
            <div class="rounded-lg bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800 p-4">
                <p class="text-sm text-red-800 dark:text-red-200">⚠ @_errorMessage</p>
            </div>
            <a href="/" class="text-sm underline text-muted-foreground">Go home</a>
        </div>
    }
</div>

@code {
    private string? _errorMessage;
    private bool _isHandlingCallback;

    private IOAuthService OAuthService => OAuthServiceIndex[AuthProvider.Plex];

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (
            query.TryGetValue("pinId", out var pinIdValues) && int.TryParse(pinIdValues.FirstOrDefault(), out var pinId) &&
            query.TryGetValue("clientId", out var clientValues) && Guid.TryParse(clientValues.FirstOrDefault(), out var clientId))
        {
            _isHandlingCallback = true;
            await HandlePinCallbackAsync(pinId, clientId);
            _isHandlingCallback = false;

            if (_errorMessage is null)
                NavigationManager.NavigateTo("/", replace: true);
        }
        else
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandlePinCallbackAsync(int pinId, Guid clientId)
    {
        try
        {
            var pinStatus = await OAuthService.CallbackAsync(pinId, clientId);
            if (pinStatus.AuthToken is not null)
                await CredentialStore.StoreAsync(AuthProvider.Plex, pinStatus.AuthToken, pinStatus.ExpiresAt, clientId);
            else
                _errorMessage = "Authentication was not completed. Please try again.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to complete sign-in: {ex.Message}";
        }
    }
}
