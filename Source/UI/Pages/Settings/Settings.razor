@page "/settings"

<PageTitle>Settings</PageTitle>

<div class="px-8 py-10">
    <div class="pb-6 mb-8">
        <h1 class="text-3xl font-semibold">Settings</h1>
    </div>

    <div class="flex items-start gap-6">
        <!-- Sidebar nav -->
        <nav class="w-44 shrink-0 flex flex-col gap-1 mt-2">
            @foreach (var item in _sections)
            {
                <BbButton Variant="@(_activeSection == item ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Class="w-full justify-start"
                          OnClick="() => _activeSection = item">
                    <LucideIcon Name="@item.Icon" Size="15" Class="mr-2.5 shrink-0"/>
                    @item.Label
                </BbButton>
            }
        </nav>

        <!-- Separator -->
        <div class="border-l self-stretch"></div>

        <!-- Content -->
        <div class="flex-1">
            <DynamicComponent Type="_activeSection.ComponentType"/>
        </div>
    </div>
</div>

@code {
    private record SettingsSection(string Label, string Icon, Type ComponentType);

    private readonly List<SettingsSection> _sections =
    [
        new("API Keys", "key", typeof(ApiKeysSection)),
    ];

    private SettingsSection _activeSection = null!;

    protected override void OnInitialized()
    {
        _activeSection = _sections[0];
    }
}
