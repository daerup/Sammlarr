@page "/subscription/create"
@implements IDisposable
@using BlazorBlueprint.Primitives.Filtering
@using Contracts
@using global::Shared
@using Contracts.Media.List
@using Contracts.Media.Search
@using Contracts.DI
@using Contracts.Auth
@using UI.Features.Import.Components
@using UI.Shared.Services.Branding
@inject IImportListRepository ImportListRepository
@inject IKeyedServiceIndex<MediaListProvider, IImportListService> ImportListServiceIndex
@inject IApiKeyConfigRepository ApiKeyConfigRepository
@inject MediaProviderBrandingService MediaProviderBrandingService
@inject NavigationManager NavigationManager

<PageTitle>Create subscription</PageTitle>

<div class="px-6 py-10">
    <div class="mb-6">
        <h1 class="text-3xl font-bold tracking-wide antialiased">Create subscription</h1>
        <p class="text-muted-foreground mt-1 font-normal tracking-wide pb-4">Import a list from an external provider and subscribe to it.</p>
    </div>

    <div class="w-full max-w-2xl">
        <div class="rounded-lg border">

            <div class="px-6 py-6 space-y-6">

                <BbField>
                    <BbFieldLabel Class="flex items-center leading-none">
                        Enabled
                        <BbTooltipProvider>
                            <BbTooltip DelayDuration="0">
                                <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                    <LucideIcon Name="info" Size="14"/>
                                </BbTooltipTrigger>
                                <BbTooltipContent>Toggle to enable or disable this import.</BbTooltipContent>
                            </BbTooltip>
                        </BbTooltipProvider>
                    </BbFieldLabel>
                    <BbFieldContent>
                        <BbSwitch @bind-Checked="_isEnabled"/>
                    </BbFieldContent>
                </BbField>

                <BbField IsInvalid="NameIsInvalid">
                    <BbFieldLabel For="name" Class="flex items-center leading-none">
                        Name <span class="text-destructive ml-0.5">*</span>
                        <BbTooltipProvider>
                            <BbTooltip DelayDuration="0">
                                <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                    <LucideIcon Name="info" Size="14"/>
                                </BbTooltipTrigger>
                                <BbTooltipContent>A friendly label to identify this subscription across your lists.</BbTooltipContent>
                            </BbTooltip>
                        </BbTooltipProvider>
                    </BbFieldLabel>
                    <BbFieldContent>
                        <BbInput id="name" Placeholder="e.g. My Top Movies" @bind-Value="_name" Class="bg-accent" Required="true" AriaInvalid="@NameIsInvalid"
                                 UpdateTiming="UpdateTiming.Immediate"/>
                    </BbFieldContent>
                    @if (NameIsInvalid)
                    {
                        <BbFieldError>Name is required.</BbFieldError>
                    }
                </BbField>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <BbField>
                        <BbFieldLabel Class="flex items-center leading-none">
                            Provider
                            @if (_disabledProviders.Count > 0)
                            {
                                var allDisabled = _disabledProviders.Count == Enum.GetValues<MediaListProvider>().Length;
                                <BbPopover>
                                    <BbPopoverTrigger AsChild="false"
                                                      Class="@($"ml-1 inline-flex items-center cursor-pointer {(allDisabled ? "text-destructive" : "text-amber-500")}")">
                                        <LucideIcon Name="triangle-alert" Size="14"/>
                                    </BbPopoverTrigger>
                                    <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Class="w-72">
                                        <div class="space-y-2">
                                            <p class="text-sm font-semibold">API key required</p>
                                            <p class="text-sm text-muted-foreground">
                                                The following providers are unavailable because no API key is configured:
                                                <span class="font-medium">@string.Join(", ", _disabledProviders)</span>.
                                            </p>
                                            <BbButton Variant="ButtonVariant.Link" Href="/settings?section=api-keys" Class="h-auto p-0 text-sm">
                                                Go to Settings →
                                            </BbButton>
                                        </div>
                                    </BbPopoverContent>
                                </BbPopover>
                            }
                            <BbTooltipProvider>
                                <BbTooltip DelayDuration="0">
                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                        <LucideIcon Name="info" Size="14"/>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>The external service that hosts the list you want to import.
                                    </BbTooltipContent>
                                </BbTooltip>
                            </BbTooltipProvider>
                        </BbFieldLabel>
                        <BbFieldContent>
                            <EnumToggleGroup TEnum="MediaListProvider"
                                             Value="_provider"
                                             OnChange="@OnProviderChanged"
                                             BrandingProvider="GetProviderBranding"
                                             DisabledValues="_disabledProviders"/>
                        </BbFieldContent>
                    </BbField>

                    <BbField>
                        <BbFieldLabel Class="flex leading-none">
                            Strategy
                            <BbTooltipProvider>
                                <BbTooltip>
                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex p-0 text-muted-foreground cursor-default">
                                        <LucideIcon Name="info" Size="14"/>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Only relevant when a subscription runs more than once. Controls whether repeated syncs add to or replace
                                        your existing collection.
                                    </BbTooltipContent>
                                </BbTooltip>
                            </BbTooltipProvider>
                        </BbFieldLabel>
                        <BbFieldContent>
                            <EnumToggleGroup TEnum="MediaListAddStrategy"
                                             Value="_strategy"
                                             OnChange="@OnStrategyChanged"
                                             TooltipProvider="GetStrategyTooltip"
                                             BrandingProvider="GetStrategyBranding"/>
                        </BbFieldContent>
                    </BbField>
                </div>

                <BbField IsInvalid="ListIdentifierIsInvalid">
                    <BbFieldLabel For="list-identifier" Class="flex items-center leading-none">
                        List identifier <span class="text-destructive ml-0.5">*</span>
                        <BbTooltipProvider>
                            <BbTooltip>
                                <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                    <LucideIcon Name="info" Size="14"/>
                                </BbTooltipTrigger>
                                <BbTooltipContent>The unique string that locates your list within the selected provider. The exact format varies by provider;
                                    check the list's URL or the provider's documentation.
                                </BbTooltipContent>
                            </BbTooltip>
                        </BbTooltipProvider>
                    </BbFieldLabel>
                    <BbFieldContent>
                        <BbInput id="list-identifier" Placeholder="@GetListIdentifierPlaceholder(_provider)"
                                 @bind-Value="_listIdentifier"
                                 @bind-Value:after="OnListIdentifierChanged"
                                 Class="bg-accent"
                                 Required="true" AriaInvalid="@ListIdentifierIsInvalid" UpdateTiming="UpdateTiming.Immediate"/>
                    </BbFieldContent>
                    <BbFieldDescription>@RenderListIdentifierDescription()</BbFieldDescription>
                    @if (ListIdentifierIsInvalid)
                    {
                        <BbFieldError>List identifier is required.</BbFieldError>
                    }
                </BbField>

            </div>

            <BbCollapsible>
                <BbCollapsibleTrigger AsChild="false"
                                      Class="group w-full flex items-center justify-between px-6 py-3 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors border-t">
                    <span class="flex items-center gap-2">
                        <LucideIcon Name="sliders-horizontal" Size="14"/>
                        Filters, Sorting & Limits
                        <span class="text-xs font-normal opacity-50">optional</span>
                    </span>
                    <LucideIcon Name="chevron-down" Size="14" Class="transition-transform duration-200 group-data-[state=open]:rotate-180"/>
                </BbCollapsibleTrigger>
                <BbCollapsibleContent>
                    <div class="px-6 pb-8 pt-4 space-y-6 p-4">

                        <BbField>
                            <BbFieldLabel Class="flex items-center leading-none">
                                Enable filters
                                <BbTooltipProvider>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                            <LucideIcon Name="info" Size="14"/>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Limit which imported items are added to your collection. Filter by genre, rating, release year, and
                                            more.
                                        </BbTooltipContent>
                                    </BbTooltip>
                                </BbTooltipProvider>
                            </BbFieldLabel>
                            <BbFieldContent>
                                <BbSwitch @bind-Checked="_filtersEnabled"/>
                            </BbFieldContent>
                        </BbField>

                        @if (_filtersEnabled)
                        {
                            <BbFilterBuilder @bind-Filter="_filter"
                                             Fields="FilterFields"
                                             OnFilterChanged="HandleFilterChanged"/>
                        }

                        <BbField>
                            <BbFieldLabel Class="flex items-center leading-none">
                                Enable custom sorting
                                <BbTooltipProvider>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                            <LucideIcon Name="info" Size="14"/>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Sort imported items by a specific field before applying the limit.</BbTooltipContent>
                                    </BbTooltip>
                                </BbTooltipProvider>
                            </BbFieldLabel>
                            <BbFieldContent>
                                <BbSwitch @bind-Checked="_sortingEnabled"/>
                            </BbFieldContent>
                        </BbField>

                        @if (_sortingEnabled)
                        {
                            <BbField>
                                <BbFieldLabel Class="flex items-center leading-none">
                                    Sort by
                                </BbFieldLabel>
                                <BbFieldContent>
                                    <div class="flex items-center gap-3">
                                        <BbSelect TValue="string"
                                                  Value="_sortField"
                                                  Class="w-40"
                                                  ValueChanged="@((v) => _sortField = v ?? _sortField)"
                                                  Options="SortFieldOptions"/>
                                        <BbTooltipProvider>
                                            <BbTooltip DelayDuration="0">
                                                <BbTooltipTrigger AsChild="false" Class="p-0">
                                                    <BbButton Size="ButtonSize.Icon"
                                                              Variant="ButtonVariant.Outline"
                                                              OnClick="@ToggleSortDirection"
                                                              AriaLabel="@GetSortLabel()">
                                                        <LucideIcon Name="arrow-up" Size="14"
                                                                    Class="@GetSortIconClass()"/>
                                                    </BbButton>
                                                </BbTooltipTrigger>
                                        <BbTooltipContent>@GetSortTooltip()</BbTooltipContent>
                                            </BbTooltip>
                                        </BbTooltipProvider>
                                    </div>
                                    </BbFieldContent>
                                </BbField>
                        }

                        <BbField IsInvalid="LimitIsInvalid">
                            <BbFieldLabel For="limit" Class="flex items-center leading-none">
                                Limit
                                <BbTooltipProvider>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                            <LucideIcon Name="info" Size="14"/>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Maximum number of items to import from the list. Leave empty to import all available items.
                                        </BbTooltipContent>
                                    </BbTooltip>
                                </BbTooltipProvider>
                            </BbFieldLabel>
                            <BbFieldContent>
                                <BbInput id="limit"
                                         Placeholder="e.g. 100"
                                         @bind-Value="_limitRaw"
                                         Class="bg-accent w-40"
                                         AriaInvalid="@LimitIsInvalid"
                                         UpdateTiming="UpdateTiming.Immediate"/>
                            </BbFieldContent>
                            @if (LimitIsInvalid)
                            {
                                <BbFieldError>Limit must be a positive whole number.</BbFieldError>
                            }
                        </BbField>
                    </div>
                </BbCollapsibleContent>
            </BbCollapsible>

            <BbCollapsible>
                <BbCollapsibleTrigger AsChild="false"
                                      Class="group w-full flex items-center justify-between px-6 py-3 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors border-t">
                    <span class="flex items-center gap-2">
                        <LucideIcon Name="clock" Size="14"/>
                        Sync Frequency
                        <span class="text-xs font-normal opacity-50">optional</span>
                    </span>
                    <LucideIcon Name="chevron-down" Size="14" Class="transition-transform duration-200 group-data-[state=open]:rotate-180"/>
                </BbCollapsibleTrigger>
                <BbCollapsibleContent>
                    <div class="px-6 pb-8 pt-4 space-y-6 p-4">

                        <BbField>
                            <BbFieldLabel Class="flex items-center leading-none">
                                Trigger
                                <BbTooltipProvider>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                            <LucideIcon Name="info" Size="14"/>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>When to sync this subscription, on demand or on a recurring schedule.</BbTooltipContent>
                                    </BbTooltip>
                                </BbTooltipProvider>
                            </BbFieldLabel>
                            <BbFieldContent>
                                <EnumToggleGroup TEnum="RunMode"
                                                 Value="_runMode"
                                                 OnChange="@OnRunModeChanged"
                                                 BrandingProvider="GetRunModeBranding"/>
                            </BbFieldContent>
                        </BbField>

                        @if (_runMode == RunMode.Scheduled)
                        {
                            <BbField>
                                <BbFieldLabel Class="flex items-center leading-none">
                                    Schedule
                                    <BbTooltipProvider>
                                        <BbTooltip DelayDuration="0">
                                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                <LucideIcon Name="info" Size="14"/>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>Define a CRON schedule for automatic runs.</BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                </BbFieldLabel>
                                <BbFieldContent>
                                    <SchedulePicker CronExpression="@_scheduleCronExpression"
                                                    CronExpressionChanged="@((value) => _scheduleCronExpression = value)"/>
                                </BbFieldContent>
                            </BbField>
                        }

                    </div>
                </BbCollapsibleContent>
            </BbCollapsible>

            <div class="px-6 py-4 border-t flex items-center justify-end gap-2">
                @if (_state == State.Testing)
                {
                    <BbButton Variant="ButtonVariant.Default" Disabled="true">
                        <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                        <span>Testing…</span>
                    </BbButton>
                }
                else if (ShowSaveButton)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="text-success border-success hover:bg-success"
                              OnClick="HandleSaveAsync"
                              Disabled="!CanSave">
                        <LucideIcon Name="save" Size="14" Class="mr-2"/>
                        Save
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline"
                              OnClick="HandleViewPreviewAsync">
                        <LucideIcon Name="eye" Size="14" Class="mr-2"/>
                        View
                    </BbButton>
                }
                else if (_state == State.Failed)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="text-destructive border-destructive hover:bg-destructive/10 hover:text-destructive"
                              Disabled="true">
                        <LucideIcon Name="x" Size="14" Class="mr-2"/>
                        Failed
                    </BbButton>
                }
                else if (ShowTestButton)
                {
                    <BbButton Variant="ButtonVariant.Default"
                              OnClick="HandleTestAsync"
                              Disabled="!CanTest || LimitIsInvalid">
                        <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                        Test
                    </BbButton>
                }

                <BbButton Variant="ButtonVariant.Outline"
                          Class="text-destructive border-destructive hover:bg-destructive/10 hover:text-destructive"
                          OnClick="ReturnAsync"
                          Disabled="@IsProcessing">
                    Cancel
                </BbButton>
            </div>

        </div>
    </div>
</div>

@if (_showPreviewModal)
{
    <div class="preview-modal"
         role="dialog"
         aria-modal="true"
         aria-label="Import Preview"
         @onkeydown="HandlePreviewKeyDown">
        <div class="preview-modal-backdrop" @onclick="ClosePreviewModal"></div>

        <div class="preview-modal-content">
            <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                    <h2 class="text-lg font-bold tracking-wide">Import Preview</h2>
                    <p class="text-sm text-muted-foreground">
                        @_previewResults.Count item@(_previewResults.Count == 1 ? "" : "s") found in <span class="font-medium">@_testedListIdentifier</span>
                    </p>
                </div>
                <BbButton Variant="ButtonVariant.Ghost" OnClick="ClosePreviewModal">
                    <LucideIcon Name="x" Size="18"/>
                </BbButton>
            </div>

            <div class="mb-4">
                <input type="search"
                       class="w-full border-input bg-secondary file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 flex h-9 min-w-0 rounded-md border px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm"
                       placeholder="Filter by title…"
                       @bind="_previewFilterQuery"
                       @bind:event="oninput"
                       @onfocus="() => _focusedPreviewResult = null"
                       aria-label="Filter preview results by title"/>
            </div>

            <div class="preview-modal-results space-y-2 pr-1">
                @{
                    var filtered = FilteredPreviewResults.ToList();
                }
                @if (filtered.Count > 0)
                {
                    @foreach (var result in filtered)
                    {
                        var isBlacklisted = IsPreviewBlacklisted(result);
                        <div class="@(isBlacklisted ? "preview-result-blacklisted" : string.Empty)">
                            <MediaDetailTile @key="result"
                                             Result="result"
                                             IsMarked="isBlacklisted"
                                             IsActiveToggle="false"
                                             IsFocused="_focusedPreviewResult == result"
                                             OnFocusIn="() => _focusedPreviewResult = result"
                                             OnToggleWatchlist="TogglePreviewBlacklistAsync"
                                             ToggleIcon="GetPreviewBlacklistIcon"
                                             ToggleActiveColor="hsl(var(--destructive))"/>
                        </div>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(_previewFilterQuery))
                {
                    <div class="rounded-lg bg-surface p-6 text-center space-y-2">
                        <LucideIcon Name="search-x" Size="28" Class="mx-auto text-muted-foreground"/>
                        <p class="text-sm text-muted-foreground">No items match <span class="font-medium">"@_previewFilterQuery"</span>.</p>
                    </div>
                }
                else
                {
                    <div class="rounded-lg bg-surface p-6 text-center space-y-2">
                        <LucideIcon Name="search-x" Size="28" Class="mx-auto text-muted-foreground"/>
                        <p class="text-sm text-muted-foreground">No items found.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {

    private enum State { Idle, Testing, Success, Saving, Saved, Failed }
    private enum SortDirection { Ascending, Descending }
    private enum RunMode { Manual, Scheduled }

    #region Form State
    private string _name = string.Empty;
    private string _listIdentifier = string.Empty;
    private bool _isEnabled = true;
    private MediaListProvider? _provider = MediaListProvider.Mdblist;
    private MediaListAddStrategy _strategy = MediaListAddStrategy.Append;
    #endregion

    #region Test/Save State
    private State _state = State.Idle;
    private bool _showValidation;
    private MediaListProvider? _testedProvider;
    private string _testedListIdentifier = string.Empty;
    private IReadOnlyList<IMediaDetailResult> _previewResults = [];
    private CancellationTokenSource? _cancellationTokenSource;
    private bool _showPreviewModal;
    private string _previewFilterQuery = string.Empty;
    private readonly HashSet<string> _previewBlacklistedSourceIds = [];
    private IMediaDetailResult? _focusedPreviewResult;
    #endregion

    #region Sync Schedule State
    private RunMode _runMode = RunMode.Manual;
    private string? _scheduleCronExpression = string.Empty;
    #endregion

    #region Filters, Sorting & Limits State
    private bool _filtersEnabled;
    private FilterDefinition _filter = new();
    private bool _sortingEnabled;
    private SortDirection _sortDirection = SortDirection.Descending;
    private string _sortField = "title";
    private string _limitRaw = string.Empty;
    #endregion

    #region Disabled Providers
    private readonly HashSet<MediaListProvider> _disabledProviders = [];
    #endregion

    #region Constants
    private static readonly IReadOnlyList<SelectOption<string>> SortFieldOptions =
    [
        new("title", "Title"),
        new("releaseDate", "Release Date"),
        new("rating", "Rating"),
        new("runtime", "Runtime"),
        new("popularity", "Popularity"),
    ];

    private static readonly IReadOnlyList<FilterField> FilterFields =
    [
        new FilterField { Name = "name", Label = "Name", Type = FilterFieldType.Text },
        new FilterField { Name = "age", Label = "Age", Type = FilterFieldType.Number },
        new FilterField { Name = "joinedAt", Label = "Joined", Type = FilterFieldType.Date },
        new FilterField { Name = "active", Label = "Active", Type = FilterFieldType.Boolean },
        new FilterField
        {
            Name = "role", Label = "Role", Type = FilterFieldType.Enum,
            Options =
            [
                new SelectOption<string>("admin", "Admin"),
                new SelectOption<string>("editor", "Editor"),
                new SelectOption<string>("viewer", "Viewer"),
            ]
        },
    ];
    #endregion

    #region Validation & Computed State
    private bool NameIsInvalid => _showValidation && string.IsNullOrWhiteSpace(_name);
    private bool ListIdentifierIsInvalid => _showValidation && string.IsNullOrWhiteSpace(_listIdentifier);
    private int? ParsedLimit => int.TryParse(_limitRaw, out var n) && n > 0 ? n : null;
    private bool LimitIsInvalid => !string.IsNullOrWhiteSpace(_limitRaw) && ParsedLimit is null;

    private bool CanTest => !string.IsNullOrWhiteSpace(_listIdentifier) && _provider is not null;
    private bool CanSave =>
        _state == State.Success &&
        _provider is not null &&
        _provider == _testedProvider &&
        !string.IsNullOrWhiteSpace(_listIdentifier) &&
        string.Equals(_listIdentifier.Trim(), _testedListIdentifier, StringComparison.Ordinal) &&
        !string.IsNullOrWhiteSpace(_name) &&
        !LimitIsInvalid;

    private bool IsProcessing => _state is State.Testing or State.Saving;
    private bool ShowTestButton => _state is State.Idle or State.Failed;
    private bool ShowSaveButton => _state == State.Success;
    #endregion

    private Task OnRunModeChanged(RunMode mode)
    {
        _runMode = mode;
        _scheduleCronExpression = mode == RunMode.Manual ? string.Empty : null;
        return Task.CompletedTask;
    }

    private BrandingInfo GetRunModeBranding(RunMode mode) =>
        mode switch
        {
            RunMode.Manual => BrandingInfoBuilder.Lucide("Manual", mode.ToString(), "hand", "#000000"),
            RunMode.Scheduled => BrandingInfoBuilder.Lucide("Scheduled", mode.ToString(), "calendar", "#000000"),
            _ => BrandingInfoBuilder.Lucide(mode.ToString(), mode.ToString(), "clock", "#000000"),
        };

    private Task OnStrategyChanged(MediaListAddStrategy strategy)
    {
        _strategy = strategy;
        return Task.CompletedTask;
    }

    private BrandingInfo GetProviderBranding(MediaListProvider provider) =>
        MediaProviderBrandingService.GetBrandingInfo(provider.AsMediaProvider());

    private BrandingInfo GetStrategyBranding(MediaListAddStrategy strategy) =>
        BrandingInfoBuilder.Lucide(strategy.GetDescription(), strategy.ToString(), "shield-check", "#000000");

    protected override async Task OnInitializedAsync()
    {
        foreach (var provider in Enum.GetValues<MediaListProvider>())
        {
            var apiKey = await ApiKeyConfigRepository.GetApiKeyAsync(provider.AsMediaProvider());
            if (string.IsNullOrEmpty(apiKey))
                _disabledProviders.Add(provider);
        }

        if (_disabledProviders.Contains(_provider ?? default))
            _provider = Enum.GetValues<MediaListProvider>().Cast<MediaListProvider?>().FirstOrDefault(p => !_disabledProviders.Contains(p!.Value));
    }

    private string GetListIdentifierPlaceholder(MediaListProvider? provider) =>
        provider switch
        {
            MediaListProvider.Mdblist => "e.g. top-250-movies or 12345",
            null => "Select a provider first",
            _ => "Provider-specific list identifier",
        };

    private MarkupString RenderListIdentifierDescription() => _provider switch
    {
        MediaListProvider.Mdblist => new MarkupString(
        "Slug or numeric ID from the list URL, e.g. <code>top-250-movies</code> or <code>12345</code>. " +
        "<a href=\"https://mdblist.com/toplists/\" target=\"_blank\" " +
        "class=\"underline underline-offset-2 hover:text-foreground transition-colors\">Browse lists on MDBList</a>"),
        null => new MarkupString("No provider is available. Configure an API key in Settings."),
        _ => new MarkupString("The provider-specific identifier for the list (slug, numeric ID, or URL segment)."),
    };

    private string GetStrategyTooltip(MediaListAddStrategy strategy) =>
        strategy switch
        {
            MediaListAddStrategy.Append => "Each sync adds only new items. Items already in your collection are kept.",
            MediaListAddStrategy.Replace => "Each sync removes items that were added by this subscription and are no longer on the list. Items added by other subscriptions are unaffected, even if they appear on this list.",
        };

    private Task OnProviderChanged(MediaListProvider provider)
    {
        _provider = provider;
        return Task.CompletedTask;
    }

    private Task ReturnAsync()
    {
        NavigationManager.NavigateTo("/lists");
        return Task.CompletedTask;
    }

    private void OnListIdentifierChanged()
    {
        // If identifier changed after a successful test, reset to Idle to force re-test
        if (_state is State.Success or State.Failed &&
            !string.Equals(_listIdentifier.Trim(), _testedListIdentifier, StringComparison.Ordinal))
        {
            _state = State.Idle;
            _testedProvider = null;
            _testedListIdentifier = string.Empty;
        }
    }

    private void HandleFilterChanged(FilterDefinition filter) {}

    private void HandlePreviewKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Escape")
            ClosePreviewModal();
    }

    private static string GetPreviewSourceKey(IMediaDetailResult result) => result.SourceId.ToString() ?? string.Empty;

    private bool IsPreviewBlacklisted(IMediaDetailResult result) =>
        _previewBlacklistedSourceIds.Contains(GetPreviewSourceKey(result));

    private Task TogglePreviewBlacklistAsync(IMediaDetailResult result)
    {
        var sourceKey = GetPreviewSourceKey(result);
        if (!_previewBlacklistedSourceIds.Add(sourceKey))
            _previewBlacklistedSourceIds.Remove(sourceKey);

        return Task.CompletedTask;
    }

    private static string GetPreviewBlacklistIcon(bool isBlacklisted) => isBlacklisted ? "list-x" : "list-minus";


    private Task HandleTestAsync() => TestAsync();

    private Task HandleSaveAsync()
    {
        _showValidation = true;
        return CanSave ? SaveAsync() : Task.CompletedTask;
    }

    private Task HandleViewPreviewAsync()
    {
        _previewFilterQuery = string.Empty;
        _previewBlacklistedSourceIds.Clear();
        _focusedPreviewResult = null;
        _showPreviewModal = true;
        return Task.CompletedTask;
    }

    private void ClosePreviewModal()
    {
        _showPreviewModal = false;
        _previewFilterQuery = string.Empty;
        _previewBlacklistedSourceIds.Clear();
        _focusedPreviewResult = null;
    }

    private IEnumerable<IMediaDetailResult> FilteredPreviewResults =>
        string.IsNullOrWhiteSpace(_previewFilterQuery)
            ? _previewResults
            : _previewResults.Where(r => r.Title.Contains(_previewFilterQuery, StringComparison.OrdinalIgnoreCase));

    #region Sort Direction Helpers
    private void ToggleSortDirection() =>
        _sortDirection = _sortDirection == SortDirection.Ascending ? SortDirection.Descending : SortDirection.Ascending;

    private string GetSortLabel() =>
        _sortDirection == SortDirection.Ascending ? "Ascending" : "Descending";

    private string GetSortTooltip() =>
        _sortDirection == SortDirection.Ascending ? "Ascending — low to high" : "Descending — high to low";

    private string GetSortIconClass() =>
        _sortDirection == SortDirection.Descending ? "transition-transform duration-200 rotate-180" : "transition-transform duration-200";
    #endregion

    private async Task TestAsync()
    {
        if (!CanTest || LimitIsInvalid)
        {
            return;
        }

        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _cancellationTokenSource.Token;

        _state = State.Testing;
        _testedProvider = null;
        _testedListIdentifier = string.Empty;

        try
        {
            var importListService = ImportListServiceIndex[_provider!.Value];
            var results = (await importListService.GetEnrichedImportListItemsAsync(_listIdentifier.Trim(), cancellationToken)).ToList();

            _previewResults = results;
            _previewBlacklistedSourceIds.Clear();
            _focusedPreviewResult = null;
            _state = _previewResults.Count > 0 ? State.Success : State.Failed;

            if (_state == State.Success)
            {
                _testedProvider = _provider;
                _testedListIdentifier = _listIdentifier.Trim();
            }
        }
        catch (OperationCanceledException)
        {
            _state = State.Idle;
            _previewBlacklistedSourceIds.Clear();
            _focusedPreviewResult = null;
            _testedProvider = null;
            _testedListIdentifier = string.Empty;
        }
        catch (Exception)
        {
            _state = State.Failed;
            _previewResults = [];
            _previewBlacklistedSourceIds.Clear();
            _focusedPreviewResult = null;
            _testedProvider = null;
            _testedListIdentifier = string.Empty;
        }
    }

    private async Task SaveAsync()
    {
        _state = State.Saving;

        var createData = new ImportListCreateData
        {
            IsEnabled = _isEnabled,
            Provider = _provider!.Value,
            Strategy = _strategy,
            ListIdentifier = _listIdentifier.Trim(),
        };

        try
        {
            var cancellationToken = _cancellationTokenSource?.Token ?? CancellationToken.None;
            await ImportListRepository.CreateImportListsAsync(_name.Trim(), createData, cancellationToken);
            _state = State.Saved;
            NavigationManager.NavigateTo("/lists");
        }
        catch (OperationCanceledException)
        {
            _state = State.Idle;
        }
        catch (Exception)
        {
            _state = State.Failed;
        }
    }


    public void Dispose()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = null;
    }
}
