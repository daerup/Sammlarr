    private void InvalidateTestStateIfSourceChanged()
    {
        if (_state is not (State.Success or State.Failed))
            return;

        if (_provider != _testedProvider ||
            !string.Equals(_listIdentifier.Trim(), _testedListIdentifier, StringComparison.Ordinal))
        {
            _state = State.Idle;
            _testedProvider = null;
            _testedListIdentifier = string.Empty;
        }
    }

    private void HandleFilterChanged(FilterDefinition filter) {}

    private static string GetPreviewSourceKey(IMediaDetailResult result) => result.SourceId.ToString() ?? string.Empty;

    private bool IsPreviewBlacklisted(IMediaDetailResult result) =>
        _previewBlacklistedSourceIds.Contains(GetPreviewSourceKey(result));

    private bool IsInWatchlist(IMediaDetailResult result) =>
        _watchlistSourceIds.Contains(GetPreviewSourceKey(result));

    private async Task TogglePreviewBlacklistAsync(IMediaDetailResult result)
    {
        if (_togglingBlacklistItem is not null)
            return;

        _togglingBlacklistItem = result;
        try
        {
            var sourceKey = GetPreviewSourceKey(result);

            if (_previewBlacklistedSourceIds.Contains(sourceKey))
            {
                await BlacklistService.RemoveFromBacklistAsync(result.SourceId);
                _previewBlacklistedSourceIds.Remove(sourceKey);
            }
            else
            {
                await BlacklistService.AddToBacklistAsync(result.SourceId);
                _previewBlacklistedSourceIds.Add(sourceKey);
            }
        }
        finally
        {
            _togglingBlacklistItem = null;
            _focusedPreviewResult = null;
        }
    }

    private async Task TogglePreviewWatchlistAsync(IMediaDetailResult result)
    {
        if (_togglingWatchlistItem is not null)
            return;

        _togglingWatchlistItem = result;
        try
        {
            var providerConfig = await ProviderConfigRepository.GetAsync();
            var watchlistService = WatchlistServiceIndex[providerConfig.WatchlistProvider];
            var sourceKey = GetPreviewSourceKey(result);

            if (_watchlistSourceIds.Contains(sourceKey))
            {
                if (await watchlistService.RemoveFromWatchlistAsync(result.SourceId))
                    _watchlistSourceIds.Remove(sourceKey);
            }
            else
            {
                if (await watchlistService.AddToWatchlistAsync(result.SourceId))
                    _watchlistSourceIds.Add(sourceKey);
            }
        }
        finally
        {
            _togglingWatchlistItem = null;
            _focusedPreviewResult = null;
        }
    }

    private void ClearFocusedPreviewResult(IMediaDetailResult result)
    {
        if (ReferenceEquals(_focusedPreviewResult, result))
            _focusedPreviewResult = null;
    }


    private static IMediaDetailResult? GetItemFromResult(QueryResult<IMediaDetailResult> result) =>
        result.Value switch
        {
            IMediaDetailResult item => item,
            Skipped<IMediaDetailResult> s => s.Item,
            Filtered<IMediaDetailResult> f => f.Item,
            _ => null,
        };

    private Task HandleTestAsync() => TestAsync();

    private Task HandleSaveAsync()
    {
        _showValidation = true;
        return CanSave ? SaveAsync() : Task.CompletedTask;
    }


    private IEnumerable<QueryResult<IMediaDetailResult>> FilteredPreviewResults =>
        string.IsNullOrWhiteSpace(_previewFilterQuery) ? _processedResults : _processedResults.Where(r => GetItemFromResult(r)?.Title.Contains(_previewFilterQuery, StringComparison.OrdinalIgnoreCase) == true);

    private void ReprocessResults()
    {
        if (_rawResults.Count == 0)
        {
            _processedResults = [];
            return;
        }

        var options = new QueryOptions { Sort = _sort, Limit = GetEffectiveQueryLimit(), Filter = GetEffectiveQueryFilter() };
        _processedResults = QueryProcessor.Execute(_rawResults, options).ToList();
    }

    private QueryLimit? GetEffectiveQueryLimit() => _limit is { } l && ParsedLimit is { } n ? l with { Count = n } : null;

    private QueryFilter? GetEffectiveQueryFilter() => _filtersEnabled ? FilterDefinitionConverter.ToQueryFilter(_filter) : null;

    private void ApplyQuerySettings()
    {
        _appliedFiltersEnabled = _filtersEnabled;
        _appliedFilterVersion = _filter.Version;
        _appliedSort = _sort;
        _appliedLimit = _limit;
        _appliedLimitRaw = _limitRaw;
        ReprocessResults();
    }

    private void ToggleSortDirection() =>
        _sortDirection = _sortDirection == SortDirection.Ascending ? SortDirection.Descending : SortDirection.Ascending;

    private string GetSortLabel() =>
        _sortDirection == SortDirection.Ascending ? "Ascending" : "Descending";

    private string GetSortTooltip() =>
        _sortDirection == SortDirection.Ascending ? "Ascending (low to high)" : "Descending (high to low)";

    private string GetSortIconClass() =>
        _sortDirection == SortDirection.Descending ? "transition-transform duration-200 rotate-180" : "transition-transform duration-200";


    private async Task TestAsync()
    {
        if (!CanTest || LimitIsInvalid)
        {
            return;
        }

        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = new CancellationTokenSource();
        var cancellationToken = _cancellationTokenSource.Token;

        _state = State.Testing;
        _testedProvider = null;
        _testedListIdentifier = string.Empty;

        try
        {
            var importListService = ImportListServiceIndex[_provider!.Value];
            var results = (await importListService.GetEnrichedImportListItemsAsync(_listIdentifier.Trim(), cancellationToken)).ToList();
            var watchlistSourceIds = await GetWatchlistSourceIdsAsync(cancellationToken);
            var blacklistSourceIds = await GetBlacklistSourceIdsAsync(cancellationToken);

            _rawResults = results;
            _previewBlacklistedSourceIds.Clear();
            _previewBlacklistedSourceIds.UnionWith(blacklistSourceIds);
            _watchlistSourceIds.Clear();
            _watchlistSourceIds.UnionWith(watchlistSourceIds);
            _focusedPreviewResult = null;
            _state = _rawResults.Count > 0 ? State.Success : State.Failed;

            if (_state == State.Success)
            {
                _testedProvider = _provider;
                _testedListIdentifier = _listIdentifier.Trim();
                ApplyQuerySettings();
            }
        }
        catch (OperationCanceledException)
        {
            _state = State.Idle;
            _rawResults = [];
            _processedResults = [];
            _previewBlacklistedSourceIds.Clear();
            _watchlistSourceIds.Clear();
            _focusedPreviewResult = null;
            _testedProvider = null;
            _testedListIdentifier = string.Empty;
        }
        catch (Exception)
        {
            _state = State.Failed;
            _rawResults = [];
            _processedResults = [];
            _previewBlacklistedSourceIds.Clear();
            _watchlistSourceIds.Clear();
            _focusedPreviewResult = null;
            _testedProvider = null;
            _testedListIdentifier = string.Empty;
        }
    }

    private async Task<HashSet<string>> GetWatchlistSourceIdsAsync(CancellationToken cancellationToken)
    {
        try
        {
            var providerConfig = await ProviderConfigRepository.GetAsync(cancellationToken);
            var watchlistService = WatchlistServiceIndex[providerConfig.WatchlistProvider];
            var sourceIds = new HashSet<string>(StringComparer.Ordinal);

            var firstPage = await watchlistService.GetWatchlistAsync(1, cancellationToken);
            AddWatchlistSourceIds(sourceIds, firstPage.Items);

            for (var page = 2; page <= firstPage.TotalPages; page++)
            {
                var nextPage = await watchlistService.GetWatchlistAsync(page, cancellationToken);
                AddWatchlistSourceIds(sourceIds, nextPage.Items);
            }

            return sourceIds;
        }
        catch
        {
            return [];
        }
    }

    private static void AddWatchlistSourceIds(HashSet<string> sourceIds, IEnumerable<IWatchlistItem> items)
    {
        foreach (var item in items)
        {
            var sourceKey = item.SourceId.ToString();
            if (!string.IsNullOrWhiteSpace(sourceKey))
            {
                sourceIds.Add(sourceKey);
            }
        }
    }

    private async Task<HashSet<string>> GetBlacklistSourceIdsAsync(CancellationToken cancellationToken)
    {
        try
        {
            var providerConfig = await ProviderConfigRepository.GetAsync(cancellationToken);
            var mediaProvider = providerConfig.WatchlistProvider.AsMediaProvider();
            var items = await BlacklistService.GetBlacklistItems(mediaProvider, cancellationToken);
            var sourceIds = new HashSet<string>(StringComparer.Ordinal);

            foreach (var item in items)
            {
                var sourceKey = item.SourceId.ToString();
                if (!string.IsNullOrWhiteSpace(sourceKey))
                    sourceIds.Add(sourceKey);
            }

            return sourceIds;
        }
        catch
        {
            return [];
        }
    }

    private async Task SaveAsync()
    {
        _state = State.Saving;

        try
        {
            var cancellationToken = _cancellationTokenSource?.Token ?? CancellationToken.None;

            if (IsEditMode)
            {
                var updateData = new ImportListUpdateData
                {
                    Name = _name.Trim(),
                    IsEnabled = _isEnabled,
                    Provider = _provider!.Value,
                    Strategy = _strategy,
                    ListIdentifier = _listIdentifier.Trim(),
                    Filter = GetEffectiveQueryFilter(),
                    Sort = _appliedSort,
                    Limit = _appliedLimit is { } appliedLimit && ParsedLimit is { } appliedLimitCount ? appliedLimit with { Count = appliedLimitCount } : null,
                };

                await ImportListRepository.CreateImportListsAsync(ImportListId!.Value, updateData, cancellationToken);
            }
            else
            {
                var createData = new ImportListCreateData
                {
                    IsEnabled = _isEnabled,
                    Provider = _provider!.Value,
                    Strategy = _strategy,
                    ListIdentifier = _listIdentifier.Trim(),
                    Filter = GetEffectiveQueryFilter(),
                    Sort = _appliedSort,
                    Limit = _appliedLimit is { } appliedLimit && ParsedLimit is { } appliedLimitCount ? appliedLimit with { Count = appliedLimitCount } : null,
                };

                await ImportListRepository.CreateImportListsAsync(_name.Trim(), createData, cancellationToken);
            }

            _state = State.Saved;
            NavigationManager.NavigateTo("/lists");
        }
        catch (OperationCanceledException)
        {
            _state = State.Idle;
        }
        catch (Exception)
        {
            _state = State.Failed;
        }
    }


    public void Dispose()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = null;

        if (_isShortcutRegistered)
        {
            _shortcutRegistration?.Dispose();
            _shortcutRegistration = null;
            KeyboardShortcutService.Unregister(SubscriptionShortcutId);
            _isShortcutRegistered = false;
        }
    }
}
