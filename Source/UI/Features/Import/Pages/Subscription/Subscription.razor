        FieldDefinitions
            .Select(f => new FilterField { Name = f.Property, Label = f.Label, Type = f.FilterType })
            .ToList();

    private bool NameIsInvalid => _showValidation && string.IsNullOrWhiteSpace(_name);
    private bool ListIdentifierIsInvalid => _showValidation && string.IsNullOrWhiteSpace(_listIdentifier);
    private int? ParsedLimit => int.TryParse(_limitRaw, out var n) && n > 0 ? n : null;
    private bool LimitIsInvalid => _limitEnabled && ParsedLimit is null;

    private bool CanTest => !string.IsNullOrWhiteSpace(_listIdentifier) && _provider is not null;
    private bool CanSave =>
        _state == State.Success &&
        _provider is not null &&
        _provider == _testedProvider &&
        !string.IsNullOrWhiteSpace(_listIdentifier) &&
        string.Equals(_listIdentifier.Trim(), _testedListIdentifier, StringComparison.Ordinal) &&
        !string.IsNullOrWhiteSpace(_name) &&
        !LimitIsInvalid &&
        (!IsEditMode || HasEditChanges);

    private bool HasEditChanges =>
        !string.Equals(_name.Trim(), _initialName, StringComparison.Ordinal) ||
        !string.Equals(_listIdentifier.Trim(), _initialListIdentifier, StringComparison.Ordinal) ||
        _isEnabled != _initialIsEnabled ||
        _provider != _initialProvider ||
        _strategy != _initialStrategy ||
        _appliedFiltersEnabled != _initialFiltersEnabled ||
        (_appliedFiltersEnabled && _appliedFilterVersion != _initialFilterVersion) ||
        _appliedSort != _initialSort ||
        _appliedLimit != _initialLimit ||
        (_appliedLimit is not null && _appliedLimitRaw != _initialLimitRaw);

    private bool IsProcessing => _state is State.Testing or State.Saving;
    private bool ShowTestButton => _state is State.Idle or State.Failed || _rawResults.Count == 0;
    private bool ShowApplyButton => _state == State.Success && _rawResults.Count > 0 && HasPendingQueryChanges;
    private bool ShowSaveButton => _state == State.Success && _rawResults.Count > 0 && !HasPendingQueryChanges;

    private bool HasPendingQueryChanges =>
        _rawResults.Count > 0 && (
        _filtersEnabled != _appliedFiltersEnabled ||
        (_filtersEnabled && _filter.Version != _appliedFilterVersion) ||
        _sort != _appliedSort ||
        _limit != _appliedLimit ||
        (_limit is not null && _limitRaw != _appliedLimitRaw)
        );

    private int IncludedCount => _processedResults.Count(r => r.Value is IMediaDetailResult);
    private int FilteredPreviewCount => _processedResults.Count(r => r.Value is Filtered<IMediaDetailResult>);
    private int SkippedPreviewCount => _processedResults.Count(r => r.Value is Skipped<IMediaDetailResult>);
    private int WatchlistTotalCount => _processedResults.Count(r => GetItemFromResult(r) is {} item && IsInWatchlist(item));
    private int BlacklistedTotalCount => _processedResults.Count(r => GetItemFromResult(r) is {} item && IsPreviewBlacklisted(item));

    private Task OnRunModeChanged(RunMode mode)
    {
        _runMode = mode;
        _scheduleCronExpression = mode == RunMode.Manual ? string.Empty : null;
