    protected override async Task OnInitializedAsync()
    {
        foreach (var provider in Enum.GetValues<MediaListProvider>())
        {
            var apiKey = await ApiKeyConfigRepository.GetApiKeyAsync(provider.AsMediaProvider());
            if (string.IsNullOrEmpty(apiKey))
                _disabledProviders.Add(provider);
        }

        if (IsEditMode || IsCloneMode)
        {
            var sourceImportListId = IsEditMode ? ImportListId!.Value : CloneSourceImportListId!.Value;
            var importList = (await ImportListRepository.GetImportListsAsync())
                .FirstOrDefault(list => list.Id == sourceImportListId);

            if (importList is null)
            {
                NavigationManager.NavigateTo("/lists");
                return;
            }

            _name = importList.Name;
            _isEnabled = importList.Enabled;
            _provider = importList.Provider;
            _strategy = importList.Strategy;
            _listIdentifier = importList.ListIdentifier;

            if (importList.Filter is { } existingFilter)
            {
                _filter = FilterDefinitionConverter.FromQueryFilter(existingFilter);
                _filtersEnabled = !_filter.IsEmpty;
            }

            _sort = importList.Sort;

            if (importList.Limit is { } limit)
            {
                _limit = limit;
                _limitRaw = limit.Count.ToString();
            }

            _filtersSectionOpen = _filtersEnabled || _sort is not null || _limit is not null;

            _disabledProviders.Remove(importList.Provider);

            if (IsEditMode)
            {
                _initialName = importList.Name.Trim();
                _initialIsEnabled = importList.Enabled;
                _initialProvider = importList.Provider;
                _initialStrategy = importList.Strategy;
                _initialListIdentifier = importList.ListIdentifier.Trim();
                _initialFiltersEnabled = _filtersEnabled;
                _initialFilterVersion = _filter.Version;
                _initialSort = _sort;
                _initialLimit = _limit;
                _initialLimitRaw = _limitRaw;
