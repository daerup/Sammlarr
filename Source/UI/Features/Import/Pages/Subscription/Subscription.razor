@page "/subscription/create"
@page "/subscription/{ImportListId:guid}/edit"
@page "/subscription/{CloneSourceImportListId:guid}/clone"
@implements IDisposable
@using UI.Features.Import.Components
@using BlazorBlueprint.Primitives.Filtering
@using Contracts
@using Contracts.Media.List
@using Contracts.Media.Search
@using Contracts.DI
@using Contracts.Auth
@using Contracts.Processing
@using Contracts.Settings
@using Contracts.Watchlist
@using Contracts.Media.Blacklist
@using System.ComponentModel
@inject IImportListRepository ImportListRepository
@inject IKeyedServiceIndex<MediaListProvider, IImportListService> ImportListServiceIndex
@inject IApiKeyConfigRepository ApiKeyConfigRepository
@inject NavigationManager NavigationManager
@inject IKeyboardShortcutService KeyboardShortcutService
@inject IQueryProcessor<IMediaDetailResult> QueryProcessor
@inject IProviderConfigRepository ProviderConfigRepository
@inject IKeyedServiceIndex<WatchlistProvider, IWatchlistService> WatchlistServiceIndex
@inject IBlacklistService BlacklistService

<PageTitle>@PageTitleText</PageTitle>

<div class="flex flex-col h-[calc(100vh-7rem)] overflow-hidden">

    <div class="shrink-0 px-6 py-4 border-b flex items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-wide antialiased">@PageHeadingText</h1>
            <p class="text-sm text-muted-foreground mt-0.5 font-normal">@PageDescriptionText</p>
        </div>

        <div class="flex items-center gap-2">
            @if (_state == State.Testing)
            {
                <BbButton Variant="ButtonVariant.Default" Disabled="true">
                    <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                    <span>Testing…</span>
                </BbButton>
            }
            else if (ShowApplyButton)
            {
                <BbButton Variant="ButtonVariant.Default"
                          OnClick="ApplyQuerySettings"
                          Disabled="LimitIsInvalid">
                    <LucideIcon Name="check" Size="14" Class="mr-2"/>
                    Apply
                </BbButton>
            }
            else if (ShowSaveButton)
            {
                <BbButton Variant="ButtonVariant.Outline"
                          Class="text-success border-success hover:bg-success"
                          OnClick="HandleSaveAsync"
                          Disabled="!CanSave">
                    <LucideIcon Name="save" Size="14" Class="mr-2"/>
                    Save
                </BbButton>
            }
            else if (_state == State.Failed)
            {
                <BbButton Variant="ButtonVariant.Outline"
                          Class="text-destructive border-destructive hover:bg-destructive/10 hover:text-destructive"
                          Disabled="true">
                    <LucideIcon Name="x" Size="14" Class="mr-2"/>
                    Failed
                </BbButton>
            }
            else if (ShowTestButton)
            {
                <BbButton Variant="ButtonVariant.Default"
                          OnClick="HandleTestAsync"
                          Disabled="!CanTest || LimitIsInvalid">
                    <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                    Test
                </BbButton>
            }

            <BbButton Variant="ButtonVariant.Outline"
                      Class="text-destructive border-destructive hover:bg-destructive/10 hover:text-destructive"
                      OnClick="ReturnAsync"
                      Disabled="@IsProcessing">
                Cancel
            </BbButton>
        </div>
    </div>

    <div class="flex-1 min-h-0 flex flex-row gap-4 p-4 overflow-hidden">

        <BbCard Class="flex-1 min-w-0 flex flex-col overflow-hidden subscription-pane rounded-lg bg-card border border-border shadow-sm">
            <div class="flex-1 min-h-0 overflow-y-auto scrollbar-thin px-6 py-6">
                <div class="space-y-6 pb-4">

                    <BbField>
                        <BbFieldLabel Class="flex items-center leading-none">
                            Enabled
                            <BbTooltipProvider>
                                <BbTooltip DelayDuration="0">
                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                        <LucideIcon Name="info" Size="14"/>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Toggle to enable or disable this import.</BbTooltipContent>
                                </BbTooltip>
                            </BbTooltipProvider>
                        </BbFieldLabel>
                        <BbFieldContent>
                            <BbSwitch @bind-Checked="_isEnabled"/>
                        </BbFieldContent>
                    </BbField>

                    <BbField IsInvalid="NameIsInvalid">
                        <BbFieldLabel For="name" Class="flex items-center leading-none">
                            Name <span class="text-destructive ml-0.5">*</span>
                            <BbTooltipProvider>
                                <BbTooltip DelayDuration="0">
                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                        <LucideIcon Name="info" Size="14"/>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>A friendly label to identify this subscription across your lists.</BbTooltipContent>
                                </BbTooltip>
                            </BbTooltipProvider>
                        </BbFieldLabel>
                        <BbFieldContent>
                            <BbInput id="name" Placeholder="e.g. My Top Movies" @bind-Value="_name" Class="bg-accent" Required="true"
                                     AriaInvalid="@NameIsInvalid"
                                     UpdateTiming="UpdateTiming.Immediate" @onkeydown="HandleInputKeyDown"/>
                        </BbFieldContent>
                        @if (NameIsInvalid)
                        {
                            <BbFieldError>Name is required.</BbFieldError>
                        }
                    </BbField>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <BbField>
                            <BbFieldLabel Class="flex items-center leading-none">
                                Provider
                                @if (_disabledProviders.Count > 0)
                                {
                                    var allDisabled = _disabledProviders.Count == Enum.GetValues<MediaListProvider>().Length;
                                    <BbPopover>
                                        <BbPopoverTrigger AsChild="false"
                                                          Class="@($"ml-1 inline-flex items-center cursor-pointer {(allDisabled ? "text-destructive" : "text-amber-500")}")">
                                            <LucideIcon Name="triangle-alert" Size="14"/>
                                        </BbPopoverTrigger>
                                        <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Class="w-72">
                                            <div class="space-y-2">
                                                <p class="text-sm font-semibold">API key required</p>
                                                <p class="text-sm text-muted-foreground">
                                                    The following providers are unavailable because no API key is configured:
                                                    <span class="font-medium">@string.Join(", ", _disabledProviders)</span>.
                                                </p>
                                                <BbButton Variant="ButtonVariant.Link" Href="/settings?section=api-keys" Class="h-auto p-0 text-sm">
                                                    Go to Settings
                                                </BbButton>
                                            </div>
                                        </BbPopoverContent>
                                    </BbPopover>
                                }
                                <BbTooltipProvider>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                            <LucideIcon Name="info" Size="14"/>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>The external service that hosts the list you want to import.
                                        </BbTooltipContent>
                                    </BbTooltip>
                                </BbTooltipProvider>
                            </BbFieldLabel>
                            <BbFieldContent>
                                <EnumToggleGroup TEnum="MediaListProvider"
                                                 Value="_provider"
                                                 OnChange="@OnProviderChanged"
                                                 DisabledValues="_disabledProviders"/>
                            </BbFieldContent>
                        </BbField>

                        <BbField>
                            <BbFieldLabel Class="flex leading-none">
                                Strategy
                                <BbTooltipProvider>
                                    <BbTooltip>
                                        <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex p-0 text-muted-foreground cursor-default">
                                            <LucideIcon Name="info" Size="14"/>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Only relevant when a subscription runs more than once. Controls whether repeated syncs add to or
                                            replace
                                            your existing collection.
                                        </BbTooltipContent>
                                    </BbTooltip>
                                </BbTooltipProvider>
                            </BbFieldLabel>
                            <BbFieldContent>
                                <EnumToggleGroup TEnum="MediaListAddStrategy"
                                                 Value="_strategy"
                                                 OnChange="@OnStrategyChanged"
                                                 TooltipProvider="GetStrategyTooltip"/>
                            </BbFieldContent>
                        </BbField>
                    </div>

                    <BbField IsInvalid="ListIdentifierIsInvalid">
                        <BbFieldLabel For="list-identifier" Class="flex items-center leading-none">
                            List identifier <span class="text-destructive ml-0.5">*</span>
                            <BbTooltipProvider>
                                <BbTooltip>
                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                        <LucideIcon Name="info" Size="14"/>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>The unique string that locates your list within the selected provider. The exact format varies by
                                        provider;
                                        check the list's URL or the provider's documentation.
                                    </BbTooltipContent>
                                </BbTooltip>
                            </BbTooltipProvider>
                        </BbFieldLabel>
                        <BbFieldContent>
                            <BbInput id="list-identifier" Placeholder="@GetListIdentifierPlaceholder(_provider)"
                                     @bind-Value="_listIdentifier"
                                     @bind-Value:after="OnListIdentifierChanged"
                                     Class="bg-accent"
                                     Required="true" AriaInvalid="@ListIdentifierIsInvalid" UpdateTiming="UpdateTiming.Immediate"
                                     @onkeydown="HandleInputKeyDown"/>
                        </BbFieldContent>
                        <BbFieldDescription>@RenderListIdentifierDescription()</BbFieldDescription>
                        @if (ListIdentifierIsInvalid)
                        {
                            <BbFieldError>List identifier is required.</BbFieldError>
                        }
                    </BbField>

                </div>

                <BbCollapsible @bind-Open="_filtersSectionOpen">
                    <BbCollapsibleTrigger AsChild="false"
                                          Class="group w-full flex items-center justify-between -mx-6 px-6 py-3 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors border-t">
                <span class="flex items-center gap-2">
                    <LucideIcon Name="sliders-horizontal" Size="14"/>
                    Filters, Sorting & Limits
                    <span class="text-xs font-normal opacity-50">optional</span>
                </span>
                        <LucideIcon Name="chevron-down" Size="14" Class="transition-transform duration-200 group-data-[state=open]:rotate-180"/>
                    </BbCollapsibleTrigger>
                    <BbCollapsibleContent>
                        <div class="pt-4 pb-4 space-y-6">

                            <BbField>
                                <BbFieldLabel Class="flex items-center leading-none">
                                    Enable filters
                                    <BbTooltipProvider>
                                        <BbTooltip DelayDuration="0">
                                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                <LucideIcon Name="info" Size="14"/>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>Limit which imported items are added to your collection. Filter by genre, rating, release year,
                                                and
                                                more.
                                            </BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                </BbFieldLabel>
                                <BbFieldContent>
                                    <BbSwitch @bind-Checked="_filtersEnabled"/>
                                </BbFieldContent>
                            </BbField>

                            @if (_filtersEnabled)
                            {
                                <BbFilterBuilder @bind-Filter="_filter"
                                                 Fields="FilterFields"
                                                 OnFilterChanged="HandleFilterChanged"/>
                            }

                            <BbField>
                                <BbFieldLabel Class="flex items-center leading-none">
                                    Enable custom sorting
                                    <BbTooltipProvider>
                                        <BbTooltip DelayDuration="0">
                                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                <LucideIcon Name="info" Size="14"/>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>Sort imported items by a specific field before applying the limit.</BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                </BbFieldLabel>
                                <BbFieldContent>
                                    <BbSwitch @bind-Checked="_sortingEnabled"/>
                                </BbFieldContent>
                            </BbField>

                            @if (_sortingEnabled)
                            {
                                <BbField>
                                    <BbFieldLabel Class="flex items-center leading-none">
                                        Sort by
                                    </BbFieldLabel>
                                    <BbFieldContent>
                                        <div class="flex items-center gap-3">
                                            <BbSelect TValue="string"
                                                      Value="_sortField"
                                                      Class="w-40"
                                                      ValueChanged="@((v) => _sortField = v ?? _sortField)"
                                                      Options="SortFields"/>
                                            <BbTooltipProvider>
                                                <BbTooltip DelayDuration="0">
                                                    <BbTooltipTrigger AsChild="false" Class="p-0">
                                                        <BbButton Size="ButtonSize.Icon"
                                                                  Variant="ButtonVariant.Outline"
                                                                  OnClick="@ToggleSortDirection"
                                                                  AriaLabel="@GetSortLabel()">
                                                            <LucideIcon Name="arrow-up" Size="14"
                                                                        Class="@GetSortIconClass()"/>
                                                        </BbButton>
                                                    </BbTooltipTrigger>
                                                    <BbTooltipContent>@GetSortTooltip()</BbTooltipContent>
                                                </BbTooltip>
                                            </BbTooltipProvider>
                                        </div>
                                    </BbFieldContent>
                                </BbField>
                            }

                            <BbField>
                                <BbFieldLabel Class="flex items-center leading-none">
                                    Enable limit
                                    <BbTooltipProvider>
                                        <BbTooltip DelayDuration="0">
                                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                <LucideIcon Name="info" Size="14"/>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>Cap the number of imported items.</BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                </BbFieldLabel>
                                <BbFieldContent>
                                    <BbSwitch @bind-Checked="_limitEnabled"/>
                                </BbFieldContent>
                            </BbField>

                            @if (_limitEnabled)
                            {
                                <BbField IsInvalid="LimitIsInvalid">
                                    <BbFieldLabel For="limit" Class="flex items-center leading-none">
                                        Maximum items
                                    </BbFieldLabel>
                                    <BbFieldContent>
                                        <BbInput id="limit"
                                                 Placeholder="e.g. 100"
                                                 @bind-Value="_limitRaw"
                                                 Class="bg-accent w-40"
                                                 AriaInvalid="@LimitIsInvalid"
                                                 UpdateTiming="UpdateTiming.Immediate" @onkeydown="HandleInputKeyDown"/>
                                    </BbFieldContent>
                                    @if (LimitIsInvalid)
                                    {
                                        <BbFieldError>Limit must be a positive whole number.</BbFieldError>
                                    }
                                </BbField>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <BbField>
                                        <BbFieldLabel Class="flex items-center leading-none">
                                            Watchlist limit behavior
                                            <BbTooltipProvider>
                                                <BbTooltip>
                                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                        <LucideIcon Name="info" Size="14"/>
                                                    </BbTooltipTrigger>
                                                    <BbTooltipContent>Controls how already watchlisted items count towards the specified limit, since these
                                                        items
                                                        can't be imported.
                                                    </BbTooltipContent>
                                                </BbTooltip>
                                            </BbTooltipProvider>
                                        </BbFieldLabel>
                                        <BbFieldContent>
                                            <EnumToggleGroup TEnum="LimitBehavior"
                                                             Value="_watchlistedLimitBehavior"
                                                             OnChange="@OnWatchlistedLimitBehaviorChanged"
                                                             TooltipProvider="GetLimitBehaviorTooltip"/>
                                        </BbFieldContent>
                                    </BbField>

                                    <BbField>
                                        <BbFieldLabel Class="flex items-center leading-none">
                                            Blacklist limit behavior
                                            <BbTooltipProvider>
                                                <BbTooltip>
                                                    <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                        <LucideIcon Name="info" Size="14"/>
                                                    </BbTooltipTrigger>
                                                    <BbTooltipContent>Controls how blacklisted items count towards the specified limit, since these items can't
                                                        be
                                                        imported.
                                                    </BbTooltipContent>
                                                </BbTooltip>
                                            </BbTooltipProvider>
                                        </BbFieldLabel>
                                        <BbFieldContent>
                                            <EnumToggleGroup TEnum="LimitBehavior"
                                                             Value="_blacklistedLimitBehavior"
                                                             OnChange="@OnBlacklistedLimitBehaviorChanged"
                                                             TooltipProvider="GetLimitBehaviorTooltip"/>
                                        </BbFieldContent>
                                    </BbField>
                                </div>
                            }

                        </div>
                    </BbCollapsibleContent>
                </BbCollapsible>

                <BbCollapsible>
                    <BbCollapsibleTrigger AsChild="false"
                                          Class="group w-full flex items-center justify-between -mx-6 px-6 py-3 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors border-t">
                <span class="flex items-center gap-2">
                    <LucideIcon Name="clock" Size="14"/>
                    Sync Frequency
                    <span class="text-xs font-normal opacity-50">optional</span>
                </span>
                        <LucideIcon Name="chevron-down" Size="14" Class="transition-transform duration-200 group-data-[state=open]:rotate-180"/>
                    </BbCollapsibleTrigger>
                    <BbCollapsibleContent>
                        <div class="pt-4 pb-4 space-y-6">
                            <BbField>
                                <BbFieldLabel Class="flex items-center leading-none">
                                    Trigger
                                    <BbTooltipProvider>
                                        <BbTooltip DelayDuration="0">
                                            <BbTooltipTrigger AsChild="false" Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                <LucideIcon Name="info" Size="14"/>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>When to sync this subscription, on demand or on a recurring schedule.</BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                </BbFieldLabel>
                                <BbFieldContent>
                                    <EnumToggleGroup TEnum="RunMode"
                                                     Value="_runMode"
                                                     OnChange="@OnRunModeChanged"/>
                                </BbFieldContent>
                            </BbField>

                            @if (_runMode == RunMode.Scheduled)
                            {
                                <BbField>
                                    <BbFieldLabel Class="flex items-center leading-none">
                                        Schedule
                                        <BbTooltipProvider>
                                            <BbTooltip DelayDuration="0">
                                                <BbTooltipTrigger AsChild="false"
                                                                  Class="ml-1 inline-flex items-center p-0 text-muted-foreground cursor-default">
                                                    <LucideIcon Name="info" Size="14"/>
                                                </BbTooltipTrigger>
                                                <BbTooltipContent>Define a CRON schedule for automatic runs.</BbTooltipContent>
                                            </BbTooltip>
                                        </BbTooltipProvider>
                                    </BbFieldLabel>
                                    <BbFieldContent>
                                        <SchedulePicker CronExpression="@_scheduleCronExpression"
                                                        CronExpressionChanged="@((value) => _scheduleCronExpression = value)"/>
                                    </BbFieldContent>
                                </BbField>
                            }

                        </div>
                    </BbCollapsibleContent>
                </BbCollapsible>

            </div>
        </BbCard>

        <BbCard Class="flex-1 min-w-0 flex flex-col overflow-hidden subscription-pane rounded-lg bg-card border border-border shadow-sm">
            <div class="shrink-0 sticky top-0 z-20 px-6 pt-6 pb-4 border-b flex items-center gap-2 bg-base-100 rounded-t-lg">
                <BbInput Placeholder="Search media..."
                         Class="w-full"
                         @bind-Value="_previewFilterQuery"
                         UpdateTiming="UpdateTiming.Immediate" @onkeydown="HandleInputKeyDown"/>
                <LucideIcon Name="search" Class="text-muted-foreground shrink-0"/>
            </div>
            <div class="flex-1 min-h-0 overflow-y-auto scrollbar-thin px-6 pb-4 pt-4 flex flex-col">
                @if (_state == State.Success && FilteredPreviewResults.Any())
                {
                    <div class="mb-4 shrink-0">
                        <div class="flex items-center justify-between gap-3">
                            <h2 class="text-base font-semibold tracking-wide">Media Results</h2>
                            <BbTooltipProvider>
                                <div class="flex items-center gap-1.5 text-xs font-medium">
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="stat-badge cursor-default text-muted-foreground bg-muted/40">
                                            <LucideIcon Name="list" Size="14"/>
                                            <span>@_rawResults.Count</span>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Total items fetched from the source list</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="stat-badge cursor-default text-emerald-600 bg-emerald-500/10">
                                            <LucideIcon Name="check" Size="14"/>
                                            <span>@IncludedCount</span>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Items that will be imported</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="stat-badge cursor-default text-amber-600 bg-amber-500/10">
                                            <LucideIcon Name="filter-x" Size="14"/>
                                            <span>@FilteredPreviewCount</span>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Items removed by your filter rules</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="stat-badge cursor-default text-amber-600 bg-amber-500/10">
                                            <LucideIcon Name="scissors" Size="14"/>
                                            <span>@SkippedPreviewCount</span>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Items cut off by the import limit</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="stat-badge cursor-default text-blue-500 bg-blue-500/10">
                                            <LucideIcon Name="bookmark" Size="14"/>
                                            <span>@WatchlistTotalCount</span>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>
                                            <p class="font-medium mb-0.5">Watchlist</p>
                                            <p>@WatchlistTotalCount items across this list are already in your watchlist.</p>
                                            <p class="opacity-70 mt-0.5">These will not be imported as they are already tracked.</p>
                                        </BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip DelayDuration="0">
                                        <BbTooltipTrigger AsChild="false" Class="stat-badge cursor-default text-orange-500 bg-orange-500/10">
                                            <LucideIcon Name="shield-off" Size="14"/>
                                            <span>@BlacklistedTotalCount</span>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>
                                            <p class="font-medium mb-0.5">Blacklist</p>
                                            <p>@BlacklistedTotalCount items across this list are blacklisted.</p>
                                            <p class="opacity-70 mt-0.5">These are shown in the preview but will never be imported.</p>
                                        </BbTooltipContent>
                                    </BbTooltip>
                                </div>
                            </BbTooltipProvider>
                        </div>
                        <p class="text-sm text-muted-foreground mt-0.5">
                            <ProviderListLink ListIdentifier="@_testedListIdentifier" Provider="@_testedProvider!.Value"/>
                        </p>
                    </div>
                    <div class="space-y-2">
                        @foreach (var result in FilteredPreviewResults)
                        {
                            var item = GetItemFromResult(result);
                            if (item is not null)
                            {
                                var isFiltered = result.Value is Filtered<IMediaDetailResult>;
                                var isSkipped = result.Value is Skipped<IMediaDetailResult>;
                                var isDimmed = isFiltered || isSkipped;
                                var isBlacklisted = IsPreviewBlacklisted(item);
                                var isInWatchlist = IsInWatchlist(item);
                                var isTogglingWatchlist = _togglingWatchlistItem == item;
                                var isTogglingBlacklist = _togglingBlacklistItem == item;
                                <MediaDetailTile @key="item"
                                                 Result="item"
                                                 Class="@(isDimmed ? "result-dimmed" : "hover-bg")"
                                                 IsFocused="_focusedPreviewResult == item"
                                                 OnFocusIn="() => _focusedPreviewResult = item"
                                                 OnFocusOut="() => ClearFocusedPreviewResult(item)">
                                    <Icons>
                                        @if (isDimmed)
                                        {
                                            <BbTooltipProvider>
                                                <BbTooltip DelayDuration="300">
                                                    <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                                                        <div class="search-result-status-indicator">
                                                            <LucideIcon Name="@(isFiltered ? "filter-x" : "scissors")" Size="24"/>
                                                        </div>
                                                    </BbTooltipTrigger>
                                                    <BbTooltipContent>
                                                        @(isFiltered ? "Filtered out by your filter rules." : "Excluded by the specified limit.")
                                                    </BbTooltipContent>
                                                </BbTooltip>
                                            </BbTooltipProvider>
                                        }
                                            <WatchlistToggleIcon Result="item" IsToggled="isInWatchlist" IsToggling="isTogglingWatchlist"
                                                                 OnToggle="TogglePreviewWatchlistAsync"/>
                                            <BlacklistToggleIcon Result="item" IsToggled="isBlacklisted" IsToggling="isTogglingBlacklist"
                                                                 OnToggle="TogglePreviewBlacklistAsync"/>
                                    </Icons>
                                </MediaDetailTile>
                            }
                        }
                    </div>
                }
                else if (_state == State.Success)
                {
