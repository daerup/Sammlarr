@page "/subscription/create"
@page "/subscription/{EditImportListId}/edit"
@page "/subscription/{CloneImportListId}/clone"
@using Contracts.Media.List
@using Contracts.Settings
@using global::Shared
@implements IDisposable
@inject IImportListRepository ImportListRepository
@inject NavigationManager NavigationManager
@inject IKeyboardShortcutService KeyboardShortcutService
@inject IProviderConfigRepository ProviderConfigRepository
@inject ProfileDropdownService ProfileDropdownService

<PageTitle>@PageTitleText</PageTitle>

<OauthGuard Provider="@_providerConfig.WatchlistProvider" AccessChanged="HandleAccessChangedAsync"/>

<PageContainer Heading="@PageHeadingText"
               Description="@PageDescriptionText"
               HeaderClass="@(IsOAuthAllowed() ? "border-b" : "")">
    <HeaderActions>
        @if (_previewStatus.IsLoading)
        {
            <BbButton Variant="ButtonVariant.Default" Disabled="true">
                <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                <span>Testing…</span>
            </BbButton>
        }
        else if (ShowApplyButton)
        {
            <BbButton Variant="ButtonVariant.Default"
                      OnClick="() => ApplyAsync()"
                      Disabled="!_config.IsTestable">
                <LucideIcon Name="check" Size="14" Class="mr-2"/>
                Apply
            </BbButton>
        }
        else if (ShowSaveButton)
        {
            <BbButton Variant="ButtonVariant.Outline"
                      Class="text-success border-success hover:bg-success"
                      OnClick="HandleSaveAsync"
                      Disabled="!CanSave">
                <LucideIcon Name="save" Size="14" Class="mr-2"/>
                Save
            </BbButton>
        }
        else if (_previewStatus.HasFailed)
        {
            <BbButton Variant="ButtonVariant.Outline"
                      Class="text-destructive border-destructive hover:bg-destructive/10 hover:text-destructive"
                      OnClick="() => ApplyAsync()"
                      Disabled="!_config.IsTestable">
                <LucideIcon Name="rotate-cw" Size="14" Class="mr-2"/>
                Retry
            </BbButton>
        }
        else if (ShowTestButton)
        {
            <BbButton Variant="ButtonVariant.Default"
                      OnClick="() => ApplyAsync()"
                      Disabled="!_config.IsTestable">
                <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                Test
            </BbButton>
        }

        <BbButton Variant="ButtonVariant.Outline"
                  Class="text-destructive border-destructive hover:bg-destructive/10 hover:text-destructive"
                  OnClick="ReturnAsync"
                  Disabled="@(_previewStatus.IsLoading || _isSaving)">
            Cancel
        </BbButton>
    </HeaderActions>
    <ChildContent>
        <ProtectedSection GuardState="IsOAuthAllowed"
                          AuthProvider="@_providerConfig.WatchlistProvider"
                          DeniedActionDescription="managing subscriptions"
                          FallbackAction="() => ProfileDropdownService.RequestOpenAsync()">
            <div class="flex-1 min-h-0 flex flex-row gap-4 overflow-hidden" @onkeydown="HandleContainerKeyDownAsync">

                <SubscriptionConfigPanel @key="_configKey"
                                         Value="@_config"
                                         ShowValidation="@_showValidation"
                                         OnChange="@OnConfigChanged"/>

                <SubscriptionPreviewPanel @ref="_previewPanel"
                                          Config="@_config"
                                          OnStatusChanged="@OnPreviewStatusChanged"/>

            </div>
        </ProtectedSection>
    </ChildContent>
</PageContainer>

@code {

    [Parameter] public string? EditImportListId { get; set; }
    [Parameter] public string? CloneImportListId { get; set; }
    private bool IsEditOrClone => EditImportListId is not null || CloneImportListId is not null;

    private string PageTitleText =>
        EditImportListId is not null ? "Edit subscription"
        : CloneImportListId is not null ? "Clone subscription"
        : "Create subscription";
    private string PageHeadingText => PageTitleText;
    private string PageDescriptionText =>
        EditImportListId is not null ? "Update an existing subscription and keep your import settings in sync."
        : CloneImportListId is not null ? "Create a new subscription using values copied from an existing one."
        : "Import a list from an external provider and subscribe to it.";

    private ProviderConfig _providerConfig = null!;
    private bool _hasOAuthAccess;
    private bool IsOAuthAllowed() => _hasOAuthAccess;

    private SubscriptionConfig _config = new();
    private int? _storedHash;
    private int _appliedHash;

    private bool _showValidation;
    private bool _isSaving;
    private bool _pendingAutoApply;
    private PreviewStatus _previewStatus = new();
    private SubscriptionPreviewPanel _previewPanel = null!;

    private IDisposable? _shortcutRegistration;
    private bool _isShortcutRegistered;
    private const string SubscriptionShortcutId = "subscription-ctrl-enter";

    private int _configKey;

    private bool HasChanged => _storedHash is null || _config.GetSaveHash() != _storedHash;
    private bool HasPendingChanges => _config.GetPreviewHash() != _appliedHash;

    private bool CanSave => _config.IsValid && _previewStatus.HasResults && HasChanged;

    private bool ShowTestButton => !_previewStatus.HasResults && !_previewStatus.IsLoading && !_isSaving;
    private bool ShowApplyButton => _previewStatus.HasResults && (HasPendingChanges || _previewStatus.HasEnrollmentChanges) && !_isSaving;
    private bool ShowSaveButton => _previewStatus.HasResults && !HasPendingChanges && !_previewStatus.HasEnrollmentChanges && !_isSaving;

    private void OnPreviewStatusChanged(PreviewStatus status) => _previewStatus = status;
    private void OnConfigChanged(SubscriptionConfig config)
    {
        _config = config;
        StateHasChanged();
    }

    private Task HandleAccessChangedAsync(bool hasAccess)
    {
        _hasOAuthAccess = hasAccess;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        _providerConfig = await ProviderConfigRepository.GetAsync();
        if (!IsEditOrClone)
        {
            return;
        }

        var sourceId = UrlGuid.Decode(EditImportListId ?? CloneImportListId);
        var importList = await ImportListRepository.GetImportListByIdAsync(sourceId);

        if (importList is null)
        {
            NavigationManager.NavigateTo("/lists");
            return;
        }

        _config = new SubscriptionConfig
        {
            Name = importList.Name.Trim(),
            IsEnabled = importList.Enabled,
            Provider = importList.Provider,
            Strategy = importList.Strategy,
            ListIdentifier = importList.ListIdentifier.Trim(),
            Filter = FilterDefinitionConverter.FromQueryFilter(importList.Filter),
            Sort = importList.Sort,
            Limit = importList.Limit,
            Schedule = importList.Schedule,
        };
        _storedHash = _config.GetSaveHash();
        _configKey++;
        _pendingAutoApply = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingAutoApply)
        {
            _pendingAutoApply = false;
            await ApplyAsync();
        }

        if (!_isShortcutRegistered)
        {
            _shortcutRegistration = await KeyboardShortcutService.RegisterAsync("Ctrl+Enter", OnShortcutActivatedAsync, SubscriptionShortcutId);
            _isShortcutRegistered = true;
        }
    }

    private async Task OnShortcutActivatedAsync()
    {
        if (_previewStatus.IsLoading || _isSaving)
        {
            return;
        }

        if (ShowSaveButton && CanSave)
        {
            await HandleSaveAsync();
        }
        else if (ShowApplyButton && _config.IsTestable)
        {
            await ApplyAsync();
        }
        else if (ShowTestButton && _config.IsTestable)
        {
            await ApplyAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyAsync()
    {
        await _previewPanel.ApplyAsync();
        _appliedHash = _config.GetPreviewHash();
        StateHasChanged();
    }

    private Task ReturnAsync()
    {
        NavigationManager.NavigateTo("/lists");
        return Task.CompletedTask;
    }

    private Task HandleSaveAsync()
    {
        _showValidation = true;
        return CanSave ? SaveAsync() : Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;

        try
        {
            if (EditImportListId is not null)
            {
                var editId = UrlGuid.Decode(EditImportListId);
                var updateData = new ImportListUpdateData
                {
                    Name = _config.Name.Trim(),
                    IsEnabled = _config.IsEnabled,
                    Provider = _config.Provider!.Value,
                    Strategy = _config.Strategy,
                    ListIdentifier = _config.ListIdentifier.Trim(),
                    Filter = FilterDefinitionConverter.ToQueryFilter(_config.Filter),
                    Sort = _config.Sort,
                    Limit = _config.Limit,
                    Schedule = _config.Schedule,
                };

                await ImportListRepository.UpdateImportListsAsync(editId, updateData, CancellationToken.None);
            }
            else
            {
                var createData = new ImportListCreateData
                {
                    IsEnabled = _config.IsEnabled,
                    Provider = _config.Provider!.Value,
                    Strategy = _config.Strategy,
                    ListIdentifier = _config.ListIdentifier.Trim(),
                    Filter = FilterDefinitionConverter.ToQueryFilter(_config.Filter),
                    Sort = _config.Sort,
                    Limit = _config.Limit,
                    Schedule = _config.Schedule,
                };

                await ImportListRepository.CreateImportListsAsync(_config.Name.Trim(), createData, CancellationToken.None);
            }

            NavigationManager.NavigateTo("/lists");
        }
        catch (OperationCanceledException) {}
        catch (Exception)
        {
            _isSaving = false;
        }
    }

    private Task HandleContainerKeyDownAsync(KeyboardEventArgs args)
    {
        return args is { CtrlKey: true, Key: "Enter" } ? OnShortcutActivatedAsync() : Task.CompletedTask;
    }

    public void Dispose()
    {
        if (_isShortcutRegistered)
        {
            _shortcutRegistration?.Dispose();
            _shortcutRegistration = null;
            KeyboardShortcutService.Unregister(SubscriptionShortcutId);
            _isShortcutRegistered = false;
        }
    }
}
