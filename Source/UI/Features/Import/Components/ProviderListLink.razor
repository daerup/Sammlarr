@using Contracts.Media.List
@{
    var url = GetProviderUrl(ListIdentifier, Provider);
}

@if (url is not null)
{
    <a href="@url" target="_blank" rel="noopener noreferrer"
       class="inline-flex items-center gap-1 font-mono text-sm text-primary underline-offset-4 hover:underline">
        @ListIdentifier
        <LucideIcon Name="external-link" Size="12" Class="shrink-0 opacity-60"/>
    </a>
}
else
{
    <span class="font-mono text-sm">@ListIdentifier</span>
}

@code {
    [Parameter] [EditorRequired]
    public string ListIdentifier { get; set; } = string.Empty;

    [Parameter] [EditorRequired]
    public MediaListProvider Provider { get; set; }

    private static string GetProviderUrl(string listIdentifier, MediaListProvider provider) =>
        provider switch
        {
            MediaListProvider.Mdblist => $"https://mdblist.com/lists/{listIdentifier}",
            MediaListProvider.Tmdb => $"https://www.themoviedb.org/list/{listIdentifier}",
        };
}

