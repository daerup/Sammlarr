@using CronExpressionDescriptor
@using System.Linq.Expressions
@using System.Reflection
<div class="space-y-3">
    <BbSelect TValue="ScheduleMode"
              Value="_scheduleMode"
              ValueChanged="OnScheduleModeChanged"
              Options="ScheduleModeOptions"/>

    @if (_scheduleMode == ScheduleMode.Daily)
    {
        <div class="flex flex-wrap items-center gap-3">
            <BbTimePicker Value="_dailyTime"
                          ValueChanged="OnDailyTimeChanged"
                          Format="TimeFormat.Hour24"
                          MinuteStep="5"
                          Placeholder="Select time"/>
            @if (_dailyTime.HasValue)
            {
                <div class="flex flex-col gap-0.5 w-full">
                    <span class="text-xs text-muted-foreground font-mono flex items-center gap-1.5">
                        <LucideIcon Name="clock" Size="12"/>@ComputedExpression
                    </span>
                    @if (ExpressionDescription is not null)
                    {
                        <span class="text-xs text-muted-foreground italic">@ExpressionDescription</span>
                    }
                </div>
            }
        </div>
    }

    @if (_scheduleMode == ScheduleMode.Weekly)
    {
        <div class="flex flex-wrap items-center gap-3">
            <BbTimePicker Value="_weeklyTime"
                          ValueChanged="OnWeeklyTimeChanged"
                          Format="TimeFormat.Hour24"
                          MinuteStep="5"
                          Placeholder="Select time"/>
            <BbMultiSelect TValue="DayOfWeek"
                           Values="_weeklyDaysOfWeek"
                           ValuesChanged="OnWeeklyDaysChanged"
                           Options="DayOfWeekOptions"
                           MaxDisplayTags="2"
                           Placeholder="Select day(s)"
                           Class="min-w-56"/>
            @if (_weeklyTime.HasValue)
            {
                <div class="flex flex-col gap-0.5 w-full">
                    <span class="text-xs text-muted-foreground font-mono flex items-center gap-1.5">
                        <LucideIcon Name="clock" Size="12"/>@ComputedExpression
                    </span>
                    @if (ExpressionDescription is not null)
                    {
                        <span class="text-xs text-muted-foreground italic">@ExpressionDescription</span>
                    }
                </div>
            }
        </div>
    }

    @if (_scheduleMode == ScheduleMode.Expression)
    {
        <div class="flex flex-wrap items-center gap-2">
            <div class="flex flex-col items-center gap-0.5">
                <div style="@CronFieldStyle(_cronSecond)">
                    <BbInput Value="@_cronSecond"
                             ValueChanged="@(v => SetCronField(v, () => _cronSecond))"
                             Class="w-full text-center font-mono px-1 bg-accent"
                             Placeholder="*"
                             AriaLabel="Second — any integer 0–59, or * for every second"
                             AriaInvalid="@(!IsCronSecondValid)"
                             UpdateTiming="UpdateTiming.Immediate"/>
                </div>
                <span class="text-xs text-muted-foreground select-none">Second</span>
                <span class="text-[10px] @(IsCronSecondValid ? "invisible" : "text-destructive") select-none">0–59</span>
            </div>
            <div class="flex flex-col items-center gap-0.5">
                <div style="@CronFieldStyle(_cronMinute)">
                    <BbInput Value="@_cronMinute"
                             ValueChanged="@(v => SetCronField(v, () => _cronMinute))"
                             Class="w-full text-center font-mono px-1 bg-accent"
                             Placeholder="*"
                             AriaLabel="Minute — any integer 0–59, or * for every minute"
                             AriaInvalid="@(!IsCronMinuteValid)"
                             UpdateTiming="UpdateTiming.Immediate"/>
                </div>
                <span class="text-xs text-muted-foreground select-none">Minute</span>
                <span class="text-[10px] @(IsCronMinuteValid ? "invisible" : "text-destructive") select-none">0–59</span>
            </div>
            <div class="flex flex-col items-center gap-0.5">
                <div style="@CronFieldStyle(_cronHour)">
                    <BbInput Value="@_cronHour"
                             ValueChanged="@(v => SetCronField(v, () => _cronHour))"
                             Class="w-full text-center font-mono px-1 bg-accent"
                             Placeholder="*"
                             AriaLabel="Hour — any integer 0–23, or * for every hour"
                             AriaInvalid="@(!IsCronHourValid)"
                             UpdateTiming="UpdateTiming.Immediate"/>
                </div>
                <span class="text-xs text-muted-foreground select-none">Hour</span>
                <span class="text-[10px] @(IsCronHourValid ? "invisible" : "text-destructive") select-none">0–23</span>
            </div>
            <div class="flex flex-col items-center gap-0.5">
                <div style="@CronFieldStyle(_cronDayOfMonth)">
                    <BbInput Value="@_cronDayOfMonth"
                             ValueChanged="@(v => SetCronField(v, () => _cronDayOfMonth))"
                             Class="w-full text-center font-mono px-1 bg-accent"
                             Placeholder="*"
                             AriaLabel="Day of month — any integer 1–31, or * for every day"
                             AriaInvalid="@(!IsCronDayOfMonthValid)"
                             UpdateTiming="UpdateTiming.Immediate"/>
                </div>
                <span class="text-xs text-muted-foreground select-none">Day of Month</span>
                <span class="text-[10px] @(IsCronDayOfMonthValid ? "invisible" : "text-destructive") select-none">1–31</span>
            </div>
            <div class="flex flex-col items-center gap-0.5">
                <div style="@CronFieldStyle(_cronMonth)">
                    <BbInput Value="@_cronMonth"
                             ValueChanged="@(v => SetCronField(v, () => _cronMonth))"
                             Class="w-full text-center font-mono px-1 bg-accent"
                             Placeholder="*"
                             AriaLabel="Month — any integer 1–12, or * for every month"
                             AriaInvalid="@(!IsCronMonthValid)"
                             UpdateTiming="UpdateTiming.Immediate"/>
                </div>
                <span class="text-xs text-muted-foreground select-none">Month</span>
                <span class="text-[10px] @(IsCronMonthValid ? "invisible" : "text-destructive") select-none">1–12</span>
            </div>
            <div class="flex flex-col items-center gap-0.5">
                <div style="@CronFieldStyle(_cronDayOfWeek)">
                    <BbInput Value="@_cronDayOfWeek"
                             ValueChanged="@(v => SetCronField(v, () => _cronDayOfWeek))"
                             Class="w-full text-center font-mono px-1 bg-accent"
                             Placeholder="*"
                             AriaLabel="Day of week — 0 (Sunday) through 7 (Sunday), or * for every day"
                             AriaInvalid="@(!IsCronDayOfWeekValid)"
                             UpdateTiming="UpdateTiming.Immediate"/>
                </div>
                <span class="text-xs text-muted-foreground select-none">Day of Week</span>
                <span class="text-[10px] @(IsCronDayOfWeekValid ? "invisible" : "text-destructive") select-none">0–7</span>
            </div>

            @if (!string.IsNullOrEmpty(ComputedExpression))
            {
                <div class="flex flex-col gap-0.5 w-full">
                    <span class="text-xs text-muted-foreground font-mono flex items-center gap-1.5">
                        <LucideIcon Name="clock" Size="12"/>@ComputedExpression
                    </span>
                    @if (ExpressionDescription is not null)
                    {
                        <span class="text-xs text-muted-foreground italic">@ExpressionDescription</span>
                    }
                </div>
            }
        </div>
    }
</div>

@code {

    private enum ScheduleMode { Daily, Weekly, Expression }

    private sealed class DayOfWeekComparer : IComparer<DayOfWeek>
    {
        public static readonly DayOfWeekComparer Instance = new();

        public int Compare(DayOfWeek x, DayOfWeek y) => SortKey(x).CompareTo(SortKey(y));

        private static int SortKey(DayOfWeek day) => day == DayOfWeek.Sunday ? 7 : (int)day;
    }

    [Parameter] public string? CronExpression { get; set; }
    [Parameter] public EventCallback<string?> CronExpressionChanged { get; set; }

    private ScheduleMode _scheduleMode = ScheduleMode.Daily;
    private TimeSpan? _dailyTime;
    private TimeSpan? _weeklyTime;
    private List<DayOfWeek> _weeklyDaysOfWeek = [];
    private string _cronSecond = "*";
    private string _cronMinute = "*";
    private string _cronHour = "*";
    private string _cronDayOfMonth = "*";
    private string _cronMonth = "*";
    private string _cronDayOfWeek = "*";
    private bool _expressionConfigured;

    private bool IsCronSecondValid => IsCronPartValid(_cronSecond, 0, 59);
    private bool IsCronMinuteValid => IsCronPartValid(_cronMinute, 0, 59);
    private bool IsCronHourValid => IsCronPartValid(_cronHour, 0, 23);
    private bool IsCronDayOfMonthValid => IsCronPartValid(_cronDayOfMonth, 1, 31);
    private bool IsCronMonthValid => IsCronPartValid(_cronMonth, 1, 12);
    private bool IsCronDayOfWeekValid => IsCronPartValid(_cronDayOfWeek, 0, 7);
    private bool IsCronValid => IsCronSecondValid && IsCronMinuteValid && IsCronHourValid
                                && IsCronDayOfMonthValid && IsCronMonthValid && IsCronDayOfWeekValid;

    private string? ComputedExpression => _scheduleMode switch
    {
        ScheduleMode.Daily when _dailyTime.HasValue => $"0 {_dailyTime.Value.Minutes} {_dailyTime.Value.Hours} * * *",
        ScheduleMode.Weekly when _weeklyTime.HasValue && _weeklyDaysOfWeek.Count > 0
            => $"0 {_weeklyTime.Value.Minutes} {_weeklyTime.Value.Hours} * * {ToCronDayOfWeekSegment(_weeklyDaysOfWeek)}",
        ScheduleMode.Expression when IsCronValid && _expressionConfigured => $"{Normalize(_cronSecond)} {Normalize(_cronMinute)} {Normalize(_cronHour)} {Normalize(_cronDayOfMonth)} {Normalize(_cronMonth)} {Normalize(_cronDayOfWeek)}",
        _ => null,
    };

    private string? ExpressionDescription
    {
        get
        {
            var expression = ComputedExpression;
            if (string.IsNullOrEmpty(expression))
            {
                return null;
            }
            try { return ExpressionDescriptor.GetDescription(expression, new Options { Use24HourTimeFormat = true }); }
            catch { return null; }
        }
    }

    private static readonly IReadOnlyList<SelectOption<ScheduleMode>> ScheduleModeOptions =
    [
        new(ScheduleMode.Daily, "Daily"),
        new(ScheduleMode.Weekly, "Weekly"),
        new(ScheduleMode.Expression, "Expression"),
    ];

    private static readonly IReadOnlyList<SelectOption<DayOfWeek>> DayOfWeekOptions =
    [
        new(DayOfWeek.Monday, "Monday"),
        new(DayOfWeek.Tuesday, "Tuesday"),
        new(DayOfWeek.Wednesday, "Wednesday"),
        new(DayOfWeek.Thursday, "Thursday"),
        new(DayOfWeek.Friday, "Friday"),
        new(DayOfWeek.Saturday, "Saturday"),
        new(DayOfWeek.Sunday, "Sunday"),
    ];

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(CronExpression))
        {
            LoadFromExpression(CronExpression);
        }
    }

    private void LoadFromExpression(string expression)
    {
        var parts = expression.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 6)
        {
            _scheduleMode = ScheduleMode.Expression;
            return;
        }

        (_cronSecond, _cronMinute, _cronHour, _cronDayOfMonth, _cronMonth, _cronDayOfWeek) = (parts[0], parts[1], parts[2], parts[3], parts[4], parts[5]);

        if (parts[0] == "0" && parts[3] == "*" && parts[4] == "*" && parts[5] == "*"
            && int.TryParse(parts[1], out var dailyMinute) && int.TryParse(parts[2], out var dailyHour))
        {
            _scheduleMode = ScheduleMode.Daily;
            _dailyTime = new TimeSpan(dailyHour, dailyMinute, 0);
            return;
        }

        if (parts[0] == "0" && parts[3] == "*" && parts[4] == "*" && parts[5] != "*"
            && int.TryParse(parts[1], out var weeklyMinute) && int.TryParse(parts[2], out var weeklyHour))
        {
            _scheduleMode = ScheduleMode.Weekly;
            _weeklyTime = new TimeSpan(weeklyHour, weeklyMinute, 0);
            _weeklyDaysOfWeek = ParseWeeklyDays(parts[5]);
            return;
        }

        _scheduleMode = ScheduleMode.Expression;
        _expressionConfigured = true;
    }

    private void OnScheduleModeChanged(ScheduleMode newMode)
    {
        TransferScheduleConfig(_scheduleMode, newMode);
        _scheduleMode = newMode;
        NotifyChanged();
    }

    private void OnDailyTimeChanged(TimeSpan? time)
    {
        _dailyTime = time;
        NotifyChanged();
    }
    private void OnWeeklyTimeChanged(TimeSpan? time)
    {
        _weeklyTime = time;
        NotifyChanged();
    }
    private void OnWeeklyDaysChanged(IEnumerable<DayOfWeek>? days)
    {
        _weeklyDaysOfWeek = days?
                                .Distinct()
                                .Order(DayOfWeekComparer.Instance)
                                .ToList()
                            ?? [];
        NotifyChanged();
    }

    private void TransferScheduleConfig(ScheduleMode from, ScheduleMode to)
    {
        switch (from, to)
        {
            case (ScheduleMode.Daily, ScheduleMode.Weekly):
                _weeklyTime = _dailyTime;
                if (_weeklyDaysOfWeek.Count == 0)
                {
                    _weeklyDaysOfWeek = Enum.GetValues<DayOfWeek>().Order(DayOfWeekComparer.Instance).ToList();
                }
                break;

            case (ScheduleMode.Weekly, ScheduleMode.Daily):
                _dailyTime = _weeklyTime;
                break;

            case (ScheduleMode.Daily, ScheduleMode.Expression) when _dailyTime.HasValue:
                _cronSecond = "0";
                _cronMinute = _dailyTime.Value.Minutes.ToString();
                _cronHour = _dailyTime.Value.Hours.ToString();
                _cronDayOfMonth = "*";
                _cronMonth = "*";
                _cronDayOfWeek = "*";
                _expressionConfigured = true;
                break;

            case (ScheduleMode.Weekly, ScheduleMode.Expression) when _weeklyTime.HasValue:
                _cronSecond = "0";
                _cronMinute = _weeklyTime.Value.Minutes.ToString();
                _cronHour = _weeklyTime.Value.Hours.ToString();
                _cronDayOfMonth = "*";
                _cronMonth = "*";
                _cronDayOfWeek = _weeklyDaysOfWeek.Count > 0 ? ToCronDayOfWeekSegment(_weeklyDaysOfWeek) : "*";
                _expressionConfigured = true;
                break;

            case (ScheduleMode.Expression, ScheduleMode.Daily):
                if (int.TryParse(_cronHour, out var dailyHour) && int.TryParse(_cronMinute, out var dailyMinute))
                {
                    _dailyTime = new TimeSpan(dailyHour, dailyMinute, 0);
                }
                break;

            case (ScheduleMode.Expression, ScheduleMode.Weekly):
                if (int.TryParse(_cronHour, out var weeklyHour) && int.TryParse(_cronMinute, out var weeklyMinute))
                {
                    _weeklyTime = new TimeSpan(weeklyHour, weeklyMinute, 0);
                }
                _weeklyDaysOfWeek = ParseWeeklyDays(_cronDayOfWeek);
                break;
        }
    }

    private static string CronFieldStyle(string value) => $"width: calc({Math.Max(4, value.Length)} * 9px + 28px);";

    private void NotifyChanged() => _ = CronExpressionChanged.InvokeAsync(ComputedExpression);

    private void SetCronField(string? value, Expression<Func<string>> selector)
    {
        var field = (FieldInfo)((MemberExpression)selector.Body).Member;
        field.SetValue(this, value ?? string.Empty);
        _expressionConfigured = true;
        NotifyChanged();
    }

    private static string Normalize(string value) =>
        string.IsNullOrWhiteSpace(value) ? "*" : value;

    private static bool IsCronPartValid(string value, int minimum, int maximum)
    {
        if (string.IsNullOrWhiteSpace(value) || value == "*")
        {
            return true;
        }

        var stepParts = value.Split('/');
        if (stepParts.Length > 2)
        {
            return false;
        }
        if (stepParts.Length == 2 && (!int.TryParse(stepParts[1], out var stepValue) || stepValue <= 0))
        {
            return false;
        }

        var rangePart = stepParts[0];
        if (rangePart == "*")
        {
            return true;
        }

        foreach (var segment in rangePart.Split(','))
        {
            var dashParts = segment.Trim().Split('-');
            if (dashParts.Length == 1)
            {
                if (!int.TryParse(dashParts[0], out var number) || number < minimum || number > maximum)
                {
                    return false;
                }
            }
            else if (dashParts.Length == 2)
            {
                if (!int.TryParse(dashParts[0], out var rangeStart) || rangeStart < minimum || rangeStart > maximum)
                {
                    return false;
                }
                if (!int.TryParse(dashParts[1], out var rangeEnd) || rangeEnd < minimum || rangeEnd > maximum)
                {
                    return false;
                }
                if (rangeStart > rangeEnd)
                {
                    return false;
                }
            }
            else
            {
                return false;
            }
        }

        return true;
    }

    private static string ToCronDayOfWeekSegment(IEnumerable<DayOfWeek> days)
    {
        var normalizedDays = days
            .Distinct()
            .OrderBy(static day => (int)day)
            .ToList();

        if (normalizedDays.Count == 7)
        {
            return "*";
        }

        return string.Join(',', normalizedDays.Select(static day => day == DayOfWeek.Sunday ? 0 : (int)day));
    }

    private static List<DayOfWeek> ParseWeeklyDays(string value)
    {
        var normalized = Normalize(value);
        if (normalized == "*")
        {
            return
            [
                DayOfWeek.Sunday,
                DayOfWeek.Monday,
                DayOfWeek.Tuesday,
                DayOfWeek.Wednesday,
                DayOfWeek.Thursday,
                DayOfWeek.Friday,
                DayOfWeek.Saturday,
                DayOfWeek.Sunday,
            ];
        }

        var parsedDays = new SortedSet<int>();
        foreach (var segment in normalized.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            foreach (var expandedValue in ExpandDayOfWeekSegment(segment))
            {
                parsedDays.Add(expandedValue == 7 ? 0 : expandedValue);
            }
        }

        return parsedDays
            .Select(static day => (DayOfWeek)day)
            .Order(DayOfWeekComparer.Instance)
            .ToList();
    }

    private static IEnumerable<int> ExpandDayOfWeekSegment(string segment)
    {
        var stepParts = segment.Split('/');
        if (stepParts.Length > 2)
        {
            yield break;
        }

        var step = 1;
        if (stepParts.Length == 2 && (!int.TryParse(stepParts[1], out step) || step <= 0))
        {
            yield break;
        }

        var rangePart = stepParts[0];
        if (rangePart == "*")
        {
            for (var day = 0; day <= 7; day += step)
            {
                yield return day;
            }

            yield break;
        }

        var rangeParts = rangePart.Split('-');
        if (rangeParts.Length == 1)
        {
            if (!int.TryParse(rangeParts[0], out var day) || day < 0 || day > 7)
            {
                yield break;
            }

            if (stepParts.Length == 2)
            {
                for (var expandedDay = day; expandedDay <= 7; expandedDay += step)
                {
                    yield return expandedDay;
                }
            }
            else
            {
                yield return day;
            }

            yield break;
        }

        if (rangeParts.Length != 2
            || !int.TryParse(rangeParts[0], out var rangeStart)
            || !int.TryParse(rangeParts[1], out var rangeEnd)
            || rangeStart < 0
            || rangeStart > 7
            || rangeEnd < 0
            || rangeEnd > 7
            || rangeStart > rangeEnd)
        {
            yield break;
        }

        for (var day = rangeStart; day <= rangeEnd; day += step)
        {
            yield return day;
        }
    }
}

