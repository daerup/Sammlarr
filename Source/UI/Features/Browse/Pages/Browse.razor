@page "/browse"
@implements IDisposable
@using Contracts
@using Contracts.Auth
@using Contracts.DI
@using Contracts.Media
@using Contracts.Media.Trending
@using Contracts.Settings
@using Contracts.Watchlist
@inject IKeyedServiceIndex<MediaRecommendationProvider, IMediaRecommendationService> RecommendationServiceIndex
@inject IWatchlistService WatchlistService
@inject NavigationManager NavigationManager
@inject ProfileDropdownService ProfileDropdownService
@inject ScrollService ScrollService
@inject IProviderConfigRepository ProviderConfigRepository

<PageTitle>Browse Movies</PageTitle>

<OauthGuard Provider="@_providerConfig.WatchlistProvider" AccessChanged="HandleOAuthAccessChanged"/>
<ApiKeyGuard Provider="@_providerConfig.TrendingProvider.AsMediaProvider()" AccessChanged="HandleTrendingProviderAccessChanged"/>

<PageContainer Heading="Trending Movies & Shows" Description="Discover what's popular this week">
    <ChildContent>
        <ProtectedSection GuardState="HasOAuthAccess"
                          AuthProvider="@_providerConfig.WatchlistProvider"
                          DeniedActionDescription="browsing trending media"
                          FallbackAction="() => ProfileDropdownService.RequestOpenAsync()">
            <ProtectedSection GuardState="HasTrendingProviderAccess"
                              MediaProvider="@_providerConfig.TrendingProvider.AsMediaProvider()"
                              DeniedActionDescription="browse trending media"
                              FallbackAction="@(() => NavigationManager.NavigateTo("/settings?section=api-keys"))">
                @if (_isLoading)
                {
                    <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
                        <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="20"/>
                    </div>
                }
                else if (_trendingMedia != null)
                {
                    <div class="grid grid-cols-4 md:grid-cols-1 gap-6">
                        @foreach (var media in _trendingMedia)
                        {
                            <MediaGridTile @key="media"
                                           ImageUrl="@media.BackdropUrl"
                                           Title="@media.Title"
                                           OnClick="() => SelectMedia(media)"
                                           ShowBookmark="true"
                                           IsInWatchlist="IsInWatchlist(media)"
                                           IsUnresolved="@(media is UnresolvedTrendingMedia)"
                                           Rating="@media.Rating"
                                           Date="@media.ReleaseDate"/>
                        }
                    </div>

                    <PaginationControls CurrentPage="_currentPage"
                                        TotalPages="_totalPages"
                                        IsDisabled="_isLoading"
                                        PageChanged="HandlePageChangedAsync"/>
                }
            </ProtectedSection>
        </ProtectedSection>
    </ChildContent>
</PageContainer>

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  ShowContent="@(_selectedMedia is not null)"
                  Title="@(_selectedMedia?.Title ?? string.Empty)"
                  MediaType="@(_selectedMedia?.MediaType ?? MediaType.Movie)"
                  ReleaseDate="@(_selectedMedia?.ReleaseDate ?? DateTimeOffset.MinValue)"
                  ImageUrl="@(_selectedMedia?.PosterUrl ?? string.Empty)"
                  Rating="@(_selectedMedia?.Rating)"
                  ShowMetadataRow="true"
                  Description="@_selectedMedia?.Description"
                  Ids="@(_selectedMedia?.Ids)"
                  ButtonAction="ToggleWatchlistAsync"
                  ButtonText="GetSideMenuButtonText"
                  ButtonIcon="GetSideMenuButtonIcon"
                  ButtonDisabled="@(_selectedMedia is UnresolvedTrendingMedia or null)"/>

@code {
    private IReadOnlyList<ITrendingMedia>? _trendingMedia;
    private ITrendingMedia? _selectedMedia;
    private bool _isLoading;
    private bool _isSheetOpen;
    private bool _isOAuthenticated;
    private bool _hasTrendingProviderApiKey;
    private bool HasAccess => _isOAuthenticated && _hasTrendingProviderApiKey;
    private WatchlistedSet _watchlisted = WatchlistedSet.Empty;
    private ProviderConfig _providerConfig = null!;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private readonly CancellationTokenSource _cancellationTokenSource = new();

    protected override async Task OnInitializedAsync()
    {
        _providerConfig = await ProviderConfigRepository.GetAsync();
    }

    private bool HasOAuthAccess() => _isOAuthenticated;
    private bool HasTrendingProviderAccess() => _hasTrendingProviderApiKey;

    private async Task HandleOAuthAccessChanged(bool isAuthenticated)
    {
        _isOAuthenticated = isAuthenticated;

        if (!_isOAuthenticated)
        {
            _hasTrendingProviderApiKey = false;
            _watchlisted = WatchlistedSet.Empty;
            _trendingMedia = null;
            CloseSelectedMedia();
            _isLoading = false;
            return;
        }

        await LoadWatchlistIdsAsync();
    }

    private void CloseSelectedMedia()
    {
        _selectedMedia = null;
        _isSheetOpen = false;
    }

    private async Task HandleTrendingProviderAccessChanged(bool hasAccess)
    {
        _hasTrendingProviderApiKey = hasAccess;

        if (!_hasTrendingProviderApiKey)
        {
            _trendingMedia = null;
            CloseSelectedMedia();
            _currentPage = 1;
            _totalPages = 1;
            _isLoading = false;
            return;
        }

        if (_currentPage < 1)
        {
            _currentPage = 1;
        }

        await LoadPageAsync();
    }

    private async Task LoadWatchlistIdsAsync()
    {
        _watchlisted = await WatchlistService.GetWatchlistedAsync(_cancellationTokenSource.Token);
    }

    private async Task LoadPageAsync()
    {
        if (!HasAccess)
        {
            return;
        }
        _isLoading = true;

        await TryStateHasChangedAsync();
        try
        {
            var recommendationService = RecommendationServiceIndex[_providerConfig.TrendingProvider];
            (_trendingMedia, _totalPages) = await recommendationService.GetTrendingAsync(_currentPage, _cancellationTokenSource.Token);
        }
        finally
        {
            if (!_cancellationTokenSource.IsCancellationRequested)
            {
                _isLoading = false;
                await TryStateHasChangedAsync();
            }
        }
    }

    private async Task TryStateHasChangedAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) {}
    }

    private async Task HandlePageChangedAsync(int newPage)
    {
        if (newPage == _currentPage)
        {
            return;
        }
        CloseSelectedMedia();

        _currentPage = newPage;

        await ScrollService.ToTopAfterAsync(LoadPageAsync, _cancellationTokenSource.Token);
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    private bool IsInWatchlist(ITrendingMedia media) => media is TrendingMedia resolved && IsInWatchlist(GetWatchlistProviderId(resolved));

    private IMediaId GetWatchlistProviderId(TrendingMedia media) => media.Ids.Single(id => id.Source == _providerConfig.WatchlistProvider.AsMediaProvider());

    private bool IsInWatchlist(IMediaId mediaId)
    {
        if (mediaId.Source == _providerConfig.WatchlistProvider.AsMediaProvider())
        {
            return _watchlisted.Contains(mediaId);
        }
        return false;
    }

    private void SelectMedia(ITrendingMedia media)
    {
        _selectedMedia = media;
        _isSheetOpen = true;
    }

    private string GetSideMenuButtonText()
    {
        if (_selectedMedia is UnresolvedTrendingMedia or null)
        {
            return "Could not be matched";
        }
        return IsInWatchlist(_selectedMedia) ? "Remove from Watchlist" : "Add to Watchlist";
    }

    private string GetSideMenuButtonIcon()
    {
        if (_selectedMedia is UnresolvedTrendingMedia or null)
        {
            return "circle-alert";
        }
        return IsInWatchlist(_selectedMedia) ? "x" : "plus";
    }

    private async Task ToggleWatchlistAsync()
    {
        if (_selectedMedia is not TrendingMedia resolved)
        {
            return;
        }

        var watchlistId = GetWatchlistProviderId(resolved);

        if (IsInWatchlist(resolved))
        {
            await WatchlistService.RemoveFromWatchlistAsync(watchlistId);
        }
        else
        {
            await WatchlistService.AddToWatchlistAsync(watchlistId);
        }

        await LoadWatchlistIdsAsync();
        _isSheetOpen = false;
    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }
}
