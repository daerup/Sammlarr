@page "/browse"
@implements IDisposable
@implements IAsyncDisposable
@using Contracts
@using Contracts.Auth
@using Contracts.DI
@using Contracts.Media
@using Contracts.Media.Trending
@using Contracts.Settings
@using Contracts.Watchlist
@inject IKeyedServiceIndex<MediaRecommendationProvider, IMediaRecommendationService> RecommendationServiceIndex
@inject IKeyedServiceIndex<WatchlistProvider, IWatchlistService> WatchlistServiceIndex
@inject IKeyboardShortcutService KeyboardShortcutService
@inject NavigationManager NavigationManager
@inject ProfileDropdownService ProfileDropdownService
@inject ScrollService ScrollService
@inject IProviderSettingsStore ProviderSettingsStore
@inject ToastService ToastService

<PageTitle>Browse Movies</PageTitle>

<OauthGuard Provider="@_providerSettings.WatchlistProvider" AccessChanged="HandleOAuthAccessChanged"/>
<ApiKeyGuard Provider="@_providerSettings.TrendingProvider.AsMediaProvider()" AccessChanged="HandleTrendingProviderAccessChanged"/>

<div class="px-6 py-10">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="text-3xl font-bold tracking-wide antialiased">Trending Movies & Shows</h1>
            <p class="text-muted-foreground mt-1 font-normal tracking-wide pb-4">Discover what's popular this week</p>
        </div>

        <ProtectedSection GuardState="HasOAuthAccess" ShowFallback="false">
            <div class="flex items-center gap-2">
                <BbCommand Class="border">
                    <BbCommandItem OnSelect="OpenSearchModal" Value="search" class="search-command-item">
                        <LucideIcon Name="search" Class="mr-2"/>
                        Add from Search
                        <BbKbd Keys="Ctrl+K" Class="search-command-item-shortcut"/>
                    </BbCommandItem>
                </BbCommand>
            </div>
        </ProtectedSection>
    </div>

    <div class="mt-6">
        <ProtectedSection GuardState="HasOAuthAccess"
                          AuthProvider="@_providerSettings.WatchlistProvider"
                          DeniedActionDescription="browsing trending media"
                          FallbackAction="() => ProfileDropdownService.RequestOpenAsync()">
            <ProtectedSection GuardState="HasTrendingProviderAccess"
                              MediaProvider="@_providerSettings.TrendingProvider.AsMediaProvider()"
                              DeniedActionDescription="browse trending media"
                              FallbackAction="@(() => NavigationManager.NavigateTo("/settings"))">
                @if (_isLoading)
                {
                    <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
                        <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="20"/>
                    </div>
                }
                else if (_trendingMedia != null)
                {
                    <div class="grid grid-cols-4 md:grid-cols-1 gap-6">
                        @foreach (var media in _trendingMedia)
                        {
                            <MediaGridTile @key="media"
                                           ImageUrl="@media.BackdropUrl"
                                           Title="@media.Title"
                                           OnClick="() => SelectMedia(media)"
                                           ShowBookmark="true"
                                           IsInWatchlist="IsInWatchlist(media)"
                                           Rating="@media.Rating"
                                           Date="@media.ReleaseDate"/>
                        }
                    </div>

                    <PaginationControls CurrentPage="_currentPage"
                                        TotalPages="_totalPages"
                                        IsDisabled="_isLoading"
                                        PageChanged="HandlePageChangedAsync"/>
                }
            </ProtectedSection>
        </ProtectedSection>

        <ProtectedSection GuardState="HasOAuthAccess" ShowFallback="false">
            <SearchModal @bind-IsOpen="_isSearchModalOpen"
                         SearchProvider="@_providerSettings.SearchProvider"
                         IsInWatchlist="IsInWatchlist"
                         AddToWatchlistAsync="AddFromSearchAsync"
                         RemoveFromWatchlistAsync="RemoveFromSearchAsync"/>
        </ProtectedSection>
    </div>
</div>

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  ShowContent="@(_selectedMedia is not null)"
                  Title="@(_selectedMedia?.Title ?? string.Empty)"
                  MediaType="@(_selectedMedia?.MediaType ?? MediaType.Movie)"
                  ReleaseDate="@(_selectedMedia?.ReleaseDate ?? DateTimeOffset.MinValue)"
                  ImageUrl="@(_selectedMedia?.PosterUrl ?? string.Empty)"
                  Rating="@(_selectedMedia?.Rating)"
                  ShowMetadataRow="true"
                  Description="@_selectedMedia?.Description"
                  ButtonAction="ToggleWatchlistAsync"
                  ButtonText="GetSideMenuButtonText"
                  ButtonIcon="GetSideMenuButtonIcon"/>

@code {
    private IReadOnlyList<ITrendingMedia>? _trendingMedia;
    private ITrendingMedia? _selectedMedia;
    private bool _isLoading;
    private bool _isSheetOpen;
    private bool _isSearchModalOpen;
    private bool _isAuthenticated;
    private bool _hasTrendingProviderApiKey;
    private HashSet<string> _watchlistedIds = [];
    private ProviderSettings _providerSettings = null!;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private IDisposable? _shortcutRegistration;
    private bool _isShortcutRegistered;
    private const string BrowseSearchShortcutId = "browse-search-shortcut";

    protected override async Task OnInitializedAsync()
    {
        _providerSettings = await ProviderSettingsStore.GetAsync();
    }

    private bool HasOAuthAccess() => _isAuthenticated;
    private bool HasTrendingProviderAccess() => _hasTrendingProviderApiKey;

    private async Task HandleOAuthAccessChanged(bool isAuthenticated)
    {
        _isAuthenticated = isAuthenticated;

        if (!_isAuthenticated)
        {
            _hasTrendingProviderApiKey = false;
            _watchlistedIds.Clear();
            _trendingMedia = null;
            CloseSelectedMedia();
            _isSearchModalOpen = false;
            _isLoading = false;
            return;
        }

        await LoadWatchlistIdsAsync();
    }
    private void CloseSelectedMedia()
    {
        _selectedMedia = null;
        _isSheetOpen = false;
    }

    private async Task HandleTrendingProviderAccessChanged(bool hasAccess)
    {
        _hasTrendingProviderApiKey = hasAccess;

        if (!_hasTrendingProviderApiKey)
        {
            _trendingMedia = null;
            CloseSelectedMedia();
            _currentPage = 1;
            _totalPages = 1;
            _isLoading = false;
            return;
        }

        if (_currentPage < 1)
        {
            _currentPage = 1;
        }

        await LoadPageAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isAuthenticated && !_isShortcutRegistered)
        {
            _shortcutRegistration = await KeyboardShortcutService.RegisterAsync("Ctrl+K", OpenSearchFromShortcutAsync, BrowseSearchShortcutId);
            _isShortcutRegistered = true;
        }
        else if (!_isAuthenticated && _isShortcutRegistered)
        {
            await UnregisterShortcutAsync();
        }
    }

    private async Task OpenSearchFromShortcutAsync()
    {
        if (!_isAuthenticated || _isSearchModalOpen)
        {
            return;
        }

        OpenSearchModal();
        await InvokeAsync(StateHasChanged);
    }

    private ValueTask UnregisterShortcutAsync()
    {
        if (!_isShortcutRegistered)
        {
            return ValueTask.CompletedTask;
        }

        _shortcutRegistration?.Dispose();
        _shortcutRegistration = null;

        KeyboardShortcutService.Unregister(BrowseSearchShortcutId);
        _isShortcutRegistered = false;
        return ValueTask.CompletedTask;
    }

    private async Task LoadWatchlistIdsAsync()
    {
        var watchlistService = WatchlistServiceIndex[_providerSettings.WatchlistProvider];
        var watchlistPage = await watchlistService.GetWatchlistAsync(1, _cancellationTokenSource.Token);
        if (_cancellationTokenSource.IsCancellationRequested)
        {
            return;
        }

        _watchlistedIds = watchlistPage.Items.Select(item => item.SourceId.Value).ToHashSet();
    }

    private async Task LoadPageAsync()
    {
        _isLoading = true;

        await TryStateHasChangedAsync();
        try
        {
            var recommendationService = RecommendationServiceIndex[_providerSettings.TrendingProvider];
            (_trendingMedia, _totalPages) = await recommendationService.GetTrendingAsync(_currentPage, _cancellationTokenSource.Token);
        }
        finally
        {
            if (!_cancellationTokenSource.IsCancellationRequested)
            {
                _isLoading = false;
                await TryStateHasChangedAsync();
            }
        }
    }

    private async Task TryStateHasChangedAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) {}
    }

    private async Task HandlePageChangedAsync(int newPage)
    {
        if (newPage == _currentPage)
        {
            return;
        }
        CloseSelectedMedia();

        _currentPage = newPage;

        await ScrollService.ToTopAfterAsync(LoadPageAsync, _cancellationTokenSource.Token);
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        await UnregisterShortcutAsync();
        Dispose();
    }

    private bool IsInWatchlist(ITrendingMedia media)
    {
        return IsInWatchlist(media.WatchlistProviderId);
    }

    private bool IsInWatchlist(IMediaId mediaId)
    {
        if (mediaId.Source == _providerSettings.WatchlistProvider.AsMediaProvider())
        {
            return _watchlistedIds.Contains(mediaId.Value);
        }
        return false;
    }

    private void OpenSearchModal()
    {
        _isSearchModalOpen = true;
    }

    private async Task<bool> AddFromSearchAsync(IMediaId id, string title)
    {

        if (IsInWatchlist(id))
        {
            ToastService.Warning($"'{title}' is already in your watchlist.");
            return false;
        }

        var watchlistService = WatchlistServiceIndex[_providerSettings.WatchlistProvider];
        var removed = await watchlistService.AddToWatchlistAsync(id, _cancellationTokenSource.Token);
        if (!removed)
        {
            ToastService.Warning("Failed to add item to watchlist. Please try again.");
            return false;
        }

        _watchlistedIds.Add(id.Value);
        ToastService.Success($"'{title}' has been added to your watchlist.");
        return true;
    }

    private async Task<bool> RemoveFromSearchAsync(IMediaId id, string title)
    {
        if (!IsInWatchlist(id))
        {
            ToastService.Warning($"'{title}' is not in your watchlist.");
            return false;
        }

        var watchlistService = WatchlistServiceIndex[_providerSettings.WatchlistProvider];
        var added = await watchlistService.RemoveFromWatchlistAsync(id, _cancellationTokenSource.Token);

        if (!added)
        {
            ToastService.Warning("Failed to remove item from watchlist. Please try again.");
            return false;
        }

        _watchlistedIds.Remove(id.Value);
        ToastService.Success($"'{title}' has been removed from your watchlist.");
        return true;
    }

    private void SelectMedia(ITrendingMedia media)
    {
        _selectedMedia = media;
        _isSheetOpen = true;
    }

    private string GetSideMenuButtonText()
    {
        return _selectedMedia != null && IsInWatchlist(_selectedMedia) ? "Remove from Watchlist" : "Add to Watchlist";
    }

    private string GetSideMenuButtonIcon()
    {
        return _selectedMedia != null && IsInWatchlist(_selectedMedia) ? "x" : "plus";
    }

    private async Task ToggleWatchlistAsync()
    {
        if (_selectedMedia?.WatchlistProviderId.Source != _providerSettings.WatchlistProvider.AsMediaProvider())
        {
            return;
        }

        var watchlistService = WatchlistServiceIndex[_providerSettings.WatchlistProvider];
        bool success;

        if (IsInWatchlist(_selectedMedia))
        {
            success = await watchlistService.RemoveFromWatchlistAsync(_selectedMedia.WatchlistProviderId);
            if (success)
            {
                _watchlistedIds.Remove(_selectedMedia.WatchlistProviderId.Value);
                _isSheetOpen = false;
            }
        }
        else
        {
            success = await watchlistService.AddToWatchlistAsync(_selectedMedia.WatchlistProviderId);
            if (success)
            {
                _watchlistedIds.Add(_selectedMedia.WatchlistProviderId.Value);
                _isSheetOpen = false;
            }
        }

    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }
}

