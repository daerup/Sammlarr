@page "/watchlist"
@implements IDisposable
@using Contracts.Auth
@using Contracts.DI
@using Contracts.Media
@using Contracts.Watchlist
@inject IKeyedServiceIndex<WatchlistProvider, IWatchlistService> WatchlistStoreIndex
@inject ScrollService ScrollService
@inject ProfileDropdownService ProfileDropdownService

<PageTitle>Plex Watchlist</PageTitle>

<OauthGuard Provider="WatchlistProvider.Plex"
            AccessChanged="HandleAccessChanged"/>

<div class="px-6 py-10">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="text-3xl font-bold tracking-wide antialiased">Plex Watchlist</h1>
            <p class="text-muted-foreground mt-1 font-normal tracking-wide pb-4">Your saved movies and shows from Plex</p>
        </div>

        <ProtectedSection GuardState="IsOAuthAllowed" ShowFallback="false">
            <div class="flex items-center gap-2">
                <BbButton Variant="ButtonVariant.Outline" @onclick="LoadWatchlistAsync" Disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span>Refreshing...</span>
                    }
                    else
                    {
                        <LucideIcon Name="refresh-cw" Size="16" class="mr-2"/>
                        <span>Refresh</span>
                    }
                </BbButton>
            </div>
        </ProtectedSection>
    </div>

    <div class="mt-6">
        <ProtectedSection GuardState="IsOAuthAllowed"
                          AuthProvider="WatchlistProvider.Plex"
                          DeniedActionDescription="viewing your watchlist"
                          FallbackAction="() => ProfileDropdownService.RequestOpenAsync()">
            @if (_isLoading)
            {
                <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
                    <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
                </div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="rounded-lg border bg-destructive/10 border-destructive/20 p-4 space-y-3">
                    <p class="text-sm text-destructive font-medium">@_errorMessage</p>
                    <BbButton Variant="ButtonVariant.Outline" @onclick="LoadWatchlistAsync">
                        <LucideIcon Name="refresh-cw" Size="16" Class="mr-2"/>
                        Retry
                    </BbButton>
                </div>
            }
            else if (_items is not null && _items.Count == 0)
            {
                <div class="rounded-lg border bg-surface p-8 text-center space-y-2">
                    <LucideIcon Name="inbox" Size="40" class="mx-auto text-muted-foreground"/>
                    <p class="text-muted-foreground">Your Plex watchlist is empty.</p>
                </div>
            }
            else if (_items is not null)
            {
                <div class="grid grid-cols-4 md:grid-cols-1 gap-6">
                    @foreach (var item in _items)
                    {
                        <MediaGridTile @key="item"
                                       ImageUrl="@item.ArtUrl"
                                       Title="@item.Title"
                                       OnClick="() => SelectItem(item)"
                                       Description="@GetDescription(item)"/>
                    }
                </div>

                <PaginationControls CurrentPage="_currentPage"
                                    TotalPages="_totalPages"
                                    IsDisabled="_isLoading"
                                    PageChanged="HandlePageChangedAsync"/>
            }
        </ProtectedSection>
    </div>
</div>

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  ShowContent="@(_selectedItem is not null)"
                  Title="@(_selectedItem?.Title ?? string.Empty)"
                  MediaType="@(_selectedItem?.MediaType ?? MediaType.Movie)"
                  ReleaseDate="@(_selectedItem?.ReleaseDate ?? DateTimeOffset.MinValue)"
                  ImageUrl="@(_selectedItem?.PosterUrl ?? string.Empty)"
                  ShowMetadataRow="false"
                  ButtonAction="RemoveSelectedFromWatchlistAsync"
                  ButtonText="@(() => "Remove from Watchlist")"
                  ButtonIcon="@(() => "x")"/>

@code {
    private IReadOnlyList<IWatchlistItem>? _items;
    private IWatchlistItem? _selectedItem;
    private bool _isLoading;
    private bool _isRemoving;
    private bool _isSheetOpen;
    private bool _hasOAuthAccess;
    private string? _errorMessage;
    private int _currentPage = 1;
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private int _totalPages;

    private IWatchlistService WatchlistService => WatchlistStoreIndex[WatchlistProvider.Plex];
    private bool IsOAuthAllowed() => _hasOAuthAccess;

    private async Task HandleAccessChanged(bool hasAccess)
    {
        _hasOAuthAccess = hasAccess;

        if (!hasAccess)
        {
            _items = null;
            _errorMessage = null;
            _isLoading = false;
            _currentPage = 1;
            _totalPages = 0;
            CloseSelectedMedia();
            return;
        }

        if (_currentPage < 1)
        {
            _currentPage = 1;
        }

        await LoadWatchlistAsync();
    }

    private async Task LoadWatchlistAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            (_items, _totalPages) = await WatchlistService.GetWatchlistAsync(_currentPage, _cancellationTokenSource.Token);

            if (_selectedItem is not null)
            {
                _selectedItem = _items.FirstOrDefault(item => item.SourceId.Equals(_selectedItem.SourceId));
                if (_selectedItem is null)
                {
                    _isSheetOpen = false;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load watchlist: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }


    private static string GetDescription(IWatchlistItem item) => string.IsNullOrWhiteSpace(item.Description) ? "No overview available." : item.Description;

    private void SelectItem(IWatchlistItem item)
    {
        _selectedItem = item;
        _isSheetOpen = true;
    }

    private async Task RemoveSelectedFromWatchlistAsync()
    {
        if (_isRemoving)
        {
            return;
        }

        if (_selectedItem?.SourceId is not PlexId plexId)
        {
            return;
        }

        _isRemoving = true;

        try
        {
            var removed = await WatchlistService.RemoveFromWatchlistAsync(plexId, _cancellationTokenSource.Token);
            if (!removed)
            {
                return;
            }

            var removedLastVisibleItem = _items is not null && _items.Count == 1;
            if (removedLastVisibleItem && _currentPage > 1)
            {
                _currentPage--;
            }

            CloseSelectedMedia();
            await LoadWatchlistAsync();
        }
        finally
        {
            _isRemoving = false;
        }
    }

    private void CloseSelectedMedia()
    {
        _isSheetOpen = false;
        _selectedItem = null;
    }

    private async Task HandlePageChangedAsync(int newPage)
    {
        if (newPage == _currentPage)
        {
            return;
        }
        CloseSelectedMedia();

        _currentPage = newPage;

        await ScrollService.ToTopAfterAsync(LoadWatchlistAsync, _cancellationTokenSource.Token);
    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}

