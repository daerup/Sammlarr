@page "/watchlist"
@using Contracts.Auth
@using Contracts.Media
@using Contracts.Media.Metadata
@using Contracts.Media.Search
@using Contracts.Settings
@using Contracts.Watchlist
@using global::Shared
@implements IDisposable
@implements IAsyncDisposable
@inject IWatchlistService WatchlistService
@inject IMediaMetadataProvider MetadataProvider
@inject IKeyboardShortcutService KeyboardShortcutService
@inject ScrollService ScrollService
@inject ProfileDropdownService ProfileDropdownService
@inject IProviderConfigRepository ProviderConfigRepository
@inject Notifier Notifier
@inject ToastService ToastService

<PageTitle>@PageTitleText</PageTitle>

@if (_providerSettings is null)
{
    <PageContainer>
        <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
        </div>
    </PageContainer>
}
else
{
    <OauthGuard Provider="@_providerSettings.WatchlistProvider"
                AccessChanged="HandleAccessChanged"/>

    <PageContainer Heading="@PageHeading" Description="@PageDescription">
        <HeaderActions>
            <ProtectedSection GuardState="IsOAuthAllowed" ShowFallback="false">
                <div class="flex items-center gap-2">
                    <BbCommand Class="border">
                        <BbCommandItem OnSelect="OpenSearchModal" Value="search" class="search-command-item">
                            <LucideIcon Name="search" Class="mr-2"/>
                            Add from Search
                            <BbKbd Keys="Ctrl+K" Class="search-command-item-shortcut"/>
                        </BbCommandItem>
                    </BbCommand>
                    <BbButton Variant="ButtonVariant.Secondary" @onclick="LoadWatchlistAsync" Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span>Refreshing...</span>
                        }
                        else
                        {
                            <LucideIcon Name="refresh-cw" Size="16" class="mr-2"/>
                            <span>Refresh</span>
                        }
                    </BbButton>
                </div>
            </ProtectedSection>
        </HeaderActions>
        <ChildContent>
            <ProtectedSection GuardState="IsOAuthAllowed"
                              AuthProvider="@_providerSettings.WatchlistProvider"
                              DeniedActionDescription="viewing your watchlist"
                              FallbackAction="() => ProfileDropdownService.RequestOpenAsync()">
                @if (_isLoading)
                {
                    <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
                        <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="rounded-lg border bg-destructive/10 border-destructive/30 p-5 flex items-start gap-3">
                        <LucideIcon Name="circle-alert" Size="18" Class="text-destructive shrink-0 mt-0.5"/>
                        <div class="flex-1 space-y-3">
                            <p class="text-sm text-destructive font-medium">@_errorMessage</p>
                            <BbButton Variant="ButtonVariant.Secondary" @onclick="LoadWatchlistAsync">
                                <LucideIcon Name="refresh-cw" Size="14" Class="mr-2"/>
                                Retry
                            </BbButton>
                        </div>
                    </div>
                }
                else if (_items is not null && _items.Count == 0)
                {
                    <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-3">
                        <LucideIcon Name="inbox" Size="36" Class="mx-auto text-muted-foreground"/>
                        <h3 class="text-base font-semibold tracking-tight">Nothing on your watchlist yet.</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">@EmptyStateMessage Add a title with <span class="font-medium text-foreground">Ctrl+K</span>.</p>
                    </div>
                }
                else if (_items is not null)
                {
                    <div class="grid grid-cols-4 md:grid-cols-1 gap-6">
                        @foreach (var item in _items)
                        {
                            <MediaGridTile @key="item"
                                           ImageUrl="@item.BackdropUrl"
                                           Poster="@item.PosterUrl"
                                           Title="@item.Title"
                                           OnClick="() => SelectItem(item)"
                                           Tagline="@item.Tagline"
                                           Rating="@item.Rating"
                                           OnImageBroken="() => ReportBrokenImageAsync(item.SourceId)"/>
                        }
                    </div>

                    <PaginationControls CurrentPage="_currentPage"
                                        TotalPages="_totalPages"
                                        IsDisabled="_isLoading"
                                        PageChanged="HandlePageChangedAsync"/>
                }
            </ProtectedSection>
        </ChildContent>
    </PageContainer>
}

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  ShowContent="@(_selectedItem is not null)"
                  Title="@(_selectedItem?.Title ?? string.Empty)"
                  MediaType="@(_selectedItem?.MediaType ?? MediaType.Movie)"
                  ReleaseDate="@SelectedReleaseDate"
                  ImageUrl="@(_selectedItem?.PosterUrl ?? string.Empty)"
                  ShowMetadataRow="false"
                  Description="@(_selectedItem?.Summary ?? string.Empty)"
                  Ids="@(_selectedItem is null ? null : [_selectedItem.SourceId, .._selectedItem.AdditionalIds])"
                  OnImageBroken="ReportSelectedImageBrokenAsync"
                  ButtonAction="RemoveSelectedFromWatchlistAsync"
                  ButtonText="GetRemoveButtonText"
                  ButtonIcon="GetRemoveButtonIcon"/>

@if (_providerSettings is not null)
{
    <SearchModal @bind-IsOpen="_isSearchModalOpen"
                 SearchProvider="@_providerSettings.SearchProvider"
                 IsInWatchlist="IsInWatchlist"
                 OnToggle="ToggleFromSearchAsync">
        <TileIcons Context="ctx">
            <WatchlistToggleIcon Result="ctx.Result" IsToggled="ctx.IsToggled" IsToggling="ctx.IsToggling" OnToggle="ctx.OnToggle"/>
        </TileIcons>
    </SearchModal>
}

@code {
    private const string SearchShortcutId = "watchlist-search-shortcut";

    private IReadOnlyList<IMediaDetailResult>? _items;
    private IMediaDetailResult? _selectedItem;
    private bool _isLoading;
    private bool _isRemoving;
    private bool _isSheetOpen;
    private bool _hasOAuthAccess;
    private bool _isSearchModalOpen;
    private string? _errorMessage;
    private int _currentPage = 1;
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private readonly HashSet<IMediaId> _reportedBrokenImages = [];
    private int _totalPages;
    private ProviderConfig? _providerSettings;
    private IDisposable? _shortcutRegistration;
    private bool _isShortcutRegistered;

    private string PageTitleText => _providerSettings is null ? "Watchlist" : $"{_providerSettings.WatchlistProvider.GetDescription()} Watchlist";
    private string PageHeading => _providerSettings is null ? "Watchlist" : $"{_providerSettings.WatchlistProvider.GetDescription()} Watchlist";
    private string PageDescription => _providerSettings is null ? "Your saved movies and shows." : $"Your saved movies and shows from {_providerSettings.WatchlistProvider.GetDescription()}";
    private string EmptyStateMessage => _providerSettings is null ? "Your watchlist is empty." : $"Your {_providerSettings.WatchlistProvider.GetDescription()} watchlist is empty.";
    private bool IsOAuthAllowed() => _hasOAuthAccess;
    private DateTimeOffset SelectedReleaseDate => _selectedItem is { } item ? new DateTimeOffset(item.ReleaseDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero) : DateTimeOffset.MinValue;

    protected override async Task OnInitializedAsync()
    {
        _providerSettings = await ProviderConfigRepository.GetAsync() ?? throw new InvalidOperationException("Provider settings are not configured.");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_hasOAuthAccess && !_isShortcutRegistered)
        {
            _shortcutRegistration = await KeyboardShortcutService.RegisterAsync("Ctrl+K", OpenSearchFromShortcutAsync, SearchShortcutId);
            _isShortcutRegistered = true;
        }
        else if (!_hasOAuthAccess && _isShortcutRegistered)
        {
            await UnregisterShortcutAsync();
        }
    }

    private async Task HandleAccessChanged(bool hasAccess)
    {
        _hasOAuthAccess = hasAccess;

        if (!hasAccess)
        {
            _items = null;
            _errorMessage = null;
            _isLoading = false;
            _currentPage = 1;
            _totalPages = 0;
            CloseSelectedMedia();
            return;
        }

        if (_currentPage < 1)
        {
            _currentPage = 1;
        }

        await LoadWatchlistAsync();
    }

    private async Task LoadWatchlistAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            (_items, _totalPages) = await WatchlistService.GetWatchlistAsync(_currentPage, _cancellationTokenSource.Token);

            if (_selectedItem is not null)
            {
                _selectedItem = _items.FirstOrDefault(item => item.SourceId.Equals(_selectedItem.SourceId));
                if (_selectedItem is null)
                {
                    _isSheetOpen = false;
                }
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load watchlist");
            _errorMessage = $"Failed to load watchlist: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReportBrokenImageAsync(IMediaId sourceId)
    {
        if (!_reportedBrokenImages.Add(sourceId))
        {
            return;
        }
        await MetadataProvider.InvalidateAsync([sourceId], _cancellationTokenSource.Token);
    }

    private async Task ReportSelectedImageBrokenAsync()
    {
        if (_selectedItem is null)
        {
            return;
        }
        await ReportBrokenImageAsync(_selectedItem.SourceId);
    }

    private static string GetRemoveButtonText() => "Remove from Watchlist";

    private static string GetRemoveButtonIcon() => "x";

    private void SelectItem(IMediaDetailResult item)
    {
        _selectedItem = item;
        _isSheetOpen = true;
    }

    private async Task RemoveSelectedFromWatchlistAsync()
    {
        if (_isRemoving)
        {
            return;
        }

        if (_selectedItem?.SourceId is null)
        {
            return;
        }

        _isRemoving = true;

        try
        {
            var removed = await WatchlistService.RemoveFromWatchlistAsync(_selectedItem.SourceId, _cancellationTokenSource.Token);
            if (!removed)
            {
                return;
            }

            var removedLastVisibleItem = _items is not null && _items.Count == 1;
            if (removedLastVisibleItem && _currentPage > 1)
            {
                _currentPage--;
            }

            CloseSelectedMedia();
            await LoadWatchlistAsync();
        }
        finally
        {
            _isRemoving = false;
        }
    }

    private void CloseSelectedMedia()
    {
        _isSheetOpen = false;
        _selectedItem = null;
    }

    private async Task HandlePageChangedAsync(int newPage)
    {
        if (newPage == _currentPage)
        {
            return;
        }
        CloseSelectedMedia();

        _currentPage = newPage;

        await ScrollService.ToTopAfterAsync(LoadWatchlistAsync, _cancellationTokenSource.Token);
    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }

    private void OpenSearchModal()
    {
        _isSearchModalOpen = true;
    }

    private async Task OpenSearchFromShortcutAsync()
    {
        if (!_hasOAuthAccess || _isSearchModalOpen)
        {
            return;
        }
        OpenSearchModal();
        await InvokeAsync(StateHasChanged);
    }

    private ValueTask UnregisterShortcutAsync()
    {
        if (!_isShortcutRegistered)
        {
            return ValueTask.CompletedTask;
        }
        _shortcutRegistration?.Dispose();
        _shortcutRegistration = null;
        KeyboardShortcutService.Unregister(SearchShortcutId);
        _isShortcutRegistered = false;
        return ValueTask.CompletedTask;
    }

    private bool IsInWatchlist(IMediaId mediaId)
    {
        if (_items is null)
        {
            return false;
        }
        return _items.Any(i => i.SourceId.Equals(mediaId));
    }

    private async Task<bool> ToggleFromSearchAsync(IMediaId id, string title, bool isMarked)
    {
        if (isMarked)
        {
            if (!IsInWatchlist(id))
            {
                ToastService.Warning($"'{title}' is not in your watchlist.");
                return false;
            }

            var removed = await WatchlistService.RemoveFromWatchlistAsync(id, _cancellationTokenSource.Token);
            if (!removed)
            {
                ToastService.Warning("Failed to remove item from watchlist. Please try again.");
                return false;
            }

            ToastService.Success($"'{title}' has been removed from your watchlist.");
            await LoadWatchlistAsync();
            return true;
        }

        if (IsInWatchlist(id))
        {
            ToastService.Warning($"'{title}' is already in your watchlist.");
            return false;
        }

        var added = await WatchlistService.AddToWatchlistAsync(id, _cancellationTokenSource.Token);
        if (!added)
        {
            ToastService.Warning("Failed to add item to watchlist. Please try again.");
            return false;
        }

        ToastService.Success($"'{title}' has been added to your watchlist.");
        await LoadWatchlistAsync();
        return true;
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        await UnregisterShortcutAsync();
        Dispose();
    }
}
