@page "/blacklist"
@implements IDisposable
@using Contracts
@using Contracts.Media
@using Contracts.Media.Blacklist
@using Contracts.Media.Convertions
@using Contracts.Media.Metadata
@using Contracts.Media.Search
@using Contracts.Settings
@implements IAsyncDisposable
@inject IBlacklistService BlacklistService
@inject IMediaMetadataProvider MetadataProvider
@inject IKeyboardShortcutService KeyboardShortcutService
@inject ScrollService ScrollService
@inject ProfileDropdownService ProfileDropdownService
@inject IProviderConfigRepository ProviderConfigRepository
@inject IMediaIdResolver MediaIdResolver
@inject Notifier Notifier
@inject ToastService ToastService

<PageTitle>@PageTitleText</PageTitle>

@if (_providerSettings is null)
{
    <PageContainer>
        <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
        </div>
    </PageContainer>
}
else
{
    <PageContainer Heading="@PageHeading" Description="@PageDescription">
        <HeaderActions>
            <div class="flex items-center gap-2">
                <BbCommand Class="border">
                    <BbCommandItem OnSelect="OpenSearchModal" Value="search" class="search-command-item">
                        <LucideIcon Name="search" Class="mr-2"/>
                        Add from Search
                        <BbKbd Keys="Ctrl+K" Class="search-command-item-shortcut"/>
                    </BbCommandItem>
                </BbCommand>
                @if (_items is { Count: > 0 } && !_isEditMode)
                {
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Default" @onclick="EnterEditMode" Class="whitespace-nowrap">
                        <LucideIcon Name="square-check" Size="16" Class="mr-2"/>
                        Bulk edit
                    </BbButton>
                }
            </div>
        </HeaderActions>
        <ChildContent>
            @if (_isLoading)
            {
                <div class="grid grid-cols-4 md:grid-cols-4 gap-6">
                    <AutoSkeletons Preset="AutoSkeletonPreset.MediaGridTile" Count="12"/>
                </div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="rounded-lg border bg-destructive/10 border-destructive/20 p-4 space-y-3">
                    <p class="text-sm text-destructive font-medium">@_errorMessage</p>
                    <BbButton Variant="ButtonVariant.Secondary" @onclick="LoadBlacklistAsync">
                        <LucideIcon Name="refresh-cw" Size="16" Class="mr-2"/>
                        Retry
                    </BbButton>
                </div>
            }
            else if (_items is not null && _items.Count == 0)
            {
                <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-3">
                    <LucideIcon Name="shield-off" Size="36" Class="mx-auto text-muted-foreground"/>
                    <h3 class="text-base font-semibold tracking-tight">Nothing blacklisted.</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed">Add a title with <span class="font-medium text-foreground">Ctrl+K</span> to keep it out of your Watchlist.</p>
                </div>
            }
            else if (_items is not null)
            {
                <BulkEditableMediaGrid TItem="BlacklistedMediaDetail"
                                       Items="_items"
                                       Detail="@(i => i.Detail)"
                                       Key="@(i => i.Detail.SourceId)"
                                       IsEditMode="_isEditMode"
                                       IsEditModeChanged="@(v => _isEditMode = v)"
                                       OnTileClick="@(i => SelectItem(i.Detail))"
                                       OnBulkRemove="RemoveBulkAsync"
                                       OnImageBroken="ReportBrokenImageAsync"
                                       RemoveLabel="Remove from Blacklist"/>
            }
        </ChildContent>
    </PageContainer>
}

<MediaDetailSheet Open="_isSheetOpen"
                  OnOpenChanged="DetailsOpenChangedAsync"
                  ShowContent="@(_selectedItem is not null)"
                  Title="@(_selectedItem?.Title ?? string.Empty)"
                  Description="@(_selectedItem?.Summary ?? string.Empty)"
                  MediaType="@(_selectedItem?.MediaType ?? MediaType.Movie)"
                  ReleaseDate="@SelectedReleaseDate"
                  ImageUrl="@(_selectedItem?.PosterUrl ?? string.Empty)"
                  ShowMetadataRow="false"
                  Ids="@(_selectedItem is null ? null : [_selectedItem.SourceId, .._selectedItem.AdditionalIds])"
                  OnImageBroken="ReportSelectedImageBrokenAsync"
                  ButtonAction="RemoveSelectedFromBlacklistAsync"
                  ButtonText="GetRemoveButtonText"
                  ButtonIcon="GetRemoveButtonIcon"/>

<SearchModal @bind-IsOpen="_isSearchModalOpen"
             SearchProvider="@_providerSettings.SearchProvider"
             IsInWatchlist="IsBlacklisted"
             OnToggle="ToggleFromSearchAsync"
             Title="Search & Add to Blacklist"
             Description="Find a movie or show and add it to your blacklist.">
    <TileIcons Context="ctx">
        <BlacklistToggleIcon Result="ctx.Result" IsToggled="ctx.IsToggled" IsToggling="ctx.IsToggling" OnToggle="ctx.OnToggle"/>
    </TileIcons>
</SearchModal>

@code {
    private IReadOnlyList<BlacklistedMediaDetail>? _items;
    private IMediaDetailResult? _selectedItem;
    private bool _isLoading;
    private bool _isRemoving;
    private bool _isSheetOpen;
    private bool _isSearchModalOpen;
    private bool _isEditMode;
    private string? _errorMessage;
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private readonly HashSet<IMediaId> _reportedBrokenImages = [];
    private ProviderConfig? _providerSettings;
    private IDisposable? _shortcutRegistration;
    private bool _isShortcutRegistered;
    private const string BlacklistSearchShortcutId = "blacklist-search-shortcut";

    private string PageTitleText => "Blacklist";
    private string PageHeading => "Blacklist";
    private string PageDescription => "Your blacklisted movies and shows.";
    private string EmptyStateMessage => "Your blacklist is empty.";
    private DateTimeOffset SelectedReleaseDate => _selectedItem is { } item ? new DateTimeOffset(item.ReleaseDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero) : DateTimeOffset.MinValue;

    protected override async Task OnInitializedAsync()
    {
        _providerSettings = await ProviderConfigRepository.GetAsync() ?? throw new InvalidOperationException("Provider settings are not configured.");
        await LoadBlacklistAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_providerSettings is not null && !_isShortcutRegistered)
        {
            _shortcutRegistration = await KeyboardShortcutService.RegisterAsync("Ctrl+K", OpenSearchFromShortcutAsync, BlacklistSearchShortcutId);
            _isShortcutRegistered = true;
        }
    }

    private async Task LoadBlacklistAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _items = await BlacklistService.GetBlacklistItems(_cancellationTokenSource.Token).ToListAsync();

            if (_selectedItem is not null)
            {
                _selectedItem = _items.FirstOrDefault(i => i.Detail.SourceId.Equals(_selectedItem.SourceId))?.Detail;
                if (_selectedItem is null)
                {
                    _isSheetOpen = false;
                }
            }
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to load blacklist");
            _errorMessage = $"Failed to load blacklist: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReportBrokenImageAsync(IMediaId sourceId)
    {
        if (!_reportedBrokenImages.Add(sourceId))
        {
            return;
        }
        await MetadataProvider.InvalidateAsync([sourceId], _cancellationTokenSource.Token);
    }

    private async Task ReportSelectedImageBrokenAsync()
    {
        if (_selectedItem is null)
        {
            return;
        }
        await ReportBrokenImageAsync(_selectedItem.SourceId);
    }

    private static string GetRemoveButtonText() => "Remove from Blacklist";

    private static string GetRemoveButtonIcon() => "x";

    private void SelectItem(IMediaDetailResult detail)
    {
        _selectedItem = detail;
        _isSheetOpen = true;
    }

    private void EnterEditMode()
    {
        _isEditMode = true;
        CloseSelectedMedia();
    }

    private async Task RemoveBulkAsync(IReadOnlyList<BlacklistedMediaDetail> toRemove)
    {
        foreach (var item in toRemove)
        {
            await BlacklistService.RemoveFromBacklistAsync(item.Detail.SourceId, _cancellationTokenSource.Token);
        }
        ToastService.Success($"Removed {toRemove.Count} item{(toRemove.Count == 1 ? "" : "s")} from your blacklist.");
        await LoadBlacklistAsync();
    }

    private async Task RemoveSelectedFromBlacklistAsync()
    {
        if (_isRemoving)
        {
            return;
        }

        if (_selectedItem?.SourceId is null)
        {
            return;
        }

        _isRemoving = true;

        try
        {
            await BlacklistService.RemoveFromBacklistAsync(_selectedItem.SourceId, _cancellationTokenSource.Token);
            CloseSelectedMedia();
            await LoadBlacklistAsync();
        }
        finally
        {
            _isRemoving = false;
        }
    }

    private void CloseSelectedMedia()
    {
        _isSheetOpen = false;
        _selectedItem = null;
    }

    private Task DetailsOpenChangedAsync(bool isOpen)
    {
        if (!isOpen)
        {
            CloseSelectedMedia();
        }
        return Task.CompletedTask;
    }

    private bool IsBlacklisted(IMediaId mediaId)
    {
        if (_items is null)
        {
            return false;
        }

        return _items.Any(item => item.Detail.SourceId.Equals(mediaId));
    }

    private void OpenSearchModal()
    {
        _isSearchModalOpen = true;
    }

    private async Task OpenSearchFromShortcutAsync()
    {
        if (_providerSettings is null || _isSearchModalOpen)
        {
            return;
        }

        OpenSearchModal();
        await InvokeAsync(StateHasChanged);
    }

    private ValueTask UnregisterShortcutAsync()
    {
        if (!_isShortcutRegistered)
        {
            return ValueTask.CompletedTask;
        }

        _shortcutRegistration?.Dispose();
        _shortcutRegistration = null;

        KeyboardShortcutService.Unregister(BlacklistSearchShortcutId);
        _isShortcutRegistered = false;
        return ValueTask.CompletedTask;
    }

    private async Task<bool> ToggleFromSearchAsync(IMediaId id, string title, bool isMarked)
    {
        if (isMarked)
        {
            if (!IsBlacklisted(id))
            {
                Notifier.Warning($"'{title}' is not in your blacklist.");
                return false;
            }

            try
            {
                await BlacklistService.RemoveFromBacklistAsync(id, _cancellationTokenSource.Token);
                Notifier.Success($"'{title}' has been removed from your blacklist.");
                await LoadBlacklistAsync();
                return true;
            }
            catch (Exception ex)
            {
                Notifier.Error(ex, "Failed to remove from blacklist");
                return false;
            }
        }

        if (IsBlacklisted(id))
        {
            Notifier.Warning($"'{title}' is already in your blacklist.");
            return false;
        }

        try
        {
            var conversion = await MediaIdResolver.ResolveAsync([id], _providerSettings!.WatchlistProvider.AsMediaProvider(), new None());
            var result = conversion switch
            {
                Resolved resolved => resolved.Id,
                Unresolved _ => throw new ArgumentException("Failed to resolve media ID"),
            };

            await BlacklistService.AddToBacklistAsync(result, _cancellationTokenSource.Token);
            Notifier.Success($"'{title}' has been added to your blacklist.");
            await LoadBlacklistAsync();
            return true;
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to add to blacklist");
            return false;
        }
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        await UnregisterShortcutAsync();
        Dispose();
    }
}




