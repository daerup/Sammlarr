@using Contracts.Auth
@using Contracts.DI
@using Contracts.Media
@using UI.Shared.Services.Branding
@inject IApiKeyConfigRepository ApiKeyConfigRepository
@inject IKeyedServiceIndex<MediaProvider, IApiKeyValidator> ApiKeyValidatorIndex
@inject MediaProviderBrandingService MediaProviderBrandingService

@{
    var providerBranding = MediaProviderBrandingService.GetBrandingInfo(Provider);
}

<div class="w-full max-w-lg">
    <div class="rounded-lg border bg-card overflow-hidden">
        <div class="flex items-center gap-3 px-6 py-4"
             style="@($"background: linear-gradient(90deg, color-mix(in oklch, {providerBranding.BrandColor} 26%, transparent) 0%, color-mix(in oklch, {providerBranding.BrandColor} 22%, transparent) 55%, color-mix(in oklch, {providerBranding.BrandColor} 12%, transparent) 100%); border-bottom: 2px solid {providerBranding.BrandColor};")">
            @providerBranding.Icon
            <h3 class="text-sm font-semibold">@providerBranding.DisplayName</h3>
            @if (_state == State.Failed || _savedState == State.Failed)
            {
                <BbBadge Variant="BadgeVariant.Destructive" Class="ml-auto gap-1.5">
                    <LucideIcon Name="circle-alert" Size="12"/>
                    Invalid
                </BbBadge>
            }
            else if (_state == State.Success)
            {
                <BbBadge Variant="BadgeVariant.Outline" Class="ml-auto gap-1.5 text-success border-success">
                    <LucideIcon Name="check" Size="12"/>
                    Verified
                </BbBadge>
            }
            else if (_savedState == State.Saved)
            {
                <BbBadge Variant="BadgeVariant.Outline" Class="ml-auto gap-1.5 text-success border-success">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-success"></span>
                    Connected
                </BbBadge>
            }
            else
            {
                <BbBadge Variant="BadgeVariant.Secondary" Class="ml-auto gap-1.5 text-muted-foreground">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-muted-foreground/60"></span>
                    Not configured
                </BbBadge>
            }
        </div>

        <div class="px-6 py-6 space-y-6">
            <BbField>
                <BbFieldContent>
                    <div class="relative">
                        <BbInput
                            Placeholder="Enter API key"
                            @bind-Value="ApiKey"
                            Type="@(_showApiKey ? InputType.Text : InputType.Password)"
                            Class="bg-accent pr-10"
                            UpdateTiming="UpdateTiming.Immediate"/>
                        <BbButton Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.IconSmall"
                                  AriaLabel="@(_showApiKey ? "Hide API key" : "Show API key")"
                                  Class="absolute right-1 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground hover:bg-transparent"
                                  OnClick="ToggleApiKeyVisibility">
                            <LucideIcon Name="@(_showApiKey ? "eye-off" : "eye")" Size="16"/>
                        </BbButton>
                    </div>
                    <BbFieldDescription> @Description</BbFieldDescription>
                </BbFieldContent>
            </BbField>

            <div class="flex items-center gap-3">
                @if (_state == State.Idle)
                {
                    <BbButton Variant="ButtonVariant.Default" OnClick="HandleButtonClickAsync" Disabled="string.IsNullOrWhiteSpace(_apiKeyInput)">
                        <LucideIcon Name="zap" Size="14" Class="mr-2"/>
                        <span>Test</span>
                    </BbButton>
                }
                else if (_state == State.Testing)
                {
                    <BbButton Variant="ButtonVariant.Default" Disabled="true">
                        <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                        <span>Testing…</span>
                    </BbButton>
                }
                else if (_state == State.Success)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="text-success border-success hover:bg-success"
                              OnClick="HandleButtonClickAsync">
                        <LucideIcon Name="save" Size="14" Class="mr-2"/>
                        <span>Save</span>
                    </BbButton>
                }
                else if (_state == State.Saving)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="text-success border-success hover:bg-success"
                              Disabled="true">
                        <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                        <span>Saving…</span>
                    </BbButton>
                }
                else if (_state == State.Saved)
                {
                    <BbButton Variant="ButtonVariant.Default"
                              Class="border-success bg-success text-white"
                              Disabled="true">
                        <LucideIcon Name="check" Size="14" Class="mr-2"/>
                        <span>Saved</span>
                    </BbButton>

                    <BbAlertDialog>
                        <BbAlertDialogTrigger>
                            <BbButton Variant="ButtonVariant.Outline"
                                      Class="text-destructive border-destructive hover:bg-destructive/10 hover:text-destructive">
                                <LucideIcon Name="trash-2" Size="14" Class="mr-2"/>
                                <span>Delete key</span>
                            </BbButton>
                        </BbAlertDialogTrigger>
                        <BbAlertDialogContent>
                            <BbAlertDialogHeader>
                                <BbAlertDialogTitle>Delete API key?</BbAlertDialogTitle>
                                <BbAlertDialogDescription>
                                    This will permanently remove the saved API key for @providerBranding.DisplayName.
                                    You will need to re-enter it to use this provider again.
                                </BbAlertDialogDescription>
                            </BbAlertDialogHeader>
                            <BbAlertDialogFooter>
                                <BbAlertDialogCancel>
                                    <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                                </BbAlertDialogCancel>
                                <BbAlertDialogAction>
                                    <BbButton Variant="ButtonVariant.Destructive" OnClick="DeleteAsync">
                                        <LucideIcon Name="trash-2" Size="14" Class="mr-2"/>
                                        <span>Delete key</span>
                                    </BbButton>
                                </BbAlertDialogAction>
                            </BbAlertDialogFooter>
                        </BbAlertDialogContent>
                    </BbAlertDialog>
                }
                else if (_state == State.Failed)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="text-destructive border-destructive hover:bg-destructive/10 hover:text-destructive"
                              Disabled="true">
                        <LucideIcon Name="x" Size="14" Class="mr-2"/>
                        <span>Failed</span>
                    </BbButton>
                }

                @if (_apiKeyInput != _savedApiKey || _state != _savedState)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="text-destructive border-destructive hover:bg-destructive/10 hover:text-destructive"
                              OnClick="CancelAsync"
                              Disabled="@(_state is State.Testing or State.Saving)">
                        Cancel
                    </BbButton>
                }
            </div>
        </div>
    </div>
</div>

@code {

    private enum State { Idle, Testing, Success, Saving, Saved, Failed }

    [Parameter] [EditorRequired]
    public required MediaProvider Provider { get; set; }

    [Parameter] [EditorRequired]
    public required RenderFragment Description { get; set; }

    private string _apiKeyInput = string.Empty;
    private string _savedApiKey = string.Empty;
    private MediaProvider? _loadedProvider;
    private State _state = State.Idle;
    private State _savedState = State.Idle;
    private bool _showApiKey;

    private void ToggleApiKeyVisibility() => _showApiKey = !_showApiKey;

    private string ApiKey
    {
        get => _apiKeyInput;
        set
        {
            if (_apiKeyInput == value)
            {
                return;
            }

            _apiKeyInput = value;
            _state = value == _savedApiKey ? _savedState : State.Idle;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProvider == Provider)
        {
            return;
        }

        var key = await ApiKeyConfigRepository.GetApiKeyAsync(Provider);
        _savedApiKey = key ?? string.Empty;
        _apiKeyInput = _savedApiKey;
        _loadedProvider = Provider;

        if (string.IsNullOrEmpty(_savedApiKey))
        {
            _savedState = State.Idle;
            _state = State.Idle;
            return;
        }
        var isValid = await ApiKeyValidatorIndex[Provider].ValidateApiKeyAsync(_savedApiKey);
        _savedState = isValid ? State.Saved : State.Failed;
        _state = _savedState;
    }

    private Task HandleButtonClickAsync() => _state == State.Success ? SaveAsync() : TestAsync();

    private async Task TestAsync()
    {
        _state = State.Testing;

        try
        {
            var ok = await ApiKeyValidatorIndex[Provider].ValidateApiKeyAsync(_apiKeyInput);
            _state = ok ? State.Success : State.Failed;
        }
        catch (Exception)
        {
            _state = State.Failed;
        }
    }

    private async Task SaveAsync()
    {
        _state = State.Saving;

        await ApiKeyConfigRepository.SetApiKeyAsync(Provider, _apiKeyInput);
        _savedApiKey = _apiKeyInput;
        _savedState = State.Saved;

        _state = State.Saved;
    }

    private async Task DeleteAsync()
    {
        await ApiKeyConfigRepository.RemoveApiKeyAsync(Provider);
        _savedApiKey = string.Empty;
        _apiKeyInput = string.Empty;
        _savedState = State.Idle;
        _state = State.Idle;
    }

    private Task CancelAsync()
    {
        _apiKeyInput = _savedApiKey;
        _state = _savedState;
        return Task.CompletedTask;
    }
}
