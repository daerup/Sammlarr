@using Contracts.Media.Metadata
@inject IMediaCachePurger CachePurger
@inject Notifier Notifier

<SettingsCard Title="Media cache" Color="var(--destructive)">
    <Icon>
        <div class="w-9 h-9 flex items-center justify-center">
            <LucideIcon Name="database" Size="22"/>
        </div>
    </Icon>
    <ChildContent>
        <p class="text-muted-foreground text-sm leading-relaxed">
            Sammlarr caches every media identifier group, metadata record, and rating locally. Purging removes all cached data and forces a clean refetch from the configured providers on demand. Existing watchlist entries are preserved.
        </p>

        <div class="flex items-center gap-3">
            <BbAlertDialog>
                <BbAlertDialogTrigger>
                    <HoverButton Preset="HoverButtonPreset.Destructive"
                                 Icon="trash-2"
                                 Text="@(_isPurging ? "Purging…" : "Purge cache")"
                                 Disabled="@_isPurging"/>
                </BbAlertDialogTrigger>
                <BbAlertDialogContent>
                    <BbAlertDialogHeader>
                        <BbAlertDialogTitle>Purge the media cache?</BbAlertDialogTitle>
                        <BbAlertDialogDescription>
                            This permanently deletes all media identifier groups, identifier entries, metadata records, and ratings.
                            The next time the app needs an item it will refetch from the providers. This cannot be undone.
                        </BbAlertDialogDescription>
                    </BbAlertDialogHeader>
                    <BbAlertDialogFooter>
                        <BbAlertDialogCancel>
                            <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                        </BbAlertDialogCancel>
                        <BbAlertDialogAction>
                            <HoverButton Preset="HoverButtonPreset.Destructive"
                                         Text="Yes, purge everything"
                                         OnClick="PurgeAsync"/>
                        </BbAlertDialogAction>
                    </BbAlertDialogFooter>
                </BbAlertDialogContent>
            </BbAlertDialog>
        </div>
    </ChildContent>
</SettingsCard>

@code {
    private bool _isPurging;

    private async Task PurgeAsync()
    {
        if (_isPurging)
        {
            return;
        }

        _isPurging = true;
        try
        {
            await CachePurger.PurgeAsync();
            Notifier.Success("Media cache purged.");
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to purge media cache");
        }
        finally
        {
            _isPurging = false;
        }
    }
}
