@page "/settings"

<PageTitle>Settings</PageTitle>

<PageContainer Heading="Settings">
    <div class="flex items-start gap-6">
        <nav class="w-44 shrink-0 flex flex-col gap-1 mt-2">
            @foreach (var item in _sections)
            {
                <BbButton Variant="@(_activeSection == item ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Class="w-full justify-start"
                          OnClick="() => _activeSection = item">
                    <LucideIcon Name="@item.Icon" Size="15" Class="mr-2.5 shrink-0"/>
                    @item.Label
                </BbButton>
            }
        </nav>

        <div class="border-l self-stretch"></div>

        <div class="flex-1">
            <DynamicComponent Type="_activeSection.ComponentType"/>
        </div>
    </div>
</PageContainer>

@code {

    private record SettingsSection(string Label, string Icon, Type ComponentType);

    private readonly List<SettingsSection> _sections =
    [
        new("Provider Settings", "sliders-horizontal", typeof(ProviderSettingsSection)),
        new("API Keys", "key", typeof(ApiKeysSection)),
        new("Cache", "database", typeof(CacheSection)),
        new("Diagnostics", "activity", typeof(DiagnosticsSection)),
    ];

    private SettingsSection _activeSection = null!;

    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    protected override void OnInitialized()
    {
        _activeSection = ResolveSection() ?? _sections[0];
    }

    protected override void OnParametersSet()
    {
        var resolved = ResolveSection();
        if (resolved is not null)
        {
            _activeSection = resolved;
        }
    }

    private SettingsSection? ResolveSection() =>
        string.IsNullOrEmpty(Section) ?
            null :
            _sections.FirstOrDefault(s =>
                Slug(s.Label).Equals(Section, StringComparison.OrdinalIgnoreCase));

    private static string Slug(string label) =>
        string.Join("-", label.Split(' ')).ToLowerInvariant();
}

