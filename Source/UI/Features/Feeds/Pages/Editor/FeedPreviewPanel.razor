@using System.Diagnostics
@using Contracts.DI
@using Contracts.Media
@using Contracts.Media.Blacklist
@using Contracts.Media.Feed
@using Contracts.Media.Metadata
@using Contracts.Media.Search
@using Contracts.Processing
@using Contracts.Watchlist
@using UI.Features.Feeds.Components
@implements IDisposable
@inject IWatchlistService WatchlistService
@inject IBlacklistService BlacklistService
@inject IMediaMetadataProvider MetadataProvider
@inject IKeyedServiceIndex<FeedProvider, IFeedService> FeedServiceIndex
@inject IQueryProcessor<IMediaDetailResult> QueryProcessor
@inject Notifier Notifier

<BbCard Class="flex-1 min-w-0 flex flex-col overflow-hidden feed-pane rounded-lg bg-card border border-border shadow-sm">
    <div class="shrink-0 sticky top-0 z-20 px-6 pt-6 pb-4 border-b flex items-center gap-2 bg-base-100 rounded-t-lg">
        <BbInput Placeholder="Search media..."
                 Class="w-full"
                 @bind-Value="_searchQuery"
                 UpdateTiming="UpdateTiming.Immediate"/>
        <LucideIcon Name="search" Class="text-muted-foreground shrink-0"/>
        @if (HasResults)
        {
            <BbAlertDialog @bind-Open="_refreshDialogOpen">
                <BbAlertDialogTrigger>
                    <BbTooltip>
                        <BbTooltipTrigger>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Refresh assets">
                                <LucideIcon Name="refresh-cw" Size="16"/>
                            </BbButton>
                        </BbTooltipTrigger>
                        <BbTooltipContent>Refresh assets</BbTooltipContent>
                    </BbTooltip>
                </BbAlertDialogTrigger>
                <BbAlertDialogContent>
                    <BbAlertDialogHeader>
                        <BbAlertDialogTitle>Refresh assets?</BbAlertDialogTitle>
                        <BbAlertDialogDescription>
                            This drops the cached metadata for every item shown and re-fetches it from your providers. It may take a while for large lists.
                        </BbAlertDialogDescription>
                    </BbAlertDialogHeader>
                    <BbAlertDialogFooter>
                        <BbAlertDialogCancel>
                            <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
                        </BbAlertDialogCancel>
                        <BbButton Variant="ButtonVariant.Default" OnClick="OnRefreshConfirmedAsync">Refresh</BbButton>
                    </BbAlertDialogFooter>
                </BbAlertDialogContent>
            </BbAlertDialog>
        }
    </div>
    <div class="flex-1 min-h-0 overflow-y-auto scrollbar-thin px-6 pb-4 pt-4 flex flex-col">
        @if (HasItems && (FilteredBySearchResults.Any() || FilteredBySearchUnresolvedResults.Any()))
        {
            <div class="mb-4 shrink-0 flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-base font-semibold tracking-wide flex items-center gap-2">
                        <span>Media Results</span>
                        @if (IsLoading)
                        {
                            <BbSpinner Size="SpinnerSize.Small"/>
                        }
                    </h2>
                    <p class="text-sm text-muted-foreground mt-0.5">
                        <FeedSourceLink Identifier="@(_testedConfig?.Identifier ?? Config.Identifier)"
                                        Provider="@(_testedConfig?.Provider ?? Config.Provider!.Value)"/>
                    </p>
                </div>
                <BbTooltipProvider>
                    <div class="stat-badges-row flex items-start text-xs font-medium">
                        <BbTooltip DelayDuration="0">
                            <BbTooltipTrigger AsChild="false" Class="p-0">
                                <span class="stat-badge text-rose-500">
                                    <LucideIcon Name="list" Size="14"/>
                                    <span>@_rawResults.Count</span>
                                </span>
                            </BbTooltipTrigger>
                            <BbTooltipContent>Total items fetched from the source list</BbTooltipContent>
                        </BbTooltip>
                        <BbTooltip DelayDuration="0">
                            <BbTooltipTrigger AsChild="false" Class="p-0">
                                <span class="stat-badge text-rose-500">
                                    <LucideIcon Name="check" Size="14"/>
                                    <span>@IncludedCount</span>
                                </span>
                            </BbTooltipTrigger>
                            <BbTooltipContent>Items that will be imported</BbTooltipContent>
                        </BbTooltip>
                        <BbTooltip DelayDuration="0">
                            <BbTooltipTrigger AsChild="false" Class="p-0">
                                <span class="stat-badge text-rose-500">
                                    <LucideIcon Name="redo-dot" Size="14"/>
                                    <span>@BypassedCount</span>
                                </span>
                            </BbTooltipTrigger>
                            <BbTooltipContent>
                                <p class="font-medium mb-0.5">Bypasses import</p>
                                <p>@WatchlistCount in your watchlist · @BlacklistCount in your blacklist</p>
                                <p class="opacity-70 mt-0.5">These will not be imported.</p>
                            </BbTooltipContent>
                        </BbTooltip>
                        <BbTooltip DelayDuration="0">
                            <BbTooltipTrigger AsChild="false" Class="p-0">
                                <span class="stat-badge text-rose-500">
                                    <LucideIcon Name="filter-x" Size="14"/>
                                    <span>@FilteredCount</span>
                                </span>
                            </BbTooltipTrigger>
                            <BbTooltipContent>Items excluded by your filter rules</BbTooltipContent>
                        </BbTooltip>
                        <BbTooltip DelayDuration="0">
                            <BbTooltipTrigger AsChild="false" Class="p-0">
                                <span class="stat-badge text-rose-500">
                                    <LucideIcon Name="scissors" Size="14"/>
                                    <span>@SkippedCount</span>
                                </span>
                            </BbTooltipTrigger>
                            <BbTooltipContent>Items excluded by the import limit</BbTooltipContent>
                        </BbTooltip>
                        <BbTooltip DelayDuration="0">
                            <BbTooltipTrigger AsChild="false" Class="p-0">
                                <span class="stat-badge text-rose-500">
                                    <LucideIcon Name="circle-alert" Size="14"/>
                                    <span>@UnresolvedCount</span>
                                </span>
                            </BbTooltipTrigger>
                            <BbTooltipContent>Items that could not be matched in your media provider</BbTooltipContent>
                        </BbTooltip>
                    </div>
                </BbTooltipProvider>
            </div>
            @if (FilteredBySearchResults.Any())
            {
                <div class="space-y-2">
                    @foreach (var result in FilteredBySearchResults)
                    {
                        var item = GetItem(result);
                        var isCulled = result.Value is Culled<IMediaDetailResult>;
                        var isTruncated = result.Value is Truncated<IMediaDetailResult>;
                        var isDimmed = isCulled || isTruncated;
                        var isGreyedOut = result.Value is Bypassed<IMediaDetailResult>;
                        var isBlacklisted = IsBlacklisted(item);
                        var isInWatchlist = IsWatchlisted(item);
                        var isTogglingWatchlist = _togglingWatchlistItem == item;
                        var isTogglingBlacklist = _togglingBlacklistItem == item;

                        var hoverStyle = (isDimmed, isGreyedOut) switch
                        {
                            (true, _) => "result-dimmed",
                            (false, true) => "result-grey",
                            _ => "hover-bg"
                        };
                        <MediaDetailTile @key="item"
                                         Result="item"
                                         Class="@(hoverStyle)"
                                         IsFocused="_focusedResult == item"
                                         OnFocusIn="() => _focusedResult = item"
                                         OnFocusOut="() => ClearFocus(item)"
                                         OnImageBroken="() => ReportBrokenImageAsync(item.SourceId)">
                            <Icons>
                                @if (isDimmed)
                                {
                                    <BbTooltipProvider>
                                        <BbTooltip DelayDuration="300">
                                            <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                                                <div class="search-result-status-indicator">
                                                    <LucideIcon Name="@(isCulled ? "filter-x" : "scissors")" Size="24"/>
                                                </div>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>
                                                @(isCulled ? "Filtered out by your filter rules." : "Excluded by the specified limit.")
                                            </BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                }
                                else if (isGreyedOut)
                                {
                                    <BbTooltipProvider>
                                        <BbTooltip DelayDuration="300">
                                            <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                                                <div class="search-result-status-indicator">
                                                    <LucideIcon Name="redo-dot" Size="24"/>
                                                </div>
                                            </BbTooltipTrigger>
                                            <BbTooltipContent>@BypassedTooltip((Bypassed<IMediaDetailResult>)result.Value)</BbTooltipContent>
                                        </BbTooltip>
                                    </BbTooltipProvider>
                                }
                                <WatchlistToggleIcon Result="item" IsToggled="isInWatchlist" IsToggling="isTogglingWatchlist" OnToggle="ToggleWatchlistAsync"/>
                                <BlacklistToggleIcon Result="item" IsToggled="isBlacklisted" IsToggling="isTogglingBlacklist" OnToggle="ToggleBlacklistAsync"/>
                            </Icons>
                        </MediaDetailTile>
                    }
                </div>
            }
            @if (FilteredBySearchUnresolvedResults.Any())
            {
                <div class="mt-4 space-y-2">
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider px-1">Not found in provider</p>
                    @foreach (var item in FilteredBySearchUnresolvedResults)
                    {
                        <MediaDetailTile @key="item"
                                         Result="item"
                                         IsFocused="_focusedResult == item"
                                         OnFocusIn="() => _focusedResult = item"
                                         OnFocusOut="() => ClearFocus(item)"
                                         OnImageBroken="() => ReportBrokenImageAsync(item.SourceId)">
                            <Icons>
                                <BbTooltipProvider>
                                    <BbTooltip DelayDuration="300">
                                        <BbTooltipTrigger AsChild="false" Class="p-0 cursor-default">
                                            <div class="search-result-status-indicator">
                                                <LucideIcon Name="circle-alert" Size="24"/>
                                            </div>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Could not be matched in your media provider. This item will not be imported.</BbTooltipContent>
                                    </BbTooltip>
                                </BbTooltipProvider>
                            </Icons>
                        </MediaDetailTile>
                    }
                </div>
            }
            @if (IsLoading)
            {
                <div class="mt-2 space-y-2">
                    <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="3"/>
                </div>
            }
        }
        else if (HasItems)
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                <LucideIcon Name="search-x" Size="48" Class="text-muted-foreground mb-4"/>
                <p class="text-lg font-semibold">No results match your search</p>
                <p class="text-muted-foreground text-sm mt-2">Try adjusting or clearing the search filter.</p>
            </div>
        }
        else if (IsLoading)
        {
            <AutoSkeletons Preset="AutoSkeletonPreset.MediaResultsHeader"/>
            <div class="space-y-2">
                <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="8"/>
            </div>
        }
        else if (HasFailed)
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                <LucideIcon Name="zap-off" Size="48" Class="mb-4"/>
                <p class="text-lg font-semibold">Test failed</p>
                <p class="text-muted-foreground text-sm mt-2">Could not fetch media from the provider. Please check your input and try again.</p>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center flex-1 text-center py-12">
                <LucideIcon Name="list-music" Size="48" Class="text-muted-foreground mb-4"/>
                <p class="text-lg font-semibold">Media results will appear here</p>
                <p class="text-muted-foreground text-sm mt-2">Run a test to preview the media items from your list.</p>
            </div>
        }
    </div>
</BbCard>

@code {

    [Parameter] public required FeedConfig Config { get; set; }
    [Parameter] public EventCallback<PreviewStatus> OnStatusChanged { get; set; }

    private enum FetchState { Idle, Loading, Success, Failed }

    private FetchState _fetchState = FetchState.Idle;
    private List<IMediaDetailResult> _rawResults = [];
    private IReadOnlyList<IMediaDetailResult> _unresolvedResults = [];
    private IReadOnlyList<QueryResult<IMediaDetailResult>> _processedResults = [];
    private FeedConfig? _testedConfig;
    private CancellationTokenSource? _cts;
    private PreviewStatus _lastEmittedStatus = new();

    private string _searchQuery = string.Empty;
    private IMediaDetailResult? _focusedResult;
    private IMediaDetailResult? _togglingWatchlistItem;
    private IMediaDetailResult? _togglingBlacklistItem;
    private readonly HashSet<IMediaId> _watchlisted = new();
    private readonly HashSet<IMediaId> _blacklistIds = new();
    private readonly HashSet<IMediaId> _reportedBrokenImages = [];
    private bool _hasEnrollmentChanges;
    private bool _refreshDialogOpen;

    private bool IsLoading => _fetchState == FetchState.Loading;
    private bool HasItems => _rawResults.Count > 0;
    private bool HasResults => _fetchState == FetchState.Success && _rawResults.Count > 0;
    private bool HasFailed => _fetchState == FetchState.Failed;

    protected override void OnParametersSet()
    {
        if (_fetchState is FetchState.Success or FetchState.Failed &&
            (Config.Provider != _testedConfig?.Provider ||
             !string.Equals(Config.Identifier?.Trim(), _testedConfig?.Identifier?.Trim(), StringComparison.Ordinal)))
        {
            _fetchState = FetchState.Idle;
            _rawResults = [];
            _unresolvedResults = [];
            _processedResults = [];
            _testedConfig = null;
        }

        _ = EmitStatusIfChangedAsync();
    }

    public async Task ApplyAsync()
    {
        if (_fetchState == FetchState.Loading)
        {
            return;
        }

        var needsFetch = _fetchState is FetchState.Idle or FetchState.Failed ||
                         Config.Provider != _testedConfig?.Provider ||
                         !string.Equals(Config.Identifier?.Trim(), _testedConfig?.Identifier?.Trim(), StringComparison.Ordinal);

        if (needsFetch)
        {
            _fetchState = FetchState.Loading;
            _rawResults = [];
            _unresolvedResults = [];
            _processedResults = [];
            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);
            await FetchAsync();
        }
        else
        {
            Reprocess();
        }

        await EmitStatusIfChangedAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRefreshConfirmedAsync()
    {
        if (_fetchState == FetchState.Loading || _rawResults.Count == 0)
        {
            return;
        }

        var staleIds = _rawResults.Select(r => r.SourceId).ToList();
        _refreshDialogOpen = false;
        _fetchState = FetchState.Loading;
        ClearResults();
        await RunRefreshAsync(staleIds);
    }

    private async Task RunRefreshAsync(IEnumerable<IMediaId> staleIds)
    {
        await Task.Yield();

        try
        {

            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);

            await MetadataProvider.InvalidateAsync(staleIds);
            _reportedBrokenImages.Clear();

            await FetchAsync();
            await EmitStatusIfChangedAsync();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FetchAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        ClearResults();

        try
        {
            _watchlisted.Clear();
            _blacklistIds.Clear();
            await LoadWatchlistAndBlacklistAsync();

            var service = FeedServiceIndex[Config.Provider!.Value];
            var totalSw = Stopwatch.StartNew();
            var sw = Stopwatch.StartNew();
            await foreach (var item in service.GetFeedItemsAsync(Config.Identifier.Trim(), ct).WithCancellation(ct))
            {
                _rawResults.Add(item);
                if (sw.ElapsedMilliseconds >= 150)
                {
                    Reprocess();
                    await InvokeAsync(StateHasChanged);
                    sw.Restart();
                }
            }
            totalSw.Stop();

            if (_rawResults.Count == 0)
            {
                _fetchState = FetchState.Failed;
                return;
            }

            _fetchState = FetchState.Success;
            Reprocess();
            Notifier.Info($"Loaded {_rawResults.Count} items in {FormatElapsed(totalSw.Elapsed)}.");
        }
        catch (OperationCanceledException)
        {
            _rawResults = [];
            _unresolvedResults = [];
            _processedResults = [];
            _fetchState = FetchState.Idle;
        }
        catch (Exception ex)
        {
            _rawResults = [];
            _unresolvedResults = [];
            _processedResults = [];
            _fetchState = FetchState.Failed;
            Notifier.Error(ex, "Failed to fetch media");
        }
        finally
        {
            _testedConfig = Config;
        }
    }
    private void ClearResults()
    {
        _rawResults = [];
        _unresolvedResults = [];
        _processedResults = [];
    }

    private void Reprocess()
    {
        _hasEnrollmentChanges = false;

        if (_rawResults.Count == 0)
        {
            _unresolvedResults = [];
            _processedResults = [];
            return;
        }

        _unresolvedResults = _rawResults.Where(r => r is UnresolvedMediaResult).ToList();
        var resolvedItems = _rawResults.Where(r => r is not UnresolvedMediaResult).ToList();

        var options = new QueryOptions
        {
            Sort = Config.Sort,
            Limit = Config.Limit,
            Filter = FilterDefinitionConverter.ToQueryFilter(Config.Filter),
        };
        _processedResults = resolvedItems.Count > 0 ? QueryProcessor.Execute(resolvedItems, options, IsWatchlisted, IsBlacklisted).ToList() : [];
    }

    private Task EmitStatusIfChangedAsync()
    {
        var status = BuildStatus();
        if (status == _lastEmittedStatus)
        {
            return Task.CompletedTask;
        }
        _lastEmittedStatus = status;
        return OnStatusChanged.InvokeAsync(status);
    }

    private PreviewStatus BuildStatus() => new()
    {
        IsLoading = IsLoading,
        HasResults = HasResults,
        HasFailed = HasFailed,
        HasEnrollmentChanges = _hasEnrollmentChanges,
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private static string FormatElapsed(TimeSpan elapsed) =>
        elapsed.TotalSeconds < 1 ? $"{elapsed.TotalMilliseconds:0} ms" : $"{elapsed.TotalSeconds:0.0} s";

    private async Task LoadWatchlistAndBlacklistAsync()
    {
        try
        {
            (await WatchlistService.GetWatchlistIdsAsync(CancellationToken.None)).ToList().ForEach(item => _watchlisted.Add(item));
            (await BlacklistService.GetBlacklistIdsAsync(CancellationToken.None)).ToList().ForEach(item => _blacklistIds.Add(item));
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Failed to fetch media");
        }
    }

    private int IncludedCount => _processedResults.Count(r => r.Value is IMediaDetailResult);
    private int BypassedCount => _processedResults.Count(r => r.Value is Bypassed<IMediaDetailResult>);
    private int FilteredCount => _processedResults.Count(r => r.Value is Culled<IMediaDetailResult>);
    private int SkippedCount => _processedResults.Count(r => r.Value is Truncated<IMediaDetailResult>);
    private int UnresolvedCount => _unresolvedResults.Count;
    private int WatchlistCount => _processedResults.Count(r => GetItem(r) is {} item && IsWatchlisted(item));
    private int BlacklistCount => _processedResults.Count(r => GetItem(r) is {} item && IsBlacklisted(item));

    private IEnumerable<QueryResult<IMediaDetailResult>> FilteredBySearchResults =>
        string.IsNullOrWhiteSpace(_searchQuery) ? _processedResults : _processedResults.Where(r => GetItem(r).Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<IMediaDetailResult> FilteredBySearchUnresolvedResults =>
        string.IsNullOrWhiteSpace(_searchQuery) ? _unresolvedResults : _unresolvedResults.Where(r => r.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

    private bool IsBlacklisted(IMediaDetailResult item) => _blacklistIds.Contains(item.SourceId);
    private bool IsWatchlisted(IMediaDetailResult item) => _watchlisted.Contains(item.SourceId);

    private static string GetKey(IMediaDetailResult item) => item.SourceId.ToString() ?? string.Empty;

    private string BypassedTooltip(Bypassed<IMediaDetailResult> bypassed)
    {
        var source = bypassed.Source switch
        {
            BypassReason.Watchlisted => "On your watchlist",
            BypassReason.Blacklisted => "On your blacklist",
        };
        if (Config.Limit is null)
            return $"{source}, will not be imported.";
        return bypassed.CountsTowardLimit ? $"{source}, skipped but counts toward your import limit." : $"{source}, skipped and does not count toward your import limit.";
    }

    private async Task ReportBrokenImageAsync(IMediaId sourceId)
    {
        if (!_reportedBrokenImages.Add(sourceId))
        {
            return;
        }
        await MetadataProvider.InvalidateAsync([sourceId]);
    }

    private static IMediaDetailResult GetItem(QueryResult<IMediaDetailResult> result) =>
        result.Value switch
        {
            IMediaDetailResult item => item,
            Bypassed<IMediaDetailResult> e => e.Item,
            Truncated<IMediaDetailResult> s => s.Item,
            Culled<IMediaDetailResult> f => f.Item,
        };

    private void ClearFocus(IMediaDetailResult item)
    {
        if (ReferenceEquals(_focusedResult, item))
        {
            _focusedResult = null;
        }
    }

    private async Task ToggleBlacklistAsync(IMediaDetailResult item)
    {
        if (_togglingBlacklistItem is not null)
        {
            return;
        }

        _togglingBlacklistItem = item;
        try
        {
            if (_blacklistIds.Contains(item.SourceId))
            {
                await BlacklistService.RemoveFromBacklistAsync(item.SourceId);
                _blacklistIds.Remove(item.SourceId);
            }
            else
            {
                await BlacklistService.AddToBacklistAsync(item.SourceId);
                _blacklistIds.Add(item.SourceId);
            }
        }
        finally
        {
            _togglingBlacklistItem = null;
            _focusedResult = null;
            _hasEnrollmentChanges = true;
            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleWatchlistAsync(IMediaDetailResult item)
    {
        if (_togglingWatchlistItem is not null)
        {
            return;
        }

        _togglingWatchlistItem = item;
        try
        {
            if (IsWatchlisted(item))
            {
                await WatchlistService.RemoveFromWatchlistAsync(item.SourceId);
                _watchlisted.Remove(item.SourceId);
            }
            else
            {
                await WatchlistService.AddToWatchlistAsync([item.SourceId], new ManualOrigin());
                _watchlisted.Add(item.SourceId);
            }
        }
        finally
        {
            _togglingWatchlistItem = null;
            _focusedResult = null;
            _hasEnrollmentChanges = true;
            await EmitStatusIfChangedAsync();
            await InvokeAsync(StateHasChanged);
        }
    }
}
