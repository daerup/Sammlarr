@switch (Preset)
{
    case AutoSkeletonPreset.MediaCard:
        @for (var i = 0; i < SkeletonCount; i++)
        {
            <div class="space-y-3">
                <BbSkeleton Class="w-full auto-skeleton-media-card" Height="300px"/>
            </div>
        }

        break;

    case AutoSkeletonPreset.SearchResult:
        @for (var i = 0; i < SkeletonCount; i++)
        {
            <div class="rounded-lg p-3 bg-surface">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-start gap-3 min-w-0 flex-1">
                        <div class="auto-skeleton-search-result-poster">
                            <BbSkeleton Class="h-full w-full"/>
                        </div>
                        <div class="auto-skeleton-search-result-content min-w-0 flex-1 space-y-2">
                            <BbSkeleton Height="16px" Class="w-2/3"/>
                            <BbSkeleton Height="12px" Class="w-1/3"/>
                            <BbSkeleton Height="12px" Class="w-full"/>
                            <BbSkeleton Height="12px" Class="w-5/6"/>
                        </div>
                    </div>
                    <BbSkeleton Class="auto-skeleton-search-result-action"/>
                </div>
            </div>
        }

        break;
}

@code {
    [Parameter, EditorRequired] public AutoSkeletonPreset Preset { get; set; }
    [Parameter] public int Count { get; set; } = 1;

    private int SkeletonCount => Math.Max(Count, 0);
}
