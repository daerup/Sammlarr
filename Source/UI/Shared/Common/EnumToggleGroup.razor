@using global::Shared
@typeparam TEnum where TEnum : struct, Enum

<div class="flex flex-wrap gap-2" role="group" aria-label="Enum selection">
    @foreach (var option in All)
    {
        var isSelected = Value.HasValue && EqualityComparer<TEnum>.Default.Equals(option, Value.Value);
        var isOptionDisabled = Disabled || DisabledValues.Contains(option);
        RenderFragment button =
            @<BbButton Variant="@(isSelected ? ButtonVariant.Default : ButtonVariant.Outline)"
                       Disabled="@isOptionDisabled"
                       Class="min-w-24 justify-center flex items-center gap-2"
                       aria-pressed="@isSelected"
                       @onclick="() => SelectAsync(option)">
                @option.GetDescription()
            </BbButton>;

        @if (TooltipProvider is null)
        {
            @button
        }
        else
        {
            <BbTooltipProvider>
                <BbTooltip>
                    <BbTooltipTrigger>@button</BbTooltipTrigger>
                    <BbTooltipContent>@TooltipProvider?.Invoke(option)</BbTooltipContent>
                </BbTooltip>
            </BbTooltipProvider>
        }
    }
</div>

@code {
    private List<TEnum> All => Enum.GetValues<TEnum>().ToList();


    [Parameter] public required Func<TEnum, string>? TooltipProvider { get; set; }

    [Parameter] [EditorRequired] public TEnum? Value { get; set; }

    [Parameter] [EditorRequired] public required EventCallback<TEnum> OnChange { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public IReadOnlyCollection<TEnum> DisabledValues { get; set; } = [];

    [Parameter] public IReadOnlyList<TEnum>? AllValues { get; set; }


    private async Task SelectAsync(TEnum value)
    {
        if (Disabled || DisabledValues.Contains(value))
        {
            return;
        }

        await OnChange.InvokeAsync(value);
    }
}
