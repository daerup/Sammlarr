@using global::Shared
@using UI.Shared.Services.Branding

@typeparam TEnum where TEnum : struct, Enum
@{
    var selectedBranding = BrandingProvider(Value);
}

<div class="flex flex-wrap gap-2" role="group" aria-label="Enum selection">
	@foreach (var option in All)
	{
		var isSelected = EqualityComparer<TEnum>.Default.Equals(option, Value);
		var isOptionDisabled = Disabled;
		var branding = BrandingProvider(option);

		<BbButton
				  Variant="@(isSelected ? ButtonVariant.Secondary : ButtonVariant.Outline)"
				  Disabled="@isOptionDisabled"
				  Class="min-w-24 justify-center flex items-center gap-2"
				  aria-pressed="@isSelected"
				  @onclick="() => SelectAsync(option)">
			@option.GetDescription()
		</BbButton>
	}
</div>

@code {
    private List<TEnum> All => Enum.GetValues<TEnum>().ToList();

    [Parameter, EditorRequired] public required Func<TEnum, BrandingInfo> BrandingProvider { get; set; }

    [Parameter, EditorRequired] public TEnum Value { get; set; }

	[Parameter, EditorRequired] public required EventCallback<TEnum> OnChange { get; set; }


	[Parameter] public bool Disabled { get; set; }

	[Parameter] public IReadOnlyList<TEnum>? AllValues { get; set; }


	private async Task SelectAsync(TEnum value)
	{
		if (Disabled || EqualityComparer<TEnum>.Default.Equals(value, Value))
		{
			return;
		}

		await OnChange.InvokeAsync(value);
	}
}
