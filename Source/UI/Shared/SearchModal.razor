@using Contracts.Media
@using Contracts.Media.Search
@using global::Shared.DI
@inject IKeyedServiceIndex<MediaProvider, IMediaSearchService> SearchServiceIndex
@inject IJSRuntime JsRuntime
@inject ToastService ToastService
@implements IAsyncDisposable
@if (IsOpen)
{
    <div class="search-modal" role="dialog" aria-modal="true" aria-label="Search Plex Catalog">
        <div class="search-modal-backdrop" @onclick="CloseAsync"></div>

        <div class="search-modal-content">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-bold tracking-wide">Search Plex Catalog</h2>
                    <p class="text-sm text-muted-foreground">Find a movie or show and add it to your watchlist.</p>
                </div>
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseAsync">
                    <LucideIcon Name="x" Size="18"/>
                </BbButton>
            </div>

            <div class="search-modal-body space-y-4 mt-4">
                <div class="flex items-center gap-2">
                    <BbField Class="flex-1">
                        <BbFieldLabel For="search-input" Class="sr-only">Search query</BbFieldLabel>
                        <BbFieldContent>
                            <BbInput Id="search-input"
                                     @bind-Value="_searchQuery"
                                     @onkeydown="HandleSearchKeyDown"
                                     UpdateTiming="UpdateTiming.Immediate"
                                     Placeholder="Search title"/>
                        </BbFieldContent>
                    </BbField>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="SearchAsync" Disabled="@_isSearching">
                        @if (_isSearching)
                        {
                            <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <LucideIcon Name="search" Size="16" Class="mr-2"/>
                            <span>Search</span>
                        }
                    </BbButton>
                </div>

                @if (!string.IsNullOrWhiteSpace(_searchStatusMessage))
                {
                    <div
                        class="rounded-lg p-3 text-sm @(_isSearchStatusError ? "text-destructive border-destructive/30 bg-destructive/10" : "text-muted-foreground bg-surface")">
                        @_searchStatusMessage
                    </div>
                }

                @if (_isSearching)
                {
                    <div class="search-modal-results space-y-2 pr-1" aria-hidden="true">
                        @for (var i = 0; i < 4; i++)
                        {
                            <div class="rounded-lg p-3 bg-surface">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-start gap-3 min-w-0 flex-1">
                                        <div class="search-result-poster">
                                            <BbSkeleton Class="h-full w-full"/>
                                        </div>
                                        <div class="search-result-content min-w-0 flex-1 space-y-2">
                                            <BbSkeleton Height="16px" Class="w-2/3"/>
                                            <BbSkeleton Height="12px" Class="w-1/3"/>
                                            <BbSkeleton Height="12px" Class="w-full"/>
                                            <BbSkeleton Height="12px" Class="w-5/6"/>
                                        </div>
                                    </div>
                                    <BbSkeleton Class="search-result-action-skeleton"/>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_searchResults.Count > 0)
                {
                    <div class="search-modal-results space-y-2 pr-1">
                        @foreach (var result in _searchResults)
                        {
                            var displayFacts = GetDisplayFacts(result);

                            var backgroundStyle = $"--hover-bg: url('{(string.IsNullOrWhiteSpace(result.BackdropUrl) ? result.PosterUrl ?? "" : result.BackdropUrl)}')";

                            <div class="search-result-row rounded-lg bg-black hover-bg" style="@backgroundStyle">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-start">
                                        <div class="search-result-poster">
                                            @if (!string.IsNullOrWhiteSpace(result.PosterUrl))
                                            {
                                                <img src="@result.PosterUrl" alt="@result.Title" class="rounded-lg"/>
                                            }
                                            else
                                            {
                                                <LucideIcon Name="image-off" Size="16" Class="text-muted-foreground"/>
                                            }
                                        </div>
                                        <div class="search-result-content min-w-0">
                                            <p class="text-xs text-muted-foreground flex items-center gap-1.5">
                                                @if (result.MediaType is MediaType.Movie)
                                                {
                                                    <LucideIcon Name="film" Size="13"/>
                                                }
                                                else if (result.MediaType is MediaType.Show)
                                                {
                                                    <LucideIcon Name="tv" Size="13"/>
                                                }
                                                else
                                                {
                                                    <LucideIcon Name="circle-help" Size="13"/>
                                                }
                                                <span>@result.ReleaseDate?.Year</span>
                                                @if (displayFacts.Count > 0)
                                                {
                                                    <span aria-hidden="true">•</span>
                                                    <span>@string.Join(" • ", displayFacts)</span>
                                                }
                                            </p>
                                            <p class="font-bold truncate text-xl pt-2">@result.Title</p>

                                            @if (result.Genres.Count > 0)
                                            {
                                                <div class="search-result-genres pt-1">
                                                    @foreach (var genre in result.Genres)
                                                    {
                                                        <BbBadge Variant="BadgeVariant.Secondary" Class="px-2 py-0.5">@genre</BbBadge>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <BbButton Variant="ButtonVariant.Link"
                                              OnClick="() => ToggleWatchlistAsync(result)"
                                              Disabled="@(_isAdding || !CanAddToWatchlist(result))">
                                        @if (_isAdding && Equals(_activeAddSourceId, result.SourceId))
                                        {
                                            <BbSpinner Size="SpinnerSize.Default"/>
                                        }
                                        else if (IsSearchResultInWatchlist(result))
                                        {
                                            <LucideIcon Name="bookmark" Size="24" Fill="orange" Color="orange" />
                                        }
                                        else
                                        {
                                            <LucideIcon Name="bookmark" Size="24"/>
                                        }
                                    </BbButton>
                                </div>
                            </div>
                        }
                    </div>
                    <BbSeparator/>
                }
                else if (!_isSearching && _hasSearched)
                {
                    <div class="rounded-lg bg-surface p-6 text-center space-y-2">
                        <LucideIcon Name="search-x" Size="28" Class="mx-auto text-muted-foreground"/>
                        <p class="text-sm text-muted-foreground">No matches found.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public MediaProvider SearchProvider { get; set; } = MediaProvider.Plex;
    [Parameter] public Func<PlexId, bool>? IsInWatchlist { get; set; }
    [Parameter] public Func<PlexId, string, Task<bool>> AddToWatchlistAsync { get; set; }
    [Parameter] public Func<PlexId, string, Task<bool>> RemoveFromWatchlistAsync { get; set; }

    private bool _isSearching;
    private bool _hasSearched;
    private bool _isAdding;
    private string? _searchQuery = string.Empty;
    private string? _searchStatusMessage;
    private bool _isSearchStatusError;
    private IMediaId? _activeAddSourceId;
    private List<IMediaSearchResult> _searchResults = [];
    private bool _wasOpen;
    private bool _isEscapeHandlerRegistered;
    private DotNetObjectReference<SearchModal>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            await JsRuntime.InvokeVoidAsync("focusSearchInput", "search-input");
            await RegisterEscapeHandlerAsync();
        }
        else if (!IsOpen && _wasOpen)
        {
            await UnregisterEscapeHandlerAsync();
        }

        _wasOpen = IsOpen;
    }

    [JSInvokable]
    public async Task CloseFromEscapeAsync()
    {
        if (IsOpen)
        {
            await CloseAsync();
        }
    }

    private async Task RegisterEscapeHandlerAsync()
    {
        if (_isEscapeHandlerRegistered)
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("registerSearchModalEscape", _dotNetRef);
        _isEscapeHandlerRegistered = true;
    }

    private async Task UnregisterEscapeHandlerAsync()
    {
        if (!_isEscapeHandlerRegistered)
        {
            return;
        }

        try
        {
            await JsRuntime.InvokeVoidAsync("unregisterSearchModalEscape");
        }
        catch (JSDisconnectedException) {}

        _dotNetRef?.Dispose();
        _dotNetRef = null;
        _isEscapeHandlerRegistered = false;
    }

    public async ValueTask DisposeAsync()
    {
        await UnregisterEscapeHandlerAsync();
    }

    private bool InWatchlist(PlexId plexId)
    {
        return IsInWatchlist?.Invoke(plexId) == true;
    }

    private bool IsSearchResultInWatchlist(IMediaSearchResult result)
    {
        return result.SourceId is PlexId plexId && InWatchlist(plexId);
    }

    private static bool CanAddToWatchlist(IMediaSearchResult result)
    {
        return result.SourceId is PlexId;
    }

    private async Task CloseAsync()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        var query = _searchQuery?.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            _searchStatusMessage = "Enter a title to search.";
            _isSearchStatusError = true;
            _searchResults = [];
            _hasSearched = false;
            return;
        }

        _isSearching = true;
        _searchStatusMessage = null;
        _isSearchStatusError = false;

        try
        {
            var searchService = SearchServiceIndex[SearchProvider];
            _searchResults = [.. await searchService.SearchAsync(query, [MediaType.Movie, MediaType.Show])];

            _hasSearched = true;
        }
        catch (Exception ex)
        {
            _searchStatusMessage = $"Search failed: {ex.Message}";
            _isSearchStatusError = true;
            _searchResults = [];
            _hasSearched = false;
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task ToggleWatchlistAsync(IMediaSearchResult result)
    {
        if (_isAdding)
        {
            return;
        }

        if (result.SourceId is not PlexId plexId)
        {
            _searchStatusMessage = $"Could not modify watchlist for '{result.Title}': missing Plex identifier.";
            _isSearchStatusError = true;
            return;
        }

        _isAdding = true;
        _activeAddSourceId = result.SourceId;
        _searchStatusMessage = null;
        _isSearchStatusError = false;

        if (IsSearchResultInWatchlist(result))
        {
            await RemoveFromWatchlistAsync(plexId, result.Title);
        }
        else
        {
            await AddToWatchlistAsync(plexId, result.Title);
        }
        _isAdding = false;
        _activeAddSourceId = null;
    }

    private static IReadOnlyList<string> GetDisplayFacts(IMediaSearchResult result)
    {
        var facts = new List<string>();

        switch (result)
        {
            case ShowSearchResult showResult:
                AddCountFact(facts, showResult.Seasons, "season");
                AddCountFact(facts, showResult.Episodes, "episode");
                break;
            case MovieSearchResult movieResult:
                var runtime = GetRuntimeLabel(movieResult.Runtime);
                if (!string.IsNullOrWhiteSpace(runtime))
                {
                    facts.Add(runtime);
                }
                break;
            default:
                var fallbackRuntime = GetRuntimeLabel(result.Runtime);
                if (!string.IsNullOrWhiteSpace(fallbackRuntime))
                {
                    facts.Add(fallbackRuntime);
                }
                break;
        }

        return facts;
    }

    private static void AddCountFact(ICollection<string> facts, int count, string singularLabel)
    {
        if (count <= 0)
        {
            return;
        }

        var suffix = count == 1 ? string.Empty : "s";
        facts.Add($"{count} {singularLabel}{suffix}");
    }

    private static string? GetRuntimeLabel(TimeSpan? runtime)
    {
        if (runtime is null || runtime <= TimeSpan.Zero)
        {
            return null;
        }

        var totalMinutes = (int)Math.Round(runtime.Value.TotalMinutes, MidpointRounding.AwayFromZero);
        if (totalMinutes <= 0)
        {
            return null;
        }

        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;

        return hours > 0 ? $"{hours}h {minutes}m" : $"{minutes}m";
    }

}
