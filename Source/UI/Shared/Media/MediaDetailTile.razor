@using Contracts.Media
@using Contracts.Media.Search
<div class="search-result-row rounded-sm bg-black @Class @(IsFocused ? "row-focused" : "")"
     style="@_backgroundStyle"
     @onfocusin="OnFocusIn"
     @onfocusout="OnFocusOut">
    <div class="flex items-start justify-between gap-3">
        <div class="search-result-main-content flex items-start">
            <div class="search-result-poster">
                @if (!_failed && !string.IsNullOrWhiteSpace(Result.PosterUrl))
                {
                    <img src="@Result.PosterUrl" alt="@Result.Title" class="rounded-sm" loading="lazy" decoding="async" @onerror="OnPosterError"/>
                }
                else
                {
                    <LucideIcon Name="image-off" Size="16" Class="text-muted-foreground"/>
                }
            </div>
            <div class="search-result-content min-w-0">
                <p class="text-xs text-muted-foreground flex items-center gap-1.5">
                    @if (Result.MediaType is MediaType.Movie)
                    {
                        <LucideIcon Name="film" Size="13"/>
                    }
                    else if (Result.MediaType is MediaType.Show)
                    {
                        <LucideIcon Name="tv" Size="13"/>
                    }
                    else
                    {
                        <LucideIcon Name="circle-help" Size="13"/>
                    }
                    @if (Result.ReleaseDate > DateOnly.MinValue)
                    {
                        <span>@Result.ReleaseDate.Year</span>
                    }
                    @if (_displayFacts.Count > 0)
                    {
                        <span aria-hidden="true">•</span>
                        <span>@string.Join(" • ", _displayFacts)</span>
                    }
                    @if (Result.Rating is { } rating)
                    {
                        <span aria-hidden="true">•</span>
                        <span class="inline-flex items-center gap-1 text-yellow-400">
                            <LucideIcon Name="star" Size="12" Fill="currentColor"/>
                            <span class="font-medium">@rating.ToString("F1")</span>
                        </span>
                    }
                </p>
                <p class="font-bold truncate text-xl pt-2">@Result.Title</p>

                @if (!string.IsNullOrWhiteSpace(Result.Tagline))
                {
                    <p class="text-xs italic text-muted-foreground line-clamp-1 pt-1">@Result.Tagline</p>
                }

                @if (Result.Genres.Count > 0)
                {
                    <div class="search-result-genres pt-1">
                        @foreach (var genre in Result.Genres)
                        {
                            <BbBadge Variant="BadgeVariant.Secondary" Class="px-2 py-0.5">@genre</BbBadge>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Result.Summary))
                {
                    <p class="text-sm text-white line-clamp-2 pt-2">@Result.Summary</p>
                }
            </div>
        </div>
        @if (Icons != null)
        {
            <div class="flex items-center gap-1">
                @Icons
            </div>
        }
    </div>
</div>

@code {

    [Parameter] [EditorRequired] public required IMediaDetailResult Result { get; set; }
    [Parameter] public string Class { get; set; } = "hover-bg";
    [Parameter] public bool IsFocused { get; set; }
    [Parameter] public EventCallback OnFocusIn { get; set; }
    [Parameter] public EventCallback OnFocusOut { get; set; }
    [Parameter] public RenderFragment? Icons { get; set; }
    [Parameter] public EventCallback OnImageBroken { get; set; }

    private string _backgroundStyle = string.Empty;
    private IReadOnlyList<string> _displayFacts = [];
    private bool _failed;
    private IMediaDetailResult? _lastResult;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastResult, Result))
        {
            _lastResult = Result;
            _failed = false;
        }
        _backgroundStyle = $"--hover-bg: url('{(string.IsNullOrWhiteSpace(Result.BackdropUrl) ? Result.PosterUrl : Result.BackdropUrl)}')";
        _displayFacts = GetDisplayFacts(Result);
    }

    private async Task OnPosterError()
    {
        _failed = true;
        await OnImageBroken.InvokeAsync();
    }

    private static IReadOnlyList<string> GetDisplayFacts(IMediaDetailResult result)
    {
        var facts = new List<string>();

        switch (result)
        {
            case ShowDetailResult showResult:
                AddCountFact(facts, showResult.Seasons, "season");
                AddCountFact(facts, showResult.Episodes, "episode");
                break;
            case MovieDetailResult movieResult:
                var runtime = GetRuntimeLabel(movieResult.Runtime);
                if (!string.IsNullOrWhiteSpace(runtime))
                {
                    facts.Add(runtime);
                }
                break;
        }

        return facts;
    }

    private static void AddCountFact(ICollection<string> facts, int count, string singularLabel)
    {
        if (count <= 0)
        {
            return;
        }

        var suffix = count == 1 ? string.Empty : "s";
        facts.Add($"{count} {singularLabel}{suffix}");
    }

    private static string? GetRuntimeLabel(TimeSpan runtime)
    {
        var totalMinutes = (int)Math.Round(runtime.TotalMinutes, MidpointRounding.AwayFromZero);
        if (totalMinutes <= 0)
        {
            return null;
        }

        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;

        return hours > 0 ? $"{hours}h {minutes}m" : $"{minutes}m";
    }

}
