@using Contracts.DI
@using Contracts.Media
@using Contracts.Media.Search
@using global::Shared
@inject IKeyedServiceIndex<MediaSearchProvider, IMediaSearchService> SearchServiceIndex
@inject Notifier Notifier
@if (IsOpen)
{
    <div class="search-modal"
         role="dialog"
         aria-modal="true"
         aria-label="@SearchModalTitle"
         tabindex="-1"
         @onkeydown="HandleModalKeyDown">
        <div class="search-modal-backdrop" @onclick="CloseAsync"></div>

        <div tabindex="0" class="sr-only" aria-hidden="true" @onfocus="FocusTrapLoopAsync"></div>

        <div class="search-modal-content">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-bold tracking-wide">@SearchModalTitle</h2>
                    <p class="text-sm text-muted-foreground">@SearchModalDescription</p>
                </div>
                <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseAsync">
                    <LucideIcon Name="x" Size="18"/>
                </BbButton>
            </div>

            <div class="search-modal-body space-y-4 mt-4">
                <div class="flex items-center gap-2">
                    <BbField Class="flex-1">
                        <BbFieldLabel For="search-input" Class="sr-only">Search query</BbFieldLabel>
                        <BbFieldContent>
                            <input id="search-input"
                                   class="w-full border-input bg-secondary file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 flex h-9 min-w-0 rounded-md border px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm"
                                   type="search"
                                   @bind="_searchQuery"
                                   @bind:event="oninput"
                                   @onkeydown="HandleSearchKeyDown"
                                   @onfocus="() => _focusedResult = null"
                                   @ref="_searchInputRef"
                                   placeholder="Search title"/>
                        </BbFieldContent>
                    </BbField>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="SearchAsync" Disabled="@_isSearching" Class="bg-secondary">
                        @if (_isSearching)
                        {
                            <BbSpinner Size="SpinnerSize.Small" Class="mr-2"/>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <LucideIcon Name="search" Size="16" Class="mr-2"/>
                            <span>Search</span>
                        }
                    </BbButton>
                </div>

                @if (!string.IsNullOrWhiteSpace(_searchHint))
                {
                    <div class="rounded-lg border bg-muted/40 px-4 py-3 flex items-center gap-2 text-sm text-muted-foreground">
                        <LucideIcon Name="info" Size="16" Class="shrink-0"/>
                        <span>@_searchHint</span>
                    </div>
                }

                @if (_isSearching)
                {
                    <div class="search-modal-results space-y-2 pr-1" aria-hidden="true" tabindex="-1">
                        <AutoSkeletons Preset="AutoSkeletonPreset.MediaDetailTile" Count="4"/>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_searchError))
                {
                    <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-3">
                        <LucideIcon Name="circle-alert" Size="36" Class="mx-auto text-destructive"/>
                        <h3 class="text-base font-semibold tracking-tight">Search failed.</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed break-words">@_searchError</p>
                    </div>
                }
                else if (_searchResults.Count > 0)
                {
                    <div class="search-modal-results space-y-2 pr-1" tabindex="-1">
                        @foreach (var result in _searchResults)
                        {
                            <MediaDetailTile @key="result"
                                             Result="result"
                                             IsFocused="_focusedResult == result"
                                             OnFocusIn="() => _focusedResult = result"
                                             OnFocusOut="() => ClearFocusedResult(result)">
                                <Icons>
                                    @TileIcons?.Invoke(new TileIconContext(result, IsSearchResultMarked(result), _isAdding && Equals(_activeToggledSourceId, result.SourceId), EventCallback.Factory.Create<IMediaDetailResult>(this, ToggleAsync)))
                                </Icons>
                            </MediaDetailTile>
                        }
                    </div>
                    <BbSeparator/>
                }
                else if (_hasSearched)
                {
                    <div class="rounded-lg border bg-muted/40 p-8 text-center space-y-3">
                        <LucideIcon Name="search-x" Size="36" Class="mx-auto text-muted-foreground"/>
                        <h3 class="text-base font-semibold tracking-tight">No matches found.</h3>
                        <p class="text-sm text-muted-foreground leading-relaxed">Try a different title or check your spelling.</p>
                    </div>
                }
            </div>
        </div>

        <div tabindex="0" class="sr-only" aria-hidden="true" @onfocus="FocusTrapLoopAsync"></div>

    </div>
}

@code {

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] [EditorRequired] public MediaSearchProvider SearchProvider { get; set; }
    [Parameter] [EditorRequired] public required Func<IMediaId, bool> IsInWatchlist { get; set; }
    [Parameter] [EditorRequired] public required Func<IMediaId, string, bool, Task<bool>> OnToggle { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment<TileIconContext>? TileIcons { get; set; }
    private bool _isSearching;
    private bool _hasSearched;
    private bool _isAdding;
    private string? _searchQuery = string.Empty;
    private string? _searchHint;
    private string? _searchError;
    private IMediaId? _activeToggledSourceId;
    private List<IMediaDetailResult> _searchResults = [];
    private ElementReference _searchInputRef;
    private bool _shouldFocusSearchInput;
    private bool _wasOpen;
    private IMediaDetailResult? _focusedResult;

    private string SearchProviderName => SearchProvider.GetDescription();
    private string SearchModalTitle => Title ?? $"Search {SearchProviderName}";
    private string SearchModalDescription => Description ?? $"Find a movie or show from {SearchProviderName} and add it to your watchlist.";

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _shouldFocusSearchInput = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && _shouldFocusSearchInput)
        {
            _shouldFocusSearchInput = false;
            await _searchInputRef.FocusAsync();
        }

        _wasOpen = IsOpen;
    }

    private async Task FocusTrapLoopAsync()
    {
        await _searchInputRef.FocusAsync();
    }


    private bool IsSearchResultMarked(IMediaDetailResult result) => IsInWatchlist.Invoke(result.SourceId);

    private async Task CloseAsync()
    {
        _focusedResult = null;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter")
        {
            await SearchAsync();
        }
        else if (args.Key is "Escape" && IsOpen)
        {
            await CloseAsync();
        }
    }

    private async Task HandleModalKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Escape" && IsOpen)
        {
            await CloseAsync();
        }
    }

    private async Task SearchAsync()
    {
        var query = _searchQuery?.Trim();
        _searchHint = null;
        _searchError = null;

        if (string.IsNullOrWhiteSpace(query))
        {
            _searchHint = "Enter a title to search.";
            _searchResults = [];
            _hasSearched = false;
            return;
        }

        _isSearching = true;

        try
        {
            var searchService = SearchServiceIndex[SearchProvider];
            _searchResults = [.. await searchService.SearchAsync(query, [MediaType.Movie, MediaType.Show])];

            _hasSearched = true;
        }
        catch (Exception ex)
        {
            Notifier.Error(ex, "Search failed");
            _searchError = ex.Message;
            _searchResults = [];
            _hasSearched = false;
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task ToggleAsync(IMediaDetailResult result)
    {
        if (_isAdding)
        {
            return;
        }

        _isAdding = true;
        _activeToggledSourceId = result.SourceId;
        _searchHint = null;
        _searchError = null;

        var isMarked = IsSearchResultMarked(result);
        await OnToggle(result.SourceId, result.Title, isMarked);

        _isAdding = false;
        _activeToggledSourceId = null;
        _focusedResult = null;
    }

    private void ClearFocusedResult(IMediaDetailResult result)
    {
        if (ReferenceEquals(_focusedResult, result))
        {
            _focusedResult = null;
        }
    }


}
