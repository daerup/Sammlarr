@using Contracts.Auth

@inject ICredentialStore CredentialStore

@code {
    [Parameter, EditorRequired] public AuthProvider Provider { get; set; }
    [Parameter] public EventCallback<bool> AccessChanged { get; set; }

    private bool _hasAccess;
    private bool? _lastReportedAccess;

    protected override async Task OnParametersSetAsync()
    {
        var credential = await CredentialStore.GetAsync(Provider);
        _hasAccess = credential is not null && !string.IsNullOrWhiteSpace(credential.AccessToken);

        if (AccessChanged.HasDelegate && _lastReportedAccess != _hasAccess)
        {
            _lastReportedAccess = _hasAccess;
            await AccessChanged.InvokeAsync(_hasAccess);
        }
    }
}
