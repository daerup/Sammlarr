@using Contracts.Auth
@using Contracts.Media
@using global::Shared.DI

@inject IApiKeyStore ApiKeyStore
@inject IKeyedServiceIndex<MediaProvider, IApiKeyValidator> ApiKeyValidatorIndex

@code {
    [Parameter, EditorRequired] public MediaProvider Provider { get; set; }
    [Parameter] public EventCallback<bool> AccessChanged { get; set; }

    private bool _hasAccess;
    private bool? _lastReportedAccess;
    private string? _lastValidatedKey;
    private MediaProvider? _lastValidatedProvider;
    private bool _lastValidationResult;

    protected override async Task OnParametersSetAsync()
    {
        var apiKey = await ApiKeyStore.GetApiKeyAsync(Provider);
        _hasAccess = await ValidateApiKeyAsync(apiKey);

        if (AccessChanged.HasDelegate && _lastReportedAccess != _hasAccess)
        {
            _lastReportedAccess = _hasAccess;
            await AccessChanged.InvokeAsync(_hasAccess);
        }
    }

    private async Task<bool> ValidateApiKeyAsync(string? apiKey)
    {
        var normalizedApiKey = apiKey?.Trim();
        if (string.IsNullOrWhiteSpace(normalizedApiKey))
        {
            return false;
        }

        var keyToValidate = normalizedApiKey;

        // Avoid re-validating the same provider/key pair on every render.
        if (_lastValidatedProvider == Provider && string.Equals(_lastValidatedKey, keyToValidate, StringComparison.Ordinal))
        {
            return _lastValidationResult;
        }

        try
        {
            var isValid = await ApiKeyValidatorIndex[Provider].ValidateApiKeyAsync(keyToValidate);
            _lastValidatedProvider = Provider;
            _lastValidatedKey = keyToValidate;
            _lastValidationResult = isValid;
            return isValid;
        }
        catch
        {
            _lastValidatedProvider = Provider;
            _lastValidatedKey = keyToValidate;
            _lastValidationResult = false;
            return false;
        }
    }
}

