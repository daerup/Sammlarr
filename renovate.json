{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "semanticCommits": "enabled",
  "timezone": "Europe/Zurich",
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": { "enabled": true },
  "automerge": true,
  "packageRules": [
    {
      "description": "Everything that is not a major update arrives as one PR a week",
      "groupName": "non-major dependencies",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"]
    },
    {
      "description": "Test-only packages come as their own PR",
      "matchPackageNames": ["TUnit*", "bunit", "Bogus", "CsCheck", "Verify.TUnit", "NetArchTest.eNhancedEdition", "Microsoft.Extensions.TimeProvider.Testing", "Microsoft.Extensions.Diagnostics.Testing"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "test packages"
    },
    {
      "description": "Aspire's packages and its AppHost SDK move together, with the MessagePack the AppHost pins above Aspire's own",
      "matchPackageNames": ["/^aspire\\./i", "MessagePack"],
      "groupName": "Aspire"
    },
    {
      "description": "Roslyn stays at the SDK's compiler version, or the repo's analyzer stops loading (CS9057)",
      "matchPackageNames": ["Microsoft.CodeAnalysis.*"],
      "enabled": false
    },
    {
      "description": "TickerQ stays on 10.4, its last MIT/Apache line; 10.5.0 onwards is source-available under a commercial licence",
      "matchPackageNames": ["TickerQ", "TickerQ.*"],
      "allowedVersions": "<10.5.0"
    },
    {
      "description": "Radarr and Sonarr bumps come as their own PR",
      "matchPackageNames": ["ghcr.io/linuxserver/radarr", "ghcr.io/linuxserver/sonarr"],
      "groupName": null
    },
    {
      "description": "compose.yaml follows Sammlarr's own :latest for whoever downloads it, so it is never pinned or bumped",
      "matchPackageNames": ["ghcr.io/daerup/sammlarr"],
      "enabled": false
    },
    {
      "description": "The C# pins carry a tag only, so there is no digest to pin",
      "matchManagers": ["custom.regex"],
      "pinDigests": false
    },
    {
      "description": "Major updates wait for a review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Radarr and Sonarr images the AppHost and E2E pin in C#",
      "managerFilePatterns": ["/^src/AppHost/ArrContainers\\.cs$/"],
      "matchStrings": ["\"(?<depName>ghcr\\.io/linuxserver/[a-z]+)\", \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "The BuildKit the image build, its rebuild and the scan share",
      "managerFilePatterns": ["/^\\.github/actions/build-image/action\\.yml$/"],
      "matchStrings": ["image=(?<depName>moby/buildkit):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
