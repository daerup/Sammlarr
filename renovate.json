{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "semanticCommits": "enabled",
  "timezone": "Europe/Zurich",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Everything that is not a major update arrives as one PR a week",
      "groupName": "non-major dependencies",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"]
    },
    {
      "description": "Test-only packages come as their own PR and merge by themselves once CI is green",
      "matchPackageNames": ["TUnit*", "bunit", "Bogus", "CsCheck", "Verify.TUnit", "NetArchTest.eNhancedEdition", "Microsoft.Extensions.TimeProvider.Testing"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "test packages",
      "automerge": true
    },
    {
      "description": "Aspire's packages and its AppHost SDK move together, with the MessagePack the AppHost pins above Aspire's own",
      "matchPackageNames": ["/^aspire\\./i", "MessagePack"],
      "groupName": "Aspire",
      "automerge": false
    },
    {
      "description": "Roslyn stays at the SDK's compiler version, or the repo's analyzer stops loading (CS9057)",
      "matchPackageNames": ["Microsoft.CodeAnalysis.*"],
      "enabled": false
    },
    {
      "description": "Radarr and Sonarr bumps wait for the self-hosted E2E suite",
      "matchPackageNames": ["lscr.io/linuxserver/radarr", "lscr.io/linuxserver/sonarr"],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "compose.yaml follows Sammlarr's own :latest for whoever downloads it, so it is never pinned or bumped",
      "matchPackageNames": ["ghcr.io/daerup/sammlarr"],
      "enabled": false
    },
    {
      "description": "The C# pins carry a tag only, so there is no digest to pin",
      "matchManagers": ["custom.regex"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Radarr and Sonarr images the AppHost and E2E pin in C#",
      "managerFilePatterns": ["/^AppHost/ArrContainers\\.cs$/"],
      "matchStrings": ["\"(?<depName>lscr\\.io/linuxserver/[a-z]+)\", \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "The BuildKit the image build, its rebuild and the scan share",
      "managerFilePatterns": ["/^\\.github/actions/build-image/action\\.yml$/"],
      "matchStrings": ["image=(?<depName>moby/buildkit):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
