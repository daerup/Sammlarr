	<PropertyGroup>
		<RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
	</PropertyGroup>
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Shared.Options.Generator' and '$(MSBuildProjectName)' != 'Shared.Options.Generator.Tests'">
