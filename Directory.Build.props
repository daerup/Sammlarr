<Project>
	<PropertyGroup>
		<RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
	</PropertyGroup>
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Roslyn' and '$(MSBuildProjectName)' != 'Roslyn.Tests'">
		<Using Include="Shared" />
		<Using Include="Shared.Collections" />
		<Using Include="Shared.Extensions" />
	</ItemGroup>
</Project>
