<Project>
	<PropertyGroup>
		<RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Roslyn' and '$(MSBuildProjectName)' != 'Roslyn.Tests' and '$(MSBuildProjectName)' != 'Analyzers'">
		<Using Include="Shared" />
		<Using Include="Shared.Collections" />
		<Using Include="Shared.Extensions" />
		<ProjectReference
			Include="$(MSBuildThisFileDirectory)Analyzers\Analyzers.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			IsAspireProjectResource="false"
		/>
	</ItemGroup>
</Project>
