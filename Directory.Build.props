<Project>
	<PropertyGroup>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PublishDocumentationFiles>false</PublishDocumentationFiles>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<LangVersion Condition="'$(MSBuildProjectName)' != 'Roslyn' and '$(MSBuildProjectName)' != 'Roslyn.Tests'">preview</LangVersion>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
		<Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
		<Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
	</PropertyGroup>
	<ItemGroup>
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Visible="false" />
		<AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" Visible="false" />
	</ItemGroup>
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Roslyn' and '$(MSBuildProjectName)' != 'Roslyn.Tests'">
		<Using Include="Shared" />
		<Using Include="Shared.Collections" />
		<Using Include="Shared.Extensions" />
		<Using Include="Shared.Secret" Alias="Secret" />
	</ItemGroup>
	<ItemGroup Condition="'$(MSBuildProjectName)' != 'Roslyn'">
		<ProjectReference
			Include="$(MSBuildThisFileDirectory)src\Roslyn\Roslyn.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			IsAspireProjectResource="false"
		/>
	</ItemGroup>
</Project>
